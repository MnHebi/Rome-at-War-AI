;Generated diagnostic-only terminal report; code 4 namespace, not RAW3 event 4.
(defrule
	(goal gl-transport-route-state TRANSPORT-ROUTE-UNSCREENED-DENY)
	(goal gl-assault-fallback-denial 4)
	(goal gl-assault-diag-subcode 401)
	(up-compare-goal gl-assault-fallback-seen c:> 0)
=>
	(set-goal gl-assault-diag-subcode 402)
)

(defrule
	(goal gl-transport-route-state TRANSPORT-ROUTE-UNSCREENED-DENY)
	(goal gl-assault-fallback-denial 4)
	(goal gl-assault-diag-subcode 0)
=>
	(set-goal gl-assault-diag-subcode 419)
)

(defrule
	(goal gl-transport-route-state TRANSPORT-ROUTE-UNSCREENED-DENY)
	(goal gl-assault-fallback-denial 4)
	(up-compare-goal gl-assault-diag-subcode c:>= 411)
	(up-compare-goal gl-assault-diag-checked-enemy g:!= gl-assault-manifest-player)
=>
	(set-goal gl-assault-diag-subcode 415)
)

(defrule
	(goal gl-transport-route-state TRANSPORT-ROUTE-UNSCREENED-DENY)
	(goal gl-assault-fallback-denial 4)
=>
	(up-modify-goal gl-assault-diag-global-target s:= sn-target-player-number)
	(up-chat-data-to-all str-assault-deny-stage c: 2)
	(up-chat-data-to-all str-assault-deny-subcode g: gl-assault-diag-subcode)
	(up-chat-data-to-all str-assault-deny-hull g: gl-transport-route-id)
	(up-chat-data-to-all str-assault-saved-enemy g: gl-assault-manifest-player)
	(up-chat-data-to-all str-assault-deny-global-target g: gl-assault-diag-global-target)
	(up-chat-data-to-all str-assault-deny-checked-enemy g: gl-assault-diag-checked-enemy)
	(up-chat-data-to-all str-assault-deny-enemy-failure g: gl-assault-diag-enemy-failure)
	(up-chat-data-to-all str-assault-deny-live g: gl-assault-preflight-live)
)

(defrule
	(goal gl-transport-route-state TRANSPORT-ROUTE-UNSCREENED-DENY)
	(goal gl-assault-fallback-denial 4)
	(up-compare-goal gl-assault-diag-subcode c:< 410)
=>
	(up-chat-data-to-all str-assault-deny-iterator g: gl-assault-fallback-player)
	(up-chat-data-to-all str-assault-deny-first g: gl-assault-fallback-first)
	(up-chat-data-to-all str-assault-deny-previous g: gl-assault-diag-previous-enemy)
	(up-chat-data-to-all str-assault-deny-seen g: gl-assault-fallback-seen)
)

(defrule
	(goal gl-transport-route-state TRANSPORT-ROUTE-UNSCREENED-DENY)
	(goal gl-assault-fallback-denial 4)
	(goal gl-assault-diag-subcode 401)
=>
	(up-chat-data-to-all str-assault-deny-401 g: gl-assault-fallback-player)
)

