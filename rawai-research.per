
;UNIT UPGRADES

;Ballistics is the first Middle-Age military technology whenever it is
;available. Town Centers, towers, forts, and ranged units otherwise waste much
;of their defensive fire against moving attackers.
(defrule
	(current-age >= middle-antiquity-age)
	(up-can-research gl-researchescrow-state c: ri-ballistics)
=>
	(up-research gl-researchescrow-state c: ri-ballistics)
)

;Advanced Weaponry upgrades a broad set of ranged units, naval units, and
;static defenses in the current DAT. Some civilizations expose it in Middle
;Antiquity, so capability rather than an Imperial-only phase gate owns timing.
(defrule
	(current-age >= middle-antiquity-age)
	(up-can-research gl-researchescrow-state c: ri-advanced-weaponry)
=>
	(up-research gl-researchescrow-state c: ri-advanced-weaponry)
)

;Crossbowman is a separate advanced unit unlock (technology 85), not an
;Improved Bowman upgrade. Explicit ownership keeps the Roman late ranged policy
;from depending on undocumented automatic-research behavior.
(defrule
	(current-age >= middle-antiquity-age)
	(research-completed ri-advanced-weaponry)
	(up-can-research gl-researchescrow-state c: ri-crossbowman)
=>
	(up-research gl-researchescrow-state c: ri-crossbowman)
)

;Faith cannot be researched before Imperial in the data mod. Enemy conversion
;units make it an immediate Imperial request instead of leaving it behind the
;ordinary monastery-research queue.
(defrule
	(up-compare-goal current-phase == 7)
	(or
		(players-unit-type-count any-enemy priest > 0)
		(players-unit-type-count any-enemy brahmin > 0)
	)
	(up-can-research gl-researchescrow-state c: ri-faith)
=>
	(up-research gl-researchescrow-state c: ri-faith)
)

(defrule
	(up-compare-goal current-phase == 7)
	(up-compare-goal villager-count g:>= upgrade-military-villager-requirement)
	(goal upgrade-military-lines 1)
	(unit-type-count-total my-unique-unit > 2)
	(up-can-research gl-researchescrow-state c: my-unique-unit-upgrade)
=>
	(up-research gl-researchescrow-state c: my-unique-unit-upgrade)
)

(defrule
	(up-compare-goal current-phase == 7)
	(up-compare-goal villager-count g:>= upgrade-military-villager-requirement)
	(up-can-research gl-researchescrow-state c: my-unique-research)
=>
	(up-research gl-researchescrow-state c: my-unique-research)
)

(defrule
	(up-compare-goal current-phase == 7)
	(up-compare-goal villager-count g:>= upgrade-military-villager-requirement)
	(up-can-research gl-researchescrow-state c: my-second-unique-research)
=>
	(up-research gl-researchescrow-state c: my-second-unique-research)
)

