(defrule
	(up-compare-goal current-phase == 7)
	(up-compare-goal villager-count g:>= upgrade-navy-villager-requirement)
	(goal upgrade-navy 1)
	(or
		(and
			(up-compare-goal gl-naval-role c:<= NAVAL-ROLE-COMPETITIVE)
			(up-compare-goal gl-naval-role c:>= NAVAL-ROLE-PRIMARY)
		)
		(and
			(goal gl-naval-role NAVAL-ROLE-SUPPORT)
			(goal gl-naval-specialist-support YES)
		)
	)
	(up-can-research gl-researchescrow-state c: ri-quinquereme)
=>
    (up-research gl-researchescrow-state c: ri-quinquereme)
)

