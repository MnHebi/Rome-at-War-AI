;Generated by tools/generate_ranged_threat.py. No orders or ownership changes.

;AIRef: players-unit-type-count cannot count enemy classes.

;Search only recently sighted enemies; no omniscient cc fact. Five-second refresh.

(defconst gl-reactive-ranged-threat 15860)

(defconst gl-reactive-ranged-clock 15861)

(defconst gl-reactive-ranged-next 15862)

(defconst gl-reactive-ranged-scan 15863)

(defconst gl-reactive-ranged-focus 15864)

(defconst gl-reactive-ranged-local 15865)

(defconst gl-reactive-ranged-local-last 15866)

(defconst gl-reactive-ranged-remote 15867)

(defconst gl-reactive-ranged-remote-last 15868)

(defrule
	(true)
=>
	(set-goal gl-reactive-ranged-next 0)
	(set-goal gl-reactive-ranged-threat NO)
	(disable-self)
)

(defrule
	(true)
=>
	(up-get-fact game-time 0 gl-reactive-ranged-clock)
	(set-goal gl-reactive-ranged-scan NO)
)

(defrule
	(up-compare-goal gl-reactive-ranged-clock g:>= gl-reactive-ranged-next)
=>
	(set-goal gl-reactive-ranged-scan YES)
	(set-goal gl-reactive-ranged-threat NO)
	(up-modify-goal gl-reactive-ranged-focus s:= sn-focus-player-number)
	(up-modify-goal gl-reactive-ranged-next g:= gl-reactive-ranged-clock)
	(up-modify-goal gl-reactive-ranged-next c:+ 5)
)

(defrule
	(goal gl-reactive-ranged-scan YES)
	(goal gl-reactive-ranged-threat NO)
	(player-in-game 1)
	(stance-toward 1 enemy)
=>
	(set-strategic-number sn-focus-player-number 1)
	(up-full-reset-search)
	(up-find-remote c: archery-class c: 3)
	(up-get-search-state gl-reactive-ranged-local)
)

(defrule
	(goal gl-reactive-ranged-scan YES)
	(goal gl-reactive-ranged-threat NO)
	(player-in-game 1)
	(stance-toward 1 enemy)
	(up-compare-goal gl-reactive-ranged-remote c:>= 3)
=>
	(set-goal gl-reactive-ranged-threat YES)
)

