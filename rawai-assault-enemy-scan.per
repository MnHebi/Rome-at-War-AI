;Generated bounded literal-player hostility gate. No engine enemy iterator.

;The caller retains the original all-enemy waypoint AND landing danger scan.

(defrule
	(goal gl-transport-route-state TRANSPORT-ROUTE-UNSCREENED-SCAN)
=>
	(set-goal gl-assault-fallback-hostile NO)
)

(defrule
	(goal gl-transport-route-state TRANSPORT-ROUTE-UNSCREENED-SCAN)
	(goal gl-assault-fallback-player 1)
	(player-in-game 1)
	(stance-toward 1 enemy)
=>
	(set-goal gl-assault-fallback-hostile YES)
)

(defrule
	(goal gl-transport-route-state TRANSPORT-ROUTE-UNSCREENED-SCAN)
	(goal gl-assault-fallback-player 2)
