(defrule
	(or
		(goal map-type LAKE)
		(or
			(goal map-type RIVERS)
			(or
				(goal map-type ISLANDS)
				(goal map-type TEAM-ISLANDS)
			)
		)
	)
=>
	(set-goal gl-naval-theater YES)
)

(defrule
	(goal map-type LAND)
=>
	(set-goal gl-naval-theater NO)
	(set-goal gl-naval-role NAVAL-ROLE-UNASSIGNED)
	(set-goal upgrade-navy 0)
	(set-goal gl-naval-fleet-cap 0)
	(set-goal gl-naval-specialist-fleet-cap 0)
)

(defrule
	(goal gl-naval-theater YES)
	(goal good-navy NO)
	(goal gl-enemy-primary-navy YES)
=>
	(set-goal gl-naval-role NAVAL-ROLE-SUPPORT)
)

(defrule
	(goal gl-naval-theater YES)
	(goal team-game YES)
	(goal good-navy NO)
	(up-allied-goal any-ally good-navy == YES)
=>
	(set-goal gl-naval-role NAVAL-ROLE-SUPPORT)
)

(defrule
	(goal gl-naval-theater YES)
	(goal good-navy YES)
=>
	(set-goal gl-naval-role NAVAL-ROLE-PRIMARY)
)

(defrule
	(goal gl-naval-role NAVAL-ROLE-PRIMARY)
=>
	(up-modify-goal gl-naval-fleet-cap g:= gl-ten-percent)
	(up-modify-goal gl-naval-specialist-fleet-cap g:= gl-ten-percent)
	(set-goal upgrade-navy 1)
	(set-goal train-scoutships YES)
	(set-goal train-remes YES)
	(set-goal train-fireships YES)
	(set-goal train-demoships YES)
	(set-goal train-hemiolia YES)
	(set-goal train-boardingships YES)
)

(defrule
	(goal gl-naval-role NAVAL-ROLE-COMPETITIVE)
=>
	(up-modify-goal gl-naval-fleet-cap g:= gl-eight-percent)
	(up-modify-goal gl-naval-specialist-fleet-cap g:= gl-eight-percent)
	(set-goal upgrade-navy 1)
	(set-goal train-scoutships YES)
	(set-goal train-remes YES)
	(set-goal train-fireships YES)
	(set-goal train-demoships YES)
	(set-goal train-hemiolia YES)
	(set-goal train-boardingships YES)
)

(defrule
	(goal gl-naval-role NAVAL-ROLE-SUPPORT)
	(goal gl-naval-specialist-support NO)
=>
	(up-modify-goal gl-naval-fleet-cap g:= gl-three-percent)
	(up-modify-goal gl-naval-specialist-fleet-cap g:= gl-three-percent)
)

(defrule
	(goal gl-naval-role NAVAL-ROLE-SUPPORT)
	(goal gl-naval-specialist-support YES)
=>
	(up-modify-goal gl-naval-fleet-cap g:= gl-three-percent)
	(up-modify-goal gl-naval-specialist-fleet-cap g:= gl-five-percent)
)

(defrule
	(goal gl-naval-role NAVAL-ROLE-SUPPORT)
=>
	(set-goal upgrade-navy 1)
	(set-goal train-scoutships YES)
	(set-goal train-remes NO)
	(set-goal train-fireships YES)
	(set-goal train-demoships NO)
	(set-goal train-hemiolia NO)
	(set-goal train-boardingships YES)
	(set-goal naval-attack-percentage 0)
)

(defrule
	(goal gl-naval-capability-ready YES)
=>
	(up-get-fact unit-type-count-total warship-class gl-naval-fleet-count-total)
	(up-get-fact unit-type-count-total boarding-ship gl-naval-boarding-count-total)
	(up-modify-goal gl-naval-fleet-count-total g:+ gl-naval-boarding-count-total)
)

(defrule
	(goal gl-naval-role NAVAL-ROLE-PRIMARY)
	(up-compare-goal current-phase c:>= 5)
=>
	(up-modify-goal desired-number-shipyards c:= 4)
)

(defrule
	(goal gl-naval-role NAVAL-ROLE-PRIMARY)
	(up-compare-goal current-phase c:>= 7)
=>
	(up-modify-goal desired-number-shipyards c:= 8)
)

(defrule
	(goal gl-naval-role NAVAL-ROLE-COMPETITIVE)
	(up-compare-goal current-phase c:>= 5)
=>
	(up-modify-goal desired-number-shipyards c:= 3)
)

(defrule
	(goal gl-naval-role NAVAL-ROLE-COMPETITIVE)
	(up-compare-goal current-phase c:>= 7)
=>
	(up-modify-goal desired-number-shipyards c:= 6)
)

(defrule
	(goal gl-naval-role NAVAL-ROLE-SUPPORT)
	(up-compare-goal current-phase c:>= 5)
=>
	(up-modify-goal desired-number-shipyards c:= 2)
)

(defrule
	(goal gl-naval-role NAVAL-ROLE-SUPPORT)
	(up-compare-goal current-phase c:>= 7)
=>
	(up-modify-goal desired-number-shipyards c:= 2)
)
