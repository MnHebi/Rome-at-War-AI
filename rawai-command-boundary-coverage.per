(defrule
	(true)
=>
	(up-get-fact game-time 0 gl-cb-now)
)
;Generated independent coverage counters; no detail quota is shared.
(defrule
	(up-compare-goal gl-cb-b-calls c:> 0)
	(up-compare-goal gl-cb-now g:>= gl-cb-b-report)
=>
	(up-chat-data-to-all str-t12-diag-id c: 763)
	(up-chat-data-to-all str-t12-diag-value c: 1)
	(up-chat-data-to-all str-t12-diag-id c: 723)
	(up-chat-data-to-all str-t12-diag-value g: gl-cb-now)
	(up-chat-data-to-all str-t12-diag-id c: 771)
	(up-chat-data-to-all str-t12-diag-value g: gl-cb-enabled)
	(up-chat-data-to-all str-t12-diag-id c: 764)
	(up-chat-data-to-all str-t12-diag-value g: gl-cb-b-calls)
	(up-chat-data-to-all str-t12-diag-id c: 765)
	(up-chat-data-to-all str-t12-diag-value g: gl-cb-b-nonempty)
	(up-chat-data-to-all str-t12-diag-id c: 766)
	(up-chat-data-to-all str-t12-diag-value g: gl-cb-b-suppressed)
	(up-chat-data-to-all str-t12-diag-id c: 767)
	(up-chat-data-to-all str-t12-diag-value g: gl-cb-b-detailed)
	(up-chat-data-to-all str-t12-diag-id c: 768)
	(up-chat-data-to-all str-t12-diag-value g: gl-cb-b-missed)
	(up-chat-data-to-all str-t12-diag-id c: 769)
	(up-chat-data-to-all str-t12-diag-value g: gl-cb-b-targets)
	(up-chat-data-to-all str-t12-diag-id c: 770)
	(up-chat-data-to-all str-t12-diag-value g: gl-cb-b-invalid)
)
(defrule
	(up-compare-goal gl-cb-b-calls c:> 0)
	(up-compare-goal gl-cb-now g:>= gl-cb-b-report)
=>
	(up-modify-goal gl-cb-b-report g:= gl-cb-now)
	(up-modify-goal gl-cb-b-report c:+ 180)
)
(defrule
	(up-compare-goal gl-cb-r-calls c:> 0)
	(up-compare-goal gl-cb-now g:>= gl-cb-r-report)
=>
	(up-chat-data-to-all str-t12-diag-id c: 763)
	(up-chat-data-to-all str-t12-diag-value c: 2)
	(up-chat-data-to-all str-t12-diag-id c: 723)
	(up-chat-data-to-all str-t12-diag-value g: gl-cb-now)
	(up-chat-data-to-all str-t12-diag-id c: 771)
	(up-chat-data-to-all str-t12-diag-value g: gl-cb-enabled)
	(up-chat-data-to-all str-t12-diag-id c: 764)
	(up-chat-data-to-all str-t12-diag-value g: gl-cb-r-calls)
	(up-chat-data-to-all str-t12-diag-id c: 765)
	(up-chat-data-to-all str-t12-diag-value g: gl-cb-r-nonempty)
	(up-chat-data-to-all str-t12-diag-id c: 766)
	(up-chat-data-to-all str-t12-diag-value g: gl-cb-r-suppressed)
	(up-chat-data-to-all str-t12-diag-id c: 767)
	(up-chat-data-to-all str-t12-diag-value g: gl-cb-r-detailed)
	(up-chat-data-to-all str-t12-diag-id c: 768)
	(up-chat-data-to-all str-t12-diag-value g: gl-cb-r-missed)
	(up-chat-data-to-all str-t12-diag-id c: 769)
	(up-chat-data-to-all str-t12-diag-value g: gl-cb-r-targets)
	(up-chat-data-to-all str-t12-diag-id c: 770)
	(up-chat-data-to-all str-t12-diag-value g: gl-cb-r-invalid)
)
(defrule
	(up-compare-goal gl-cb-r-calls c:> 0)
	(up-compare-goal gl-cb-now g:>= gl-cb-r-report)
=>
	(up-modify-goal gl-cb-r-report g:= gl-cb-now)
	(up-modify-goal gl-cb-r-report c:+ 180)
)
