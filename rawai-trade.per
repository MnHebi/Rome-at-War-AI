;A taunt stays detected until it is acknowledged. These fallbacks deliberately
;follow every affordable response: when no earlier rule could send aid, consume
;the request now so it cannot trigger a stale donation after the donor recovers.
(defrule
	(taunt-detected any-ally 3)
=>
	(acknowledge-taunt this-any-ally 3)
)
(defrule
	(taunt-detected any-ally 4)
=>
	(acknowledge-taunt this-any-ally 4)
)
(defrule
	(taunt-detected any-ally 5)
=>
	(acknowledge-taunt this-any-ally 5)
)
(defrule
	(taunt-detected any-ally 6)
=>
	(acknowledge-taunt this-any-ally 6)
)
(defrule
	(taunt-detected any-ally TAUNT-REQUEST-FOOD-500)
=>
	(acknowledge-taunt this-any-ally TAUNT-REQUEST-FOOD-500)
)
