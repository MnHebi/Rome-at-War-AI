;request resources
;The request names a team-wide target. In a 4v4, each of the other three allies
;may independently answer with a 200-resource tranche, so the nominal response
;is bounded at 600 rather than multiplying a 600-resource tribute three times.
(defrule
	(goal dont-spam-requests NO)
	(players-building-type-count any-ally market >= 1)
	(food-amount < 100)
=>
	(chat-to-allies "3 Critically low on food; team please send 600 food")
	(set-goal dont-spam-requests YES)
)

(defrule
	(goal dont-spam-requests NO)
	(players-building-type-count any-ally market >= 1)
	(wood-amount < 100)
=>
	(chat-to-allies "4 Critically low on wood; team please send 600 wood")
	(set-goal dont-spam-requests YES)
)

(defrule
	(goal dont-spam-requests NO)
	(players-building-type-count any-ally market >= 1)
	(gold-amount < 100)
=>
	(chat-to-allies "5 Critically low on gold; team please send 600 gold")
	(set-goal dont-spam-requests YES)
)

(defrule
	(goal dont-spam-requests NO)
	(players-building-type-count any-ally market >= 1)
	(stone-amount < 100)
=>
	(chat-to-allies "6 Critically low on stone; team please send 600 stone")
	(set-goal dont-spam-requests YES)
)

;send resources
;Explicit player rules keep the acknowledgment, tribute target, and visible
;recipient label identical. Player numbers are stable engine IDs; colors remain
;independent lobby choices and are resolved only by replay metadata.
;Food donors retain at least the audited 1000-food Imperial reserve. Wood and
;stone donors retain 600, while gold donors retain the audited 800-gold reserve
;until Imperial Age and a 500-gold operating reserve afterward.
(defrule
	(taunt-detected 1 3)
	(stance-toward 1 ally)
	(building-type-count market > 0)
	(food-amount >= 1200)
=>
	(acknowledge-taunt 1 3)
	(tribute-to-player 1 food 200)
	(chat-to-allies "Sending 200 food to player 1")
)

(defrule
	(taunt-detected 2 3)
