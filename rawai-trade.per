;request resources
;Every tier requires a live stockpile below 100. The engine-maintained cumulative
;collected-resource bank chooses the amount: below 500 requests 100, 500..999
;requests 500, and 1000+ requests 1000.
;Per-resource deadlines prevent one persistent shortage from starving the other
;resource requests; the shared ten-second deadline prevents a simultaneous burst.
;food request tiers
(defrule
	(players-building-type-count any-ally market >= 1)
	(food-amount < 100)
	(up-compare-goal gl-request-food-bank c:>= RESOURCE-AID-BANK-1000)
	(up-compare-goal gl-game-time g:>= gl-request-food-next)
	(up-compare-goal gl-game-time g:>= gl-resource-request-next)
=>
	(chat-to-allies "245 Critically low on food; please send 1000 food")
	(up-chat-data-to-self "Requesting 1000 food; lifetime bank: %d" g: gl-request-food-bank)
	(up-modify-goal gl-request-food-next g:= gl-game-time)
	(up-modify-goal gl-request-food-next c:+ 120)
	(up-modify-goal gl-resource-request-next g:= gl-game-time)
	(up-modify-goal gl-resource-request-next c:+ 10)
)
(defrule
	(players-building-type-count any-ally market >= 1)
	(food-amount < 100)
	(up-compare-goal gl-request-food-bank c:>= RESOURCE-AID-BANK-500)
	(up-compare-goal gl-request-food-bank c:< RESOURCE-AID-BANK-1000)
	(up-compare-goal gl-game-time g:>= gl-request-food-next)
	(up-compare-goal gl-game-time g:>= gl-resource-request-next)
=>
	(chat-to-allies "241 Critically low on food; please send 500 food")
	(up-chat-data-to-self "Requesting 500 food; lifetime bank: %d" g: gl-request-food-bank)
	(up-modify-goal gl-request-food-next g:= gl-game-time)
	(up-modify-goal gl-request-food-next c:+ 120)
	(up-modify-goal gl-resource-request-next g:= gl-game-time)
	(up-modify-goal gl-resource-request-next c:+ 10)
)
(defrule
	(players-building-type-count any-ally market >= 1)
	(food-amount < 100)
	(up-compare-goal gl-request-food-bank c:< RESOURCE-AID-BANK-500)
