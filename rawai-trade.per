; ///////////////////////// FEUDAL

(defrule
	(current-age == early-antiquity-age)
	(gold-amount >= 900)
	(wood-amount <= 100)
	(commodity-buying-price wood <= 100)
	(can-buy-commodity wood)
=>
	(chat-local-to-self "buy wood")
	(buy-commodity wood)
)

(defrule
	(current-age == early-antiquity-age)
	(gold-amount >= 900)
	(food-amount <= 100)
	(commodity-buying-price food <= 100)
	(can-buy-commodity food)
=>
	(chat-local-to-self "buy food")
	(buy-commodity food)
)

(defrule
	(current-age == early-antiquity-age)
	(gold-amount >= 900)
	(stone-amount <= 100)
	(commodity-buying-price stone <= 200)
	(can-buy-commodity stone)
=>
	(chat-local-to-self "buy stone")
	(buy-commodity stone)
)

(defrule
	(current-age == early-antiquity-age)
	(wood-amount >= 500)
	(or
		(gold-amount < 100)
		(food-amount < 100)
	)
	(commodity-selling-price wood >= 50)
	(can-sell-commodity wood)
=>
	(chat-local-to-self "Gold panic; sell wood")
	(sell-commodity wood)
)

(defrule
	(current-age == early-antiquity-age)
	(food-amount >= 1000)
	(or
		(gold-amount < 100)
		(wood-amount < 100)
	)
	(can-sell-commodity food)
=>
	(chat-local-to-self "sell food")
	(sell-commodity food)
)

;****************************CASTLE

;The current DAT charges 1000 food and 800 gold for Imperial Age. After the
;normal preparation deadline, trade only to close those deficits: liquidate an
;excess resource for missing gold, or buy the last food tranche from a genuine
;gold surplus. A cooldown prevents command bursts from racing the age-up rule.
(defrule
	(current-age == middle-antiquity-age)
	(up-compare-goal age-up-started c:< IMPERIAL)
	(game-time >= 900)
	(up-timer-status t-age-market == timer-triggered)
	(gold-amount < 800)
	(wood-amount >= 400)
	(commodity-selling-price wood >= 30)
	(can-sell-commodity wood)
=>
	(sell-commodity wood)
	(up-set-timer c: t-age-market c: 20)
	(chat-local-to-self "Imperial bridge: sell excess wood for gold")
)

;A depleted starting island needs a 125-wood Transport Ship plus a 100-wood
;remote resource camp. Bridge that audited DAT package before normal age and
;military spending consumes the last movable reserve.
(defrule
	(current-age >= middle-antiquity-age)
	(goal gl-home-resource-pressure YES)
	(up-compare-goal gl-game-time g:>= gl-relocation-market-next)
	(wood-amount < 225)
	(gold-amount >= 200)
	(can-buy-commodity wood)
=>
	(buy-commodity wood)
	(up-modify-goal gl-relocation-market-next g:= gl-game-time)
	(up-modify-goal gl-relocation-market-next c:+ 20)
	(chat-local-to-self "Relocation bridge: buy wood")
)

(defrule
	(current-age >= middle-antiquity-age)
	(goal gl-home-resource-pressure YES)
	(up-compare-goal gl-game-time g:>= gl-relocation-market-next)
	(wood-amount < 225)
	(gold-amount < 200)
	(stone-amount >= 300)
	(can-sell-commodity stone)
=>
	(sell-commodity stone)
	(up-modify-goal gl-relocation-market-next g:= gl-game-time)
	(up-modify-goal gl-relocation-market-next c:+ 20)
	(chat-local-to-self "Relocation bridge: sell stone")
)

(defrule
	(current-age >= middle-antiquity-age)
	(goal gl-home-resource-pressure YES)
	(up-compare-goal gl-game-time g:>= gl-relocation-market-next)
	(wood-amount < 225)
	(gold-amount < 200)
	(stone-amount < 300)
	(food-amount >= 700)
	(can-sell-commodity food)
=>
	(sell-commodity food)
	(up-modify-goal gl-relocation-market-next g:= gl-game-time)
	(up-modify-goal gl-relocation-market-next c:+ 20)
	(chat-local-to-self "Relocation bridge: sell food")
)

