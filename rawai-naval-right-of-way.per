	(set-goal gl-row-stage 8)
)

(defrule
	(goal gl-row-stage 8)
	(goal gl-row-record 2)
	(up-set-target-object search-local c: 0)
=>
	(up-get-object-data object-data-target-id gl-row-m2-target)
	(up-modify-goal gl-row-m2-id g:= gl-row-merchant)
	(up-copy-point gl-row-m2-x gl-row-hold-x)
	(up-modify-goal gl-row-m2-zone g:= gl-row-zone)
	(up-modify-goal gl-row-m2-until g:= gl-row-clock)
	(up-modify-goal gl-row-m2-until c:+ 120)
	(up-modify-goal gl-row-m2-hold-until g:= gl-row-clock)
	(up-modify-goal gl-row-m2-hold-until c:+ 32)
	(up-modify-goal gl-row-m2-next g:= gl-row-clock)
	(up-modify-goal gl-row-m2-next c:+ 8)
	(set-goal gl-row-m2-renewals 0)
	(up-remove-objects search-local object-data-player != my-player-number)
	(up-remove-objects search-local object-data-group-flag >= 0)
	(up-target-point gl-row-hold-x action-move -1 stance-no-attack)
	(up-modify-goal gl-row-tries c:+ 1)
	(set-goal gl-row-active 1)
	(set-goal gl-row-issued 1)
	(up-chat-data-to-all str-t12-diag-id c: 420)
	(up-chat-data-to-all str-t12-diag-value g: gl-row-merchant)
	(up-chat-data-to-all str-t12-diag-id c: 421)
	(up-chat-data-to-all str-t12-diag-value g: gl-row-hull)
	(set-goal gl-row-stage 9)
)

(defrule
	(goal gl-row-stage 9)
=>
	(set-goal gl-row-found 0)
)

(defrule
	(goal gl-row-stage 9)
	(up-compare-goal gl-row-ban0-id g:== gl-row-hull)
=>
	(set-goal gl-row-found 1)
)

(defrule
	(goal gl-row-stage 9)
	(up-compare-goal gl-row-ban1-id g:== gl-row-hull)
=>
	(set-goal gl-row-found 1)
)

(defrule
	(goal gl-row-stage 9)
	(up-compare-goal gl-row-ban2-id g:== gl-row-hull)
=>
	(set-goal gl-row-found 1)
)

(defrule
	(goal gl-row-stage 9)
	(up-compare-goal gl-row-ban3-id g:== gl-row-hull)
=>
	(set-goal gl-row-found 1)
)

(defrule
	(goal gl-row-stage 9)
	(goal gl-row-found 0)
	(up-compare-goal gl-row-ban0-id c:< 0)
=>
	(up-modify-goal gl-row-ban0-id g:= gl-row-hull)
	(up-modify-goal gl-row-ban0-until g:= gl-row-clock)
	(up-modify-goal gl-row-ban0-until c:+ 180)
	(set-goal gl-row-found 1)
)

(defrule
	(goal gl-row-stage 9)
	(goal gl-row-found 0)
	(up-compare-goal gl-row-ban1-id c:< 0)
=>
	(up-modify-goal gl-row-ban1-id g:= gl-row-hull)
	(up-modify-goal gl-row-ban1-until g:= gl-row-clock)
	(up-modify-goal gl-row-ban1-until c:+ 180)
	(set-goal gl-row-found 1)
)

(defrule
	(goal gl-row-stage 9)
	(goal gl-row-found 0)
	(up-compare-goal gl-row-ban2-id c:< 0)
=>
	(up-modify-goal gl-row-ban2-id g:= gl-row-hull)
	(up-modify-goal gl-row-ban2-until g:= gl-row-clock)
	(up-modify-goal gl-row-ban2-until c:+ 180)
	(set-goal gl-row-found 1)
)

(defrule
	(goal gl-row-stage 9)
	(goal gl-row-found 0)
	(up-compare-goal gl-row-ban3-id c:< 0)
=>
	(up-modify-goal gl-row-ban3-id g:= gl-row-hull)
	(up-modify-goal gl-row-ban3-until g:= gl-row-clock)
	(up-modify-goal gl-row-ban3-until c:+ 180)
	(set-goal gl-row-found 1)
)

(defrule
	(goal gl-row-stage 9)
=>
	(set-goal gl-row-stage 0)
)

(defrule
	(goal gl-row-stage 8)
=>
	(set-goal gl-row-stage 0)
)
