(defrule
	(goal gl-transport-route-state AP-SAFETY)
	(player-in-game 1)
	(stance-toward 1 enemy)
=>
	(set-strategic-number sn-focus-player-number 1)
	(up-full-reset-search)
	(up-set-target-point gl-transport-route-landing-x)
	(up-filter-distance c: -1 c: 20)
	(up-find-remote c: tower-class c: 40)
	(up-find-remote c: sea-tower c: 40)
	(up-find-remote c: castle c: 40)
	(up-find-remote c: town-center c: 40)
	(up-get-search-state local-total)
	(up-modify-goal gl-ap-landing-threats g:+ remote-total)
	(up-full-reset-search)
	(up-set-target-point gl-transport-route-waypoint-x)
	(up-filter-distance c: -1 c: 20)
