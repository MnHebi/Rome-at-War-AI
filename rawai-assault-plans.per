=>
	(set-goal gl-transport-route-state AP-CANDIDATE)
)

(defrule
	(goal gl-transport-route-state AP-CANDIDATE)
	(up-compare-goal gl-ap-candidate c:>= 5)
=>
	(set-goal gl-transport-route-state AP-OBJECTIVE-FAILED)
)

(defrule
	(goal gl-transport-route-state AP-CANDIDATE)
	(goal gl-ap-candidate 0)
=>
	(up-bound-point gl-transport-route-landing-x gl-transport-route-target-x)
	(set-goal gl-ap-zone -1)
	(up-get-point-zone gl-transport-route-landing-x gl-ap-zone)
	(set-goal gl-ap-valid YES)
	(set-goal gl-ap-blocked NO)
	(up-modify-goal gl-ap-min-x g:= gl-transport-route-landing-x)
	(up-modify-goal gl-ap-min-x c:- 12)
	(up-modify-goal gl-ap-max-x g:= gl-transport-route-landing-x)
	(up-modify-goal gl-ap-max-x c:+ 12)
	(up-modify-goal gl-ap-min-y g:= gl-transport-route-landing-y)
	(up-modify-goal gl-ap-min-y c:- 12)
	(up-modify-goal gl-ap-max-y g:= gl-transport-route-landing-y)
	(up-modify-goal gl-ap-max-y c:+ 12)
	(set-goal gl-transport-route-state AP-CACHE)
)

(defrule
	(goal gl-transport-route-state AP-CANDIDATE)
	(goal gl-ap-candidate 1)
=>
	(up-bound-point gl-transport-route-landing-x gl-transport-route-target-x)
	(up-cross-tiles gl-transport-route-landing-x gl-transport-route-origin-x c: 28)
	(set-goal gl-ap-zone -1)
	(up-get-point-zone gl-transport-route-landing-x gl-ap-zone)
	(set-goal gl-ap-valid YES)
	(set-goal gl-ap-blocked NO)
