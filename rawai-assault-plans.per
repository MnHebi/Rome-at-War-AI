	(goal gl-transport-route-state AP-NEXT-OBJECTIVE)
=>
	(up-modify-sn sn-focus-player-number g:= gl-assault-manifest-player)
	(up-full-reset-search)
	(up-set-target-point gl-transport-route-target-x)
	(up-find-remote c: town-center c: 20)
	(up-find-remote c: market c: 20)
	(up-find-remote c: barracks c: 20)
	(up-find-remote c: archery-range c: 20)
	(up-find-remote c: stable c: 20)
	(up-find-remote c: siege-workshop c: 20)
	(up-find-remote c: castle c: 20)
	(up-find-remote c: house c: 20)
	(up-remove-objects search-remote object-data-player g:!= gl-assault-manifest-player)
	(up-remove-objects search-remote object-data-hitpoints <= 0)
	(up-remove-objects search-remote object-data-map-zone-id g:!= gl-transport-route-target-zone)
	(up-remove-objects search-remote object-data-distance < 24)
	(up-remove-objects search-remote object-data-id g:== gl-ap-seen1)
	(up-remove-objects search-remote object-data-id g:== gl-ap-seen2)
	(up-remove-objects search-remote object-data-id g:== gl-ap-seen3)
	(up-clean-search search-remote object-data-distance search-order-asc)
)

