(defrule
	(goal gl-transport-route-state AP-SAFE-CHECK)
	(up-compare-goal gl-ap-landing-threats c:> 0)
=>
	(set-goal gl-ap-failure 11)
	(set-goal gl-transport-route-state AP-FAIL)
)

