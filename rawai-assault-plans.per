;Generated loaded-assault planner. Only preparation owns this state.

;Reasons: screening2/4/6/7/8/10/11;21 topology;22 total budget;

;23 enemy budget;24 invalid hull/manifest;26 no alternative enemy;

;27 maximum opponents tried;28 enemy unavailable;29 no longer hostile.

;32 fallback danger;33 fallback topology;35 fallback Scout invalid.

;after-failure:0 next approach,2 next enemy,3 terminal recovery.

;A failed beach is excluded. Different beaches require fresh checks.

(defrule
	(true)
=>
	(set-goal gl-ap-active NO)
	(set-goal gl-ap-write 1)
	(set-goal gl-ap-preferred-enemy -1)
	(set-goal gl-ap-memory1-until 0)
	(set-goal gl-ap-memory2-until 0)
	(set-goal gl-ap-memory3-until 0)
	(set-goal gl-ap-memory4-until 0)
	(set-goal gl-ap-memory5-until 0)
	(set-goal gl-ap-memory6-until 0)
	(set-goal gl-ap-memory7-until 0)
	(set-goal gl-ap-memory8-until 0)
	(set-goal gl-ap-memory9-until 0)
	(set-goal gl-ap-memory10-until 0)
	(set-goal gl-ap-memory11-until 0)
	(set-goal gl-ap-memory12-until 0)
	(set-goal gl-ap-memory13-until 0)
	(set-goal gl-ap-memory14-until 0)
	(set-goal gl-ap-memory15-until 0)
	(set-goal gl-ap-memory16-until 0)
	(disable-self)
)

(defrule
	(true)
=>
	(up-get-fact game-time 0 gl-ap-clock)
)

(defrule
	(goal gl-transport-route-state TRANSPORT-ROUTE-IDLE)
=>
	(set-goal gl-ap-active NO)
)

(defrule
	(goal gl-transport-route-state TRANSPORT-ROUTE-RECOVERY-WAIT)
=>
	(set-goal gl-ap-active NO)
)

(defrule
	(goal gl-transport-route-state TRANSPORT-ROUTE-OWNER-LOST)
=>
	(set-goal gl-ap-active NO)
)

(defrule
	(goal gl-transport-route-state 101)
=>
	(set-goal gl-ap-active NO)
)

(defrule
	(goal gl-transport-route-state TRANSPORT-ROUTE-TARGET)
	(goal gl-transport-route-script-load YES)
=>
	(up-full-reset-search)
	(up-add-object-by-id search-remote g: gl-assault-admission-objective)
	(up-remove-objects search-remote object-data-player g:!= gl-assault-manifest-player)
	(up-remove-objects search-remote object-data-hitpoints <= 0)
	(up-remove-objects search-remote object-data-map-zone-id < 0)
	(up-remove-objects search-remote object-data-map-zone-id g:== gl-home-zone)
)

(defrule
	(goal gl-transport-route-state TRANSPORT-ROUTE-TARGET)
=>
	(set-goal gl-ap-active YES)
	(up-modify-goal gl-ap-hull g:= gl-transport-route-id)
	(up-modify-goal gl-ap-until g:= gl-ap-clock)
	(up-modify-goal gl-ap-until c:+ AP-MISSION-SECONDS)
	(up-modify-goal gl-ap-enemy-until g:= gl-ap-clock)
	(up-modify-goal gl-ap-enemy-until c:+ AP-ENEMY-SECONDS)
	(set-goal gl-ap-enemies-tried 1)
	(set-goal gl-ap-objective-count 0)
	(set-goal gl-ap-seen1 -1)
	(set-goal gl-ap-seen2 -1)
	(set-goal gl-ap-seen3 -1)
	(set-goal gl-ap-objective -1)
	(set-goal gl-ap-valid NO)
	(set-goal gl-ap-after-failure 0)
	(set-goal gl-ap-enemy1-visited NO)
	(set-goal gl-ap-enemy2-visited NO)
	(set-goal gl-ap-enemy3-visited NO)
	(set-goal gl-ap-enemy4-visited NO)
	(set-goal gl-ap-enemy5-visited NO)
	(set-goal gl-ap-enemy6-visited NO)
	(set-goal gl-ap-enemy7-visited NO)
	(set-goal gl-ap-enemy8-visited NO)
	(set-goal gl-transport-route-state AP-BEGIN)
)

(defrule
	(goal gl-transport-route-state AP-BEGIN)
	(up-set-target-object search-remote c: 0)
=>
	(up-get-object-data object-data-id gl-ap-objective)
	(up-get-point position-object gl-transport-route-target-x)
)

(defrule
	(goal gl-transport-route-state AP-BEGIN)
	(goal gl-transport-route-script-load YES)
	(not (up-set-target-object search-remote c: 0))
=>
	(set-goal gl-ap-failure 30)
	(set-goal gl-transport-route-state AP-ENEMY-SEARCH)
)

(defrule
	(goal gl-transport-route-state AP-BEGIN)
=>
	(set-goal gl-transport-route-state AP-OBJECTIVE)
)

(defrule
	(goal gl-ap-active YES)
=>
	(set-goal gl-ap-live NO)
)

(defrule
	(goal gl-ap-active YES)
	(goal gl-assault-manifest-player 1)
	(player-in-game 1)
	(stance-toward 1 enemy)
=>
	(set-goal gl-ap-live YES)
)

