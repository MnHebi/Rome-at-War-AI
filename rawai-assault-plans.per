	(up-find-remote c: siege-workshop c: 20)
	(up-find-remote c: castle c: 20)
	(up-find-remote c: house c: 20)
	(up-remove-objects search-remote object-data-player g:!= gl-assault-manifest-player)
	(up-remove-objects search-remote object-data-hitpoints <= 0)
	(up-remove-objects search-remote object-data-id g:== gl-ap-seen1)
	(up-remove-objects search-remote object-data-id g:== gl-ap-seen2)
	(up-remove-objects search-remote object-data-id g:== gl-ap-seen3)
	(up-clean-search search-remote object-data-distance search-order-asc)
)

(defrule
	(goal gl-transport-route-state AP-ENEMY-SEARCH)
	(goal gl-transport-route-script-load YES)
=>
	(up-remove-objects search-remote object-data-map-zone-id < 0)
	(up-remove-objects search-remote object-data-map-zone-id g:== gl-home-zone)
)

(defrule
	(goal gl-transport-route-state AP-ENEMY-SEARCH)
	(up-set-target-object search-remote c: 0)
=>
	(up-get-object-data object-data-id gl-ap-objective)
	(up-get-point position-object gl-transport-route-target-x)
	(set-goal gl-transport-route-state AP-OBJECTIVE)
)

(defrule
	(goal gl-transport-route-state AP-ENEMY-SEARCH)
=>
	(set-goal gl-transport-route-state AP-ENEMY-FAILED)
)

(defrule
	(goal gl-transport-route-state AP-TERMINAL)
=>
	(set-goal gl-ap-active NO)
	(set-goal gl-transport-route-state TRANSPORT-ROUTE-SCREEN-RECALL)
)
