(defrule
	(goal gl-ap-active YES)
	(goal gl-ap-live NO)
=>
	(set-goal gl-transport-route-state AP-NEXT-ENEMY)
)

(defrule
	(goal gl-ap-active YES)
=>
	(up-full-reset-search)
	(up-add-object-by-id search-local g: gl-transport-route-id)
	(up-remove-objects search-local object-data-player != my-player-number)
	(up-remove-objects search-local object-data-group-flag != attack-transport-group)
)

(defrule
	(goal gl-ap-active YES)
	(not (up-set-target-object search-local c: 0))
=>
	(set-goal gl-ap-active NO)
	(set-goal gl-transport-route-state TRANSPORT-ROUTE-OWNER-LOST)
)

(defrule
	(goal gl-ap-active YES)
	(up-set-target-object search-local c: 0)
	(or (up-compare-goal gl-ap-hull g:!= gl-transport-route-id)
	(or (up-compare-goal gl-assault-manifest-hull g:!= gl-transport-route-id)
	(or (up-compare-goal gl-assault-manifest-count c:< 5)
	(or (up-object-data object-data-garrison-count g:< gl-assault-manifest-count)
	(or (up-object-data object-data-hitpoints <= 0)
	(up-object-data object-data-under-attack > 0))))))
=>
	(set-goal gl-ap-failure 24)
	(set-goal gl-transport-route-state AP-TERMINAL)
)

(defrule
	(goal gl-ap-active YES)
	(goal gl-ap-after-failure 0)
	(up-compare-goal gl-ap-clock g:>= gl-ap-until)
	(not (goal gl-transport-route-state AP-TERMINAL))
	(not (goal gl-transport-route-state AP-NEXT-ENEMY))
=>
	(set-goal gl-ap-failure 22)
	(set-goal gl-ap-after-failure 3)
	(set-goal gl-transport-route-state AP-FAIL)
)

(defrule
	(goal gl-ap-active YES)
	(goal gl-ap-after-failure 0)
	(up-compare-goal gl-ap-clock g:>= gl-ap-enemy-until)
	(not (goal gl-transport-route-state AP-TERMINAL))
	(not (goal gl-transport-route-state AP-NEXT-ENEMY))
=>
	(set-goal gl-ap-failure 23)
	(set-goal gl-ap-after-failure 2)
	(set-goal gl-transport-route-state AP-FAIL)
)

(defrule
	(goal gl-transport-route-state AP-OBJECTIVE)
=>
	(set-goal gl-transport-route-target-zone -1)
	(up-get-point-zone gl-transport-route-target-x gl-transport-route-target-zone)
	(up-modify-goal gl-ap-objective-count c:+ 1)
	(set-goal gl-ap-candidate 0)
	(set-goal gl-ap-valid NO)
	(up-modify-goal gl-ap-preferred-enemy g:= gl-assault-manifest-player)
)

(defrule
	(goal gl-transport-route-state AP-OBJECTIVE)
	(goal gl-ap-objective-count 1)
=>
	(up-modify-goal gl-ap-seen1 g:= gl-ap-objective)
