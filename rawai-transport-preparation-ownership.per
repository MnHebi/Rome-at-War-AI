										(or (goal gl-island-migration-state MIGRATION-ROUTE-LEFT)
											(or (goal gl-island-migration-state MIGRATION-ROUTE-RIGHT)
												(goal gl-island-migration-state MIGRATION-ROUTE-APPLY))))))))))))
	(up-set-target-object search-local c: 0)
