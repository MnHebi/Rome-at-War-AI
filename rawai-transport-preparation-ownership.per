	(up-remove-objects search-local object-data-player != my-player-number)
	(up-remove-objects search-local object-data-group-flag >= 0)
	(up-remove-objects search-local object-data-idling != 1)
	(up-remove-objects search-local object-data-under-attack > 0)
	(up-create-group 0 0 c: attack-transport-group)
	(up-modify-group-flag 1 c: attack-transport-group)
)

;CB BEGIN 1853
(defrule
	(goal gl-transport-route-state TRANSPORT-ROUTE-OWNER-LOST)
	(up-set-target-object search-local c: 0)
	(up-object-data object-data-player == my-player-number)
	(up-object-data object-data-group-flag == attack-transport-group)
=>
	(set-goal gl-cbf-cont 1853)
)
(defrule
	(goal gl-cbf-cont 1853)
=>
	(up-remove-objects search-local object-data-player != my-player-number)
	(up-remove-objects search-local object-data-group-flag != attack-transport-group)
)
(defrule
	(goal gl-cbf-cont 1853)
=>
	(set-goal gl-cbf-site 1853)
	(set-goal gl-cbf-kind 1)
	(up-modify-goal gl-cbf-args0 g:= gl-transport-route-origin-x)
	(set-goal gl-cbf-args1 action-unload)
	(set-goal gl-cbf-args2 -1)
	(set-goal gl-cbf-args3 stance-no-attack)
	(up-modify-goal gl-cbf-point-y g:= gl-transport-route-origin-y)
	(up-get-rule-id gl-cbf-return)
	(up-modify-goal gl-cbf-return c:+ 1)
	(up-jump-direct g: gl-cbf-entry)
)
(defrule
	(goal gl-cbf-cont 1853)
=>
	(up-target-point gl-transport-route-origin-x action-unload -1 stance-no-attack)
)
(defrule
	(goal gl-cbf-cont 1853)
=>
	(set-goal gl-cbf-site 1853)
	(set-goal gl-cbf-kind 2)
	(up-modify-goal gl-cbf-args0 g:= gl-transport-route-origin-x)
	(set-goal gl-cbf-args1 action-unload)
	(set-goal gl-cbf-args2 -1)
	(set-goal gl-cbf-args3 stance-no-attack)
	(up-modify-goal gl-cbf-point-y g:= gl-transport-route-origin-y)
	(up-get-rule-id gl-cbf-return)
	(up-modify-goal gl-cbf-return c:+ 1)
	(up-jump-direct g: gl-cbf-entry)
)
(defrule
	(goal gl-cbf-cont 1853)
=>
	(up-chat-data-to-all "RAW17 assault owner recovery hull: %d" g: gl-transport-route-id)
	(up-modify-sn sn-focus-player-number g:= gl-transport-route-focus)
	(up-set-timer c: t-transport-route c: 15)
	(set-goal gl-route-unload-attempts 0)
	(set-goal gl-transport-route-state TRANSPORT-ROUTE-RECOVERY-WAIT)
)
(defrule
	(goal gl-cbf-cont 1853)
=>
	(set-goal gl-cbf-cont 0)
)
;CB END 1853

(defrule
	(goal gl-transport-route-state TRANSPORT-ROUTE-OWNER-LOST)
=>
	(up-chat-data-to-all "RAW17 assault owner yield hull: %d" g: gl-transport-route-id)
	(up-full-reset-search)
	(up-set-group search-local c: attack-boarding-group)
	(up-remove-objects search-local object-data-player != my-player-number)
	(up-remove-objects search-local object-data-group-flag != attack-boarding-group)
	(up-create-group 0 0 c: attack-boarding-group)
	(up-modify-group-flag 0 c: attack-boarding-group)
	(up-reset-group c: attack-boarding-group)
	(up-modify-sn sn-focus-player-number g:= gl-transport-route-focus)
	(up-set-timer c: t-transport-route c: 60)
	(set-goal gl-transport-route-state TRANSPORT-ROUTE-IDLE)
)
