(defrule
	(goal gl-island-migration-state MIGRATION-OWNER-LOST)
	(up-set-target-object search-local c: 0)
=>
	(up-get-object-data object-data-group-flag gl-transport-observed-value)
	(up-get-object-data object-data-order gl-transport-observed-value)
)

(defrule
	(goal gl-island-migration-state MIGRATION-OWNER-LOST)
	(up-set-target-object search-local c: 0)
	(up-object-data object-data-player == my-player-number)
	(up-object-data object-data-group-flag < 0)
	(up-object-data object-data-idling == 1)
	(up-object-data object-data-under-attack == 0)
=>
	(up-remove-objects search-local object-data-player != my-player-number)
	(up-remove-objects search-local object-data-group-flag >= 0)
	(up-remove-objects search-local object-data-idling != 1)
	(up-remove-objects search-local object-data-under-attack > 0)
	(up-create-group 0 0 c: migration-transport-group)
	(up-modify-group-flag 1 c: migration-transport-group)
)

(defrule
	(goal gl-island-migration-state MIGRATION-OWNER-LOST)
	(up-set-target-object search-local c: 0)
	(up-object-data object-data-player == my-player-number)
	(up-object-data object-data-group-flag == migration-transport-group)
=>
	;OWNERSHIP command: migration-transport-group.
	(up-remove-objects search-local object-data-player != my-player-number)
	(up-remove-objects search-local object-data-group-flag != migration-transport-group)
	(up-target-point gl-island-migration-origin-x action-unload -1 stance-no-attack)
	(up-modify-sn sn-focus-player-number g:= gl-island-migration-focus)
	(up-set-timer c: t-island-migration c: 15)
	(set-goal gl-island-migration-route-waits 0)
	(set-goal gl-island-migration-rejection-armed NO)
	(set-goal gl-island-migration-state MIGRATION-RETURNING)
)

(defrule
	(goal gl-island-migration-state MIGRATION-OWNER-LOST)
=>
	(up-full-reset-search)
	(up-set-group search-local c: migration-boarding-group)
	(up-remove-objects search-local object-data-player != my-player-number)
	(up-remove-objects search-local object-data-group-flag != migration-boarding-group)
	(up-create-group 0 0 c: migration-boarding-group)
	(up-modify-group-flag 0 c: migration-boarding-group)
	(up-reset-group c: migration-boarding-group)
	(up-modify-sn sn-focus-player-number g:= gl-island-migration-focus)
	(up-set-timer c: t-island-migration c: 60)
	(set-goal gl-island-migration-state MIGRATION-IDLE)
)

