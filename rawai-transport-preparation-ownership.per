;Generated by tools/generate_assault_missions.py. T17 preparation lease guard.

;Claim acknowledgement is in rawai-military.per. This catches later loss.

;No active independent voyage is eligible for this handler.

(defrule
	(or (goal gl-island-migration-state MIGRATION-BOARDING)
		(or (goal gl-island-migration-state MIGRATION-LOADING)
			(or (goal gl-island-migration-state MIGRATION-CHECK-LOAD)
				(or (goal gl-island-migration-state MIGRATION-ISSUE-BOARD)
					(or (goal gl-island-migration-state MIGRATION-OWNERSHIP-CLAIM)
						(or (goal gl-island-migration-state MIGRATION-LOAD-DIAG-FIND)
							(or (goal gl-island-migration-state MIGRATION-LOAD-DIAG-PASSENGER)
								(or (goal gl-island-migration-state MIGRATION-LOAD-DIAG-APPLY)
									(or (goal gl-island-migration-state MIGRATION-ROUTE-PREPARE)
										(or (goal gl-island-migration-state MIGRATION-ROUTE-LEFT)
											(or (goal gl-island-migration-state MIGRATION-ROUTE-RIGHT)
												(goal gl-island-migration-state MIGRATION-ROUTE-APPLY))))))))))))
=>
	(set-goal gl-transport-preparation-owned NO)
	(up-full-reset-search)
	(up-add-object-by-id search-local g: gl-island-migration-transport-id)
)

(defrule
	(or (goal gl-island-migration-state MIGRATION-BOARDING)
		(or (goal gl-island-migration-state MIGRATION-LOADING)
