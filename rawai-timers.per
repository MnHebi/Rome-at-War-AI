
(defrule
	(true)
=>
	(generate-random-number 121)
	(up-get-fact random-number 0 gl-attack-timer-random)
	(up-modify-goal gl-attack-timer-next g:= gl-attack-timer-random)
	(up-modify-goal gl-attack-timer-next c:+ 540)
	(up-set-timer c: t-land-attack g: gl-attack-timer-next)
	(generate-random-number 121)
	(up-get-fact random-number 0 gl-attack-timer-random)
	(up-modify-goal gl-attack-timer-next g:= gl-attack-timer-random)
	(up-modify-goal gl-attack-timer-next c:+ 540)
	(up-set-timer c: t-naval-attack g: gl-attack-timer-next)
	
	(disable-self)
)

;timer 3, land attack timer

(defrule
	(up-timer-status t-land-attack != timer-running)
=>
	(generate-random-number 61)
	(up-get-fact random-number 0 gl-attack-timer-random)
	(up-modify-goal gl-attack-timer-next g:= land-attack-interval)
	(up-modify-goal gl-attack-timer-next g:+ gl-attack-timer-random)
	(up-set-timer c: t-land-attack g: gl-attack-timer-next)
)

;timer 4, naval attack timer

(defrule
	(up-timer-status t-naval-attack != timer-running)
=>
	(generate-random-number 61)
	(up-get-fact random-number 0 gl-attack-timer-random)
	(up-modify-goal gl-attack-timer-next g:= naval-attack-interval)
	(up-modify-goal gl-attack-timer-next g:+ gl-attack-timer-random)
	(up-set-timer c: t-naval-attack g: gl-attack-timer-next)
)

;timer 5, farms

(defrule
	(up-timer-status t-farm-check != timer-running)
=>
	(up-set-timer c: t-farm-check c: 30)
)
;This module is loaded after every conditional rush module in AI RAW. All
;attack-now producers retain COMPLETE ownership until this post-dispatch rule,
;preventing a later rush from issuing a second global attack in the same sweep.
(defrule
	(goal current-action ACTION-ATTACK)
	(goal gl-attack-dispatch-owner ATTACK-DISPATCH-COMPLETE)
=>
	;Commit the just-completed attack for a bounded window so a lone nearby enemy
	;cannot immediately global-retreat the army back into the defense latch.
	(up-modify-goal gl-attack-dwell-until g:= gl-game-time)
	(up-modify-goal gl-attack-dwell-until c:+ 45)
	(set-goal gl-attack-dispatch-owner ATTACK-DISPATCH-NONE)
	(set-goal current-action ACTION-WAIT)
)

;A naval dispatch wakes the opportunistic-vessel controller instead of issuing
;a global attack-now, so it must not arm the attack-commitment dwell.
(defrule
	(goal current-action ACTION-ATTACK)
	(goal gl-attack-dispatch-owner ATTACK-DISPATCH-NAVAL-WAKE)
=>
	(set-goal gl-attack-dispatch-owner ATTACK-DISPATCH-NONE)
	(set-goal current-action ACTION-WAIT)
)

;timer 46, finalized farm-demand telemetry

(defrule
	(up-timer-status t-farm-report != timer-running)
=>
	(up-set-timer c: t-farm-report c: 30)
)

;timer 47, starting-land mine pressure for island migration

(defrule
