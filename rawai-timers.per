	(up-modify-goal gl-attack-timer-next g:= periodic-attack-interval)
	(up-modify-goal gl-attack-timer-next g:+ gl-attack-timer-random)
	(up-set-timer c: t-periodic-attack g: gl-attack-timer-next)
)

(defrule
	(up-timer-status t-attack-type != timer-running)
=>
