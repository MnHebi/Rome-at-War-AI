;CB BEGIN 1146
(defrule
	(or (up-compare-goal villager-count <= 0)
	    (not (goal gl-transport-route-state TRANSPORT-ROUTE-IDLE)))
=>
	(up-jump-rule 15))
;CB END 1146
(defrule
	(true)
=>
	(set-goal temporary-goal 0)
	(up-full-reset-search)
	(up-filter-exclude -1 actionid-explore orderid-explore -1)
	(up-find-local c: villager-class g: villager-count)
	;Borrow the empty preparation hull group only while that owner is IDLE.
	;Group 0 now belongs to an independent assault voyage; never touch it here.
	;The jump above skips this complete scratch lifetime during preparation.
	(up-remove-objects search-local object-data-group-flag >= 0)
	(up-remove-objects search-local object-data-id g:== gl-boar-lurer-id)
	(up-remove-objects search-local object-data-target == tree-class)
	(up-create-group 0 0 c: attack-transport-group)
	(up-modify-group-flag 1 c: attack-transport-group)
	(up-get-search-state local-total)
	(up-remove-objects search-local object-data-index g:!= temporary-goal))
;CB BEGIN 1147
(defrule
	(up-set-target-object search-local c: 0)
	(up-object-data object-data-target-id == -1)
(or	(up-object-data object-data-order == orderid-attack)
(or	(up-object-data object-data-order == orderid-build)
(or	(up-object-data object-data-order == orderid-repair)
	(up-object-data object-data-order == orderid-enter))))
=>
	(set-goal gl-cbf-cont 1147)
)
(defrule
	(goal gl-cbf-cont 1147)
=>
	(up-remove-objects search-local object-data-player != my-player-number)
	(up-remove-objects search-local object-data-group-flag != attack-transport-group)
	(up-modify-goal gl-command-counter-1 c:+ 1)
)
(defrule
	(goal gl-cbf-cont 1147)
=>
	(set-goal gl-cbf-site 1147)
	(set-goal gl-cbf-kind 1)
	(set-goal gl-cbf-args0 0)
	(set-goal gl-cbf-args1 action-stop)
	(set-goal gl-cbf-args2 -1)
	(set-goal gl-cbf-args3 -1)
	(set-goal gl-cbf-point-y -2)
	(up-get-rule-id gl-cbf-return)
	(up-modify-goal gl-cbf-return c:+ 1)
	(up-jump-direct g: gl-cbf-entry)
)
(defrule
	(goal gl-cbf-cont 1147)
=>
	(up-target-point 0 action-stop -1 -1)
)
(defrule
	(goal gl-cbf-cont 1147)
=>
	(set-goal gl-cbf-site 1147)
	(set-goal gl-cbf-kind 2)
	(set-goal gl-cbf-args0 0)
	(set-goal gl-cbf-args1 action-stop)
	(set-goal gl-cbf-args2 -1)
	(set-goal gl-cbf-args3 -1)
	(set-goal gl-cbf-point-y -2)
	(up-get-rule-id gl-cbf-return)
	(up-modify-goal gl-cbf-return c:+ 1)
	(up-jump-direct g: gl-cbf-entry)
)
(defrule
	(goal gl-cbf-cont 1147)
=>
	(set-goal gl-cbf-cont 0)
)
;CB END 1147
