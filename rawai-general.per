(defrule
	(up-compare-sn sn-number-explore-groups g:!= desired-military-explorers)
=>
	(up-modify-sn sn-number-explore-groups g:= desired-military-explorers))

(defrule
	(up-compare-sn sn-cap-civilian-explorers g:!= desired-civilian-explorers)
=>
	(up-modify-sn sn-cap-civilian-explorers g:= desired-civilian-explorers))

(defrule
	(up-compare-sn sn-minimum-civilian-explorers g:!= desired-civilian-explorers)
=>
	(up-modify-sn sn-minimum-civilian-explorers g:= desired-civilian-explorers))

(defrule
	(up-compare-sn sn-number-boat-explore-groups c:!= 0)
=>
	;The engine boat-explorer selector has no hull allowlist and can draft siege
	;ships. A DUC controller in rawai-military owns Scout Ship exploration.
	(set-strategic-number sn-number-boat-explore-groups 0))

(defrule
	(up-compare-goal current-phase c:< 4)
	(up-compare-sn sn-total-number-explorers c:!= 2)
=>
	;The engine owns at most two early explorers. Late-phase scouting belongs to
	;the bounded naval and military DUC controllers instead.
	(set-strategic-number sn-total-number-explorers 2))

(defrule
	(up-compare-goal current-phase c:>= 4)
	(up-compare-sn sn-total-number-explorers c:!= 0)
=>
	;Retire the engine explorer owner after the Middle Age so it cannot alternate
	;explore and stop orders with attack, defense, or trade controllers.
	(set-strategic-number sn-total-number-explorers 0))

(defrule
	(up-compare-goal villager-count <= 0)
=>
	(up-jump-rule 5))
(defrule
	(true)
=>
	(set-goal temporary-goal 0)
	(up-full-reset-search)
	(up-filter-exclude -1 actionid-explore orderid-explore -1)
	(up-find-local c: villager-class g: villager-count)
	;P3B44T6: temporary group 0 replaced the migrant reservation, then its
	;cleanup cleared that flag. Keep the transport owner's passengers out of
	;both generic stop handling and temporary-group flag mutations.
	(up-remove-objects search-local object-data-group-flag == migration-boarding-group)
	(up-remove-objects search-local object-data-target == tree-class)
	(up-create-group 0 0 c: 0)
	(up-modify-group-flag 1 c: 0)
	(up-get-search-state local-total)
	(up-remove-objects search-local object-data-index g:!= temporary-goal))
(defrule
	(up-set-target-object search-local c: 0)
	(up-object-data object-data-target-id == -1)
(or	(up-object-data object-data-order == orderid-attack)
(or	(up-object-data object-data-order == orderid-build)
(or	(up-object-data object-data-order == orderid-repair)
	(up-object-data object-data-order == orderid-enter))))
=>
	(up-target-point 0 action-stop -1 -1))
(defrule
	(up-set-target-object search-local c: 0)
	(up-object-data object-data-order == orderid-build)
	(up-object-data object-data-target-id != -1)
	(up-object-target-data object-data-status != status-pending)
=>
	(up-target-point 0 action-stop -1 -1))
(defrule
	(up-set-target-object search-local c: 0)
	(up-compare-goal temporary-goal g:< local-total)
=>
	(up-modify-goal temporary-goal c:+ 1)
	(up-set-group search-local c: 0)
	(up-remove-objects search-local object-data-index g:!= temporary-goal)
	(up-jump-rule -3))
(defrule
	(true)
=>
	(up-modify-group-flag 0 c: 0)
	(up-reset-group c: 0))
