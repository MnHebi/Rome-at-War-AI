(defrule
	(goal gl-owner-explore-suspended NO)
	(current-age < imperial-age)
	(up-compare-sn sn-number-explore-groups g:!= desired-military-explorers)
=>
	(up-modify-sn sn-number-explore-groups g:= desired-military-explorers))

;CB BEGIN 1143
(defrule
	(goal gl-owner-explore-suspended NO)
	(current-age < imperial-age)
	(up-compare-sn sn-cap-civilian-explorers g:!= desired-civilian-explorers)
=>
	(set-goal gl-cbf-cont 1143)
)
(defrule
	(goal gl-cbf-cont 1143)
=>
	(set-goal gl-cbf-site 1143)
	(set-goal gl-cbf-kind 3)
	(set-goal gl-cbf-args0 -2)
	(set-goal gl-cbf-args1 -2)
	(set-goal gl-cbf-args2 -2)
	(set-goal gl-cbf-args3 -2)
	(set-goal gl-cbf-point-y -2)
	(up-get-rule-id gl-cbf-return)
	(up-modify-goal gl-cbf-return c:+ 1)
	(up-jump-direct g: gl-cbf-entry)
)
(defrule
	(goal gl-cbf-cont 1143)
=>
	(up-modify-sn sn-cap-civilian-explorers g:= desired-civilian-explorers)
)
