;CB BEGIN 1149
(defrule
	(up-set-target-object search-local c: 0)
	(up-compare-goal temporary-goal g:< local-total)
=>
	(up-modify-goal temporary-goal c:+ 1)
	(up-set-group search-local c: attack-transport-group)
	(up-remove-objects search-local object-data-index g:!= temporary-goal)
	(up-jump-rule -13))
;CB END 1149
(defrule
	(true)
=>
	(up-modify-group-flag 0 c: attack-transport-group)
	(up-reset-group c: attack-transport-group))
