(defrule
	(goal gl-sy-stage 10)
	(goal gl-owner-worker-hold NO)
	(can-build shipyard)
	(can-afford-building shipyard)
	(or (goal wait-techup-requirements NO) (or (building-type-count-total shipyard == 0)
	(and (building-type-count-total shipyard g:< gl-sy-minimum) (up-compare-goal gl-sy-clock g:>= gl-sy-deficit-since))))
	(or (building-type-count-total shipyard == 0) (building-type-count-total shipyard g:< desired-number-shipyards))
	(up-pending-objects c: shipyard <= 0)
	(not (up-pending-placement c: shipyard))
	(up-can-build-line 0 gl-shipyard-x c: shipyard)
=>
	(up-build-line gl-shipyard-x gl-shipyard-x c: shipyard)
	(up-modify-goal gl-sy-until g:= gl-sy-clock)
	(up-modify-goal gl-sy-until c:+ 24)
	(set-goal gl-sy-foundation -1)
	(set-goal gl-sy-stage 20)
)

