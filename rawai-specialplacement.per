=>
	(up-chat-data-to-all str-t12-diag-id c: 410)
	(up-chat-data-to-all str-t12-diag-value g: gl-sy-reason)
	(up-modify-goal gl-sy-reported g:= gl-sy-reason)
	(up-modify-goal gl-sy-diag-next g:= gl-sy-clock)
	(up-modify-goal gl-sy-diag-next c:+ 60)
)
