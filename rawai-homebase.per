
; Straight from AiBuilder files. Now extensively modified.

;Builder targets are persistent foundation assignments. They speed large
;buildings without globally converting most gatherers -- including animal-food
;workers -- into builders every time a foundation appears.
(defrule
	(true)
=>
	(up-assign-builders c: town-center-foundation c: 6)
	(up-assign-builders c: market c: 4)
	(up-assign-builders c: university c: 4)
	(up-assign-builders c: monastery c: 4)
	(up-assign-builders c: siege-workshop c: 4)
	(up-assign-builders c: dock c: 4)
	(up-assign-builders c: shipyard c: 4)
	(up-assign-builders c: caravanserai c: 4)
	(up-assign-builders c: castle c: 10)
	(up-assign-builders c: wonder c: 15)
	(disable-self)
)

;Do not let the automatic builder-assistance pool pull shepherds or hunters
;away while animal food is still being harvested. Explicit foundation builder
;targets above remain available for large structures.
(defrule
	(or
		(unit-type-count villager-shepherd >= 1)
		(unit-type-count villager-hunter >= 1)
	)
	(or
		(strategic-number sn-disable-builder-assistance != 1)
		(or
			(strategic-number sn-retask-gather-amount != 40)
			(strategic-number sn-max-retask-gather-amount != 40)
		)
	)
=>
	(set-strategic-number sn-disable-builder-assistance 1)
	;This is a global engine control, so use the documented normal maximum as a
	;bounded retention floor instead of freezing every resource worker.
	(set-strategic-number sn-retask-gather-amount 40)
	(set-strategic-number sn-max-retask-gather-amount 40)
)

(defrule
	(unit-type-count villager-shepherd <= 0)
	(unit-type-count villager-hunter <= 0)
	(or
		(strategic-number sn-disable-builder-assistance != 0)
		(or
			(strategic-number sn-retask-gather-amount != 20)
			(strategic-number sn-max-retask-gather-amount != 40)
		)
	)
=>
	(set-strategic-number sn-disable-builder-assistance 0)
	(set-strategic-number sn-retask-gather-amount 20)
	(set-strategic-number sn-max-retask-gather-amount 40)
)

;Temporarily pull extra villagers onto large foundations. The percentages and
;caps return to the normal economy profile as soon as those foundations finish.
(defrule
	(or
		(up-pending-objects c: castle >= 1)
		(up-pending-objects c: wonder >= 1)
	)
	(strategic-number sn-percent-civilian-builders != 35)
=>
	(set-strategic-number sn-percent-civilian-builders 35)
	(set-strategic-number sn-cap-civilian-builders 15)
	(set-strategic-number sn-percent-civilian-gatherers 65)
)

(defrule
	(and
		(up-pending-objects c: castle <= 0)
		(up-pending-objects c: wonder <= 0)
	)
	(or
		(up-pending-objects c: town-center >= 1)
		(or
			(up-pending-objects c: market >= 1)
			(or
				(up-pending-objects c: university >= 1)
				(or
					(up-pending-objects c: monastery >= 1)
					(or
						(up-pending-objects c: siege-workshop >= 1)
						(or
							(up-pending-objects c: dock >= 1)
							(or
								(up-pending-objects c: shipyard >= 1)
								(up-pending-objects c: caravanserai >= 1)
							)
						)
					)
				)
			)
		)
	)
	(strategic-number sn-percent-civilian-builders != 25)
=>
	(set-strategic-number sn-percent-civilian-builders 25)
	(set-strategic-number sn-cap-civilian-builders 10)
	(set-strategic-number sn-percent-civilian-gatherers 75)
)

(defrule
	(up-pending-objects c: castle <= 0)
	(up-pending-objects c: wonder <= 0)
	(up-pending-objects c: town-center <= 0)
	(up-pending-objects c: market <= 0)
	(up-pending-objects c: university <= 0)
	(up-pending-objects c: monastery <= 0)
	(up-pending-objects c: siege-workshop <= 0)
	(up-pending-objects c: dock <= 0)
	(up-pending-objects c: shipyard <= 0)
	(up-pending-objects c: caravanserai <= 0)
	(strategic-number sn-percent-civilian-builders != 15)
=>
	(set-strategic-number sn-percent-civilian-builders 15)
	(set-strategic-number sn-cap-civilian-builders 8)
	(set-strategic-number sn-percent-civilian-gatherers 85)
)

(defrule
	(current-age == iron-age)
	(and
		(up-compare-sn sn-maximum-town-size c:> 0)
		(up-compare-sn sn-maximum-town-size g:< outer-townsize)
	)
	(up-timer-status t-town-size != timer-running)
	(or
		(up-pending-placement c: town-center)
		(or
			(up-pending-placement c: farm)
			(or	
				(up-pending-placement c: house)
				(or	
					(up-pending-placement c: barracks)
					(up-pending-placement c: dock)
				)
			)
		)
	)
=>
	(up-modify-sn sn-maximum-town-size c:+ 1)
	(up-modify-sn sn-maximum-town-size g:<= outer-townsize)
	(up-modify-sn sn-maximum-town-size g:> 0)
	(up-chat-data-to-self "pending placement resize sn-maximum-town-size; %d" s: sn-maximum-town-size)
	(enable-timer t-town-size 6)
)

(defrule
	(current-age == early-antiquity-age)
	(and
		(up-compare-sn sn-maximum-town-size c:> 0)
		(up-compare-sn sn-maximum-town-size g:< outer-townsize)
	)
	(up-timer-status t-town-size != timer-running)
	(or	
		(up-pending-placement c: town-center)
		(or	
			(up-pending-placement c: farm)
			(or	
				(up-pending-placement c: house)
				(or	
					(up-pending-placement c: barracks)
					(or	
						(up-pending-placement c: archery-range)
						(or	
							(up-pending-placement c: stable)
							(or	
								(up-pending-placement c: siege-workshop)
								(or	
									(up-pending-placement c: blacksmith)
									(or	
										(up-pending-placement c: market)
										(up-pending-placement c: watch-tower)
									)
								)
							)
						)
					)
				)
			)
		)
	)
=>
	(up-modify-sn sn-maximum-town-size c:+ 1)
	(up-modify-sn sn-maximum-town-size c:> 0)
	(up-modify-sn sn-maximum-town-size g:< outer-townsize)
	(up-chat-data-to-self "pending placement resize sn-maximum-town-size; %d" s: sn-maximum-town-size)
	(enable-timer t-town-size 6)
)

(defrule
	(current-age == early-antiquity-age)
	(and
		(up-compare-sn sn-maximum-town-size c:> 0)
		(up-compare-sn sn-maximum-town-size g:< outer-townsize)
	)
	(or
		(up-pending-placement c: dock)
		(up-pending-placement c: shipyard)
	)
=>
	(up-modify-sn sn-maximum-town-size c:+ 1)
	(up-modify-sn sn-maximum-town-size c:> 0)
	(up-modify-sn sn-maximum-town-size g:< outer-townsize)
	(up-chat-data-to-self "pending placement resize sn-maximum-town-size; %d" s: sn-maximum-town-size)
)

(defrule
	(current-age >= middle-antiquity-age)
	(and
		(up-compare-sn sn-maximum-town-size c:> 0)
		(up-compare-sn sn-maximum-town-size g:< outer-townsize)
	)
	(up-timer-status t-town-size != timer-running)
	(or	
		(up-pending-placement c: town-center)
		(or	
			(up-pending-placement c: farm)
			(or	
				(up-pending-placement c: house)
				(or	
					(up-pending-placement c: barracks)
					(or	
						(up-pending-placement c: archery-range)
						(or	
							(up-pending-placement c: stable)
							(or	
								(up-pending-placement c: siege-workshop)
								(or	
									(up-pending-placement c: blacksmith)
									(or	
										(up-pending-placement c: market)
										(or	
											(up-pending-placement c: dock)
											(up-pending-placement c: university)
										)
									)
								)
							)
						)
					)
				)
			)
		)
	)
=>
	(up-modify-sn sn-maximum-town-size c:+ 1)
	(up-modify-sn sn-maximum-town-size c:> 0)
	(up-modify-sn sn-maximum-town-size g:< outer-townsize)
	(up-chat-data-to-self "pending placement resize sn-maximum-town-size; %d" s: sn-maximum-town-size)
	(enable-timer t-town-size 6)
	(up-jump-rule 1)
)

(defrule
	(current-age >= middle-antiquity-age)
	(and
		(up-compare-sn sn-maximum-town-size c:> 0)
		(up-compare-sn sn-maximum-town-size g:< outer-townsize)
	)
	(or
		(up-pending-placement c: monastery)
		(or
			(up-pending-placement c: castle)
			(or	
				(up-pending-placement c: watch-tower)
				(or	
					(up-pending-placement c: shipyard)
					(up-pending-placement c: outpost)
				)
			)
		)
	)
=>
	(up-modify-sn sn-maximum-town-size c:+ 1)
	(up-modify-sn sn-maximum-town-size c:> 0)
	(up-modify-sn sn-maximum-town-size g:< outer-townsize)
	(up-chat-data-to-self "pending placement resize sn-maximum-town-size; %d" s: sn-maximum-town-size)
)

;Enemy structures can contract placement toward the protected core, but the
;strict comparison must turn false at safe-townsize or this rule never settles.
(defrule
	(enemy-buildings-in-town)
	(up-compare-sn sn-maximum-town-size g:> safe-townsize)
	(up-compare-sn sn-maximum-town-size g:<= outer-townsize)
	(up-timer-status t-town-size != timer-running)
=>
	(up-modify-sn sn-maximum-town-size c:- 1)
	(up-chat-data-to-self "resize due to enemy buildings in town sn-maximum-town-size; %d" s: sn-maximum-town-size)
	(enable-timer t-town-size 6)
)

(defrule
	(strategic-number sn-maximum-town-size s:> sn-camp-max-distance)
=>
	(up-modify-sn sn-camp-max-distance s:max sn-maximum-town-size)
	(up-chat-data-to-self "sn-camp-max-distance; %d" s: sn-camp-max-distance)
)

(defrule
	(goal allow-houses YES)
	(building-type-count-total town-center == 0)
=>
	(set-goal allow-houses NO)
	(chat-local-to-self "allow-houses NO")
)

(defrule
	(goal allow-houses NO)
	(building-type-count-total town-center > 0)
=>
	(set-goal allow-houses YES)
	(chat-local-to-self "allow-houses YES")
)

;One House at a time cannot keep pace with several Town Centers and military
;buildings. Start a pressure timer at three slots of headroom, then permit one
;additional pending House while the shortage persists. The two-foundation cap
;prevents the old unbounded House-flood failure mode.
(defrule
	(goal gl-house-pressure NO)
	(housing-headroom < 5)
	(up-pending-objects c: house >= 1)
=>
	(set-goal gl-house-pressure YES)
	(up-set-timer c: t-house-pressure c: 15)
)

(defrule
	(goal gl-house-pressure YES)
	(housing-headroom >= 5)
=>
	(set-goal gl-house-pressure NO)
	(up-set-timer c: t-house-pressure c: 30)
)

;A confirmed resource colony becomes a real settlement when its land zone has
;enough observed resources to justify a Town Center. Map-zone and resource
;density are the engine-visible proxy for island size; terrain area itself is
;not exposed to the AI scripting interface.
(defrule
	(up-timer-status t-colony-towncenter == timer-triggered)
	(goal gl-colony-towncenter-state COLONY-TC-IDLE)
	(goal gl-island-colony-established YES)
	(up-compare-goal gl-colony-towncenter-id c:< 0)
	(goal gl-island-migration-state MIGRATION-IDLE)
	(or
		(goal map-type RIVERS)
		(or
			(goal map-type ISLANDS)
			(goal map-type TEAM-ISLANDS)
		)
	)
=>
	(set-goal gl-colony-towncenter-state COLONY-TC-GATE)
)

(defrule
	(goal gl-colony-towncenter-state COLONY-TC-GATE)
	(goal gl-lumbercamp-placement-state PLACEMENT-IDLE)
	(goal gl-miningcamp-placement-state PLACEMENT-IDLE)
	(current-age >= middle-antiquity-age)
	(building-type-count-total town-center < 8)
	(or
		(building-type-count-total town-center g:< desired-number-towncenters)
		(goal resources-depleted YES)
	)
	(up-pending-objects c: town-center <= 0)
	(not (up-pending-placement c: town-center))
	(can-afford-building town-center)
=>
	(up-modify-goal gl-colony-towncenter-focus s:= sn-focus-player-number)
	(set-strategic-number sn-focus-player-number my-player-number)
	(up-full-reset-search)
	(up-set-target-point gl-island-colony-x)
	(up-filter-distance c: -1 c: 40)
	(up-find-local c: villager-class c: 40)
	(up-remove-objects search-local object-data-garrisoned == 1)
	(up-remove-objects search-local object-data-map-zone-id g:!= gl-island-colony-zone)
	(up-clean-search search-local object-data-distance search-order-asc)
	(set-goal gl-colony-towncenter-state COLONY-TC-FIND-SETTLER)
)

(defrule
	(goal gl-colony-towncenter-state COLONY-TC-GATE)
=>
	(up-set-timer c: t-colony-towncenter c: 45)
	(set-goal gl-colony-towncenter-state COLONY-TC-IDLE)
)

(defrule
	(goal gl-colony-towncenter-state COLONY-TC-FIND-SETTLER)
	(up-set-target-object search-local c: 0)
=>
	(up-get-point position-object gl-colony-towncenter-target-x)
	(set-strategic-number sn-focus-player-number 0)
	(up-full-reset-search)
	(up-set-target-point gl-colony-towncenter-target-x)
	(up-filter-distance c: -1 c: 36)
	(up-find-remote c: gold-mine-class c: 10)
	(up-find-remote c: stone-mine-class c: 10)
	(up-find-remote c: tree-class c: 40)
	(up-find-remote c: forage-class c: 10)
	(up-find-remote c: prey-animal-class c: 10)
	(up-remove-objects search-remote object-data-map-zone-id g:!= gl-island-colony-zone)
	(up-get-search-state remote-total)
	(up-modify-goal gl-colony-towncenter-resource-count g:= remote-total)
	(set-goal gl-colony-towncenter-state COLONY-TC-CHECK-RESOURCES)
)

(defrule
	(goal gl-colony-towncenter-state COLONY-TC-FIND-SETTLER)
	(not (up-set-target-object search-local c: 0))
=>
	(up-modify-sn sn-focus-player-number g:= gl-colony-towncenter-focus)
	(up-set-timer c: t-colony-towncenter c: 90)
	(set-goal gl-colony-towncenter-state COLONY-TC-IDLE)
)

(defrule
	(goal gl-colony-towncenter-state COLONY-TC-CHECK-RESOURCES)
	(up-compare-goal gl-colony-towncenter-resource-count c:>= 12)
=>
	(set-strategic-number sn-focus-player-number my-player-number)
	(up-full-reset-search)
	(up-find-local c: town-center c: 20)
	(up-remove-objects search-local object-data-map-zone-id g:!= gl-island-colony-zone)
	(set-goal gl-colony-towncenter-state COLONY-TC-CHECK-EXISTING)
)

(defrule
	(goal gl-colony-towncenter-state COLONY-TC-CHECK-RESOURCES)
	(up-compare-goal gl-colony-towncenter-resource-count c:< 12)
=>
	(up-chat-data-to-self "colony TC resource proxy too small: %d" g: gl-colony-towncenter-resource-count)
	(up-modify-sn sn-focus-player-number g:= gl-colony-towncenter-focus)
	(up-set-timer c: t-colony-towncenter c: 120)
	(set-goal gl-colony-towncenter-state COLONY-TC-IDLE)
)

(defrule
	(goal gl-colony-towncenter-state COLONY-TC-CHECK-EXISTING)
	(up-set-target-object search-local c: 0)
=>
	(up-get-object-data object-data-id gl-colony-towncenter-id)
	(up-modify-sn sn-focus-player-number g:= gl-colony-towncenter-focus)
	(up-set-timer c: t-colony-towncenter c: 180)
	(set-goal gl-colony-towncenter-state COLONY-TC-IDLE)
)

(defrule
	(goal gl-colony-towncenter-state COLONY-TC-CHECK-EXISTING)
	(not (up-set-target-object search-local c: 0))
=>
	(up-modify-sn sn-focus-player-number g:= gl-colony-towncenter-focus)
	(set-goal gl-colony-towncenter-attempts 0)
	(set-goal gl-colony-towncenter-state COLONY-TC-PLACE)
)

(defrule
	(goal gl-colony-towncenter-state COLONY-TC-PLACE)
	(goal gl-colony-towncenter-attempts 0)
=>
	(up-copy-point point2-x gl-colony-towncenter-target-x)
	(up-modify-goal point2-x c:+ 8)
	(up-modify-goal point2-y c:+ 8)
	(up-bound-point point3-x point2-x)
	(up-set-target-point point3-x)
	(set-goal gl-colony-towncenter-state COLONY-TC-ISSUE)
)

(defrule
	(goal gl-colony-towncenter-state COLONY-TC-PLACE)
	(goal gl-colony-towncenter-attempts 1)
=>
	(up-copy-point point2-x gl-colony-towncenter-target-x)
	(up-modify-goal point2-x c:- 8)
	(up-modify-goal point2-y c:+ 8)
	(up-bound-point point3-x point2-x)
	(up-set-target-point point3-x)
	(set-goal gl-colony-towncenter-state COLONY-TC-ISSUE)
)

(defrule
	(goal gl-colony-towncenter-state COLONY-TC-PLACE)
	(goal gl-colony-towncenter-attempts 2)
=>
	(up-copy-point point2-x gl-colony-towncenter-target-x)
	(up-modify-goal point2-x c:+ 8)
	(up-modify-goal point2-y c:- 8)
	(up-bound-point point3-x point2-x)
	(up-set-target-point point3-x)
	(set-goal gl-colony-towncenter-state COLONY-TC-ISSUE)
)

(defrule
	(goal gl-colony-towncenter-state COLONY-TC-PLACE)
	(goal gl-colony-towncenter-attempts 3)
=>
	(up-copy-point point2-x gl-colony-towncenter-target-x)
	(up-modify-goal point2-x c:- 8)
	(up-modify-goal point2-y c:- 8)
	(up-bound-point point3-x point2-x)
	(up-set-target-point point3-x)
	(set-goal gl-colony-towncenter-state COLONY-TC-ISSUE)
)

(defrule
	(goal gl-colony-towncenter-state COLONY-TC-ISSUE)
	(or
		(up-pending-placement c: town-center)
		(or
			(up-pending-placement c: market)
			(or
				(up-pending-placement c: lumber-camp)
				(or
					(up-pending-placement c: mining-camp)
					(or
						(up-pending-placement c: mill)
						(up-pending-placement c: house)
					)
				)
			)
		)
	)
=>
	(up-modify-sn sn-focus-player-number g:= gl-colony-towncenter-focus)
	(up-set-timer c: t-colony-towncenter c: 15)
	(set-goal gl-colony-towncenter-state COLONY-TC-IDLE)
)

(defrule
	(goal gl-colony-towncenter-state COLONY-TC-ISSUE)
	(up-pending-objects c: town-center <= 0)
	(not (up-pending-placement c: town-center))
	(up-can-build 0 c: town-center)
=>
	(up-build place-point 0 c: town-center)
	(up-modify-goal gl-colony-towncenter-attempts c:+ 1)
	(up-chat-data-to-self "colony TC placement attempt: %d" g: gl-colony-towncenter-attempts)
	(up-modify-sn sn-focus-player-number g:= gl-colony-towncenter-focus)
	(up-set-timer c: t-colony-towncenter c: 20)
	(set-goal gl-colony-towncenter-state COLONY-TC-WAIT)
)

(defrule
	(goal gl-colony-towncenter-state COLONY-TC-ISSUE)
	(up-compare-goal gl-colony-towncenter-attempts c:< 3)
	(can-afford-building town-center)
	(not (up-can-build 0 c: town-center))
=>
	(up-modify-goal gl-colony-towncenter-attempts c:+ 1)
	(set-goal gl-colony-towncenter-state COLONY-TC-PLACE)
)

(defrule
	(goal gl-colony-towncenter-state COLONY-TC-ISSUE)
	(up-compare-goal gl-colony-towncenter-attempts c:>= 3)
	(can-afford-building town-center)
	(not (up-can-build 0 c: town-center))
=>
	(up-chat-data-to-self "colony TC placement exhausted: %d" g: gl-island-colony-zone)
	(up-modify-sn sn-focus-player-number g:= gl-colony-towncenter-focus)
	(up-set-timer c: t-colony-towncenter c: 120)
	(set-goal gl-colony-towncenter-state COLONY-TC-IDLE)
)

(defrule
	(goal gl-colony-towncenter-state COLONY-TC-ISSUE)
	(not (can-afford-building town-center))
=>
	(up-chat-data-to-self "colony TC resource wait in zone: %d" g: gl-island-colony-zone)
	(up-modify-sn sn-focus-player-number g:= gl-colony-towncenter-focus)
	(up-set-timer c: t-colony-towncenter c: 60)
	(set-goal gl-colony-towncenter-state COLONY-TC-IDLE)
)

(defrule
	(goal gl-colony-towncenter-state COLONY-TC-WAIT)
	(up-pending-objects c: town-center >= 1)
=>
	(set-strategic-number sn-focus-player-number my-player-number)
	(up-full-reset-search)
	(up-filter-status c: status-pending c: list-active)
	(up-find-status-local c: town-center c: 10)
	(up-remove-objects search-local object-data-map-zone-id g:!= gl-island-colony-zone)
	(up-clean-search search-local object-data-distance search-order-asc)
	(set-goal gl-colony-towncenter-state COLONY-TC-ASSIGN)
)

(defrule
	(goal gl-colony-towncenter-state COLONY-TC-ASSIGN)
	(up-set-target-object search-local c: 0)
=>
	(up-get-object-data object-data-id gl-colony-towncenter-id)
	(up-get-point position-object gl-colony-towncenter-target-x)
	(up-full-reset-search)
	(up-set-target-point gl-colony-towncenter-target-x)
	(up-filter-distance c: -1 c: 24)
	(up-find-local c: villager-class c: 6)
	(up-remove-objects search-local object-data-garrisoned == 1)
	(up-remove-objects search-local object-data-map-zone-id g:!= gl-island-colony-zone)
	(up-remove-objects search-local object-data-language-id == lid-villager-shepherd)
	(up-remove-objects search-local object-data-language-id == lid-villager-hunter)
	(up-remove-objects search-local object-data-language-id == lid-villager-fisherman)
	(up-clean-search search-local object-data-distance search-order-asc)
	(up-add-object-by-id search-remote g: gl-colony-towncenter-id)
	(up-target-objects 0 action-default -1 stance-no-attack)
	(up-chat-data-to-self "colony TC accepted in zone: %d" g: gl-island-colony-zone)
	(up-modify-sn sn-focus-player-number g:= gl-colony-towncenter-focus)
	(up-set-timer c: t-colony-towncenter c: 180)
	(set-goal gl-colony-towncenter-state COLONY-TC-IDLE)
)

(defrule
	(goal gl-colony-towncenter-state COLONY-TC-ASSIGN)
	(not (up-set-target-object search-local c: 0))
=>
	(up-chat-data-to-self "colony TC pending owner mismatch: %d" g: gl-island-colony-zone)
	(up-modify-sn sn-focus-player-number g:= gl-colony-towncenter-focus)
	(up-set-timer c: t-colony-towncenter c: 120)
	(set-goal gl-colony-towncenter-state COLONY-TC-IDLE)
)

(defrule
	(goal gl-colony-towncenter-state COLONY-TC-WAIT)
	(up-timer-status t-colony-towncenter == timer-triggered)
	(up-pending-objects c: town-center <= 0)
	(up-compare-goal gl-colony-towncenter-attempts c:< 4)
=>
	(up-reset-placement c: town-center)
	(set-goal gl-colony-towncenter-state COLONY-TC-PLACE)
)

(defrule
	(goal gl-colony-towncenter-state COLONY-TC-WAIT)
	(up-timer-status t-colony-towncenter == timer-triggered)
	(up-pending-objects c: town-center <= 0)
	(up-compare-goal gl-colony-towncenter-attempts c:>= 4)
=>
	(up-chat-data-to-self "colony TC foundation not accepted: %d" g: gl-island-colony-zone)
	(up-modify-sn sn-focus-player-number g:= gl-colony-towncenter-focus)
	(up-set-timer c: t-colony-towncenter c: 120)
	(set-goal gl-colony-towncenter-state COLONY-TC-IDLE)
)

(defrule
	(current-age >= middle-antiquity-age)
	(goal gl-colony-towncenter-state COLONY-TC-IDLE)
	(goal gl-island-migration-state MIGRATION-IDLE)
	(can-afford-building town-center)
	(building-type-count-total town-center g:< desired-number-towncenters)
	(up-can-build 0 c: town-center)
=>
	(up-build place-normal 0 c: town-center)
)

(defrule
	(goal allow-houses 1)
	(building-type-count-total house == 0)
	(building-type-count-total mill == 0)
	(goal gl-migration-placement-lock NO)
	(up-pending-objects c: house <= 0)
	(population-headroom > 0)
	(housing-headroom < 5)
	(can-afford-building house)
	(up-can-build 0 c: house)
=>
	(up-build place-normal 0 c: house)
)

(defrule
	(current-age <= early-antiquity-age)
	(goal allow-houses 1)
	(building-type-count-total house > 0)
	(building-type-count-total mill == 0)
	(goal gl-migration-placement-lock NO)
	(up-pending-objects c: house <= 0)
	(population-headroom > 0)
	(housing-headroom < 5)
	(can-afford-building house)
	(up-can-build 0 c: house)
=>
	(up-set-placement-data my-player-number -1 c: -10)
	(up-build place-control 0 c: house)
)

(defrule
	(current-age <= early-antiquity-age)
	(goal allow-houses 1)
	(building-type-count-total house > 0)
	(building-type-count-total mill >= 1)
	(goal gl-migration-placement-lock NO)
	(up-pending-objects c: house <= 0)
	(population-headroom > 0)
	(housing-headroom < 5)
	(can-afford-building house)
	(up-can-build 0 c: house)
=>
	;Bias later houses away from the Mill anchor selected by the placement engine
	;letting the compact TC housing pattern seal every farm approach.
	(up-set-placement-data my-player-number mill c: 8)
	(up-build place-control 0 c: house)
)

(defrule
	(current-age >= middle-antiquity-age)
	(goal allow-houses 1)
	(building-type-count-total house > 0)
	(building-type-count-total mill == 0)
	(goal gl-migration-placement-lock NO)
	(up-pending-objects c: house <= 0)
	(population-headroom > 0)
	(housing-headroom < 5)
	(can-afford-building house)
	(up-can-build 0 c: house)
=>
	(up-build place-normal 0 c: house)
)

(defrule
	(goal allow-houses 1)
	(building-type-count-total house == 0)
	(building-type-count-total mill >= 1)
	(goal gl-migration-placement-lock NO)
	(up-pending-objects c: house <= 0)
	(population-headroom > 0)
	(housing-headroom < 5)
	(can-afford-building house)
	(up-can-build 0 c: house)
=>
	;Starting-Mill starts and rebuilt housing use the same local clearance bias.
	(up-set-placement-data my-player-number mill c: 8)
	(up-build place-control 0 c: house)
)

;Under sustained population pressure, put one new House at the confirmed
;colony instead of consuming another military-production tile around the home
;Mill. This is replacement-free: completed inner housing is never deleted.
(defrule
	(goal gl-house-pressure YES)
	(goal gl-island-colony-established YES)
	(goal gl-migration-placement-lock NO)
	(up-timer-status t-house-pressure == timer-triggered)
	(up-pending-objects c: house < 2)
	(population-headroom > 0)
	(housing-headroom < 3)
	(can-afford-building house)
	(or
		(goal map-type RIVERS)
		(or
			(goal map-type ISLANDS)
			(goal map-type TEAM-ISLANDS)
		)
	)
=>
	(up-copy-point point2-x gl-island-colony-x)
	(up-modify-goal point2-x c:+ 14)
	(up-modify-goal point2-y c:+ 14)
	(up-bound-point point3-x point2-x)
	(up-set-target-point point3-x)
	(up-build place-point 0 c: house)
)

(defrule
	(goal gl-house-pressure YES)
	(up-timer-status t-house-pressure == timer-triggered)
	(building-type-count-total mill >= 1)
	(goal gl-migration-placement-lock NO)
	(up-pending-objects c: house < 2)
	(population-headroom > 0)
	(housing-headroom < 3)
	(can-afford-building house)
	(up-can-build 0 c: house)
=>
	(up-set-placement-data my-player-number mill c: 8)
	(up-build place-control 0 c: house)
	(up-set-timer c: t-house-pressure c: 30)
)

(defrule
	(goal gl-house-pressure YES)
	(up-timer-status t-house-pressure == timer-triggered)
	(building-type-count-total mill == 0)
	(goal gl-migration-placement-lock NO)
	(up-pending-objects c: house < 2)
	(population-headroom > 0)
	(housing-headroom < 3)
	(can-afford-building house)
	(up-can-build 0 c: house)
=>
	(up-build place-normal 0 c: house)
	(up-set-timer c: t-house-pressure c: 30)
)

(defrule
	(current-age >= middle-antiquity-age)
	(goal allow-houses 1)
	(building-type-count-total house > 0)
	(building-type-count-total mill >= 1)
	(goal gl-migration-placement-lock NO)
	(up-pending-objects c: house <= 0)
	(population-headroom > 0)
	(housing-headroom < 5)
	(can-afford-building house)
	(up-can-build 0 c: house)
=>
	(up-set-placement-data my-player-number mill c: 8)
	(up-build place-control 0 c: house)
)

(defrule
	(or	
		(and	
			(up-pending-objects c: lumber-camp <= 0)
			(up-pending-objects c: mining-camp <= 0)
		)
		(strategic-number sn-camp-max-distance g:>= map-size)
	)
=>
	(up-jump-rule 4)
)

;Resource presence goals are refreshed from current sighted objects every minute.
;Do not use the total-sighted counters here because they retain depleted nodes.
(defrule
	(goal wood-present YES)
	(up-pending-objects c: lumber-camp >= 1)
=>
	(up-full-reset-search)
	(up-filter-status c: status-pending c: list-active)
	(up-find-status-local c: lumber-camp c: 1)
	(up-set-target-object search-local c: 0)
	(up-get-point position-object 509)
	(up-set-target-point 509)
	(up-reset-filters)
	(up-filter-distance c: -1 c: 8)
	(up-find-resource c: wood c: 3)
	(up-get-search-state local-total)
)

(defrule
	(goal wood-present YES)
	(up-pending-objects c: lumber-camp >= 1)
	(up-compare-goal local-total >= 1)
	(up-compare-goal remote-total <= 2)
	(up-object-data object-data-hitpoints <= 1)
=>
	(up-target-point 0 action-delete -1 -1)
	(up-reset-placement c: lumber-camp)
	(set-strategic-number sn-allow-adjacent-dropsites 1)
	(up-modify-sn sn-camp-max-distance c:+ 1)
)

(defrule
	(or	
		(goal gold-present YES)
		(goal stone-present YES)
	)
	(up-pending-objects c: mining-camp >= 1)
=>
	(up-full-reset-search)
	(up-filter-status c: status-pending c: list-active)
	(up-find-status-local c: mining-camp c: 1)
	(up-set-target-object search-local c: 0)
	(up-get-point position-object 509)
	(up-set-target-point 509)
	(up-reset-filters)
	;The targeted builder uses four diagonal offsets three tiles from the mine.
	;An eight-tile validation radius covers those accepted foundations.
	(up-filter-distance c: -1 c: 8)
	(up-modify-goal 508 s:= sn-focus-player-number)
	(set-strategic-number sn-focus-player-number 0)
	(up-find-remote c: 66 c: 1)
	(up-find-remote c: 102 c: 1)
	(up-modify-sn sn-focus-player-number g:= 508)
	(up-get-search-state local-total)
)

(defrule
	(or	
		(goal gold-present YES)
		(goal stone-present YES)
	)
	(up-pending-objects c: mining-camp >= 1) 
	(up-compare-goal local-total >= 1)
	(up-compare-goal remote-total <= 0)
	(up-object-data object-data-hitpoints <= 1)
=>
	(up-target-point 0 action-delete -1 -1)
	(up-reset-placement c: mining-camp)
	(set-strategic-number sn-allow-adjacent-dropsites 1)
	(up-modify-sn sn-camp-max-distance c:+ 1)
)

(defrule
	(up-timer-status t-lumbercamp-placement == timer-triggered)
	(goal gl-lumbercamp-placement-state PLACEMENT-IDLE)
	(goal gl-island-migration-state MIGRATION-IDLE)
	(wood-amount >= 100)
	(unit-type-count villager-wood >= 3)
	(building-type-count-total lumber-camp >= 1)
	(building-type-count-total lumber-camp < 8)
	(up-pending-objects c: lumber-camp <= 0)
	(can-afford-building lumber-camp)
	(up-can-build 0 c: lumber-camp)
=>
	(up-modify-goal gl-lumbercamp-placement-focus s:= sn-focus-player-number)
	(set-strategic-number sn-focus-player-number my-player-number)
	(up-full-reset-search)
	(up-set-target-point position-self-x)
	(up-find-local c: villager-class c: 40)
	(up-remove-objects search-local object-data-gather-type != wood)
	(up-clean-search search-local object-data-distance search-order-desc)
	(up-set-timer c: t-lumbercamp-placement c: 120)
	(set-goal gl-lumbercamp-placement-state PLACEMENT-ASSESS)
)

(defrule
	(goal gl-lumbercamp-placement-state PLACEMENT-ASSESS)
	(up-set-target-object search-local c: 0)
	(up-object-data object-data-distance > 12)
=>
	(up-get-point position-object gl-lumbercamp-target-x)
	(up-full-reset-search)
	(up-set-target-point gl-lumbercamp-target-x)
	(up-find-remote c: lumber-camp c: 20)
	(up-clean-search search-remote object-data-distance search-order-asc)
	(set-goal gl-lumbercamp-placement-state PLACEMENT-FIND-CAMP)
)

(defrule
	(goal gl-lumbercamp-placement-state PLACEMENT-ASSESS)
	(up-set-target-object search-local c: 0)
	(up-object-data object-data-distance <= 12)
=>
	(up-modify-sn sn-focus-player-number g:= gl-lumbercamp-placement-focus)
	(set-goal gl-lumbercamp-placement-state PLACEMENT-IDLE)
)

(defrule
	(goal gl-lumbercamp-placement-state PLACEMENT-ASSESS)
	(not (up-set-target-object search-local c: 0))
=>
	(up-modify-sn sn-focus-player-number g:= gl-lumbercamp-placement-focus)
	(set-goal gl-lumbercamp-placement-state PLACEMENT-IDLE)
)

(defrule
	(goal gl-lumbercamp-placement-state PLACEMENT-FIND-CAMP)
	(up-set-target-object search-remote c: 0)
	(up-object-data object-data-distance > 10)
=>
	(up-copy-point point2-x gl-lumbercamp-target-x)
	(up-modify-goal point2-x c:+ 3)
	(up-modify-goal point2-y c:+ 3)
	(up-bound-point point3-x point2-x)
	(up-set-target-point point3-x)
	(up-build place-point 0 c: lumber-camp)
	(up-modify-sn sn-focus-player-number g:= gl-lumbercamp-placement-focus)
	(set-goal gl-lumbercamp-placement-state PLACEMENT-IDLE)
)

(defrule
	(goal gl-lumbercamp-placement-state PLACEMENT-FIND-CAMP)
	(up-set-target-object search-remote c: 0)
	(up-object-data object-data-distance <= 10)
=>
	(up-modify-sn sn-focus-player-number g:= gl-lumbercamp-placement-focus)
	(set-goal gl-lumbercamp-placement-state PLACEMENT-IDLE)
)

(defrule
	(goal gl-lumbercamp-placement-state PLACEMENT-FIND-CAMP)
	(not (up-set-target-object search-remote c: 0))
=>
	(up-copy-point point2-x gl-lumbercamp-target-x)
	(up-modify-goal point2-x c:+ 3)
	(up-modify-goal point2-y c:+ 3)
	(up-bound-point point3-x point2-x)
	(up-set-target-point point3-x)
	(up-build place-point 0 c: lumber-camp)
	(up-modify-sn sn-focus-player-number g:= gl-lumbercamp-placement-focus)
	(set-goal gl-lumbercamp-placement-state PLACEMENT-IDLE)
)

(defrule
	(and
		(goal wood-present YES)
		(and
			(dropsite-min-distance wood > 4)
			(building-type-count-total lumber-camp g:< desired-number-lumbercamps)
		)
	)
	(dropsite-min-distance wood g:< map-size)
	(goal gl-lumbercamp-placement-state PLACEMENT-IDLE)
	(goal gl-island-migration-state MIGRATION-IDLE)
	(up-timer-status t-lumbercamp-placement == timer-triggered)
	(can-afford-building lumber-camp)
	(up-pending-objects c: lumber-camp <= 0)
	(up-can-build 0 c: lumber-camp)
=>
	(up-build place-normal 0 c: lumber-camp)
)

(defrule
	(and	
		(up-gaia-type-count c: food >= 5)
		(and
			(building-type-count-total lumber-camp >= 1)
			(and
				(building-type-count-total farm g:< gl-farm-build-target)
				(building-type-count-total mill g:< desired-number-mills)
			)
		)
	)
	;The opening Mill is exclusively owned by the escrow bootstrap below. This
	;rule may only add a genuinely additional drop site later.
	(goal gl-island-migration-state MIGRATION-IDLE)
	(building-type-count-total mill > 0)
	(dropsite-min-distance food > 12)
	(dropsite-min-distance food g:< map-size)
	(can-afford-building mill)
	(up-pending-objects c: mill <= 0)
	(up-can-build 0 c: mill)
=>
	(up-build place-normal 0 c: mill)
)

(defrule
	(goal dependent-farms FARM-DEMAND-DEPENDENT)
=>
	(up-modify-goal gl-farm-build-target g:= villager-count)
	(up-modify-goal gl-farm-build-target s:%* sn-food-gatherer-percentage)
	(up-modify-goal 510 g:= gl-farm-build-target)
	(up-get-fact unit-type-count villager-food 509)
	(up-modify-goal gl-farm-build-target g:- 509)
	(up-get-fact unit-type-count villager-farmer 509)
	(up-modify-goal gl-farm-build-target g:+ 509)
	;At most two shore fishermen may substitute for farms. Add the full
	;fisherman count back, then discount only the bounded supplement.
	(up-get-fact unit-type-count villager-fisherman 509)
	(up-modify-goal gl-farm-build-target g:+ 509)
	(up-modify-goal 509 c:min 2)
	(up-modify-goal gl-farm-build-target g:- 509)
	(up-modify-goal gl-farm-build-target c:max 0)
	(up-modify-goal 510 c:+ 2);
	(up-modify-goal gl-farm-build-target g:min 510)
)

;Once land food is exhausted, derive farms from the current villager economy,
;not the phase's population-cap percentage. Shore fishing remains a bounded
;supplement, so it cannot displace more than two farms.
(defrule
	(goal dependent-farms FARM-DEMAND-INDEPENDENT)
=>
	(up-modify-goal gl-farm-build-target g:= villager-count)
	(up-modify-goal gl-farm-build-target s:%* sn-food-gatherer-percentage)
	(up-get-fact unit-type-count villager-fisherman 509)
	(up-modify-goal 509 c:min 2)
	(up-modify-goal gl-farm-build-target g:- 509)
	(up-modify-goal gl-farm-build-target c:max 0)
)

;Report only after economy state transitions and both finalized demand paths.
(defrule
	(timer-triggered t-farm-report)
=>
	(up-get-fact unit-type-count villager-fisherman gl-farm-report-fishermen)
	(up-get-fact unit-type-count villager-farmer gl-farm-report-farmers)
	(up-get-fact building-type-count farm gl-farm-report-farms)
	(up-get-fact dropsite-min-distance hunting gl-farm-report-hunt-distance)
	(up-get-fact dropsite-min-distance food gl-farm-report-food-distance)
	(up-chat-data-to-self "farm mode: %d" g: dependent-farms)
	(up-chat-data-to-self "civilian fishermen: %d" g: gl-farm-report-fishermen)
	(up-chat-data-to-self "farmers: %d" g: gl-farm-report-farmers)
	(up-chat-data-to-self "farms: %d" g: gl-farm-report-farms)
	(up-chat-data-to-self "farm target: %d" g: gl-farm-build-target)
	(up-chat-data-to-self "farm placement suspended: %d" g: gl-farm-placement-suspended)
	(up-chat-data-to-self "hunt distance: %d" g: gl-farm-report-hunt-distance)
	(up-chat-data-to-self "food distance: %d" g: gl-farm-report-food-distance)
	(disable-timer t-farm-report)
)

(defrule
	(wood-amount < 160)
	(dropsite-min-distance wood >= 5)
	(building-type-count-total lumber-camp g:< desired-number-lumbercamps)
	(strategic-number sn-wood-gatherer-percentage >= 1)
=>
	(up-jump-rule 18)
)

(defrule
(or	(goal gl-farm-placement-suspended YES)
(or	(up-compare-goal gl-farm-build-target <= 0)
(or	(building-type-count-total farm g:>= gl-farm-build-target)
(or	(up-pending-placement c: farm)
	(not (up-can-build 0 c: farm))))))
=>
	(up-jump-rule 17)

)

(defrule
	(true)
=>
	(set-goal temporary-goal town-center)
	(set-goal temporary-goal4 0)
	(set-goal temporary-goal5 40)
	(up-modify-goal temporary-goal5 s:min sn-maximum-town-size)
	(set-goal temporary-goal8 0)
	(up-modify-goal temporary-goal9 g:= map-size)
	(set-goal temporary-goal10 0)
)

(defrule
	(true)
=>
	(set-goal point3-x -1)
	(up-set-target-point position-self-x)
	(up-full-reset-search)
	(up-find-local g: temporary-goal c: 12)
	(up-remove-objects search-local object-data-distance g:> temporary-goal5)
	(up-clean-search search-local object-data-distance search-order-asc)
)

(defrule; end neg jump
(not	(up-set-target-object search-local g: temporary-goal4))
=>
	(up-jump-rule 12)
)

(defrule
	(up-set-target-object search-local g: temporary-goal4)
	(up-object-data object-data-type == town-center)
=>
	(set-goal temporary-goal2 2)
	(set-goal temporary-goal3 3)
	(set-goal temporary-goal6 4)
	(set-goal temporary-goal7 1)
)

(defrule
	(up-set-target-object search-local g: temporary-goal4)
	(up-object-data object-data-type == mill)
=>
	(set-goal temporary-goal2 1)
	(set-goal temporary-goal3 2)
	(set-goal temporary-goal6 4)
	(set-goal temporary-goal7 1)
)

(defrule
	(goal temporary-goal10 1)
	(goal point3-x -1)
=>
	(up-modify-goal temporary-goal2 c:+ 1)
	(up-modify-goal temporary-goal3 c:+ 1)
	(up-modify-goal temporary-goal6 c:+ 1)
)

(defrule
	(up-set-target-object search-local g: temporary-goal4)
=>
	(up-get-point position-object point-x)
	(up-copy-point point2-x point-x)
	(up-modify-goal point2-x c:+ 40)
	(up-modify-goal point2-y c:+ 40)
	(up-modify-goal point-x g:+ temporary-goal2)
	(up-modify-goal point-y g:+ temporary-goal3)
)

(defrule
	(up-compare-goal point-x >= 0)
	(up-can-build-line 0 point-x c: farm)
	(up-point-distance point2-x point-x g:< temporary-goal9)
=>
	(up-get-point-distance point2-x point-x temporary-goal9)
	(up-copy-point point3-x point-x)
)

(defrule
	(up-compare-goal temporary-goal6 >= 2)
=>
	(up-modify-goal point-x g:- temporary-goal7)
	(up-modify-goal temporary-goal6 c:- 1)
	(up-jump-rule -2)
)

(defrule
	(up-compare-goal temporary-goal6 == 1)
	(up-set-target-object search-local g: temporary-goal4)
=>
	(up-get-point position-object point-x)
	(up-modify-goal point-x g:+ temporary-goal3)
	(up-modify-goal point-y g:+ temporary-goal3)
	(set-goal temporary-goal6 -7)
)

(defrule
	(up-compare-goal temporary-goal6 <= -2)
=>
	(up-modify-goal point-y g:- temporary-goal7)
	(up-modify-goal temporary-goal6 c:+ 1)
	(up-jump-rule -4)
)

(defrule
	(goal temporary-goal8 0)
=>
	(set-goal temporary-goal6 4)
	(up-modify-goal temporary-goal2 c:+ 1)
	(up-modify-goal temporary-goal3 c:+ 1)
	(up-modify-goal temporary-goal2 c:* -1)
	(up-modify-goal temporary-goal3 c:* -1)
	(up-modify-goal temporary-goal7 c:* -1)
	(set-goal temporary-goal8 1)
	(up-jump-rule -6)
)

(defrule
	(goal temporary-goal10 0)
	(goal point3-x -1)
=>
	(set-goal temporary-goal8 0)
	(set-goal temporary-goal10 1)
	(up-jump-rule -10)
)

(defrule
	(goal gl-farm-placement-suspended NO)
	(building-type-count mill >= 1)
	(up-compare-goal point3-x >= 0)
	(up-can-build-line 0 point3-x c: farm)
	(up-can-build 0 c: farm)
=>
;	(chat-to-player my-player-number "Manual farm.")
	(up-build-line point3-x point3-x c: farm)
	(up-jump-rule 3)
)

(defrule
	(up-set-target-object search-local g: temporary-goal4)
=>
	(up-modify-goal temporary-goal4 c:+ 1)
	(set-goal temporary-goal8 0)
	(set-goal temporary-goal10 0)
	(up-jump-rule -13)
)

(defrule
	(not	
		(up-set-target-object search-local g: temporary-goal4)
	)
	(goal temporary-goal town-center)
	(building-type-count mill >= 1)
=>
	(set-goal temporary-goal mill)
	(up-full-reset-search)
	(up-find-local g: temporary-goal c: 20)
	(set-goal temporary-goal4 0)
	(set-goal temporary-goal8 0)
	(set-goal temporary-goal10 0)
	(up-jump-rule -14)
)

;jumps end

(defrule
	(goal gl-farm-placement-suspended NO)
	(wood-amount > 150)
	(building-type-count mill >= 1)
	(up-can-build 0 c: farm)
=>
;	(chat-to-player my-player-number "Normal farm.")
	(up-build place-normal 0 c: farm)
)

(defrule
	(goal gl-colony-towncenter-state COLONY-TC-IDLE)
	(goal gl-island-migration-state MIGRATION-IDLE)
	(can-afford-building town-center)
	(building-type-count-total town-center == 0)
	(up-can-build 0 c: town-center)
=>
	(up-build place-normal 0 c: town-center)
)

(defrule
	(up-object-type-count-total c: town-center > 0)
	(up-object-type-count-total c: lumber-camp > 0)
	(up-object-type-count-total c: mill == 0)
	(goal gl-opening-mill-requested NO)
	(goal gl-island-migration-state MIGRATION-IDLE)
	(up-pending-objects c: mill <= 0)
	(up-can-build gl-escrow c: mill)
=>
	(set-goal gl-escrow with-escrow)
	(up-build place-normal gl-escrow c: mill)
	(set-goal gl-opening-mill-requested YES)
	(up-set-timer c: t-opening-mill c: 90)
)

;A failed managed placement must not permanently consume the one-shot opening
;Mill owner. Reset only when no Mill object or foundation appeared.
(defrule
	(goal gl-opening-mill-requested YES)
	(building-type-count-total mill == 0)
	(up-pending-objects c: mill <= 0)
	(up-timer-status t-opening-mill == timer-triggered)
=>
	(up-reset-placement c: mill)
	(set-goal gl-opening-mill-requested NO)
	(up-set-timer c: t-opening-mill c: 30)
)

(defrule
	(goal wood-present YES)
	(up-object-type-count-total c: town-center > 0)
	(up-object-type-count-total c: lumber-camp == 0)
	(goal gl-island-migration-state MIGRATION-IDLE)
	(up-pending-objects c: lumber-camp <= 0)
	(can-build-with-escrow lumber-camp)
=>
	(release-escrow wood)
	(build lumber-camp)
)

;Mining Camps follow the actual resource targeted by an active miner. Alternate
;gold and stone searches so one configured gather percentage cannot starve the
;other resource, then reject targets that already have a nearby camp.
(defrule
	(up-timer-status t-miningcamp-placement == timer-triggered)
	(goal gl-miningcamp-placement-state PLACEMENT-IDLE)
	(goal gl-island-migration-state MIGRATION-IDLE)
	(goal gl-miningcamp-next-resource gold)
	(current-age >= early-antiquity-age)
	(building-type-count-total mining-camp g:< desired-number-miningcamps)
	(building-type-count-total lumber-camp >= 1)
	(up-pending-objects c: mining-camp <= 0)
	(not (up-pending-placement c: mining-camp))
	(strategic-number sn-gold-gatherer-percentage >= 1)
	(goal gold-present YES)
	(can-afford-building mining-camp)
	(up-can-build 0 c: mining-camp)
=>
	(up-modify-goal gl-miningcamp-placement-focus s:= sn-focus-player-number)
	(set-strategic-number sn-focus-player-number my-player-number)
	(up-full-reset-search)
	(up-set-target-point position-self-x)
	(up-find-local c: villager-class c: 40)
	(up-remove-objects search-local object-data-gather-type != gold)
	(up-clean-search search-local object-data-distance search-order-desc)
	(set-goal gl-miningcamp-resource-type gold)
	(set-goal gl-miningcamp-next-resource stone)
	(set-goal gl-miningcamp-placement-attempts 0)
	(up-set-timer c: t-miningcamp-placement c: 60)
	(set-goal gl-miningcamp-placement-state PLACEMENT-ASSESS)
)

(defrule
	(up-timer-status t-miningcamp-placement == timer-triggered)
	(goal gl-miningcamp-placement-state PLACEMENT-IDLE)
	(goal gl-island-migration-state MIGRATION-IDLE)
	(goal gl-miningcamp-next-resource stone)
	(current-age >= early-antiquity-age)
	(building-type-count-total mining-camp g:< desired-number-miningcamps)
	(building-type-count-total lumber-camp >= 1)
	(up-pending-objects c: mining-camp <= 0)
	(not (up-pending-placement c: mining-camp))
	(strategic-number sn-stone-gatherer-percentage >= 1)
	(goal stone-present YES)
	(can-afford-building mining-camp)
	(up-can-build 0 c: mining-camp)
=>
	(up-modify-goal gl-miningcamp-placement-focus s:= sn-focus-player-number)
	(set-strategic-number sn-focus-player-number my-player-number)
	(up-full-reset-search)
	(up-set-target-point position-self-x)
	(up-find-local c: villager-class c: 40)
	(up-remove-objects search-local object-data-gather-type != stone)
	(up-clean-search search-local object-data-distance search-order-desc)
	(set-goal gl-miningcamp-resource-type stone)
	(set-goal gl-miningcamp-next-resource gold)
	(set-goal gl-miningcamp-placement-attempts 0)
	(up-set-timer c: t-miningcamp-placement c: 60)
	(set-goal gl-miningcamp-placement-state PLACEMENT-ASSESS)
)

;If the preferred resource is unavailable, immediately give the other search a
;turn instead of leaving the placement timer pinned to an impossible branch.
(defrule
	(up-timer-status t-miningcamp-placement == timer-triggered)
	(goal gl-miningcamp-placement-state PLACEMENT-IDLE)
	(goal gl-miningcamp-next-resource gold)
	(or
		(goal gold-present NO)
		(strategic-number sn-gold-gatherer-percentage < 1)
	)
=>
	(set-goal gl-miningcamp-next-resource stone)
)

(defrule
	(up-timer-status t-miningcamp-placement == timer-triggered)
	(goal gl-miningcamp-placement-state PLACEMENT-IDLE)
	(goal gl-miningcamp-next-resource stone)
	(or
		(goal stone-present NO)
		(strategic-number sn-stone-gatherer-percentage < 1)
	)
=>
	(set-goal gl-miningcamp-next-resource gold)
	(up-set-timer c: t-miningcamp-placement c: 10)
)

(defrule
	(goal gl-miningcamp-placement-state PLACEMENT-ASSESS)
	(up-set-target-object search-local c: 0)
=>
	(up-get-point position-object gl-miningcamp-target-x)
	(up-get-object-data object-data-target-id gl-miningcamp-resource-id)
	(set-strategic-number sn-focus-player-number 0)
	(up-full-reset-search)
	(up-add-object-by-id search-remote g: gl-miningcamp-resource-id)
	(set-goal gl-miningcamp-placement-state PLACEMENT-FIND-RESOURCE)
)

(defrule
	(goal gl-miningcamp-placement-state PLACEMENT-ASSESS)
	(not (up-set-target-object search-local c: 0))
=>
	(up-modify-sn sn-focus-player-number g:= gl-miningcamp-placement-focus)
	(up-set-timer c: t-miningcamp-placement c: 10)
	(set-goal gl-miningcamp-placement-state PLACEMENT-IDLE)
)

(defrule
	(goal gl-miningcamp-placement-state PLACEMENT-FIND-RESOURCE)
	(up-set-target-object search-remote c: 0)
	(or
		(and
			(goal gl-miningcamp-resource-type gold)
			(up-object-data object-data-type == 66)
		)
		(and
			(goal gl-miningcamp-resource-type stone)
			(up-object-data object-data-type == 102)
		)
	)
=>
	;Only a matching mine target can own this placement. A miner temporarily
	;attacking a Gaia animal must not redirect a Mining Camp.
	(up-get-point position-object gl-miningcamp-target-x)
	(set-strategic-number sn-focus-player-number my-player-number)
	(up-full-reset-search)
	(up-set-target-point gl-miningcamp-target-x)
	(up-find-remote c: mining-camp c: 20)
	(up-clean-search search-remote object-data-distance search-order-asc)
	(up-modify-sn sn-focus-player-number g:= gl-miningcamp-placement-focus)
	(set-goal gl-miningcamp-placement-state PLACEMENT-FIND-CAMP)
)

(defrule
	(goal gl-miningcamp-placement-state PLACEMENT-FIND-RESOURCE)
	(up-set-target-object search-remote c: 0)
	(or
		(and
			(goal gl-miningcamp-resource-type gold)
			(up-object-data object-data-type != 66)
		)
		(and
			(goal gl-miningcamp-resource-type stone)
			(up-object-data object-data-type != 102)
		)
	)
=>
	(up-modify-sn sn-focus-player-number g:= gl-miningcamp-placement-focus)
	(up-set-timer c: t-miningcamp-placement c: 10)
	(set-goal gl-miningcamp-placement-state PLACEMENT-IDLE)
)

(defrule
	(goal gl-miningcamp-placement-state PLACEMENT-FIND-RESOURCE)
	(not (up-set-target-object search-remote c: 0))
=>
	(up-modify-sn sn-focus-player-number g:= gl-miningcamp-placement-focus)
	(up-set-timer c: t-miningcamp-placement c: 10)
	(set-goal gl-miningcamp-placement-state PLACEMENT-IDLE)
)

(defrule
	(goal gl-miningcamp-placement-state PLACEMENT-FIND-CAMP)
	(up-set-target-object search-remote c: 0)
	(up-object-data object-data-distance <= 10)
=>
	(up-set-timer c: t-miningcamp-placement c: 60)
	(set-goal gl-miningcamp-placement-state PLACEMENT-IDLE)
)

(defrule
	(goal gl-miningcamp-placement-state PLACEMENT-FIND-CAMP)
	(up-set-target-object search-remote c: 0)
	(up-object-data object-data-distance > 10)
=>
	(set-goal gl-miningcamp-placement-state PLACEMENT-PLACE)
)

(defrule
	(goal gl-miningcamp-placement-state PLACEMENT-FIND-CAMP)
	(not (up-set-target-object search-remote c: 0))
=>
	(set-goal gl-miningcamp-placement-state PLACEMENT-PLACE)
)

;Try four bounded diagonals around the resource target. Retain state ownership
;until a foundation exists or every offset has failed.
(defrule
	(goal gl-miningcamp-placement-state PLACEMENT-PLACE)
	(goal gl-miningcamp-placement-attempts 0)
=>
	(up-copy-point point2-x gl-miningcamp-target-x)
	(up-modify-goal point2-x c:+ 3)
	(up-modify-goal point2-y c:+ 3)
	(up-bound-point point3-x point2-x)
	(up-set-target-point point3-x)
	(up-build place-point 0 c: mining-camp)
	(set-goal gl-miningcamp-placement-attempts 1)
	(up-set-timer c: t-miningcamp-placement c: 30)
	(set-goal gl-miningcamp-placement-state PLACEMENT-WAIT)
)

(defrule
	(goal gl-miningcamp-placement-state PLACEMENT-PLACE)
	(goal gl-miningcamp-placement-attempts 1)
=>
	(up-copy-point point2-x gl-miningcamp-target-x)
	(up-modify-goal point2-x c:- 3)
	(up-modify-goal point2-y c:+ 3)
	(up-bound-point point3-x point2-x)
	(up-set-target-point point3-x)
	(up-build place-point 0 c: mining-camp)
	(set-goal gl-miningcamp-placement-attempts 2)
	(up-set-timer c: t-miningcamp-placement c: 30)
	(set-goal gl-miningcamp-placement-state PLACEMENT-WAIT)
)

(defrule
	(goal gl-miningcamp-placement-state PLACEMENT-PLACE)
	(goal gl-miningcamp-placement-attempts 2)
=>
	(up-copy-point point2-x gl-miningcamp-target-x)
	(up-modify-goal point2-x c:+ 3)
	(up-modify-goal point2-y c:- 3)
	(up-bound-point point3-x point2-x)
	(up-set-target-point point3-x)
	(up-build place-point 0 c: mining-camp)
	(set-goal gl-miningcamp-placement-attempts 3)
	(up-set-timer c: t-miningcamp-placement c: 30)
	(set-goal gl-miningcamp-placement-state PLACEMENT-WAIT)
)

(defrule
	(goal gl-miningcamp-placement-state PLACEMENT-PLACE)
	(goal gl-miningcamp-placement-attempts 3)
=>
	(up-copy-point point2-x gl-miningcamp-target-x)
	(up-modify-goal point2-x c:- 3)
	(up-modify-goal point2-y c:- 3)
	(up-bound-point point3-x point2-x)
	(up-set-target-point point3-x)
	(up-build place-point 0 c: mining-camp)
	(set-goal gl-miningcamp-placement-attempts 4)
	(up-set-timer c: t-miningcamp-placement c: 30)
	(set-goal gl-miningcamp-placement-state PLACEMENT-WAIT)
)

(defrule
	(goal gl-miningcamp-placement-state PLACEMENT-WAIT)
	(up-pending-objects c: mining-camp >= 1)
=>
	(set-goal gl-miningcamp-placement-attempts 0)
	(up-set-timer c: t-miningcamp-placement c: 120)
	(set-goal gl-miningcamp-placement-state PLACEMENT-IDLE)
)

(defrule
	(goal gl-miningcamp-placement-state PLACEMENT-WAIT)
	(up-timer-status t-miningcamp-placement == timer-triggered)
	(up-pending-objects c: mining-camp <= 0)
	(up-compare-goal gl-miningcamp-placement-attempts c:< 4)
=>
	(up-reset-placement c: mining-camp)
	(up-set-timer c: t-miningcamp-placement c: 1)
	(set-goal gl-miningcamp-placement-state PLACEMENT-PLACE)
)

(defrule
	(goal gl-miningcamp-placement-state PLACEMENT-WAIT)
	(up-timer-status t-miningcamp-placement == timer-triggered)
	(up-pending-objects c: mining-camp <= 0)
	(up-compare-goal gl-miningcamp-placement-attempts c:>= 4)
=>
	(up-reset-placement c: mining-camp)
	(set-goal gl-miningcamp-placement-attempts 0)
	(up-set-timer c: t-miningcamp-placement c: 180)
	(set-goal gl-miningcamp-placement-state PLACEMENT-IDLE)
)

(defrule
	(up-timer-status t-miningcamp-placement == timer-triggered)
	(or
		(goal gl-miningcamp-placement-state PLACEMENT-ASSESS)
		(goal gl-miningcamp-placement-state PLACEMENT-FIND-RESOURCE)
	)
=>
	(up-reset-placement c: mining-camp)
	(up-modify-sn sn-focus-player-number g:= gl-miningcamp-placement-focus)
	(set-goal gl-miningcamp-placement-attempts 0)
	(up-set-timer c: t-miningcamp-placement c: 60)
	(set-goal gl-miningcamp-placement-state PLACEMENT-IDLE)
)

(defrule
	(up-timer-status t-miningcamp-placement == timer-triggered)
	(or
		(goal gl-miningcamp-placement-state PLACEMENT-FIND-CAMP)
		(or
			(goal gl-miningcamp-placement-state PLACEMENT-PLACE)
			(goal gl-miningcamp-placement-state PLACEMENT-WAIT)
		)
	)
=>
	(up-reset-placement c: mining-camp)
	(set-goal gl-miningcamp-placement-attempts 0)
	(up-set-timer c: t-miningcamp-placement c: 60)
	(set-goal gl-miningcamp-placement-state PLACEMENT-IDLE)
)

(defrule
	(goal gl-opening-drop-sites-ready NO)
	(game-time >= 180)
	(building-type-count lumber-camp >= 1)
	(building-type-count mill >= 1)
	(up-pending-objects c: lumber-camp <= 0)
	(up-pending-objects c: mill <= 0)
	(not (up-pending-placement c: lumber-camp))
	(not (up-pending-placement c: mill))
=>
	;Use a persistent readiness latch so queued-building count semantics cannot
	;release an opening Barracks in the first rules pass.
	(set-goal gl-opening-drop-sites-ready YES)
)

(defrule
	(can-afford-building barracks)
	(goal wait-techup-requirements NO)
	(goal gl-opening-drop-sites-ready YES)
	(building-type-count-total barracks g:< desired-number-barracks)
	;Non-total counts exclude queued buildings, and pending checks keep a live
	;foundation from satisfying the prerequisite.
	(building-type-count lumber-camp >= 1)
	(building-type-count mill >= 1)
	(up-pending-objects c: lumber-camp <= 0)
	(up-pending-objects c: mill <= 0)
	(or
		(current-age < middle-antiquity-age)
		(or
			(building-type-count town-center >= 2)
			(or
				(goal gl-home-defense-state YES)
				(goal rush-rushing YES)
			)
		)
	)
	(up-can-build 0 c: barracks)
=>
	(up-build place-normal 0 c: barracks))

(defrule
	(current-age >= early-antiquity-age)
	(goal wait-techup-requirements NO)
	(can-afford-building archery-range)
	(building-type-count-total barracks > 0)
	(building-type-count-total archery-range g:< desired-number-ranges)
	(or
		(current-age < middle-antiquity-age)
		(or
			(building-type-count town-center >= 2)
			(or
				(goal gl-home-defense-state YES)
				(goal rush-rushing YES)
			)
		)
	)
	(up-can-build 0 c: archery-range)
=>
	(up-build place-normal 0 c: archery-range))

(defrule
	(current-age >= early-antiquity-age)
	(goal wait-techup-requirements NO)
	(can-afford-building stable)
	(building-type-count-total barracks > 0)
	(building-type-count-total stable g:< desired-number-stables)
	(or
		(current-age < middle-antiquity-age)
		(or
			(building-type-count town-center >= 2)
			(or
				(goal gl-home-defense-state YES)
				(goal rush-rushing YES)
			)
		)
	)
	(up-can-build 0 c: stable)
=>
	(up-build place-normal 0 c: stable))

(defrule
	(current-age >= middle-antiquity-age)
	(goal wait-techup-requirements NO)
	(can-afford-building siege-workshop)
	(building-type-count-total siege-workshop g:< desired-number-workshops)
	(or
		(building-type-count town-center >= 2)
		(or
			(goal gl-home-defense-state YES)
			(goal rush-rushing YES)
		)
	)
	(up-can-build 0 c: siege-workshop)
=>
	(up-build place-normal 0 c: siege-workshop))

(defrule
	(current-age >= early-antiquity-age)
	(can-afford-building blacksmith)
	(building-type-count-total blacksmith g:< desired-number-blacksmiths)
	(or
		(current-age < middle-antiquity-age)
		(or
			(building-type-count town-center >= 2)
			(goal gl-home-defense-state YES)
		)
	)
	(up-can-build 0 c: blacksmith)
=>
	(up-build place-normal 0 c: blacksmith)
)

(defrule
	(current-age >= early-antiquity-age)
	(building-type-count-total market g:< desired-number-markets)
	(up-pending-objects c: market <= 0)
	(up-pending-placement c: market)
	(up-timer-status t-market-placement == timer-triggered)
=>
	;A managed placement can remain pending without ever creating a foundation.
	;Release it and count the expired attempt so the fallback remains reachable.
	(up-reset-placement c: market)
	(up-modify-goal gl-market-placement-attempts c:+ 1)
)

(defrule
	(or
		(current-age == early-antiquity-age)
		(and
			(current-age == middle-antiquity-age)
			(or
				(building-type-count town-center >= 2)
				(or
					(goal gl-home-defense-state YES)
					(goal rush-rushing YES)
				)
			)
		)
	)
	(goal gl-migration-placement-lock NO)
	(can-afford-building market)
	(building-type-count-total market == 0)
	(up-pending-objects c: market <= 0)
	(not (up-pending-placement c: market))
	(up-timer-status t-market-placement != timer-running)
	(up-compare-goal gl-market-placement-attempts c:< 3)
	(up-can-build 0 c: market)
=>
	(up-build place-normal 0 c: market)
	(up-modify-goal gl-market-placement-attempts c:+ 1)
	(up-set-timer c: t-market-placement c: 30)
)

;After three normal failures, clear the managed placement and retry from a
;positive town radius. This cannot issue thousands of identical commands.
(defrule
	(current-age >= early-antiquity-age)
	(goal gl-migration-placement-lock NO)
	(or
		(current-age != middle-antiquity-age)
		(or
			(building-type-count town-center >= 2)
			(or
				(goal gl-home-defense-state YES)
				(goal rush-rushing YES)
			)
		)
	)
	(building-type-count-total market g:< desired-number-markets)
	(up-pending-objects c: market <= 0)
	(up-timer-status t-market-placement != timer-running)
	(up-compare-goal gl-market-placement-attempts c:>= 3)
	(up-can-build 0 c: market)
=>
	(up-reset-placement c: market)
	(up-set-placement-data my-player-number -1 c: 12)
	(up-build place-control 0 c: market)
	(set-goal gl-market-placement-attempts 0)
	(up-set-timer c: t-market-placement c: 180)
)

(defrule
	(building-type-count-total market g:>= desired-number-markets)
	(up-compare-goal gl-market-placement-attempts c:> 0)
=>
	(set-goal gl-market-placement-attempts 0)
)

(defrule
	(current-age == imperial-age)
	(goal gl-migration-placement-lock NO)
	(can-afford-building market)
	(building-type-count-total market g:< desired-number-markets)
	(up-pending-objects c: market <= 0)
	(not (up-pending-placement c: market))
	(up-timer-status t-market-placement != timer-running)
	(up-compare-goal gl-market-placement-attempts c:< 3)
	(up-can-build 0 c: market)
=>
	(up-build place-normal 0 c: market)
	(up-modify-goal gl-market-placement-attempts c:+ 1)
	(up-set-timer c: t-market-placement c: 30)
)

(defrule
	(can-afford-building dock)
	(goal wait-techup-requirements NO)
	(or
		(goal map-type LAKE)
		(or
			(goal map-type RIVERS)
			(or
				(goal map-type ISLANDS)
				(goal map-type TEAM-ISLANDS)
			)
		)
	)
	(building-type-count-total dock g:< desired-number-docks)
	(building-type-count-total lumber-camp >= 1)
	(up-can-build 0 c: dock)
=>
	(up-build place-normal 0 c: dock)
)

(defrule
	(current-age >= middle-antiquity-age)
	(or
		(building-type-count town-center >= 2)
		(game-time >= 990)
	)
	(can-afford-building university)
	(building-type-count-total university g:< desired-number-universities)
	(up-can-build 0 c: university)
=>
	(up-build place-normal 0 c: university))

(defrule
	(current-age >= middle-antiquity-age)
	(or
		(building-type-count town-center >= 2)
		(game-time >= 990)
	)
	(can-afford-building monastery)
	(building-type-count-total monastery g:< desired-number-monasteries)
	(up-can-build 0 c: monastery)
=>
	(up-build place-normal 0 c: monastery))

(defrule
	(current-age >= middle-antiquity-age)
	(building-type-count town-center >= 2)
	(can-afford-building castle)
	(building-type-count-total castle g:< desired-number-castles)
	(up-can-build 0 c: castle)
=>
;	(up-get-fact building-type-count castle gl-number-castles)	
;	(up-modify-goal gl-castle-placement c:= 10)
;	(up-modify-goal gl-castle-placement g:* gl-number-castles)
;	(up-modify-goal gl-castle-placement c:+ 10)
;	(up-modify-goal gl-castle-placement s:min sn-maximum-town-size)
	(up-set-placement-data my-player-number -1 c: 20)	
;	(up-set-placement-data my-player-number -1 g: gl-castle-placement)
	(up-build place-control 0 c: castle)
)

(defrule
	(current-age >= middle-antiquity-age)
	(building-type-count town-center >= 2)
	(can-afford-building outpost)
	(building-type-count-total outpost g:< desired-number-outposts)
	(up-can-build 0 c: outpost)
=>
	(up-build place-normal 0 c: outpost))

(defrule
	(current-age >= early-antiquity-age)
	(or
		(current-age < middle-antiquity-age)
		(or
			(building-type-count town-center >= 2)
			(goal gl-home-defense-state YES)
		)
	)
	(can-afford-building watch-tower)
	(building-type-count-total watch-tower g:< desired-number-watchtowers)
	(up-can-build 0 c: watch-tower)
	(up-pending-objects c: watch-tower < 1)
=>
	(up-get-fact building-type-count watch-tower gl-number-watchtowers)
	
	(up-modify-goal gl-watchtower-placement c:= 4)
	(up-modify-goal gl-watchtower-placement g:* gl-number-watchtowers)
	(up-modify-goal gl-watchtower-placement c:+ 4)
	(up-modify-goal gl-watchtower-placement s:min sn-maximum-town-size)
	
	(up-set-placement-data my-player-number -1 g: gl-watchtower-placement)
	(up-build place-control 0 c: watch-tower)
)

;does not function
;cause unknown

#load-if-not-defined CHINESE-CIV

(defrule
	(and
		(current-age >= early-antiquity-age)
		(goal flank-position 1)
	)
=>
	(enable-wall-placement 2)
	(set-strategic-number sn-gate-type-for-wall 1)
	(chat-local-to-self "Enable walls for flank position")
	(disable-self)
)

(defrule
	(and
		(current-age >= early-antiquity-age)
		(goal flank-position 1)
	)
	(wall-completed-percentage 2 < 100)
	(can-build-wall-with-escrow 2 palisade-wall)
=>
	(release-escrow wood)
	(build-wall 2 palisade-wall)
	(chat-local-to-self "Place walls")
)

(defrule
	(and
		(current-age >= early-antiquity-age)
		(goal flank-position 1)
	)
	(building-type-count-total gate < 4)
	(can-build-gate-with-escrow 2)
=>
	(release-escrow wood)
	(build-gate 2)
	(chat-local-to-self "Place gates")
)

(defrule
	(goal taunt-wall YES)
	(current-age >= early-antiquity-age)
	(wall-completed-percentage 2 < 100)
	(can-build-wall-with-escrow 2 stone-wall-line)
=>
	(release-escrow stone)
	(build-wall 2 stone-wall-line)
	(chat-local-to-self "Place walls")
)

(defrule
	(goal taunt-wall YES)
	(current-age >= early-antiquity-age)
	(building-type-count-total gate < 4)
	(can-build-gate-with-escrow 2)
=>
	(set-strategic-number sn-gate-type-for-wall 0)
	(release-escrow stone)
	(build-gate 2)
	(chat-local-to-self "Place gates")
)

#end-if

#load-if-defined CHINESE-CIV

(defrule
	(true)
=>
	(enable-wall-placement 2)
	(set-strategic-number sn-gate-type-for-wall 0)
	(chat-local-to-self "Enable walls for Chinese")
	(disable-self)
)

(defrule
	(goal age-up-started EARLY-ANTIQUITY)
	(wall-completed-percentage 2 < 100)
	(can-build-wall-with-escrow 2 stone-wall-line)
=>
	(release-escrow stone)
	(build-wall 2 stone-wall-line)
	(chat-local-to-self "Place walls")
)

(defrule
	(goal age-up-started EARLY-ANTIQUITY)
	(building-type-count-total gate < 4)
	(can-build-gate-with-escrow 2)
=>
	(release-escrow stone)
	(build-gate 2)
	(chat-local-to-self "Place gates")
)

#end-if

;farm fallback

(defrule
	(goal gl-farm-placement-suspended NO)
	(current-age >= early-antiquity-age)
	(wood-amount > 150)
	(up-compare-goal gl-farm-build-target > 0)
	(and
		(building-type-count mill >= 1)
		(building-type-count farm == 0)
	)
		(building-type-count farm < gl-farm-build-target)
	(up-can-build 0 c: farm)
=>
	(chat-local-to-self "fallback farm placement")
	(up-build place-normal 0 c: farm)
)


