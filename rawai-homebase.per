;Wall posture starts with the actual exposed flank role. Pocket detection was
;formerly inverted in rawai-map, which gave this doctrine to the wrong players.
(defrule
	(current-age >= early-antiquity-age)
	(goal flank-position 1)
	(goal gl-wall-needed NO)
=>
	(set-goal gl-wall-needed YES)
	(chat-local-to-self "Wall posture: exposed flank")
)

(defrule
	(current-age >= early-antiquity-age)
	(or
		(goal gl-home-defense-state YES)
		(or
			(enemy-buildings-in-town)
			(goal taunt-wall YES)
		)
	)
	(goal gl-wall-needed NO)
=>
	(set-goal gl-wall-needed YES)
	(chat-local-to-self "Wall posture: local threat")
)

;A known enemy economy or military structure in the same active land zone is
;the engine-visible reachability proxy for a mainland opponent. This avoids
;walling an isolated island merely because the Real World map is hybrid.
(defrule
	(current-age >= early-antiquity-age)
	(goal gl-wall-scan-state WALL-SCAN-IDLE)
	(up-compare-goal gl-game-time g:>= gl-wall-scan-next)
	(goal gl-island-colony-established NO)
=>
	(up-modify-goal gl-wall-scan-focus s:= sn-focus-player-number)
	(up-modify-goal gl-wall-land-zone g:= gl-home-zone)
	(set-goal gl-hostile-land-route NO)
	(up-find-player enemy find-ordered gl-wall-scan-player)
	(up-modify-goal gl-wall-scan-first g:= gl-wall-scan-player)
	(set-goal gl-wall-scan-state WALL-SCAN-START)
)

(defrule
	(current-age >= early-antiquity-age)
	(goal gl-wall-scan-state WALL-SCAN-IDLE)
	(up-compare-goal gl-game-time g:>= gl-wall-scan-next)
	(goal gl-island-colony-established YES)
=>
	(up-modify-goal gl-wall-scan-focus s:= sn-focus-player-number)
	(up-modify-goal gl-wall-land-zone g:= gl-island-colony-zone)
	(set-goal gl-hostile-land-route NO)
	(up-find-player enemy find-ordered gl-wall-scan-player)
	(up-modify-goal gl-wall-scan-first g:= gl-wall-scan-player)
	(set-goal gl-wall-scan-state WALL-SCAN-START)
)

(defrule
	(goal gl-wall-scan-state WALL-SCAN-START)
=>
	(up-modify-sn sn-focus-player-number g:= gl-wall-scan-player)
	(up-full-reset-search)
	(up-set-target-point gl-home-anchor-x)
	(up-find-remote c: town-center c: 20)
	(up-find-remote c: barracks c: 20)
	(up-find-remote c: archery-range c: 20)
	(up-find-remote c: stable c: 20)
	(up-find-remote c: castle c: 10)
	(up-remove-objects search-remote object-data-map-zone-id g:!= gl-wall-land-zone)
	(up-clean-search search-remote object-data-distance search-order-asc)
	(up-modify-sn sn-focus-player-number g:= gl-wall-scan-focus)
	(set-goal gl-wall-scan-state WALL-SCAN-CHECK)
)

(defrule
	(goal gl-wall-scan-state WALL-SCAN-CHECK)
	(up-set-target-object search-remote c: 0)
=>
	(set-goal gl-hostile-land-route YES)
	(set-goal gl-wall-needed YES)
	(up-modify-goal gl-wall-scan-next g:= gl-game-time)
	(up-modify-goal gl-wall-scan-next c:+ 90)
	(up-chat-data-to-self "Wall posture same-zone enemy: %d" g: gl-wall-scan-player)
	(set-goal gl-wall-scan-state WALL-SCAN-IDLE)
)

(defrule
	(goal gl-wall-scan-state WALL-SCAN-CHECK)
	(not (up-set-target-object search-remote c: 0))
=>
	(set-goal gl-wall-scan-state WALL-SCAN-ADVANCE)
)

(defrule
	(goal gl-wall-scan-state WALL-SCAN-ADVANCE)
=>
	(up-find-next-player enemy find-ordered gl-wall-scan-player)
	(set-goal gl-wall-scan-state WALL-SCAN-NEXT)
)

(defrule
	(goal gl-wall-scan-state WALL-SCAN-NEXT)
	(up-compare-goal gl-wall-scan-player g:!= gl-wall-scan-first)
=>
	(set-goal gl-wall-scan-state WALL-SCAN-START)
)

(defrule
	(goal gl-wall-scan-state WALL-SCAN-NEXT)
	(up-compare-goal gl-wall-scan-player g:== gl-wall-scan-first)
=>
	(up-modify-sn sn-focus-player-number g:= gl-wall-scan-focus)
	(up-modify-goal gl-wall-scan-next g:= gl-game-time)
	(up-modify-goal gl-wall-scan-next c:+ 90)
	(set-goal gl-wall-scan-state WALL-SCAN-IDLE)
)

(defrule
	(current-age >= early-antiquity-age)
	(goal gl-wall-needed YES)
	(goal gl-wall-enabled NO)
=>
	(enable-wall-placement 2)
	(set-goal gl-wall-enabled YES)
	(chat-local-to-self "Wall placement owner enabled")
)

;Completion quarters act as a progress latch using only classic wall facts.
;Each new quarter clears the no-progress retry count. Three commands without a
;new quarter trigger a three-minute backoff, preventing the replayed identical-
;segment loop from multiplying across every newly eligible AI.
(defrule
	(wall-completed-percentage 2 >= 25)
	(up-compare-goal gl-wall-last-percent c:< 25)
=>
	(set-goal gl-wall-last-percent 25)
	(set-goal gl-wall-retries 0)
)

(defrule
	(wall-completed-percentage 2 >= 50)
	(up-compare-goal gl-wall-last-percent c:< 50)
=>
	(set-goal gl-wall-last-percent 50)
	(set-goal gl-wall-retries 0)
)

(defrule
	(wall-completed-percentage 2 >= 75)
	(up-compare-goal gl-wall-last-percent c:< 75)
=>
	(set-goal gl-wall-last-percent 75)
	(set-goal gl-wall-retries 0)
)

;Choose one material for perimeter 2 and retain it. Switching the strategic
;gate type between stone and palisade retries can make build-gate interpret an
;already-started perimeter with the wrong gate family.
(defrule
	(goal gl-wall-needed YES)
	(goal gl-wall-material WALL-MATERIAL-UNSET)
	(can-build-wall-with-escrow 2 stone-wall-line)
=>
	(set-goal gl-wall-material WALL-MATERIAL-STONE)
	(set-strategic-number sn-gate-type-for-wall 0)
	(chat-local-to-self "Wall owner latched stone perimeter")
)

(defrule
	(goal gl-wall-needed YES)
	(goal gl-wall-material WALL-MATERIAL-UNSET)
	(not (can-build-wall-with-escrow 2 stone-wall-line))
	(can-build-wall-with-escrow 2 palisade-wall)
=>
	(set-goal gl-wall-material WALL-MATERIAL-PALISADE)
	(set-strategic-number sn-gate-type-for-wall 1)
	(chat-local-to-self "Wall owner latched palisade perimeter")
)

