;Under sustained population pressure, put one new House at the confirmed
;colony instead of consuming another military-production tile around the home
;Mill. This is replacement-free: completed inner housing is never deleted.
;CB BEGIN 1181
(defrule
	(goal gl-owner-worker-hold NO)
	(goal gl-house-pressure YES)
	(goal gl-island-colony-established YES)
	(goal gl-migration-placement-lock NO)
	(up-timer-status t-house-pressure == timer-triggered)
	(up-pending-objects c: house < 2)
	(population-headroom > 0)
	(housing-headroom < 3)
	(up-timer-status t-house-placement != timer-running)
	(can-afford-building house)
	(up-can-build 0 c: house)
	(or
		(goal map-type RIVERS)
		(or
			(goal map-type ISLANDS)
			(goal map-type TEAM-ISLANDS)
		)
	)
=>
	(set-goal gl-cbf-cont 1181)
)
(defrule
	(goal gl-cbf-cont 1181)
=>
	(up-copy-point point2-x gl-island-colony-x)
	(up-modify-goal point2-x c:+ 6)
	(up-modify-goal point2-y c:+ 6)
	(up-bound-point point3-x point2-x)
	(up-set-target-point point3-x)
)
(defrule
	(goal gl-cbf-cont 1181)
=>
	(set-goal gl-cbf-site 1181)
	(set-goal gl-cbf-kind 3)
	(set-goal gl-cbf-args0 -2)
	(set-goal gl-cbf-args1 -2)
	(set-goal gl-cbf-args2 -2)
	(set-goal gl-cbf-args3 -2)
	(set-goal gl-cbf-point-y -2)
	(up-get-rule-id gl-cbf-return)
	(up-modify-goal gl-cbf-return c:+ 1)
	(up-jump-direct g: gl-cbf-entry)
)
(defrule
	(goal gl-cbf-cont 1181)
=>
	(up-build place-point 0 c: house)
)
(defrule
	(goal gl-cbf-cont 1181)
=>
	(set-goal gl-cbf-site 1181)
	(set-goal gl-cbf-kind 2)
	(set-goal gl-cbf-args0 -2)
	(set-goal gl-cbf-args1 -2)
	(set-goal gl-cbf-args2 -2)
	(set-goal gl-cbf-args3 -2)
	(set-goal gl-cbf-point-y -2)
	(up-get-rule-id gl-cbf-return)
	(up-modify-goal gl-cbf-return c:+ 1)
	(up-jump-direct g: gl-cbf-entry)
)
(defrule
	(goal gl-cbf-cont 1181)
=>
	(up-set-timer c: t-house-pressure c: 30)
	(up-set-timer c: t-house-placement c: 8)
)
(defrule
	(goal gl-cbf-cont 1181)
=>
	(set-goal gl-cbf-cont 0)
)
;CB END 1181

