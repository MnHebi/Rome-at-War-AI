	(up-modify-goal gl-lumbercamp-rejected-resource-id g:= gl-lumbercamp-resource-id)
	(up-chat-data-to-self "lumber camp deleted stale resource foundation: %d" g: gl-lumbercamp-foundation-id)
	(up-modify-sn sn-focus-player-number g:= gl-lumbercamp-placement-focus)
	(set-goal gl-lumbercamp-placement-attempts 0)
	(up-set-timer c: t-lumbercamp-placement c: 30)
	(set-goal gl-lumbercamp-placement-state PLACEMENT-IDLE)
)
(defrule
	(goal gl-cbf-cont 1191)
=>
	(set-goal gl-cbf-cont 0)
)
;CB END 1191

;Four builders can complete the tiny foundation before the WAIT sweep ever
;observes a pending object. Resolve a ready camp at the exact candidate before
;classifying that successful build as a failed offset.
(defrule
	(goal gl-lumbercamp-placement-state PLACEMENT-WAIT)
	(up-timer-status t-lumbercamp-placement == timer-triggered)
	(up-pending-objects c: lumber-camp <= 0)
	(building-type-count-total lumber-camp >= 1)
=>
	(set-strategic-number sn-focus-player-number my-player-number)
	(up-full-reset-search)
	(up-set-target-point gl-lumbercamp-target-x)
	(up-filter-distance c: -1 c: 8)
	(up-filter-status c: status-ready c: list-active)
	(up-find-local c: lumber-camp c: 8)
	(up-remove-objects search-local object-data-map-zone-id g:!= gl-lumbercamp-resource-zone)
	(up-clean-search search-local object-data-distance search-order-asc)
	(set-goal gl-lumbercamp-placement-state PLACEMENT-FIND-COMPLETED)
)

(defrule
	(goal gl-lumbercamp-placement-state PLACEMENT-FIND-COMPLETED)
	(up-set-target-object search-local c: 0)
=>
	(set-strategic-number sn-focus-player-number 0)
	(up-full-reset-search)
	(up-add-object-by-id search-remote g: gl-lumbercamp-resource-id)
	(set-goal gl-lumbercamp-placement-state PLACEMENT-VALIDATE-COMPLETED-RESOURCE)
)

(defrule
	(goal gl-lumbercamp-placement-state PLACEMENT-FIND-COMPLETED)
	(not (up-set-target-object search-local c: 0))
=>
	(up-reset-placement c: lumber-camp)
	(set-goal gl-lumbercamp-placement-state PLACEMENT-PLACE)
)

(defrule
	(goal gl-lumbercamp-placement-state PLACEMENT-VALIDATE-COMPLETED-RESOURCE)
	(up-set-target-object search-remote c: 0)
	(up-object-data object-data-class == tree-class)
	(up-object-data object-data-map-zone-id g:== gl-lumbercamp-resource-zone)
=>
	(up-chat-data-to-self "lumber camp accepted completed resource: %d" g: gl-lumbercamp-resource-id)
	(up-modify-sn sn-focus-player-number g:= gl-lumbercamp-placement-focus)
	(set-goal gl-lumbercamp-placement-attempts 0)
	(set-goal gl-lumbercamp-candidate-index 0)
	(up-set-timer c: t-lumbercamp-placement c: 90)
	(set-goal gl-lumbercamp-placement-state PLACEMENT-IDLE)
)

(defrule
	(goal gl-lumbercamp-placement-state PLACEMENT-VALIDATE-COMPLETED-RESOURCE)
	(or
		(not (up-set-target-object search-remote c: 0))
		(or
			(up-object-data object-data-class != tree-class)
			(up-object-data object-data-map-zone-id g:!= gl-lumbercamp-resource-zone)
		)
	)
=>
	;Never delete a completed drop site merely because its exact sampled tree was
	;cut down while builders worked. Reject that sample and seek another cluster.
	(up-modify-goal gl-lumbercamp-rejected-resource-id3 g:= gl-lumbercamp-rejected-resource-id2)
	(up-modify-goal gl-lumbercamp-rejected-resource-id2 g:= gl-lumbercamp-rejected-resource-id)
	(up-modify-goal gl-lumbercamp-rejected-resource-id g:= gl-lumbercamp-resource-id)
	(up-modify-sn sn-focus-player-number g:= gl-lumbercamp-placement-focus)
	(set-goal gl-lumbercamp-placement-attempts 0)
	(up-set-timer c: t-lumbercamp-placement c: 30)
	(set-goal gl-lumbercamp-placement-state PLACEMENT-IDLE)
)

(defrule
	(goal gl-lumbercamp-placement-state PLACEMENT-WAIT)
	(up-timer-status t-lumbercamp-placement == timer-triggered)
	(up-pending-objects c: lumber-camp <= 0)
	(up-compare-goal gl-lumbercamp-placement-attempts c:< 4)
=>
	(up-reset-placement c: lumber-camp)
	(up-set-timer c: t-lumbercamp-placement c: 30)
	(set-goal gl-lumbercamp-placement-state PLACEMENT-PLACE)
)

(defrule
	(goal gl-lumbercamp-placement-state PLACEMENT-WAIT)
	(up-timer-status t-lumbercamp-placement == timer-triggered)
	(up-pending-objects c: lumber-camp <= 0)
	(up-compare-goal gl-lumbercamp-placement-attempts c:>= 4)
=>
	(up-reset-placement c: lumber-camp)
	(up-modify-goal gl-lumbercamp-rejected-resource-id3 g:= gl-lumbercamp-rejected-resource-id2)
	(up-modify-goal gl-lumbercamp-rejected-resource-id2 g:= gl-lumbercamp-rejected-resource-id)
	(up-modify-goal gl-lumbercamp-rejected-resource-id g:= gl-lumbercamp-resource-id)
	(up-chat-data-to-self "lumber camp exhausted offsets at resource: %d" g: gl-lumbercamp-resource-id)
	(up-modify-sn sn-focus-player-number g:= gl-lumbercamp-placement-focus)
	(set-goal gl-lumbercamp-placement-attempts 0)
	(up-set-timer c: t-lumbercamp-placement c: 60)
	(set-goal gl-lumbercamp-placement-state PLACEMENT-IDLE)
)

(defrule
	(up-timer-status t-lumbercamp-placement == timer-triggered)
	(up-compare-goal gl-lumbercamp-placement-state c:!= PLACEMENT-IDLE)
=>
	(up-reset-placement c: lumber-camp)
	(up-modify-sn sn-focus-player-number g:= gl-lumbercamp-placement-focus)
	(up-set-timer c: t-lumbercamp-placement c: 30)
	(set-goal gl-lumbercamp-placement-state PLACEMENT-IDLE)
)

;CB BEGIN 1192
(defrule
	(goal gl-owner-worker-hold NO)
	(and	
		(up-gaia-type-count c: food >= 5)
		(and
			(building-type-count-total lumber-camp >= 1)
			(and
				(building-type-count-total farm g:< gl-farm-build-target)
				(building-type-count-total mill g:< desired-number-mills)
			)
		)
	)
			(goal gl-island-migration-state MIGRATION-IDLE)
	(building-type-count-total mill > 0)
	(dropsite-min-distance food > 12)
	(dropsite-min-distance food g:< map-size)
	(can-afford-building mill)
	(up-pending-objects c: mill <= 0)
	(up-can-build 0 c: mill)
=>
	(set-goal gl-cbf-cont 1192)
)
(defrule
	(goal gl-cbf-cont 1192)
=>
	(set-goal gl-cbf-site 1192)
	(set-goal gl-cbf-kind 3)
	(set-goal gl-cbf-args0 -2)
	(set-goal gl-cbf-args1 -2)
	(set-goal gl-cbf-args2 -2)
	(set-goal gl-cbf-args3 -2)
	(set-goal gl-cbf-point-y -2)
	(up-get-rule-id gl-cbf-return)
	(up-modify-goal gl-cbf-return c:+ 1)
	(up-jump-direct g: gl-cbf-entry)
)
(defrule
	(goal gl-cbf-cont 1192)
=>
	(up-build place-normal 0 c: mill)
)
(defrule
	(goal gl-cbf-cont 1192)
=>
	(set-goal gl-cbf-site 1192)
	(set-goal gl-cbf-kind 2)
	(set-goal gl-cbf-args0 -2)
	(set-goal gl-cbf-args1 -2)
	(set-goal gl-cbf-args2 -2)
	(set-goal gl-cbf-args3 -2)
	(set-goal gl-cbf-point-y -2)
	(up-get-rule-id gl-cbf-return)
	(up-modify-goal gl-cbf-return c:+ 1)
	(up-jump-direct g: gl-cbf-entry)
)
(defrule
	(goal gl-cbf-cont 1192)
=>
	(set-goal gl-cbf-cont 0)
)
;CB END 1192

(defrule
	(goal dependent-farms FARM-DEMAND-DEPENDENT)
=>
	(up-modify-goal gl-farm-build-target g:= villager-count)
	(up-modify-goal gl-farm-build-target s:%* sn-food-gatherer-percentage)
	(up-modify-goal 510 g:= gl-farm-build-target)
	(up-get-fact unit-type-count villager-food 509)
	(up-modify-goal gl-farm-build-target g:- 509)
	(up-get-fact unit-type-count villager-farmer 509)
	(up-modify-goal gl-farm-build-target g:+ 509)
	;At most two shore fishermen may substitute for farms. Add the full
	;fisherman count back, then discount only the bounded supplement.
	(up-get-fact unit-type-count villager-fisherman 509)
	(up-modify-goal gl-farm-build-target g:+ 509)
	(up-modify-goal 509 c:min 2)
	(up-modify-goal gl-farm-build-target g:- 509)
	(up-modify-goal gl-farm-build-target c:max 0)
	(up-modify-goal 510 c:+ 2);
	(up-modify-goal gl-farm-build-target g:min 510)
)

;Once land food is exhausted, derive farms from the current villager economy,
;not the phase's population-cap percentage. Shore fishing remains a bounded
;supplement, so it cannot displace more than two farms.
(defrule
	(goal dependent-farms FARM-DEMAND-INDEPENDENT)
=>
	(up-modify-goal gl-farm-build-target g:= villager-count)
	(up-modify-goal gl-farm-build-target s:%* sn-food-gatherer-percentage)
	(up-get-fact unit-type-count villager-fisherman 509)
	(up-modify-goal 509 c:min 2)
	(up-modify-goal gl-farm-build-target g:- 509)
	(up-modify-goal gl-farm-build-target c:max 0)
)

;Farm construction and farm staffing are separate invariants. A completed
;abandoned Farm must be reclaimed even when the building target is already met.
;The tasker handles one worker per bounded pass and only targets a Farm in the
;worker's land zone, so it never issues an impossible across-water gather order.
;A sampled T53 retask is observed on the next farm timer episode.  Keeping this
(load "rawai-boarding-ctrl-post")
;observer on the controller's own idle boundary prevents its diagnostic search
;from disturbing a live farm candidate list.
(defrule
	(goal gl-econ-retask-diag-state 2)
	(up-compare-goal gl-game-time g:>= gl-econ-retask-diag-due)
	(up-timer-status t-farm-staffing == timer-triggered)
	(goal gl-farm-staffing-state FARM-STAFFING-IDLE)
=>
	(up-full-reset-search)
	(up-add-object-by-id search-local g: gl-econ-retask-diag-actor)
	(up-remove-objects search-local object-data-player != my-player-number)
	(set-goal gl-econ-retask-diag-state 3)
)

;T55B: cross-player coverage summary, independent of the detail latch.
;Counts are PER command-site invocations (including an empty post-filter list),
;not outgoing native packets. Samples can straddle a summary window.
(defrule
	(up-compare-goal gl-game-time g:>= gl-econ-retask-summary-next)
=>
	(up-modify-goal gl-econ-retask-unsampled g:= gl-econ-retask-count1)
	(up-modify-goal gl-econ-retask-unsampled g:+ gl-econ-retask-count2)
	(up-modify-goal gl-econ-retask-unsampled g:+ gl-econ-retask-count3)
	(up-modify-goal gl-econ-retask-unsampled g:+ gl-econ-retask-count4)
	(up-modify-goal gl-econ-retask-unsampled g:- gl-econ-retask-sampled)
	(up-modify-goal gl-econ-retask-unsampled c:max 0)
	(up-chat-data-to-all str-t12-diag-id c: 659)
	(up-chat-data-to-all str-t12-diag-value g: gl-game-time)
	(up-chat-data-to-all str-t12-diag-id c: 660)
	(up-chat-data-to-all str-t12-diag-value g: gl-econ-retask-count1)
	(up-chat-data-to-all str-t12-diag-id c: 661)
	(up-chat-data-to-all str-t12-diag-value g: gl-econ-retask-count2)
	(up-chat-data-to-all str-t12-diag-id c: 662)
	(up-chat-data-to-all str-t12-diag-value g: gl-econ-retask-count3)
	(up-chat-data-to-all str-t12-diag-id c: 663)
	(up-chat-data-to-all str-t12-diag-value g: gl-econ-retask-count4)
	(up-chat-data-to-all str-t12-diag-id c: 664)
	(up-chat-data-to-all str-t12-diag-value g: gl-econ-retask-sampled)
	(up-chat-data-to-all str-t12-diag-id c: 665)
	(up-chat-data-to-all str-t12-diag-value g: gl-econ-retask-unsampled)
	(set-goal gl-econ-retask-count1 0)
	(set-goal gl-econ-retask-count2 0)
	(set-goal gl-econ-retask-count3 0)
	(set-goal gl-econ-retask-count4 0)
	(set-goal gl-econ-retask-sampled 0)
	(up-modify-goal gl-econ-retask-summary-next g:= gl-game-time)
	(up-modify-goal gl-econ-retask-summary-next c:+ 300)
)

(defrule
	(goal gl-econ-retask-diag-state 3)
	(up-set-target-object search-local c: 0)
=>
	(up-get-object-data object-data-action gl-econ-retask-diag-action)
	(up-get-object-data object-data-target-id gl-econ-retask-diag-target)
	(up-get-object-data object-data-language-id gl-econ-retask-diag-language)
	(up-get-object-data object-data-gather-type gl-econ-retask-diag-gather)
	(up-get-fact game-time 0 gl-econ-retask-diag-time)
	(up-chat-data-to-all str-t12-diag-id c: 651)
	(up-chat-data-to-all str-t12-diag-value g: gl-econ-retask-diag-actor)
	(up-chat-data-to-all str-t12-diag-id c: 652)
	(up-chat-data-to-all str-t12-diag-value g: gl-econ-retask-diag-action)
	(up-chat-data-to-all str-t12-diag-id c: 653)
	(up-chat-data-to-all str-t12-diag-value g: gl-econ-retask-diag-target)
	(up-chat-data-to-all str-t12-diag-id c: 654)
	(up-chat-data-to-all str-t12-diag-value g: gl-econ-retask-diag-language)
	(up-chat-data-to-all str-t12-diag-id c: 655)
	(up-chat-data-to-all str-t12-diag-value g: gl-econ-retask-diag-gather)
	(up-chat-data-to-all str-t12-diag-id c: 656)
	(up-chat-data-to-all str-t12-diag-value g: gl-econ-retask-diag-time)
	(up-chat-data-to-all str-t12-diag-id c: 657)
	(up-chat-data-to-all str-t12-diag-value c: 1)
	(up-chat-data-to-all str-t12-diag-id c: 658)
	(up-chat-data-to-all str-t12-diag-value c: 2)
	(up-modify-goal gl-econ-retask-sampled c:+ 1)
	(up-modify-goal gl-econ-retask-diag-next g:= gl-econ-retask-diag-time)
	(up-modify-goal gl-econ-retask-diag-next c:+ 300)
	(set-goal gl-econ-retask-diag-state 0)
)

(defrule
	(goal gl-econ-retask-diag-state 3)
	(not (up-set-target-object search-local c: 0))
=>
	(up-get-fact game-time 0 gl-econ-retask-diag-time)
	(up-chat-data-to-all str-t12-diag-id c: 651)
	(up-chat-data-to-all str-t12-diag-value g: gl-econ-retask-diag-actor)
	(up-chat-data-to-all str-t12-diag-id c: 656)
	(up-chat-data-to-all str-t12-diag-value g: gl-econ-retask-diag-time)
	(up-chat-data-to-all str-t12-diag-id c: 657)
	(up-chat-data-to-all str-t12-diag-value c: 0)
	(up-chat-data-to-all str-t12-diag-id c: 658)
	(up-chat-data-to-all str-t12-diag-value c: 2)
	(up-modify-goal gl-econ-retask-sampled c:+ 1)
	(up-modify-goal gl-econ-retask-diag-next g:= gl-econ-retask-diag-time)
	(up-modify-goal gl-econ-retask-diag-next c:+ 300)
	(set-goal gl-econ-retask-diag-state 0)
)

(defrule
	(goal gl-econ-retask-diag-state 0)
	(goal gl-econ-retask-diag-armed NO)
	(up-compare-goal gl-game-time g:>= gl-econ-retask-diag-next)
=>
	(set-goal gl-econ-retask-diag-armed YES)
)

(defrule
	(up-timer-status t-farm-staffing == timer-triggered)
	(goal gl-farm-staffing-state FARM-STAFFING-IDLE)
	(goal gl-island-migration-state MIGRATION-IDLE)
	(building-type-count farm >= 1)
	(or
		(unit-type-count villager-fisherman > 0)
		(unit-type-count villager-farmer g:< gl-farm-build-target)
	)
=>
	(up-modify-goal gl-farm-staffing-focus s:= sn-focus-player-number)
	(set-strategic-number sn-focus-player-number my-player-number)
	(up-full-reset-search)
	(up-set-target-point position-self-x)
	(up-filter-distance c: -1 g: map-size)
	(up-filter-status c: status-ready c: list-active)
	(up-find-remote c: farm c: 240)
	(up-remove-objects search-remote object-data-tasks-count > 0)
	(up-clean-search search-remote object-data-distance search-order-asc)
	(set-goal gl-farm-staffing-state FARM-STAFFING-FIND-FARM)
)

(defrule
	(goal gl-farm-staffing-state FARM-STAFFING-FIND-FARM)
	(up-set-target-object search-remote c: 0)
=>
	(up-get-object-data object-data-id gl-farm-staffing-id)
	(up-get-object-data object-data-map-zone-id gl-farm-staffing-zone)
	(up-modify-goal gl-econ-retask-diag-target-id g:= gl-farm-staffing-id)
	(up-get-object-data object-data-type gl-econ-retask-diag-target-type)
	(up-get-object-data object-data-class gl-econ-retask-diag-target-class)
	(up-get-point position-object point2-x)
	;Keep the remaining Farm candidates in search-remote. If this Farm's zone has
	;lost every eligible worker, the failure path can reject it and advance.
	(up-reset-search 1 1 0 0)
	(up-set-target-point point2-x)
	(up-find-local c: villager-class c: 240)
	(up-remove-objects search-local object-data-group-flag >= 0)
	(up-remove-objects search-local object-data-language-id != lid-villager-fisherman)
	(up-remove-objects search-local object-data-garrisoned == 1)
	;Ctrl retasking may discard carried resources. Carrying workers remain on
	;their current job and may be reconsidered on a later bounded pass.
	(up-remove-objects search-local object-data-carry > 0)
	(up-remove-objects search-local object-data-map-zone-id g:!= gl-farm-staffing-zone)
	(up-clean-search search-local object-data-distance search-order-asc)
	(up-remove-objects search-local object-data-index >= 1)
	(set-goal gl-farm-staffing-state FARM-STAFFING-CHECK-FISHERMAN)
)

(defrule
	(goal gl-farm-staffing-state FARM-STAFFING-CHECK-FISHERMAN)
	(goal gl-econ-retask-diag-armed YES)
	(goal gl-econ-retask-diag-state 0)
	(up-set-target-object search-local c: 0)
=>
	(set-goal gl-econ-retask-diag-writer 1)
	(up-get-object-data object-data-id gl-econ-retask-diag-actor)
	(up-get-object-data object-data-action gl-econ-retask-diag-action)
	(up-get-object-data object-data-target-id gl-econ-retask-diag-target)
	(up-get-object-data object-data-language-id gl-econ-retask-diag-language)
	(up-get-object-data object-data-gather-type gl-econ-retask-diag-gather)
	(up-get-object-data object-data-carry gl-econ-retask-diag-carry)
	(up-get-fact game-time 0 gl-econ-retask-diag-time)
	(up-chat-data-to-all str-t12-diag-id c: 640)
	(up-chat-data-to-all str-t12-diag-value g: gl-econ-retask-diag-writer)
	(up-chat-data-to-all str-t12-diag-id c: 641)
	(up-chat-data-to-all str-t12-diag-value g: gl-econ-retask-diag-actor)
	(up-chat-data-to-all str-t12-diag-id c: 642)
	(up-chat-data-to-all str-t12-diag-value g: gl-econ-retask-diag-action)
	(up-chat-data-to-all str-t12-diag-id c: 643)
	(up-chat-data-to-all str-t12-diag-value g: gl-econ-retask-diag-target)
	(up-chat-data-to-all str-t12-diag-id c: 644)
	(up-chat-data-to-all str-t12-diag-value g: gl-econ-retask-diag-language)
	(up-chat-data-to-all str-t12-diag-id c: 645)
	(up-chat-data-to-all str-t12-diag-value g: gl-econ-retask-diag-gather)
	(up-chat-data-to-all str-t12-diag-id c: 646)
	(up-chat-data-to-all str-t12-diag-value g: gl-econ-retask-diag-carry)
	(set-goal gl-econ-retask-diag-state 1)
)

(defrule
	(goal gl-farm-staffing-state FARM-STAFFING-CHECK-FISHERMAN)
	(goal gl-econ-retask-diag-state 1)
=>
	(up-chat-data-to-all str-t12-diag-id c: 647)
	(up-chat-data-to-all str-t12-diag-value g: gl-econ-retask-diag-target-id)
	(up-chat-data-to-all str-t12-diag-id c: 648)
	(up-chat-data-to-all str-t12-diag-value g: gl-econ-retask-diag-target-type)
	(up-chat-data-to-all str-t12-diag-id c: 649)
	(up-chat-data-to-all str-t12-diag-value g: gl-econ-retask-diag-target-class)
	(up-chat-data-to-all str-t12-diag-id c: 650)
	(up-chat-data-to-all str-t12-diag-value g: gl-econ-retask-diag-time)
	(up-modify-goal gl-econ-retask-diag-due g:= gl-econ-retask-diag-time)
	(up-modify-goal gl-econ-retask-diag-due c:+ 2)
	(set-goal gl-econ-retask-diag-armed NO)
	(set-goal gl-econ-retask-diag-state 2)
)

;CB BEGIN 1193
(defrule
	(goal gl-farm-staffing-state FARM-STAFFING-CHECK-FISHERMAN)
	(up-set-target-object search-local c: 0)
=>
	(set-goal gl-cbf-cont 1193)
)
(defrule
	(goal gl-cbf-cont 1193)
