
; Straight from AiBuilder files. Now extensively modified.

;Builder targets are persistent foundation assignments. They speed large
;buildings without globally converting most gatherers -- including animal-food
;workers -- into builders every time a foundation appears.
(defrule
	(true)
=>
	(up-assign-builders c: town-center-foundation c: 6)
	(up-assign-builders c: market c: 4)
	(up-assign-builders c: university c: 4)
	(up-assign-builders c: monastery c: 4)
	(up-assign-builders c: siege-workshop c: 4)
	(up-assign-builders c: dock c: 4)
	(up-assign-builders c: shipyard c: 4)
	(up-assign-builders c: caravanserai c: 4)
	(up-assign-builders c: castle c: 10)
	(up-assign-builders c: wonder c: 15)
	(disable-self)
)

;Do not let the automatic builder-assistance pool pull shepherds or hunters
;away while animal food is still being harvested. Explicit foundation builder
;targets above remain available for large structures.
(defrule
	(or
		(unit-type-count villager-shepherd >= 1)
		(unit-type-count villager-hunter >= 1)
	)
	(or
		(strategic-number sn-disable-builder-assistance != 1)
		(or
			(strategic-number sn-retask-gather-amount != 40)
			(strategic-number sn-max-retask-gather-amount != 40)
		)
	)
=>
	(set-strategic-number sn-disable-builder-assistance 1)
	;This is a global engine control, so use the documented normal maximum as a
	;bounded retention floor instead of freezing every resource worker.
	(set-strategic-number sn-retask-gather-amount 40)
	(set-strategic-number sn-max-retask-gather-amount 40)
)

(defrule
	(unit-type-count villager-shepherd <= 0)
	(unit-type-count villager-hunter <= 0)
	(or
		(strategic-number sn-disable-builder-assistance != 0)
		(or
			(strategic-number sn-retask-gather-amount != 20)
			(strategic-number sn-max-retask-gather-amount != 40)
		)
	)
=>
	(set-strategic-number sn-disable-builder-assistance 0)
	(set-strategic-number sn-retask-gather-amount 20)
	(set-strategic-number sn-max-retask-gather-amount 40)
)

;Temporarily pull extra villagers onto large foundations. The percentages and
;caps return to the normal economy profile as soon as those foundations finish.
(defrule
	(or
		(up-pending-objects c: castle >= 1)
		(up-pending-objects c: wonder >= 1)
	)
	(strategic-number sn-percent-civilian-builders != 35)
=>
	(set-strategic-number sn-percent-civilian-builders 35)
	(set-strategic-number sn-cap-civilian-builders 15)
	(set-strategic-number sn-percent-civilian-gatherers 65)
)

(defrule
	(and
		(up-pending-objects c: castle <= 0)
		(up-pending-objects c: wonder <= 0)
	)
	(or
		(up-pending-objects c: town-center >= 1)
		(or
			(up-pending-objects c: market >= 1)
			(or
				(up-pending-objects c: university >= 1)
				(or
					(up-pending-objects c: monastery >= 1)
					(or
						(up-pending-objects c: siege-workshop >= 1)
						(or
							(up-pending-objects c: dock >= 1)
							(or
								(up-pending-objects c: shipyard >= 1)
								(up-pending-objects c: caravanserai >= 1)
							)
						)
					)
				)
			)
		)
	)
	(strategic-number sn-percent-civilian-builders != 25)
=>
	(set-strategic-number sn-percent-civilian-builders 25)
	(set-strategic-number sn-cap-civilian-builders 10)
	(set-strategic-number sn-percent-civilian-gatherers 75)
)

(defrule
	(up-pending-objects c: castle <= 0)
	(up-pending-objects c: wonder <= 0)
	(up-pending-objects c: town-center <= 0)
	(up-pending-objects c: market <= 0)
	(up-pending-objects c: university <= 0)
	(up-pending-objects c: monastery <= 0)
	(up-pending-objects c: siege-workshop <= 0)
	(up-pending-objects c: dock <= 0)
	(up-pending-objects c: shipyard <= 0)
	(up-pending-objects c: caravanserai <= 0)
	(strategic-number sn-percent-civilian-builders != 15)
=>
	(set-strategic-number sn-percent-civilian-builders 15)
	(set-strategic-number sn-cap-civilian-builders 8)
	(set-strategic-number sn-percent-civilian-gatherers 85)
)

;A pending placement must persist for twelve seconds before it is classified as
;crowding. Naval and exact point-placement owners are intentionally excluded:
;increasing a land town radius cannot fix an impossible shoreline or a rejected
;resource cluster.
(defrule
	(goal gl-placement-pressure-state PLACEMENT-PRESSURE-IDLE)
	(goal gl-placement-pressure-cap 0)
	(or
		(up-pending-placement c: house)
		(or
			(up-pending-placement c: barracks)
			(or
				(up-pending-placement c: archery-range)
				(or
					(up-pending-placement c: stable)
					(or
						(up-pending-placement c: siege-workshop)
						(up-pending-placement c: blacksmith)
					)
				)
			)
		)
	)
=>
	(up-modify-goal gl-placement-pressure-cap s:= sn-maximum-town-size)
	(up-modify-goal gl-placement-pressure-cap c:+ 24)
)

(defrule
	(goal gl-placement-pressure-state PLACEMENT-PRESSURE-IDLE)
	(goal gl-placement-pressure-cap 0)
	(or
		(up-pending-placement c: university)
		(or
			(up-pending-placement c: monastery)
			(or
				(up-pending-placement c: castle)
				(or
					(up-pending-placement c: watch-tower)
					(or
						(up-pending-placement c: outpost)
						(up-pending-placement c: wonder)
					)
				)
			)
		)
	)
=>
	(up-modify-goal gl-placement-pressure-cap s:= sn-maximum-town-size)
	(up-modify-goal gl-placement-pressure-cap c:+ 24)
)

(defrule
	(goal gl-placement-pressure-state PLACEMENT-PRESSURE-IDLE)
	(up-pending-placement c: house)
=>
	(up-modify-goal gl-placement-pressure-next g:= gl-game-time)
	(up-modify-goal gl-placement-pressure-next c:+ 12)
	(set-goal gl-placement-pressure-saturated NO)
	(set-goal gl-placement-pressure-category PLACEMENT-KIND-ECONOMY)
	(set-goal gl-placement-pressure-state PLACEMENT-PRESSURE-WAIT)
)

(defrule
	(goal gl-placement-pressure-state PLACEMENT-PRESSURE-IDLE)
	(or
		(up-pending-placement c: barracks)
		(or
			(up-pending-placement c: archery-range)
			(or
				(up-pending-placement c: stable)
				(or
					(up-pending-placement c: siege-workshop)
					(up-pending-placement c: blacksmith)
				)
			)
		)
	)
=>
	(up-modify-goal gl-placement-pressure-next g:= gl-game-time)
	(up-modify-goal gl-placement-pressure-next c:+ 12)
	(set-goal gl-placement-pressure-saturated NO)
	(set-goal gl-placement-pressure-category PLACEMENT-KIND-MILITARY)
	(set-goal gl-placement-pressure-state PLACEMENT-PRESSURE-WAIT)
)

(defrule
	(goal gl-placement-pressure-state PLACEMENT-PRESSURE-IDLE)
	(or
		(up-pending-placement c: university)
		(or
			(up-pending-placement c: monastery)
			(or
				(up-pending-placement c: castle)
				(or
					(up-pending-placement c: watch-tower)
					(or
						(up-pending-placement c: outpost)
						(up-pending-placement c: wonder)
					)
				)
			)
		)
	)
=>
	(up-modify-goal gl-placement-pressure-next g:= gl-game-time)
	(up-modify-goal gl-placement-pressure-next c:+ 12)
	(set-goal gl-placement-pressure-saturated NO)
	(set-goal gl-placement-pressure-category PLACEMENT-KIND-DEFENSE)
	(set-goal gl-placement-pressure-state PLACEMENT-PRESSURE-WAIT)
)

(defrule
	(goal gl-placement-pressure-state PLACEMENT-PRESSURE-WAIT)
	(goal gl-placement-pressure-category PLACEMENT-KIND-ECONOMY)
	(up-compare-goal gl-game-time g:>= gl-placement-pressure-next)
=>
	(set-goal gl-placement-pressure-state PLACEMENT-PRESSURE-CHECK-ECONOMY)
)

(defrule
	(goal gl-placement-pressure-state PLACEMENT-PRESSURE-WAIT)
	(goal gl-placement-pressure-category PLACEMENT-KIND-MILITARY)
	(up-compare-goal gl-game-time g:>= gl-placement-pressure-next)
=>
	(set-goal gl-placement-pressure-state PLACEMENT-PRESSURE-CHECK-MILITARY)
)

(defrule
	(goal gl-placement-pressure-state PLACEMENT-PRESSURE-WAIT)
	(goal gl-placement-pressure-category PLACEMENT-KIND-DEFENSE)
	(up-compare-goal gl-game-time g:>= gl-placement-pressure-next)
=>
	(set-goal gl-placement-pressure-state PLACEMENT-PRESSURE-CHECK-DEFENSE)
)

(defrule
	(goal gl-placement-pressure-state PLACEMENT-PRESSURE-CHECK-ECONOMY)
	(up-pending-placement c: house)
=>
	(up-reset-placement c: house)
	(set-goal gl-placement-pressure-state PLACEMENT-PRESSURE-EXPAND)
)

(defrule
	(goal gl-placement-pressure-state PLACEMENT-PRESSURE-CHECK-ECONOMY)
	(not (up-pending-placement c: house))
=>
	(set-goal gl-placement-pressure-state PLACEMENT-PRESSURE-IDLE)
	(set-goal gl-placement-pressure-category PLACEMENT-KIND-NONE)
)

(defrule
	(goal gl-placement-pressure-state PLACEMENT-PRESSURE-CHECK-MILITARY)
	(or
		(up-pending-placement c: barracks)
		(or
			(up-pending-placement c: archery-range)
			(or
				(up-pending-placement c: stable)
				(or
					(up-pending-placement c: siege-workshop)
					(up-pending-placement c: blacksmith)
				)
			)
		)
	)
=>
	(up-reset-placement c: barracks)
	(up-reset-placement c: archery-range)
	(up-reset-placement c: stable)
	(up-reset-placement c: siege-workshop)
	(up-reset-placement c: blacksmith)
	(set-goal gl-placement-pressure-state PLACEMENT-PRESSURE-EXPAND)
)

(defrule
	(goal gl-placement-pressure-state PLACEMENT-PRESSURE-CHECK-MILITARY)
	(nor
		(up-pending-placement c: barracks)
		(or
			(up-pending-placement c: archery-range)
			(or
				(up-pending-placement c: stable)
				(or
					(up-pending-placement c: siege-workshop)
					(up-pending-placement c: blacksmith)
				)
			)
		)
	)
=>
	(set-goal gl-placement-pressure-state PLACEMENT-PRESSURE-IDLE)
	(set-goal gl-placement-pressure-category PLACEMENT-KIND-NONE)
)

(defrule
	(goal gl-placement-pressure-state PLACEMENT-PRESSURE-CHECK-DEFENSE)
	(or
		(up-pending-placement c: university)
		(or
			(up-pending-placement c: monastery)
			(or
				(up-pending-placement c: castle)
				(or
					(up-pending-placement c: watch-tower)
					(or
						(up-pending-placement c: outpost)
						(up-pending-placement c: wonder)
					)
				)
			)
		)
	)
=>
	(up-reset-placement c: university)
	(up-reset-placement c: monastery)
	(up-reset-placement c: castle)
	(up-reset-placement c: watch-tower)
	(up-reset-placement c: outpost)
	(up-reset-placement c: wonder)
	(set-goal gl-placement-pressure-state PLACEMENT-PRESSURE-EXPAND)
)

(defrule
	(goal gl-placement-pressure-state PLACEMENT-PRESSURE-CHECK-DEFENSE)
	(nor
		(up-pending-placement c: university)
		(or
			(up-pending-placement c: monastery)
			(or
				(up-pending-placement c: castle)
				(or
					(up-pending-placement c: watch-tower)
					(or
						(up-pending-placement c: outpost)
						(up-pending-placement c: wonder)
					)
				)
			)
		)
	)
=>
	(set-goal gl-placement-pressure-state PLACEMENT-PRESSURE-IDLE)
	(set-goal gl-placement-pressure-category PLACEMENT-KIND-NONE)
)

;If the town is already too crowded for up-can-build to return a placement,
;there is no pending request for the watchdog above to observe. These demand
;facts enter the same bounded expansion owner directly. Managed Market and Town
;Center state machines keep their own placement/reset ownership; this owner
;only enlarges their legal search radius.
(defrule
	(goal gl-placement-pressure-state PLACEMENT-PRESSURE-IDLE)
	(up-compare-goal gl-game-time g:>= gl-placement-pressure-next)
	(goal allow-houses YES)
	(goal gl-migration-placement-lock NO)
	(housing-headroom < 5)
	(up-pending-objects c: house <= 0)
	(not (up-pending-placement c: house))
	(can-afford-building house)
	(not (up-can-build 0 c: house))
=>
	(set-goal gl-placement-pressure-category PLACEMENT-KIND-ECONOMY)
	(set-goal gl-placement-pressure-state PLACEMENT-PRESSURE-EXPAND)
)

(defrule
	(goal gl-placement-pressure-state PLACEMENT-PRESSURE-IDLE)
	(up-compare-goal gl-game-time g:>= gl-placement-pressure-next)
	(current-age >= early-antiquity-age)
	(goal gl-migration-placement-lock NO)
	(building-type-count-total market g:< desired-number-markets)
	(up-pending-objects c: market <= 0)
	(not (up-pending-placement c: market))
	(can-afford-building market)
	(not (up-can-build 0 c: market))
=>
	(set-goal gl-placement-pressure-category PLACEMENT-KIND-ECONOMY)
	(set-goal gl-placement-pressure-state PLACEMENT-PRESSURE-EXPAND)
)

;Farm demand can be the only symptom of a full core. It may enlarge the shared
;radius, but its existing owner retains exclusive reset/placement control.
(defrule
	(goal gl-placement-pressure-state PLACEMENT-PRESSURE-IDLE)
	(up-compare-goal gl-game-time g:>= gl-placement-pressure-next)
	(goal gl-farm-placement-suspended NO)
	(up-compare-goal gl-farm-build-target c:> 0)
	(building-type-count mill >= 1)
	(building-type-count-total farm g:< gl-farm-build-target)
	(up-pending-objects c: farm <= 0)
	(not (up-pending-placement c: farm))
	(can-afford-building farm)
	(not (up-can-build 0 c: farm))
=>
	(set-goal gl-placement-pressure-category PLACEMENT-KIND-ECONOMY)
	(set-goal gl-placement-pressure-state PLACEMENT-PRESSURE-EXPAND)
)

(defrule
	(goal gl-placement-pressure-state PLACEMENT-PRESSURE-IDLE)
	(up-compare-goal gl-game-time g:>= gl-placement-pressure-next)
	(goal gl-colony-towncenter-state COLONY-TC-IDLE)
	(goal gl-island-migration-state MIGRATION-IDLE)
	(goal gl-home-resource-pressure NO)
	(building-type-count-total town-center g:< desired-number-towncenters)
	(up-pending-objects c: town-center <= 0)
	(not (up-pending-placement c: town-center))
	(can-afford-building town-center)
	(not (up-can-build 0 c: town-center))
=>
	(set-goal gl-placement-pressure-category PLACEMENT-KIND-ECONOMY)
	(set-goal gl-placement-pressure-state PLACEMENT-PRESSURE-EXPAND)
)

(defrule
	(goal gl-placement-pressure-state PLACEMENT-PRESSURE-IDLE)
	(up-compare-goal gl-game-time g:>= gl-placement-pressure-next)
	(goal gl-opening-drop-sites-ready YES)
	(goal wait-techup-requirements NO)
	(building-type-count-total barracks g:< desired-number-barracks)
	(up-pending-objects c: barracks <= 0)
	(not (up-pending-placement c: barracks))
	(can-afford-building barracks)
	(not (up-can-build 0 c: barracks))
=>
	(set-goal gl-placement-pressure-category PLACEMENT-KIND-MILITARY)
	(set-goal gl-placement-pressure-state PLACEMENT-PRESSURE-EXPAND)
)

(defrule
	(goal gl-placement-pressure-state PLACEMENT-PRESSURE-IDLE)
	(up-compare-goal gl-game-time g:>= gl-placement-pressure-next)
	(current-age >= early-antiquity-age)
	(goal wait-techup-requirements NO)
	(building-type-count-total barracks > 0)
	(building-type-count-total archery-range g:< desired-number-ranges)
	(up-pending-objects c: archery-range <= 0)
	(not (up-pending-placement c: archery-range))
	(can-afford-building archery-range)
	(not (up-can-build 0 c: archery-range))
=>
	(set-goal gl-placement-pressure-category PLACEMENT-KIND-MILITARY)
	(set-goal gl-placement-pressure-state PLACEMENT-PRESSURE-EXPAND)
)

(defrule
	(goal gl-placement-pressure-state PLACEMENT-PRESSURE-IDLE)
	(up-compare-goal gl-game-time g:>= gl-placement-pressure-next)
	(current-age >= early-antiquity-age)
	(goal wait-techup-requirements NO)
	(building-type-count-total barracks > 0)
	(building-type-count-total stable g:< desired-number-stables)
	(up-pending-objects c: stable <= 0)
	(not (up-pending-placement c: stable))
	(can-afford-building stable)
	(not (up-can-build 0 c: stable))
=>
	(set-goal gl-placement-pressure-category PLACEMENT-KIND-MILITARY)
	(set-goal gl-placement-pressure-state PLACEMENT-PRESSURE-EXPAND)
)

(defrule
	(goal gl-placement-pressure-state PLACEMENT-PRESSURE-IDLE)
	(up-compare-goal gl-game-time g:>= gl-placement-pressure-next)
	(current-age >= middle-antiquity-age)
	(goal wait-techup-requirements NO)
	(building-type-count-total siege-workshop g:< desired-number-workshops)
	(up-pending-objects c: siege-workshop <= 0)
	(not (up-pending-placement c: siege-workshop))
	(can-afford-building siege-workshop)
	(not (up-can-build 0 c: siege-workshop))
=>
	(set-goal gl-placement-pressure-category PLACEMENT-KIND-MILITARY)
	(set-goal gl-placement-pressure-state PLACEMENT-PRESSURE-EXPAND)
)

(defrule
	(goal gl-placement-pressure-state PLACEMENT-PRESSURE-IDLE)
	(up-compare-goal gl-game-time g:>= gl-placement-pressure-next)
	(current-age >= early-antiquity-age)
	(building-type-count-total blacksmith g:< desired-number-blacksmiths)
	(up-pending-objects c: blacksmith <= 0)
	(not (up-pending-placement c: blacksmith))
	(can-afford-building blacksmith)
	(not (up-can-build 0 c: blacksmith))
=>
	(set-goal gl-placement-pressure-category PLACEMENT-KIND-MILITARY)
	(set-goal gl-placement-pressure-state PLACEMENT-PRESSURE-EXPAND)
)

(defrule
	(goal gl-placement-pressure-state PLACEMENT-PRESSURE-IDLE)
	(up-compare-goal gl-game-time g:>= gl-placement-pressure-next)
	(current-age >= middle-antiquity-age)
	(building-type-count-total university g:< desired-number-universities)
	(up-pending-objects c: university <= 0)
	(not (up-pending-placement c: university))
	(can-afford-building university)
	(not (up-can-build 0 c: university))
=>
	(set-goal gl-placement-pressure-category PLACEMENT-KIND-DEFENSE)
	(set-goal gl-placement-pressure-state PLACEMENT-PRESSURE-EXPAND)
)

(defrule
	(goal gl-placement-pressure-state PLACEMENT-PRESSURE-IDLE)
	(up-compare-goal gl-game-time g:>= gl-placement-pressure-next)
	(current-age >= middle-antiquity-age)
	(building-type-count-total monastery g:< desired-number-monasteries)
	(up-pending-objects c: monastery <= 0)
	(not (up-pending-placement c: monastery))
	(can-afford-building monastery)
	(not (up-can-build 0 c: monastery))
=>
	(set-goal gl-placement-pressure-category PLACEMENT-KIND-DEFENSE)
	(set-goal gl-placement-pressure-state PLACEMENT-PRESSURE-EXPAND)
)

(defrule
	(goal gl-placement-pressure-state PLACEMENT-PRESSURE-IDLE)
	(up-compare-goal gl-game-time g:>= gl-placement-pressure-next)
	(current-age >= middle-antiquity-age)
	(building-type-count town-center >= 2)
	(building-type-count-total castle g:< desired-number-castles)
	(up-pending-objects c: castle <= 0)
	(not (up-pending-placement c: castle))
	(can-afford-building castle)
	(not (up-can-build 0 c: castle))
=>
	(set-goal gl-placement-pressure-category PLACEMENT-KIND-DEFENSE)
	(set-goal gl-placement-pressure-state PLACEMENT-PRESSURE-EXPAND)
)

(defrule
	(goal gl-placement-pressure-state PLACEMENT-PRESSURE-IDLE)
	(up-compare-goal gl-game-time g:>= gl-placement-pressure-next)
	(current-age >= middle-antiquity-age)
	(building-type-count town-center >= 2)
	(building-type-count-total outpost g:< desired-number-outposts)
	(up-pending-objects c: outpost <= 0)
	(not (up-pending-placement c: outpost))
	(can-afford-building outpost)
	(not (up-can-build 0 c: outpost))
=>
	(set-goal gl-placement-pressure-category PLACEMENT-KIND-DEFENSE)
	(set-goal gl-placement-pressure-state PLACEMENT-PRESSURE-EXPAND)
)

(defrule
	(goal gl-placement-pressure-state PLACEMENT-PRESSURE-IDLE)
	(up-compare-goal gl-game-time g:>= gl-placement-pressure-next)
	(current-age >= early-antiquity-age)
	(building-type-count-total watch-tower g:< desired-number-watchtowers)
	(up-pending-objects c: watch-tower <= 0)
	(not (up-pending-placement c: watch-tower))
	(can-afford-building watch-tower)
	(not (up-can-build 0 c: watch-tower))
=>
	(set-goal gl-placement-pressure-category PLACEMENT-KIND-DEFENSE)
	(set-goal gl-placement-pressure-state PLACEMENT-PRESSURE-EXPAND)
)

(defrule
	(goal gl-placement-pressure-state PLACEMENT-PRESSURE-EXPAND)
	(goal gl-placement-pressure-cap 0)
=>
	(up-modify-goal gl-placement-pressure-cap s:= sn-maximum-town-size)
	(up-modify-goal gl-placement-pressure-cap c:+ 24)
)

(defrule
	(goal gl-placement-pressure-state PLACEMENT-PRESSURE-EXPAND)
	(up-compare-sn sn-maximum-town-size g:< gl-placement-pressure-cap)
=>
	(up-modify-sn sn-maximum-town-size c:+ 3)
	(up-modify-sn sn-maximum-town-size g:min gl-placement-pressure-cap)
	(up-modify-goal outer-townsize s:max sn-maximum-town-size)
	(up-modify-sn sn-camp-max-distance s:max sn-maximum-town-size)
	(up-modify-goal gl-placement-pressure-next g:= gl-game-time)
	(up-modify-goal gl-placement-pressure-next c:+ 12)
	(up-chat-data-to-self "crowded town placement retry size: %d" s: sn-maximum-town-size)
	(set-goal gl-placement-pressure-state PLACEMENT-PRESSURE-WAIT)
)

(defrule
	(goal gl-placement-pressure-state PLACEMENT-PRESSURE-EXPAND)
	(up-compare-sn sn-maximum-town-size g:>= gl-placement-pressure-cap)
	(goal gl-placement-pressure-saturated NO)
=>
	(up-chat-data-to-self "crowded town placement saturated size: %d" s: sn-maximum-town-size)
	(set-goal gl-placement-pressure-saturated YES)
	(up-modify-goal gl-placement-pressure-next g:= gl-game-time)
	(up-modify-goal gl-placement-pressure-next c:+ 60)
	(set-goal gl-placement-pressure-state PLACEMENT-PRESSURE-WAIT)
)

(defrule
	(goal gl-placement-pressure-state PLACEMENT-PRESSURE-EXPAND)
	(up-compare-sn sn-maximum-town-size g:>= gl-placement-pressure-cap)
	(goal gl-placement-pressure-saturated YES)
=>
	(up-modify-goal gl-placement-pressure-next g:= gl-game-time)
	(up-modify-goal gl-placement-pressure-next c:+ 60)
	(set-goal gl-placement-pressure-state PLACEMENT-PRESSURE-WAIT)
)

;Enemy structures can contract placement toward the protected core, but the
;strict comparison must turn false at safe-townsize or this rule never settles.
(defrule
	(enemy-buildings-in-town)
	(goal gl-placement-pressure-state PLACEMENT-PRESSURE-IDLE)
	(up-compare-sn sn-maximum-town-size g:> safe-townsize)
	(up-compare-sn sn-maximum-town-size g:<= outer-townsize)
	(up-timer-status t-town-size != timer-running)
=>
	(up-modify-sn sn-maximum-town-size c:- 1)
	(up-chat-data-to-self "resize due to enemy buildings in town sn-maximum-town-size; %d" s: sn-maximum-town-size)
	(enable-timer t-town-size 6)
)

(defrule
	(strategic-number sn-maximum-town-size s:> sn-camp-max-distance)
=>
	(up-modify-sn sn-camp-max-distance s:max sn-maximum-town-size)
	(up-chat-data-to-self "sn-camp-max-distance; %d" s: sn-camp-max-distance)
)

(defrule
	(goal allow-houses YES)
	(building-type-count-total town-center == 0)
=>
	(set-goal allow-houses NO)
	(chat-local-to-self "allow-houses NO")
)

(defrule
	(goal allow-houses NO)
	(building-type-count-total town-center > 0)
=>
	(set-goal allow-houses YES)
	(chat-local-to-self "allow-houses YES")
)

;One House at a time cannot keep pace with several Town Centers and military
;buildings. Start a pressure timer at three slots of headroom, then permit one
;additional pending House while the shortage persists. The two-foundation cap
;prevents the old unbounded House-flood failure mode.
(defrule
	(goal gl-house-pressure NO)
	(housing-headroom < 5)
	(up-pending-objects c: house >= 1)
=>
	(set-goal gl-house-pressure YES)
	(up-set-timer c: t-house-pressure c: 15)
)

(defrule
	(goal gl-house-pressure YES)
	(housing-headroom >= 5)
=>
	(set-goal gl-house-pressure NO)
	(up-set-timer c: t-house-pressure c: 30)
)

;A confirmed resource colony becomes a real settlement when its land zone has
;enough observed resources to justify a Town Center. Map-zone and resource
;density are the engine-visible proxy for island size; terrain area itself is
;not exposed to the AI scripting interface.
(defrule
	(up-timer-status t-colony-towncenter == timer-triggered)
	(goal gl-colony-towncenter-state COLONY-TC-IDLE)
	(goal gl-island-colony-established YES)
	(up-compare-goal gl-colony-towncenter-id c:< 0)
	(goal gl-island-migration-state MIGRATION-IDLE)
	(or
		(goal map-type RIVERS)
		(or
			(goal map-type ISLANDS)
			(goal map-type TEAM-ISLANDS)
		)
	)
=>
	(set-goal gl-colony-towncenter-state COLONY-TC-GATE)
)

(defrule
	(goal gl-colony-towncenter-state COLONY-TC-GATE)
	(goal gl-lumbercamp-placement-state PLACEMENT-IDLE)
	(goal gl-miningcamp-placement-state PLACEMENT-IDLE)
	(current-age >= middle-antiquity-age)
	(building-type-count-total town-center < 8)
	(or
		(building-type-count-total town-center g:< desired-number-towncenters)
		(or
			(goal resources-depleted YES)
			(goal gl-home-resource-pressure YES)
		)
	)
	(up-pending-objects c: town-center <= 0)
	(not (up-pending-placement c: town-center))
	(can-afford-building town-center)
=>
	(up-modify-goal gl-colony-towncenter-focus s:= sn-focus-player-number)
	(set-strategic-number sn-focus-player-number my-player-number)
	(up-full-reset-search)
	(up-set-target-point gl-island-colony-x)
	(up-filter-distance c: -1 c: 40)
	(up-find-local c: villager-class c: 40)
	(up-remove-objects search-local object-data-garrisoned == 1)
	(up-remove-objects search-local object-data-map-zone-id g:!= gl-island-colony-zone)
	(up-clean-search search-local object-data-distance search-order-asc)
	(set-goal gl-colony-towncenter-state COLONY-TC-FIND-SETTLER)
)

(defrule
	(goal gl-colony-towncenter-state COLONY-TC-GATE)
=>
	(up-set-timer c: t-colony-towncenter c: 45)
	(set-goal gl-colony-towncenter-state COLONY-TC-IDLE)
)

(defrule
	(goal gl-colony-towncenter-state COLONY-TC-FIND-SETTLER)
	(up-set-target-object search-local c: 0)
=>
	(up-get-point position-object gl-colony-towncenter-target-x)
	(set-strategic-number sn-focus-player-number 0)
	(up-full-reset-search)
	(up-set-target-point gl-colony-towncenter-target-x)
	(up-filter-distance c: -1 c: 36)
	(up-find-remote c: gold-mine-class c: 10)
	(up-find-remote c: stone-mine-class c: 10)
	(up-find-remote c: tree-class c: 40)
	(up-find-remote c: forage-class c: 10)
	(up-find-remote c: prey-animal-class c: 10)
	(up-remove-objects search-remote object-data-map-zone-id g:!= gl-island-colony-zone)
	(up-get-search-state local-total)
	(up-modify-goal gl-colony-towncenter-resource-count g:= remote-total)
	(set-goal gl-colony-towncenter-state COLONY-TC-CHECK-RESOURCES)
)

(defrule
	(goal gl-colony-towncenter-state COLONY-TC-FIND-SETTLER)
	(not (up-set-target-object search-local c: 0))
=>
	(up-modify-sn sn-focus-player-number g:= gl-colony-towncenter-focus)
	(up-set-timer c: t-colony-towncenter c: 90)
	(set-goal gl-colony-towncenter-state COLONY-TC-IDLE)
)

(defrule
	(goal gl-colony-towncenter-state COLONY-TC-CHECK-RESOURCES)
	(up-compare-goal gl-colony-towncenter-resource-count c:>= 12)
=>
	(set-strategic-number sn-focus-player-number my-player-number)
	(up-full-reset-search)
	(up-find-local c: town-center c: 20)
	(up-remove-objects search-local object-data-map-zone-id g:!= gl-island-colony-zone)
	(set-goal gl-colony-towncenter-state COLONY-TC-CHECK-EXISTING)
)

(defrule
	(goal gl-colony-towncenter-state COLONY-TC-CHECK-RESOURCES)
	(up-compare-goal gl-colony-towncenter-resource-count c:< 12)
=>
	(up-chat-data-to-self "colony TC resource proxy too small: %d" g: gl-colony-towncenter-resource-count)
	(up-modify-sn sn-focus-player-number g:= gl-colony-towncenter-focus)
	(up-set-timer c: t-colony-towncenter c: 120)
	(set-goal gl-colony-towncenter-state COLONY-TC-IDLE)
)

(defrule
	(goal gl-colony-towncenter-state COLONY-TC-CHECK-EXISTING)
	(up-set-target-object search-local c: 0)
=>
	(up-get-object-data object-data-id gl-colony-towncenter-id)
	(up-modify-sn sn-focus-player-number g:= gl-colony-towncenter-focus)
	(up-set-timer c: t-colony-towncenter c: 180)
	(set-goal gl-colony-towncenter-state COLONY-TC-IDLE)
)

(defrule
	(goal gl-colony-towncenter-state COLONY-TC-CHECK-EXISTING)
	(not (up-set-target-object search-local c: 0))
=>
	(up-modify-sn sn-focus-player-number g:= gl-colony-towncenter-focus)
	(set-goal gl-colony-towncenter-attempts 0)
	(set-goal gl-colony-towncenter-state COLONY-TC-PLACE)
)

(defrule
	(goal gl-colony-towncenter-state COLONY-TC-PLACE)
	(goal gl-colony-towncenter-attempts 0)
=>
	(up-copy-point point2-x gl-colony-towncenter-target-x)
	(up-modify-goal point2-x c:+ 8)
	(up-modify-goal point2-y c:+ 8)
	(up-bound-point point3-x point2-x)
	(up-set-target-point point3-x)
	(set-goal gl-colony-towncenter-state COLONY-TC-ISSUE)
)

(defrule
	(goal gl-colony-towncenter-state COLONY-TC-PLACE)
	(goal gl-colony-towncenter-attempts 1)
=>
	(up-copy-point point2-x gl-colony-towncenter-target-x)
	(up-modify-goal point2-x c:- 8)
	(up-modify-goal point2-y c:+ 8)
	(up-bound-point point3-x point2-x)
	(up-set-target-point point3-x)
	(set-goal gl-colony-towncenter-state COLONY-TC-ISSUE)
)

(defrule
	(goal gl-colony-towncenter-state COLONY-TC-PLACE)
	(goal gl-colony-towncenter-attempts 2)
=>
	(up-copy-point point2-x gl-colony-towncenter-target-x)
	(up-modify-goal point2-x c:+ 8)
	(up-modify-goal point2-y c:- 8)
	(up-bound-point point3-x point2-x)
	(up-set-target-point point3-x)
	(set-goal gl-colony-towncenter-state COLONY-TC-ISSUE)
)

(defrule
	(goal gl-colony-towncenter-state COLONY-TC-PLACE)
	(goal gl-colony-towncenter-attempts 3)
=>
	(up-copy-point point2-x gl-colony-towncenter-target-x)
	(up-modify-goal point2-x c:- 8)
	(up-modify-goal point2-y c:- 8)
	(up-bound-point point3-x point2-x)
	(up-set-target-point point3-x)
	(set-goal gl-colony-towncenter-state COLONY-TC-ISSUE)
)

(defrule
	(goal gl-colony-towncenter-state COLONY-TC-ISSUE)
	(or
		(up-pending-placement c: town-center)
		(or
			(up-pending-placement c: market)
			(or
				(up-pending-placement c: lumber-camp)
				(or
					(up-pending-placement c: mining-camp)
					(or
						(up-pending-placement c: mill)
						(up-pending-placement c: house)
					)
				)
			)
		)
	)
=>
	(up-modify-sn sn-focus-player-number g:= gl-colony-towncenter-focus)
	(up-set-timer c: t-colony-towncenter c: 15)
	(set-goal gl-colony-towncenter-state COLONY-TC-IDLE)
)

(defrule
	(goal gl-colony-towncenter-state COLONY-TC-ISSUE)
	(up-pending-objects c: town-center <= 0)
	(not (up-pending-placement c: town-center))
	(up-can-build 0 c: town-center)
=>
	(up-build place-point 0 c: town-center)
	(up-modify-goal gl-colony-towncenter-attempts c:+ 1)
	(up-chat-data-to-self "colony TC placement attempt: %d" g: gl-colony-towncenter-attempts)
	(up-modify-sn sn-focus-player-number g:= gl-colony-towncenter-focus)
	(up-set-timer c: t-colony-towncenter c: 20)
	(set-goal gl-colony-towncenter-state COLONY-TC-WAIT)
)

(defrule
	(goal gl-colony-towncenter-state COLONY-TC-ISSUE)
	(up-compare-goal gl-colony-towncenter-attempts c:< 3)
	(can-afford-building town-center)
	(not (up-can-build 0 c: town-center))
=>
	(up-modify-goal gl-colony-towncenter-attempts c:+ 1)
	(set-goal gl-colony-towncenter-state COLONY-TC-PLACE)
)

(defrule
	(goal gl-colony-towncenter-state COLONY-TC-ISSUE)
	(up-compare-goal gl-colony-towncenter-attempts c:>= 3)
	(can-afford-building town-center)
	(not (up-can-build 0 c: town-center))
=>
	(up-chat-data-to-self "colony TC placement exhausted: %d" g: gl-island-colony-zone)
	(up-modify-sn sn-focus-player-number g:= gl-colony-towncenter-focus)
	(up-set-timer c: t-colony-towncenter c: 120)
	(set-goal gl-colony-towncenter-state COLONY-TC-IDLE)
)

(defrule
	(goal gl-colony-towncenter-state COLONY-TC-ISSUE)
	(not (can-afford-building town-center))
=>
	(up-chat-data-to-self "colony TC resource wait in zone: %d" g: gl-island-colony-zone)
	(up-modify-sn sn-focus-player-number g:= gl-colony-towncenter-focus)
	(up-set-timer c: t-colony-towncenter c: 60)
	(set-goal gl-colony-towncenter-state COLONY-TC-IDLE)
)

(defrule
	(goal gl-colony-towncenter-state COLONY-TC-WAIT)
	(up-pending-objects c: town-center >= 1)
=>
	(set-strategic-number sn-focus-player-number my-player-number)
	(up-full-reset-search)
	(up-filter-status c: status-pending c: list-active)
	(up-find-status-local c: town-center c: 10)
	(up-remove-objects search-local object-data-map-zone-id g:!= gl-island-colony-zone)
	(up-clean-search search-local object-data-distance search-order-asc)
	(set-goal gl-colony-towncenter-state COLONY-TC-ASSIGN)
)

(defrule
	(goal gl-colony-towncenter-state COLONY-TC-ASSIGN)
	(up-set-target-object search-local c: 0)
=>
	(up-get-object-data object-data-id gl-colony-towncenter-id)
	(up-get-point position-object gl-colony-towncenter-target-x)
	(up-full-reset-search)
	(up-set-target-point gl-colony-towncenter-target-x)
	(up-filter-distance c: -1 c: 24)
	(up-find-local c: villager-class c: 6)
	(up-remove-objects search-local object-data-garrisoned == 1)
	(up-remove-objects search-local object-data-map-zone-id g:!= gl-island-colony-zone)
	(up-remove-objects search-local object-data-language-id == lid-villager-shepherd)
	(up-remove-objects search-local object-data-language-id == lid-villager-hunter)
	(up-remove-objects search-local object-data-language-id == lid-villager-fisherman)
	(up-clean-search search-local object-data-distance search-order-asc)
	(up-add-object-by-id search-remote g: gl-colony-towncenter-id)
	(up-target-objects 0 action-default -1 stance-no-attack)
	(up-chat-data-to-self "colony TC accepted in zone: %d" g: gl-island-colony-zone)
	(up-modify-sn sn-focus-player-number g:= gl-colony-towncenter-focus)
	(up-set-timer c: t-colony-towncenter c: 180)
	(set-goal gl-colony-towncenter-state COLONY-TC-IDLE)
)

(defrule
	(goal gl-colony-towncenter-state COLONY-TC-ASSIGN)
	(not (up-set-target-object search-local c: 0))
=>
	(up-chat-data-to-self "colony TC pending owner mismatch: %d" g: gl-island-colony-zone)
	(up-modify-sn sn-focus-player-number g:= gl-colony-towncenter-focus)
	(up-set-timer c: t-colony-towncenter c: 120)
	(set-goal gl-colony-towncenter-state COLONY-TC-IDLE)
)

(defrule
	(goal gl-colony-towncenter-state COLONY-TC-WAIT)
	(up-timer-status t-colony-towncenter == timer-triggered)
	(up-pending-objects c: town-center <= 0)
	(up-compare-goal gl-colony-towncenter-attempts c:< 4)
=>
	(up-reset-placement c: town-center)
	(set-goal gl-colony-towncenter-state COLONY-TC-PLACE)
)

(defrule
	(goal gl-colony-towncenter-state COLONY-TC-WAIT)
	(up-timer-status t-colony-towncenter == timer-triggered)
	(up-pending-objects c: town-center <= 0)
	(up-compare-goal gl-colony-towncenter-attempts c:>= 4)
=>
	(up-chat-data-to-self "colony TC foundation not accepted: %d" g: gl-island-colony-zone)
	(up-modify-sn sn-focus-player-number g:= gl-colony-towncenter-focus)
	(up-set-timer c: t-colony-towncenter c: 120)
	(set-goal gl-colony-towncenter-state COLONY-TC-IDLE)
)

;Capture one immutable starting Town Center before remote expansion can add
;other candidates. Retirement later applies only to this exact object ID.
(defrule
	(goal gl-home-retirement-state HOME-RETIRE-IDLE)
	(up-compare-goal gl-home-retirement-target-id c:== -1)
	(building-type-count-total town-center >= 1)
=>
	(up-modify-goal gl-home-retirement-focus s:= sn-focus-player-number)
	(set-strategic-number sn-focus-player-number my-player-number)
	(up-full-reset-search)
	(up-set-target-point position-self-x)
	(up-filter-status c: status-ready c: list-active)
	(up-find-local c: town-center c: 20)
	(up-remove-objects search-local object-data-on-mainland != on-mainland)
	(up-clean-search search-local object-data-distance search-order-asc)
	(set-goal gl-home-retirement-state HOME-RETIRE-CAPTURE-STARTING)
)

(defrule
	(goal gl-home-retirement-state HOME-RETIRE-CAPTURE-STARTING)
	(up-set-target-object search-local c: 0)
=>
	(up-get-object-data object-data-id gl-home-retirement-target-id)
	(up-get-object-data object-data-map-zone-id gl-home-zone)
	(up-get-point position-object gl-home-anchor-x)
	(up-chat-data-to-self "starting TC captured: %d" g: gl-home-retirement-target-id)
	(up-modify-sn sn-focus-player-number g:= gl-home-retirement-focus)
	(set-goal gl-home-retirement-state HOME-RETIRE-IDLE)
)

(defrule
	(goal gl-home-retirement-state HOME-RETIRE-CAPTURE-STARTING)
	(not (up-set-target-object search-local c: 0))
=>
	(up-modify-sn sn-focus-player-number g:= gl-home-retirement-focus)
	(up-set-timer c: t-home-retirement c: 30)
	(set-goal gl-home-retirement-state HOME-RETIRE-IDLE)
)

;Once a resource-bearing off-home colony has a live Town Center and enough
;settlers, retire the captured starting Town Center once. This conservative
;variant keeps the old base until the replacement is complete, then leaves the
;new TC as the engine's ordinary place-normal anchor. Every delete revalidates
;the exact ready object and never removes the last TC.
(defrule
	(up-timer-status t-home-retirement == timer-triggered)
	(goal gl-home-retirement-state HOME-RETIRE-IDLE)
	(goal gl-island-colony-established YES)
	(goal gl-island-colony-threat NO)
	(goal gl-island-migration-state MIGRATION-IDLE)
	(goal gl-colony-towncenter-state COLONY-TC-IDLE)
	(goal gl-home-defense-state NO)
	(up-compare-goal gl-colony-towncenter-id c:>= 0)
	(up-compare-goal gl-home-retirement-target-id c:>= 0)
	(goal gl-home-resource-pressure YES)
	(building-type-count-total town-center >= 2)
	(up-pending-objects c: town-center <= 0)
	(not (up-pending-placement c: town-center))
	(or
		(goal map-type RIVERS)
		(or
			(goal map-type ISLANDS)
			(goal map-type TEAM-ISLANDS)
		)
	)
=>
	(up-modify-goal gl-home-retirement-focus s:= sn-focus-player-number)
	(set-strategic-number sn-focus-player-number my-player-number)
	(up-full-reset-search)
	(up-find-local c: town-center c: 20)
	(up-remove-objects search-local object-data-id g:!= gl-colony-towncenter-id)
	(set-goal gl-home-retirement-state HOME-RETIRE-VERIFY-COLONY)
)

(defrule
	(goal gl-home-retirement-state HOME-RETIRE-VERIFY-COLONY)
	(up-set-target-object search-local c: 0)
	(up-object-data object-data-status == status-ready)
	(up-object-data object-data-map-zone-id g:== gl-island-colony-zone)
	(up-object-data object-data-on-mainland == off-mainland)
=>
	(up-get-point position-object point-x)
	(set-strategic-number sn-focus-player-number 0)
	(up-full-reset-search)
	(up-set-target-point point-x)
	(up-filter-distance c: -1 c: 40)
	(up-find-remote c: gold-mine-class c: 10)
	(up-find-remote c: stone-mine-class c: 10)
	(up-find-remote c: tree-class c: 40)
	(up-find-remote c: forage-class c: 10)
	(up-find-remote c: prey-animal-class c: 10)
	(up-remove-objects search-remote object-data-map-zone-id g:!= gl-island-colony-zone)
	(up-get-search-state local-total)
	(up-modify-goal gl-home-retirement-resource-count g:= remote-total)
	(set-strategic-number sn-focus-player-number my-player-number)
	(up-full-reset-search)
	(up-set-target-point point-x)
	(up-filter-distance c: -1 c: 40)
	(up-find-local c: villager-class c: 40)
	(up-remove-objects search-local object-data-garrisoned == 1)
	(up-remove-objects search-local object-data-map-zone-id g:!= gl-island-colony-zone)
	(up-get-search-state local-total)
	(up-modify-goal gl-home-retirement-settler-count g:= local-total)
	(set-goal gl-home-retirement-state HOME-RETIRE-CHECK-VIABILITY)
)

(defrule
	(goal gl-home-retirement-state HOME-RETIRE-VERIFY-COLONY)
	(up-set-target-object search-local c: 0)
	(up-object-data object-data-status != status-ready)
=>
	(up-modify-sn sn-focus-player-number g:= gl-home-retirement-focus)
	(up-set-timer c: t-home-retirement c: 60)
	(set-goal gl-home-retirement-state HOME-RETIRE-IDLE)
)

(defrule
	(goal gl-home-retirement-state HOME-RETIRE-VERIFY-COLONY)
	(up-set-target-object search-local c: 0)
	(up-object-data object-data-status == status-ready)
	(or
		(up-object-data object-data-map-zone-id g:!= gl-island-colony-zone)
		(up-object-data object-data-on-mainland != off-mainland)
	)
=>
	(up-chat-data-to-self "colony TC revalidation mismatch: %d" g: gl-colony-towncenter-id)
	(set-goal gl-colony-towncenter-id -1)
	(up-modify-sn sn-focus-player-number g:= gl-home-retirement-focus)
	(up-set-timer c: t-home-retirement c: 90)
	(set-goal gl-home-retirement-state HOME-RETIRE-IDLE)
)

(defrule
	(goal gl-home-retirement-state HOME-RETIRE-VERIFY-COLONY)
	(not (up-set-target-object search-local c: 0))
=>
	(up-chat-data-to-self "colony TC revalidation lost: %d" g: gl-colony-towncenter-id)
	(set-goal gl-colony-towncenter-id -1)
	(up-modify-sn sn-focus-player-number g:= gl-home-retirement-focus)
	(up-set-timer c: t-home-retirement c: 90)
	(set-goal gl-home-retirement-state HOME-RETIRE-IDLE)
)

(defrule
	(goal gl-home-retirement-state HOME-RETIRE-CHECK-VIABILITY)
	(up-compare-goal gl-home-retirement-resource-count c:>= 4)
	(up-compare-goal gl-home-retirement-settler-count c:>= 6)
=>
	(up-full-reset-search)
	(up-find-local c: town-center c: 20)
	(up-remove-objects search-local object-data-id g:!= gl-home-retirement-target-id)
	(set-goal gl-home-retirement-state HOME-RETIRE-VALIDATE-OLD)
)

(defrule
	(goal gl-home-retirement-state HOME-RETIRE-CHECK-VIABILITY)
	(or
		(up-compare-goal gl-home-retirement-resource-count c:< 4)
		(up-compare-goal gl-home-retirement-settler-count c:< 6)
	)
=>
	(up-chat-data-to-self "colony TC retirement hold settlers: %d" g: gl-home-retirement-settler-count)
	(up-modify-sn sn-focus-player-number g:= gl-home-retirement-focus)
	(up-set-timer c: t-home-retirement c: 90)
	(set-goal gl-home-retirement-state HOME-RETIRE-IDLE)
)

(defrule
	(goal gl-home-retirement-state HOME-RETIRE-VALIDATE-OLD)
	(or
		(goal gl-island-colony-threat YES)
		(or
			(not (goal gl-island-migration-state MIGRATION-IDLE))
			(or
				(not (goal gl-colony-towncenter-state COLONY-TC-IDLE))
				(or
					(goal gl-home-defense-state YES)
					(or
						(building-type-count-total town-center < 2)
						(or
							(up-pending-objects c: town-center > 0)
							(up-pending-placement c: town-center)
						)
					)
				)
			)
		)
	)
=>
	(up-chat-data-to-self "home TC retirement invalidated: %d" g: gl-home-retirement-target-id)
	(up-modify-sn sn-focus-player-number g:= gl-home-retirement-focus)
	(up-set-timer c: t-home-retirement c: 90)
	(set-goal gl-home-retirement-state HOME-RETIRE-IDLE)
)

(defrule
	(goal gl-home-retirement-state HOME-RETIRE-VALIDATE-OLD)
	(up-set-target-object search-local c: 0)
	(up-object-data object-data-id g:== gl-home-retirement-target-id)
	(up-object-data object-data-status == status-ready)
	(up-object-data object-data-map-zone-id g:== gl-home-zone)
	(up-object-data object-data-under-attack <= 0)
	(up-object-data object-data-action != actionid-research)
	(up-object-data object-data-order != orderid-research)
	(goal gl-island-colony-threat NO)
	(goal gl-island-migration-state MIGRATION-IDLE)
	(goal gl-colony-towncenter-state COLONY-TC-IDLE)
	(goal gl-home-defense-state NO)
	(building-type-count-total town-center >= 2)
	(up-pending-objects c: town-center <= 0)
	(not (up-pending-placement c: town-center))
=>
	(up-target-point 0 action-delete -1 -1)
	(up-chat-data-to-self "home TC retired exact id: %d" g: gl-home-retirement-target-id)
	(set-goal gl-home-retirement-target-id -2)
	(up-modify-goal gl-home-zone g:= gl-island-colony-zone)
	(up-copy-point gl-home-anchor-x gl-island-colony-x)
	(up-modify-sn sn-focus-player-number g:= gl-home-retirement-focus)
	(up-set-timer c: t-home-retirement c: 90)
	(set-goal gl-home-retirement-state HOME-RETIRE-IDLE)
)

(defrule
	(goal gl-home-retirement-state HOME-RETIRE-VALIDATE-OLD)
	(not (up-set-target-object search-local c: 0))
=>
	(up-chat-data-to-self "starting TC already absent: %d" g: gl-home-retirement-target-id)
	(set-goal gl-home-retirement-target-id -2)
	(up-modify-goal gl-home-zone g:= gl-island-colony-zone)
	(up-copy-point gl-home-anchor-x gl-island-colony-x)
	(up-modify-sn sn-focus-player-number g:= gl-home-retirement-focus)
	(up-set-timer c: t-home-retirement c: 300)
	(set-goal gl-home-retirement-state HOME-RETIRE-IDLE)
)

(defrule
	(goal gl-home-retirement-state HOME-RETIRE-VALIDATE-OLD)
	(up-set-target-object search-local c: 0)
	(or
		(up-object-data object-data-id g:!= gl-home-retirement-target-id)
		(or
			(up-object-data object-data-status != status-ready)
			(or
				(up-object-data object-data-map-zone-id g:!= gl-home-zone)
				(or
					(up-object-data object-data-under-attack > 0)
					(or
						(up-object-data object-data-action == actionid-research)
						(up-object-data object-data-order == orderid-research)
					)
				)
			)
		)
	)
=>
	(up-chat-data-to-self "home TC retirement deferred: %d" g: gl-home-retirement-target-id)
	(up-modify-sn sn-focus-player-number g:= gl-home-retirement-focus)
	(up-set-timer c: t-home-retirement c: 90)
	(set-goal gl-home-retirement-state HOME-RETIRE-IDLE)
)

(defrule
	(current-age >= middle-antiquity-age)
	(goal gl-colony-towncenter-state COLONY-TC-IDLE)
	(goal gl-island-migration-state MIGRATION-IDLE)
	(goal gl-home-resource-pressure NO)
	(can-afford-building town-center)
	(building-type-count-total town-center g:< desired-number-towncenters)
	(up-pending-objects c: town-center <= 0)
	(not (up-pending-placement c: town-center))
	(up-can-build 0 c: town-center)
=>
	(up-build place-normal 0 c: town-center)
)

(defrule
	(goal allow-houses 1)
	(building-type-count-total house == 0)
	(building-type-count-total mill == 0)
	(goal gl-migration-placement-lock NO)
	(up-pending-objects c: house <= 0)
	(population-headroom > 0)
	(housing-headroom < 5)
	(up-timer-status t-house-placement != timer-running)
	(can-afford-building house)
	(up-can-build 0 c: house)
=>
	(up-build place-normal 0 c: house)
	(up-set-timer c: t-house-placement c: 8)
)

(defrule
	(current-age <= early-antiquity-age)
	(goal allow-houses 1)
	(building-type-count-total house > 0)
	(building-type-count-total mill == 0)
	(goal gl-migration-placement-lock NO)
	(up-pending-objects c: house <= 0)
	(population-headroom > 0)
	(housing-headroom < 5)
	(up-timer-status t-house-placement != timer-running)
	(can-afford-building house)
	(up-can-build 0 c: house)
=>
	(up-set-placement-data my-player-number -1 c: -10)
	(up-build place-control 0 c: house)
	(up-set-timer c: t-house-placement c: 8)
)

(defrule
	(current-age <= early-antiquity-age)
	(goal allow-houses 1)
	(building-type-count-total house > 0)
	(building-type-count-total mill >= 1)
	(goal gl-migration-placement-lock NO)
	(up-pending-objects c: house <= 0)
	(population-headroom > 0)
	(housing-headroom < 5)
	(up-timer-status t-house-placement != timer-running)
	(can-afford-building house)
	(up-can-build 0 c: house)
=>
	;Bias later houses away from the Mill anchor selected by the placement engine
	;letting the compact TC housing pattern seal every farm approach.
	(up-set-placement-data my-player-number mill c: 8)
	(up-build place-control 0 c: house)
	(up-set-timer c: t-house-placement c: 8)
)

(defrule
	(current-age >= middle-antiquity-age)
	(goal allow-houses 1)
	(building-type-count-total house > 0)
	(building-type-count-total mill == 0)
	(goal gl-migration-placement-lock NO)
	(up-pending-objects c: house <= 0)
	(population-headroom > 0)
	(housing-headroom < 5)
	(up-timer-status t-house-placement != timer-running)
	(can-afford-building house)
	(up-can-build 0 c: house)
=>
	(up-build place-normal 0 c: house)
	(up-set-timer c: t-house-placement c: 8)
)

(defrule
	(goal allow-houses 1)
	(building-type-count-total house == 0)
	(building-type-count-total mill >= 1)
	(goal gl-migration-placement-lock NO)
	(up-pending-objects c: house <= 0)
	(population-headroom > 0)
	(housing-headroom < 5)
	(up-timer-status t-house-placement != timer-running)
	(can-afford-building house)
	(up-can-build 0 c: house)
=>
	;Starting-Mill starts and rebuilt housing use the same local clearance bias.
	(up-set-placement-data my-player-number mill c: 8)
	(up-build place-control 0 c: house)
	(up-set-timer c: t-house-placement c: 8)
)

;Under sustained population pressure, put one new House at the confirmed
;colony instead of consuming another military-production tile around the home
;Mill. This is replacement-free: completed inner housing is never deleted.
(defrule
	(goal gl-house-pressure YES)
	(goal gl-island-colony-established YES)
	(goal gl-migration-placement-lock NO)
	(up-timer-status t-house-pressure == timer-triggered)
	(up-pending-objects c: house < 2)
	(population-headroom > 0)
	(housing-headroom < 3)
	(up-timer-status t-house-placement != timer-running)
	(can-afford-building house)
	(up-can-build 0 c: house)
	(or
		(goal map-type RIVERS)
		(or
			(goal map-type ISLANDS)
			(goal map-type TEAM-ISLANDS)
		)
	)
=>
	(up-copy-point point2-x gl-island-colony-x)
	;Keep colony housing near its confirmed resource anchor. The former diagonal
	;offset was almost twenty tiles away and could cross a narrow island.
	(up-modify-goal point2-x c:+ 6)
	(up-modify-goal point2-y c:+ 6)
	(up-bound-point point3-x point2-x)
	(up-set-target-point point3-x)
	(up-build place-point 0 c: house)
	(up-set-timer c: t-house-pressure c: 30)
	(up-set-timer c: t-house-placement c: 8)
)

(defrule
	(goal gl-house-pressure YES)
	(up-timer-status t-house-pressure == timer-triggered)
	(building-type-count-total mill >= 1)
	(goal gl-migration-placement-lock NO)
	(up-pending-objects c: house < 2)
	(population-headroom > 0)
	(housing-headroom < 3)
	(up-timer-status t-house-placement != timer-running)
	(can-afford-building house)
	(up-can-build 0 c: house)
=>
	(up-set-placement-data my-player-number mill c: 8)
	(up-build place-control 0 c: house)
	(up-set-timer c: t-house-pressure c: 30)
	(up-set-timer c: t-house-placement c: 8)
)

(defrule
	(goal gl-house-pressure YES)
	(up-timer-status t-house-pressure == timer-triggered)
	(building-type-count-total mill == 0)
	(goal gl-migration-placement-lock NO)
	(up-pending-objects c: house < 2)
	(population-headroom > 0)
	(housing-headroom < 3)
	(up-timer-status t-house-placement != timer-running)
	(can-afford-building house)
	(up-can-build 0 c: house)
=>
	(up-build place-normal 0 c: house)
	(up-set-timer c: t-house-pressure c: 30)
	(up-set-timer c: t-house-placement c: 8)
)

(defrule
	(current-age >= middle-antiquity-age)
	(goal allow-houses 1)
	(building-type-count-total house > 0)
	(building-type-count-total mill >= 1)
	(goal gl-migration-placement-lock NO)
	(up-pending-objects c: house <= 0)
	(population-headroom > 0)
	(housing-headroom < 5)
	(up-timer-status t-house-placement != timer-running)
	(can-afford-building house)
	(up-can-build 0 c: house)
=>
	(up-set-placement-data my-player-number mill c: 8)
	(up-build place-control 0 c: house)
	(up-set-timer c: t-house-placement c: 8)
)

;The first Lumber Camp cannot depend on an existing classified woodcutter: with
;three opening villagers, a ten-percent wood allocation can legitimately round
;to zero. Bootstrap only from a visible tree near the active home
;land, then feed that exact resource into the same cluster/foundation validator
;used by later worker-owned camps.
(defrule
	(up-timer-status t-lumbercamp-placement == timer-triggered)
	(goal gl-lumbercamp-placement-state PLACEMENT-IDLE)
	(goal gl-island-migration-state MIGRATION-IDLE)
	(up-compare-goal desired-number-lumbercamps c:>= 1)
	(up-compare-goal gl-home-zone c:>= 0)
	(building-type-count-total lumber-camp == 0)
	(up-pending-objects c: lumber-camp <= 0)
	(not (up-pending-placement c: lumber-camp))
	(can-afford-building lumber-camp)
=>
	(up-modify-goal gl-lumbercamp-placement-focus s:= sn-focus-player-number)
	(set-strategic-number sn-focus-player-number 0)
	(up-full-reset-search)
	(up-set-target-point gl-home-anchor-x)
	(up-filter-distance c: -1 c: 40)
	(up-find-remote c: tree-class c: 40)
	(up-remove-objects search-remote object-data-map-zone-id g:!= gl-home-zone)
	(up-remove-objects search-remote object-data-id g:== gl-lumbercamp-rejected-resource-id)
	(up-remove-objects search-remote object-data-id g:== gl-lumbercamp-rejected-resource-id2)
	(up-remove-objects search-remote object-data-id g:== gl-lumbercamp-rejected-resource-id3)
	(up-clean-search search-remote object-data-distance search-order-asc)
	;Keep one stable rank from the freshly rebuilt list. Sparse candidates advance
	;this cursor monotonically instead of cycling through a three-ID ring.
	(up-remove-objects search-remote object-data-index g:!= gl-lumbercamp-candidate-index)
	(set-goal gl-lumbercamp-placement-attempts 0)
	(up-set-timer c: t-lumbercamp-placement c: 120)
	(set-goal gl-lumbercamp-placement-state PLACEMENT-FIND-RESOURCE)
)

;After the bootstrap, the desired count is a ceiling. A live same-zone
;woodcutter owns each additional request, and a nearby tree must still belong
;to a useful cluster before point placement is issued.
(defrule
	(up-timer-status t-lumbercamp-placement == timer-triggered)
	(goal gl-lumbercamp-placement-state PLACEMENT-IDLE)
	(goal gl-island-migration-state MIGRATION-IDLE)
	(unit-type-count villager-wood >= 1)
	(building-type-count-total lumber-camp >= 1)
	(building-type-count-total lumber-camp g:< desired-number-lumbercamps)
	(building-type-count-total lumber-camp < 8)
	(up-pending-objects c: lumber-camp <= 0)
	(not (up-pending-placement c: lumber-camp))
	(can-afford-building lumber-camp)
=>
	(up-modify-goal gl-lumbercamp-placement-focus s:= sn-focus-player-number)
	(set-strategic-number sn-focus-player-number my-player-number)
	(up-full-reset-search)
	(up-set-target-point gl-home-anchor-x)
	(up-find-local c: villager-class c: 160)
	(up-remove-objects search-local object-data-gather-type != wood)
	(up-get-search-state local-total)
	(up-modify-goal gl-lumbercamp-worker-count g:= local-total)
	;Walking to a tree, returning a load, and dropping it off are all valid
	;wood-worker states. The old instantaneous actionid-gather filter discarded
	;those workers and could suppress every later camp request.
	(up-remove-objects search-local object-data-garrisoned == 1)
	(up-remove-objects search-local object-data-map-zone-id g:!= gl-home-zone)
	(up-clean-search search-local object-data-distance search-order-desc)
	(up-get-search-state local-total)
	(up-modify-goal gl-lumbercamp-candidate-count g:= local-total)
	(up-chat-data-to-self "lumber camp live candidates: %d" g: gl-lumbercamp-candidate-count)
	(set-goal gl-lumbercamp-placement-attempts 0)
	(up-set-timer c: t-lumbercamp-placement c: 120)
	(set-goal gl-lumbercamp-placement-state PLACEMENT-ASSESS)
)

(defrule
	(goal gl-lumbercamp-placement-state PLACEMENT-ASSESS)
	(up-set-target-object search-local c: 0)
=>
	;A returning woodcutter targets a drop site rather than a tree. Anchor the
	;resource search on the worker's own position so walking, gathering, and
	;returning workers can all reveal the distant wood line.
	(up-get-object-data object-data-map-zone-id gl-lumbercamp-resource-zone)
	(up-get-point position-object gl-lumbercamp-target-x)
	(set-strategic-number sn-focus-player-number 0)
	(up-full-reset-search)
	(up-set-target-point gl-lumbercamp-target-x)
	(up-filter-distance c: -1 c: 12)
	(up-find-remote c: tree-class c: 20)
	(up-remove-objects search-remote object-data-map-zone-id g:!= gl-lumbercamp-resource-zone)
	(up-remove-objects search-remote object-data-id g:== gl-lumbercamp-rejected-resource-id)
	(up-remove-objects search-remote object-data-id g:== gl-lumbercamp-rejected-resource-id2)
	(up-remove-objects search-remote object-data-id g:== gl-lumbercamp-rejected-resource-id3)
	(up-clean-search search-remote object-data-distance search-order-asc)
	(set-goal gl-lumbercamp-placement-state PLACEMENT-FIND-RESOURCE)
)

(defrule
	(goal gl-lumbercamp-placement-state PLACEMENT-FIND-RESOURCE)
	(up-set-target-object search-remote c: 0)
	(up-object-data object-data-class == tree-class)
=>
	(up-get-object-data object-data-id gl-lumbercamp-resource-id)
	(up-get-point position-object gl-lumbercamp-target-x)
	(up-get-object-data object-data-map-zone-id gl-lumbercamp-resource-zone)
	(up-full-reset-search)
	(up-set-target-point gl-lumbercamp-target-x)
	(up-filter-distance c: -1 c: 8)
	(up-find-remote c: tree-class c: 20)
	(up-remove-objects search-remote object-data-map-zone-id g:!= gl-lumbercamp-resource-zone)
	;up-get-search-state always writes local total, local last, remote total, and
	;remote last beginning at its operand. local-total is the four-goal base.
	(up-get-search-state local-total)
	(set-goal gl-lumbercamp-placement-state PLACEMENT-CHECK-RESOURCE)
)

(defrule
	(goal gl-lumbercamp-placement-state PLACEMENT-CHECK-RESOURCE)
	(up-compare-goal remote-total c:>= 3)
=>
	(set-strategic-number sn-focus-player-number my-player-number)
	(up-full-reset-search)
	(up-set-target-point gl-lumbercamp-target-x)
	(up-find-remote c: lumber-camp c: 20)
	(up-remove-objects search-remote object-data-map-zone-id g:!= gl-lumbercamp-resource-zone)
	(up-clean-search search-remote object-data-distance search-order-asc)
	(up-modify-sn sn-focus-player-number g:= gl-lumbercamp-placement-focus)
	(set-goal gl-lumbercamp-placement-state PLACEMENT-FIND-CAMP)
)

(defrule
	(goal gl-lumbercamp-placement-state PLACEMENT-CHECK-RESOURCE)
	(up-compare-goal remote-total c:< 3)
=>
	(up-modify-goal gl-lumbercamp-rejected-resource-id3 g:= gl-lumbercamp-rejected-resource-id2)
	(up-modify-goal gl-lumbercamp-rejected-resource-id2 g:= gl-lumbercamp-rejected-resource-id)
	(up-modify-goal gl-lumbercamp-rejected-resource-id g:= gl-lumbercamp-resource-id)
	(up-modify-goal gl-lumbercamp-candidate-index c:+ 1)
	(up-modify-sn sn-focus-player-number g:= gl-lumbercamp-placement-focus)
	(up-chat-data-to-self "lumber camp rejected sparse wood zone: %d" g: gl-lumbercamp-resource-zone)
	(up-chat-data-to-self "lumber camp sparse tree count: %d" g: remote-total)
	(up-set-timer c: t-lumbercamp-placement c: 15)
	(set-goal gl-lumbercamp-placement-state PLACEMENT-IDLE)
)

(defrule
	(goal gl-lumbercamp-placement-state PLACEMENT-ASSESS)
	(not (up-set-target-object search-local c: 0))
=>
	;The rejection ring is bounded backoff. If all current woodcutter targets are
	;temporarily sparse, release it before a later economy assignment is sampled.
	(set-goal gl-lumbercamp-rejected-resource-id -1)
	(set-goal gl-lumbercamp-rejected-resource-id2 -1)
	(set-goal gl-lumbercamp-rejected-resource-id3 -1)
	(set-goal gl-lumbercamp-candidate-index 0)
	(up-modify-sn sn-focus-player-number g:= gl-lumbercamp-placement-focus)
	(up-set-timer c: t-lumbercamp-placement c: 15)
	(set-goal gl-lumbercamp-placement-state PLACEMENT-IDLE)
)

(defrule
	(goal gl-lumbercamp-placement-state PLACEMENT-FIND-RESOURCE)
	(or
		(not (up-set-target-object search-remote c: 0))
		(up-object-data object-data-class != tree-class)
	)
=>
	;The three-entry rejection ring is bounded backoff, not a permanent ban.
	;If every non-rejected tree has been exhausted, release the ring so a
	;temporarily obstructed sole resource can be reconsidered.
	(set-goal gl-lumbercamp-rejected-resource-id -1)
	(set-goal gl-lumbercamp-rejected-resource-id2 -1)
	(set-goal gl-lumbercamp-rejected-resource-id3 -1)
	(set-goal gl-lumbercamp-candidate-index 0)
	(up-modify-sn sn-focus-player-number g:= gl-lumbercamp-placement-focus)
	(up-set-timer c: t-lumbercamp-placement c: 15)
	(set-goal gl-lumbercamp-placement-state PLACEMENT-IDLE)
)

(defrule
	(goal gl-lumbercamp-placement-state PLACEMENT-FIND-CAMP)
	(up-set-target-object search-remote c: 0)
	(up-object-data object-data-distance <= 10)
=>
	(up-set-timer c: t-lumbercamp-placement c: 60)
	(set-goal gl-lumbercamp-placement-state PLACEMENT-IDLE)
)

(defrule
	(goal gl-lumbercamp-placement-state PLACEMENT-FIND-CAMP)
	(or
		(not (up-set-target-object search-remote c: 0))
		(up-object-data object-data-distance > 10)
	)
=>
	(set-goal gl-lumbercamp-placement-attempts 0)
	(set-goal gl-lumbercamp-placement-state PLACEMENT-PLACE)
)

(defrule
	(goal gl-lumbercamp-placement-state PLACEMENT-PLACE)
	(goal gl-lumbercamp-placement-attempts 0)
	(can-afford-building lumber-camp)
=>
	(up-copy-point point2-x gl-lumbercamp-target-x)
	(up-modify-goal point2-x c:+ 3)
	(up-modify-goal point2-y c:+ 3)
	(up-bound-point point3-x point2-x)
	(up-set-target-point point3-x)
	(up-build place-point 0 c: lumber-camp)
	(set-goal gl-lumbercamp-placement-attempts 1)
	(up-chat-data-to-self "lumber camp resource zone: %d" g: gl-lumbercamp-resource-zone)
	(up-set-timer c: t-lumbercamp-placement c: 30)
	(set-goal gl-lumbercamp-placement-state PLACEMENT-WAIT)
)

(defrule
	(goal gl-lumbercamp-placement-state PLACEMENT-PLACE)
	(goal gl-lumbercamp-placement-attempts 1)
	(can-afford-building lumber-camp)
=>
	(up-copy-point point2-x gl-lumbercamp-target-x)
	(up-modify-goal point2-x c:- 3)
	(up-modify-goal point2-y c:+ 3)
	(up-bound-point point3-x point2-x)
	(up-set-target-point point3-x)
	(up-build place-point 0 c: lumber-camp)
	(set-goal gl-lumbercamp-placement-attempts 2)
	(up-set-timer c: t-lumbercamp-placement c: 30)
	(set-goal gl-lumbercamp-placement-state PLACEMENT-WAIT)
)

(defrule
	(goal gl-lumbercamp-placement-state PLACEMENT-PLACE)
	(goal gl-lumbercamp-placement-attempts 2)
	(can-afford-building lumber-camp)
=>
	(up-copy-point point2-x gl-lumbercamp-target-x)
	(up-modify-goal point2-x c:+ 3)
	(up-modify-goal point2-y c:- 3)
	(up-bound-point point3-x point2-x)
	(up-set-target-point point3-x)
	(up-build place-point 0 c: lumber-camp)
	(set-goal gl-lumbercamp-placement-attempts 3)
	(up-set-timer c: t-lumbercamp-placement c: 30)
	(set-goal gl-lumbercamp-placement-state PLACEMENT-WAIT)
)

(defrule
	(goal gl-lumbercamp-placement-state PLACEMENT-PLACE)
	(goal gl-lumbercamp-placement-attempts 3)
	(can-afford-building lumber-camp)
=>
	(up-copy-point point2-x gl-lumbercamp-target-x)
	(up-modify-goal point2-x c:- 3)
	(up-modify-goal point2-y c:- 3)
	(up-bound-point point3-x point2-x)
	(up-set-target-point point3-x)
	(up-build place-point 0 c: lumber-camp)
	(set-goal gl-lumbercamp-placement-attempts 4)
	(up-set-timer c: t-lumbercamp-placement c: 30)
	(set-goal gl-lumbercamp-placement-state PLACEMENT-WAIT)
)

(defrule
	(goal gl-lumbercamp-placement-state PLACEMENT-PLACE)
	(not (can-afford-building lumber-camp))
=>
	(up-modify-sn sn-focus-player-number g:= gl-lumbercamp-placement-focus)
	(set-goal gl-lumbercamp-placement-attempts 0)
	(up-set-timer c: t-lumbercamp-placement c: 30)
	(set-goal gl-lumbercamp-placement-state PLACEMENT-IDLE)
)

(defrule
	(goal gl-lumbercamp-placement-state PLACEMENT-WAIT)
	(up-pending-objects c: lumber-camp >= 1)
=>
	(set-strategic-number sn-focus-player-number my-player-number)
	(up-full-reset-search)
	(up-set-target-point gl-lumbercamp-target-x)
	(up-filter-distance c: -1 c: 8)
	(up-filter-status c: status-pending c: list-active)
	(up-find-status-local c: lumber-camp c: 8)
	(up-clean-search search-local object-data-distance search-order-asc)
	(set-goal gl-lumbercamp-placement-state PLACEMENT-CHECK-FOUNDATION)
)

(defrule
	(goal gl-lumbercamp-placement-state PLACEMENT-CHECK-FOUNDATION)
	(up-set-target-object search-local c: 0)
	(up-object-data object-data-distance <= 8)
	(up-object-data object-data-map-zone-id g:== gl-lumbercamp-resource-zone)
=>
	(up-get-object-data object-data-id gl-lumbercamp-foundation-id)
	(set-strategic-number sn-focus-player-number 0)
	(up-full-reset-search)
	(up-add-object-by-id search-remote g: gl-lumbercamp-resource-id)
	(set-goal gl-lumbercamp-placement-state PLACEMENT-VALIDATE-FOUNDATION-RESOURCE)
)

(defrule
	(goal gl-lumbercamp-placement-state PLACEMENT-CHECK-FOUNDATION)
	(up-set-target-object search-local c: 0)
	(up-object-data object-data-distance <= 8)
	(up-object-data object-data-map-zone-id g:!= gl-lumbercamp-resource-zone)
=>
	(up-get-object-data object-data-id gl-lumbercamp-foundation-id)
	(up-target-point 0 action-delete -1 -1)
	(up-reset-placement c: lumber-camp)
	(up-chat-data-to-self "lumber camp deleted wrong-zone foundation: %d" g: gl-lumbercamp-foundation-id)
	(up-modify-sn sn-focus-player-number g:= gl-lumbercamp-placement-focus)
	(up-set-timer c: t-lumbercamp-placement c: 30)
	(set-goal gl-lumbercamp-placement-state PLACEMENT-IDLE)
)

(defrule
	(goal gl-lumbercamp-placement-state PLACEMENT-CHECK-FOUNDATION)
	(not (up-set-target-object search-local c: 0))
=>
	(up-reset-placement c: lumber-camp)
	(up-modify-sn sn-focus-player-number g:= gl-lumbercamp-placement-focus)
	(up-set-timer c: t-lumbercamp-placement c: 30)
	(set-goal gl-lumbercamp-placement-state PLACEMENT-IDLE)
)

(defrule
	(goal gl-lumbercamp-placement-state PLACEMENT-VALIDATE-FOUNDATION-RESOURCE)
	(up-set-target-object search-remote c: 0)
	(up-object-data object-data-class == tree-class)
	(up-object-data object-data-map-zone-id g:== gl-lumbercamp-resource-zone)
=>
	(up-chat-data-to-self "lumber camp accepted live resource: %d" g: gl-lumbercamp-resource-id)
	;Assign only nearby wood workers to the exact validated foundation. This
	;finishes the camp without exposing shepherds or hunters to global builder
	;assistance.
	(set-strategic-number sn-focus-player-number my-player-number)
	(up-full-reset-search)
	(up-add-object-by-id search-remote g: gl-lumbercamp-foundation-id)
	(up-set-target-point gl-lumbercamp-target-x)
	(up-filter-distance c: -1 c: 12)
	(up-find-local c: villager-class c: 20)
	(up-remove-objects search-local object-data-gather-type != wood)
	(up-remove-objects search-local object-data-garrisoned == 1)
	(up-remove-objects search-local object-data-map-zone-id g:!= gl-lumbercamp-resource-zone)
	(up-clean-search search-local object-data-distance search-order-asc)
	(up-remove-objects search-local object-data-index g:>= 2)
	(up-get-search-state local-total)
	(up-target-objects 0 action-default -1 stance-no-attack)
	(up-chat-data-to-self "lumber camp builders assigned: %d" g: local-total)
	(up-modify-sn sn-focus-player-number g:= gl-lumbercamp-placement-focus)
	(set-goal gl-lumbercamp-placement-attempts 0)
	(set-goal gl-lumbercamp-candidate-index 0)
	(up-set-timer c: t-lumbercamp-placement c: 90)
	(set-goal gl-lumbercamp-placement-state PLACEMENT-IDLE)
)

(defrule
	(goal gl-lumbercamp-placement-state PLACEMENT-VALIDATE-FOUNDATION-RESOURCE)
	(or
		(not (up-set-target-object search-remote c: 0))
		(or
			(up-object-data object-data-class != tree-class)
			(up-object-data object-data-map-zone-id g:!= gl-lumbercamp-resource-zone)
		)
	)
=>
	(set-strategic-number sn-focus-player-number my-player-number)
	(up-full-reset-search)
	(up-add-object-by-id search-local g: gl-lumbercamp-foundation-id)
	(up-set-target-object search-local c: 0)
	(up-target-point 0 action-delete -1 -1)
	(up-reset-placement c: lumber-camp)
	(up-modify-goal gl-lumbercamp-rejected-resource-id3 g:= gl-lumbercamp-rejected-resource-id2)
	(up-modify-goal gl-lumbercamp-rejected-resource-id2 g:= gl-lumbercamp-rejected-resource-id)
	(up-modify-goal gl-lumbercamp-rejected-resource-id g:= gl-lumbercamp-resource-id)
	(up-chat-data-to-self "lumber camp deleted stale resource foundation: %d" g: gl-lumbercamp-foundation-id)
	(up-modify-sn sn-focus-player-number g:= gl-lumbercamp-placement-focus)
	(set-goal gl-lumbercamp-placement-attempts 0)
	(up-set-timer c: t-lumbercamp-placement c: 30)
	(set-goal gl-lumbercamp-placement-state PLACEMENT-IDLE)
)

;Four builders can complete the tiny foundation before the WAIT sweep ever
;observes a pending object. Resolve a ready camp at the exact candidate before
;classifying that successful build as a failed offset.
(defrule
	(goal gl-lumbercamp-placement-state PLACEMENT-WAIT)
	(up-timer-status t-lumbercamp-placement == timer-triggered)
	(up-pending-objects c: lumber-camp <= 0)
	(building-type-count-total lumber-camp >= 1)
=>
	(set-strategic-number sn-focus-player-number my-player-number)
	(up-full-reset-search)
	(up-set-target-point gl-lumbercamp-target-x)
	(up-filter-distance c: -1 c: 8)
	(up-filter-status c: status-ready c: list-active)
	(up-find-local c: lumber-camp c: 8)
	(up-remove-objects search-local object-data-map-zone-id g:!= gl-lumbercamp-resource-zone)
	(up-clean-search search-local object-data-distance search-order-asc)
	(set-goal gl-lumbercamp-placement-state PLACEMENT-FIND-COMPLETED)
)

(defrule
	(goal gl-lumbercamp-placement-state PLACEMENT-FIND-COMPLETED)
	(up-set-target-object search-local c: 0)
=>
	(set-strategic-number sn-focus-player-number 0)
	(up-full-reset-search)
	(up-add-object-by-id search-remote g: gl-lumbercamp-resource-id)
	(set-goal gl-lumbercamp-placement-state PLACEMENT-VALIDATE-COMPLETED-RESOURCE)
)

(defrule
	(goal gl-lumbercamp-placement-state PLACEMENT-FIND-COMPLETED)
	(not (up-set-target-object search-local c: 0))
=>
	(up-reset-placement c: lumber-camp)
	(set-goal gl-lumbercamp-placement-state PLACEMENT-PLACE)
)

(defrule
	(goal gl-lumbercamp-placement-state PLACEMENT-VALIDATE-COMPLETED-RESOURCE)
	(up-set-target-object search-remote c: 0)
	(up-object-data object-data-class == tree-class)
	(up-object-data object-data-map-zone-id g:== gl-lumbercamp-resource-zone)
=>
	(up-chat-data-to-self "lumber camp accepted completed resource: %d" g: gl-lumbercamp-resource-id)
	(up-modify-sn sn-focus-player-number g:= gl-lumbercamp-placement-focus)
	(set-goal gl-lumbercamp-placement-attempts 0)
	(set-goal gl-lumbercamp-candidate-index 0)
	(up-set-timer c: t-lumbercamp-placement c: 90)
	(set-goal gl-lumbercamp-placement-state PLACEMENT-IDLE)
)

(defrule
	(goal gl-lumbercamp-placement-state PLACEMENT-VALIDATE-COMPLETED-RESOURCE)
	(or
		(not (up-set-target-object search-remote c: 0))
		(or
			(up-object-data object-data-class != tree-class)
			(up-object-data object-data-map-zone-id g:!= gl-lumbercamp-resource-zone)
		)
	)
=>
	;Never delete a completed drop site merely because its exact sampled tree was
	;cut down while builders worked. Reject that sample and seek another cluster.
	(up-modify-goal gl-lumbercamp-rejected-resource-id3 g:= gl-lumbercamp-rejected-resource-id2)
	(up-modify-goal gl-lumbercamp-rejected-resource-id2 g:= gl-lumbercamp-rejected-resource-id)
	(up-modify-goal gl-lumbercamp-rejected-resource-id g:= gl-lumbercamp-resource-id)
	(up-modify-sn sn-focus-player-number g:= gl-lumbercamp-placement-focus)
	(set-goal gl-lumbercamp-placement-attempts 0)
	(up-set-timer c: t-lumbercamp-placement c: 30)
	(set-goal gl-lumbercamp-placement-state PLACEMENT-IDLE)
)

(defrule
	(goal gl-lumbercamp-placement-state PLACEMENT-WAIT)
	(up-timer-status t-lumbercamp-placement == timer-triggered)
	(up-pending-objects c: lumber-camp <= 0)
	(up-compare-goal gl-lumbercamp-placement-attempts c:< 4)
=>
	(up-reset-placement c: lumber-camp)
	(up-set-timer c: t-lumbercamp-placement c: 30)
	(set-goal gl-lumbercamp-placement-state PLACEMENT-PLACE)
)

(defrule
	(goal gl-lumbercamp-placement-state PLACEMENT-WAIT)
	(up-timer-status t-lumbercamp-placement == timer-triggered)
	(up-pending-objects c: lumber-camp <= 0)
	(up-compare-goal gl-lumbercamp-placement-attempts c:>= 4)
=>
	(up-reset-placement c: lumber-camp)
	(up-modify-goal gl-lumbercamp-rejected-resource-id3 g:= gl-lumbercamp-rejected-resource-id2)
	(up-modify-goal gl-lumbercamp-rejected-resource-id2 g:= gl-lumbercamp-rejected-resource-id)
	(up-modify-goal gl-lumbercamp-rejected-resource-id g:= gl-lumbercamp-resource-id)
	(up-chat-data-to-self "lumber camp exhausted offsets at resource: %d" g: gl-lumbercamp-resource-id)
	(up-modify-sn sn-focus-player-number g:= gl-lumbercamp-placement-focus)
	(set-goal gl-lumbercamp-placement-attempts 0)
	(up-set-timer c: t-lumbercamp-placement c: 60)
	(set-goal gl-lumbercamp-placement-state PLACEMENT-IDLE)
)

(defrule
	(up-timer-status t-lumbercamp-placement == timer-triggered)
	(up-compare-goal gl-lumbercamp-placement-state c:!= PLACEMENT-IDLE)
=>
	(up-reset-placement c: lumber-camp)
	(up-modify-sn sn-focus-player-number g:= gl-lumbercamp-placement-focus)
	(up-set-timer c: t-lumbercamp-placement c: 30)
	(set-goal gl-lumbercamp-placement-state PLACEMENT-IDLE)
)

(defrule
	(and	
		(up-gaia-type-count c: food >= 5)
		(and
			(building-type-count-total lumber-camp >= 1)
			(and
				(building-type-count-total farm g:< gl-farm-build-target)
				(building-type-count-total mill g:< desired-number-mills)
			)
		)
	)
	;The opening Mill is exclusively owned by the escrow bootstrap below. This
	;rule may only add a genuinely additional drop site later.
	(goal gl-island-migration-state MIGRATION-IDLE)
	(building-type-count-total mill > 0)
	(dropsite-min-distance food > 12)
	(dropsite-min-distance food g:< map-size)
	(can-afford-building mill)
	(up-pending-objects c: mill <= 0)
	(up-can-build 0 c: mill)
=>
	(up-build place-normal 0 c: mill)
)

(defrule
	(goal dependent-farms FARM-DEMAND-DEPENDENT)
=>
	(up-modify-goal gl-farm-build-target g:= villager-count)
	(up-modify-goal gl-farm-build-target s:%* sn-food-gatherer-percentage)
	(up-modify-goal 510 g:= gl-farm-build-target)
	(up-get-fact unit-type-count villager-food 509)
	(up-modify-goal gl-farm-build-target g:- 509)
	(up-get-fact unit-type-count villager-farmer 509)
	(up-modify-goal gl-farm-build-target g:+ 509)
	;At most two shore fishermen may substitute for farms. Add the full
	;fisherman count back, then discount only the bounded supplement.
	(up-get-fact unit-type-count villager-fisherman 509)
	(up-modify-goal gl-farm-build-target g:+ 509)
	(up-modify-goal 509 c:min 2)
	(up-modify-goal gl-farm-build-target g:- 509)
	(up-modify-goal gl-farm-build-target c:max 0)
	(up-modify-goal 510 c:+ 2);
	(up-modify-goal gl-farm-build-target g:min 510)
)

;Once land food is exhausted, derive farms from the current villager economy,
;not the phase's population-cap percentage. Shore fishing remains a bounded
;supplement, so it cannot displace more than two farms.
(defrule
	(goal dependent-farms FARM-DEMAND-INDEPENDENT)
=>
	(up-modify-goal gl-farm-build-target g:= villager-count)
	(up-modify-goal gl-farm-build-target s:%* sn-food-gatherer-percentage)
	(up-get-fact unit-type-count villager-fisherman 509)
	(up-modify-goal 509 c:min 2)
	(up-modify-goal gl-farm-build-target g:- 509)
	(up-modify-goal gl-farm-build-target c:max 0)
)

;Farm construction and farm staffing are separate invariants. A completed
;abandoned Farm must be reclaimed even when the building target is already met.
;The tasker handles one worker per bounded pass and only targets a Farm in the
;worker's land zone, so it never issues an impossible across-water gather order.
(defrule
	(up-timer-status t-farm-staffing == timer-triggered)
	(goal gl-farm-staffing-state FARM-STAFFING-IDLE)
	(goal gl-island-migration-state MIGRATION-IDLE)
	(building-type-count farm >= 1)
	(or
		(unit-type-count villager-fisherman > 0)
		(unit-type-count villager-farmer g:< gl-farm-build-target)
	)
=>
	(up-modify-goal gl-farm-staffing-focus s:= sn-focus-player-number)
	(set-strategic-number sn-focus-player-number my-player-number)
	(up-full-reset-search)
	(up-set-target-point position-self-x)
	(up-filter-distance c: -1 g: map-size)
	(up-filter-status c: status-ready c: list-active)
	(up-find-remote c: farm c: 240)
	(up-remove-objects search-remote object-data-tasks-count > 0)
	(up-clean-search search-remote object-data-distance search-order-asc)
	(set-goal gl-farm-staffing-state FARM-STAFFING-FIND-FARM)
)

(defrule
	(goal gl-farm-staffing-state FARM-STAFFING-FIND-FARM)
	(up-set-target-object search-remote c: 0)
=>
	(up-get-object-data object-data-id gl-farm-staffing-id)
	(up-get-object-data object-data-map-zone-id gl-farm-staffing-zone)
	(up-get-point position-object point2-x)
	;Keep the remaining Farm candidates in search-remote. If this Farm's zone has
	;lost every eligible worker, the failure path can reject it and advance.
	(up-reset-search 1 1 0 0)
	(up-set-target-point point2-x)
	(up-find-local c: villager-class c: 240)
	(up-remove-objects search-local object-data-language-id != lid-villager-fisherman)
	(up-remove-objects search-local object-data-garrisoned == 1)
	(up-remove-objects search-local object-data-map-zone-id g:!= gl-farm-staffing-zone)
	(up-clean-search search-local object-data-distance search-order-asc)
	(up-remove-objects search-local object-data-index >= 1)
	(set-goal gl-farm-staffing-state FARM-STAFFING-CHECK-FISHERMAN)
)

(defrule
	(goal gl-farm-staffing-state FARM-STAFFING-CHECK-FISHERMAN)
	(up-set-target-object search-local c: 0)
=>
	(up-add-object-by-id search-remote g: gl-farm-staffing-id)
	(up-target-objects 0 action-default -1 stance-no-attack)
	(up-chat-data-to-self "farm staffing fisherman: %d" g: gl-farm-staffing-id)
	(up-modify-sn sn-focus-player-number g:= gl-farm-staffing-focus)
	(up-set-timer c: t-farm-staffing c: 5)
	(set-goal gl-farm-staffing-state FARM-STAFFING-IDLE)
)

(defrule
	(goal gl-farm-staffing-state FARM-STAFFING-CHECK-FISHERMAN)
	(not (up-set-target-object search-local c: 0))
=>
	(up-reset-search 1 1 0 0)
	(up-set-target-point point2-x)
	(up-find-local c: villager-class c: 240)
	(up-remove-objects search-local object-data-garrisoned == 1)
	(up-remove-objects search-local object-data-idling != 1)
	(up-remove-objects search-local object-data-map-zone-id g:!= gl-farm-staffing-zone)
	(up-clean-search search-local object-data-distance search-order-asc)
	(up-remove-objects search-local object-data-index >= 1)
	(set-goal gl-farm-staffing-state FARM-STAFFING-CHECK-IDLE)
)

(defrule
	(goal gl-farm-staffing-state FARM-STAFFING-CHECK-IDLE)
	(up-set-target-object search-local c: 0)
=>
	(up-add-object-by-id search-remote g: gl-farm-staffing-id)
	(up-target-objects 0 action-default -1 stance-no-attack)
	(up-chat-data-to-self "farm staffing idle: %d" g: gl-farm-staffing-id)
	(up-modify-sn sn-focus-player-number g:= gl-farm-staffing-focus)
	(up-set-timer c: t-farm-staffing c: 5)
	(set-goal gl-farm-staffing-state FARM-STAFFING-IDLE)
)

(defrule
	(goal gl-farm-staffing-state FARM-STAFFING-CHECK-IDLE)
	(not (up-set-target-object search-local c: 0))
=>
	(up-reset-search 1 1 0 0)
	(up-set-target-point point2-x)
	(up-find-local c: villager-class c: 240)
	(up-remove-objects search-local object-data-garrisoned == 1)
	(up-remove-objects search-local object-data-action == actionid-build)
	(up-remove-objects search-local object-data-action == actionid-repair)
	(up-remove-objects search-local object-data-action == actionid-hunt)
	(up-remove-objects search-local object-data-target == prey-animal-class)
	(up-remove-objects search-local object-data-target == livestock-class)
	(up-remove-objects search-local object-data-language-id == lid-villager-farmer)
	(up-remove-objects search-local object-data-language-id == lid-villager-shepherd)
	(up-remove-objects search-local object-data-language-id == lid-villager-forager)
	(up-remove-objects search-local object-data-language-id == lid-villager-hunter)
	(up-remove-objects search-local object-data-language-id == lid-villager-builder)
	(up-remove-objects search-local object-data-group-flag == migration-boarding-group)
	(up-remove-objects search-local object-data-map-zone-id g:!= gl-farm-staffing-zone)
	(up-clean-search search-local object-data-distance search-order-asc)
	(up-remove-objects search-local object-data-index >= 1)
	(set-goal gl-farm-staffing-state FARM-STAFFING-ASSIGN)
)

(defrule
	(goal gl-farm-staffing-state FARM-STAFFING-ASSIGN)
	(up-set-target-object search-local c: 0)
=>
	(up-add-object-by-id search-remote g: gl-farm-staffing-id)
	(up-target-objects 0 action-default -1 stance-no-attack)
	(up-chat-data-to-self "farm staffing worker: %d" g: gl-farm-staffing-id)
	(up-modify-sn sn-focus-player-number g:= gl-farm-staffing-focus)
	(up-set-timer c: t-farm-staffing c: 5)
	(set-goal gl-farm-staffing-state FARM-STAFFING-IDLE)
)

(defrule
	(goal gl-farm-staffing-state FARM-STAFFING-ASSIGN)
	(not (up-set-target-object search-local c: 0))
=>
	;An orphan Farm must not monopolize every later staffing pass. Remove it from
	;this preserved candidate list and test the next observed Farm immediately.
	(up-remove-objects search-remote object-data-id g:== gl-farm-staffing-id)
	(up-clean-search search-remote object-data-distance search-order-asc)
	(set-goal gl-farm-staffing-state FARM-STAFFING-FIND-FARM)
)

;Once Farms exist, civilian shore fishing is no longer a permanent role. If no
;same-zone Farm is available, convert one excess fisherman per pass to an
;observed same-zone mine or tree. This also prevents a resource-island colony
;from turning every transported worker into a shoreline fisherman.
(defrule
	(goal gl-farm-staffing-state FARM-STAFFING-FIND-FARM)
	(not (up-set-target-object search-remote c: 0))
=>
	(up-full-reset-search)
	(up-set-target-point position-self-x)
	(up-filter-distance c: -1 g: map-size)
	(up-find-local c: villager-class c: 240)
	(up-remove-objects search-local object-data-language-id != lid-villager-fisherman)
	(up-remove-objects search-local object-data-garrisoned == 1)
	(up-clean-search search-local object-data-distance search-order-asc)
	(up-remove-objects search-local object-data-index >= 1)
	(set-goal gl-farm-staffing-state FARM-STAFFING-CHECK-EXCESS-FISHERMAN)
)

(defrule
	(goal gl-farm-staffing-state FARM-STAFFING-CHECK-EXCESS-FISHERMAN)
	(up-set-target-object search-local c: 0)
=>
	(up-get-object-data object-data-id gl-farm-staffing-worker-id)
	(up-get-object-data object-data-map-zone-id gl-farm-staffing-zone)
	(up-get-point position-object point2-x)
	(set-strategic-number sn-focus-player-number 0)
	(up-full-reset-search)
	(up-set-target-point point2-x)
	(up-filter-distance c: -1 c: 40)
	(up-find-remote c: gold-mine-class c: 10)
	(up-find-remote c: stone-mine-class c: 10)
	(up-find-remote c: tree-class c: 40)
	(up-remove-objects search-remote object-data-map-zone-id g:!= gl-farm-staffing-zone)
	(up-clean-search search-remote object-data-distance search-order-asc)
	(set-goal gl-farm-staffing-state FARM-STAFFING-FIND-RESOURCE)
)

(defrule
	(goal gl-farm-staffing-state FARM-STAFFING-FIND-RESOURCE)
	(up-set-target-object search-remote c: 0)
=>
	(up-get-object-data object-data-id gl-farm-staffing-id)
	(set-strategic-number sn-focus-player-number my-player-number)
	(up-full-reset-search)
	(up-add-object-by-id search-local g: gl-farm-staffing-worker-id)
	(set-strategic-number sn-focus-player-number 0)
	(up-add-object-by-id search-remote g: gl-farm-staffing-id)
	(up-target-objects 0 action-default -1 stance-no-attack)
	(up-chat-data-to-self "fisherman redirected to resource: %d" g: gl-farm-staffing-zone)
	(up-modify-sn sn-focus-player-number g:= gl-farm-staffing-focus)
	(up-set-timer c: t-farm-staffing c: 5)
	(set-goal gl-farm-staffing-state FARM-STAFFING-IDLE)
)

(defrule
	(goal gl-farm-staffing-state FARM-STAFFING-FIND-RESOURCE)
	(not (up-set-target-object search-remote c: 0))
=>
	(up-modify-sn sn-focus-player-number g:= gl-farm-staffing-focus)
	(up-set-timer c: t-farm-staffing c: 20)
	(set-goal gl-farm-staffing-state FARM-STAFFING-IDLE)
)

(defrule
	(goal gl-farm-staffing-state FARM-STAFFING-CHECK-EXCESS-FISHERMAN)
	(not (up-set-target-object search-local c: 0))
=>
	(up-modify-sn sn-focus-player-number g:= gl-farm-staffing-focus)
	(up-set-timer c: t-farm-staffing c: 15)
	(set-goal gl-farm-staffing-state FARM-STAFFING-IDLE)
)

(defrule
	(up-timer-status t-farm-staffing == timer-triggered)
	(goal gl-farm-staffing-state FARM-STAFFING-IDLE)
=>
	(up-set-timer c: t-farm-staffing c: 15)
)

;Report only after economy state transitions and both finalized demand paths.
(defrule
	(timer-triggered t-farm-report)
=>
	(up-get-fact unit-type-count villager-fisherman gl-farm-report-fishermen)
	(up-get-fact unit-type-count villager-farmer gl-farm-report-farmers)
	(up-get-fact building-type-count farm gl-farm-report-farms)
	(up-get-fact dropsite-min-distance hunting gl-farm-report-hunt-distance)
	(up-get-fact dropsite-min-distance food gl-farm-report-food-distance)
	(up-chat-data-to-self "farm mode: %d" g: dependent-farms)
	(up-chat-data-to-self "civilian fishermen: %d" g: gl-farm-report-fishermen)
	(up-chat-data-to-self "farmers: %d" g: gl-farm-report-farmers)
	(up-chat-data-to-self "farms: %d" g: gl-farm-report-farms)
	(up-chat-data-to-self "farm target: %d" g: gl-farm-build-target)
	(up-chat-data-to-self "farm placement suspended: %d" g: gl-farm-placement-suspended)
	(up-chat-data-to-self "hunt distance: %d" g: gl-farm-report-hunt-distance)
	(up-chat-data-to-self "food distance: %d" g: gl-farm-report-food-distance)
	(disable-timer t-farm-report)
)

(defrule
	(wood-amount < 160)
	(dropsite-min-distance wood >= 5)
	(building-type-count-total lumber-camp g:< desired-number-lumbercamps)
	(strategic-number sn-wood-gatherer-percentage >= 1)
=>
	(up-jump-rule 18)
)

(defrule
(or	(goal gl-farm-placement-suspended YES)
(or	(up-compare-goal gl-farm-build-target <= 0)
(or	(building-type-count-total farm g:>= gl-farm-build-target)
(or	(up-pending-placement c: farm)
	(not (up-can-build 0 c: farm))))))
=>
	(up-jump-rule 17)

)

(defrule
	(true)
=>
	(set-goal temporary-goal town-center)
	(set-goal temporary-goal4 0)
	(set-goal temporary-goal5 40)
	(up-modify-goal temporary-goal5 s:min sn-maximum-town-size)
	(set-goal temporary-goal8 0)
	(up-modify-goal temporary-goal9 g:= map-size)
	(set-goal temporary-goal10 0)
)

(defrule
	(true)
=>
	(set-goal point3-x -1)
	(up-set-target-point position-self-x)
	(up-full-reset-search)
	(up-find-local g: temporary-goal c: 12)
	(up-remove-objects search-local object-data-distance g:> temporary-goal5)
	(up-clean-search search-local object-data-distance search-order-asc)
)

(defrule; end neg jump
(not	(up-set-target-object search-local g: temporary-goal4))
=>
	(up-jump-rule 12)
)

(defrule
	(up-set-target-object search-local g: temporary-goal4)
	(up-object-data object-data-type == town-center)
=>
	(set-goal temporary-goal2 2)
	(set-goal temporary-goal3 3)
	(set-goal temporary-goal6 4)
	(set-goal temporary-goal7 1)
)

(defrule
	(up-set-target-object search-local g: temporary-goal4)
	(up-object-data object-data-type == mill)
=>
	(set-goal temporary-goal2 1)
	(set-goal temporary-goal3 2)
	(set-goal temporary-goal6 4)
	(set-goal temporary-goal7 1)
)

(defrule
	(goal temporary-goal10 1)
	(goal point3-x -1)
=>
	(up-modify-goal temporary-goal2 c:+ 1)
	(up-modify-goal temporary-goal3 c:+ 1)
	(up-modify-goal temporary-goal6 c:+ 1)
)

(defrule
	(up-set-target-object search-local g: temporary-goal4)
=>
	(up-get-point position-object point-x)
	(up-copy-point point2-x point-x)
	(up-modify-goal point2-x c:+ 40)
	(up-modify-goal point2-y c:+ 40)
	(up-modify-goal point-x g:+ temporary-goal2)
	(up-modify-goal point-y g:+ temporary-goal3)
)

(defrule
	(up-compare-goal point-x >= 0)
	(up-can-build-line 0 point-x c: farm)
	(up-point-distance point2-x point-x g:< temporary-goal9)
=>
	(up-get-point-distance point2-x point-x temporary-goal9)
	(up-copy-point point3-x point-x)
)

(defrule
	(up-compare-goal temporary-goal6 >= 2)
=>
	(up-modify-goal point-x g:- temporary-goal7)
	(up-modify-goal temporary-goal6 c:- 1)
	(up-jump-rule -2)
)

(defrule
	(up-compare-goal temporary-goal6 == 1)
	(up-set-target-object search-local g: temporary-goal4)
=>
	(up-get-point position-object point-x)
	(up-modify-goal point-x g:+ temporary-goal3)
	(up-modify-goal point-y g:+ temporary-goal3)
	(set-goal temporary-goal6 -7)
)

(defrule
	(up-compare-goal temporary-goal6 <= -2)
=>
	(up-modify-goal point-y g:- temporary-goal7)
	(up-modify-goal temporary-goal6 c:+ 1)
	(up-jump-rule -4)
)

(defrule
	(goal temporary-goal8 0)
=>
	(set-goal temporary-goal6 4)
	(up-modify-goal temporary-goal2 c:+ 1)
	(up-modify-goal temporary-goal3 c:+ 1)
	(up-modify-goal temporary-goal2 c:* -1)
	(up-modify-goal temporary-goal3 c:* -1)
	(up-modify-goal temporary-goal7 c:* -1)
	(set-goal temporary-goal8 1)
	(up-jump-rule -6)
)

(defrule
	(goal temporary-goal10 0)
	(goal point3-x -1)
=>
	(set-goal temporary-goal8 0)
	(set-goal temporary-goal10 1)
	(up-jump-rule -10)
)

(defrule
	(goal gl-farm-placement-suspended NO)
	(building-type-count mill >= 1)
	(up-compare-goal point3-x >= 0)
	(up-can-build-line 0 point3-x c: farm)
	(up-can-build 0 c: farm)
=>
;	(chat-to-player my-player-number "Manual farm.")
	(up-build-line point3-x point3-x c: farm)
	(up-jump-rule 3)
)

(defrule
	(up-set-target-object search-local g: temporary-goal4)
=>
	(up-modify-goal temporary-goal4 c:+ 1)
	(set-goal temporary-goal8 0)
	(set-goal temporary-goal10 0)
	(up-jump-rule -13)
)

(defrule
	(not	
		(up-set-target-object search-local g: temporary-goal4)
	)
	(goal temporary-goal town-center)
	(building-type-count mill >= 1)
=>
	(set-goal temporary-goal mill)
	(up-full-reset-search)
	(up-find-local g: temporary-goal c: 20)
	(set-goal temporary-goal4 0)
	(set-goal temporary-goal8 0)
	(set-goal temporary-goal10 0)
	(up-jump-rule -14)
)

;jumps end

(defrule
	(goal gl-farm-placement-suspended NO)
	(wood-amount > 150)
	(building-type-count mill >= 1)
	(up-can-build 0 c: farm)
=>
;	(chat-to-player my-player-number "Normal farm.")
	(up-build place-normal 0 c: farm)
)

(defrule
	(goal gl-colony-towncenter-state COLONY-TC-IDLE)
	(goal gl-island-migration-state MIGRATION-IDLE)
	(goal gl-migration-placement-lock NO)
	(can-afford-building town-center)
	(building-type-count-total town-center == 0)
	(up-pending-objects c: town-center <= 0)
	(not (up-pending-placement c: town-center))
	(up-can-build 0 c: town-center)
=>
	(up-build place-normal 0 c: town-center)
)

;The opening Mill must not be placed before the home explorers have had a real
;chance to reveal forage. Search from the active-home Town Center under Gaia
;focus and require a useful same-zone cluster before point placement. The
;32-tile radius is a provisional home-base bound. Team vision may also reveal
;nearby allied forage, so reject candidates close to every allied Town Center.
(defrule
	(game-time >= 300)
	(up-timer-status t-opening-mill == timer-triggered)
	(goal gl-opening-mill-state OPENING-MILL-IDLE)
	(goal gl-opening-mill-requested NO)
	(goal gl-island-migration-state MIGRATION-IDLE)
	(goal gl-migration-placement-lock NO)
	(up-object-type-count-total c: town-center > 0)
	(up-object-type-count-total c: lumber-camp > 0)
	(up-object-type-count-total c: mill == 0)
	(up-pending-objects c: mill <= 0)
	(not (up-pending-placement c: mill))
	(can-afford-building mill)
	(up-can-build 0 c: mill)
=>
	(up-modify-goal gl-opening-mill-focus s:= sn-focus-player-number)
	(set-goal gl-migration-placement-lock YES)
	(set-goal gl-opening-mill-state OPENING-MILL-FALLBACK)
)

(defrule
	(game-time >= 60)
	(game-time < 300)
	(up-timer-status t-opening-mill == timer-triggered)
	(goal gl-opening-mill-state OPENING-MILL-IDLE)
	(goal gl-opening-mill-requested NO)
	(goal gl-island-migration-state MIGRATION-IDLE)
	(goal gl-migration-placement-lock NO)
	(up-compare-goal gl-home-zone c:>= 0)
	(up-object-type-count-total c: town-center > 0)
	(up-object-type-count-total c: lumber-camp > 0)
	(up-object-type-count-total c: mill == 0)
	(up-pending-objects c: mill <= 0)
	(not (up-pending-placement c: mill))
	(can-afford-building mill)
	(up-can-build 0 c: mill)
=>
	(up-modify-goal gl-opening-mill-focus s:= sn-focus-player-number)
	(set-goal gl-migration-placement-lock YES)
	(set-strategic-number sn-focus-player-number 0)
	(up-full-reset-search)
	(up-set-target-point gl-home-anchor-x)
	(up-filter-distance c: -1 c: 32)
	(up-find-remote c: forage-class c: 20)
	(up-remove-objects search-remote object-data-map-zone-id g:!= gl-home-zone)
	(up-clean-search search-remote object-data-distance search-order-asc)
	(up-remove-objects search-remote object-data-index g:!= gl-opening-mill-candidate-index)
	(up-set-timer c: t-opening-mill c: 120)
	(set-goal gl-opening-mill-state OPENING-MILL-FIND-RESOURCE)
)

(defrule
	(goal gl-opening-mill-state OPENING-MILL-FIND-RESOURCE)
	(up-set-target-object search-remote c: 0)
	(up-object-data object-data-class == forage-class)
	(not (player-in-game any-ally))
=>
	(up-get-object-data object-data-id gl-opening-mill-resource-id)
	(up-get-object-data object-data-map-zone-id gl-opening-mill-resource-zone)
	(up-get-point position-object gl-opening-mill-target-x)
	(up-full-reset-search)
	(up-set-target-point gl-opening-mill-target-x)
	(up-filter-distance c: -1 c: 8)
	(up-find-remote c: forage-class c: 20)
	(up-remove-objects search-remote object-data-map-zone-id g:!= gl-opening-mill-resource-zone)
	(up-get-search-state local-total)
	(set-goal gl-opening-mill-state OPENING-MILL-CHECK-RESOURCE)
)

(defrule
	(goal gl-opening-mill-state OPENING-MILL-FIND-RESOURCE)
	(up-set-target-object search-remote c: 0)
	(up-object-data object-data-class == forage-class)
	(player-in-game any-ally)
=>
	(up-get-object-data object-data-id gl-opening-mill-resource-id)
	(up-get-object-data object-data-map-zone-id gl-opening-mill-resource-zone)
	(up-get-point position-object gl-opening-mill-target-x)
	(up-find-player ally find-ordered gl-opening-mill-ally-player)
	(up-modify-goal gl-opening-mill-ally-first g:= gl-opening-mill-ally-player)
	(set-goal gl-opening-mill-state OPENING-MILL-START-ALLY-CHECK)
)

(defrule
	(goal gl-opening-mill-state OPENING-MILL-START-ALLY-CHECK)
=>
	(up-modify-sn sn-focus-player-number g:= gl-opening-mill-ally-player)
	(up-full-reset-search)
	(up-set-target-point gl-opening-mill-target-x)
	(up-filter-distance c: -1 c: 18)
	(up-find-remote c: town-center c: 10)
	(up-clean-search search-remote object-data-distance search-order-asc)
	(set-goal gl-opening-mill-state OPENING-MILL-CHECK-ALLY-TC)
)

(defrule
	(goal gl-opening-mill-state OPENING-MILL-CHECK-ALLY-TC)
	(up-set-target-object search-remote c: 0)
=>
	(up-chat-data-to-self "opening Mill rejected allied-base forage: %d" g: gl-opening-mill-resource-id)
	(up-modify-goal gl-opening-mill-candidate-index c:+ 1)
	(up-modify-sn sn-focus-player-number g:= gl-opening-mill-focus)
	(set-goal gl-migration-placement-lock NO)
	(up-set-timer c: t-opening-mill c: 15)
	(set-goal gl-opening-mill-state OPENING-MILL-IDLE)
)

(defrule
	(goal gl-opening-mill-state OPENING-MILL-CHECK-ALLY-TC)
	(not (up-set-target-object search-remote c: 0))
=>
	(set-goal gl-opening-mill-state OPENING-MILL-ADVANCE-ALLY)
)

(defrule
	(goal gl-opening-mill-state OPENING-MILL-ADVANCE-ALLY)
=>
	(up-find-next-player ally find-ordered gl-opening-mill-ally-player)
	(set-goal gl-opening-mill-state OPENING-MILL-NEXT-ALLY)
)

(defrule
	(goal gl-opening-mill-state OPENING-MILL-NEXT-ALLY)
	(up-compare-goal gl-opening-mill-ally-player g:!= gl-opening-mill-ally-first)
=>
	;The ally search producer is earlier. Yield with only the next player stored,
	;then rebuild that player's Town Center list in the next forward sweep.
	(up-modify-sn sn-focus-player-number g:= gl-opening-mill-focus)
	(set-goal gl-opening-mill-state OPENING-MILL-START-ALLY-CHECK)
)

(defrule
	(goal gl-opening-mill-state OPENING-MILL-NEXT-ALLY)
	(up-compare-goal gl-opening-mill-ally-player g:== gl-opening-mill-ally-first)
=>
	(set-strategic-number sn-focus-player-number 0)
	(up-full-reset-search)
	(up-set-target-point gl-opening-mill-target-x)
	(up-filter-distance c: -1 c: 8)
	(up-find-remote c: forage-class c: 20)
	(up-remove-objects search-remote object-data-map-zone-id g:!= gl-opening-mill-resource-zone)
	(up-get-search-state local-total)
	(set-goal gl-opening-mill-state OPENING-MILL-CHECK-RESOURCE)
)

(defrule
	(goal gl-opening-mill-state OPENING-MILL-CHECK-RESOURCE)
	(up-compare-goal remote-total c:>= 3)
=>
	(up-modify-goal gl-opening-mill-cluster-count g:= remote-total)
	(up-modify-sn sn-focus-player-number g:= gl-opening-mill-focus)
	(set-goal gl-opening-mill-placement-attempts 0)
	(set-goal gl-opening-mill-state OPENING-MILL-PLACE)
)

(defrule
	(goal gl-opening-mill-state OPENING-MILL-CHECK-RESOURCE)
	(up-compare-goal remote-total c:< 3)
=>
	(up-modify-goal gl-opening-mill-cluster-count g:= remote-total)
	(up-modify-goal gl-opening-mill-cluster-count c:max 1)
	;Distance ordering does not guarantee that one spatial cluster is contiguous.
	;Advance one known candidate at a time; the five-minute fallback bounds retries.
	(up-modify-goal gl-opening-mill-candidate-index c:+ 1)
	(up-chat-data-to-self "opening Mill rejected sparse forage: %d" g: remote-total)
	(up-modify-sn sn-focus-player-number g:= gl-opening-mill-focus)
	(set-goal gl-migration-placement-lock NO)
	(up-set-timer c: t-opening-mill c: 15)
	(set-goal gl-opening-mill-state OPENING-MILL-IDLE)
)

;Home defense, depletion, or an active rush may require farms and production
;before the unconditional five-minute discovery bound. This emergency fallback
;is still delayed until three minutes so the normal forage search gets priority.
(defrule
	(goal gl-opening-mill-state OPENING-MILL-FIND-RESOURCE)
	(not (up-set-target-object search-remote c: 0))
	(game-time >= 180)
	(or
		(goal gl-home-defense-state YES)
		(or
			(goal resources-depleted YES)
			(not (goal rush-rushing NO))
		)
	)
=>
	(set-goal gl-opening-mill-state OPENING-MILL-FALLBACK)
)

(defrule
	(goal gl-opening-mill-state OPENING-MILL-FIND-RESOURCE)
	(not (up-set-target-object search-remote c: 0))
	(game-time >= 300)
=>
	(set-goal gl-opening-mill-state OPENING-MILL-FALLBACK)
)

(defrule
	(goal gl-opening-mill-state OPENING-MILL-FIND-RESOURCE)
	(not (up-set-target-object search-remote c: 0))
	(game-time < 300)
=>
	(up-chat-data-to-self "opening Mill waiting for forage: %d" g: gl-opening-mill-candidate-index)
	(set-goal gl-opening-mill-candidate-index 0)
	(up-modify-sn sn-focus-player-number g:= gl-opening-mill-focus)
	(set-goal gl-migration-placement-lock NO)
	(up-set-timer c: t-opening-mill c: 20)
	(set-goal gl-opening-mill-state OPENING-MILL-IDLE)
)

(defrule
	(goal gl-opening-mill-state OPENING-MILL-FALLBACK)
=>
	(set-goal gl-opening-mill-candidate-index 0)
	(up-modify-sn sn-focus-player-number g:= gl-opening-mill-focus)
	(up-full-reset-search)
	(up-build place-normal 0 c: mill)
	(set-goal gl-opening-mill-requested YES)
	(chat-local-to-self "opening Mill fallback placement")
	(up-set-timer c: t-opening-mill c: 90)
	(set-goal gl-opening-mill-state OPENING-MILL-FALLBACK-WAIT)
)

(defrule
	(goal gl-opening-mill-state OPENING-MILL-FALLBACK-WAIT)
	(or
		(building-type-count-total mill > 0)
		(up-pending-objects c: mill > 0)
	)
=>
	(chat-local-to-self "opening Mill fallback accepted")
	(set-goal gl-migration-placement-lock NO)
	(set-goal gl-opening-mill-state OPENING-MILL-IDLE)
)

(defrule
	(goal gl-opening-mill-state OPENING-MILL-FALLBACK-WAIT)
	(building-type-count-total mill == 0)
	(up-pending-objects c: mill <= 0)
	(up-timer-status t-opening-mill == timer-triggered)
=>
	(up-reset-placement c: mill)
	(set-goal gl-opening-mill-requested NO)
	(set-goal gl-migration-placement-lock NO)
	(up-set-timer c: t-opening-mill c: 30)
	(set-goal gl-opening-mill-state OPENING-MILL-IDLE)
)

;Re-arm the owner if the accepted foundation fails or the completed opening Mill
;is later destroyed. A live Mill or foundation keeps the one-shot latch closed.
(defrule
	(goal gl-opening-mill-state OPENING-MILL-IDLE)
	(goal gl-opening-mill-requested YES)
	(building-type-count-total mill == 0)
	(up-pending-objects c: mill <= 0)
	(not (up-pending-placement c: mill))
	(up-timer-status t-opening-mill == timer-triggered)
=>
	(up-reset-placement c: mill)
	(set-goal gl-opening-mill-requested NO)
	(set-goal gl-migration-placement-lock NO)
	(up-set-timer c: t-opening-mill c: 30)
)

;Try four bounded diagonals around the exact forage object. A failed cluster
;advances one candidate at a time so another cluster cannot be skipped merely
;because home-distance sorting interleaves the two clusters.
(defrule
	(goal gl-opening-mill-state OPENING-MILL-PLACE)
	(goal gl-opening-mill-placement-attempts 0)
	(can-afford-building mill)
=>
	(up-copy-point point2-x gl-opening-mill-target-x)
	(up-modify-goal point2-x c:+ 4)
	(up-modify-goal point2-y c:+ 4)
	(up-bound-point point3-x point2-x)
	(up-set-target-point point3-x)
	(up-build place-point 0 c: mill)
	(set-goal gl-opening-mill-requested YES)
	(set-goal gl-opening-mill-placement-attempts 1)
	(up-set-timer c: t-opening-mill c: 30)
	(set-goal gl-opening-mill-state OPENING-MILL-WAIT)
)

(defrule
	(goal gl-opening-mill-state OPENING-MILL-PLACE)
	(goal gl-opening-mill-placement-attempts 1)
	(can-afford-building mill)
=>
	(up-copy-point point2-x gl-opening-mill-target-x)
	(up-modify-goal point2-x c:- 4)
	(up-modify-goal point2-y c:+ 4)
	(up-bound-point point3-x point2-x)
	(up-set-target-point point3-x)
	(up-build place-point 0 c: mill)
	(set-goal gl-opening-mill-requested YES)
	(set-goal gl-opening-mill-placement-attempts 2)
	(up-set-timer c: t-opening-mill c: 30)
	(set-goal gl-opening-mill-state OPENING-MILL-WAIT)
)

(defrule
	(goal gl-opening-mill-state OPENING-MILL-PLACE)
	(goal gl-opening-mill-placement-attempts 2)
	(can-afford-building mill)
=>
	(up-copy-point point2-x gl-opening-mill-target-x)
	(up-modify-goal point2-x c:+ 4)
	(up-modify-goal point2-y c:- 4)
	(up-bound-point point3-x point2-x)
	(up-set-target-point point3-x)
	(up-build place-point 0 c: mill)
	(set-goal gl-opening-mill-requested YES)
	(set-goal gl-opening-mill-placement-attempts 3)
	(up-set-timer c: t-opening-mill c: 30)
	(set-goal gl-opening-mill-state OPENING-MILL-WAIT)
)

(defrule
	(goal gl-opening-mill-state OPENING-MILL-PLACE)
	(goal gl-opening-mill-placement-attempts 3)
	(can-afford-building mill)
=>
	(up-copy-point point2-x gl-opening-mill-target-x)
	(up-modify-goal point2-x c:- 4)
	(up-modify-goal point2-y c:- 4)
	(up-bound-point point3-x point2-x)
	(up-set-target-point point3-x)
	(up-build place-point 0 c: mill)
	(set-goal gl-opening-mill-requested YES)
	(set-goal gl-opening-mill-placement-attempts 4)
	(up-set-timer c: t-opening-mill c: 30)
	(set-goal gl-opening-mill-state OPENING-MILL-WAIT)
)

(defrule
	(goal gl-opening-mill-state OPENING-MILL-PLACE)
	(not (can-afford-building mill))
=>
	(set-goal gl-opening-mill-requested NO)
	(up-modify-sn sn-focus-player-number g:= gl-opening-mill-focus)
	(set-goal gl-migration-placement-lock NO)
	(up-set-timer c: t-opening-mill c: 30)
	(set-goal gl-opening-mill-state OPENING-MILL-IDLE)
)

(defrule
	(goal gl-opening-mill-state OPENING-MILL-WAIT)
	(up-pending-objects c: mill >= 1)
=>
	(set-strategic-number sn-focus-player-number my-player-number)
	(up-full-reset-search)
	(up-set-target-point gl-opening-mill-target-x)
	(up-filter-distance c: -1 c: 10)
	(up-filter-status c: status-pending c: list-active)
	(up-find-status-local c: mill c: 10)
	(up-remove-objects search-local object-data-map-zone-id g:!= gl-opening-mill-resource-zone)
	(up-clean-search search-local object-data-distance search-order-asc)
	(set-goal gl-opening-mill-state OPENING-MILL-CHECK-FOUNDATION)
)

(defrule
	(goal gl-opening-mill-state OPENING-MILL-CHECK-FOUNDATION)
	(up-set-target-object search-local c: 0)
	(up-object-data object-data-distance <= 10)
	(up-object-data object-data-map-zone-id g:== gl-opening-mill-resource-zone)
=>
	(up-chat-data-to-self "opening Mill forage resource: %d" g: gl-opening-mill-resource-id)
	(up-chat-data-to-self "opening Mill forage zone: %d" g: gl-opening-mill-resource-zone)
	(set-goal gl-opening-mill-candidate-index 0)
	(set-goal gl-opening-mill-placement-attempts 0)
	(up-modify-sn sn-focus-player-number g:= gl-opening-mill-focus)
	(set-goal gl-migration-placement-lock NO)
	(up-set-timer c: t-opening-mill c: 90)
	(set-goal gl-opening-mill-state OPENING-MILL-IDLE)
)

(defrule
	(goal gl-opening-mill-state OPENING-MILL-CHECK-FOUNDATION)
	(not (up-set-target-object search-local c: 0))
	(up-compare-goal gl-opening-mill-placement-attempts c:< 4)
=>
	(up-reset-placement c: mill)
	(set-goal gl-opening-mill-requested NO)
	(up-modify-sn sn-focus-player-number g:= gl-opening-mill-focus)
	(set-goal gl-opening-mill-state OPENING-MILL-PLACE)
)

(defrule
	(goal gl-opening-mill-state OPENING-MILL-CHECK-FOUNDATION)
	(not (up-set-target-object search-local c: 0))
	(up-compare-goal gl-opening-mill-placement-attempts c:>= 4)
=>
	(set-goal gl-opening-mill-state OPENING-MILL-REJECT-CANDIDATE)
)

;The tiny foundation may complete before a WAIT sweep sees it pending. Resolve
;and accept a ready same-zone Mill without ever deleting a completed structure.
(defrule
	(goal gl-opening-mill-state OPENING-MILL-WAIT)
	(up-timer-status t-opening-mill == timer-triggered)
	(up-pending-objects c: mill <= 0)
	(building-type-count-total mill >= 1)
=>
	(set-strategic-number sn-focus-player-number my-player-number)
	(up-full-reset-search)
	(up-set-target-point gl-opening-mill-target-x)
	(up-filter-distance c: -1 c: 10)
	(up-filter-status c: status-ready c: list-active)
	(up-find-local c: mill c: 10)
	(up-remove-objects search-local object-data-map-zone-id g:!= gl-opening-mill-resource-zone)
	(up-clean-search search-local object-data-distance search-order-asc)
	(set-goal gl-opening-mill-state OPENING-MILL-FIND-COMPLETED)
)

(defrule
	(goal gl-opening-mill-state OPENING-MILL-FIND-COMPLETED)
	(up-set-target-object search-local c: 0)
=>
	(up-chat-data-to-self "opening Mill completed at forage: %d" g: gl-opening-mill-resource-id)
	(set-goal gl-opening-mill-candidate-index 0)
	(set-goal gl-opening-mill-placement-attempts 0)
	(up-modify-sn sn-focus-player-number g:= gl-opening-mill-focus)
	(set-goal gl-migration-placement-lock NO)
	(up-set-timer c: t-opening-mill c: 90)
	(set-goal gl-opening-mill-state OPENING-MILL-IDLE)
)

(defrule
	(goal gl-opening-mill-state OPENING-MILL-FIND-COMPLETED)
	(not (up-set-target-object search-local c: 0))
=>
	(set-goal gl-opening-mill-state OPENING-MILL-REJECT-CANDIDATE)
)

(defrule
	(goal gl-opening-mill-state OPENING-MILL-WAIT)
	(up-timer-status t-opening-mill == timer-triggered)
	(up-pending-objects c: mill <= 0)
	(building-type-count-total mill == 0)
	(up-compare-goal gl-opening-mill-placement-attempts c:< 4)
=>
	(up-reset-placement c: mill)
	(set-goal gl-opening-mill-requested NO)
	(up-modify-sn sn-focus-player-number g:= gl-opening-mill-focus)
	(set-goal gl-opening-mill-state OPENING-MILL-PLACE)
)

(defrule
	(goal gl-opening-mill-state OPENING-MILL-WAIT)
	(up-timer-status t-opening-mill == timer-triggered)
	(up-pending-objects c: mill <= 0)
	(building-type-count-total mill == 0)
	(up-compare-goal gl-opening-mill-placement-attempts c:>= 4)
=>
	(set-goal gl-opening-mill-state OPENING-MILL-REJECT-CANDIDATE)
)

(defrule
	(goal gl-opening-mill-state OPENING-MILL-REJECT-CANDIDATE)
=>
	(up-reset-placement c: mill)
	(up-modify-goal gl-opening-mill-candidate-index c:+ 1)
	(up-chat-data-to-self "opening Mill rejected blocked forage: %d" g: gl-opening-mill-resource-id)
	(set-goal gl-opening-mill-requested NO)
	(set-goal gl-opening-mill-placement-attempts 0)
	(up-modify-sn sn-focus-player-number g:= gl-opening-mill-focus)
	(set-goal gl-migration-placement-lock NO)
	(up-set-timer c: t-opening-mill c: 15)
	(set-goal gl-opening-mill-state OPENING-MILL-IDLE)
)

;As with the first Lumber Camp, the first Mining Camp must not require a miner
;who is already extracting without a dropoff. Bootstrap from an exact visible
;active-home mine; later expansions remain owned by active gatherers.
(defrule
	(up-timer-status t-miningcamp-placement == timer-triggered)
	(goal gl-miningcamp-placement-state PLACEMENT-IDLE)
	(goal gl-island-migration-state MIGRATION-IDLE)
	(goal gl-miningcamp-next-resource gold)
	(current-age >= early-antiquity-age)
	(building-type-count-total mining-camp == 0)
	(up-compare-goal desired-number-miningcamps c:>= 1)
	(up-compare-goal gl-home-zone c:>= 0)
	(building-type-count-total lumber-camp >= 1)
	(up-pending-objects c: mining-camp <= 0)
	(not (up-pending-placement c: mining-camp))
	(strategic-number sn-gold-gatherer-percentage >= 1)
	(can-afford-building mining-camp)
=>
	(up-modify-goal gl-miningcamp-placement-focus s:= sn-focus-player-number)
	(set-strategic-number sn-focus-player-number 0)
	(up-full-reset-search)
	(up-set-target-point gl-home-anchor-x)
	(up-filter-distance c: -1 c: 60)
	(up-find-remote c: gold-mine-class c: 40)
	(up-remove-objects search-remote object-data-type != 66)
	(up-remove-objects search-remote object-data-map-zone-id g:!= gl-home-zone)
	(up-remove-objects search-remote object-data-id g:== gl-miningcamp-rejected-resource-id)
	(up-remove-objects search-remote object-data-id g:== gl-miningcamp-rejected-resource-id2)
	(up-remove-objects search-remote object-data-id g:== gl-miningcamp-rejected-resource-id3)
	(up-clean-search search-remote object-data-distance search-order-asc)
	(set-goal gl-miningcamp-resource-type gold)
	(set-goal gl-miningcamp-next-resource stone)
	(set-goal gl-miningcamp-placement-attempts 0)
	(up-set-timer c: t-miningcamp-placement c: 60)
	(set-goal gl-miningcamp-placement-state PLACEMENT-FIND-RESOURCE)
)

(defrule
	(up-timer-status t-miningcamp-placement == timer-triggered)
	(goal gl-miningcamp-placement-state PLACEMENT-IDLE)
	(goal gl-island-migration-state MIGRATION-IDLE)
	(goal gl-miningcamp-next-resource stone)
	(current-age >= early-antiquity-age)
	(building-type-count-total mining-camp == 0)
	(up-compare-goal desired-number-miningcamps c:>= 1)
	(up-compare-goal gl-home-zone c:>= 0)
	(building-type-count-total lumber-camp >= 1)
	(up-pending-objects c: mining-camp <= 0)
	(not (up-pending-placement c: mining-camp))
	(strategic-number sn-stone-gatherer-percentage >= 1)
	(can-afford-building mining-camp)
=>
	(up-modify-goal gl-miningcamp-placement-focus s:= sn-focus-player-number)
	(set-strategic-number sn-focus-player-number 0)
	(up-full-reset-search)
	(up-set-target-point gl-home-anchor-x)
	(up-filter-distance c: -1 c: 60)
	(up-find-remote c: stone-mine-class c: 40)
	(up-remove-objects search-remote object-data-type != 102)
	(up-remove-objects search-remote object-data-map-zone-id g:!= gl-home-zone)
	(up-remove-objects search-remote object-data-id g:== gl-miningcamp-rejected-resource-id)
	(up-remove-objects search-remote object-data-id g:== gl-miningcamp-rejected-resource-id2)
	(up-remove-objects search-remote object-data-id g:== gl-miningcamp-rejected-resource-id3)
	(up-clean-search search-remote object-data-distance search-order-asc)
	(set-goal gl-miningcamp-resource-type stone)
	(set-goal gl-miningcamp-next-resource gold)
	(set-goal gl-miningcamp-placement-attempts 0)
	(up-set-timer c: t-miningcamp-placement c: 60)
	(set-goal gl-miningcamp-placement-state PLACEMENT-FIND-RESOURCE)
)

;After bootstrap, alternate the active gold and stone searches so one configured
;gather percentage cannot starve the other, then reject already-served targets.
(defrule
	(up-timer-status t-miningcamp-placement == timer-triggered)
	(goal gl-miningcamp-placement-state PLACEMENT-IDLE)
	(goal gl-island-migration-state MIGRATION-IDLE)
	(goal gl-miningcamp-next-resource gold)
	(current-age >= early-antiquity-age)
	(building-type-count-total mining-camp >= 1)
	(building-type-count-total mining-camp g:< desired-number-miningcamps)
	(building-type-count-total lumber-camp >= 1)
	(up-pending-objects c: mining-camp <= 0)
	(not (up-pending-placement c: mining-camp))
	(strategic-number sn-gold-gatherer-percentage >= 1)
	(can-afford-building mining-camp)
=>
	(up-modify-goal gl-miningcamp-placement-focus s:= sn-focus-player-number)
	(set-strategic-number sn-focus-player-number my-player-number)
	(up-full-reset-search)
	(up-set-target-point position-self-x)
	(up-find-local c: villager-class c: 40)
	(up-remove-objects search-local object-data-gather-type != gold)
	(up-remove-objects search-local object-data-action != actionid-gather)
	(up-remove-objects search-local object-data-target-id == -1)
	(up-clean-search search-local object-data-distance search-order-desc)
	(set-goal gl-miningcamp-resource-type gold)
	(set-goal gl-miningcamp-next-resource stone)
	(set-goal gl-miningcamp-placement-attempts 0)
	(up-set-timer c: t-miningcamp-placement c: 60)
	(set-goal gl-miningcamp-placement-state PLACEMENT-ASSESS)
)

(defrule
	(up-timer-status t-miningcamp-placement == timer-triggered)
	(goal gl-miningcamp-placement-state PLACEMENT-IDLE)
	(goal gl-island-migration-state MIGRATION-IDLE)
	(goal gl-miningcamp-next-resource stone)
	(current-age >= early-antiquity-age)
	(building-type-count-total mining-camp >= 1)
	(building-type-count-total mining-camp g:< desired-number-miningcamps)
	(building-type-count-total lumber-camp >= 1)
	(up-pending-objects c: mining-camp <= 0)
	(not (up-pending-placement c: mining-camp))
	(strategic-number sn-stone-gatherer-percentage >= 1)
	(can-afford-building mining-camp)
=>
	(up-modify-goal gl-miningcamp-placement-focus s:= sn-focus-player-number)
	(set-strategic-number sn-focus-player-number my-player-number)
	(up-full-reset-search)
	(up-set-target-point position-self-x)
	(up-find-local c: villager-class c: 40)
	(up-remove-objects search-local object-data-gather-type != stone)
	(up-remove-objects search-local object-data-action != actionid-gather)
	(up-remove-objects search-local object-data-target-id == -1)
	(up-clean-search search-local object-data-distance search-order-desc)
	(set-goal gl-miningcamp-resource-type stone)
	(set-goal gl-miningcamp-next-resource gold)
	(set-goal gl-miningcamp-placement-attempts 0)
	(up-set-timer c: t-miningcamp-placement c: 60)
	(set-goal gl-miningcamp-placement-state PLACEMENT-ASSESS)
)

;If the preferred resource is unavailable, immediately give the other search a
;turn instead of leaving the placement timer pinned to an impossible branch.
(defrule
	(up-timer-status t-miningcamp-placement == timer-triggered)
	(goal gl-miningcamp-placement-state PLACEMENT-IDLE)
	(goal gl-miningcamp-next-resource gold)
	(or
		(goal gold-present NO)
		(strategic-number sn-gold-gatherer-percentage < 1)
	)
=>
	(set-goal gl-miningcamp-next-resource stone)
)

(defrule
	(up-timer-status t-miningcamp-placement == timer-triggered)
	(goal gl-miningcamp-placement-state PLACEMENT-IDLE)
	(goal gl-miningcamp-next-resource stone)
	(or
		(goal stone-present NO)
		(strategic-number sn-stone-gatherer-percentage < 1)
	)
=>
	(set-goal gl-miningcamp-next-resource gold)
	(up-set-timer c: t-miningcamp-placement c: 10)
)

(defrule
	(goal gl-miningcamp-placement-state PLACEMENT-ASSESS)
	(up-set-target-object search-local c: 0)
=>
	(up-get-point position-object gl-miningcamp-target-x)
	(up-get-object-data object-data-target-id gl-miningcamp-resource-id)
	(set-strategic-number sn-focus-player-number 0)
	(up-full-reset-search)
	(up-add-object-by-id search-remote g: gl-miningcamp-resource-id)
	(set-goal gl-miningcamp-placement-state PLACEMENT-FIND-RESOURCE)
)

(defrule
	(goal gl-miningcamp-placement-state PLACEMENT-ASSESS)
	(not (up-set-target-object search-local c: 0))
=>
	(up-modify-sn sn-focus-player-number g:= gl-miningcamp-placement-focus)
	(up-set-timer c: t-miningcamp-placement c: 10)
	(set-goal gl-miningcamp-placement-state PLACEMENT-IDLE)
)

;Rebuild and consume the exact mine search in this same forward rule sweep.
;No DUC list or Gaia focus is allowed to survive a backward state transition.
(defrule
	(goal gl-miningcamp-placement-state PLACEMENT-WAIT)
	(up-timer-status t-miningcamp-placement == timer-triggered)
	(up-pending-objects c: mining-camp <= 0)
	(up-compare-goal gl-miningcamp-placement-attempts c:< 4)
=>
	(up-reset-placement c: mining-camp)
	(set-strategic-number sn-focus-player-number 0)
	(up-full-reset-search)
	(up-add-object-by-id search-remote g: gl-miningcamp-resource-id)
	(up-set-timer c: t-miningcamp-placement c: 30)
	(set-goal gl-miningcamp-placement-state PLACEMENT-FIND-RESOURCE)
)

(defrule
	(goal gl-miningcamp-placement-state PLACEMENT-FIND-RESOURCE)
	(up-set-target-object search-remote c: 0)
	(or
		(and
			(goal gl-miningcamp-resource-type gold)
			(up-object-data object-data-type == 66)
		)
		(and
			(goal gl-miningcamp-resource-type stone)
			(up-object-data object-data-type == 102)
		)
	)
=>
	;Only a matching mine target can own this placement. A miner temporarily
	;attacking a Gaia animal must not redirect a Mining Camp.
	(up-get-object-data object-data-id gl-miningcamp-resource-id)
	(up-get-point position-object gl-miningcamp-target-x)
	(up-get-object-data object-data-map-zone-id gl-miningcamp-resource-zone)
	(set-strategic-number sn-focus-player-number my-player-number)
	(up-full-reset-search)
	(up-set-target-point gl-miningcamp-target-x)
	(up-find-remote c: mining-camp c: 20)
	(up-remove-objects search-remote object-data-map-zone-id g:!= gl-miningcamp-resource-zone)
	(up-clean-search search-remote object-data-distance search-order-asc)
	(up-modify-sn sn-focus-player-number g:= gl-miningcamp-placement-focus)
	(set-goal gl-miningcamp-placement-state PLACEMENT-FIND-CAMP)
)

(defrule
	(goal gl-miningcamp-placement-state PLACEMENT-FIND-RESOURCE)
	(up-set-target-object search-remote c: 0)
	(or
		(and
			(goal gl-miningcamp-resource-type gold)
			(up-object-data object-data-type != 66)
		)
		(and
			(goal gl-miningcamp-resource-type stone)
			(up-object-data object-data-type != 102)
		)
	)
=>
	(up-modify-sn sn-focus-player-number g:= gl-miningcamp-placement-focus)
	(up-set-timer c: t-miningcamp-placement c: 10)
	(set-goal gl-miningcamp-placement-state PLACEMENT-IDLE)
)

(defrule
	(goal gl-miningcamp-placement-state PLACEMENT-FIND-RESOURCE)
	(not (up-set-target-object search-remote c: 0))
=>
	;Release bounded rejection memory after an exhausted candidate search. This
	;lets a sole mine recover after a temporary placement obstruction clears.
	(set-goal gl-miningcamp-rejected-resource-id -1)
	(set-goal gl-miningcamp-rejected-resource-id2 -1)
	(set-goal gl-miningcamp-rejected-resource-id3 -1)
	(up-modify-sn sn-focus-player-number g:= gl-miningcamp-placement-focus)
	(up-set-timer c: t-miningcamp-placement c: 10)
	(set-goal gl-miningcamp-placement-state PLACEMENT-IDLE)
)

(defrule
	(goal gl-miningcamp-placement-state PLACEMENT-FIND-CAMP)
	(up-set-target-object search-remote c: 0)
	(up-object-data object-data-distance <= 10)
=>
	(up-set-timer c: t-miningcamp-placement c: 60)
	(set-goal gl-miningcamp-placement-state PLACEMENT-IDLE)
)

(defrule
	(goal gl-miningcamp-placement-state PLACEMENT-FIND-CAMP)
	(up-set-target-object search-remote c: 0)
	(up-object-data object-data-distance > 10)
=>
	(set-goal gl-miningcamp-placement-state PLACEMENT-PLACE)
)

(defrule
	(goal gl-miningcamp-placement-state PLACEMENT-FIND-CAMP)
	(not (up-set-target-object search-remote c: 0))
=>
	(set-goal gl-miningcamp-placement-state PLACEMENT-PLACE)
)

;Try four bounded diagonals around the resource target. Retain state ownership
;until a foundation exists or every offset has failed.
(defrule
	(goal gl-miningcamp-placement-state PLACEMENT-PLACE)
	(goal gl-miningcamp-placement-attempts 0)
	(can-afford-building mining-camp)
=>
	(up-copy-point point2-x gl-miningcamp-target-x)
	(up-modify-goal point2-x c:+ 3)
	(up-modify-goal point2-y c:+ 3)
	(up-bound-point point3-x point2-x)
	(up-set-target-point point3-x)
	(up-build place-point 0 c: mining-camp)
	(set-goal gl-miningcamp-placement-attempts 1)
	(up-set-timer c: t-miningcamp-placement c: 30)
	(set-goal gl-miningcamp-placement-state PLACEMENT-WAIT)
)

(defrule
	(goal gl-miningcamp-placement-state PLACEMENT-PLACE)
	(goal gl-miningcamp-placement-attempts 1)
	(can-afford-building mining-camp)
=>
	(up-copy-point point2-x gl-miningcamp-target-x)
	(up-modify-goal point2-x c:- 3)
	(up-modify-goal point2-y c:+ 3)
	(up-bound-point point3-x point2-x)
	(up-set-target-point point3-x)
	(up-build place-point 0 c: mining-camp)
	(set-goal gl-miningcamp-placement-attempts 2)
	(up-set-timer c: t-miningcamp-placement c: 30)
	(set-goal gl-miningcamp-placement-state PLACEMENT-WAIT)
)

(defrule
	(goal gl-miningcamp-placement-state PLACEMENT-PLACE)
	(goal gl-miningcamp-placement-attempts 2)
	(can-afford-building mining-camp)
=>
	(up-copy-point point2-x gl-miningcamp-target-x)
	(up-modify-goal point2-x c:+ 3)
	(up-modify-goal point2-y c:- 3)
	(up-bound-point point3-x point2-x)
	(up-set-target-point point3-x)
	(up-build place-point 0 c: mining-camp)
	(set-goal gl-miningcamp-placement-attempts 3)
	(up-set-timer c: t-miningcamp-placement c: 30)
	(set-goal gl-miningcamp-placement-state PLACEMENT-WAIT)
)

(defrule
	(goal gl-miningcamp-placement-state PLACEMENT-PLACE)
	(goal gl-miningcamp-placement-attempts 3)
	(can-afford-building mining-camp)
=>
	(up-copy-point point2-x gl-miningcamp-target-x)
	(up-modify-goal point2-x c:- 3)
	(up-modify-goal point2-y c:- 3)
	(up-bound-point point3-x point2-x)
	(up-set-target-point point3-x)
	(up-build place-point 0 c: mining-camp)
	(set-goal gl-miningcamp-placement-attempts 4)
	(up-set-timer c: t-miningcamp-placement c: 30)
	(set-goal gl-miningcamp-placement-state PLACEMENT-WAIT)
)

(defrule
	(goal gl-miningcamp-placement-state PLACEMENT-PLACE)
	(not (can-afford-building mining-camp))
=>
	(up-modify-sn sn-focus-player-number g:= gl-miningcamp-placement-focus)
	(set-goal gl-miningcamp-placement-attempts 0)
	(up-set-timer c: t-miningcamp-placement c: 30)
	(set-goal gl-miningcamp-placement-state PLACEMENT-IDLE)
)

(defrule
	(goal gl-miningcamp-placement-state PLACEMENT-WAIT)
	(up-pending-objects c: mining-camp >= 1)
=>
	(set-strategic-number sn-focus-player-number my-player-number)
	(up-full-reset-search)
	(up-set-target-point gl-miningcamp-target-x)
	(up-filter-distance c: -1 c: 8)
	(up-filter-status c: status-pending c: list-active)
	(up-find-status-local c: mining-camp c: 8)
	(up-clean-search search-local object-data-distance search-order-asc)
	(set-goal gl-miningcamp-placement-state PLACEMENT-CHECK-FOUNDATION)
)

(defrule
	(goal gl-miningcamp-placement-state PLACEMENT-CHECK-FOUNDATION)
	(up-set-target-object search-local c: 0)
	(up-object-data object-data-distance <= 8)
	(up-object-data object-data-map-zone-id g:== gl-miningcamp-resource-zone)
=>
	(up-get-object-data object-data-id gl-miningcamp-foundation-id)
	(set-strategic-number sn-focus-player-number 0)
	(up-full-reset-search)
	(up-add-object-by-id search-remote g: gl-miningcamp-resource-id)
	(set-goal gl-miningcamp-placement-state PLACEMENT-VALIDATE-FOUNDATION-RESOURCE)
)

(defrule
	(goal gl-miningcamp-placement-state PLACEMENT-CHECK-FOUNDATION)
	(up-set-target-object search-local c: 0)
	(up-object-data object-data-distance <= 8)
	(up-object-data object-data-map-zone-id g:!= gl-miningcamp-resource-zone)
=>
	(up-get-object-data object-data-id gl-miningcamp-foundation-id)
	(up-target-point 0 action-delete -1 -1)
	(up-reset-placement c: mining-camp)
	(up-chat-data-to-self "mining camp deleted wrong-zone foundation: %d" g: gl-miningcamp-foundation-id)
	(up-modify-sn sn-focus-player-number g:= gl-miningcamp-placement-focus)
	(up-set-timer c: t-miningcamp-placement c: 30)
	(set-goal gl-miningcamp-placement-state PLACEMENT-IDLE)
)

(defrule
	(goal gl-miningcamp-placement-state PLACEMENT-CHECK-FOUNDATION)
	(not (up-set-target-object search-local c: 0))
=>
	(up-reset-placement c: mining-camp)
	(up-chat-data-to-self "mining camp rejected unrelated foundation: %d" g: gl-miningcamp-resource-zone)
	(up-modify-sn sn-focus-player-number g:= gl-miningcamp-placement-focus)
	(up-set-timer c: t-miningcamp-placement c: 30)
	(set-goal gl-miningcamp-placement-state PLACEMENT-IDLE)
)

(defrule
	(goal gl-miningcamp-placement-state PLACEMENT-VALIDATE-FOUNDATION-RESOURCE)
	(up-set-target-object search-remote c: 0)
	(up-object-data object-data-map-zone-id g:== gl-miningcamp-resource-zone)
	(or
		(and
			(goal gl-miningcamp-resource-type gold)
			(up-object-data object-data-type == 66)
		)
		(and
			(goal gl-miningcamp-resource-type stone)
			(up-object-data object-data-type == 102)
		)
	)
=>
	(up-chat-data-to-self "mining camp resource zone: %d" g: gl-miningcamp-resource-zone)
	(up-modify-sn sn-focus-player-number g:= gl-miningcamp-placement-focus)
	(set-goal gl-miningcamp-placement-attempts 0)
	(up-set-timer c: t-miningcamp-placement c: 120)
	(set-goal gl-miningcamp-placement-state PLACEMENT-IDLE)
)

;If the exact mine disappeared before the matching same-zone foundation was
;accepted, remove that now-useless foundation instead of satisfying a quota.
(defrule
	(goal gl-miningcamp-placement-state PLACEMENT-VALIDATE-FOUNDATION-RESOURCE)
	(or
		(not (up-set-target-object search-remote c: 0))
		(or
			(up-object-data object-data-map-zone-id g:!= gl-miningcamp-resource-zone)
			(or
				(and
					(goal gl-miningcamp-resource-type gold)
					(up-object-data object-data-type != 66)
				)
				(and
					(goal gl-miningcamp-resource-type stone)
					(up-object-data object-data-type != 102)
				)
			)
		)
	)
=>
	(set-strategic-number sn-focus-player-number my-player-number)
	(up-full-reset-search)
	(up-add-object-by-id search-local g: gl-miningcamp-foundation-id)
	(up-set-target-object search-local c: 0)
	(up-target-point 0 action-delete -1 -1)
	(up-reset-placement c: mining-camp)
	(up-chat-data-to-self "mining camp deleted stale resource foundation: %d" g: gl-miningcamp-foundation-id)
	(up-modify-sn sn-focus-player-number g:= gl-miningcamp-placement-focus)
	(set-goal gl-miningcamp-placement-attempts 0)
	(up-set-timer c: t-miningcamp-placement c: 60)
	(set-goal gl-miningcamp-placement-state PLACEMENT-IDLE)
)

(defrule
	(goal gl-miningcamp-placement-state PLACEMENT-WAIT)
	(up-timer-status t-miningcamp-placement == timer-triggered)
	(up-pending-objects c: mining-camp <= 0)
	(up-compare-goal gl-miningcamp-placement-attempts c:>= 4)
=>
	(up-reset-placement c: mining-camp)
	(up-modify-goal gl-miningcamp-rejected-resource-id3 g:= gl-miningcamp-rejected-resource-id2)
	(up-modify-goal gl-miningcamp-rejected-resource-id2 g:= gl-miningcamp-rejected-resource-id)
	(up-modify-goal gl-miningcamp-rejected-resource-id g:= gl-miningcamp-resource-id)
	(up-chat-data-to-self "mining camp exhausted offsets at resource: %d" g: gl-miningcamp-resource-id)
	(up-modify-sn sn-focus-player-number g:= gl-miningcamp-placement-focus)
	(set-goal gl-miningcamp-placement-attempts 0)
	(up-set-timer c: t-miningcamp-placement c: 180)
	(set-goal gl-miningcamp-placement-state PLACEMENT-IDLE)
)

(defrule
	(up-timer-status t-miningcamp-placement == timer-triggered)
	(or
		(goal gl-miningcamp-placement-state PLACEMENT-ASSESS)
		(goal gl-miningcamp-placement-state PLACEMENT-FIND-RESOURCE)
	)
=>
	(up-reset-placement c: mining-camp)
	(up-modify-sn sn-focus-player-number g:= gl-miningcamp-placement-focus)
	(set-goal gl-miningcamp-placement-attempts 0)
	(up-set-timer c: t-miningcamp-placement c: 60)
	(set-goal gl-miningcamp-placement-state PLACEMENT-IDLE)
)

(defrule
	(up-timer-status t-miningcamp-placement == timer-triggered)
	(or
		(goal gl-miningcamp-placement-state PLACEMENT-FIND-CAMP)
		(or
			(goal gl-miningcamp-placement-state PLACEMENT-PLACE)
			(or
				(goal gl-miningcamp-placement-state PLACEMENT-WAIT)
				(or
					(goal gl-miningcamp-placement-state PLACEMENT-CHECK-FOUNDATION)
					(goal gl-miningcamp-placement-state PLACEMENT-VALIDATE-FOUNDATION-RESOURCE)
				)
			)
		)
	)
=>
	(up-reset-placement c: mining-camp)
	(up-modify-sn sn-focus-player-number g:= gl-miningcamp-placement-focus)
	(set-goal gl-miningcamp-placement-attempts 0)
	(up-set-timer c: t-miningcamp-placement c: 60)
	(set-goal gl-miningcamp-placement-state PLACEMENT-IDLE)
)

(defrule
	(goal gl-opening-drop-sites-ready NO)
	(game-time >= 180)
	(building-type-count lumber-camp >= 1)
	(building-type-count mill >= 1)
	(up-pending-objects c: lumber-camp <= 0)
	(up-pending-objects c: mill <= 0)
	(not (up-pending-placement c: lumber-camp))
	(not (up-pending-placement c: mill))
=>
	;Use a persistent readiness latch so queued-building count semantics cannot
	;release an opening Barracks in the first rules pass.
	(set-goal gl-opening-drop-sites-ready YES)
)

(defrule
	(can-afford-building barracks)
	(goal wait-techup-requirements NO)
	(goal gl-opening-drop-sites-ready YES)
	(building-type-count-total barracks g:< desired-number-barracks)
	;Non-total counts exclude queued buildings, and pending checks keep a live
	;foundation from satisfying the prerequisite.
	(building-type-count lumber-camp >= 1)
	(building-type-count mill >= 1)
	(up-pending-objects c: lumber-camp <= 0)
	(up-pending-objects c: mill <= 0)
	(or
		(current-age < middle-antiquity-age)
		(or
			(building-type-count town-center >= 2)
			(or
				(goal gl-home-defense-state YES)
				(goal rush-rushing YES)
			)
		)
	)
	(up-can-build 0 c: barracks)
=>
	(up-build place-normal 0 c: barracks))

;A player whose last army and Barracks were destroyed has no responder with
;which to raise gl-home-defense-state. Rebuild the foundational producer even
;while age-up escrow is active; this rule is threat-gated and cannot restore the
;old opening Barracks regression.
(defrule
	(current-age >= early-antiquity-age)
	(goal gl-local-threat-active YES)
	(building-type-count-total barracks < 1)
	(up-pending-objects c: barracks <= 0)
	(not (up-pending-placement c: barracks))
	(can-afford-building barracks)
	(up-can-build 0 c: barracks)
=>
	(up-build place-normal 0 c: barracks)
	(chat-local-to-self "Emergency Barracks requested after local attack")
)

(defrule
	(goal gl-placement-pressure-state PLACEMENT-PRESSURE-IDLE)
	(up-compare-goal gl-game-time g:>= gl-placement-pressure-next)
	(goal gl-local-threat-active YES)
	(building-type-count-total barracks < 1)
	(up-pending-objects c: barracks <= 0)
	(not (up-pending-placement c: barracks))
	(can-afford-building barracks)
	(not (up-can-build 0 c: barracks))
=>
	(set-goal gl-placement-pressure-category PLACEMENT-KIND-MILITARY)
	(set-goal gl-placement-pressure-state PLACEMENT-PRESSURE-EXPAND)
)

(defrule
	(current-age >= early-antiquity-age)
	(goal wait-techup-requirements NO)
	(can-afford-building archery-range)
	(building-type-count-total barracks > 0)
	(building-type-count-total archery-range g:< desired-number-ranges)
	(or
		(current-age < middle-antiquity-age)
		(or
			(building-type-count town-center >= 2)
			(or
				(goal gl-home-defense-state YES)
				(goal rush-rushing YES)
			)
		)
	)
	(up-can-build 0 c: archery-range)
=>
	(up-build place-normal 0 c: archery-range))

(defrule
	(current-age >= early-antiquity-age)
	(goal wait-techup-requirements NO)
	(can-afford-building stable)
	(building-type-count-total barracks > 0)
	(building-type-count-total stable g:< desired-number-stables)
	(or
		(current-age < middle-antiquity-age)
		(or
			(building-type-count town-center >= 2)
			(or
				(goal gl-home-defense-state YES)
				(goal rush-rushing YES)
			)
		)
	)
	(up-can-build 0 c: stable)
=>
	(up-build place-normal 0 c: stable))

(defrule
	(current-age >= middle-antiquity-age)
	(goal wait-techup-requirements NO)
	(can-afford-building siege-workshop)
	(building-type-count-total siege-workshop g:< desired-number-workshops)
	(or
		(building-type-count town-center >= 2)
		(or
			(goal gl-home-defense-state YES)
			(goal rush-rushing YES)
		)
	)
	(up-can-build 0 c: siege-workshop)
=>
	(up-build place-normal 0 c: siege-workshop))

(defrule
	(current-age >= early-antiquity-age)
	(can-afford-building blacksmith)
	(building-type-count-total blacksmith g:< desired-number-blacksmiths)
	(or
		(current-age < middle-antiquity-age)
		(or
			(building-type-count town-center >= 2)
			(goal gl-home-defense-state YES)
		)
	)
	(up-can-build 0 c: blacksmith)
=>
	(up-build place-normal 0 c: blacksmith)
)

(defrule
	(current-age >= early-antiquity-age)
	(building-type-count-total market g:< desired-number-markets)
	(up-pending-objects c: market <= 0)
	(up-pending-placement c: market)
	(up-timer-status t-market-placement == timer-triggered)
=>
	;A managed placement can remain pending without ever creating a foundation.
	;Release it and count the expired attempt so the fallback remains reachable.
	(up-reset-placement c: market)
	(up-modify-goal gl-market-placement-attempts c:+ 1)
)

(defrule
	(or
		(current-age == early-antiquity-age)
		(and
			(current-age == middle-antiquity-age)
			(or
				(building-type-count town-center >= 2)
				(or
					(goal gl-home-defense-state YES)
					(goal rush-rushing YES)
				)
			)
		)
	)
	(goal gl-migration-placement-lock NO)
	(can-afford-building market)
	(building-type-count-total market == 0)
	(up-pending-objects c: market <= 0)
	(not (up-pending-placement c: market))
	(up-timer-status t-market-placement != timer-running)
	(up-compare-goal gl-market-placement-attempts c:< 3)
	(up-can-build 0 c: market)
=>
	(up-build place-normal 0 c: market)
	(up-modify-goal gl-market-placement-attempts c:+ 1)
	(up-set-timer c: t-market-placement c: 30)
)

;After three normal failures, clear the managed placement and retry from a
;positive town radius. This cannot issue thousands of identical commands.
(defrule
	(current-age >= early-antiquity-age)
	(goal gl-migration-placement-lock NO)
	(or
		(current-age != middle-antiquity-age)
		(or
			(building-type-count town-center >= 2)
			(or
				(goal gl-home-defense-state YES)
				(goal rush-rushing YES)
			)
		)
	)
	(building-type-count-total market g:< desired-number-markets)
	(up-pending-objects c: market <= 0)
	(up-timer-status t-market-placement != timer-running)
	(up-compare-goal gl-market-placement-attempts c:>= 3)
	(up-can-build 0 c: market)
=>
	(up-reset-placement c: market)
	(up-set-placement-data my-player-number -1 c: 12)
	(up-build place-control 0 c: market)
	(set-goal gl-market-placement-attempts 0)
	(up-set-timer c: t-market-placement c: 180)
)

(defrule
	(building-type-count-total market g:>= desired-number-markets)
	(up-compare-goal gl-market-placement-attempts c:> 0)
=>
	(set-goal gl-market-placement-attempts 0)
)

(defrule
	(current-age == imperial-age)
	(goal gl-migration-placement-lock NO)
	(can-afford-building market)
	(building-type-count-total market g:< desired-number-markets)
	(up-pending-objects c: market <= 0)
	(not (up-pending-placement c: market))
	(up-timer-status t-market-placement != timer-running)
	(up-compare-goal gl-market-placement-attempts c:< 3)
	(up-can-build 0 c: market)
=>
	(up-build place-normal 0 c: market)
	(up-modify-goal gl-market-placement-attempts c:+ 1)
	(up-set-timer c: t-market-placement c: 30)
)

(defrule
	(can-afford-building dock)
	(goal wait-techup-requirements NO)
	(or
		(goal map-type LAKE)
		(or
			(goal map-type RIVERS)
			(or
				(goal map-type ISLANDS)
				(goal map-type TEAM-ISLANDS)
			)
		)
	)
	(building-type-count-total dock g:< desired-number-docks)
	(building-type-count-total lumber-camp >= 1)
	(up-can-build 0 c: dock)
=>
	(up-build place-normal 0 c: dock)
)

(defrule
	(current-age >= middle-antiquity-age)
	(or
		(building-type-count town-center >= 2)
		(game-time >= 990)
	)
	(can-afford-building university)
	(building-type-count-total university g:< desired-number-universities)
	(up-can-build 0 c: university)
=>
	(up-build place-normal 0 c: university))

(defrule
	(current-age >= middle-antiquity-age)
	(or
		(building-type-count town-center >= 2)
		(game-time >= 990)
	)
	(can-afford-building monastery)
	(building-type-count-total monastery g:< desired-number-monasteries)
	(up-can-build 0 c: monastery)
=>
	(up-build place-normal 0 c: monastery))

(defrule
	(current-age >= middle-antiquity-age)
	(building-type-count town-center >= 2)
	(can-afford-building castle)
	(building-type-count-total castle g:< desired-number-castles)
	(up-can-build 0 c: castle)
=>
;	(up-get-fact building-type-count castle gl-number-castles)	
;	(up-modify-goal gl-castle-placement c:= 10)
;	(up-modify-goal gl-castle-placement g:* gl-number-castles)
;	(up-modify-goal gl-castle-placement c:+ 10)
;	(up-modify-goal gl-castle-placement s:min sn-maximum-town-size)
	(up-set-placement-data my-player-number -1 c: 20)	
;	(up-set-placement-data my-player-number -1 g: gl-castle-placement)
	(up-build place-control 0 c: castle)
)

(defrule
	(current-age >= middle-antiquity-age)
	(building-type-count town-center >= 2)
	(can-afford-building outpost)
	(building-type-count-total outpost g:< desired-number-outposts)
	(up-can-build 0 c: outpost)
=>
	(up-build place-normal 0 c: outpost))

(defrule
	(current-age >= early-antiquity-age)
	(or
		(current-age < middle-antiquity-age)
		(or
			(building-type-count town-center >= 2)
			(goal gl-home-defense-state YES)
		)
	)
	(can-afford-building watch-tower)
	(building-type-count-total watch-tower g:< desired-number-watchtowers)
	(up-can-build 0 c: watch-tower)
	(up-pending-objects c: watch-tower < 1)
=>
	(up-get-fact building-type-count watch-tower gl-number-watchtowers)
	
	(up-modify-goal gl-watchtower-placement c:= 4)
	(up-modify-goal gl-watchtower-placement g:* gl-number-watchtowers)
	(up-modify-goal gl-watchtower-placement c:+ 4)
	(up-modify-goal gl-watchtower-placement s:min sn-maximum-town-size)
	
	(up-set-placement-data my-player-number -1 g: gl-watchtower-placement)
	(up-build place-control 0 c: watch-tower)
)

;Wall posture starts with the actual exposed flank role. Pocket detection was
;formerly inverted in rawai-map, which gave this doctrine to the wrong players.
(defrule
	(current-age >= early-antiquity-age)
	(goal flank-position 1)
	(goal gl-wall-needed NO)
=>
	(set-goal gl-wall-needed YES)
	(chat-local-to-self "Wall posture: exposed flank")
)

(defrule
	(current-age >= early-antiquity-age)
	(or
		(goal gl-home-defense-state YES)
		(or
			(enemy-buildings-in-town)
			(goal taunt-wall YES)
		)
	)
	(goal gl-wall-needed NO)
=>
	(set-goal gl-wall-needed YES)
	(chat-local-to-self "Wall posture: local threat")
)

;A known enemy economy or military structure in the same active land zone is
;the engine-visible reachability proxy for a mainland opponent. This avoids
;walling an isolated island merely because the Real World map is hybrid.
(defrule
	(current-age >= early-antiquity-age)
	(goal gl-wall-scan-state WALL-SCAN-IDLE)
	(up-compare-goal gl-game-time g:>= gl-wall-scan-next)
	(goal gl-island-colony-established NO)
=>
	(up-modify-goal gl-wall-scan-focus s:= sn-focus-player-number)
	(up-modify-goal gl-wall-land-zone g:= gl-home-zone)
	(set-goal gl-hostile-land-route NO)
	(up-find-player enemy find-ordered gl-wall-scan-player)
	(up-modify-goal gl-wall-scan-first g:= gl-wall-scan-player)
	(set-goal gl-wall-scan-state WALL-SCAN-START)
)

(defrule
	(current-age >= early-antiquity-age)
	(goal gl-wall-scan-state WALL-SCAN-IDLE)
	(up-compare-goal gl-game-time g:>= gl-wall-scan-next)
	(goal gl-island-colony-established YES)
=>
	(up-modify-goal gl-wall-scan-focus s:= sn-focus-player-number)
	(up-modify-goal gl-wall-land-zone g:= gl-island-colony-zone)
	(set-goal gl-hostile-land-route NO)
	(up-find-player enemy find-ordered gl-wall-scan-player)
	(up-modify-goal gl-wall-scan-first g:= gl-wall-scan-player)
	(set-goal gl-wall-scan-state WALL-SCAN-START)
)

(defrule
	(goal gl-wall-scan-state WALL-SCAN-START)
=>
	(up-modify-sn sn-focus-player-number g:= gl-wall-scan-player)
	(up-full-reset-search)
	(up-set-target-point gl-home-anchor-x)
	(up-find-remote c: town-center c: 20)
	(up-find-remote c: barracks c: 20)
	(up-find-remote c: archery-range c: 20)
	(up-find-remote c: stable c: 20)
	(up-find-remote c: castle c: 10)
	(up-remove-objects search-remote object-data-map-zone-id g:!= gl-wall-land-zone)
	(up-clean-search search-remote object-data-distance search-order-asc)
	(up-modify-sn sn-focus-player-number g:= gl-wall-scan-focus)
	(set-goal gl-wall-scan-state WALL-SCAN-CHECK)
)

(defrule
	(goal gl-wall-scan-state WALL-SCAN-CHECK)
	(up-set-target-object search-remote c: 0)
=>
	(set-goal gl-hostile-land-route YES)
	(set-goal gl-wall-needed YES)
	(up-modify-goal gl-wall-scan-next g:= gl-game-time)
	(up-modify-goal gl-wall-scan-next c:+ 90)
	(up-chat-data-to-self "Wall posture same-zone enemy: %d" g: gl-wall-scan-player)
	(set-goal gl-wall-scan-state WALL-SCAN-IDLE)
)

(defrule
	(goal gl-wall-scan-state WALL-SCAN-CHECK)
	(not (up-set-target-object search-remote c: 0))
=>
	(set-goal gl-wall-scan-state WALL-SCAN-ADVANCE)
)

(defrule
	(goal gl-wall-scan-state WALL-SCAN-ADVANCE)
=>
	(up-find-next-player enemy find-ordered gl-wall-scan-player)
	(set-goal gl-wall-scan-state WALL-SCAN-NEXT)
)

(defrule
	(goal gl-wall-scan-state WALL-SCAN-NEXT)
	(up-compare-goal gl-wall-scan-player g:!= gl-wall-scan-first)
=>
	(set-goal gl-wall-scan-state WALL-SCAN-START)
)

(defrule
	(goal gl-wall-scan-state WALL-SCAN-NEXT)
	(up-compare-goal gl-wall-scan-player g:== gl-wall-scan-first)
=>
	(up-modify-sn sn-focus-player-number g:= gl-wall-scan-focus)
	(up-modify-goal gl-wall-scan-next g:= gl-game-time)
	(up-modify-goal gl-wall-scan-next c:+ 90)
	(set-goal gl-wall-scan-state WALL-SCAN-IDLE)
)

(defrule
	(current-age >= early-antiquity-age)
	(goal gl-wall-needed YES)
	(goal gl-wall-enabled NO)
=>
	(enable-wall-placement 2)
	(set-goal gl-wall-enabled YES)
	(chat-local-to-self "Wall placement owner enabled")
)

;Completion quarters act as a progress latch using only classic wall facts.
;Each new quarter clears the no-progress retry count. Three commands without a
;new quarter trigger a three-minute backoff, preventing the replayed identical-
;segment loop from multiplying across every newly eligible AI.
(defrule
	(wall-completed-percentage 2 >= 25)
	(up-compare-goal gl-wall-last-percent c:< 25)
=>
	(set-goal gl-wall-last-percent 25)
	(set-goal gl-wall-retries 0)
)

(defrule
	(wall-completed-percentage 2 >= 50)
	(up-compare-goal gl-wall-last-percent c:< 50)
=>
	(set-goal gl-wall-last-percent 50)
	(set-goal gl-wall-retries 0)
)

(defrule
	(wall-completed-percentage 2 >= 75)
	(up-compare-goal gl-wall-last-percent c:< 75)
=>
	(set-goal gl-wall-last-percent 75)
	(set-goal gl-wall-retries 0)
)

;Choose one material for perimeter 2 and retain it. Switching the strategic
;gate type between stone and palisade retries can make build-gate interpret an
;already-started perimeter with the wrong gate family.
(defrule
	(goal gl-wall-needed YES)
	(goal gl-wall-material WALL-MATERIAL-UNSET)
	(can-build-wall-with-escrow 2 stone-wall-line)
=>
	(set-goal gl-wall-material WALL-MATERIAL-STONE)
	(set-strategic-number sn-gate-type-for-wall 0)
	(chat-local-to-self "Wall owner latched stone perimeter")
)

(defrule
	(goal gl-wall-needed YES)
	(goal gl-wall-material WALL-MATERIAL-UNSET)
	(not (can-build-wall-with-escrow 2 stone-wall-line))
	(can-build-wall-with-escrow 2 palisade-wall)
=>
	(set-goal gl-wall-material WALL-MATERIAL-PALISADE)
	(set-strategic-number sn-gate-type-for-wall 1)
	(chat-local-to-self "Wall owner latched palisade perimeter")
)

(defrule
	(current-age >= early-antiquity-age)
	(goal gl-wall-needed YES)
	(goal gl-wall-material WALL-MATERIAL-STONE)
	(up-compare-goal gl-game-time g:>= gl-wall-next)
	(up-compare-goal gl-game-time g:>= gl-wall-danger-until)
	(up-compare-goal gl-wall-retries c:< 3)
	(wall-completed-percentage 2 < 100)
	(can-build-wall-with-escrow 2 stone-wall-line)
=>
	(release-escrow stone)
	(build-wall 2 stone-wall-line)
	(up-modify-goal gl-wall-retries c:+ 1)
	(up-modify-goal gl-wall-next g:= gl-game-time)
	(up-modify-goal gl-wall-next c:+ 45)
	(chat-local-to-self "Wall owner issued stone line")
)

(defrule
	(current-age >= early-antiquity-age)
	(goal gl-wall-needed YES)
	(goal gl-wall-material WALL-MATERIAL-PALISADE)
	(up-compare-goal gl-game-time g:>= gl-wall-next)
	(up-compare-goal gl-game-time g:>= gl-wall-danger-until)
	(up-compare-goal gl-wall-retries c:< 3)
	(wall-completed-percentage 2 < 100)
	(can-build-wall-with-escrow 2 palisade-wall)
=>
	(release-escrow wood)
	(build-wall 2 palisade-wall)
	(up-modify-goal gl-wall-retries c:+ 1)
	(up-modify-goal gl-wall-next g:= gl-game-time)
	(up-modify-goal gl-wall-next c:+ 45)
	(chat-local-to-self "Wall owner issued palisade line")
)

(defrule
	(goal gl-wall-needed YES)
	(goal gl-wall-material WALL-MATERIAL-UNSET)
	(up-compare-goal gl-game-time g:>= gl-wall-next)
	(up-compare-goal gl-wall-retries c:< 3)
	(wall-completed-percentage 2 < 100)
	(not (can-build-wall-with-escrow 2 stone-wall-line))
	(not (can-build-wall-with-escrow 2 palisade-wall))
=>
	(up-modify-goal gl-wall-next g:= gl-game-time)
	(up-modify-goal gl-wall-next c:+ 60)
)

(defrule
	(goal gl-wall-needed YES)
	(goal gl-wall-material WALL-MATERIAL-STONE)
	(up-compare-goal gl-game-time g:>= gl-wall-next)
	(up-compare-goal gl-wall-retries c:< 3)
	(wall-completed-percentage 2 < 100)
	(not (can-build-wall-with-escrow 2 stone-wall-line))
=>
	(up-modify-goal gl-wall-next g:= gl-game-time)
	(up-modify-goal gl-wall-next c:+ 60)
)

(defrule
	(goal gl-wall-needed YES)
	(goal gl-wall-material WALL-MATERIAL-PALISADE)
	(up-compare-goal gl-game-time g:>= gl-wall-next)
	(up-compare-goal gl-wall-retries c:< 3)
	(wall-completed-percentage 2 < 100)
	(not (can-build-wall-with-escrow 2 palisade-wall))
=>
	(up-modify-goal gl-wall-next g:= gl-game-time)
	(up-modify-goal gl-wall-next c:+ 60)
)

(defrule
	(goal gl-wall-needed YES)
	(up-compare-goal gl-game-time g:>= gl-wall-next)
	(up-compare-goal gl-wall-retries c:>= 3)
	(wall-completed-percentage 2 < 100)
=>
	(set-goal gl-wall-retries 0)
	(up-modify-goal gl-wall-next g:= gl-game-time)
	(up-modify-goal gl-wall-next c:+ 180)
	(up-chat-data-to-self "Wall placement no-progress backoff: %d" g: gl-wall-last-percent)
)

;Insert one usable opening as soon as a quarter of the perimeter exists and a
;second after three quarters. The owner count is perimeter-specific; a scenario
;or unrelated gate elsewhere must not suppress these requests. Gate timing is
;independent of the wall command/backoff deadline.
(defrule
	(goal gl-wall-needed YES)
	(goal gl-wall-enabled YES)
	(goal gl-wall-material WALL-MATERIAL-STONE)
	(goal gl-wall-gates-issued 0)
	(wall-completed-percentage 2 >= 25)
	(up-compare-goal gl-game-time g:>= gl-wall-gate-next)
	(up-compare-goal gl-game-time g:>= gl-wall-danger-until)
	(can-build-gate-with-escrow 2)
=>
	(release-escrow stone)
	(build-gate 2)
	(set-goal gl-wall-gates-issued 1)
	(set-goal gl-wall-gate-attempts 0)
	(up-modify-goal gl-wall-gate-next g:= gl-game-time)
	(up-modify-goal gl-wall-gate-next c:+ 60)
	(chat-local-to-self "Wall owner issued stone gate 1")
)

(defrule
	(goal gl-wall-needed YES)
	(goal gl-wall-enabled YES)
	(goal gl-wall-material WALL-MATERIAL-PALISADE)
	(goal gl-wall-gates-issued 0)
	(wall-completed-percentage 2 >= 25)
	(up-compare-goal gl-game-time g:>= gl-wall-gate-next)
	(up-compare-goal gl-game-time g:>= gl-wall-danger-until)
	(can-build-gate-with-escrow 2)
=>
	(release-escrow wood)
	(build-gate 2)
	(set-goal gl-wall-gates-issued 1)
	(set-goal gl-wall-gate-attempts 0)
	(up-modify-goal gl-wall-gate-next g:= gl-game-time)
	(up-modify-goal gl-wall-gate-next c:+ 60)
	(chat-local-to-self "Wall owner issued palisade gate 1")
)

(defrule
	(goal gl-wall-needed YES)
	(goal gl-wall-enabled YES)
	(goal gl-wall-material WALL-MATERIAL-STONE)
	(goal gl-wall-gates-issued 1)
	(wall-completed-percentage 2 >= 75)
	(up-compare-goal gl-game-time g:>= gl-wall-gate-next)
	(up-compare-goal gl-game-time g:>= gl-wall-danger-until)
	(can-build-gate-with-escrow 2)
=>
	(release-escrow stone)
	(build-gate 2)
	(set-goal gl-wall-gates-issued 2)
	(set-goal gl-wall-gate-attempts 0)
	(up-modify-goal gl-wall-gate-next g:= gl-game-time)
	(up-modify-goal gl-wall-gate-next c:+ 60)
	(chat-local-to-self "Wall owner issued stone gate 2")
)

(defrule
	(goal gl-wall-needed YES)
	(goal gl-wall-enabled YES)
	(goal gl-wall-material WALL-MATERIAL-PALISADE)
	(goal gl-wall-gates-issued 1)
	(wall-completed-percentage 2 >= 75)
	(up-compare-goal gl-game-time g:>= gl-wall-gate-next)
	(up-compare-goal gl-game-time g:>= gl-wall-danger-until)
	(can-build-gate-with-escrow 2)
=>
	(release-escrow wood)
	(build-gate 2)
	(set-goal gl-wall-gates-issued 2)
	(set-goal gl-wall-gate-attempts 0)
	(up-modify-goal gl-wall-gate-next g:= gl-game-time)
	(up-modify-goal gl-wall-gate-next c:+ 60)
	(chat-local-to-self "Wall owner issued palisade gate 2")
)

;A partially built line may not yet contain a replaceable gate span. Poll that
;engine fact on a separate bounded cadence without consuming a gate request.
(defrule
	(goal gl-wall-needed YES)
	(goal gl-wall-enabled YES)
	(goal gl-wall-gates-issued 0)
	(wall-completed-percentage 2 >= 25)
	(up-compare-goal gl-game-time g:>= gl-wall-gate-next)
	(up-compare-goal gl-wall-gate-attempts c:< 3)
	(not (can-build-gate-with-escrow 2))
=>
	(up-modify-goal gl-wall-gate-attempts c:+ 1)
	(up-modify-goal gl-wall-gate-next g:= gl-game-time)
	(up-modify-goal gl-wall-gate-next c:+ 60)
)

(defrule
	(goal gl-wall-needed YES)
	(goal gl-wall-enabled YES)
	(goal gl-wall-gates-issued 1)
	(wall-completed-percentage 2 >= 75)
	(up-compare-goal gl-game-time g:>= gl-wall-gate-next)
	(up-compare-goal gl-wall-gate-attempts c:< 3)
	(not (can-build-gate-with-escrow 2))
=>
	(up-modify-goal gl-wall-gate-attempts c:+ 1)
	(up-modify-goal gl-wall-gate-next g:= gl-game-time)
	(up-modify-goal gl-wall-gate-next c:+ 60)
)

(defrule
	(goal gl-wall-needed YES)
	(up-compare-goal gl-wall-gates-issued c:< 2)
	(up-compare-goal gl-wall-gate-attempts c:>= 3)
	(up-compare-goal gl-game-time g:>= gl-wall-gate-next)
=>
	(set-goal gl-wall-gate-attempts 0)
	(up-modify-goal gl-wall-gate-next g:= gl-game-time)
	(up-modify-goal gl-wall-gate-next c:+ 180)
	(up-chat-data-to-self "Wall gate availability backoff: %d" g: gl-wall-gates-issued)
)

;farm fallback

(defrule
	(goal gl-farm-placement-suspended NO)
	(current-age >= early-antiquity-age)
	(wood-amount > 150)
	(up-compare-goal gl-farm-build-target > 0)
	(and
		(building-type-count mill >= 1)
		(building-type-count farm == 0)
	)
		(building-type-count farm < gl-farm-build-target)
	(up-can-build 0 c: farm)
=>
	(chat-local-to-self "fallback farm placement")
	(up-build place-normal 0 c: farm)
)


