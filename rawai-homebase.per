;CB END 1152

;Water maps need the first Port independently of later expansion policy.
;CB BEGIN 1153
(defrule
	(goal gl-owner-worker-hold NO)
	(or
		(goal map-type LAKE)
		(or
			(goal map-type RIVERS)
			(or
				(goal map-type ISLANDS)
				(goal map-type TEAM-ISLANDS)
			)
		)
	)
	(building-type-count-total lumber-camp >= 1)
	(building-type-count-total dock < 1)
	(up-pending-objects c: dock <= 0)
	(not (up-pending-placement c: dock))
	(up-can-build 0 c: dock)
=>
	(set-goal gl-cbf-cont 1153)
)
(defrule
	(goal gl-cbf-cont 1153)
=>
	(set-goal gl-cbf-site 1153)
	(set-goal gl-cbf-kind 3)
	(set-goal gl-cbf-args0 -2)
	(set-goal gl-cbf-args1 -2)
	(set-goal gl-cbf-args2 -2)
	(set-goal gl-cbf-args3 -2)
	(set-goal gl-cbf-point-y -2)
	(up-get-rule-id gl-cbf-return)
	(up-modify-goal gl-cbf-return c:+ 1)
	(up-jump-direct g: gl-cbf-entry)
)
(defrule
	(goal gl-cbf-cont 1153)
=>
	(up-build place-normal 0 c: dock)
)
(defrule
	(goal gl-cbf-cont 1153)
=>
	(set-goal gl-cbf-site 1153)
	(set-goal gl-cbf-kind 2)
	(set-goal gl-cbf-args0 -2)
	(set-goal gl-cbf-args1 -2)
	(set-goal gl-cbf-args2 -2)
	(set-goal gl-cbf-args3 -2)
	(set-goal gl-cbf-point-y -2)
	(up-get-rule-id gl-cbf-return)
	(up-modify-goal gl-cbf-return c:+ 1)
	(up-jump-direct g: gl-cbf-entry)
)
(defrule
	(goal gl-cbf-cont 1153)
=>
	(set-goal gl-cbf-cont 0)
)
;CB END 1153

; Straight from AiBuilder files. Now extensively modified.

;Spread the first two Ports on water-map openings: rear first, front second,
;then standard placement. Front/back is relative to the map center, NOT a proof
;of opposite island shores. Proximity and minimum body area are set at startup.
(defrule
	(or (goal map-type ISLANDS)
	    (or (goal map-type TEAM-ISLANDS) (goal map-type RIVERS)))
	(building-type-count dock == 1)
	(strategic-number sn-dock-placement-mode != 1)
=>
	(set-strategic-number sn-dock-placement-mode 1)
)

(defrule
	(or (goal map-type ISLANDS)
	    (or (goal map-type TEAM-ISLANDS) (goal map-type RIVERS)))
	(building-type-count dock >= 2)
	(strategic-number sn-dock-placement-mode != 0)
=>
	(set-strategic-number sn-dock-placement-mode 0)
)

;Builder targets are persistent foundation assignments. They speed large
;buildings without globally converting most gatherers -- including animal-food
;workers -- into builders every time a foundation appears.
;CB BEGIN 1154
(defrule
	(goal gl-owner-worker-hold NO)
	(true)
=>
	(set-goal gl-cbf-cont 1154)
	(disable-self)
)
(defrule
	(goal gl-cbf-cont 1154)
=>
	(set-goal gl-cbf-site 1154)
	(set-goal gl-cbf-kind 3)
	(set-goal gl-cbf-args0 -2)
	(set-goal gl-cbf-args1 -2)
	(set-goal gl-cbf-args2 -2)
	(set-goal gl-cbf-args3 -2)
	(set-goal gl-cbf-point-y -2)
	(up-get-rule-id gl-cbf-return)
	(up-modify-goal gl-cbf-return c:+ 1)
	(up-jump-direct g: gl-cbf-entry)
)
(defrule
	(goal gl-cbf-cont 1154)
=>
	(up-assign-builders c: town-center-foundation c: 6)
)
