;State:0 FREE,1 WAYPOINT,2 LANDING,3 RETURN,4 QUARANTINE,5 RELEASE,6 LANDED COMBAT.

;Event:0 commit,1 enemy left,2 hostile fire,3 invalid landing,

;4 no progress,5 voyage deadline,6 hull lost,7 empty before landing,

;8 landed,9 return empty,10 quarantine,11 obstruction clearance,12 combat release,13 combat target.

(defrule
	(true)
=>
	(set-goal gl-am1-state 0)
	(set-goal gl-am1-hull -1)
	(set-goal gl-am1-combat-diag-left 24)
	(set-goal gl-am1-combat-diag-terminal-left 4)
	(disable-self)
)

(defrule
	(true)
=>
	(set-goal gl-am2-state 0)
	(set-goal gl-am2-hull -1)
	(set-goal gl-am2-combat-diag-left 24)
	(set-goal gl-am2-combat-diag-terminal-left 4)
