(defrule
	(true)
=>
	(set-goal gl-assault-admission-diag-next 0)
	(set-goal gl-assault-admission-diag-state 0)
	(set-goal gl-assault-admission-diag-mask 0)
	(set-goal gl-assault-admission-last-stage 0)
	(set-goal gl-assault-admission-last-time 0)
	(set-goal gl-assault-admission-reported-mask -1)
	(set-goal gl-assault-admission-reported-stage -1)
	(disable-self)
)

(defrule
	(true)
=>
	(up-get-fact game-time 0 gl-assault-mission-clock)
	(set-goal gl-assault-admission-open NO)
	(set-goal gl-assault-preflight-live NO)
	(up-modify-goal gl-assault-diag-checked-enemy g:= gl-assault-manifest-player)
	(set-goal gl-assault-diag-enemy-failure 411)
)

(defrule
	(or (goal gl-am1-state 0) (or (goal gl-am2-state 0) (goal gl-am3-state 0)))
=>
	(set-goal gl-assault-admission-open YES)
)

(defrule
	(up-compare-goal gl-assault-manifest-player c:> 8)
=>
	(set-goal gl-assault-diag-enemy-failure 412)
)

(defrule
	(goal gl-assault-manifest-player 1)
	(not (player-in-game 1))
=>
	(set-goal gl-assault-diag-enemy-failure 413)
)

(defrule
	(goal gl-assault-manifest-player 1)
	(player-in-game 1)
	(not (stance-toward 1 enemy))
=>
	(set-goal gl-assault-diag-enemy-failure 414)
)

(defrule
	(goal gl-assault-manifest-player 1)
	(player-in-game 1)
	(stance-toward 1 enemy)
=>
	(set-goal gl-assault-preflight-live YES)
	(set-goal gl-assault-diag-enemy-failure 0)
)

