
(defrule
	(goal resources-depleted NO)
	(and
		(goal current-phase 1)
		(and
			(up-object-type-count c: lumber-camp == 0)
			(up-object-type-count c: mill == 0)
		)
	)
=>
	(up-modify-sn sn-food-gatherer-percentage c:= 80)
	(up-modify-sn sn-wood-gatherer-percentage c:= 10)
	(up-modify-sn sn-gold-gatherer-percentage c:= 0)
	(up-modify-sn sn-stone-gatherer-percentage c:= 0)
	(up-modify-goal desired-number-lumbercamps c:= 1)
	(up-modify-goal desired-number-mills c:= 1)
	(up-modify-goal desired-number-miningcamps c:= 1)
	(chat-local-to-self "initial resource gathering settings")
	
	(disable-self)
)

(defrule
	(goal resources-depleted NO)
	(and
		(goal current-phase 1)
		(and
			(up-object-type-count c: lumber-camp >= 1)
			(up-object-type-count c: mill == 0)
		)
	)
=>
	(up-modify-sn sn-food-gatherer-percentage c:= 40)
	(up-modify-sn sn-wood-gatherer-percentage c:= 60)
	(up-modify-sn sn-gold-gatherer-percentage c:= 0)
	(up-modify-sn sn-stone-gatherer-percentage c:= 0)
	(up-modify-goal desired-number-lumbercamps c:= 1)
	(up-modify-goal desired-number-mills c:= 1)
	(up-modify-goal desired-number-miningcamps c:= 1)
	(chat-local-to-self "have lumber camp resource gathering settings")
	
	(disable-self)
)

(defrule
	(goal resources-depleted NO)
	(and
		(goal current-phase 1)
		(and
			(up-object-type-count c: lumber-camp >= 1)
			(up-object-type-count c: mill >= 1)
		)
	)
=>
	(up-modify-sn sn-food-gatherer-percentage c:= 90)
	(up-modify-sn sn-wood-gatherer-percentage c:= 10)
	(up-modify-sn sn-gold-gatherer-percentage c:= 0)
	(up-modify-sn sn-stone-gatherer-percentage c:= 0)
	(up-modify-goal desired-number-lumbercamps c:= 1)
	(up-modify-goal desired-number-mills c:= 1)
	(up-modify-goal desired-number-miningcamps c:= 1)
	(chat-local-to-self "have mill & lumber camp resource gathering settings")
	
	(disable-self)
)

(defrule
	(goal resources-depleted NO)
	(and
		(goal current-phase 2)
		(goal age-up-started EARLY-ANTIQUITY)
	)
=>
	(up-modify-sn sn-food-gatherer-percentage c:= 50)
	(up-modify-sn sn-wood-gatherer-percentage c:= 40)
	(up-modify-sn sn-gold-gatherer-percentage c:= 10)
	(up-modify-sn sn-stone-gatherer-percentage c:= 0)
	(up-modify-goal desired-number-lumbercamps c:= 2)
	;One Mill covers the opening food cluster. Additional Mills require an
	;actually distant cluster later instead of following the phase number.
	(up-modify-goal desired-number-mills c:= 1)
	(up-modify-goal desired-number-miningcamps c:= 2)
	(chat-local-to-self "aging to early antiquity age resource gathering settings")
	
	(disable-self)
)

(defrule
	(goal resources-depleted NO)
	(and
		(goal current-phase 3)
		(and
			(goal age-up-finished EARLY-ANTIQUITY)
			(and
				(goal age-up-started EARLY-ANTIQUITY)
				(and
					(building-type-count-total market == 0)
					(building-type-count-total blacksmith == 0)
				)
			)
		)
	)
=>
	(up-modify-sn sn-food-gatherer-percentage c:= 20)
	(up-modify-sn sn-wood-gatherer-percentage c:= 80)
	(up-modify-sn sn-gold-gatherer-percentage c:= 0)
	(up-modify-sn sn-stone-gatherer-percentage c:= 0)
	(up-modify-goal desired-number-lumbercamps c:= 3)
	(up-modify-goal desired-number-mills c:= 1)
	(up-modify-goal desired-number-miningcamps c:= 3)
)

(defrule
	(goal resources-depleted NO)
	(and
		(goal current-phase 3)
		(and
			(goal age-up-finished EARLY-ANTIQUITY)
			(and
				;Keep a buffer between the food recovery and gold-heavy modes.
				(food-amount < 700)
				(and
					(goal age-up-started EARLY-ANTIQUITY)
					(and
						(building-type-count-total market > 0)
						(building-type-count-total blacksmith > 0)
					)
				)
			)
		)
	)
=>
	(up-modify-sn sn-food-gatherer-percentage c:= 80)
	(up-modify-sn sn-wood-gatherer-percentage c:= 10)
	(up-modify-sn sn-gold-gatherer-percentage c:= 10)
	(up-modify-sn sn-stone-gatherer-percentage c:= 0)
	(up-modify-goal desired-number-lumbercamps c:= 3)
	(up-modify-goal desired-number-mills c:= 1)
	(up-modify-goal desired-number-miningcamps c:= 3)
)

(defrule
	(goal resources-depleted NO)
	(and
		(goal current-phase 3)
		(and
			(goal age-up-finished EARLY-ANTIQUITY)
			(and
				(food-amount > 900)
				(and
					(goal age-up-started EARLY-ANTIQUITY)
					(and
						(building-type-count-total market > 0)
						(building-type-count-total blacksmith > 0)
					)
				)
			)
		)
	)
=>
	(up-modify-sn sn-food-gatherer-percentage c:= 40)
	(up-modify-sn sn-wood-gatherer-percentage c:= 20)
	(up-modify-sn sn-gold-gatherer-percentage c:= 40)
	(up-modify-sn sn-stone-gatherer-percentage c:= 0)
	(up-modify-goal desired-number-lumbercamps c:= 3)
	(up-modify-goal desired-number-mills c:= 1)
	(up-modify-goal desired-number-miningcamps c:= 3)
)

(defrule
	(goal resources-depleted NO)
	(and
		(goal current-phase 3)
		(and
			(goal age-up-finished EARLY-ANTIQUITY)
			(and
				(goal age-up-started MIDDLE-ANTIQUITY)
				(and
					(building-type-count-total market > 0)
					(building-type-count-total blacksmith > 0)
				)
			)
		)
	)
=>
	(up-modify-sn sn-food-gatherer-percentage c:= 40)
	(up-modify-sn sn-wood-gatherer-percentage c:= 40)
	(up-modify-sn sn-gold-gatherer-percentage c:= 10)
	(up-modify-sn sn-stone-gatherer-percentage c:= 10)
	(up-modify-goal desired-number-lumbercamps c:= 3)
	(up-modify-goal desired-number-mills c:= 1)
	(up-modify-goal desired-number-miningcamps c:= 3)
)

(defrule
	(goal resources-depleted NO)
	(goal current-phase 4)
=>
	(up-modify-sn sn-food-gatherer-percentage c:= 40)
	(up-modify-sn sn-wood-gatherer-percentage c:= 45)
	(up-modify-sn sn-gold-gatherer-percentage c:= 10)
	(up-modify-sn sn-stone-gatherer-percentage c:= 5)
	(up-modify-goal desired-number-lumbercamps c:= 5)
	(up-modify-goal desired-number-mills c:= 5)
	(up-modify-goal desired-number-miningcamps c:= 5)
)

(defrule
	(goal resources-depleted NO)
	(and
		(current-age-time < 120)
		(and
			(goal current-phase 5)
			;Hysteresis prevents villagers bouncing at a single wood threshold.
			(wood-amount < 125)
		)
	)
=>
	(up-modify-sn sn-food-gatherer-percentage c:= 10)
	(up-modify-sn sn-wood-gatherer-percentage c:= 80)
	(up-modify-sn sn-gold-gatherer-percentage c:= 5)
	(up-modify-sn sn-stone-gatherer-percentage c:= 5)
	(up-modify-goal desired-number-lumbercamps c:= 4)
	(up-modify-goal desired-number-mills c:= 4)
	(up-modify-goal desired-number-miningcamps c:= 4)
)

(defrule
	(goal resources-depleted NO)
	(and
		(current-age-time < 120)
		(and
			(goal current-phase 5)
			(wood-amount > 200)
		)
	)
=>
	(up-modify-sn sn-food-gatherer-percentage c:= 40)
	(up-modify-sn sn-wood-gatherer-percentage c:= 45)
	(up-modify-sn sn-gold-gatherer-percentage c:= 5)
	(up-modify-sn sn-stone-gatherer-percentage c:= 5)
	(up-modify-goal desired-number-lumbercamps c:= 4)
	(up-modify-goal desired-number-mills c:= 4)
	(up-modify-goal desired-number-miningcamps c:= 4)
)

(defrule
	(goal resources-depleted NO)
	(and
		(current-age-time > 120)
		(and
			(goal current-phase 5)
			(and
				(building-type-count-total university == 0)
				(building-type-count-total monastery == 0)
			)
		)
	)
=>
	(up-modify-sn sn-food-gatherer-percentage c:= 20)
	(up-modify-sn sn-wood-gatherer-percentage c:= 65)
	(up-modify-sn sn-gold-gatherer-percentage c:= 10)
	(up-modify-sn sn-stone-gatherer-percentage c:= 5)
	(up-modify-goal desired-number-lumbercamps c:= 4)
	(up-modify-goal desired-number-mills c:= 4)
	(up-modify-goal desired-number-miningcamps c:= 4)
)

(defrule
	(goal resources-depleted NO)
	(and
		(current-age-time > 120)
		(and
			(goal current-phase 5)
			(and
				(building-type-count-total university > 0)
				(building-type-count-total monastery > 0)
			)
		)
	)
=>
	;This is the stable average of the former 20/35/40/5 recovery branch
	;and 40/15/40/5 completion branch. The old farm-target feedback made the
	;two branches alternate every sweep and repeatedly retask villagers.
	(up-modify-sn sn-food-gatherer-percentage c:= 30)
	(up-modify-sn sn-wood-gatherer-percentage c:= 25)
	(up-modify-sn sn-gold-gatherer-percentage c:= 40)
	(up-modify-sn sn-stone-gatherer-percentage c:= 5)
	(up-modify-goal desired-number-lumbercamps c:= 4)
	(up-modify-goal desired-number-mills c:= 4)
	(up-modify-goal desired-number-miningcamps c:= 4)
)

(defrule
	(goal resources-depleted NO)
	(goal current-phase 6)
=>
	(up-modify-sn sn-food-gatherer-percentage c:= 40)
	(up-modify-sn sn-wood-gatherer-percentage c:= 45)
	(up-modify-sn sn-gold-gatherer-percentage c:= 10)
	(up-modify-sn sn-stone-gatherer-percentage c:= 5)
	(up-modify-goal desired-number-lumbercamps c:= 5)
	(up-modify-goal desired-number-mills c:= 5)
	(up-modify-goal desired-number-miningcamps c:= 5)
)

(defrule
	(goal resources-depleted NO)
	(goal current-phase 7)
=>
	(up-modify-sn sn-food-gatherer-percentage c:= 40)
	(up-modify-sn sn-wood-gatherer-percentage c:= 45)
	(up-modify-sn sn-gold-gatherer-percentage c:= 10)
	(up-modify-sn sn-stone-gatherer-percentage c:= 5)
	(up-modify-goal desired-number-lumbercamps c:= 5)
	(up-modify-goal desired-number-mills c:= 5)
	(up-modify-goal desired-number-miningcamps c:= 5)
)

(defrule
	(and
		(goal gold-present NO)
		(goal stone-present NO)
	)
	(goal current-phase 7)
=>
	(up-modify-sn sn-food-gatherer-percentage c:= 50)
	(up-modify-sn sn-wood-gatherer-percentage c:= 50)
	(up-modify-sn sn-gold-gatherer-percentage c:= 0)
	(up-modify-sn sn-stone-gatherer-percentage c:= 0)
	(up-modify-goal desired-number-lumbercamps c:= 5)
	(up-modify-goal desired-number-mills c:= 5)
	(up-modify-goal desired-number-miningcamps c:= 0)
	(up-chat-data-to-self "gatherers: phase 7 no gold/stone -> food %d" c: 50)
	(disable-self)
)

;Hybrid and island economies must keep extending their wood line instead of
;letting the five oldest camps satisfy the late-game building target forever.
;The larger drop distance remains confined to water-separated maps.
(defrule
	(up-compare-goal current-phase >= 5)
	(goal wood-present YES)
	(or
		(goal map-type RIVERS)
		(or
			(goal map-type ISLANDS)
			(goal map-type TEAM-ISLANDS)
		)
	)
=>
	(up-modify-goal desired-number-lumbercamps c:max 7)
	(up-modify-goal lumbercamp-max-distance c:max 120)
	(up-modify-goal max-wood-distance c:max 36)
)

(defrule
	(goal resources-depleted YES)
	(nor
		(goal map-type RIVERS)
		(or
			(goal map-type ISLANDS)
			(goal map-type TEAM-ISLANDS)
		)
	)
=>
	(up-modify-sn sn-food-gatherer-percentage c:= 100)
	(up-modify-sn sn-wood-gatherer-percentage c:= 0)
	(up-modify-sn sn-gold-gatherer-percentage c:= 0)
	(up-modify-sn sn-stone-gatherer-percentage c:= 0)
	(up-modify-goal desired-depleted-villagers g:= gl-thirty-percent)
	(up-chat-data-to-self "gatherers: depleted land -> food %d" c: 100)
	(disable-self)
)

;After a resource-bearing off-island colony is confirmed, "depleted" describes
;the exhausted starting land mass rather than every reachable zone. Preserve
;nonzero remote-resource demand without rebalancing a failed migration.
(defrule
	(goal resources-depleted YES)
	(goal gl-island-colony-established YES)
	(or
		(goal map-type RIVERS)
		(or
			(goal map-type ISLANDS)
			(goal map-type TEAM-ISLANDS)
		)
	)
=>
	(up-modify-sn sn-food-gatherer-percentage c:= 45)
	(up-modify-sn sn-wood-gatherer-percentage c:= 35)
	(up-modify-sn sn-gold-gatherer-percentage c:= 15)
	(up-modify-sn sn-stone-gatherer-percentage c:= 5)
	;A productive colony is no longer an emergency end-state. Restore the normal
	;phase villager target so losses among remote workers and farmers are
	;replaced instead of waiting for the entire economy to fall below 30%.
	(up-modify-goal desired-depleted-villagers g:= desired-number-villagers)
	(up-chat-data-to-self "gatherers: depleted island colony -> food %d" c: 45)
	(disable-self)
)

(defrule
	(goal resources-depleted YES)
	(goal gl-island-colony-established NO)
	(or
		(goal map-type RIVERS)
		(or
			(goal map-type ISLANDS)
			(goal map-type TEAM-ISLANDS)
		)
	)
=>
	(up-modify-sn sn-food-gatherer-percentage c:= 100)
	(up-modify-sn sn-wood-gatherer-percentage c:= 0)
	(up-modify-sn sn-gold-gatherer-percentage c:= 0)
	(up-modify-sn sn-stone-gatherer-percentage c:= 0)
	(up-modify-goal desired-depleted-villagers g:= gl-thirty-percent)
	(up-chat-data-to-self "gatherers: depleted island no colony -> food %d" c: 100)
	(disable-self)
)

;A depleted island without a colony must spend its remaining wood on the
;transport/migration path instead of filling the exhausted home island with
;farms. Land maps and established colonies retain normal farm construction.
(defrule
	(goal resources-depleted YES)
	(goal gl-island-colony-established NO)
	(or
		(goal map-type RIVERS)
		(or
			(goal map-type ISLANDS)
			(goal map-type TEAM-ISLANDS)
		)
	)
=>
	(set-goal gl-farm-placement-suspended YES)
)

(defrule
	(or
		(goal resources-depleted NO)
		(or
			(goal gl-island-colony-established YES)
			(nor
				(goal map-type RIVERS)
				(or
					(goal map-type ISLANDS)
					(goal map-type TEAM-ISLANDS)
				)
			)
		)
	)
=>
	(set-goal gl-farm-placement-suspended NO)
)

(defrule
	(up-compare-sn mill-max-distance != mill-max-distance)
=>
	(up-modify-sn sn-mill-max-distance g:= mill-max-distance)
)

(defrule
	(up-compare-sn sn-lumber-camp-max-distance != lumbercamp-max-distance)
=>
	(up-modify-sn sn-lumber-camp-max-distance g:= lumbercamp-max-distance)
)

(defrule
	(up-compare-sn sn-mining-camp-max-distance != miningcamp-max-distance)
=>
	(up-modify-sn sn-mining-camp-max-distance g:= miningcamp-max-distance)
)

(defrule
	(up-compare-sn sn-maximum-hunt-drop-distance != max-hunt-distance)
=>
	(up-modify-sn sn-maximum-hunt-drop-distance g:= max-hunt-distance)
)

(defrule
	(up-compare-sn sn-maximum-food-drop-distance != max-food-distance)
=>
	(up-modify-sn sn-maximum-food-drop-distance g:= max-food-distance)
)

(defrule
	(up-compare-sn sn-maximum-wood-drop-distance != max-wood-distance)
=>
	(up-modify-sn sn-maximum-wood-drop-distance g:= max-wood-distance)
)

(defrule
	(up-compare-sn sn-maximum-stone-drop-distance != max-stone-distance)
=>
	(up-modify-sn sn-maximum-stone-drop-distance g:= max-stone-distance)
)

(defrule
	(up-compare-sn sn-maximum-gold-drop-distance != max-gold-distance)
=>
	(up-modify-sn sn-maximum-gold-drop-distance g:= max-gold-distance)
)

;upgrade requirements/settings

(defrule
	(up-compare-goal current-phase g:!= previous-phase)
	(goal current-phase 1)
=>
	(set-goal upgrade-military-lines 0)
	(set-goal upgrade-military-smith 0)
	(set-goal upgrade-military-generic 0)
	(set-goal upgrade-military-villager-requirement 24)
	(set-goal upgrade-economy 0)
	(set-goal upgrade-economy-villager-requirement 24)
	(set-goal upgrade-fortifications 0)
	(set-goal upgrade-fortifications-villager-requirement 24)
	(set-goal upgrade-navy 0)
	(set-goal upgrade-navy-villager-requirement 24)
	(set-goal upgrade-other 0)
	(set-goal upgrade-other-villager-requirement 24)
	
	(disable-self)
)

(defrule
	(up-compare-goal current-phase g:!= previous-phase)
	(goal current-phase 2)
=>
	(set-goal upgrade-military-lines 0)
	(set-goal upgrade-military-smith 0)
	(set-goal upgrade-military-generic 0)
	(set-goal upgrade-military-villager-requirement 24)
	(set-goal upgrade-economy 0)
	(set-goal upgrade-economy-villager-requirement 24)
	(set-goal upgrade-fortifications 0)
	(set-goal upgrade-fortifications-villager-requirement 24)
	(set-goal upgrade-navy 0)
	(set-goal upgrade-navy-villager-requirement 24)
	(set-goal upgrade-other 0)
	(set-goal upgrade-other-villager-requirement 24)
	
	(disable-self)
)

(defrule
	(up-compare-goal current-phase g:!= previous-phase)
	(goal current-phase 3)
=>
	(set-goal upgrade-military-lines 0)
	(set-goal upgrade-military-smith 0)
	(set-goal upgrade-military-generic 0)
	(set-goal upgrade-military-villager-requirement 27)
	(set-goal upgrade-economy 0)
	(set-goal upgrade-economy-villager-requirement 27)
	(set-goal upgrade-fortifications 0)
	(set-goal upgrade-fortifications-villager-requirement 27)
	(set-goal upgrade-navy 0)
	(set-goal upgrade-navy-villager-requirement 27)
	(set-goal upgrade-other 0)
	(set-goal upgrade-other-villager-requirement 27)
	
	(disable-self)
)

(defrule
	(up-compare-goal current-phase g:!= previous-phase)
	(goal current-phase 4)
=>
	(set-goal upgrade-military-lines 1)
	(set-goal upgrade-military-smith 1)
	(set-goal upgrade-military-generic 1)
	(set-goal upgrade-military-villager-requirement 27)
	(set-goal upgrade-economy 1)
	(set-goal upgrade-economy-villager-requirement 27)
	;While preparing for and living in Middle Antiquity, reserve research
	;escrow for unit lines and the economy. Optional defenses and utility techs
	;resume once Imperial is queued, or immediately for a rush/emergency.
	(set-goal upgrade-fortifications 0)
	(set-goal upgrade-fortifications-villager-requirement 27)
	(set-goal upgrade-navy 1)
	(set-goal upgrade-navy-villager-requirement 27)
	(set-goal upgrade-other 0)
	(set-goal upgrade-other-villager-requirement 27)
	
	(disable-self)
)

(defrule
	(up-compare-goal current-phase g:!= previous-phase)
	(goal current-phase 5)
=>
	(set-goal upgrade-military-lines 1)
	(set-goal upgrade-military-smith 1)
	(set-goal upgrade-military-generic 1)
	(set-goal upgrade-military-villager-requirement 27)
	(set-goal upgrade-economy 1)
	(set-goal upgrade-economy-villager-requirement 27)
	(set-goal upgrade-fortifications 0)
	(set-goal upgrade-fortifications-villager-requirement 27)
	(set-goal upgrade-navy 1)
	(set-goal upgrade-navy-villager-requirement 27)
	(set-goal upgrade-other 0)
	(set-goal upgrade-other-villager-requirement 27)
	
	(disable-self)
)

(defrule
	(current-age == middle-antiquity-age)
	(or
		(up-compare-goal rush-rushing c:!= NO)
		(or
			(goal gl-home-defense-state YES)
			(goal age-up-started IMPERIAL)
		)
	)
	(or
		(goal upgrade-fortifications 0)
		(goal upgrade-other 0)
	)
=>
	(set-goal upgrade-fortifications 1)
	(set-goal upgrade-other 1)
)

(defrule
	(current-age == middle-antiquity-age)
	(goal rush-rushing NO)
	(goal gl-home-defense-state NO)
	(up-compare-goal age-up-started c:< IMPERIAL)
	(or
		(goal upgrade-fortifications 1)
		(goal upgrade-other 1)
	)
=>
	(set-goal upgrade-fortifications 0)
	(set-goal upgrade-other 0)
)

;run once, timer handles it afterwards
(defrule
	(and
		(building-type-count-total mill >= 1)
		(and
			(and
				(dropsite-min-distance hunting >= 0)
				(dropsite-min-distance hunting <= 15)
			)
			(and
				(dropsite-min-distance food >= 0)
				(dropsite-min-distance food <= 15)
			)
		)
	)
=>
	(set-goal dependent-farms FARM-DEMAND-DEPENDENT)
	(chat-local-to-self "Farm demand depends on nearby natural food")
	(disable-self)
)

(defrule
	(and
		(goal dependent-farms FARM-DEMAND-INDEPENDENT)
		(building-type-count-total mill == 0)
	)
=>
	(set-goal dependent-farms FARM-DEMAND-DEPENDENT)
	(chat-local-to-self "Defer independent farms, no mill")
)

(defrule
	(current-age == early-antiquity-age)
	(and
		(goal dependent-farms FARM-DEMAND-INDEPENDENT)
		(and
			(building-type-count-total market == 0)
			(building-type-count-total blacksmith == 0)
		)
	)
=>
	(set-goal dependent-farms FARM-DEMAND-DEPENDENT)
	(chat-local-to-self "Defer independent farms, age-up structures missing")
)

(defrule
	(timer-triggered t-farm-check)
	(building-type-count-total mill >= 1)
	(or
		(not
			(sheep-and-forage-too-far)
		)
		(and
			(dropsite-min-distance hunting >= 0)
			(dropsite-min-distance hunting <= 8)
		)
	)
=>
	(set-goal dependent-farms FARM-DEMAND-DEPENDENT)
	(disable-timer t-farm-check)
	(chat-local-to-self "Farm demand still depends on nearby hunt")
)

(defrule
	(timer-triggered t-farm-check)
	(and
		(building-type-count-total mill >= 1)
		(and
			(sheep-and-forage-too-far)
			(and
				(or
					(dropsite-min-distance hunting < 0)
					(dropsite-min-distance hunting > 8)
				)
				(or
					(current-age != early-antiquity-age)
					(or
						(building-type-count-total market > 0)
						(building-type-count-total blacksmith > 0)
					)
				)
			)
		)
	)
=>
	(set-goal dependent-farms FARM-DEMAND-INDEPENDENT)
	(disable-timer t-farm-check)
	(chat-local-to-self "Use independent farm target, natural food is exhausted")
)

(defrule
	(goal resources-depleted NO)
	(up-object-type-count-total c: villager g:< desired-number-villagers)
	(up-can-train gl-unitescrow-state c: villager)
=>
	(up-train gl-unitescrow-state c: villager)
)

(defrule
	(goal resources-depleted YES)
	(up-object-type-count-total c: villager g:< desired-depleted-villagers)
	(up-can-train gl-unitescrow-state c: villager)
=>
	(up-train gl-unitescrow-state c: villager)
)

;delete excess villagers, start with idle ones
(defrule
	(goal resources-depleted YES)
	(up-object-type-count-total c: villager g:> desired-depleted-villagers)
	(nor
		(goal map-type RIVERS)
		(or
			(goal map-type ISLANDS)
			(goal map-type TEAM-ISLANDS)
		)
	)
=>
	(up-delete-idle-units idle-type-villager)
	(disable-self)
)

(defrule
	(goal resources-depleted YES)
	(up-idle-unit-count idle-type-villager < 5)
	(up-object-type-count-total c: villager g:> desired-depleted-villagers)
	(nor
		(goal map-type RIVERS)
		(or
			(goal map-type ISLANDS)
			(goal map-type TEAM-ISLANDS)
		)
	)
=>
	(delete-unit villager)
)

;Seed an aquatic economy even before the periodic resource scan has seen fish.
;The first boats explore their water body and reveal additional fishing grounds.
(defrule
	(game-time < 600)
	(unit-type-count-total fishing-ship < 2)
	(unit-type-count-total fishing-ship g:< desired-number-fishing)
	(or
		(goal map-type LAKE)
		(or
			(goal map-type RIVERS)
			(or
				(goal map-type ISLANDS)
				(goal map-type TEAM-ISLANDS)
			)
		)
	)
	(can-train fishing-ship)
=>
	(train fishing-ship)
)

(defrule
	(goal fish-present YES)
	(unit-type-count-total fishing-ship < 2)
	(unit-type-count-total fishing-ship g:< desired-number-fishing)
	(wood-amount > 140)
	(can-train fishing-ship)
=>
	(train fishing-ship)
)

;Scale the fishing fleet to the fishing grounds that are still visible. This
;prevents a small inland sea from consuming the same population as open water.
(defrule
	(or
		(cc-players-unit-type-count 0 ocean-fish-class >= 4)
		(or
			(cc-players-unit-type-count 0 shore-fish-class >= 4)
			(building-type-count-total fish-trap > 0)
		)
	)
	(unit-type-count-total fishing-ship < 4)
	(unit-type-count-total fishing-ship g:< desired-number-fishing)
	(wood-amount > 220)
	(can-train fishing-ship)
=>
	(train fishing-ship)
)

(defrule
	(or
		(cc-players-unit-type-count 0 ocean-fish-class >= 10)
		(cc-players-unit-type-count 0 shore-fish-class >= 10)
	)
	(unit-type-count-total fishing-ship < 6)
	(unit-type-count-total fishing-ship g:< desired-number-fishing)
	(wood-amount > 320)
	(can-train fishing-ship)
=>
	(train fishing-ship)
)

;Budget one full lift for the current army plus one utility hull for villagers,
;relic carriers, rescue work, or replacing a transport that is already sailing.
(defrule
	(or
		(goal map-type LAKE)
		(or
			(goal map-type RIVERS)
			(or
				(goal map-type ISLANDS)
				(goal map-type TEAM-ISLANDS)
			)
		)
	)
=>
	(up-get-fact soldier-count 0 gl-transport-required)
	(up-modify-goal gl-transport-required g:+ gl-transport-capacity)
	(up-modify-goal gl-transport-required c:- 1)
	(up-modify-goal gl-transport-required g:/ gl-transport-capacity)
	(up-modify-goal gl-transport-required c:+ 1)
)

(defrule
	(up-compare-goal gl-transport-required c:> 16)
=>
	(set-goal gl-transport-required 16)
)

;On true island layouts a land attack waits for the completed full-lift budget.
;Queued hulls and transports currently owned by utility controllers are not a
;usable lift and therefore cannot release the army toward an inland rally.
;Hybrid Rivers and Lake maps keep ordinary land dispatch because reachable land
;fronts can exist there even when naval infrastructure is incomplete.
(defrule
	(up-timer-status t-transport-readiness == timer-triggered)
	(or
		(goal map-type LAKE)
		(or
			(goal map-type RIVERS)
			(or
				(goal map-type ISLANDS)
				(goal map-type TEAM-ISLANDS)
			)
		)
	)
=>
	(up-modify-goal gl-transport-readiness-focus s:= sn-focus-player-number)
	(set-strategic-number sn-focus-player-number my-player-number)
	(up-full-reset-search)
	(up-find-local c: transport-ship c: 40)
	(up-remove-objects search-local object-data-id g:== gl-quarantine-transport-id)
	(up-remove-objects search-local object-data-garrison-count > 0)
	(up-remove-objects search-local object-data-idling != 1)
	(up-remove-objects search-local object-data-under-attack > 0)
	;Any direct-control or engine attack-group flag makes the hull unavailable
	;for a newly dispatched full lift. Unassigned objects report group flag -2.
	(up-remove-objects search-local object-data-group-flag >= 0)
	(up-get-search-state local-total)
	(up-modify-goal gl-available-transport-count g:= local-total)
	(up-modify-sn sn-focus-player-number g:= gl-transport-readiness-focus)
	(up-set-timer c: t-transport-readiness c: 5)
)

(defrule
	(or
		(goal map-type ISLANDS)
		(goal map-type TEAM-ISLANDS)
	)
	(up-compare-goal gl-available-transport-count g:< gl-transport-required)
=>
	(set-goal gl-land-transport-ready NO)
)

(defrule
	(or
		(goal map-type LAKE)
		(goal map-type RIVERS)
	)
	(goal gl-land-target-needs-transport YES)
	(up-compare-goal gl-available-transport-count g:< gl-transport-required)
=>
	(set-goal gl-land-transport-ready NO)
)

(defrule
	(or
		(goal map-type ISLANDS)
		(goal map-type TEAM-ISLANDS)
	)
	(or
		(nor
			(goal gl-island-migration-state MIGRATION-IDLE)
			(goal gl-island-migration-state MIGRATION-QUARANTINED)
		)
		(or
			(not (goal gl-transport-route-state TRANSPORT-ROUTE-IDLE))
			(or
				(not (goal gl-transport-recovery-state TRANSPORT-RECOVERY-IDLE))
				(or
					(not (goal gl-relic-ferry-state RELIC-FERRY-IDLE))
					(or
						(not (goal gl-transport-repair-state TRANSPORT-REPAIR-IDLE))
						(not (goal gl-transport-clear-state TRANSPORT-CLEAR-IDLE))
					)
				)
			)
		)
	)
=>
	(set-goal gl-land-transport-ready NO)
)

(defrule
	(or
		(goal map-type LAKE)
		(goal map-type RIVERS)
	)
	(goal gl-land-target-needs-transport YES)
	(or
		(nor
			(goal gl-island-migration-state MIGRATION-IDLE)
			(goal gl-island-migration-state MIGRATION-QUARANTINED)
		)
		(or
			(not (goal gl-transport-route-state TRANSPORT-ROUTE-IDLE))
			(or
				(not (goal gl-transport-recovery-state TRANSPORT-RECOVERY-IDLE))
				(or
					(not (goal gl-relic-ferry-state RELIC-FERRY-IDLE))
					(or
						(not (goal gl-transport-repair-state TRANSPORT-REPAIR-IDLE))
						(not (goal gl-transport-clear-state TRANSPORT-CLEAR-IDLE))
					)
				)
			)
		)
	)
=>
	(set-goal gl-land-transport-ready NO)
)

(defrule
	(or
		(goal map-type ISLANDS)
		(goal map-type TEAM-ISLANDS)
	)
	(up-compare-goal gl-available-transport-count g:>= gl-transport-required)
	(or
		(goal gl-island-migration-state MIGRATION-IDLE)
		(goal gl-island-migration-state MIGRATION-QUARANTINED)
	)
	(goal gl-transport-route-state TRANSPORT-ROUTE-IDLE)
	(goal gl-transport-recovery-state TRANSPORT-RECOVERY-IDLE)
	(goal gl-relic-ferry-state RELIC-FERRY-IDLE)
	(goal gl-transport-repair-state TRANSPORT-REPAIR-IDLE)
	(goal gl-transport-clear-state TRANSPORT-CLEAR-IDLE)
=>
	(set-goal gl-land-transport-ready YES)
)

(defrule
	(or
		(goal map-type LAKE)
		(goal map-type RIVERS)
	)
	(goal gl-land-target-needs-transport YES)
	(up-compare-goal gl-available-transport-count g:>= gl-transport-required)
	(or
		(goal gl-island-migration-state MIGRATION-IDLE)
		(goal gl-island-migration-state MIGRATION-QUARANTINED)
	)
	(goal gl-transport-route-state TRANSPORT-ROUTE-IDLE)
	(goal gl-transport-recovery-state TRANSPORT-RECOVERY-IDLE)
	(goal gl-relic-ferry-state RELIC-FERRY-IDLE)
	(goal gl-transport-repair-state TRANSPORT-REPAIR-IDLE)
	(goal gl-transport-clear-state TRANSPORT-CLEAR-IDLE)
=>
	(set-goal gl-land-transport-ready YES)
)

(defrule
	(or
		(goal map-type LAND)
		(and
			(or
				(goal map-type LAKE)
				(goal map-type RIVERS)
			)
			(goal gl-land-target-needs-transport NO)
		)
	)
=>
	(set-goal gl-land-transport-ready YES)
)

;Target connectivity is the final authority. Empty completed hulls are a
;production budget, not an executing lift: the scripted route owner must board
;and sail disconnected attacks itself. This override is deliberately after the
;legacy capacity rules above so generic attack-now cannot consume a cross-water
;dispatch merely because enough empty Transports exist.
(defrule
	(goal gl-land-target-needs-transport YES)
=>
	(set-goal gl-land-transport-ready NO)
)

(defrule
	(goal gl-land-target-needs-transport NO)
=>
	(set-goal gl-land-transport-ready YES)
)

(defrule
	(current-age >= early-antiquity-age)
	(goal gl-home-resource-pressure YES)
	(or
		(goal map-type RIVERS)
		(or
			(goal map-type ISLANDS)
			(goal map-type TEAM-ISLANDS)
		)
	)
	(up-compare-goal gl-quarantine-transport-id c:< 0)
	;The authoritative DAT costs are 125 wood for the hull and 100 for either
	;resource camp. Require the complete 225-wood package when the hull is
	;requested; the relocation Market bridge continues replenishing wood while
	;pressure remains because this threshold is not an engine escrow.
	(wood-amount >= 225)
	(or
		(unit-type-count-total transport-ship < 2)
		(and
			(up-compare-goal gl-available-transport-count c:< 1)
			(unit-type-count-total transport-ship < 3)
		)
	)
	(can-train transport-ship)
=>
	(train transport-ship)
)

(defrule
	(current-age >= early-antiquity-age)
	(goal gl-home-resource-pressure NO)
	(or
		(goal map-type LAKE)
		(or
			(goal map-type RIVERS)
			(or
				(goal map-type ISLANDS)
				(goal map-type TEAM-ISLANDS)
			)
		)
	)
	(wood-amount > 160)
	(up-compare-goal gl-quarantine-transport-id c:< 0)
	(unit-type-count-total transport-ship g:< gl-transport-required)
	(can-train transport-ship)
=>
	(train transport-ship)
)

;A detached occupied hull is deliberately unavailable, so it must not satisfy
;the production ceiling. Build exactly one bounded replacement above the normal
;full-lift target; the one-slot quarantine makes required+1 a hard ceiling.
(defrule
	(current-age >= early-antiquity-age)
	(or
		(goal map-type LAKE)
		(or
			(goal map-type RIVERS)
			(or
				(goal map-type ISLANDS)
				(goal map-type TEAM-ISLANDS)
			)
		)
	)
	(up-compare-goal gl-quarantine-transport-id c:>= 0)
	(or
		(and
			(goal gl-home-resource-pressure YES)
			(wood-amount >= 225)
		)
		(and
			(goal gl-home-resource-pressure NO)
			(wood-amount > 160)
		)
	)
	(unit-type-count-total transport-ship g:<= gl-transport-required)
	(can-train transport-ship)
=>
	(train transport-ship)
)

;Team trade modality is selected from actual endpoint reachability, never from
;the map label alone. Real World Britain is a hybrid RIVERS map: several starts
;share water while their Markets occupy disconnected land zones.
(defrule
	(goal team-game YES)
	(not (player-in-game any-ally))
	(or
		(goal gl-land-trade-route YES)
		(or
			(goal gl-water-trade-route YES)
			(not (goal gl-trade-route-state TRADE-ROUTE-IDLE))
		)
	)
=>
	(set-goal gl-land-trade-route NO)
	(set-goal gl-water-trade-route NO)
	(set-goal gl-trade-action-verified NO)
	(set-goal gl-trade-active-count 0)
	(set-goal gl-trade-growth-limit 3)
	(set-goal gl-trade-route-state TRADE-ROUTE-IDLE)
	(up-modify-goal gl-trade-route-next g:= gl-game-time)
	(up-modify-goal gl-trade-route-next c:+ 60)
)

;Dock/Port map-zone equality proved insufficient in the 2026-08-27 Britain
;replay. Once the bounded probes exist, accept water trade only from the
;engine's live trade action on a merchant hull. This is both a reachability and
;route-use proof; a merely completed or idle ship does not qualify.
(defrule
	(current-age >= early-antiquity-age)
	(goal team-game YES)
	(player-in-game any-ally)
	(goal gl-trade-route-state TRADE-ROUTE-IDLE)
	(goal gl-land-trade-route NO)
	(up-compare-goal gl-game-time g:>= gl-trade-route-next)
	(or
		(up-compare-goal gl-trade-probe-trained c:>= 1)
		(goal gl-water-trade-route YES)
	)
	(unit-type-count-total trade-cog >= 1)
	(or
		(goal map-type LAKE)
		(or
			(goal map-type RIVERS)
			(or
				(goal map-type ISLANDS)
				(goal map-type TEAM-ISLANDS)
			)
		)
	)
=>
	(up-modify-goal gl-trade-route-focus s:= sn-focus-player-number)
	(set-strategic-number sn-focus-player-number my-player-number)
	(up-full-reset-search)
	;The 400-population scarce target is 160 merchants. A 40-object proof list
	;would hard-cap staged growth at 83 even if every listed ship were trading.
	(up-find-local c: trade-cog-class c: 240)
	(up-remove-objects search-local object-data-action != actionid-trade)
	(up-clean-search search-local object-data-id search-order-asc)
	(up-get-search-state local-total)
	(up-modify-goal gl-trade-active-count g:= local-total)
	(set-goal gl-trade-route-state TRADE-ROUTE-WATER-PROOF-CHECK)
)

(defrule
	(goal gl-trade-route-state TRADE-ROUTE-WATER-PROOF-CHECK)
	(up-set-target-object search-local c: 0)
=>
	(up-get-object-data object-data-map-zone-id gl-trade-water-zone)
	(set-goal gl-water-trade-route YES)
	(set-goal gl-trade-action-verified YES)
	(set-goal gl-trade-route-failures 0)
	(up-modify-goal gl-trade-growth-limit g:= gl-trade-active-count)
	(up-modify-goal gl-trade-growth-limit c:* 2)
	(up-modify-goal gl-trade-growth-limit c:+ 3)
	(up-chat-data-to-self "merchant route action verified: %d" g: gl-trade-water-zone)
	(up-modify-sn sn-focus-player-number g:= gl-trade-route-focus)
	(up-modify-goal gl-trade-route-next g:= gl-game-time)
	(up-modify-goal gl-trade-route-next c:+ 15)
	(set-goal gl-trade-route-state TRADE-ROUTE-IDLE)
)

(defrule
	(goal gl-trade-route-state TRADE-ROUTE-WATER-PROOF-CHECK)
	(not (up-set-target-object search-local c: 0))
=>
	(set-goal gl-water-trade-route NO)
	(set-goal gl-trade-action-verified NO)
	(set-goal gl-trade-active-count 0)
	(set-goal gl-trade-growth-limit 3)
	(up-chat-data-to-self "merchant probes idle: %d" g: gl-trade-probe-trained)
	(up-modify-sn sn-focus-player-number g:= gl-trade-route-focus)
	(up-modify-goal gl-trade-route-next g:= gl-game-time)
	(up-modify-goal gl-trade-route-next c:+ 30)
	(set-goal gl-trade-route-state TRADE-ROUTE-IDLE)
)

;Land endpoint zone equality is also only a candidate route. Require an actual
;Trade Cart action before a large-population trade transition can retire any
;villagers. An idle first cart invalidates the candidate and triggers a fresh
;endpoint scan instead of allowing a stranded fleet to grow.
(defrule
	(current-age >= early-antiquity-age)
	(goal team-game YES)
	(player-in-game any-ally)
	(goal gl-trade-route-state TRADE-ROUTE-IDLE)
	(goal gl-land-trade-route YES)
	(up-compare-goal gl-game-time g:>= gl-trade-route-next)
	(unit-type-count-total trade-cart >= 1)
=>
	(up-modify-goal gl-trade-route-focus s:= sn-focus-player-number)
	(set-strategic-number sn-focus-player-number my-player-number)
	(up-full-reset-search)
	(up-find-local c: trade-cart c: 240)
	(up-remove-objects search-local object-data-action != actionid-trade)
	(up-clean-search search-local object-data-id search-order-asc)
	(up-get-search-state local-total)
	(up-modify-goal gl-trade-active-count g:= local-total)
	(set-goal gl-trade-route-state TRADE-ROUTE-ACTION-PROOF-CHECK)
)

(defrule
	(goal gl-trade-route-state TRADE-ROUTE-ACTION-PROOF-CHECK)
	(up-set-target-object search-local c: 0)
=>
	(set-goal gl-trade-action-verified YES)
	(set-goal gl-trade-route-failures 0)
	(up-modify-goal gl-trade-growth-limit g:= gl-trade-active-count)
	(up-modify-goal gl-trade-growth-limit c:* 2)
	(up-modify-goal gl-trade-growth-limit c:+ 3)
	(chat-local-to-self "merchant land route action verified")
	(up-modify-sn sn-focus-player-number g:= gl-trade-route-focus)
	(up-modify-goal gl-trade-route-next g:= gl-game-time)
	(up-modify-goal gl-trade-route-next c:+ 15)
	(set-goal gl-trade-route-state TRADE-ROUTE-IDLE)
)

(defrule
	(goal gl-trade-route-state TRADE-ROUTE-ACTION-PROOF-CHECK)
	(not (up-set-target-object search-local c: 0))
=>
	(set-goal gl-land-trade-route NO)
	(set-goal gl-trade-action-verified NO)
	(set-goal gl-trade-active-count 0)
	(set-goal gl-trade-growth-limit 3)
	(chat-local-to-self "merchant land route idle")
	(up-modify-sn sn-focus-player-number g:= gl-trade-route-focus)
	(up-modify-goal gl-trade-route-next g:= gl-game-time)
	(up-modify-goal gl-trade-route-next c:+ 30)
	(set-goal gl-trade-route-state TRADE-ROUTE-IDLE)
)

(defrule
	(current-age >= early-antiquity-age)
	(goal team-game YES)
	(player-in-game any-ally)
	(goal gl-trade-route-state TRADE-ROUTE-IDLE)
	(up-compare-goal gl-game-time g:>= gl-trade-route-next)
	(goal gl-island-colony-established NO)
=>
	(up-modify-goal gl-trade-route-focus s:= sn-focus-player-number)
	(up-modify-goal gl-trade-land-zone g:= gl-home-zone)
	(set-goal gl-land-trade-route NO)
	(set-goal gl-water-trade-route NO)
	(set-goal gl-trade-action-verified NO)
	(set-goal gl-trade-active-count 0)
	(set-goal gl-trade-growth-limit 3)
	(set-goal gl-trade-own-producer-total 0)
	(set-goal gl-trade-valid-producer-total 0)
	(set-strategic-number sn-focus-player-number my-player-number)
	(up-full-reset-search)
	(up-set-target-point gl-home-anchor-x)
	(up-filter-status c: status-ready c: list-active)
	(up-find-local c: market c: 20)
	(up-get-search-state local-total)
	(up-modify-goal gl-trade-own-producer-total g:= local-total)
	(up-remove-objects search-local object-data-map-zone-id g:!= gl-trade-land-zone)
	(up-get-search-state local-total)
	(up-modify-goal gl-trade-valid-producer-total g:= local-total)
	(up-clean-search search-local object-data-distance search-order-asc)
	(up-modify-sn sn-focus-player-number g:= gl-trade-route-focus)
	(set-goal gl-trade-route-state TRADE-ROUTE-LAND-SOURCE)
)

(defrule
	(current-age >= early-antiquity-age)
	(goal team-game YES)
	(player-in-game any-ally)
	(goal gl-trade-route-state TRADE-ROUTE-IDLE)
	(up-compare-goal gl-game-time g:>= gl-trade-route-next)
	(goal gl-island-colony-established YES)
=>
	(up-modify-goal gl-trade-route-focus s:= sn-focus-player-number)
	(up-modify-goal gl-trade-land-zone g:= gl-island-colony-zone)
	(set-goal gl-land-trade-route NO)
	(set-goal gl-water-trade-route NO)
	(set-goal gl-trade-action-verified NO)
	(set-goal gl-trade-active-count 0)
	(set-goal gl-trade-growth-limit 3)
	(set-goal gl-trade-own-producer-total 0)
	(set-goal gl-trade-valid-producer-total 0)
	(set-strategic-number sn-focus-player-number my-player-number)
	(up-full-reset-search)
	(up-set-target-point gl-island-colony-x)
	(up-filter-status c: status-ready c: list-active)
	(up-find-local c: market c: 20)
	(up-get-search-state local-total)
	(up-modify-goal gl-trade-own-producer-total g:= local-total)
	(up-remove-objects search-local object-data-map-zone-id g:!= gl-trade-land-zone)
	(up-get-search-state local-total)
	(up-modify-goal gl-trade-valid-producer-total g:= local-total)
	(up-clean-search search-local object-data-distance search-order-asc)
	(up-modify-sn sn-focus-player-number g:= gl-trade-route-focus)
	(set-goal gl-trade-route-state TRADE-ROUTE-LAND-SOURCE)
)

(defrule
	(goal gl-trade-route-state TRADE-ROUTE-LAND-SOURCE)
	(up-set-target-object search-local c: 0)
	(up-compare-goal gl-trade-valid-producer-total g:== gl-trade-own-producer-total)
=>
	(up-find-player ally find-ordered gl-trade-route-player)
	(up-modify-goal gl-trade-route-first g:= gl-trade-route-player)
	(set-goal gl-trade-route-state TRADE-ROUTE-LAND-START)
)

(defrule
	(goal gl-trade-route-state TRADE-ROUTE-LAND-SOURCE)
	(or
		(not (up-set-target-object search-local c: 0))
		(up-compare-goal gl-trade-valid-producer-total g:!= gl-trade-own-producer-total)
	)
=>
	(set-strategic-number sn-focus-player-number my-player-number)
	(up-full-reset-search)
	(up-set-target-point gl-home-anchor-x)
	(up-filter-status c: status-ready c: list-active)
	(up-find-local c: dock c: 20)
	(up-get-search-state local-total)
	(up-modify-goal gl-trade-own-producer-total g:= local-total)
	(up-clean-search search-local object-data-distance search-order-asc)
	(up-modify-sn sn-focus-player-number g:= gl-trade-route-focus)
	(set-goal gl-trade-route-state TRADE-ROUTE-WATER-SOURCE)
)

(defrule
	(goal gl-trade-route-state TRADE-ROUTE-LAND-START)
=>
	(up-modify-sn sn-focus-player-number g:= gl-trade-route-player)
	(up-full-reset-search)
	(up-set-target-point gl-home-anchor-x)
	(up-filter-status c: status-ready c: list-active)
	(up-find-remote c: market c: 20)
	(up-remove-objects search-remote object-data-map-zone-id g:!= gl-trade-land-zone)
	(up-clean-search search-remote object-data-distance search-order-asc)
	(up-modify-sn sn-focus-player-number g:= gl-trade-route-focus)
	(set-goal gl-trade-route-state TRADE-ROUTE-LAND-CHECK)
)

(defrule
	(goal gl-trade-route-state TRADE-ROUTE-LAND-CHECK)
	(up-set-target-object search-remote c: 0)
=>
	(set-goal gl-land-trade-route YES)
	(set-goal gl-trade-route-failures 0)
	(up-modify-goal gl-trade-route-next g:= gl-game-time)
	(up-modify-goal gl-trade-route-next c:+ 90)
	(up-chat-data-to-self "reachable ally land trade: %d" g: gl-trade-route-player)
	(set-goal gl-trade-route-state TRADE-ROUTE-IDLE)
)

(defrule
	(goal gl-trade-route-state TRADE-ROUTE-LAND-CHECK)
	(not (up-set-target-object search-remote c: 0))
=>
	(set-goal gl-trade-route-state TRADE-ROUTE-LAND-ADVANCE)
)

(defrule
	(goal gl-trade-route-state TRADE-ROUTE-LAND-ADVANCE)
=>
	(up-find-next-player ally find-ordered gl-trade-route-player)
	(set-goal gl-trade-route-state TRADE-ROUTE-LAND-NEXT)
)

(defrule
	(goal gl-trade-route-state TRADE-ROUTE-LAND-NEXT)
	(up-compare-goal gl-trade-route-player g:!= gl-trade-route-first)
=>
	(set-goal gl-trade-route-state TRADE-ROUTE-LAND-START)
)

(defrule
	(goal gl-trade-route-state TRADE-ROUTE-LAND-NEXT)
	(up-compare-goal gl-trade-route-player g:== gl-trade-route-first)
=>
	(set-strategic-number sn-focus-player-number my-player-number)
	(up-full-reset-search)
	(up-set-target-point gl-home-anchor-x)
	(up-filter-status c: status-ready c: list-active)
	(up-find-local c: dock c: 20)
	(up-get-search-state local-total)
	(up-modify-goal gl-trade-own-producer-total g:= local-total)
	(up-clean-search search-local object-data-distance search-order-asc)
	(up-modify-sn sn-focus-player-number g:= gl-trade-route-focus)
	(set-goal gl-trade-route-state TRADE-ROUTE-WATER-SOURCE)
)

(defrule
	(goal gl-trade-route-state TRADE-ROUTE-WATER-SOURCE)
	(up-set-target-object search-local c: 0)
=>
	(up-get-object-data object-data-map-zone-id gl-trade-water-zone)
	(up-remove-objects search-local object-data-map-zone-id g:!= gl-trade-water-zone)
	(up-get-search-state local-total)
	(up-modify-goal gl-trade-valid-producer-total g:= local-total)
	(set-goal gl-trade-route-state TRADE-ROUTE-WATER-VALIDATE-SOURCE)
)

(defrule
	(goal gl-trade-route-state TRADE-ROUTE-WATER-VALIDATE-SOURCE)
	(up-compare-goal gl-trade-valid-producer-total g:== gl-trade-own-producer-total)
=>
	(up-find-player ally find-ordered gl-trade-route-player)
	(up-modify-goal gl-trade-route-first g:= gl-trade-route-player)
	(set-goal gl-trade-route-state TRADE-ROUTE-WATER-START)
)

(defrule
	(goal gl-trade-route-state TRADE-ROUTE-WATER-VALIDATE-SOURCE)
	(up-compare-goal gl-trade-valid-producer-total g:!= gl-trade-own-producer-total)
=>
	(up-modify-goal gl-trade-route-failures c:+ 1)
	(up-chat-data-to-self "trade water source valid: %d" g: gl-trade-valid-producer-total)
	(up-chat-data-to-self "trade water source total: %d" g: gl-trade-own-producer-total)
	(up-modify-sn sn-focus-player-number g:= gl-trade-route-focus)
	(up-modify-goal gl-trade-route-next g:= gl-game-time)
	(up-modify-goal gl-trade-route-next c:+ 60)
	(set-goal gl-trade-route-state TRADE-ROUTE-IDLE)
)

(defrule
	(goal gl-trade-route-state TRADE-ROUTE-WATER-SOURCE)
	(not (up-set-target-object search-local c: 0))
=>
	(up-modify-goal gl-trade-route-failures c:+ 1)
	(up-chat-data-to-self "trade water source missing: %d" g: gl-trade-route-failures)
	(up-modify-sn sn-focus-player-number g:= gl-trade-route-focus)
	(up-modify-goal gl-trade-route-next g:= gl-game-time)
	(up-modify-goal gl-trade-route-next c:+ 60)
	(set-goal gl-trade-route-state TRADE-ROUTE-IDLE)
)

(defrule
	(goal gl-trade-route-state TRADE-ROUTE-WATER-START)
=>
	(up-modify-sn sn-focus-player-number g:= gl-trade-route-player)
	(up-full-reset-search)
	(up-set-target-point gl-home-anchor-x)
	(up-filter-status c: status-ready c: list-active)
	(up-find-remote c: dock c: 20)
	(up-remove-objects search-remote object-data-map-zone-id g:!= gl-trade-water-zone)
	(up-clean-search search-remote object-data-distance search-order-asc)
	(up-modify-sn sn-focus-player-number g:= gl-trade-route-focus)
	(set-goal gl-trade-route-state TRADE-ROUTE-WATER-CHECK)
)

(defrule
	(goal gl-trade-route-state TRADE-ROUTE-WATER-CHECK)
	(up-set-target-object search-remote c: 0)
=>
	(set-goal gl-water-trade-route YES)
	(set-goal gl-trade-route-failures 0)
	(up-modify-goal gl-trade-route-next g:= gl-game-time)
	(up-modify-goal gl-trade-route-next c:+ 90)
	(up-chat-data-to-self "reachable ally water trade: %d" g: gl-trade-route-player)
	(set-goal gl-trade-route-state TRADE-ROUTE-IDLE)
)

(defrule
	(goal gl-trade-route-state TRADE-ROUTE-WATER-CHECK)
	(not (up-set-target-object search-remote c: 0))
=>
	(set-goal gl-trade-route-state TRADE-ROUTE-WATER-ADVANCE)
)

(defrule
	(goal gl-trade-route-state TRADE-ROUTE-WATER-ADVANCE)
=>
	(up-find-next-player ally find-ordered gl-trade-route-player)
	(set-goal gl-trade-route-state TRADE-ROUTE-WATER-NEXT)
)

(defrule
	(goal gl-trade-route-state TRADE-ROUTE-WATER-NEXT)
	(up-compare-goal gl-trade-route-player g:!= gl-trade-route-first)
=>
	(set-goal gl-trade-route-state TRADE-ROUTE-WATER-START)
)

(defrule
	(goal gl-trade-route-state TRADE-ROUTE-WATER-NEXT)
	(up-compare-goal gl-trade-route-player g:== gl-trade-route-first)
=>
	(up-modify-goal gl-trade-route-failures c:+ 1)
	(up-chat-data-to-self "trade no shared water zone: %d" g: gl-trade-route-failures)
	(up-modify-sn sn-focus-player-number g:= gl-trade-route-focus)
	(up-modify-goal gl-trade-route-next g:= gl-game-time)
	(up-modify-goal gl-trade-route-next c:+ 60)
	(set-goal gl-trade-route-state TRADE-ROUTE-IDLE)
)

(defrule
	(goal gl-land-trade-route YES)
	(goal gl-trade-action-verified YES)
	(building-type-count market g:== gl-trade-own-producer-total)
	(unit-type-count-total trade-cart g:< desired-number-carts)
	(unit-type-count-total trade-cart g:< gl-trade-growth-limit)
	(goal wait-techup-requirements NO)
	(can-train trade-cart)
=>
	(train trade-cart)
)

(defrule
	(goal gl-land-trade-route NO)
	(goal gl-water-trade-route YES)
	(goal gl-trade-action-verified YES)
	(building-type-count dock g:== gl-trade-own-producer-total)
	(or
		(goal map-type LAKE)
		(or
			(goal map-type RIVERS)
			(or
				(goal map-type ISLANDS)
				(goal map-type TEAM-ISLANDS)
			)
		)
	)
	(unit-type-count-total trade-cog g:< desired-number-cogs)
	(unit-type-count-total trade-cog g:< gl-trade-growth-limit)
	(goal wait-techup-requirements NO)
	(wood-amount > 200)
	(can-train trade-cog)
=>
	(train trade-cog)
)

;Endpoint equality is only a candidate. Permit at most three merchant probes
;until the engine proves that one is currently executing actionid-trade.
(defrule
	(goal gl-land-trade-route YES)
	(goal gl-trade-action-verified NO)
	(building-type-count market g:== gl-trade-own-producer-total)
	(unit-type-count-total trade-cart < 3)
	(goal wait-techup-requirements NO)
	(can-train trade-cart)
=>
	(train trade-cart)
)

(defrule
	(goal gl-land-trade-route NO)
	(goal gl-water-trade-route YES)
	(goal gl-trade-action-verified NO)
	(building-type-count dock g:== gl-trade-own-producer-total)
	(unit-type-count-total trade-cog < 3)
	(goal wait-techup-requirements NO)
	(wood-amount > 200)
	(can-train trade-cog)
=>
	(train trade-cog)
)

;The engine's generic train command cannot bind a specific Dock. If three full
;endpoint scans fail on an aquatic team map, allow only a three-ship probe.
;This converts a silent all-game deadlock into bounded evidence without
;committing the economy to an unverified route or relaxing the normal source
;ownership invariant.
(defrule
	(goal team-game YES)
	(player-in-game any-ally)
	(goal gl-land-trade-route NO)
	(goal gl-water-trade-route NO)
	(up-compare-goal gl-trade-route-failures c:>= 3)
	(or
		(goal map-type LAKE)
		(or
			(goal map-type RIVERS)
			(or
				(goal map-type ISLANDS)
				(goal map-type TEAM-ISLANDS)
			)
		)
	)
	(building-type-count dock >= 1)
	(unit-type-count-total trade-cog < 3)
	(up-compare-goal gl-trade-probe-trained c:< 3)
	(goal wait-techup-requirements NO)
	(wood-amount > 200)
	(can-train trade-cog)
=>
	(train trade-cog)
	(up-modify-goal gl-trade-probe-trained c:+ 1)
	(up-chat-data-to-self "bounded trade cog probe: %d" g: gl-trade-route-failures)
)

;A live route, rather than the global Gaia-depletion flag, owns the large-game
;trade transition. At 400 population the route stage means 100 traders and 160
;villagers; sustained local resource pressure raises trade to 160 and retires
;villagers toward 100. Lower population caps use the same bounded percentages.
(defrule
	(current-age == imperial-age)
	(population-cap >= 300)
	(game-time >= 1800)
	(goal gl-trade-transition TRADE-TRANSITION-NONE)
	(goal gl-trade-action-verified YES)
	(or
		(goal gl-land-trade-route YES)
		(goal gl-water-trade-route YES)
	)
=>
	(set-goal gl-trade-transition TRADE-TRANSITION-ROUTE)
	(chat-local-to-self "Verified late trade transition")
)

(defrule
	(goal gl-trade-transition TRADE-TRANSITION-ROUTE)
	(or
		(goal resources-depleted YES)
		(goal gl-home-resource-pressure YES)
	)
=>
	(set-goal gl-trade-transition TRADE-TRANSITION-SCARCE)
	(chat-local-to-self "Verified scarce-economy trade transition")
)

(defrule
	(goal gl-trade-transition TRADE-TRANSITION-ROUTE)
=>
	(up-modify-goal desired-number-villagers g:= gl-fourty-percent)
	(up-modify-goal desired-depleted-villagers g:= gl-fourty-percent)
	(up-modify-goal desired-number-carts g:= gl-twentyfive-percent)
	(up-modify-goal desired-number-cogs g:= gl-twentyfive-percent)
)

(defrule
	(goal gl-trade-transition TRADE-TRANSITION-SCARCE)
=>
	(up-modify-goal desired-number-villagers g:= gl-twentyfive-percent)
	(up-modify-goal desired-depleted-villagers g:= gl-twentyfive-percent)
	(up-modify-goal desired-number-carts g:= gl-fourty-percent)
	(up-modify-goal desired-number-cogs g:= gl-fourty-percent)
)

;If the engine ceases performing trade, restore the ordinary Imperial civilian
;profile before any further retirement. A later live proof may latch it again.
(defrule
	(up-compare-goal gl-trade-transition c:> TRADE-TRANSITION-NONE)
	(or
		(goal gl-trade-action-verified NO)
		(and
			(goal gl-land-trade-route NO)
			(goal gl-water-trade-route NO)
		)
	)
=>
	(set-goal gl-trade-transition TRADE-TRANSITION-NONE)
	(up-modify-goal desired-number-villagers g:= gl-sixty-percent)
	(up-modify-goal desired-depleted-villagers g:= gl-sixty-percent)
	(up-modify-goal desired-number-carts g:= gl-ten-percent)
	(up-modify-goal desired-number-cogs g:= gl-ten-percent)
)

;Retire at most one safe non-food villager every two seconds, and only at an
;actual population block. Three currently active traders are the minimum proof
;that deletion can create useful merchant capacity. Only engine-idle Villagers
;are eligible: deleting an active faraway worker would preferentially destroy
;the remote miners and lumberjacks that make island migration useful.
(defrule
	(goal gl-trade-retirement-state TRADE-RETIRE-IDLE)
	(up-compare-goal gl-trade-transition c:> TRADE-TRANSITION-NONE)
	(up-compare-goal gl-game-time g:>= gl-trade-retirement-next)
	(up-object-type-count-total c: villager-class g:> desired-number-villagers)
	(population-headroom < 2)
	(up-idle-unit-count idle-type-villager >= 1)
	(goal gl-home-defense-state NO)
	(goal gl-island-colony-threat NO)
	(goal gl-island-migration-state MIGRATION-IDLE)
	(goal gl-trade-action-verified YES)
	(up-compare-goal gl-trade-active-count c:>= 3)
	(or
		(goal gl-land-trade-route YES)
		(goal gl-water-trade-route YES)
	)
=>
	(set-goal gl-trade-retirement-state TRADE-RETIRE-SELECT-IDLE)
)

(defrule
	(goal gl-trade-retirement-state TRADE-RETIRE-SELECT-IDLE)
=>
	(set-strategic-number sn-focus-player-number my-player-number)
	(up-full-reset-search)
	(up-set-target-point gl-home-anchor-x)
	(up-find-local c: villager-class c: 240)
	(up-remove-objects search-local object-data-idling != 1)
	(up-remove-objects search-local object-data-garrisoned == 1)
	(up-remove-objects search-local object-data-group-flag >= 0)
	(up-remove-objects search-local object-data-language-id == lid-villager-farmer)
	(up-remove-objects search-local object-data-language-id == lid-villager-fisherman)
	(up-remove-objects search-local object-data-language-id == lid-villager-shepherd)
	(up-remove-objects search-local object-data-language-id == lid-villager-forager)
	(up-remove-objects search-local object-data-language-id == lid-villager-hunter)
	(up-remove-objects search-local object-data-under-attack > 0)
	(up-clean-search search-local object-data-distance search-order-desc)
	(up-remove-objects search-local object-data-index >= 1)
	(set-goal gl-trade-retirement-state TRADE-RETIRE-CHECK)
)

(defrule
	(goal gl-trade-retirement-state TRADE-RETIRE-CHECK)
	(up-set-target-object search-local c: 0)
	(population-headroom < 2)
	(goal gl-trade-action-verified YES)
	(up-compare-goal gl-trade-active-count c:>= 3)
=>
	(up-target-point position-self-x action-delete -1 stance-no-attack)
	(up-modify-goal gl-trade-retirement-next g:= gl-game-time)
	(up-modify-goal gl-trade-retirement-next c:+ 2)
	(set-goal gl-trade-retirement-state TRADE-RETIRE-IDLE)
)

(defrule
	(not (goal gl-trade-retirement-state TRADE-RETIRE-IDLE))
	(or
		(goal gl-trade-action-verified NO)
		(population-headroom >= 2)
	)
=>
	(up-modify-goal gl-trade-retirement-next g:= gl-game-time)
	(up-modify-goal gl-trade-retirement-next c:+ 2)
	(set-goal gl-trade-retirement-state TRADE-RETIRE-IDLE)
)

(defrule
	(goal gl-trade-retirement-state TRADE-RETIRE-CHECK)
	(not (up-set-target-object search-local c: 0))
=>
	(up-modify-goal gl-trade-retirement-next g:= gl-game-time)
	(up-modify-goal gl-trade-retirement-next c:+ 2)
	(set-goal gl-trade-retirement-state TRADE-RETIRE-IDLE)
)

;Global depletion still raises a route that was already verified in small games.
;These remain live because a colony can later connect the AI to allies by land.
(defrule
	(goal resources-depleted YES)
	(goal gl-land-trade-route YES)
	(goal gl-trade-action-verified YES)
=>
	(up-modify-goal desired-number-carts g:= gl-fourty-percent)
)

(defrule
	(goal resources-depleted YES)
	(goal gl-land-trade-route NO)
	(goal gl-water-trade-route YES)
	(goal gl-trade-action-verified YES)
=>
	(up-modify-goal desired-number-cogs g:= gl-fourty-percent)
)

;Cow trainable from Mill due to Pict team bonus
(defrule
	(food-amount > 50)
	(wood-amount > 50)
	(up-compare-goal gl-pict-cow-requests c:< 4)
	(unit-type-count-total mill-cow g:< gl-one-percent)
	(can-train mill-cow)
=>
	(train mill-cow)
	(up-modify-goal gl-pict-cow-requests c:+ 1)
)

;Fish traps and sea towers need work before these are useful, atm they just stop villagers from doing construction projects
;(defrule
;	(unit-type-count-total construction-ship == 0)
;	(can-train construction-ship)
;=>
;	(train construction-ship)
;)

;Do not delete resource Camps through delete-building: that command cannot
;select the depleted camp and can erase the productive remote camp instead.
;Targeted object-ID deletion can be added once per-zone depletion is tracked.

;Trim fishing fleets when their fishing grounds shrink.

(defrule
	(up-timer-status t-update-facts == timer-triggered)
	(unit-type-count fishing-ship g:> desired-number-fishing)
=>
	(delete-unit fishing-ship)
)

(defrule
	(and
		(goal fish-present NO)
		(building-type-count-total fish-trap <= 0)
	)
	(up-timer-status t-update-facts == timer-triggered)
	(unit-type-count fishing-ship > 0)
=>
	(delete-unit fishing-ship)
)

(defrule
	(goal fish-present YES)
	(cc-players-unit-type-count 0 ocean-fish-class < 4)
	(cc-players-unit-type-count 0 shore-fish-class < 4)
	(up-timer-status t-update-facts == timer-triggered)
	(unit-type-count fishing-ship > 2)
=>
	(delete-unit fishing-ship)
)

(defrule
	(goal fish-present YES)
	(cc-players-unit-type-count 0 ocean-fish-class < 10)
	(cc-players-unit-type-count 0 shore-fish-class < 10)
	(or
		(cc-players-unit-type-count 0 ocean-fish-class >= 4)
		(cc-players-unit-type-count 0 shore-fish-class >= 4)
	)
	(up-timer-status t-update-facts == timer-triggered)
	(unit-type-count fishing-ship > 4)
=>
	(delete-unit fishing-ship)
)

;count units for goals

(defrule
	(up-timer-status t-check-vills == timer-triggered)
=>
	(up-get-fact unit-type-count villager gl-current-villagers)
	(up-modify-goal gl-past-villagers g:= gl-current-villagers)
	(up-chat-data-to-self "previous villagers: %d." g: gl-previous-villagers)
	(up-chat-data-to-self "current villagers: %d." g: gl-current-villagers)
)

(defrule
	(up-timer-status t-check-vills == timer-triggered)
	(up-compare-goal gl-current-villagers g:> gl-previous-villagers)
=>
	(up-modify-goal gl-villager-counter g:= gl-current-villagers)
	(up-modify-goal gl-villager-counter g:- gl-previous-villagers)
	(up-modify-goal gl-trained-villagers g:+ gl-villager-counter)
	(up-modify-goal gl-villager-counter c:= 0)
	(up-modify-goal gl-previous-villagers g:= gl-past-villagers)
	(up-chat-data-to-self "starting villagers: %d." g: gl-starting-villagers)
	(up-chat-data-to-self "trained villagers: %d." g: gl-trained-villagers)
)

(defrule
	(up-timer-status t-check-vills == timer-triggered)
	(up-compare-goal gl-trained-villagers c:> 0)
=>
	(up-modify-goal gl-trained-villagers g:- gl-starting-villagers)
	(up-chat-data-to-self "removed starting villagers from trained villagers, trained villagers: %d." g: gl-trained-villagers)
	
	(disable-self)
)
