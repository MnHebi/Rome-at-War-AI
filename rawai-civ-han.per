;enemy-specific opening adjustments
;Only rushes configured for the active difficulty profile are adjusted.
;Positive values exploit the enemy doctrine; negative values avoid its counters.

#load-if-defined UP-BERBERS-CIV-ENEMY ; Armenians

#load-if-not-defined DIFFICULTY-EXTREME
;Respond to enemy doctrine: armored cavalry supported by mounted missiles and clergy.
(defrule
	(true)
=>
	(up-modify-goal sprush-affinity c:+ 2)
	(up-modify-goal sgush-affinity c:- 1)
	(up-modify-goal fc-affinity c:- 1)

	(disable-self)
)
#end-if

