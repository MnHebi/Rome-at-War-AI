
(defrule
	(up-timer-status t-taunt-spam != timer-running)
=>
	(enable-timer t-taunt-spam 120)
	(set-goal dont-spam-taunts NO)
	(chat-local-to-self "start taunt spam timer")
)

;Only a freshly verified victim/hostile event can produce an attack claim.
;Ordinary incursion defense remains independent of this request policy.
(defrule
	(goal dont-spam-taunts NO)
	(goal gl-self-attack-verified YES)
	(or (up-compare-goal military-superiority c:<= 1)
	    (up-compare-goal gl-local-response-responders c:<= 0))
=>
	(chat-to-allies "48 My settlement is under attack; I need reinforcements!")
	(up-chat-data-to-all str-t12-diag-id c: 300)
	(up-chat-data-to-all str-t12-diag-value g: gl-t12-help-kind)
	(up-chat-data-to-all str-t12-diag-id c: 301)
	(up-chat-data-to-all str-t12-diag-value g: gl-t12-help-asset)
	(up-chat-data-to-all str-t12-diag-id c: 302)
	(up-chat-data-to-all str-t12-diag-value g: gl-t12-help-hostile)
	(up-chat-data-to-all str-t12-diag-id c: 303)
	(up-chat-data-to-all str-t12-diag-value g: gl-t12-help-anchor-x)
	(up-chat-data-to-all str-t12-diag-id c: 304)
	(up-chat-data-to-all str-t12-diag-value g: gl-t12-help-anchor-y)
	(up-chat-data-to-all str-t12-diag-id c: 305)
	(up-chat-data-to-all str-t12-diag-value g: gl-verify-asset-x)
	(up-chat-data-to-all str-t12-diag-id c: 306)
	(up-chat-data-to-all str-t12-diag-value g: gl-verify-asset-y)
	(up-chat-data-to-all str-t12-diag-id c: 307)
	(up-chat-data-to-all str-t12-diag-value g: gl-verify-enemy)
	(up-chat-data-to-all str-t12-diag-id c: 308)
	(up-chat-data-to-all str-t12-diag-value g: gl-verify-zone)
	(up-chat-data-to-all str-t12-diag-id c: 309)
	(up-chat-data-to-all str-t12-diag-value g: gl-t12-help-time)
	(up-chat-data-to-all str-t12-diag-id c: 310)
	(up-chat-data-to-all str-t12-diag-value g: gl-local-response-threats)
	(up-chat-data-to-all str-t12-diag-id c: 311)
	(up-chat-data-to-all str-t12-diag-value g: gl-local-response-responders)
	(set-goal dont-spam-taunts YES)
	(enable-timer t-taunt-spam 120)
)

