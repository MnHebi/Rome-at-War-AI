
(defrule
	(up-timer-status t-taunt-spam != timer-running)
=>
	(enable-timer t-taunt-spam 120)
	(set-goal dont-spam-taunts NO)
	(chat-local-to-self "start taunt spam timer")
)

(defrule
	(goal dont-spam-taunts NO)
	(up-compare-goal military-superiority c:<= 1)
	(and
		(up-enemy-units-in-town c:>= 5)
		(goal town-size-attack NO)
	)
=>
	(chat-to-allies "48 I'm under attack, I need immediate reinforcements!")
	(set-goal dont-spam-taunts YES)
)

;The formal town fact misses attacked colonies, wall sites, and small raiding
;parties. A sustained local threat with no same-zone responder is the stronger
;reason to ask teammates for relief, independent of the global team ratio.
(defrule
	(goal dont-spam-taunts NO)
	(goal gl-local-threat-active YES)
	(up-compare-goal gl-local-response-threats c:>= 1)
	(up-compare-goal gl-local-response-responders c:<= 0)
=>
	(chat-to-allies "48 I'm under attack and have no local defenders!")
	(set-goal dont-spam-taunts YES)
)

