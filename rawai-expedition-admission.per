(defrule
	(true)
=>
	(up-get-fact game-time 0 gl-exp-clock)
	(set-goal gl-exp-next 0)
	(set-goal gl-exp-until 0)
	(set-goal gl-exp-allowed NO)
	(set-goal gl-exp-stage 0)
	(up-modify-goal gl-exp-safe-after g:= gl-exp-clock)
	(up-modify-goal gl-exp-safe-after c:+ 180)
	(set-goal gl-exp-reported -1)
	(set-goal gl-exp-diag-next 0)
	(set-goal gl-exp-life-left 24)
	(set-goal gl-exp-life-next 0)
	(set-goal gl-exp-life-budget-reported 0)
	(disable-self)
)

