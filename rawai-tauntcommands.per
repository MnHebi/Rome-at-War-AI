(defrule
	(goal gl-home-defense-state YES)
	(taunt-detected any-ally 48)
=>
	(acknowledge-taunt this-any-ally 48)
	(chat-to-allies "39 I cannot spare troops while my own town is under attack.")
)

;The AI's own help call also reaches its own taunt detector. Ignore it so a
;player never dispatches its own relief flow in answer to its own request.
(defrule
	(goal gl-ally-help-state ALLY-HELP-FIND-ASSET)
	(up-compare-goal gl-ally-help-player g:== gl-self-player-number)
=>
	(set-goal gl-ally-help-player -1)
	(set-goal gl-ally-help-state ALLY-HELP-IDLE)
)

;rawai-attack-verification resolves actual threatened assets; original TC memory
;is not a relief destination substitute. Failure reports remain bounded.
(defrule
	(goal gl-ally-help-state ALLY-HELP-NEXT-THREAT)
=>
	(up-modify-sn sn-focus-player-number g:= gl-ally-help-focus)
	(chat-to-allies "39 I cannot verify a reachable attack on that ally.")
	(up-chat-data-to-all str-t12-diag-id c: 320)
	(up-chat-data-to-all str-t12-diag-value g: gl-ally-help-player)
	(up-chat-data-to-all str-t12-diag-id c: 321)
	(up-chat-data-to-all str-t12-diag-value c: 1)
	(up-chat-data-to-all str-t12-diag-id c: 322)
	(up-chat-data-to-all str-t12-diag-value g: gl-ally-help-target-x)
	(up-chat-data-to-all str-t12-diag-id c: 323)
	(up-chat-data-to-all str-t12-diag-value g: gl-ally-help-target-y)
	(up-chat-data-to-all str-t12-diag-id c: 324)
	(up-chat-data-to-all str-t12-diag-value g: gl-ally-help-zone)
	(set-goal gl-ally-help-player -1)
	(set-goal gl-ally-help-state ALLY-HELP-IDLE)
)

;Rebuild after the shared verifier/military pass, before touching responder lists.
(defrule
	(goal gl-ally-help-state ALLY-HELP-FIND-RESPONDERS)
=>
	(up-modify-sn sn-focus-player-number g:= gl-owner-relief-player)
	(up-full-reset-search)
	(up-add-object-by-id search-remote g: gl-owner-relief-target)
	(up-remove-objects search-remote object-data-player g:!= gl-owner-relief-player)
	(up-remove-objects search-remote object-data-action != actionid-attack)
	(up-remove-objects search-remote object-data-target-id g:!= gl-ally-help-asset)
	(up-set-target-point gl-ally-help-target-x)
	(up-remove-objects search-remote object-data-distance > 48)
	(up-remove-objects search-remote object-data-map-zone-id g:!= gl-ally-help-zone)
	(up-modify-sn sn-focus-player-number g:= gl-ally-help-focus)
)


(defrule
	(goal gl-ally-help-state ALLY-HELP-FIND-RESPONDERS)
	(up-set-target-object search-remote c: 0)
	(up-object-target-data object-data-player g:== gl-ally-help-player)
=>
	(set-strategic-number sn-focus-player-number my-player-number)
	;Preserve the verified hostile as search-remote while rebuilding own sources.
	(up-reset-search 1 1 0 0)
	(up-set-target-point gl-ally-help-target-x)
	(up-filter-distance c: -1 c: 96)
	(up-find-local c: scout-cavalry-class c: 40)
	(up-find-local c: cavalry-archer-class c: 40)
	(up-find-local c: cavalry-class c: 40)
	(up-find-local c: infantry-class c: 40)
	(up-find-local c: archery-class c: 40)
	(up-find-local c: siege-weapon-class c: 40)
	(up-remove-objects search-local object-data-type == palintonon)
	(up-remove-objects search-local object-data-type == palintonon-packed)
	(up-remove-objects search-local object-data-garrisoned == 1)
	(up-remove-objects search-local object-data-under-attack > 0)
	(up-remove-objects search-local object-data-group-flag >= 0)
	(up-remove-objects search-local object-data-idling != 1)
	(up-remove-objects search-local object-data-map-zone-id g:!= gl-ally-help-zone)
	(up-clean-search search-local object-data-distance search-order-asc)
	(up-remove-objects search-local object-data-index >= 12)
	(up-get-search-state local-total)
	(up-modify-goal gl-ally-help-responders g:= local-total)
	(set-goal gl-ally-help-state ALLY-HELP-DISPATCH)
)

(defrule
	(goal gl-ally-help-state ALLY-HELP-FIND-RESPONDERS)
=>
	(up-modify-sn sn-focus-player-number g:= gl-ally-help-focus)
	(chat-to-allies "39 The attacker is no longer at the reported position.")
	(up-chat-data-to-all str-t12-diag-id c: 320)
	(up-chat-data-to-all str-t12-diag-value g: gl-ally-help-player)
	(up-chat-data-to-all str-t12-diag-id c: 321)
	(up-chat-data-to-all str-t12-diag-value c: 2)
	(up-chat-data-to-all str-t12-diag-id c: 322)
	(up-chat-data-to-all str-t12-diag-value g: gl-ally-help-target-x)
	(up-chat-data-to-all str-t12-diag-id c: 323)
	(up-chat-data-to-all str-t12-diag-value g: gl-ally-help-target-y)
	(up-chat-data-to-all str-t12-diag-id c: 324)
	(up-chat-data-to-all str-t12-diag-value g: gl-ally-help-zone)
	(set-goal gl-ally-help-player -1)
	(set-goal gl-ally-help-state ALLY-HELP-IDLE)
)

