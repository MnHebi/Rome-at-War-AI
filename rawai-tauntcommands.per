	(goal gl-ally-help-state ALLY-HELP-IDLE)
	(goal gl-home-defense-state NO)
	(taunt-detected 2 48)
	(stance-toward 2 ally)
=>
	(acknowledge-taunt 2 48)
	(set-goal gl-ally-help-player 2)
	(set-goal gl-ally-help-state ALLY-HELP-FIND-ASSET)
)

