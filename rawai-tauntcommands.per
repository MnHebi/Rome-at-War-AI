(defrule
	(goal gl-ally-help-state ALLY-HELP-DISPATCH)
	(goal gl-home-defense-state NO)
	(up-compare-goal gl-ally-help-responders c:> 0)
	(up-set-target-object search-remote c: 0)
=>
	;OWNERSHIP acquire/revalidate: FREE -> ALLIED-RELIEF.
	(up-remove-objects search-local object-data-player != my-player-number)
	(up-remove-objects search-local object-data-group-flag >= 0)
	(up-remove-objects search-local object-data-idling != 1)
	(up-create-group 0 0 c: allied-relief-group)
	(up-modify-group-flag 1 c: allied-relief-group)
	(up-reset-search 0 0 1 1)
	(up-add-object-by-id search-remote g: gl-owner-relief-target)
	(up-remove-objects search-remote object-data-player g:!= gl-owner-relief-player)
	(up-remove-objects search-remote object-data-status != status-ready)
	(up-set-target-point gl-ally-help-target-x)
	(up-remove-objects search-remote object-data-distance > 48)
	(up-remove-objects search-remote object-data-map-zone-id g:!= gl-ally-help-zone)
	(set-goal gl-ally-help-state ALLY-HELP-OWNERSHIP-COMMAND)
)

(defrule
	(goal gl-ally-help-state ALLY-HELP-OWNERSHIP-COMMAND)
=>
	(up-remove-objects search-remote object-data-action != actionid-attack)
	(up-remove-objects search-remote object-data-target-id g:!= gl-ally-help-asset)
	(up-set-group search-local c: allied-relief-group)
	(up-remove-objects search-local object-data-player != my-player-number)
	(up-remove-objects search-local object-data-group-flag != allied-relief-group)
	(up-get-search-state local-total)
	(up-modify-goal gl-ally-help-responders g:= local-total)
)

(defrule
	(goal gl-ally-help-state ALLY-HELP-OWNERSHIP-COMMAND)
	(up-set-target-object search-remote c: 0)
	(not (up-object-target-data object-data-player g:== gl-ally-help-player))
=>
	;Conversion/target change invalidates the claim before the promise/order.
	(up-reset-search 0 0 1 1)
)

