;31 "Attack an enemy now"
;CB BEGIN 1827
(defrule
	(goal gl-home-defense-state NO)
	(goal gl-transport-route-state TRANSPORT-ROUTE-IDLE)
	(taunt-detected any-ally 31)
=>
	(set-goal gl-cbf-cont 1827)
)
(defrule
	(goal gl-cbf-cont 1827)
=>
	(acknowledge-taunt this-any-ally 31)
	(chat-local-to-self "land attack, response to taunt 31")
	(set-goal current-action ACTION-ATTACK)
	(set-goal gl-attack-dispatch-owner ATTACK-DISPATCH-COMPLETE)
	(up-modify-sn sn-percent-attack-soldiers g:= land-attack-percentage)
	(up-modify-sn sn-percent-attack-boats g:= naval-attack-percentage)
	(up-modify-sn sn-maximum-town-size c:= 250)
)
(defrule
	(goal gl-cbf-cont 1827)
=>
	(set-goal gl-cbf-site 1827)
	(set-goal gl-cbf-kind 3)
	(set-goal gl-cbf-args0 -2)
	(set-goal gl-cbf-args1 -2)
	(set-goal gl-cbf-args2 -2)
	(set-goal gl-cbf-args3 -2)
	(set-goal gl-cbf-point-y -2)
	(up-get-rule-id gl-cbf-return)
	(up-modify-goal gl-cbf-return c:+ 1)
	(up-jump-direct g: gl-cbf-entry)
)
(defrule
	(goal gl-cbf-cont 1827)
=>
	(attack-now)
)
(defrule
	(goal gl-cbf-cont 1827)
=>
	(set-goal gl-cbf-site 1827)
	(set-goal gl-cbf-kind 2)
	(set-goal gl-cbf-args0 -2)
	(set-goal gl-cbf-args1 -2)
	(set-goal gl-cbf-args2 -2)
	(set-goal gl-cbf-args3 -2)
	(set-goal gl-cbf-point-y -2)
	(up-get-rule-id gl-cbf-return)
	(up-modify-goal gl-cbf-return c:+ 1)
	(up-jump-direct g: gl-cbf-entry)
)
(defrule
	(goal gl-cbf-cont 1827)
=>
	(up-modify-sn sn-maximum-town-size g:= outer-townsize)
	(set-strategic-number sn-percent-attack-soldiers 0)
	(set-strategic-number sn-percent-attack-boats 0)
	(chat-to-allies "39 Yes my liege, attacking now")
)
(defrule
	(goal gl-cbf-cont 1827)
=>
	(set-goal gl-cbf-cont 0)
)
;CB END 1827

;45 "Retreat now!"

;CB BEGIN 1828
(defrule
	(taunt-detected any-ally 45)
=>
	(set-goal gl-cbf-cont 1828)
)
(defrule
	(goal gl-cbf-cont 1828)
=>
	(acknowledge-taunt this-any-ally 45)
	(up-full-reset-search)
	(up-set-target-point gl-home-anchor-x)
	(up-find-local c: scout-cavalry-class c: 40)
	(up-find-local c: cavalry-archer-class c: 40)
	(up-find-local c: cavalry-class c: 40)
	(up-find-local c: infantry-class c: 40)
	(up-find-local c: archery-class c: 40)
	(up-find-local c: siege-weapon-class c: 40)
	(up-remove-objects search-local object-data-group-flag >= 0)
	(up-remove-objects search-local object-data-player != my-player-number)
	(up-remove-objects search-local object-data-map-zone-id g:!= gl-home-zone)
)
(defrule
	(goal gl-cbf-cont 1828)
=>
	(set-goal gl-cbf-site 1828)
	(set-goal gl-cbf-kind 1)
	(up-modify-goal gl-cbf-args0 g:= gl-home-anchor-x)
	(set-goal gl-cbf-args1 action-move)
	(set-goal gl-cbf-args2 -1)
	(set-goal gl-cbf-args3 stance-defensive)
	(up-modify-goal gl-cbf-point-y g:= gl-home-anchor-y)
	(up-get-rule-id gl-cbf-return)
	(up-modify-goal gl-cbf-return c:+ 1)
	(up-jump-direct g: gl-cbf-entry)
)
(defrule
	(goal gl-cbf-cont 1828)
=>
	(up-target-point gl-home-anchor-x action-move -1 stance-defensive)
)
(defrule
	(goal gl-cbf-cont 1828)
=>
	(set-goal gl-cbf-site 1828)
	(set-goal gl-cbf-kind 2)
	(up-modify-goal gl-cbf-args0 g:= gl-home-anchor-x)
	(set-goal gl-cbf-args1 action-move)
	(set-goal gl-cbf-args2 -1)
	(set-goal gl-cbf-args3 stance-defensive)
	(up-modify-goal gl-cbf-point-y g:= gl-home-anchor-y)
	(up-get-rule-id gl-cbf-return)
	(up-modify-goal gl-cbf-return c:+ 1)
	(up-jump-direct g: gl-cbf-entry)
)
(defrule
	(goal gl-cbf-cont 1828)
=>
	(set-goal gl-cbf-cont 0)
)
;CB END 1828
