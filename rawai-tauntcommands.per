(defrule
	(goal gl-home-defense-state YES)
	(taunt-detected any-ally 48)
=>
	(acknowledge-taunt this-any-ally 48)
	(chat-to-allies "42 I cannot spare troops while my own town is under attack.")
)

;Resolve the requester's attacked asset and the exact hostile beside it.  The
;old handler erased the enemy target and announced help before it had selected
;either a destination or a single responder.
(defrule
	(goal gl-ally-help-state ALLY-HELP-FIND-ASSET)
	(goal gl-home-defense-state NO)
=>
	(up-modify-goal gl-ally-help-focus s:= sn-focus-player-number)
	(up-modify-sn sn-focus-player-number g:= gl-ally-help-player)
	(up-get-point position-focus gl-ally-help-target-x)
	(up-full-reset-search)
	(up-set-target-point gl-ally-help-target-x)
	(up-filter-distance c: -1 c: 255)
	(up-find-remote c: villager-class c: 240)
	(up-find-remote c: town-center c: 20)
	(up-find-remote c: mining-camp c: 20)
	(up-find-remote c: lumber-camp c: 20)
	(up-find-remote c: mill c: 20)
	(up-find-remote c: market c: 10)
	(up-find-remote c: barracks c: 10)
	(up-find-remote c: archery-range c: 10)
	(up-find-remote c: stable c: 10)
	(up-find-remote c: siege-workshop c: 10)
	(up-find-remote c: castle c: 10)
	(up-find-remote c: dock c: 20)
	(up-find-remote c: port c: 20)
	(up-find-remote c: shipyard c: 20)
	;Taunt 48 carries no flare or coordinates. Only a currently attacked allied
	;asset can safely anchor a reinforcement promise; an arbitrary nearest base
	;object could miss an outlying raid or misdirect help to an unrelated threat.
	(up-remove-objects search-remote object-data-under-attack <= 0)
	(up-clean-search search-remote object-data-distance search-order-asc)
	(set-goal gl-ally-help-state ALLY-HELP-FIND-THREAT)
)

(defrule
	(goal gl-ally-help-state ALLY-HELP-FIND-THREAT)
	(up-set-target-object search-remote c: 0)
=>
	(up-get-point position-object gl-ally-help-target-x)
	(up-get-object-data object-data-map-zone-id gl-ally-help-zone)
	;Walk every enemy because find-closest is relative to this AI, not to the
	;retained attacked allied asset.
	(up-find-player enemy find-ordered gl-ally-help-enemy-player)
	(up-modify-goal gl-ally-help-first-enemy g:= gl-ally-help-enemy-player)
	(set-goal gl-ally-help-state ALLY-HELP-SCAN-THREAT)
)

(defrule
	(goal gl-ally-help-state ALLY-HELP-SCAN-THREAT)
=>
	(up-modify-sn sn-focus-player-number g:= gl-ally-help-enemy-player)
	(up-full-reset-search)
	(up-set-target-point gl-ally-help-target-x)
	(up-filter-distance c: -1 c: 32)
	(up-find-remote c: scout-cavalry-class c: 40)
	(up-find-remote c: cavalry-archer-class c: 40)
	(up-find-remote c: cavalry-class c: 40)
	(up-find-remote c: infantry-class c: 40)
	(up-find-remote c: archery-class c: 40)
	(up-find-remote c: siege-weapon-class c: 40)
	(up-find-remote c: priest c: 10)
	(up-remove-objects search-remote object-data-map-zone-id g:!= gl-ally-help-zone)
	(up-clean-search search-remote object-data-distance search-order-asc)
	(up-modify-sn sn-focus-player-number g:= gl-ally-help-focus)
	(set-goal gl-ally-help-state ALLY-HELP-CHECK-THREAT)
)

(defrule
	(goal gl-ally-help-state ALLY-HELP-CHECK-THREAT)
	(up-set-target-object search-remote c: 0)
=>
	(set-goal gl-ally-help-state ALLY-HELP-FIND-RESPONDERS)
)

(defrule
	(goal gl-ally-help-state ALLY-HELP-CHECK-THREAT)
	(not (up-set-target-object search-remote c: 0))
=>
	(set-goal gl-ally-help-state ALLY-HELP-ADVANCE-THREAT)
)

(defrule
	(goal gl-ally-help-state ALLY-HELP-ADVANCE-THREAT)
=>
	(up-find-next-player enemy find-ordered gl-ally-help-enemy-player)
	(set-goal gl-ally-help-state ALLY-HELP-NEXT-THREAT)
)

(defrule
	(goal gl-ally-help-state ALLY-HELP-NEXT-THREAT)
	(up-compare-goal gl-ally-help-enemy-player g:!= gl-ally-help-first-enemy)
=>
	(set-goal gl-ally-help-state ALLY-HELP-SCAN-THREAT)
)

(defrule
	(goal gl-ally-help-state ALLY-HELP-NEXT-THREAT)
	(up-compare-goal gl-ally-help-enemy-player g:== gl-ally-help-first-enemy)
=>
	(up-modify-sn sn-focus-player-number g:= gl-ally-help-focus)
	(chat-to-allies "42 I cannot verify a reachable attack on that ally.")
	(set-goal gl-ally-help-player -1)
	(set-goal gl-ally-help-state ALLY-HELP-IDLE)
)

(defrule
	(goal gl-ally-help-state ALLY-HELP-FIND-THREAT)
	(not (up-set-target-object search-remote c: 0))
=>
	(up-modify-sn sn-focus-player-number g:= gl-ally-help-focus)
	(chat-to-allies "42 I cannot verify a reachable attack on that ally.")
	(set-goal gl-ally-help-player -1)
	(set-goal gl-ally-help-state ALLY-HELP-IDLE)
)

(defrule
	(goal gl-ally-help-state ALLY-HELP-FIND-RESPONDERS)
	(up-set-target-object search-remote c: 0)
=>
	(set-strategic-number sn-focus-player-number my-player-number)
	;Preserve the verified hostile as search-remote while rebuilding own sources.
	(up-reset-search 1 1 0 0)
	(up-set-target-point gl-ally-help-target-x)
	(up-filter-distance c: -1 c: 255)
	(up-find-local c: scout-cavalry-class c: 40)
	(up-find-local c: cavalry-archer-class c: 40)
	(up-find-local c: cavalry-class c: 40)
	(up-find-local c: infantry-class c: 40)
	(up-find-local c: archery-class c: 40)
	(up-find-local c: siege-weapon-class c: 40)
	(up-remove-objects search-local object-data-type == palintonon)
	(up-remove-objects search-local object-data-type == palintonon-packed)
	(up-remove-objects search-local object-data-garrisoned == 1)
	(up-remove-objects search-local object-data-under-attack > 0)
	(up-remove-objects search-local object-data-group-flag >= 0)
	(up-remove-objects search-local object-data-map-zone-id g:!= gl-ally-help-zone)
	(up-clean-search search-local object-data-distance search-order-asc)
	(up-remove-objects search-local object-data-index >= 12)
	(up-get-search-state local-total)
	(up-modify-goal gl-ally-help-responders g:= local-total)
	(set-goal gl-ally-help-state ALLY-HELP-DISPATCH)
)

(defrule
	(goal gl-ally-help-state ALLY-HELP-FIND-RESPONDERS)
	(not (up-set-target-object search-remote c: 0))
=>
	(up-modify-sn sn-focus-player-number g:= gl-ally-help-focus)
	(chat-to-allies "42 The attacker is no longer at the reported position.")
	(set-goal gl-ally-help-player -1)
	(set-goal gl-ally-help-state ALLY-HELP-IDLE)
)

(defrule
	(goal gl-ally-help-state ALLY-HELP-DISPATCH)
	(goal gl-home-defense-state NO)
	(up-compare-goal gl-ally-help-responders c:> 0)
	(up-set-target-object search-remote c: 0)
=>
	(up-target-objects 1 action-default -1 stance-aggressive)
	(up-chat-data-to-self "ally relief responders: %d" g: gl-ally-help-responders)
	;Only now is the original promise true.
	(chat-to-allies "39 Reinforcements have been dispatched to the attacked ally.")
	(up-modify-sn sn-focus-player-number g:= gl-ally-help-focus)
	(set-goal gl-ally-help-player -1)
	(set-goal gl-ally-help-state ALLY-HELP-IDLE)
)

(defrule
	(goal gl-ally-help-state ALLY-HELP-DISPATCH)
	(goal gl-home-defense-state NO)
	(or
		(up-compare-goal gl-ally-help-responders c:<= 0)
		(not (up-set-target-object search-remote c: 0))
	)
=>
	(chat-to-allies "42 I have no reachable spare troops for that position.")
	(up-modify-sn sn-focus-player-number g:= gl-ally-help-focus)
	(set-goal gl-ally-help-player -1)
	(set-goal gl-ally-help-state ALLY-HELP-IDLE)
)

(defrule
	(not (goal gl-ally-help-state ALLY-HELP-IDLE))
	(goal gl-home-defense-state YES)
=>
	(chat-to-allies "42 I cannot spare troops while my own town is under attack.")
	(up-modify-sn sn-focus-player-number g:= gl-ally-help-focus)
	(set-goal gl-ally-help-player -1)
	(set-goal gl-ally-help-state ALLY-HELP-IDLE)
)

;52 "Build a market at the flared location."
(defrule
	(goal target-action NO)
	(taunt-detected any-ally 52)
=>
	(acknowledge-taunt this-any-ally 52)
	(set-goal target-action YES)
	(set-goal market-flare YES)
	(up-jump-rule 1)
)

(defrule
	(goal market-flare YES)
	(goal gl-migration-placement-lock NO)
	(cc-players-unit-type-count any-human-ally flare >= 1)
	(can-build market)
=>
	(up-find-player-flare any-human-ally gl-flared-market-x)
	(up-set-target-point gl-flared-market-x)
	(up-build place-point 0 c: market)
	;(set-goal place-flare-market YES)
	(set-goal market-flare NO)
	(set-goal target-action NO)
	(chat-to-allies "39 Placed the Market you requested.")
)

(defrule
	(goal market-flare YES)
	(cc-players-unit-type-count any-human-ally flare <= 0)
=>
	(set-goal market-flare NO)
	(set-goal target-action NO)
	(chat-local-to-self "No flare detected to place market")
)

;55 "Build a wall around your town"
(defrule
	(taunt-detected any-ally 55)
=>
	(acknowledge-taunt this-any-ally 55)
	(set-goal taunt-wall YES)
	(chat-local-to-self "Request walls, response to taunt")
	(chat-to-allies "39 Very well, I will build a wall around my base.")
	(disable-self)
)

