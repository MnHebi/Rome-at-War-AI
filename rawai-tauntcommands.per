	(goal gl-cbf-cont 1832)
=>
	(up-modify-goal gl-owner-relief-until g:= gl-game-time)
	(up-modify-goal gl-owner-relief-until c:+ 90)
	(up-chat-data-to-self "ally relief responders: %d" g: gl-ally-help-responders)
	(chat-to-allies "39 Reinforcements have been dispatched to the attacked ally.")
	(up-chat-data-to-all str-t12-diag-id c: 320)
	(up-chat-data-to-all str-t12-diag-value g: gl-ally-help-player)
	(up-chat-data-to-all str-t12-diag-id c: 321)
	(up-chat-data-to-all str-t12-diag-value c: 5)
	(up-chat-data-to-all str-t12-diag-id c: 322)
	(up-chat-data-to-all str-t12-diag-value g: gl-ally-help-target-x)
	(up-chat-data-to-all str-t12-diag-id c: 323)
	(up-chat-data-to-all str-t12-diag-value g: gl-ally-help-target-y)
	(up-chat-data-to-all str-t12-diag-id c: 324)
	(up-chat-data-to-all str-t12-diag-value g: gl-ally-help-zone)
	(up-modify-sn sn-focus-player-number g:= gl-ally-help-focus)
	(set-goal gl-ally-help-player -1)
	(set-goal gl-ally-help-state ALLY-HELP-IDLE)
)
(defrule
	(goal gl-cbf-cont 1832)
=>
	(set-goal gl-cbf-cont 0)
)
;CB END 1832

(defrule
	(goal gl-ally-help-state ALLY-HELP-OWNERSHIP-COMMAND)
=>
	(up-modify-group-flag 0 c: allied-relief-group)
	(up-reset-group c: allied-relief-group)
	(up-modify-sn sn-focus-player-number g:= gl-ally-help-focus)
	(set-goal gl-ally-help-player -1)
	(set-goal gl-ally-help-state ALLY-HELP-IDLE)
)

(defrule
	(goal gl-ally-help-state ALLY-HELP-DISPATCH)
	(goal gl-home-defense-state NO)
	(or
		(up-compare-goal gl-ally-help-responders c:<= 0)
		(not (up-set-target-object search-remote c: 0))
	)
=>
	(chat-to-allies "39 I have no reachable spare troops for that position.")
	(up-chat-data-to-all str-t12-diag-id c: 320)
	(up-chat-data-to-all str-t12-diag-value g: gl-ally-help-player)
	(up-chat-data-to-all str-t12-diag-id c: 321)
	(up-chat-data-to-all str-t12-diag-value c: 3)
	(up-chat-data-to-all str-t12-diag-id c: 322)
	(up-chat-data-to-all str-t12-diag-value g: gl-ally-help-target-x)
	(up-chat-data-to-all str-t12-diag-id c: 323)
	(up-chat-data-to-all str-t12-diag-value g: gl-ally-help-target-y)
	(up-chat-data-to-all str-t12-diag-id c: 324)
	(up-chat-data-to-all str-t12-diag-value g: gl-ally-help-zone)
	(up-modify-sn sn-focus-player-number g:= gl-ally-help-focus)
	(set-goal gl-ally-help-player -1)
	(set-goal gl-ally-help-state ALLY-HELP-IDLE)
)

(defrule
	(not (goal gl-ally-help-state ALLY-HELP-IDLE))
	(goal gl-home-defense-state YES)
=>
	(chat-to-allies "39 I cannot spare troops while my own town is under attack.")
	(up-modify-sn sn-focus-player-number g:= gl-ally-help-focus)
	(set-goal gl-ally-help-player -1)
	(set-goal gl-ally-help-state ALLY-HELP-IDLE)
)

;52 "Build a market at the flared location."
;CB BEGIN 1833
(defrule
	(goal target-action NO)
	(taunt-detected any-ally 52)
=>
	(acknowledge-taunt this-any-ally 52)
	(set-goal target-action YES)
	(set-goal market-flare YES)
	(up-modify-goal gl-flare-command-deadline g:= gl-game-time)
	(up-modify-goal gl-flare-command-deadline c:+ 8)
	(up-jump-rule 7)
)
;CB END 1833

;CB BEGIN 1834
(defrule
	(goal gl-owner-worker-hold NO)
	(goal market-flare YES)
	(goal gl-migration-placement-lock NO)
	(cc-players-unit-type-count any-ally flare >= 1)
	(can-build market)
=>
	(set-goal gl-cbf-cont 1834)
)
(defrule
	(goal gl-cbf-cont 1834)
=>
	(up-find-player-flare any-ally gl-flared-market-x)
	(up-set-target-point gl-flared-market-x)
)
(defrule
	(goal gl-cbf-cont 1834)
=>
	(set-goal gl-cbf-site 1834)
	(set-goal gl-cbf-kind 3)
	(set-goal gl-cbf-args0 -2)
	(set-goal gl-cbf-args1 -2)
	(set-goal gl-cbf-args2 -2)
	(set-goal gl-cbf-args3 -2)
	(set-goal gl-cbf-point-y -2)
	(up-get-rule-id gl-cbf-return)
	(up-modify-goal gl-cbf-return c:+ 1)
	(up-jump-direct g: gl-cbf-entry)
)
(defrule
	(goal gl-cbf-cont 1834)
=>
	(up-build place-point 0 c: market)
)
(defrule
	(goal gl-cbf-cont 1834)
=>
	(set-goal gl-cbf-site 1834)
	(set-goal gl-cbf-kind 2)
	(set-goal gl-cbf-args0 -2)
	(set-goal gl-cbf-args1 -2)
	(set-goal gl-cbf-args2 -2)
	(set-goal gl-cbf-args3 -2)
	(set-goal gl-cbf-point-y -2)
	(up-get-rule-id gl-cbf-return)
	(up-modify-goal gl-cbf-return c:+ 1)
	(up-jump-direct g: gl-cbf-entry)
)
(defrule
	(goal gl-cbf-cont 1834)
=>
	(set-goal market-flare NO)
	(set-goal target-action NO)
	(set-goal gl-flare-command-deadline 0)
	(chat-to-allies "39 Placed the Market you requested.")
)
(defrule
	(goal gl-cbf-cont 1834)
=>
	(set-goal gl-cbf-cont 0)
)
;CB END 1834

(defrule
	(goal market-flare YES)
	(cc-players-unit-type-count any-ally flare <= 0)
=>
	(set-goal market-flare NO)
	(set-goal target-action NO)
	(set-goal gl-flare-command-deadline 0)
	(chat-local-to-self "No flare detected to place market")
)

(defrule
	(goal target-action YES)
	(goal market-flare YES)
	(up-compare-goal gl-game-time g:>= gl-flare-command-deadline)
=>
	(set-goal market-flare NO)
	(set-goal target-action NO)
	(set-goal gl-flare-command-deadline 0)
	(chat-local-to-self "Market flare command expired")
)

;55 "Build a wall around your town"
(defrule
	(taunt-detected any-ally 55)
=>
	(acknowledge-taunt this-any-ally 55)
	(set-goal taunt-wall YES)
	(chat-local-to-self "Request walls, response to taunt")
	(chat-to-allies "39 Very well, I will build a wall around my base.")
	(disable-self)
)

