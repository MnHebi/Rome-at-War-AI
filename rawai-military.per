(defrule
	(and
		(goal team-game YES)
		(and
			(goal check-mil-pop YES)
			(goal milcheck-concluded CONCLUDED-LAND)
		)
	)
	(up-compare-goal gl-team-combined-navy g:> gl-enemy-team-navy)
=>
