;Keep one choice stable long enough for Shipyards to queue it. Primary and
;data-competitive fleets rotate through the complete roster. Support fleets
;retain escort/interception/bombardment hulls and receive heavy specialist
;detachments through bounded direct rules in the common production files.
(defrule
	(up-timer-status t-ship-train != timer-running)
	(goal ship-train SCOUTSHIP)
	(or
		(goal gl-naval-role NAVAL-ROLE-PRIMARY)
		(goal gl-naval-role NAVAL-ROLE-COMPETITIVE)
	)
=>
	(set-goal ship-train POLYREME)
	(up-set-timer c: t-ship-train c: 12)
)

(defrule
	(up-timer-status t-ship-train != timer-running)
	(goal ship-train SCOUTSHIP)
	(goal gl-naval-role NAVAL-ROLE-SUPPORT)
=>
	(set-goal ship-train FIRESHIP)
	(up-set-timer c: t-ship-train c: 12)
)

(defrule
	(up-timer-status t-ship-train != timer-running)
	(goal ship-train POLYREME)
=>
	(set-goal ship-train FIRESHIP)
	(up-set-timer c: t-ship-train c: 12)
)

(defrule
	(up-timer-status t-ship-train != timer-running)
	(goal ship-train FIRESHIP)
	(or
		(goal gl-naval-role NAVAL-ROLE-PRIMARY)
		(goal gl-naval-role NAVAL-ROLE-COMPETITIVE)
	)
=>
	(set-goal ship-train DEMOSHIP)
	(up-set-timer c: t-ship-train c: 12)
)

(defrule
	(up-timer-status t-ship-train != timer-running)
	(goal ship-train FIRESHIP)
	(goal gl-naval-role NAVAL-ROLE-SUPPORT)
=>
	(set-goal ship-train BOARDINGSHIP)
	(up-set-timer c: t-ship-train c: 12)
)

(defrule
	(up-timer-status t-ship-train != timer-running)
	(goal ship-train DEMOSHIP)
=>
	(set-goal ship-train HEMIOLIA)
	(up-set-timer c: t-ship-train c: 12)
)

(defrule
	(up-timer-status t-ship-train != timer-running)
	(goal ship-train HEMIOLIA)
=>
	(set-goal ship-train BOARDINGSHIP)
	(up-set-timer c: t-ship-train c: 12)
)

(defrule
	(up-timer-status t-ship-train != timer-running)
	(goal ship-train BOARDINGSHIP)
	(or
		(goal gl-naval-role NAVAL-ROLE-PRIMARY)
		(goal gl-naval-role NAVAL-ROLE-COMPETITIVE)
	)
=>
	(set-goal ship-train Q-REME)
	(up-set-timer c: t-ship-train c: 12)
)

(defrule
	(up-timer-status t-ship-train != timer-running)
	(goal ship-train BOARDINGSHIP)
	(goal gl-naval-role NAVAL-ROLE-SUPPORT)
=>
	(set-goal ship-train JUGGERNAUT)
	(up-set-timer c: t-ship-train c: 12)
)

(defrule
	(up-timer-status t-ship-train != timer-running)
	(goal ship-train Q-REME)
=>
	(set-goal ship-train OCTERES)
	(up-set-timer c: t-ship-train c: 12)
)

(defrule
	(up-timer-status t-ship-train != timer-running)
	(goal ship-train OCTERES)
=>
	(set-goal ship-train JUGGERNAUT)
	(up-set-timer c: t-ship-train c: 12)
)

(defrule
	(up-timer-status t-ship-train != timer-running)
	(goal ship-train JUGGERNAUT)
	(up-compare-goal gl-naval-role c:>= NAVAL-ROLE-PRIMARY)
=>
	(set-goal ship-train SCOUTSHIP)
	(up-set-timer c: t-ship-train c: 12)
)


#load-if-not-defined DIFFICULTY-EASIEST
#load-if-not-defined DIFFICULTY-EASY
#load-if-not-defined DIFFICULTY-MODERATE

;just do some attacks once you aged up to Castle Age, and Imperial Age

(defrule
	(current-age == middle-antiquity-age)
	(current-age-time g:> gl-age-attack-delay)
	(goal gl-home-defense-state NO)
	(or
		(goal gl-island-migration-state MIGRATION-IDLE)
		(goal gl-island-migration-state MIGRATION-QUARANTINED)
	)
	(goal gl-transport-route-state TRANSPORT-ROUTE-IDLE)
	(goal gl-land-transport-ready YES)
	(goal gl-age-advantage-pressure NO)
	(goal gl-attack-escalation-state ATTACK-ESCALATION-NORMAL)
	(up-compare-goal military-superiority c:>= TOLERABLE)
	(soldier-count g:>= gl-ten-percent)
=>
	(set-goal gl-age-up-attack-pending YES)
	(up-chat-data-to-self "middle age-up attack requested: %d" c: 60)
	(disable-self)
)

(defrule
	(current-age == imperial-age)
	(current-age-time g:> gl-age-attack-delay)
	(goal gl-home-defense-state NO)
	(or
		(goal gl-island-migration-state MIGRATION-IDLE)
		(goal gl-island-migration-state MIGRATION-QUARANTINED)
	)
	(goal gl-transport-route-state TRANSPORT-ROUTE-IDLE)
	(goal gl-land-transport-ready YES)
	(goal gl-age-advantage-pressure NO)
	(goal gl-attack-escalation-state ATTACK-ESCALATION-NORMAL)
	(up-compare-goal military-superiority c:>= TOLERABLE)
	(soldier-count g:>= gl-ten-percent)
=>
	(set-goal gl-age-up-attack-pending YES)
	(up-chat-data-to-self "imperial age-up attack requested: %d" c: 60)
	(disable-self)
)

(defrule
	(and
		(up-timer-status t-unit-type == timer-triggered)
		(gold-amount < 500)
	)
	(goal train-type MAIN)
=>
	(chat-local-to-self "unit type switch to TRASH")
	(set-goal train-type TRASH)
)

(defrule
	(and
		(up-timer-status t-unit-type == timer-triggered)
		(gold-amount > 500)
	)
	(goal train-type TRASH)
=>
	(chat-local-to-self "unit type switch to MAIN")
	(set-goal train-type MAIN)
)

;The generated match-relative naval doctrine is the only active owner of ship
;permission goals. Keep the old budget toggle and ship switcher behind one
;undefined compatibility flag so they cannot race the doctrine every sweep.
#load-if-defined RAWAI-LEGACY-NAVY-SWITCHER

;allow navy training once we have sufficient gold and wood

(defrule
	(and
		(goal train-scoutships NO)
		(wood-amount > 200)
	)
=>
	(chat-local-to-self "allow scout ship training")
	(set-goal train-scoutships YES)
)


(defrule
	(and
		(wood-amount > 250)
		(gold-amount > 150)
	)
	(or
		(goal train-remes NO)
		(or
			(goal train-fireships NO)
			(or
				(goal train-demoships NO)
				(or
					(goal train-hemiolia NO)
					(goal train-boardingships NO)
				)
			)
		)
	)
=>
	(chat-local-to-self "allow navy training")
	(set-goal train-remes YES)
	(set-goal train-fireships YES)
	(set-goal train-demoships YES)
	(set-goal train-hemiolia YES)
	(set-goal train-boardingships YES)
)

;disallow it if we don't

(defrule
	(and
		(goal train-scoutships YES)
		(wood-amount < 120)
	)
=>
	(chat-local-to-self "disallow scout ship training")
	(set-goal train-scoutships NO)
)

(defrule
	(or
		(wood-amount < 150)
		(gold-amount < 80)
	)
	(or
		(goal train-remes YES)
		(or
			(goal train-fireships YES)
			(or
				(goal train-demoships YES)
				(or
					(goal train-hemiolia YES)
					(goal train-boardingships YES)
				)
			)
		)
	)
=>
	(chat-local-to-self "disallow navy training")
	(set-goal train-remes NO)
	(set-goal train-fireships NO)
	(set-goal train-demoships NO)
	(set-goal train-hemiolia NO)
	(set-goal train-boardingships NO)
)

;good navies begin

(defrule
	(and
		(up-timer-status t-ship-train != timer-running)
		(goal good-navy YES)
	)
	(not
		(goal ship-train SCOUTSHIP)
	)
	(unit-type-count-total scout-galley-line g:< gl-no-percent)
=>
	(chat-local-to-self "ship type switch to SCOUTSHIP")
	(set-goal ship-train SCOUTSHIP)
)

(defrule
	(and
		(up-timer-status t-ship-train != timer-running)
		(goal good-navy YES)
	)
	(and
		(not
			(goal ship-train SCOUTSHIP)
		)
		(nor
			(goal ship-train POLYREME)
			(goal ship-train HEMIOLIA)
		)
	)
	(unit-type-count-total polyreme-line g:< gl-no-percent)
	(unit-type-count-total fire-ship-line g:> gl-no-percent)
=>
	(chat-local-to-self "ship type switch to POLYREME")
	(set-goal ship-train POLYREME)
)

(defrule
	(and
		(up-timer-status t-ship-train != timer-running)
		(goal good-navy YES)
	)
	(nor
		(goal ship-train SCOUTSHIP)
		(goal ship-train HEMIOLIA)
	)
	(unit-type-count-total fire-ship-line g:< gl-no-percent)
=>
	(chat-local-to-self "ship type switch to FIRESHIP")
	(set-goal ship-train FIRESHIP)
)

(defrule
	(and
		(up-timer-status t-ship-train != timer-running)
		(goal good-navy YES)
	)
	(nor
		(goal ship-train SCOUTSHIP)
		(goal ship-train HEMIOLIA)
	)
	(unit-type-count-total hemiolia-line g:< gl-no-percent)
=>
	(chat-local-to-self "ship type switch to HEMIOLIA")
	(set-goal ship-train HEMIOLIA)
)

;good navies end

;bad navies begin

(defrule
	(and
		(up-timer-status t-ship-train != timer-running)
		(goal good-navy NO)
	)
	(nor
		(goal ship-train POLYREME)
		(goal ship-train DEMOSHIP)
	)
	(unit-type-count-total polyreme-line g:< gl-no-percent)
	(unit-type-count-total fire-ship-line g:> gl-no-percent)
=>
	(chat-local-to-self "ship type switch to POLYREME")
	(set-goal ship-train POLYREME)
)

(defrule
	(and
		(up-timer-status t-ship-train != timer-running)
