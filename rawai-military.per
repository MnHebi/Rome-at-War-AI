
;rule jumps, do not add rules here
;dictate which method to attack with, TSA or Group handler
(defrule
	(up-timer-status t-attack-type <= timer-triggered)
	(soldier-count g:< gl-five-percent)
=>
	(set-goal attack-type-land TOWN-SIZE)
	(up-jump-rule 1)
)

(defrule
	(up-timer-status t-attack-type <= timer-triggered)
	(and
		(soldier-count g:> gl-five-percent)
		(soldier-count g:< gl-twenty-percent)
	)
=>
	(set-goal attack-type-land PERCENTAGE)
	(up-jump-rule 1)
)

(defrule
	(soldier-count g:>= gl-twenty-percent)
=>
	;GROUP has no direct attack executor in this module and can leave a full
	;army waiting forever. Keep the large-force path on the working executor.
	(set-goal attack-type-land PERCENTAGE)
	(up-jump-rule 1)
)

(defrule
	(warboat-count g:< gl-five-percent)
=>
	(set-goal attack-type-sea TOWN-SIZE)
	(up-jump-rule 1)
)

(defrule
	(and
		(warboat-count g:> gl-five-percent)
		(warboat-count g:< gl-twenty-percent)
	)
=>
	(set-goal attack-type-sea PERCENTAGE)
	(up-jump-rule 1)
)

(defrule
	(warboat-count g:>= gl-twenty-percent)
=>
	(set-goal attack-type-sea PERCENTAGE)
)
;rule jumps end

;Only preparation leases are checked here; committed independent voyages retain
;their own ownership and recovery rules. Never interrupt an acquired, owned hull.
(load "rawai-transport-preparation-ownership")

;T23 extends the immutable T17 preparation lease only across the new
;rendezvous phases. Its existing OWNER-LOST recovery remains authoritative.
(defrule
	(or (goal gl-transport-route-state TRANSPORT-ROUTE-RENDEZVOUS-START)
		(or (goal gl-transport-route-state TRANSPORT-ROUTE-RENDEZVOUS-WAIT)
			(or (goal gl-transport-route-state TRANSPORT-ROUTE-RENDEZVOUS-CHECK)
				(goal gl-transport-route-state TRANSPORT-ROUTE-RENDEZVOUS-PASSENGER))))
=>
	(set-goal gl-transport-preparation-owned NO)
	(up-full-reset-search)
	(up-add-object-by-id search-local g: gl-transport-route-id)
)

(defrule
	(or (goal gl-transport-route-state TRANSPORT-ROUTE-RENDEZVOUS-START)
		(or (goal gl-transport-route-state TRANSPORT-ROUTE-RENDEZVOUS-WAIT)
			(or (goal gl-transport-route-state TRANSPORT-ROUTE-RENDEZVOUS-CHECK)
				(goal gl-transport-route-state TRANSPORT-ROUTE-RENDEZVOUS-PASSENGER))))
	(up-set-target-object search-local c: 0)
	(up-object-data object-data-player == my-player-number)
	(up-object-data object-data-group-flag == attack-transport-group)
=>
	(set-goal gl-transport-preparation-owned YES)
)

(defrule
	(or (goal gl-transport-route-state TRANSPORT-ROUTE-RENDEZVOUS-START)
		(or (goal gl-transport-route-state TRANSPORT-ROUTE-RENDEZVOUS-WAIT)
			(or (goal gl-transport-route-state TRANSPORT-ROUTE-RENDEZVOUS-CHECK)
				(goal gl-transport-route-state TRANSPORT-ROUTE-RENDEZVOUS-PASSENGER))))
	(goal gl-transport-preparation-owned NO)
=>
	(set-goal gl-transport-route-state TRANSPORT-ROUTE-OWNER-LOST)
)

;Migration now has the same lease separation: remote travel to the exact hull
;is rendezvous work and may not consume the 30-second local boarding window.
(defrule
	(or (goal gl-island-migration-state MIGRATION-RENDEZVOUS-ANCHOR)
		(or (goal gl-island-migration-state MIGRATION-RENDEZVOUS-START)
			(or (goal gl-island-migration-state MIGRATION-RENDEZVOUS-WAIT)
				(or (goal gl-island-migration-state MIGRATION-RENDEZVOUS-CHECK)
					(goal gl-island-migration-state MIGRATION-RENDEZVOUS-PASSENGER)))))
=>
	(set-goal gl-transport-preparation-owned NO)
	(up-full-reset-search)
	(up-add-object-by-id search-local g: gl-island-migration-transport-id)
)

(defrule
	(or (goal gl-island-migration-state MIGRATION-RENDEZVOUS-ANCHOR)
		(or (goal gl-island-migration-state MIGRATION-RENDEZVOUS-START)
			(or (goal gl-island-migration-state MIGRATION-RENDEZVOUS-WAIT)
				(or (goal gl-island-migration-state MIGRATION-RENDEZVOUS-CHECK)
					(goal gl-island-migration-state MIGRATION-RENDEZVOUS-PASSENGER)))))
	(up-set-target-object search-local c: 0)
	(up-object-data object-data-player == my-player-number)
	(up-object-data object-data-group-flag == migration-transport-group)
=>
	(set-goal gl-transport-preparation-owned YES)
)

(defrule
	(or (goal gl-island-migration-state MIGRATION-RENDEZVOUS-ANCHOR)
		(or (goal gl-island-migration-state MIGRATION-RENDEZVOUS-START)
			(or (goal gl-island-migration-state MIGRATION-RENDEZVOUS-WAIT)
				(or (goal gl-island-migration-state MIGRATION-RENDEZVOUS-CHECK)
					(goal gl-island-migration-state MIGRATION-RENDEZVOUS-PASSENGER)))))
	(goal gl-transport-preparation-owned NO)
=>
	(set-goal gl-island-migration-state MIGRATION-OWNER-LOST)
)

;Reserve half the combat navy, with a one-ship exception, and pair one escort
;with each nearest loaded transport. Empty hulls release it on the next refresh.
(defrule
	(up-timer-status t-transport-escort == timer-triggered)
	(goal gl-transport-escort-state ESCORT-IDLE)
	;Do not reattach guards while any independent mission is unloading.
	(not (goal gl-am1-state 2))
	(not (goal gl-am2-state 2))
	(not (goal gl-am3-state 2))
	;The active route owns final-approach spacing. Reattaching a guard during the
	;landing window can pin the loaded hull against its own escort until the
	;fixed landing timer recalls it.
	(not (goal gl-transport-route-state TRANSPORT-ROUTE-RETURN-WAIT))
	(unit-type-count transport-ship >= 1)
	(or
		(warboat-count >= 1)
		(unit-type-count boarding-ship >= 1)
	)
=>
	(up-modify-goal gl-transport-escort-focus-player s:= sn-focus-player-number)
	;Release any prior escorts first. Clearing the group flag does not cancel an
	;existing guard order, so a failed or emptied transport otherwise keeps its
	;warships stranded beside it.
	(set-strategic-number sn-focus-player-number my-player-number)
	(up-set-group search-local c: transport-escort-group)
	;OWNERSHIP command: transport-escort-group.
	(up-remove-objects search-local object-data-player != my-player-number)
	(up-remove-objects search-local object-data-group-flag != transport-escort-group)
	; RAW12 counter 3
	(up-modify-goal gl-command-counter-3 c:+ 1)
	(up-target-point position-self-x action-stop -1 stance-no-attack)
	(up-modify-group-flag 0 c: transport-escort-group)
	(up-reset-group c: transport-escort-group)
	(up-full-reset-search)
	(set-strategic-number sn-focus-player-number my-player-number)
	(up-find-remote c: transport-ship c: 40)
	(up-remove-objects search-remote object-data-id g:== gl-quarantine-transport-id)
	(up-remove-objects search-remote object-data-garrison-count <= 0)
	;A loaded hull waiting motionless at a Port has no voyage to escort.  Guarding
	;it boxes the berth and reserves otherwise useful opportunity ships.
	(up-remove-objects search-remote object-data-idling == 1)
	(up-clean-search search-remote object-data-distance search-order-asc)
	(up-get-search-state local-total)
	(set-goal gl-transport-escort-state ESCORT-FIND)
)

(defrule
	(goal gl-transport-escort-state ESCORT-FIND)
	(up-compare-goal remote-total c:<= 0)
=>
	(set-goal gl-transport-escort-count 0)
	(set-goal gl-transport-escort-targets 0)
	(up-chat-data-to-self "active loaded escort targets: %d" c: 0)
	(up-modify-sn sn-focus-player-number g:= gl-transport-escort-focus-player)
	(up-full-reset-search)
	(set-goal gl-transport-escort-state ESCORT-IDLE)
)

(defrule
	(goal gl-transport-escort-state ESCORT-FIND)
	(up-compare-goal remote-total c:> 0)
=>
	(up-modify-goal gl-transport-escort-targets g:= remote-total)
	(up-get-fact warboat-count 0 gl-transport-escort-count)
	(up-get-fact unit-type-count boarding-ship gl-naval-boarding-count-total)
	(up-modify-goal gl-transport-escort-count g:+ gl-naval-boarding-count-total)
	(up-modify-goal gl-transport-escort-count c:/ 2)
	(up-chat-data-to-self "active loaded escort targets: %d" g: gl-transport-escort-targets)
	(set-goal gl-transport-escort-state ESCORT-PREPARE)
)

(defrule
	(goal gl-transport-escort-state ESCORT-PREPARE)
	(up-compare-goal gl-transport-escort-targets c:> 6)
=>
	(set-goal gl-transport-escort-targets 6)
)

(defrule
	(goal gl-transport-escort-state ESCORT-PREPARE)
	(up-compare-goal gl-transport-escort-count c:<= 0)
=>
	(set-goal gl-transport-escort-count 1)
)

(defrule
	(goal gl-transport-escort-state ESCORT-PREPARE)
	(up-compare-goal gl-transport-escort-count g:> gl-transport-escort-targets)
=>
	(up-modify-goal gl-transport-escort-count g:= gl-transport-escort-targets)
)

(defrule
	(goal gl-transport-escort-state ESCORT-PREPARE)
	(up-set-target-object search-remote c: 0)
=>
	(up-get-point position-object point-x)
	(up-set-target-point point-x)
	(set-goal gl-transport-escort-state ESCORT-SELECT)
)

(defrule
	(goal gl-transport-escort-state ESCORT-PREPARE)
	(not (up-set-target-object search-remote c: 0))
=>
	(up-modify-sn sn-focus-player-number g:= gl-transport-escort-focus-player)
	(up-full-reset-search)
	(set-goal gl-transport-escort-state ESCORT-IDLE)
)

(defrule
	(goal gl-transport-escort-state ESCORT-SELECT)
=>
	;Clear only the local list so the loaded transports remain search-remote.
	(up-reset-search 1 1 0 0)
	(up-filter-exclude -1 actionid-explore orderid-explore -1)
	(up-find-local c: warship-class c: 40)
	(up-find-local c: boarding-ship c: 10)
	(up-remove-objects search-local object-data-group-flag >= 0)
	(up-remove-objects search-local object-data-idling != 1)
	(up-remove-objects search-local object-data-group-flag >= 0)
	(up-remove-objects search-local object-data-action == actionid-explore)
	;Capital escorts are ungrouped but reserved by their follow/guard action.
	(up-remove-objects search-local object-data-action == actionid-follow)
	(up-clean-search search-local object-data-distance search-order-asc)
	(up-remove-objects search-local object-data-index g:>= gl-transport-escort-count)
	(up-get-search-state local-total)
	(set-goal gl-transport-escort-state ESCORT-COMMAND)
)

(defrule
	(goal gl-transport-escort-state ESCORT-COMMAND)
	(up-compare-goal local-total c:> 0)
=>
	(up-modify-goal gl-transport-escort-count g:= local-total)
	;OWNERSHIP acquire: only FREE objects may be claimed.
	(up-remove-objects search-local object-data-player != my-player-number)
	(up-remove-objects search-local object-data-group-flag >= 0)
	(up-create-group 0 0 c: transport-escort-group)
	(up-modify-group-flag 1 c: transport-escort-group)
	(set-goal gl-transport-escort-state ESCORT-GUARD-0)
)

(defrule
	(goal gl-transport-escort-state ESCORT-COMMAND)
	(up-compare-goal local-total c:<= 0)
=>
	(up-modify-sn sn-focus-player-number g:= gl-transport-escort-focus-player)
	(up-full-reset-search)
	(set-goal gl-transport-escort-state ESCORT-IDLE)
)

(defrule
	(goal gl-transport-escort-state ESCORT-GUARD-0)
	(up-compare-goal gl-transport-escort-count c:> 0)
	(up-set-target-object search-remote c: 0)
=>
	(up-reset-search 1 1 0 0)
	(up-find-local c: warship-class c: 40)
	(up-find-local c: boarding-ship c: 10)
	(up-remove-objects search-local object-data-group-flag != transport-escort-group)
	(up-clean-search search-local object-data-id search-order-asc)
	(up-remove-objects search-local object-data-index != 0)
	;OWNERSHIP command: transport-escort-group.
	(up-remove-objects search-local object-data-player != my-player-number)
	(up-remove-objects search-local object-data-group-flag != transport-escort-group)
	(up-target-objects 0 action-guard -1 stance-aggressive)
	(set-goal gl-transport-escort-state ESCORT-GUARD-1)
)

(defrule
	(goal gl-transport-escort-state ESCORT-GUARD-0)
=>
	(set-goal gl-transport-escort-state ESCORT-GUARD-1)
)

(defrule
	(goal gl-transport-escort-state ESCORT-GUARD-1)
	(up-compare-goal gl-transport-escort-count c:> 1)
	(up-set-target-object search-remote c: 1)
=>
	(up-reset-search 1 1 0 0)
	(up-find-local c: warship-class c: 40)
	(up-find-local c: boarding-ship c: 10)
	(up-remove-objects search-local object-data-group-flag != transport-escort-group)
	(up-clean-search search-local object-data-id search-order-asc)
	(up-remove-objects search-local object-data-index != 1)
	;OWNERSHIP command: transport-escort-group.
	(up-remove-objects search-local object-data-player != my-player-number)
	(up-remove-objects search-local object-data-group-flag != transport-escort-group)
	(up-target-objects 0 action-guard -1 stance-aggressive)
	(set-goal gl-transport-escort-state ESCORT-GUARD-2)
)

(defrule
	(goal gl-transport-escort-state ESCORT-GUARD-1)
=>
	(set-goal gl-transport-escort-state ESCORT-GUARD-2)
)

(defrule
	(goal gl-transport-escort-state ESCORT-GUARD-2)
	(up-compare-goal gl-transport-escort-count c:> 2)
	(up-set-target-object search-remote c: 2)
=>
	(up-reset-search 1 1 0 0)
	(up-find-local c: warship-class c: 40)
	(up-find-local c: boarding-ship c: 10)
	(up-remove-objects search-local object-data-group-flag != transport-escort-group)
	(up-clean-search search-local object-data-id search-order-asc)
	(up-remove-objects search-local object-data-index != 2)
	;OWNERSHIP command: transport-escort-group.
	(up-remove-objects search-local object-data-player != my-player-number)
	(up-remove-objects search-local object-data-group-flag != transport-escort-group)
	(up-target-objects 0 action-guard -1 stance-aggressive)
	(set-goal gl-transport-escort-state ESCORT-GUARD-3)
)

(defrule
	(goal gl-transport-escort-state ESCORT-GUARD-2)
=>
	(set-goal gl-transport-escort-state ESCORT-GUARD-3)
)

(defrule
	(goal gl-transport-escort-state ESCORT-GUARD-3)
	(up-compare-goal gl-transport-escort-count c:> 3)
	(up-set-target-object search-remote c: 3)
=>
	(up-reset-search 1 1 0 0)
	(up-find-local c: warship-class c: 40)
	(up-find-local c: boarding-ship c: 10)
	(up-remove-objects search-local object-data-group-flag != transport-escort-group)
	(up-clean-search search-local object-data-id search-order-asc)
	(up-remove-objects search-local object-data-index != 3)
	;OWNERSHIP command: transport-escort-group.
	(up-remove-objects search-local object-data-player != my-player-number)
	(up-remove-objects search-local object-data-group-flag != transport-escort-group)
	(up-target-objects 0 action-guard -1 stance-aggressive)
	(set-goal gl-transport-escort-state ESCORT-GUARD-4)
)

(defrule
	(goal gl-transport-escort-state ESCORT-GUARD-3)
=>
	(set-goal gl-transport-escort-state ESCORT-GUARD-4)
)

(defrule
	(goal gl-transport-escort-state ESCORT-GUARD-4)
	(up-compare-goal gl-transport-escort-count c:> 4)
	(up-set-target-object search-remote c: 4)
=>
	(up-reset-search 1 1 0 0)
	(up-find-local c: warship-class c: 40)
	(up-find-local c: boarding-ship c: 10)
	(up-remove-objects search-local object-data-group-flag != transport-escort-group)
	(up-clean-search search-local object-data-id search-order-asc)
	(up-remove-objects search-local object-data-index != 4)
	;OWNERSHIP command: transport-escort-group.
	(up-remove-objects search-local object-data-player != my-player-number)
	(up-remove-objects search-local object-data-group-flag != transport-escort-group)
	(up-target-objects 0 action-guard -1 stance-aggressive)
	(set-goal gl-transport-escort-state ESCORT-GUARD-5)
)

(defrule
	(goal gl-transport-escort-state ESCORT-GUARD-4)
=>
	(set-goal gl-transport-escort-state ESCORT-GUARD-5)
)

(defrule
	(goal gl-transport-escort-state ESCORT-GUARD-5)
	(up-compare-goal gl-transport-escort-count c:> 5)
	(up-set-target-object search-remote c: 5)
=>
	(up-reset-search 1 1 0 0)
	(up-find-local c: warship-class c: 40)
	(up-find-local c: boarding-ship c: 10)
	(up-remove-objects search-local object-data-group-flag != transport-escort-group)
	(up-clean-search search-local object-data-id search-order-asc)
	(up-remove-objects search-local object-data-index != 5)
	;OWNERSHIP command: transport-escort-group.
	(up-remove-objects search-local object-data-player != my-player-number)
	(up-remove-objects search-local object-data-group-flag != transport-escort-group)
	(up-target-objects 0 action-guard -1 stance-aggressive)
	(set-goal gl-transport-escort-state ESCORT-FINISH)
)

(defrule
	(goal gl-transport-escort-state ESCORT-GUARD-5)
=>
	(set-goal gl-transport-escort-state ESCORT-FINISH)
)

(defrule
	(goal gl-transport-escort-state ESCORT-FINISH)
=>
	(up-modify-sn sn-focus-player-number g:= gl-transport-escort-focus-player)
	(up-full-reset-search)
	(set-goal gl-transport-escort-state ESCORT-IDLE)
)

(defrule
	(up-timer-status t-transport-escort == timer-triggered)
	(goal gl-transport-escort-state ESCORT-IDLE)
	(up-group-size c: transport-escort-group > 0)
	(or
		(unit-type-count transport-ship <= 0)
		(and
			(warboat-count <= 0)
			(unit-type-count boarding-ship <= 0)
		)
	)
=>
	(up-modify-group-flag 0 c: transport-escort-group)
	(up-reset-group c: transport-escort-group)
)

;The built-in boat explorer strategic number cannot constrain hull type. Keep
;one or two explicitly selected Scout Ships exploring and reserve them from
;normal escort/attack ownership. Heavy bombardment hulls are never candidates.
(defrule
	(up-compare-goal gl-game-time g:>= gl-naval-scout-next)
	(current-age < imperial-age)
	(goal gl-naval-scout-state NAVAL-SCOUT-IDLE)
	(up-compare-goal desired-naval-explorers c:>= 1)
	(goal gl-home-defense-state NO)
	(or
		(goal map-type LAKE)
		(or
			(goal map-type RIVERS)
			(or
				(goal map-type ISLANDS)
				(goal map-type TEAM-ISLANDS)
			)
		)
	)
=>
	(up-modify-goal gl-naval-scout-focus s:= sn-focus-player-number)
	(set-strategic-number sn-focus-player-number my-player-number)
	(up-modify-group-flag 0 c: naval-scout-group)
	(up-reset-group c: naval-scout-group)
	(up-full-reset-search)
	(up-find-local c: scout-galley-line c: 10)
	(up-remove-objects search-local object-data-garrisoned == 1)
	(up-remove-objects search-local object-data-under-attack > 0)
	(up-remove-objects search-local object-data-group-flag >= 0)
	(up-clean-search search-local object-data-id search-order-asc)
	(up-remove-objects search-local object-data-index g:>= desired-naval-explorers)
	(up-get-search-state local-total)
	(up-modify-goal gl-naval-scout-count g:= local-total)
	(set-goal gl-naval-scout-state NAVAL-SCOUT-CHECK)
)

(defrule
	(goal gl-naval-scout-state NAVAL-SCOUT-CHECK)
	(current-age < imperial-age)
	(up-compare-goal gl-naval-scout-count c:> 0)
=>
	;Rebuild the filtered list in the consumer instead of depending on a shared
	;search list surviving the state boundary.
	(up-full-reset-search)
	(up-find-local c: scout-galley-line c: 10)
	(up-remove-objects search-local object-data-garrisoned == 1)
	(up-remove-objects search-local object-data-under-attack > 0)
	(up-remove-objects search-local object-data-group-flag >= 0)
	(up-clean-search search-local object-data-id search-order-asc)
	(up-remove-objects search-local object-data-index g:>= desired-naval-explorers)
	;OWNERSHIP acquire: only FREE objects may be claimed.
	(up-remove-objects search-local object-data-player != my-player-number)
	(up-remove-objects search-local object-data-group-flag >= 0)
	(up-create-group 0 0 c: naval-scout-group)
	(up-modify-group-flag 1 c: naval-scout-group)
	(set-goal gl-naval-scout-state NAVAL-SCOUT-TARGET)
)

;Known Gaia resources are shared through team vision, so using the farthest one
;made every ally converge on the same already-settled shore. Rotate four broad
;map-relative legs instead. Each ally starts on a randomized leg, advances after
;every order, and therefore cannot indefinitely refresh one allied object.
(defrule
	(goal gl-naval-scout-state NAVAL-SCOUT-TARGET)
	(current-age < imperial-age)
	(up-group-size c: naval-scout-group > 0)
	(goal gl-naval-scout-leg 0)
=>
	(set-strategic-number sn-focus-player-number my-player-number)
	(up-get-point position-opposite gl-naval-scout-target-x)
	(up-cross-tiles gl-naval-scout-target-x gl-home-anchor-x c: 24)
	(up-bound-point point4-x gl-naval-scout-target-x)
	(up-full-reset-search)
	(up-set-group search-local c: naval-scout-group)
	;OWNERSHIP command: naval-scout-group.
	(up-remove-objects search-local object-data-player != my-player-number)
	(up-remove-objects search-local object-data-group-flag != naval-scout-group)
	(up-target-point point4-x action-move -1 stance-no-attack)
	(up-chat-data-to-self "naval scout route leg: %d" c: 0)
	(up-modify-sn sn-focus-player-number g:= gl-naval-scout-focus)
	(up-modify-goal gl-naval-scout-next g:= gl-game-time)
	(up-modify-goal gl-naval-scout-next c:+ 90)
	(set-goal gl-naval-scout-leg 1)
	(set-goal gl-naval-scout-state NAVAL-SCOUT-IDLE)
)

(defrule
	(goal gl-naval-scout-state NAVAL-SCOUT-TARGET)
	(current-age < imperial-age)
	(up-group-size c: naval-scout-group > 0)
	(goal gl-naval-scout-leg 1)
=>
	(set-strategic-number sn-focus-player-number my-player-number)
	(up-get-point position-corner gl-naval-scout-target-x)
	(up-cross-tiles gl-naval-scout-target-x gl-home-anchor-x c: -24)
	(up-bound-point point4-x gl-naval-scout-target-x)
	(up-full-reset-search)
	(up-set-group search-local c: naval-scout-group)
	;OWNERSHIP command: naval-scout-group.
	(up-remove-objects search-local object-data-player != my-player-number)
	(up-remove-objects search-local object-data-group-flag != naval-scout-group)
	(up-target-point point4-x action-move -1 stance-no-attack)
	(up-chat-data-to-self "naval scout route leg: %d" c: 1)
	(up-modify-sn sn-focus-player-number g:= gl-naval-scout-focus)
	(up-modify-goal gl-naval-scout-next g:= gl-game-time)
	(up-modify-goal gl-naval-scout-next c:+ 90)
	(set-goal gl-naval-scout-leg 2)
	(set-goal gl-naval-scout-state NAVAL-SCOUT-IDLE)
)

(defrule
	(goal gl-naval-scout-state NAVAL-SCOUT-TARGET)
	(current-age < imperial-age)
	(up-group-size c: naval-scout-group > 0)
	(goal gl-naval-scout-leg 2)
=>
	(set-strategic-number sn-focus-player-number my-player-number)
	(up-get-point position-mirror gl-naval-scout-target-x)
	(up-cross-tiles gl-naval-scout-target-x gl-home-anchor-x c: 36)
	(up-bound-point point4-x gl-naval-scout-target-x)
	(up-full-reset-search)
	(up-set-group search-local c: naval-scout-group)
	;OWNERSHIP command: naval-scout-group.
	(up-remove-objects search-local object-data-player != my-player-number)
	(up-remove-objects search-local object-data-group-flag != naval-scout-group)
	(up-target-point point4-x action-move -1 stance-no-attack)
	(up-chat-data-to-self "naval scout route leg: %d" c: 2)
	(up-modify-sn sn-focus-player-number g:= gl-naval-scout-focus)
	(up-modify-goal gl-naval-scout-next g:= gl-game-time)
	(up-modify-goal gl-naval-scout-next c:+ 90)
	(set-goal gl-naval-scout-leg 3)
	(set-goal gl-naval-scout-state NAVAL-SCOUT-IDLE)
)

(defrule
	(goal gl-naval-scout-state NAVAL-SCOUT-TARGET)
	(current-age < imperial-age)
	(up-group-size c: naval-scout-group > 0)
	(goal gl-naval-scout-leg 3)
=>
	(set-strategic-number sn-focus-player-number my-player-number)
	(up-get-point position-flank gl-naval-scout-target-x)
	(up-cross-tiles gl-naval-scout-target-x gl-home-anchor-x c: -36)
	(up-bound-point point4-x gl-naval-scout-target-x)
	(up-full-reset-search)
	(up-set-group search-local c: naval-scout-group)
	;OWNERSHIP command: naval-scout-group.
	(up-remove-objects search-local object-data-player != my-player-number)
	(up-remove-objects search-local object-data-group-flag != naval-scout-group)
	(up-target-point point4-x action-move -1 stance-no-attack)
	(up-chat-data-to-self "naval scout route leg: %d" c: 3)
	(up-modify-sn sn-focus-player-number g:= gl-naval-scout-focus)
	(up-modify-goal gl-naval-scout-next g:= gl-game-time)
	(up-modify-goal gl-naval-scout-next c:+ 90)
	(set-goal gl-naval-scout-leg 0)
	(set-goal gl-naval-scout-state NAVAL-SCOUT-IDLE)
)

;A valid post-create group size is runtime proof that the multiplexed slot was
;actually populated. Never leave the focus player borrowed when formation
;failed or another controller still owned the slot unexpectedly.
(defrule
	(goal gl-naval-scout-state NAVAL-SCOUT-TARGET)
	(up-group-size c: naval-scout-group <= 0)
=>
	(up-chat-data-to-self "naval scout group formation failed: %d" g: gl-naval-scout-count)
	(up-modify-sn sn-focus-player-number g:= gl-naval-scout-focus)
	(up-modify-goal gl-naval-scout-next g:= gl-game-time)
	(up-modify-goal gl-naval-scout-next c:+ 20)
	(set-goal gl-naval-scout-state NAVAL-SCOUT-IDLE)
)

;Do not substitute a siege or capital hull when the preferred light family is
;missing or every Scout Ship is busy. Keep the filtered absence observable.
(defrule
	(goal gl-naval-scout-state NAVAL-SCOUT-CHECK)
	(up-compare-goal gl-naval-scout-count c:<= 0)
=>
	(up-chat-data-to-self "naval scout safe hull unavailable: %d" g: gl-naval-scout-count)
	(up-modify-sn sn-focus-player-number g:= gl-naval-scout-focus)
	(up-modify-goal gl-naval-scout-next g:= gl-game-time)
	(up-modify-goal gl-naval-scout-next c:+ 45)
	(set-goal gl-naval-scout-state NAVAL-SCOUT-IDLE)
)

;Ordinary light ships intercept valuable vessels they encounter instead of
;being released into the engine's structure-biased attack-now controller.
;Select an own water-zone source first so an unreachable target in another sea
;cannot block every useful target in the fleet's actual basin. Capital ships,
;explorers, guards, response groups, screens, and transports are not candidates.
(defrule
	(up-compare-goal gl-game-time g:>= gl-naval-opportunity-next)
	(goal gl-naval-opportunity-state NAVAL-OPPORTUNITY-IDLE)
	(goal gl-naval-theater YES)
	(up-compare-goal gl-naval-role c:<= NAVAL-ROLE-COMPETITIVE)
	(up-compare-goal gl-naval-role c:>= NAVAL-ROLE-PRIMARY)
	(or
		(warboat-count > 0)
		(unit-type-count boarding-ship > 0)
	)
=>
	(up-modify-goal gl-naval-opportunity-focus s:= sn-focus-player-number)
	;Do not let one enemy or one empty water basin monopolize every scan.
	(up-find-player enemy find-random gl-naval-opportunity-player)
	(up-modify-sn sn-focus-player-number g:= gl-naval-opportunity-player)
	(up-get-point position-focus gl-naval-opportunity-source-x)
	(set-strategic-number sn-focus-player-number my-player-number)
	(up-full-reset-search)
	(up-set-target-point gl-naval-opportunity-source-x)
	(up-find-local c: scout-galley-line c: 30)
	(up-find-local c: polyreme-line c: 30)
	(up-find-local c: hemiolia-line c: 30)
	(up-find-local c: quadrireme c: 30)
	(up-find-local c: quinquereme c: 30)
	(up-find-local c: liburna-line c: 30)
	(up-find-local c: fire-ship-line c: 30)
	(up-find-local c: boarding-ship c: 30)
	(up-remove-objects search-local object-data-under-attack > 0)
	(up-remove-objects search-local object-data-idling != 1)
	(up-remove-objects search-local object-data-action == actionid-explore)
	(up-remove-objects search-local object-data-action == actionid-follow)
	;A group flag is runtime ownership, even when the ship is momentarily idle.
	;Known terminal controllers must release their groups; opportunity control
	;must not steal escorts, screens, scouts, or response ships speculatively.
	(up-remove-objects search-local object-data-group-flag >= 0)
	(up-remove-objects search-local object-data-map-zone-id g:== gl-naval-opportunity-rejected-zone)
	(up-remove-objects search-local object-data-map-zone-id g:== gl-naval-opportunity-rejected-zone2)
	(set-goal gl-naval-opportunity-state NAVAL-OPPORTUNITY-FIND-SOURCE)
)

;Same-pass continuation keeps the concrete two-form search within the rule limit.
(defrule
	(goal gl-naval-opportunity-state NAVAL-OPPORTUNITY-FIND-SOURCE)
=>
	(up-remove-objects search-local object-data-map-zone-id g:== gl-naval-opportunity-rejected-zone3)
	(up-clean-search search-local object-data-distance search-order-asc)
)

(defrule
	(goal gl-naval-opportunity-state NAVAL-OPPORTUNITY-FIND-SOURCE)
	(up-set-target-object search-local c: 0)
=>
	(up-get-object-data object-data-id gl-naval-opportunity-source-id)
	(up-get-object-data object-data-map-zone-id gl-naval-opportunity-zone)
	(up-get-point position-object gl-naval-opportunity-source-x)
	(up-modify-sn sn-focus-player-number g:= gl-naval-opportunity-player)
	(up-full-reset-search)
	(up-set-target-point gl-naval-opportunity-source-x)
	(up-filter-distance c: -1 c: 60)
	(up-find-remote c: transport-ship c: 20)
	(up-remove-objects search-remote object-data-garrison-count <= 0)
	(up-remove-objects search-remote object-data-map-zone-id g:!= gl-naval-opportunity-zone)
	(up-clean-search search-remote object-data-distance search-order-asc)
	(set-goal gl-naval-opportunity-state NAVAL-OPPORTUNITY-SCAN-LOADED)
)

(defrule
	(goal gl-naval-opportunity-state NAVAL-OPPORTUNITY-FIND-SOURCE)
	(not (up-set-target-object search-local c: 0))
=>
	(up-modify-sn sn-focus-player-number g:= gl-naval-opportunity-focus)
	(set-goal gl-naval-opportunity-active-id -1)
	(set-goal gl-naval-opportunity-rejected-zone -1)
	(set-goal gl-naval-opportunity-rejected-zone2 -1)
	(set-goal gl-naval-opportunity-rejected-zone3 -1)
	(set-goal gl-naval-opportunity-rejected-id -1)
	(set-goal gl-naval-opportunity-rejected-id2 -1)
	(set-goal gl-naval-opportunity-reject-count 0)
	(up-modify-goal gl-naval-opportunity-next g:= gl-game-time)
	(up-modify-goal gl-naval-opportunity-next c:+ 8)
	(set-goal gl-naval-opportunity-state NAVAL-OPPORTUNITY-IDLE)
)

;Loaded transports are the first target class because their loss also destroys
;the embarked army. Every accepted candidate is screened against known static
;defenses at the target and again across a conservative midpoint corridor.
(defrule
	(goal gl-naval-opportunity-state NAVAL-OPPORTUNITY-SCAN-LOADED)
	(up-set-target-object search-remote c: 0)
=>
	(set-goal gl-naval-opportunity-target-kind NAVAL-OPPORTUNITY-LOADED)
	(up-get-object-data object-data-id gl-naval-opportunity-target-id)
	(up-get-point position-object gl-naval-opportunity-target-x)
	(up-find-player enemy find-ordered gl-naval-opportunity-defense-player)
	(up-modify-goal gl-naval-opportunity-defense-first g:= gl-naval-opportunity-defense-player)
	(set-goal gl-naval-opportunity-state NAVAL-OPPORTUNITY-START-TARGET-DEFENSE)
)

(defrule
	(goal gl-naval-opportunity-state NAVAL-OPPORTUNITY-SCAN-LOADED)
	(not (up-set-target-object search-remote c: 0))
=>
	(up-full-reset-search)
	(up-set-target-point gl-naval-opportunity-source-x)
	(up-filter-distance c: -1 c: 60)
	(up-find-remote c: scout-galley-line c: 30)
	(up-find-remote c: polyreme-line c: 30)
	(up-find-remote c: hemiolia-line c: 30)
	(up-find-remote c: quadrireme c: 30)
	(up-find-remote c: quinquereme c: 30)
	(up-find-remote c: liburna-line c: 30)
	(up-find-remote c: fire-ship-line c: 30)
	(up-find-remote c: fire-galley c: 30)
	(up-find-remote c: boarding-ship c: 30)
	(up-remove-objects search-remote object-data-map-zone-id g:!= gl-naval-opportunity-zone)
	(up-clean-search search-remote object-data-distance search-order-asc)
	(set-goal gl-naval-opportunity-reject-count 0)
	(set-goal gl-naval-opportunity-state NAVAL-OPPORTUNITY-SCAN-WARSHIP)
)

(defrule
	(goal gl-naval-opportunity-state NAVAL-OPPORTUNITY-SCAN-WARSHIP)
	(up-set-target-object search-remote c: 0)
=>
	(set-goal gl-naval-opportunity-target-kind NAVAL-OPPORTUNITY-WARSHIP)
	(up-get-object-data object-data-id gl-naval-opportunity-target-id)
	(up-get-point position-object gl-naval-opportunity-target-x)
	(up-find-player enemy find-ordered gl-naval-opportunity-defense-player)
	(up-modify-goal gl-naval-opportunity-defense-first g:= gl-naval-opportunity-defense-player)
	(set-goal gl-naval-opportunity-state NAVAL-OPPORTUNITY-START-TARGET-DEFENSE)
)

(defrule
	(goal gl-naval-opportunity-state NAVAL-OPPORTUNITY-SCAN-WARSHIP)
	(not (up-set-target-object search-remote c: 0))
=>
	(up-full-reset-search)
	(up-set-target-point gl-naval-opportunity-source-x)
	(up-filter-distance c: -1 c: 60)
	(up-find-remote c: transport-ship c: 20)
	;This class is explicitly empty: a rejected loaded hull must never be
	;silently reconsidered at the lower transport priority.
	(up-remove-objects search-remote object-data-garrison-count > 0)
	(up-remove-objects search-remote object-data-map-zone-id g:!= gl-naval-opportunity-zone)
	(up-clean-search search-remote object-data-distance search-order-asc)
	(set-goal gl-naval-opportunity-reject-count 0)
	(set-goal gl-naval-opportunity-state NAVAL-OPPORTUNITY-SCAN-TRANSPORT)
)

(defrule
	(goal gl-naval-opportunity-state NAVAL-OPPORTUNITY-SCAN-TRANSPORT)
	(up-set-target-object search-remote c: 0)
=>
	(set-goal gl-naval-opportunity-target-kind NAVAL-OPPORTUNITY-TRANSPORT)
	(up-get-object-data object-data-id gl-naval-opportunity-target-id)
	(up-get-point position-object gl-naval-opportunity-target-x)
	(up-find-player enemy find-ordered gl-naval-opportunity-defense-player)
	(up-modify-goal gl-naval-opportunity-defense-first g:= gl-naval-opportunity-defense-player)
	(set-goal gl-naval-opportunity-state NAVAL-OPPORTUNITY-START-TARGET-DEFENSE)
)

(defrule
	(goal gl-naval-opportunity-state NAVAL-OPPORTUNITY-SCAN-TRANSPORT)
	(not (up-set-target-object search-remote c: 0))
=>
	(up-full-reset-search)
	(up-set-target-point gl-naval-opportunity-source-x)
	(up-filter-distance c: -1 c: 60)
	(up-find-remote c: fishing-ship-class c: 30)
	(up-remove-objects search-remote object-data-map-zone-id g:!= gl-naval-opportunity-zone)
	(up-clean-search search-remote object-data-distance search-order-asc)
	(set-goal gl-naval-opportunity-reject-count 0)
	(set-goal gl-naval-opportunity-state NAVAL-OPPORTUNITY-SCAN-FISHING)
)

(defrule
	(goal gl-naval-opportunity-state NAVAL-OPPORTUNITY-SCAN-FISHING)
	(up-set-target-object search-remote c: 0)
=>
	(set-goal gl-naval-opportunity-target-kind NAVAL-OPPORTUNITY-FISHING)
	(up-get-object-data object-data-id gl-naval-opportunity-target-id)
	(up-get-point position-object gl-naval-opportunity-target-x)
	(up-find-player enemy find-ordered gl-naval-opportunity-defense-player)
	(up-modify-goal gl-naval-opportunity-defense-first g:= gl-naval-opportunity-defense-player)
	(set-goal gl-naval-opportunity-state NAVAL-OPPORTUNITY-START-TARGET-DEFENSE)
)

(defrule
	(goal gl-naval-opportunity-state NAVAL-OPPORTUNITY-SCAN-FISHING)
	(not (up-set-target-object search-remote c: 0))
=>
	(up-modify-sn sn-focus-player-number g:= gl-naval-opportunity-focus)
	(set-goal gl-naval-opportunity-active-id -1)
	(set-goal gl-naval-opportunity-rejected-id -1)
	(set-goal gl-naval-opportunity-rejected-id2 -1)
	(set-goal gl-naval-opportunity-reject-count 0)
	(up-modify-goal gl-naval-opportunity-rejected-zone3 g:= gl-naval-opportunity-rejected-zone2)
	(up-modify-goal gl-naval-opportunity-rejected-zone2 g:= gl-naval-opportunity-rejected-zone)
	(up-modify-goal gl-naval-opportunity-rejected-zone g:= gl-naval-opportunity-zone)
	(up-modify-goal gl-naval-opportunity-next g:= gl-game-time)
	(up-modify-goal gl-naval-opportunity-next c:+ 8)
	(set-goal gl-naval-opportunity-state NAVAL-OPPORTUNITY-IDLE)
)

;Remote DUC searches are focus-player owned. Walk every live enemy in one
;bounded ordered cycle so a target belonging to one enemy is not accepted
;through another enemy's known tower, Fort/castle, or Town Center coverage.
(defrule
	(goal gl-naval-opportunity-state NAVAL-OPPORTUNITY-START-TARGET-DEFENSE)
=>
	(up-modify-sn sn-focus-player-number g:= gl-naval-opportunity-defense-player)
	(up-full-reset-search)
	(up-set-target-point gl-naval-opportunity-target-x)
	(up-filter-distance c: -1 c: 18)
	(up-find-remote c: sea-tower c: 10)
	(up-find-remote c: tower-class c: 20)
	(up-find-remote c: castle c: 10)
	(up-find-remote c: town-center c: 10)
	(up-clean-search search-remote object-data-distance search-order-asc)
	(set-goal gl-naval-opportunity-state NAVAL-OPPORTUNITY-CHECK-TARGET)
)

(defrule
	(goal gl-naval-opportunity-state NAVAL-OPPORTUNITY-CHECK-TARGET)
	(up-set-target-object search-remote c: 0)
=>
	(up-modify-goal gl-naval-opportunity-rejected-id2 g:= gl-naval-opportunity-rejected-id)
	(up-modify-goal gl-naval-opportunity-rejected-id g:= gl-naval-opportunity-target-id)
	(up-modify-goal gl-naval-opportunity-reject-count c:+ 1)
	(up-modify-sn sn-focus-player-number g:= gl-naval-opportunity-player)
	(set-goal gl-naval-opportunity-state NAVAL-OPPORTUNITY-REJECT)
)

(defrule
	(goal gl-naval-opportunity-state NAVAL-OPPORTUNITY-CHECK-TARGET)
	(not (up-set-target-object search-remote c: 0))
=>
	(set-goal gl-naval-opportunity-state NAVAL-OPPORTUNITY-ADVANCE-TARGET-DEFENSE)
)

(defrule
	(goal gl-naval-opportunity-state NAVAL-OPPORTUNITY-ADVANCE-TARGET-DEFENSE)
=>
	(up-find-next-player enemy find-ordered gl-naval-opportunity-defense-player)
	(set-goal gl-naval-opportunity-state NAVAL-OPPORTUNITY-NEXT-TARGET-DEFENSE)
)

(defrule
	(goal gl-naval-opportunity-state NAVAL-OPPORTUNITY-NEXT-TARGET-DEFENSE)
	(up-compare-goal gl-naval-opportunity-defense-player g:!= gl-naval-opportunity-defense-first)
=>
	;The producer is earlier than this iterator branch. Yield with only the next
	;player stored, restore borrowed focus, and rebuild a fresh list next sweep.
	(up-modify-sn sn-focus-player-number g:= gl-naval-opportunity-focus)
	(set-goal gl-naval-opportunity-state NAVAL-OPPORTUNITY-START-TARGET-DEFENSE)
)

(defrule
	(goal gl-naval-opportunity-state NAVAL-OPPORTUNITY-NEXT-TARGET-DEFENSE)
	(up-compare-goal gl-naval-opportunity-defense-player g:== gl-naval-opportunity-defense-first)
=>
	(up-bound-point gl-naval-opportunity-route-x gl-naval-opportunity-target-x)
	(up-lerp-percent gl-naval-opportunity-route-x gl-naval-opportunity-source-x c: 50)
	(set-goal gl-naval-opportunity-state NAVAL-OPPORTUNITY-START-ROUTE-DEFENSE)
)

(defrule
	(goal gl-naval-opportunity-state NAVAL-OPPORTUNITY-START-ROUTE-DEFENSE)
=>
	(up-modify-sn sn-focus-player-number g:= gl-naval-opportunity-defense-player)
	(up-full-reset-search)
	(up-set-target-point gl-naval-opportunity-route-x)
	;A 32-tile midpoint disk covers the full direct segment of the bounded
	;60-tile intercept and intentionally over-rejects lateral fortifications.
	(up-filter-distance c: -1 c: 32)
	(up-find-remote c: sea-tower c: 10)
	(up-find-remote c: tower-class c: 20)
	(up-find-remote c: castle c: 10)
	(up-find-remote c: town-center c: 10)
	(up-clean-search search-remote object-data-distance search-order-asc)
	(set-goal gl-naval-opportunity-state NAVAL-OPPORTUNITY-CHECK-ROUTE)
)

(defrule
	(goal gl-naval-opportunity-state NAVAL-OPPORTUNITY-CHECK-ROUTE)
	(up-set-target-object search-remote c: 0)
=>
	(up-modify-goal gl-naval-opportunity-rejected-id2 g:= gl-naval-opportunity-rejected-id)
	(up-modify-goal gl-naval-opportunity-rejected-id g:= gl-naval-opportunity-target-id)
	(up-modify-goal gl-naval-opportunity-reject-count c:+ 1)
	(up-modify-sn sn-focus-player-number g:= gl-naval-opportunity-player)
	(set-goal gl-naval-opportunity-state NAVAL-OPPORTUNITY-REJECT)
)

(defrule
	(goal gl-naval-opportunity-state NAVAL-OPPORTUNITY-CHECK-ROUTE)
	(not (up-set-target-object search-remote c: 0))
=>
	(set-goal gl-naval-opportunity-state NAVAL-OPPORTUNITY-ADVANCE-ROUTE-DEFENSE)
)

(defrule
	(goal gl-naval-opportunity-state NAVAL-OPPORTUNITY-ADVANCE-ROUTE-DEFENSE)
=>
	(up-find-next-player enemy find-ordered gl-naval-opportunity-defense-player)
	(set-goal gl-naval-opportunity-state NAVAL-OPPORTUNITY-NEXT-ROUTE-DEFENSE)
)

(defrule
	(goal gl-naval-opportunity-state NAVAL-OPPORTUNITY-NEXT-ROUTE-DEFENSE)
	(up-compare-goal gl-naval-opportunity-defense-player g:!= gl-naval-opportunity-defense-first)
=>
	(up-modify-sn sn-focus-player-number g:= gl-naval-opportunity-focus)
	(set-goal gl-naval-opportunity-state NAVAL-OPPORTUNITY-START-ROUTE-DEFENSE)
)

(defrule
	(goal gl-naval-opportunity-state NAVAL-OPPORTUNITY-NEXT-ROUTE-DEFENSE)
	(up-compare-goal gl-naval-opportunity-defense-player g:== gl-naval-opportunity-defense-first)
=>
	(up-modify-sn sn-focus-player-number g:= gl-naval-opportunity-player)
	(set-goal gl-naval-opportunity-state NAVAL-OPPORTUNITY-PREPARE)
)

;Try two candidates in the current class before descending the hierarchy. This
;prevents the nearest defended transport or fishing boat from hiding a safe
;second target while keeping the search bounded.
(defrule
	(goal gl-naval-opportunity-state NAVAL-OPPORTUNITY-REJECT)
	(goal gl-naval-opportunity-target-kind NAVAL-OPPORTUNITY-LOADED)
	(up-compare-goal gl-naval-opportunity-reject-count c:< 2)
=>
	(up-full-reset-search)
	(up-set-target-point gl-naval-opportunity-source-x)
	(up-filter-distance c: -1 c: 60)
	(up-find-remote c: transport-ship c: 20)
	(up-remove-objects search-remote object-data-garrison-count <= 0)
	(up-remove-objects search-remote object-data-id g:== gl-naval-opportunity-rejected-id)
	(up-remove-objects search-remote object-data-id g:== gl-naval-opportunity-rejected-id2)
	(up-remove-objects search-remote object-data-map-zone-id g:!= gl-naval-opportunity-zone)
	(up-clean-search search-remote object-data-distance search-order-asc)
	(set-goal gl-naval-opportunity-state NAVAL-OPPORTUNITY-SCAN-LOADED)
)

(defrule
	(goal gl-naval-opportunity-state NAVAL-OPPORTUNITY-REJECT)
	(goal gl-naval-opportunity-target-kind NAVAL-OPPORTUNITY-LOADED)
	(up-compare-goal gl-naval-opportunity-reject-count c:>= 2)
=>
	(up-full-reset-search)
	(up-set-target-point gl-naval-opportunity-source-x)
	(up-filter-distance c: -1 c: 60)
	(up-find-remote c: scout-galley-line c: 30)
	(up-find-remote c: polyreme-line c: 30)
	(up-find-remote c: hemiolia-line c: 30)
	(up-find-remote c: quadrireme c: 30)
	(up-find-remote c: quinquereme c: 30)
	(up-find-remote c: liburna-line c: 30)
	(up-find-remote c: fire-ship-line c: 30)
	(up-find-remote c: fire-galley c: 30)
	(up-find-remote c: boarding-ship c: 30)
	(up-remove-objects search-remote object-data-map-zone-id g:!= gl-naval-opportunity-zone)
	(up-clean-search search-remote object-data-distance search-order-asc)
	(set-goal gl-naval-opportunity-reject-count 0)
	(set-goal gl-naval-opportunity-state NAVAL-OPPORTUNITY-SCAN-WARSHIP)
)

(defrule
	(goal gl-naval-opportunity-state NAVAL-OPPORTUNITY-REJECT)
	(goal gl-naval-opportunity-target-kind NAVAL-OPPORTUNITY-WARSHIP)
	(up-compare-goal gl-naval-opportunity-reject-count c:< 2)
=>
	(up-full-reset-search)
	(up-set-target-point gl-naval-opportunity-source-x)
	(up-filter-distance c: -1 c: 60)
	(up-find-remote c: scout-galley-line c: 30)
	(up-find-remote c: polyreme-line c: 30)
	(up-find-remote c: hemiolia-line c: 30)
	(up-find-remote c: quadrireme c: 30)
	(up-find-remote c: quinquereme c: 30)
	(up-find-remote c: liburna-line c: 30)
	(up-find-remote c: fire-ship-line c: 30)
	(up-find-remote c: fire-galley c: 30)
	(up-find-remote c: boarding-ship c: 30)
	(up-remove-objects search-remote object-data-id g:== gl-naval-opportunity-rejected-id)
	(up-remove-objects search-remote object-data-id g:== gl-naval-opportunity-rejected-id2)
	(up-remove-objects search-remote object-data-map-zone-id g:!= gl-naval-opportunity-zone)
	(up-clean-search search-remote object-data-distance search-order-asc)
	(set-goal gl-naval-opportunity-state NAVAL-OPPORTUNITY-SCAN-WARSHIP)
)

(defrule
	(goal gl-naval-opportunity-state NAVAL-OPPORTUNITY-REJECT)
	(goal gl-naval-opportunity-target-kind NAVAL-OPPORTUNITY-WARSHIP)
	(up-compare-goal gl-naval-opportunity-reject-count c:>= 2)
=>
	(up-full-reset-search)
	(up-set-target-point gl-naval-opportunity-source-x)
	(up-filter-distance c: -1 c: 60)
	(up-find-remote c: transport-ship c: 20)
	(up-remove-objects search-remote object-data-garrison-count > 0)
	(up-remove-objects search-remote object-data-map-zone-id g:!= gl-naval-opportunity-zone)
	(up-clean-search search-remote object-data-distance search-order-asc)
	(set-goal gl-naval-opportunity-reject-count 0)
	(set-goal gl-naval-opportunity-state NAVAL-OPPORTUNITY-SCAN-TRANSPORT)
)

(defrule
	(goal gl-naval-opportunity-state NAVAL-OPPORTUNITY-REJECT)
	(goal gl-naval-opportunity-target-kind NAVAL-OPPORTUNITY-TRANSPORT)
	(up-compare-goal gl-naval-opportunity-reject-count c:< 2)
=>
	(up-full-reset-search)
	(up-set-target-point gl-naval-opportunity-source-x)
	(up-filter-distance c: -1 c: 60)
	(up-find-remote c: transport-ship c: 20)
	(up-remove-objects search-remote object-data-garrison-count > 0)
	(up-remove-objects search-remote object-data-id g:== gl-naval-opportunity-rejected-id)
	(up-remove-objects search-remote object-data-id g:== gl-naval-opportunity-rejected-id2)
	(up-remove-objects search-remote object-data-map-zone-id g:!= gl-naval-opportunity-zone)
	(up-clean-search search-remote object-data-distance search-order-asc)
	(set-goal gl-naval-opportunity-state NAVAL-OPPORTUNITY-SCAN-TRANSPORT)
)

(defrule
	(goal gl-naval-opportunity-state NAVAL-OPPORTUNITY-REJECT)
	(goal gl-naval-opportunity-target-kind NAVAL-OPPORTUNITY-TRANSPORT)
	(up-compare-goal gl-naval-opportunity-reject-count c:>= 2)
=>
	(up-full-reset-search)
	(up-set-target-point gl-naval-opportunity-source-x)
	(up-filter-distance c: -1 c: 60)
	(up-find-remote c: fishing-ship-class c: 30)
	(up-remove-objects search-remote object-data-map-zone-id g:!= gl-naval-opportunity-zone)
	(up-clean-search search-remote object-data-distance search-order-asc)
	(set-goal gl-naval-opportunity-reject-count 0)
	(set-goal gl-naval-opportunity-state NAVAL-OPPORTUNITY-SCAN-FISHING)
)

(defrule
	(goal gl-naval-opportunity-state NAVAL-OPPORTUNITY-REJECT)
	(goal gl-naval-opportunity-target-kind NAVAL-OPPORTUNITY-FISHING)
	(up-compare-goal gl-naval-opportunity-reject-count c:< 2)
=>
	(up-full-reset-search)
	(up-set-target-point gl-naval-opportunity-source-x)
	(up-filter-distance c: -1 c: 60)
	(up-find-remote c: fishing-ship-class c: 30)
	(up-remove-objects search-remote object-data-id g:== gl-naval-opportunity-rejected-id)
	(up-remove-objects search-remote object-data-id g:== gl-naval-opportunity-rejected-id2)
	(up-remove-objects search-remote object-data-map-zone-id g:!= gl-naval-opportunity-zone)
	(up-clean-search search-remote object-data-distance search-order-asc)
	(set-goal gl-naval-opportunity-state NAVAL-OPPORTUNITY-SCAN-FISHING)
)

(defrule
	(goal gl-naval-opportunity-state NAVAL-OPPORTUNITY-REJECT)
	(goal gl-naval-opportunity-target-kind NAVAL-OPPORTUNITY-FISHING)
	(up-compare-goal gl-naval-opportunity-reject-count c:>= 2)
=>
	(up-chat-data-to-self "naval opportunity rejected near defenses: %d" g: gl-naval-opportunity-target-id)
	(up-modify-sn sn-focus-player-number g:= gl-naval-opportunity-focus)
	(set-goal gl-naval-opportunity-active-id -1)
	(set-goal gl-naval-opportunity-rejected-id -1)
	(set-goal gl-naval-opportunity-rejected-id2 -1)
	(set-goal gl-naval-opportunity-reject-count 0)
	(up-modify-goal gl-naval-opportunity-rejected-zone3 g:= gl-naval-opportunity-rejected-zone2)
	(up-modify-goal gl-naval-opportunity-rejected-zone2 g:= gl-naval-opportunity-rejected-zone)
	(up-modify-goal gl-naval-opportunity-rejected-zone g:= gl-naval-opportunity-zone)
	(up-modify-goal gl-naval-opportunity-next g:= gl-game-time)
	(up-modify-goal gl-naval-opportunity-next c:+ 8)
	(set-goal gl-naval-opportunity-state NAVAL-OPPORTUNITY-IDLE)
)

;A changed target is commanded immediately. An unchanged live target is only
;refreshed every 30 seconds so the controller does not reset wind-up/pathing on
;every six-second opportunity scan.
(defrule
	(goal gl-naval-opportunity-state NAVAL-OPPORTUNITY-PREPARE)
	(or
		(up-compare-goal gl-naval-opportunity-target-id g:!= gl-naval-opportunity-active-id)
		(up-compare-goal gl-game-time g:>= gl-naval-opportunity-refresh)
	)
=>
	(set-goal gl-naval-opportunity-state NAVAL-OPPORTUNITY-COMMAND)
)

(defrule
	(goal gl-naval-opportunity-state NAVAL-OPPORTUNITY-PREPARE)
	(and
		(up-compare-goal gl-naval-opportunity-target-id g:== gl-naval-opportunity-active-id)
		(up-compare-goal gl-game-time g:< gl-naval-opportunity-refresh)
	)
=>
	(up-modify-sn sn-focus-player-number g:= gl-naval-opportunity-focus)
	(set-goal gl-naval-opportunity-rejected-zone -1)
	(set-goal gl-naval-opportunity-rejected-zone2 -1)
	(set-goal gl-naval-opportunity-rejected-zone3 -1)
	(set-goal gl-naval-opportunity-rejected-id -1)
	(set-goal gl-naval-opportunity-rejected-id2 -1)
	(set-goal gl-naval-opportunity-reject-count 0)
	(up-modify-goal gl-naval-opportunity-next g:= gl-game-time)
	(up-modify-goal gl-naval-opportunity-next c:+ 6)
	(set-goal gl-naval-opportunity-state NAVAL-OPPORTUNITY-IDLE)
)

(defrule
	(goal gl-naval-opportunity-state NAVAL-OPPORTUNITY-COMMAND)
	(goal gl-home-defense-state NO)
=>
	(set-strategic-number sn-focus-player-number my-player-number)
	(up-full-reset-search)
	(up-set-target-point gl-naval-opportunity-source-x)
	(up-filter-distance c: -1 c: 32)
	(up-find-local c: scout-galley-line c: 30)
	(up-find-local c: polyreme-line c: 30)
	(up-find-local c: hemiolia-line c: 30)
	(up-find-local c: quadrireme c: 30)
	(up-find-local c: quinquereme c: 30)
	(up-find-local c: liburna-line c: 30)
	(up-find-local c: fire-ship-line c: 30)
	(up-find-local c: fire-galley c: 30)
	(up-find-local c: boarding-ship c: 30)
	(up-remove-objects search-local object-data-under-attack > 0)
	(up-remove-objects search-local object-data-idling != 1)
	(up-remove-objects search-local object-data-action == actionid-explore)
	(up-remove-objects search-local object-data-action == actionid-follow)
	(up-remove-objects search-local object-data-group-flag >= 0)
	(up-remove-objects search-local object-data-map-zone-id g:!= gl-naval-opportunity-zone)
	(up-clean-search search-local object-data-distance search-order-asc)
	(up-remove-objects search-local object-data-index >= 12)
	(up-get-search-state local-total)
	(up-modify-goal gl-naval-opportunity-ship-count g:= local-total)
	(up-modify-sn sn-focus-player-number g:= gl-naval-opportunity-player)
	(up-add-object-by-id search-remote g: gl-naval-opportunity-target-id)
	(set-goal gl-naval-opportunity-state NAVAL-OPPORTUNITY-VERIFY)
)

;The selected ship list and enemy object ID are both revalidated immediately
;before issuing the order. This keeps stale searches from producing false
;success telemetry or commanding an empty list.
(defrule
	(goal gl-naval-opportunity-state NAVAL-OPPORTUNITY-VERIFY)
	(up-compare-goal gl-naval-opportunity-ship-count c:> 0)
	(up-set-target-object search-remote c: 0)
=>
	;OWNERSHIP command: FREE.
	(up-remove-objects search-local object-data-player != my-player-number)
	(up-remove-objects search-local object-data-group-flag >= 0)
	(up-target-objects 1 action-default -1 stance-aggressive)
	(up-modify-goal gl-naval-opportunity-active-id g:= gl-naval-opportunity-target-id)
	(up-modify-goal gl-naval-opportunity-refresh g:= gl-game-time)
	(up-modify-goal gl-naval-opportunity-refresh c:+ 30)
	(set-goal gl-naval-opportunity-state NAVAL-OPPORTUNITY-FINISH)
)

(defrule
	(goal gl-naval-opportunity-state NAVAL-OPPORTUNITY-VERIFY)
	(up-compare-goal gl-naval-opportunity-ship-count c:<= 0)
=>
	(chat-local-to-self "naval opportunity failed: no eligible ships")
	(up-modify-sn sn-focus-player-number g:= gl-naval-opportunity-focus)
	(set-goal gl-naval-opportunity-active-id -1)
	(set-goal gl-naval-opportunity-rejected-id -1)
	(set-goal gl-naval-opportunity-rejected-id2 -1)
	(set-goal gl-naval-opportunity-reject-count 0)
	(up-modify-goal gl-naval-opportunity-next g:= gl-game-time)
	(up-modify-goal gl-naval-opportunity-next c:+ 6)
	(set-goal gl-naval-opportunity-state NAVAL-OPPORTUNITY-IDLE)
)

(defrule
	(goal gl-naval-opportunity-state NAVAL-OPPORTUNITY-VERIFY)
	(up-compare-goal gl-naval-opportunity-ship-count c:> 0)
	(not (up-set-target-object search-remote c: 0))
=>
	(up-chat-data-to-self "naval opportunity failed: target lost %d" g: gl-naval-opportunity-target-id)
	(up-modify-sn sn-focus-player-number g:= gl-naval-opportunity-focus)
	(set-goal gl-naval-opportunity-active-id -1)
	(set-goal gl-naval-opportunity-rejected-id -1)
	(set-goal gl-naval-opportunity-rejected-id2 -1)
	(set-goal gl-naval-opportunity-reject-count 0)
	(up-modify-goal gl-naval-opportunity-next g:= gl-game-time)
	(up-modify-goal gl-naval-opportunity-next c:+ 6)
	(set-goal gl-naval-opportunity-state NAVAL-OPPORTUNITY-IDLE)
)

(defrule
	(goal gl-naval-opportunity-state NAVAL-OPPORTUNITY-FINISH)
=>
	(up-chat-data-to-self "naval opportunity target kind: %d" g: gl-naval-opportunity-target-kind)
	(up-chat-data-to-self "naval opportunity target id: %d" g: gl-naval-opportunity-target-id)
	(up-chat-data-to-self "naval opportunity ships: %d" g: gl-naval-opportunity-ship-count)
	(up-modify-sn sn-focus-player-number g:= gl-naval-opportunity-focus)
	(set-goal gl-naval-opportunity-rejected-id -1)
	(set-goal gl-naval-opportunity-rejected-id2 -1)
	(set-goal gl-naval-opportunity-reject-count 0)
	(set-goal gl-naval-opportunity-rejected-zone -1)
	(set-goal gl-naval-opportunity-rejected-zone2 -1)
	(set-goal gl-naval-opportunity-rejected-zone3 -1)
	(up-modify-goal gl-naval-opportunity-next g:= gl-game-time)
	(up-modify-goal gl-naval-opportunity-next c:+ 6)
	(set-goal gl-naval-opportunity-state NAVAL-OPPORTUNITY-IDLE)
)

;Home defense or loss of the naval-theater gate may occur between source
;selection and command. Restore borrowed focus before abandoning the intercept.
(defrule
	(not (goal gl-naval-opportunity-state NAVAL-OPPORTUNITY-IDLE))
	(or
		(goal gl-home-defense-state YES)
		(goal gl-naval-theater NO)
	)
=>
	(up-modify-sn sn-focus-player-number g:= gl-naval-opportunity-focus)
	(set-goal gl-naval-opportunity-active-id -1)
	(set-goal gl-naval-opportunity-rejected-id -1)
	(set-goal gl-naval-opportunity-rejected-id2 -1)
	(set-goal gl-naval-opportunity-reject-count 0)
	(set-goal gl-naval-opportunity-rejected-zone -1)
	(set-goal gl-naval-opportunity-rejected-zone2 -1)
	(set-goal gl-naval-opportunity-rejected-zone3 -1)
	(up-modify-goal gl-naval-opportunity-next g:= gl-game-time)
	(up-modify-goal gl-naval-opportunity-next c:+ 8)
	(set-goal gl-naval-opportunity-state NAVAL-OPPORTUNITY-IDLE)
)

;Track the actual Transport Ship capacity used by the current civilization.
#load-if-defined AZTEC-CIV
(defrule
	(true)
=>
	(up-modify-goal gl-transport-min-load c:+ 10)
	(up-modify-goal gl-transport-capacity c:+ 10)
	(disable-self)
)
#end-if

;Careening and Dry Dock raise the normal five-slot hull to ten and twenty.
;Keep both lift planning and the departure threshold synchronized with research.
(defrule
	(research-completed ri-careening)
	(goal gl-transport-capacity-upgrade 0)
=>
	(up-modify-goal gl-transport-min-load c:+ 5)
	(up-modify-goal gl-transport-capacity c:+ 5)
	(set-goal gl-transport-capacity-upgrade 1)
)

(defrule
	(research-completed ri-dry-dock)
	(goal gl-transport-capacity-upgrade 0)
=>
	(up-modify-goal gl-transport-min-load c:+ 15)
	(up-modify-goal gl-transport-capacity c:+ 15)
	(set-goal gl-transport-capacity-upgrade 2)
)

(defrule
	(research-completed ri-dry-dock)
	(goal gl-transport-capacity-upgrade 1)
=>
	(up-modify-goal gl-transport-min-load c:+ 10)
	(up-modify-goal gl-transport-capacity c:+ 10)
	(set-goal gl-transport-capacity-upgrade 2)
)

;Global resource depletion includes every explored island and therefore cannot
;detect exhaustion of the current active-home land zone. Count its observed
;mines and trees separately; five or fewer trees is a bounded wood-exhaustion
;warning, not a claim that the whole map is empty.
(defrule
	(up-timer-status t-home-resource-pressure == timer-triggered)
	(current-age >= middle-antiquity-age)
	(or
		(goal map-type RIVERS)
		(or
			(goal map-type ISLANDS)
			(goal map-type TEAM-ISLANDS)
		)
	)
=>
	(set-strategic-number sn-focus-player-number 0)
	(up-full-reset-search)
	(up-set-target-point gl-home-anchor-x)
	(up-find-remote c: stone-mine-class c: 20)
	(up-remove-objects search-remote object-data-map-zone-id g:!= gl-home-zone)
	(up-get-search-state local-total)
	(up-modify-goal gl-home-stone-count g:= remote-total)
)

;A low bank alone is not depletion: a healthy economy can be spending gold as
;fast as it mines it. Require three consecutive 45-second samples with no gold
;miner before low banked gold contributes to the migration pressure latch.
(defrule
	(up-timer-status t-home-resource-pressure == timer-triggered)
	(current-age >= middle-antiquity-age)
	(gold-amount < 200)
	(unit-type-count villager-gold < 1)
	(up-compare-goal gl-home-low-gold-samples c:< 4)
	(or
		(goal map-type RIVERS)
		(or
			(goal map-type ISLANDS)
			(goal map-type TEAM-ISLANDS)
		)
	)
=>
	(up-modify-goal gl-home-low-gold-samples c:+ 1)
)

(defrule
	(up-timer-status t-home-resource-pressure == timer-triggered)
	(or
		(gold-amount >= 300)
		(unit-type-count villager-gold >= 1)
	)
	(or
		(goal map-type RIVERS)
		(or
			(goal map-type ISLANDS)
			(goal map-type TEAM-ISLANDS)
		)
	)
=>
	(set-goal gl-home-low-gold-samples 0)
)

(defrule
	(up-timer-status t-home-resource-pressure == timer-triggered)
	(current-age >= middle-antiquity-age)
	(or
		(goal map-type RIVERS)
		(or
			(goal map-type ISLANDS)
			(goal map-type TEAM-ISLANDS)
		)
	)
=>
	(up-modify-goal gl-home-resource-focus s:= sn-focus-player-number)
	(set-strategic-number sn-focus-player-number 0)
	(up-full-reset-search)
	(up-set-target-point gl-home-anchor-x)
	(up-find-remote c: gold-mine-class c: 20)
	(up-find-remote c: stone-mine-class c: 20)
	(up-remove-objects search-remote object-data-map-zone-id g:!= gl-home-zone)
	(up-get-search-state local-total)
	(up-modify-goal gl-home-mine-count g:= remote-total)
	(up-full-reset-search)
	(up-set-target-point gl-home-anchor-x)
	(up-find-remote c: tree-class c: 40)
	(up-remove-objects search-remote object-data-map-zone-id g:!= gl-home-zone)
	(up-get-search-state local-total)
	(up-modify-goal gl-home-tree-count g:= remote-total)
	(up-modify-sn sn-focus-player-number g:= gl-home-resource-focus)
	(up-set-timer c: t-home-resource-pressure c: 45)
)

(defrule
	(goal gl-home-wood-pressure NO)
	(up-compare-goal gl-home-tree-count c:<= 5)
=>
	(set-goal gl-home-wood-pressure YES)
	(up-chat-data-to-self "home trees low: %d" g: gl-home-tree-count)
)

(defrule
	(goal gl-home-wood-pressure YES)
	(up-compare-goal gl-home-tree-count c:> 5)
=>
	(set-goal gl-home-wood-pressure NO)
	(up-chat-data-to-self "home trees viable: %d" g: gl-home-tree-count)
)

(defrule
	(goal gl-home-resource-pressure NO)
	(or
		(up-compare-goal gl-home-mine-count c:<= 0)
		(or
			(goal gl-home-wood-pressure YES)
			(up-compare-goal gl-home-low-gold-samples c:>= 3)
		)
	)
=>
	(set-goal gl-home-resource-pressure YES)
	(up-chat-data-to-self "home resource pressure: %d" g: gl-home-mine-count)
)

(defrule
	(goal gl-home-resource-pressure YES)
	(up-compare-goal gl-home-mine-count c:> 0)
	(goal gl-home-wood-pressure NO)
	(up-compare-goal gl-home-low-gold-samples c:< 3)
=>
	(set-goal gl-home-resource-pressure NO)
	(up-chat-data-to-self "home resources viable: %d" g: gl-home-mine-count)
)

(defrule
	(goal gl-island-migration-rejection-armed YES)
	(up-compare-goal gl-island-migration-rejected-zone c:>= 0)
	(up-compare-goal gl-game-time g:>= gl-island-migration-rejection-until)
=>
	(up-chat-data-to-self "migration rejected zone released: %d" g: gl-island-migration-rejected-zone)
	(set-goal gl-island-migration-rejected-zone -1)
	(set-goal gl-island-migration-rejected-zone2 -1)
	(set-goal gl-island-migration-rejected-zone3 -1)
	(set-goal gl-island-migration-rejection-armed NO)
)

;Start the failure-ring cooldown only after the hull/passengers have completed
;their bounded return and released migration ownership.
(defrule
	(goal gl-island-migration-state MIGRATION-IDLE)
	(goal gl-island-migration-rejection-armed NO)
	(up-compare-goal gl-island-migration-rejected-zone c:>= 0)
=>
	(up-modify-goal gl-island-migration-rejection-until g:= gl-game-time)
	(up-modify-goal gl-island-migration-rejection-until c:+ 180)
	(set-goal gl-island-migration-rejection-armed YES)
)

;Do not reinforce a colony that the response system has just identified as
;attacked, especially when it reported no same-zone defenders. Keep a bounded
;cooldown after the last land or naval response sweep for that colony zone.
(defrule
	(goal gl-island-colony-established YES)
	(goal gl-island-colony-threat NO)
	(or
		(and
			(not (goal gl-local-response-state LOCAL-RESPONSE-IDLE))
			(up-compare-goal gl-local-response-zone g:== gl-island-colony-zone)
		)
		(and
			(not (goal gl-naval-response-state NAVAL-RESPONSE-IDLE))
			(up-compare-goal gl-naval-response-asset-zone g:== gl-island-colony-zone)
		)
	)
=>
	(set-goal gl-island-colony-threat YES)
	(up-modify-goal gl-island-colony-threat-until g:= gl-game-time)
	(up-modify-goal gl-island-colony-threat-until c:+ 120)
	(up-chat-data-to-self "migration colony threat hold: %d" g: gl-island-colony-zone)
)

(defrule
	(goal gl-island-colony-threat YES)
	(or
		(and
			(not (goal gl-local-response-state LOCAL-RESPONSE-IDLE))
			(up-compare-goal gl-local-response-zone g:== gl-island-colony-zone)
		)
		(and
			(not (goal gl-naval-response-state NAVAL-RESPONSE-IDLE))
			(up-compare-goal gl-naval-response-asset-zone g:== gl-island-colony-zone)
		)
	)
=>
	(up-modify-goal gl-island-colony-threat-until g:= gl-game-time)
	(up-modify-goal gl-island-colony-threat-until c:+ 120)
)

(defrule
	(goal gl-island-colony-threat YES)
	(up-compare-goal gl-game-time g:>= gl-island-colony-threat-until)
=>
	(set-goal gl-island-colony-threat NO)
	(up-chat-data-to-self "migration colony threat cleared: %d" g: gl-island-colony-zone)
)

;Use otherwise idle villagers to establish a second economy off the home
;island. The landing point must be an observed resource site on another land
;zone; interpolating toward the enemy can select an empty intermediate island.
;The owner gate prevents migration from taking the shared placement channel
;while a colony Town Center is being placed or remains under construction.
(defrule
	(up-timer-status t-island-migration == timer-triggered)
	(goal gl-island-migration-state MIGRATION-IDLE)
	(goal gl-relic-ferry-state RELIC-FERRY-IDLE)
	(goal gl-transport-recovery-state TRANSPORT-RECOVERY-IDLE)
	(goal gl-transport-repair-state TRANSPORT-REPAIR-IDLE)
	(goal gl-transport-route-state TRANSPORT-ROUTE-IDLE)
	(goal gl-transport-clear-state TRANSPORT-CLEAR-IDLE)
	(goal gl-colony-towncenter-state COLONY-TC-IDLE)
	(up-pending-objects c: town-center <= 0)
	(not (up-pending-placement c: town-center))
	(or
		(up-timer-status t-transport-route != timer-triggered)
		(or
			(not (goal gl-assault-admission-open YES))
			(or
				(not (goal gl-home-defense-state NO))
				(or
					(unit-type-count transport-ship < 1)
					(up-compare-goal gl-ap-seed-enemy c:< 1)
				)
			)
		)
	)

=>
	;T25 Green spent most of the final 36 minutes cycling one failed migration
	;after another.  The zone rejection ring worked, but this earlier rule won
	;the shared idle lane whenever both sixty-second migration recovery and the
	;assault timer were ready. Yield exactly one admission pass when every outer
	;assault prerequisite is live. A rejected assault resets its own timer, so
	;the still-triggered migration timer can claim the lane on the next sweep.
	(set-goal gl-island-migration-state MIGRATION-GATE-OWNER)
)

(defrule
	(goal gl-island-migration-state MIGRATION-GATE-OWNER)
=>
	(set-goal gl-island-scout-zone-rejections 0)
)

(defrule
	(goal gl-island-migration-state MIGRATION-GATE-OWNER)
	(goal gl-home-defense-state NO)
	(goal resources-depleted NO)
	(goal gl-home-resource-pressure NO)
	(up-compare-goal gl-home-stone-count c:> 0)
	(current-age >= early-antiquity-age)
	(current-age < imperial-age)
	(up-compare-goal gl-island-scout-attempts c:< 3)
	(unit-type-count transport-ship >= 1)
	(unit-type-count scout-cavalry-class >= 1)
	(or
		(goal map-type RIVERS)
		(or
			(goal map-type ISLANDS)
			(goal map-type TEAM-ISLANDS)
		)
	)
=>
	(set-goal gl-island-migration-state MIGRATION-PLAN-SCOUT)
)

(defrule
	(goal gl-island-migration-state MIGRATION-PLAN-SCOUT)
=>
	(up-modify-goal gl-island-migration-focus s:= sn-focus-player-number)
	(set-strategic-number sn-focus-player-number 0)
	(up-full-reset-search)
	(up-set-target-point gl-home-anchor-x)
	(up-find-remote c: tree-class c: 40)
	(up-find-remote c: forage-class c: 10)
	(up-find-remote c: prey-animal-class c: 10)
	(up-remove-objects search-remote object-data-map-zone-id g:== gl-home-zone)
	(up-remove-objects search-remote object-data-map-zone-id g:== gl-island-migration-rejected-zone)
	(up-remove-objects search-remote object-data-map-zone-id g:== gl-island-migration-rejected-zone2)
	(up-remove-objects search-remote object-data-map-zone-id g:== gl-island-migration-rejected-zone3)
	(up-remove-objects search-remote object-data-map-zone-id g:== gl-island-scout-visited-zone)
	(up-remove-objects search-remote object-data-map-zone-id g:== gl-island-scout-visited-zone2)
	(up-remove-objects search-remote object-data-map-zone-id g:== gl-island-scout-visited-zone3)
	(up-clean-search search-remote object-data-distance search-order-desc)
	(set-goal gl-island-migration-mission MIGRATION-MISSION-SCOUT)
	(up-set-timer c: t-island-migration c: 180)
	(set-goal gl-island-migration-state MIGRATION-FIND-SCOUT-LANDING)
)

;When the active home has no useful stone reserve, give a known remote stone
;deposit first ownership of the next civilian lift. The generic mine selector
;below remains the fallback when no stone-priority mission claims the gate.
(defrule
	(goal gl-island-migration-state MIGRATION-GATE-OWNER)
	(goal gl-home-defense-state NO)
	(goal gl-island-colony-threat NO)
	(current-age >= middle-antiquity-age)
	(up-compare-goal gl-home-stone-count c:<= 0)
	(unit-type-count transport-ship >= 1)
	(or
		(up-idle-unit-count idle-type-villager >= 2)
		(or
			(goal resources-depleted YES)
			(or
				(goal gl-home-resource-pressure YES)
				(villager-count >= 60)
			)
		)
	)
	(or
		(goal map-type RIVERS)
		(or
			(goal map-type ISLANDS)
			(goal map-type TEAM-ISLANDS)
		)
	)
=>
	(up-modify-goal gl-island-migration-focus s:= sn-focus-player-number)
	(set-strategic-number sn-focus-player-number 0)
	(up-full-reset-search)
	(up-set-target-point gl-home-anchor-x)
	(up-find-remote c: stone-mine-class c: 20)
	(up-remove-objects search-remote object-data-map-zone-id g:== gl-home-zone)
	(up-remove-objects search-remote object-data-map-zone-id g:== gl-island-migration-rejected-zone)
	(up-remove-objects search-remote object-data-map-zone-id g:== gl-island-migration-rejected-zone2)
	(up-remove-objects search-remote object-data-map-zone-id g:== gl-island-migration-rejected-zone3)
	(up-clean-search search-remote object-data-distance search-order-asc)
	(set-goal gl-island-migration-mission MIGRATION-MISSION-MINING)
	(up-chat-data-to-self "migration remote stone priority: %d" g: gl-home-zone)
	(up-set-timer c: t-island-migration c: 180)
	(set-goal gl-island-migration-state MIGRATION-FIND-LANDING)
)

(defrule
	(goal gl-island-migration-state MIGRATION-GATE-OWNER)
	(goal gl-home-defense-state NO)
	(goal gl-island-colony-threat NO)
	(current-age >= middle-antiquity-age)
	(unit-type-count transport-ship >= 1)
	(or
		(up-idle-unit-count idle-type-villager >= 2)
		(or
			(goal resources-depleted YES)
			(or
				(goal gl-home-resource-pressure YES)
				(villager-count >= 60)
			)
		)
	)
	(or
		(goal map-type RIVERS)
		(or
			(goal map-type ISLANDS)
			(goal map-type TEAM-ISLANDS)
		)
	)
=>
	(up-modify-goal gl-island-migration-focus s:= sn-focus-player-number)
	(set-strategic-number sn-focus-player-number 0)
	(up-full-reset-search)
	(up-set-target-point gl-home-anchor-x)
	(up-find-remote c: gold-mine-class c: 10)
	(up-find-remote c: stone-mine-class c: 10)
	(up-remove-objects search-remote object-data-map-zone-id g:== gl-home-zone)
	(up-remove-objects search-remote object-data-map-zone-id g:== gl-island-migration-rejected-zone)
	(up-remove-objects search-remote object-data-map-zone-id g:== gl-island-migration-rejected-zone2)
	(up-remove-objects search-remote object-data-map-zone-id g:== gl-island-migration-rejected-zone3)
	(up-clean-search search-remote object-data-distance search-order-asc)
	(set-goal gl-island-migration-mission MIGRATION-MISSION-MINING)
	(up-set-timer c: t-island-migration c: 180)
	(set-goal gl-island-migration-state MIGRATION-FIND-LANDING)
)

;If neither civilian nor scout migration owns an expired timer, record a
;bounded gate snapshot. A zero utility sum means every competing transport
;controller is idle; the idle bucket distinguishes visually waiting villagers
;that the engine still considers assigned.
(defrule
	(goal gl-island-migration-state MIGRATION-GATE-OWNER)
	(current-age >= middle-antiquity-age)
	(up-compare-goal gl-island-migration-gate-reports c:< 5)
	(up-idle-unit-count idle-type-villager >= 2)
	(or
		(goal map-type RIVERS)
		(or
			(goal map-type ISLANDS)
			(goal map-type TEAM-ISLANDS)
		)
	)
=>
	(set-goal gl-island-migration-utility-blocks 0)
	(up-modify-goal gl-island-migration-utility-blocks g:+ gl-relic-ferry-state)
	(up-modify-goal gl-island-migration-utility-blocks g:+ gl-transport-recovery-state)
	(up-modify-goal gl-island-migration-utility-blocks g:+ gl-transport-repair-state)
	(up-modify-goal gl-island-migration-utility-blocks g:+ gl-transport-route-state)
	(up-modify-goal gl-island-migration-utility-blocks g:+ gl-transport-clear-state)
	(up-get-fact unit-type-count transport-ship local-total)
	(up-get-fact unit-type-count villager-fisherman gl-island-migration-fishermen)
	(up-chat-data-to-self "migration gate idle bucket: %d" c: 2)
	(up-chat-data-to-self "migration gate transports: %d" g: local-total)
	(up-chat-data-to-self "migration gate fishermen: %d" g: gl-island-migration-fishermen)
	(up-chat-data-to-self "migration gate defense: %d" g: gl-home-defense-state)
	(up-chat-data-to-self "migration gate depleted: %d" g: resources-depleted)
	(up-chat-data-to-self "migration gate home mines: %d" g: gl-home-mine-count)
	(up-chat-data-to-self "migration gate utility sum: %d" g: gl-island-migration-utility-blocks)
	(up-modify-goal gl-island-migration-gate-reports c:+ 1)
	(up-set-timer c: t-island-migration c: 60)
)

(defrule
	(goal gl-island-migration-state MIGRATION-GATE-OWNER)
	(current-age >= middle-antiquity-age)
	(up-compare-goal gl-island-migration-gate-reports c:< 5)
	(up-idle-unit-count idle-type-villager < 2)
	(or
		(goal map-type RIVERS)
		(or
			(goal map-type ISLANDS)
			(goal map-type TEAM-ISLANDS)
		)
	)
=>
	(set-goal gl-island-migration-utility-blocks 0)
	(up-modify-goal gl-island-migration-utility-blocks g:+ gl-relic-ferry-state)
	(up-modify-goal gl-island-migration-utility-blocks g:+ gl-transport-recovery-state)
	(up-modify-goal gl-island-migration-utility-blocks g:+ gl-transport-repair-state)
	(up-modify-goal gl-island-migration-utility-blocks g:+ gl-transport-route-state)
	(up-modify-goal gl-island-migration-utility-blocks g:+ gl-transport-clear-state)
	(up-get-fact unit-type-count transport-ship local-total)
	(up-get-fact unit-type-count villager-fisherman gl-island-migration-fishermen)
	(up-chat-data-to-self "migration gate idle bucket: %d" c: 0)
	(up-chat-data-to-self "migration gate transports: %d" g: local-total)
	(up-chat-data-to-self "migration gate fishermen: %d" g: gl-island-migration-fishermen)
	(up-chat-data-to-self "migration gate defense: %d" g: gl-home-defense-state)
	(up-chat-data-to-self "migration gate depleted: %d" g: resources-depleted)
	(up-chat-data-to-self "migration gate home mines: %d" g: gl-home-mine-count)
	(up-chat-data-to-self "migration gate utility sum: %d" g: gl-island-migration-utility-blocks)
	(up-modify-goal gl-island-migration-gate-reports c:+ 1)
	(up-set-timer c: t-island-migration c: 60)
)

(defrule
	(goal gl-island-migration-state MIGRATION-GATE-OWNER)
=>
	(up-set-timer c: t-island-migration c: 30)
	(set-goal gl-island-migration-state MIGRATION-IDLE)
)

(defrule
	(goal gl-island-migration-state MIGRATION-FIND-LANDING)
	(up-set-target-object search-remote c: 0)
=>
	(up-get-object-data object-data-id gl-island-migration-anchor-id)
	(up-get-object-data object-data-class gl-island-migration-anchor-class)
	(up-get-object-data object-data-map-zone-id gl-island-migration-zone)
	(up-get-point position-object gl-island-migration-target-x)
	(up-chat-data-to-self "migration target zone: %d" g: gl-island-migration-zone)
	(set-strategic-number sn-focus-player-number my-player-number)
	(up-full-reset-search)
	(up-set-target-point gl-home-anchor-x)
	(up-find-remote c: transport-ship c: 40)
	(up-remove-objects search-remote object-data-id g:== gl-quarantine-transport-id)
	(up-remove-objects search-remote object-data-garrison-count > 0)
	(up-remove-objects search-remote object-data-idling != 1)
	(up-remove-objects search-remote object-data-under-attack > 0)
	(up-remove-objects search-remote object-data-group-flag >= 0)
	(up-clean-search search-remote object-data-distance search-order-asc)
	(set-goal gl-island-migration-state MIGRATION-FIND-TRANSPORT)
)

(defrule
	(goal gl-island-migration-state MIGRATION-FIND-LANDING)
	(not (up-set-target-object search-remote c: 0))
=>
	(up-full-reset-search)
	(up-set-target-point gl-home-anchor-x)
	(up-find-remote c: tree-class c: 40)
	(up-find-remote c: forage-class c: 10)
	(up-find-remote c: prey-animal-class c: 10)
	(up-remove-objects search-remote object-data-map-zone-id g:== gl-home-zone)
	(up-remove-objects search-remote object-data-map-zone-id g:== gl-island-migration-rejected-zone)
	(up-remove-objects search-remote object-data-map-zone-id g:== gl-island-migration-rejected-zone2)
	(up-remove-objects search-remote object-data-map-zone-id g:== gl-island-migration-rejected-zone3)
	(up-clean-search search-remote object-data-distance search-order-desc)
	(set-goal gl-island-migration-state MIGRATION-FIND-COLONY-LANDING)
)

(defrule
	(goal gl-island-migration-state MIGRATION-FIND-COLONY-LANDING)
	(up-set-target-object search-remote c: 0)
=>
	(up-get-object-data object-data-id gl-island-migration-anchor-id)
	(up-get-object-data object-data-class gl-island-migration-anchor-class)
	(up-get-object-data object-data-map-zone-id gl-island-migration-zone)
	(up-get-point position-object gl-island-migration-target-x)
	(up-chat-data-to-self "migration colony zone: %d" g: gl-island-migration-zone)
	(set-strategic-number sn-focus-player-number my-player-number)
	(up-full-reset-search)
	(up-set-target-point gl-home-anchor-x)
	(up-find-remote c: transport-ship c: 40)
	(up-remove-objects search-remote object-data-id g:== gl-quarantine-transport-id)
	(up-remove-objects search-remote object-data-garrison-count > 0)
	(up-remove-objects search-remote object-data-idling != 1)
	(up-remove-objects search-remote object-data-under-attack > 0)
	(up-remove-objects search-remote object-data-group-flag >= 0)
	(up-clean-search search-remote object-data-distance search-order-asc)
	(set-goal gl-island-migration-state MIGRATION-FIND-TRANSPORT)
)

(defrule
	(goal gl-island-migration-state MIGRATION-FIND-COLONY-LANDING)
	(not (up-set-target-object search-remote c: 0))
=>
	(up-chat-data-to-self "migration no colony: %d" c: 0)
	(up-modify-sn sn-focus-player-number g:= gl-island-migration-focus)
	(up-set-timer c: t-island-migration c: 60)
	(set-goal gl-island-migration-state MIGRATION-IDLE)
)

;When no remote mine is known, use the farthest observed off-mainland natural
;object as a beachhead for a transported scout. This deliberately favors a
;barely revealed land mass over a shoreline the AI has already explored.
(defrule
	(goal gl-island-migration-state MIGRATION-FIND-SCOUT-LANDING)
	(up-set-target-object search-remote c: 0)
	(unit-type-count scout-cavalry-class >= 1)
	(not (player-in-game any-ally))
=>
	(up-get-object-data object-data-id gl-island-migration-anchor-id)
	(up-get-object-data object-data-class gl-island-migration-anchor-class)
	(up-get-object-data object-data-map-zone-id gl-island-migration-zone)
	(up-get-point position-object gl-island-migration-target-x)
	(set-strategic-number sn-focus-player-number my-player-number)
	(up-full-reset-search)
	(up-set-target-point gl-home-anchor-x)
	(up-find-remote c: transport-ship c: 40)
	(up-remove-objects search-remote object-data-id g:== gl-quarantine-transport-id)
	(up-remove-objects search-remote object-data-garrison-count > 0)
	(up-remove-objects search-remote object-data-idling != 1)
	(up-remove-objects search-remote object-data-under-attack > 0)
	(up-remove-objects search-remote object-data-group-flag >= 0)
	(up-clean-search search-remote object-data-distance search-order-asc)
	(set-goal gl-island-migration-state MIGRATION-FIND-TRANSPORT)
)

;Shared exploration can expose an ally's whole island before our scout has
;left home. Reject a candidate land zone containing any allied building rather
;than repeatedly ferrying scouts to a teammate's already-settled base.
(defrule
	(goal gl-island-migration-state MIGRATION-FIND-SCOUT-LANDING)
	(up-set-target-object search-remote c: 0)
	(unit-type-count scout-cavalry-class >= 1)
	(player-in-game any-ally)
=>
	(up-get-object-data object-data-id gl-island-migration-anchor-id)
	(up-get-object-data object-data-class gl-island-migration-anchor-class)
	(up-get-object-data object-data-map-zone-id gl-island-migration-zone)
	(up-get-point position-object gl-island-migration-target-x)
	(up-find-player ally find-ordered gl-island-scout-player)
	(up-modify-goal gl-island-scout-first g:= gl-island-scout-player)
	(set-goal gl-island-migration-state MIGRATION-SCOUT-ALLY-START)
)

(defrule
	(goal gl-island-migration-state MIGRATION-SCOUT-ALLY-START)
=>
	(up-modify-sn sn-focus-player-number g:= gl-island-scout-player)
	(up-full-reset-search)
	(up-set-target-point gl-island-migration-target-x)
	(up-filter-status c: status-ready c: list-active)
	(up-find-remote c: building-class c: 40)
	(up-remove-objects search-remote object-data-map-zone-id g:!= gl-island-migration-zone)
	(up-clean-search search-remote object-data-distance search-order-asc)
	(set-goal gl-island-migration-state MIGRATION-SCOUT-ALLY-CHECK)
)

(defrule
	(goal gl-island-migration-state MIGRATION-SCOUT-ALLY-CHECK)
	(up-set-target-object search-remote c: 0)
	(up-compare-goal gl-island-scout-zone-rejections c:< 3)
=>
	(up-chat-data-to-self "migration scout rejected allied zone: %d" g: gl-island-migration-zone)
	(up-modify-goal gl-island-scout-zone-rejections c:+ 1)
	(up-modify-goal gl-island-scout-visited-zone3 g:= gl-island-scout-visited-zone2)
	(up-modify-goal gl-island-scout-visited-zone2 g:= gl-island-scout-visited-zone)
	(up-modify-goal gl-island-scout-visited-zone g:= gl-island-migration-zone)
	(set-strategic-number sn-focus-player-number 0)
	(up-full-reset-search)
	(up-set-target-point gl-home-anchor-x)
	(up-find-remote c: tree-class c: 40)
	(up-find-remote c: forage-class c: 10)
	(up-find-remote c: prey-animal-class c: 10)
	(up-remove-objects search-remote object-data-map-zone-id g:== gl-home-zone)
	(up-remove-objects search-remote object-data-map-zone-id g:== gl-island-migration-rejected-zone)
	(up-remove-objects search-remote object-data-map-zone-id g:== gl-island-migration-rejected-zone2)
	(up-remove-objects search-remote object-data-map-zone-id g:== gl-island-migration-rejected-zone3)
	(up-remove-objects search-remote object-data-map-zone-id g:== gl-island-scout-visited-zone)
	(up-remove-objects search-remote object-data-map-zone-id g:== gl-island-scout-visited-zone2)
	(up-remove-objects search-remote object-data-map-zone-id g:== gl-island-scout-visited-zone3)
	(up-clean-search search-remote object-data-distance search-order-desc)
	(set-goal gl-island-migration-state MIGRATION-SCOUT-RETRY-LANDING)
)

;Three allied-settlement rejections exhaust this scout mission. The visited
;ring cannot represent a fourth zone, so back off instead of rotating A/B/C/D
;forever while monopolizing the migration controller.
(defrule
	(goal gl-island-migration-state MIGRATION-SCOUT-ALLY-CHECK)
	(up-set-target-object search-remote c: 0)
	(up-compare-goal gl-island-scout-zone-rejections c:>= 3)
=>
	(up-chat-data-to-self "migration scout allied-zone budget exhausted: %d" g: gl-island-migration-zone)
	(up-modify-sn sn-focus-player-number g:= gl-island-migration-focus)
	(up-set-timer c: t-island-migration c: 120)
	(set-goal gl-island-migration-state MIGRATION-IDLE)
)

;The ordinary landing consumer is earlier in this file. Consume the rebuilt
;Gaia list here in the same sweep so no later controller can replace shared
;search-remote before the next candidate is captured.
(defrule
	(goal gl-island-migration-state MIGRATION-SCOUT-RETRY-LANDING)
	(up-set-target-object search-remote c: 0)
=>
	(up-get-object-data object-data-id gl-island-migration-anchor-id)
	(up-get-object-data object-data-class gl-island-migration-anchor-class)
	(up-get-object-data object-data-map-zone-id gl-island-migration-zone)
	(up-get-point position-object gl-island-migration-target-x)
	(up-find-player ally find-ordered gl-island-scout-player)
	(up-modify-goal gl-island-scout-first g:= gl-island-scout-player)
	(set-goal gl-island-migration-state MIGRATION-SCOUT-ALLY-START)
)

(defrule
	(goal gl-island-migration-state MIGRATION-SCOUT-RETRY-LANDING)
	(not (up-set-target-object search-remote c: 0))
=>
	(up-modify-sn sn-focus-player-number g:= gl-island-migration-focus)
	(up-set-timer c: t-island-migration c: 60)
	(set-goal gl-island-migration-state MIGRATION-IDLE)
)

(defrule
	(goal gl-island-migration-state MIGRATION-SCOUT-ALLY-CHECK)
	(not (up-set-target-object search-remote c: 0))
=>
	(set-goal gl-island-migration-state MIGRATION-SCOUT-ALLY-ADVANCE)
)

(defrule
	(goal gl-island-migration-state MIGRATION-SCOUT-ALLY-ADVANCE)
=>
	(up-find-next-player ally find-ordered gl-island-scout-player)
	(set-goal gl-island-migration-state MIGRATION-SCOUT-ALLY-NEXT)
)

(defrule
	(goal gl-island-migration-state MIGRATION-SCOUT-ALLY-NEXT)
	(up-compare-goal gl-island-scout-player g:!= gl-island-scout-first)
=>
	(set-goal gl-island-migration-state MIGRATION-SCOUT-ALLY-START)
)

(defrule
	(goal gl-island-migration-state MIGRATION-SCOUT-ALLY-NEXT)
	(up-compare-goal gl-island-scout-player g:== gl-island-scout-first)
=>
	(set-strategic-number sn-focus-player-number my-player-number)
	(up-full-reset-search)
	(up-set-target-point gl-home-anchor-x)
	(up-find-remote c: transport-ship c: 40)
	(up-remove-objects search-remote object-data-id g:== gl-quarantine-transport-id)
	(up-remove-objects search-remote object-data-garrison-count > 0)
	(up-remove-objects search-remote object-data-idling != 1)
	(up-remove-objects search-remote object-data-under-attack > 0)
	(up-remove-objects search-remote object-data-group-flag >= 0)
	(up-clean-search search-remote object-data-distance search-order-asc)
	(set-goal gl-island-migration-state MIGRATION-FIND-TRANSPORT)
)

(defrule
	(goal gl-island-migration-state MIGRATION-FIND-SCOUT-LANDING)
	(or
		(not (up-set-target-object search-remote c: 0))
		(unit-type-count scout-cavalry-class <= 0)
	)
=>
	(up-modify-sn sn-focus-player-number g:= gl-island-migration-focus)
	(set-goal gl-island-migration-state MIGRATION-IDLE)
)

(defrule
	(goal gl-island-migration-state MIGRATION-FIND-TRANSPORT)
	(goal gl-island-migration-mission MIGRATION-MISSION-MINING)
	(up-set-target-object search-remote c: 0)
=>
	(up-get-object-data object-data-id gl-island-migration-transport-id)
	(up-get-point position-object gl-island-migration-origin-x)
	(up-modify-group-flag 0 c: migration-transport-group)
	(up-reset-group c: migration-transport-group)
	(up-full-reset-search)
	(up-add-object-by-id search-local g: gl-island-migration-transport-id)
	(up-remove-objects search-local object-data-id g:!= gl-island-migration-transport-id)
	(up-remove-objects search-local object-data-player != my-player-number)
	(up-remove-objects search-local object-data-group-flag >= 0)
	;An empty idle hull can retain its previous native order. Revalidate the
	;candidate contract, not that stale order; active/loaded/owned voyages stay out.
	(up-remove-objects search-local object-data-garrison-count > 0)
	(up-remove-objects search-local object-data-idling != 1)
	(up-remove-objects search-local object-data-under-attack > 0)
	(up-create-group 0 0 c: migration-transport-group)
	(up-modify-group-flag 1 c: migration-transport-group)
	(set-goal gl-island-migration-state MIGRATION-HULL-VERIFY)
)

;A scout attempt is consumed only after a real, empty hull is reserved.  Early
;land-search misses or a missing Transport Ship therefore cannot permanently
;exhaust the three bounded missions before naval production comes online.
(defrule
	(goal gl-island-migration-state MIGRATION-FIND-TRANSPORT)
	(goal gl-island-migration-mission MIGRATION-MISSION-SCOUT)
	(up-set-target-object search-remote c: 0)
=>
	(up-get-object-data object-data-id gl-island-migration-transport-id)
	(up-get-point position-object gl-island-migration-origin-x)
	(up-modify-group-flag 0 c: migration-transport-group)
	(up-reset-group c: migration-transport-group)
	(up-full-reset-search)
	(up-add-object-by-id search-local g: gl-island-migration-transport-id)
	(up-remove-objects search-local object-data-id g:!= gl-island-migration-transport-id)
	(up-remove-objects search-local object-data-player != my-player-number)
	(up-remove-objects search-local object-data-group-flag >= 0)
	(up-remove-objects search-local object-data-garrison-count > 0)
	(up-remove-objects search-local object-data-idling != 1)
	(up-remove-objects search-local object-data-under-attack > 0)
	(up-create-group 0 0 c: migration-transport-group)
	(up-modify-group-flag 1 c: migration-transport-group)
	(set-goal gl-island-migration-state MIGRATION-HULL-VERIFY)
)

;Claim and acknowledgement are adjacent and consumed in this sweep. Neither an
;empty search nor a stolen candidate may consume an attempt or select passengers.
(defrule
	(goal gl-island-migration-state MIGRATION-HULL-VERIFY)
	(goal gl-island-migration-mission MIGRATION-MISSION-SCOUT)
	(up-set-target-object search-local c: 0)
	(up-object-data object-data-id g:== gl-island-migration-transport-id)
	(up-object-data object-data-player == my-player-number)
	(up-object-data object-data-group-flag == migration-transport-group)
=>
	(up-modify-goal gl-island-scout-attempts c:+ 1)
	(up-chat-data-to-self "migration scout attempt: %d" g: gl-island-scout-attempts)
)

(defrule
	(goal gl-island-migration-state MIGRATION-HULL-VERIFY)
	(up-set-target-object search-local c: 0)
	(up-object-data object-data-id g:== gl-island-migration-transport-id)
	(up-object-data object-data-player == my-player-number)
	(up-object-data object-data-group-flag == migration-transport-group)
=>
	(up-chat-data-to-self "migration transport: %d" g: gl-island-migration-transport-id)
	(set-goal gl-island-migration-state MIGRATION-BOARDING)
)

(defrule
	(goal gl-island-migration-state MIGRATION-HULL-VERIFY)
=>
	(up-chat-data-to-all "RAW17 migration claim rejected hull: %d" g: gl-island-migration-transport-id)
	(up-modify-sn sn-focus-player-number g:= gl-island-migration-focus)
	(up-set-timer c: t-island-migration c: 60)
	(set-goal gl-island-migration-state MIGRATION-IDLE)
)

(defrule
	(goal gl-island-migration-state MIGRATION-FIND-TRANSPORT)
	(not (up-set-target-object search-remote c: 0))
=>
	(up-chat-data-to-self "migration no transport: %d" c: 0)
	(up-modify-sn sn-focus-player-number g:= gl-island-migration-focus)
	(up-set-timer c: t-island-migration c: 60)
	(set-goal gl-island-migration-state MIGRATION-IDLE)
)

(defrule
	(goal gl-island-migration-state MIGRATION-BOARDING)
	(goal gl-island-migration-mission MIGRATION-MISSION-SCOUT)
	(goal gl-owner-explore-suspended NO)
=>
	(set-strategic-number sn-number-explore-groups 0)
	(set-strategic-number sn-total-number-explorers 0)
	(set-strategic-number sn-cap-civilian-explorers 0)
	(set-strategic-number sn-minimum-civilian-explorers 0)
	; RAW12 counter 4
	(up-modify-goal gl-command-counter-4 c:+ 1)
	(up-reset-scouts)
	(set-goal gl-owner-explore-suspended YES)
)

(defrule
	(goal gl-island-migration-state MIGRATION-BOARDING)
	(goal gl-island-migration-mission MIGRATION-MISSION-MINING)
	(goal gl-owner-native-hold-applied NO)
=>
	(set-goal gl-owner-worker-hold YES)
	(up-modify-goal gl-owner-native-builder-assist s:= sn-disable-builder-assistance)
	(up-modify-goal gl-owner-native-repair s:= sn-object-repair-level)
	(set-strategic-number sn-disable-builder-assistance 1)
	(set-strategic-number sn-object-repair-level 0)
	(set-goal gl-owner-native-hold-applied YES)
)

(defrule
	(goal gl-island-migration-state MIGRATION-BOARDING)
	(goal gl-island-migration-mission MIGRATION-MISSION-MINING)
	(goal resources-depleted NO)
	(goal gl-home-resource-pressure NO)
	(villager-count < 60)
=>
	(up-modify-group-flag 0 c: migration-boarding-group)
	(up-reset-group c: migration-boarding-group)
	(up-full-reset-search)
	(up-add-object-by-id search-remote g: gl-island-migration-transport-id)
	(up-set-target-object search-remote c: 0)
	(up-get-point position-object point-x)
	(up-set-target-point point-x)
	(up-find-local c: villager-class c: 40)
	(up-remove-objects search-local object-data-garrisoned == 1)
	(up-remove-objects search-local object-data-idling != 1)
	(up-remove-objects search-local object-data-language-id == lid-villager-farmer)
	(up-remove-objects search-local object-data-language-id == lid-villager-fisherman)
	(up-remove-objects search-local object-data-language-id == lid-villager-shepherd)
	(up-remove-objects search-local object-data-language-id == lid-villager-forager)
	(up-remove-objects search-local object-data-language-id == lid-villager-hunter)
	(up-remove-objects search-local object-data-map-zone-id g:!= gl-home-zone)
	(up-remove-objects search-local object-data-group-flag >= 0)
	(up-remove-objects search-local object-data-id g:== gl-boar-lurer-id)
	(up-clean-search search-local object-data-distance search-order-asc)
	(up-remove-objects search-local object-data-index g:>= gl-transport-capacity)
	(set-goal gl-island-migration-state MIGRATION-OWNERSHIP-CLAIM)
)
;A crowded island economy can leave large numbers of villagers visibly waiting
;while the native economy still reports them as assigned, so the idle fact never
;opens migration. At sixty villagers, allow one bounded transport manifest of
;non-food workers to prove the remote resource route. Builders, grouped units,
;animal workers and every established food role remain protected.
(defrule
	(goal gl-island-migration-state MIGRATION-BOARDING)
	(goal gl-island-migration-mission MIGRATION-MISSION-MINING)
	(goal resources-depleted NO)
	(goal gl-home-resource-pressure NO)
	(villager-count >= 60)
=>
	(up-modify-group-flag 0 c: migration-boarding-group)
	(up-reset-group c: migration-boarding-group)
	(up-full-reset-search)
	(up-add-object-by-id search-remote g: gl-island-migration-transport-id)
	(up-set-target-object search-remote c: 0)
	(up-get-point position-object point-x)
	(up-set-target-point point-x)
	(up-find-local c: villager-class c: 40)
	(up-remove-objects search-local object-data-garrisoned == 1)
	(up-remove-objects search-local object-data-action == actionid-build)
	(up-remove-objects search-local object-data-action == actionid-repair)
	(up-remove-objects search-local object-data-target == prey-animal-class)
	(up-remove-objects search-local object-data-target == livestock-class)
	(up-remove-objects search-local object-data-language-id == lid-villager-farmer)
	(up-remove-objects search-local object-data-language-id == lid-villager-fisherman)
	(up-remove-objects search-local object-data-language-id == lid-villager-shepherd)
	(up-remove-objects search-local object-data-language-id == lid-villager-forager)
	(up-remove-objects search-local object-data-language-id == lid-villager-hunter)
	(up-remove-objects search-local object-data-map-zone-id g:!= gl-home-zone)
	(up-remove-objects search-local object-data-group-flag >= 0)
	(up-remove-objects search-local object-data-id g:== gl-boar-lurer-id)
	(up-clean-search search-local object-data-distance search-order-asc)
	(up-remove-objects search-local object-data-index g:>= gl-transport-capacity)
	(set-goal gl-island-migration-state MIGRATION-OWNERSHIP-CLAIM)
)
;When the known map is depleted, evacuate available non-critical workers even
;if the economy still gives them futile gather orders. Animal workers and
;builders remain protected until their current task finishes.
(defrule
	(goal gl-island-migration-state MIGRATION-BOARDING)
	(goal gl-island-migration-mission MIGRATION-MISSION-MINING)
	(goal gl-island-colony-established NO)
	(or
		(goal resources-depleted YES)
		(goal gl-home-resource-pressure YES)
	)
=>
	(up-modify-group-flag 0 c: migration-boarding-group)
	(up-reset-group c: migration-boarding-group)
	(up-full-reset-search)
	(up-add-object-by-id search-remote g: gl-island-migration-transport-id)
	(up-set-target-object search-remote c: 0)
	(up-get-point position-object point-x)
	(up-set-target-point point-x)
	(up-find-local c: villager-class c: 40)
	(up-remove-objects search-local object-data-garrisoned == 1)
	(up-remove-objects search-local object-data-action == actionid-build)
	(up-remove-objects search-local object-data-action == actionid-repair)
	(up-remove-objects search-local object-data-action == actionid-hunt)
	(up-remove-objects search-local object-data-target == prey-animal-class)
	(up-remove-objects search-local object-data-target == livestock-class)
	(up-remove-objects search-local object-data-map-zone-id g:!= gl-home-zone)
	(up-remove-objects search-local object-data-group-flag >= 0)
	(up-remove-objects search-local object-data-id g:== gl-boar-lurer-id)
	(up-clean-search search-local object-data-distance search-order-asc)
	(up-remove-objects search-local object-data-index g:>= gl-transport-capacity)
	(set-goal gl-island-migration-state MIGRATION-OWNERSHIP-CLAIM)
)
;After the first productive colony exists, later reinforcement lifts must not
;strip the home food economy. Select miners, lumberjacks, or genuinely idle
;generic workers while preserving every established farm and natural-food role.
(defrule
	(goal gl-island-migration-state MIGRATION-BOARDING)
	(goal gl-island-migration-mission MIGRATION-MISSION-MINING)
	(goal gl-island-colony-established YES)
	(or
		(goal resources-depleted YES)
		(goal gl-home-resource-pressure YES)
	)
=>
	(up-modify-group-flag 0 c: migration-boarding-group)
	(up-reset-group c: migration-boarding-group)
	(up-full-reset-search)
	(up-add-object-by-id search-remote g: gl-island-migration-transport-id)
	(up-set-target-object search-remote c: 0)
	(up-get-point position-object point-x)
	(up-set-target-point point-x)
	(up-find-local c: villager-class c: 40)
	(up-remove-objects search-local object-data-garrisoned == 1)
	(up-remove-objects search-local object-data-action == actionid-build)
	(up-remove-objects search-local object-data-action == actionid-repair)
	(up-remove-objects search-local object-data-target == prey-animal-class)
	(up-remove-objects search-local object-data-target == livestock-class)
	(up-remove-objects search-local object-data-language-id == lid-villager-farmer)
	(up-remove-objects search-local object-data-language-id == lid-villager-fisherman)
	(up-remove-objects search-local object-data-language-id == lid-villager-shepherd)
	(up-remove-objects search-local object-data-language-id == lid-villager-forager)
	(up-remove-objects search-local object-data-language-id == lid-villager-hunter)
	(up-remove-objects search-local object-data-map-zone-id g:!= gl-home-zone)
	(up-remove-objects search-local object-data-group-flag >= 0)
	(up-remove-objects search-local object-data-id g:== gl-boar-lurer-id)
	(up-clean-search search-local object-data-distance search-order-asc)
	(up-remove-objects search-local object-data-index g:>= gl-transport-capacity)
	(set-goal gl-island-migration-state MIGRATION-OWNERSHIP-CLAIM)
)
(defrule
	(goal gl-island-migration-state MIGRATION-BOARDING)
	(goal gl-island-migration-mission MIGRATION-MISSION-SCOUT)
=>
	(up-modify-group-flag 0 c: migration-boarding-group)
	(up-reset-group c: migration-boarding-group)
	(up-full-reset-search)
	(up-add-object-by-id search-remote g: gl-island-migration-transport-id)
	(up-set-target-object search-remote c: 0)
	(up-get-point position-object point-x)
	(up-set-target-point point-x)
	(up-find-local c: scout-cavalry-class c: 3)
	(up-remove-objects search-local object-data-garrisoned == 1)
	(up-remove-objects search-local object-data-map-zone-id g:!= gl-home-zone)
	(up-remove-objects search-local object-data-group-flag >= 0)
	(up-remove-objects search-local object-data-id g:== gl-boar-lurer-id)
	(up-clean-search search-local object-data-distance search-order-asc)
	(up-remove-objects search-local object-data-index >= 1)
	(set-goal gl-island-migration-state MIGRATION-OWNERSHIP-CLAIM)
)

(defrule
	(goal gl-island-migration-state MIGRATION-OWNERSHIP-CLAIM)
=>
	(up-remove-objects search-local object-data-player != my-player-number)
	(up-remove-objects search-local object-data-group-flag >= 0)
	(up-create-group 0 0 c: migration-boarding-group)
	(up-modify-group-flag 1 c: migration-boarding-group)
	(up-get-search-state local-total)
	(up-modify-goal gl-island-migration-load-target g:= local-total)
	(set-goal gl-island-migration-state MIGRATION-RENDEZVOUS-ANCHOR)
)

(defrule
	(goal gl-island-migration-state MIGRATION-RENDEZVOUS-ANCHOR)
	(up-set-target-object search-local c: 0)
=>
	;The closest reserved passenger is a stable shore rendezvous anchor. Keep the
	;selected hull/passenger policy unchanged; only separate travel from boarding.
	(up-get-point position-object gl-migration-rendezvous-x)
	(set-goal gl-island-migration-state MIGRATION-RENDEZVOUS-START)
)

(defrule
	(goal gl-island-migration-state MIGRATION-RENDEZVOUS-ANCHOR)
	(not (up-set-target-object search-local c: 0))
=>
	;Reuse the established no-passenger branch so reservations and focus restore
	;exactly as before this rendezvous phase existed.
	(set-goal gl-island-migration-state MIGRATION-ISSUE-BOARD)
)

(defrule
	(goal gl-island-migration-state MIGRATION-RENDEZVOUS-START)
=>
	;The 120-second lease includes travel from both sides. It never replaces the
	;existing 30-second local boarding deadline or the voyage watchdogs.
	(up-modify-goal gl-migration-rendezvous-until g:= gl-transport-load-clock)
	(up-modify-goal gl-migration-rendezvous-until c:+ 120)
	(up-modify-goal gl-migration-rendezvous-next g:= gl-transport-load-clock)
	(up-modify-goal gl-migration-rendezvous-next c:+ 4)
	(set-goal gl-island-migration-load-terminal TRANSPORT-LOAD-TERMINAL-NONE)
	(set-goal gl-island-migration-load-reported NO)
	(set-goal gl-island-migration-load-candidate-id -1)
	(up-full-reset-search)
	(up-set-group search-local c: migration-transport-group)
	(up-remove-objects search-local object-data-player != my-player-number)
	(up-remove-objects search-local object-data-group-flag != migration-transport-group)
	;OWNERSHIP command: migration-transport-group.
	(up-target-point gl-migration-rendezvous-x action-move -1 stance-no-attack)
	(up-full-reset-search)
	(fe-filter-garrisoned c: 1)
	(up-set-group search-local c: migration-boarding-group)
	(up-remove-objects search-local object-data-garrisoned == 1)
	(up-remove-objects search-local object-data-player != my-player-number)
	(up-remove-objects search-local object-data-group-flag != migration-boarding-group)
	(up-add-object-by-id search-remote g: gl-island-migration-transport-id)
	(up-remove-objects search-remote object-data-player != my-player-number)
	(up-remove-objects search-remote object-data-group-flag != migration-transport-group)
	;OWNERSHIP command: migration-boarding-group.
	(up-target-objects 0 action-garrison -1 stance-no-attack)
	(up-chat-data-to-all "RAW44C migration terminal hull: %d" g: gl-island-migration-transport-id)
	(up-chat-data-to-all "RAW44C migration terminal phase: %d" c: 3)
	(set-goal gl-island-migration-state MIGRATION-RENDEZVOUS-WAIT)
)

(defrule
	(goal gl-island-migration-state MIGRATION-RENDEZVOUS-WAIT)
	(up-compare-goal gl-transport-load-clock g:>= gl-migration-rendezvous-next)
=>
	(up-full-reset-search)
	(up-add-object-by-id search-local g: gl-island-migration-transport-id)
	(set-goal gl-island-migration-state MIGRATION-RENDEZVOUS-CHECK)
)

(defrule
	(goal gl-island-migration-state MIGRATION-RENDEZVOUS-CHECK)
	(up-set-target-object search-local c: 0)
	(up-object-data object-data-player == my-player-number)
	(up-object-data object-data-group-flag == migration-transport-group)
	(up-object-data object-data-garrison-count g:>= gl-island-migration-load-target)
=>
	;A manifest which completes en route enters the unchanged local load contract.
	(up-full-reset-search)
	(fe-filter-garrisoned c: 1)
	(up-set-group search-local c: migration-boarding-group)
	(up-remove-objects search-local object-data-garrisoned == 1)
	(up-remove-objects search-local object-data-player != my-player-number)
	(up-remove-objects search-local object-data-group-flag != migration-boarding-group)
	(up-add-object-by-id search-remote g: gl-island-migration-transport-id)
	(up-remove-objects search-remote object-data-player != my-player-number)
	(up-remove-objects search-remote object-data-group-flag != migration-transport-group)
	(set-goal gl-island-migration-state MIGRATION-ISSUE-BOARD)
)

(defrule
	(goal gl-island-migration-state MIGRATION-RENDEZVOUS-CHECK)
	(up-set-target-object search-local c: 0)
	(up-object-data object-data-player == my-player-number)
	(up-object-data object-data-group-flag == migration-transport-group)
	(up-object-data object-data-garrison-count g:< gl-island-migration-load-target)
=>
	(up-get-point position-object point-x)
	(up-full-reset-search)
	(fe-filter-garrisoned c: 1)
	(up-set-target-point point-x)
	(up-set-group search-local c: migration-boarding-group)
	(up-remove-objects search-local object-data-garrisoned == 1)
	(up-remove-objects search-local object-data-player != my-player-number)
	(up-remove-objects search-local object-data-group-flag != migration-boarding-group)
	(up-clean-search search-local object-data-distance search-order-asc)
	(set-goal gl-island-migration-state MIGRATION-RENDEZVOUS-PASSENGER)
)

(defrule
	(goal gl-island-migration-state MIGRATION-RENDEZVOUS-PASSENGER)
	(up-set-target-object search-local c: 0)
	(up-object-data object-data-distance <= 12)
=>
	;Only local proximity starts the existing 30-second boarding timer.
	(up-add-object-by-id search-remote g: gl-island-migration-transport-id)
	(up-remove-objects search-remote object-data-player != my-player-number)
	(up-remove-objects search-remote object-data-group-flag != migration-transport-group)
	(set-goal gl-island-migration-state MIGRATION-ISSUE-BOARD)
)

(defrule
	(goal gl-island-migration-state MIGRATION-RENDEZVOUS-PASSENGER)
	(not (up-set-target-object search-local c: 0))
=>
	;All reserved survivors are aboard or gone. Let the established load contract
	;classify the exact cargo instead of waiting on a vanished shore member.
	(up-set-group search-local c: migration-boarding-group)
	(up-remove-objects search-local object-data-garrisoned == 1)
	(up-remove-objects search-local object-data-player != my-player-number)
	(up-remove-objects search-local object-data-group-flag != migration-boarding-group)
	(up-add-object-by-id search-remote g: gl-island-migration-transport-id)
	(up-remove-objects search-remote object-data-player != my-player-number)
	(up-remove-objects search-remote object-data-group-flag != migration-transport-group)
	(set-goal gl-island-migration-state MIGRATION-ISSUE-BOARD)
)

(defrule
	(goal gl-island-migration-state MIGRATION-RENDEZVOUS-PASSENGER)
	(up-set-target-object search-local c: 0)
	(up-object-data object-data-distance > 12)
	(up-compare-goal gl-transport-load-clock g:< gl-migration-rendezvous-until)
=>
	;Renew the exact passenger/hull contract every eight seconds. This is bounded
	;and cannot become the old per-sweep garrison command loop.
	(up-add-object-by-id search-remote g: gl-island-migration-transport-id)
	(up-remove-objects search-remote object-data-player != my-player-number)
	(up-remove-objects search-remote object-data-group-flag != migration-transport-group)
	(up-remove-objects search-local object-data-player != my-player-number)
	(up-remove-objects search-local object-data-group-flag != migration-boarding-group)
	;OWNERSHIP command: migration-boarding-group.
	(up-target-objects 0 action-garrison -1 stance-no-attack)
	(up-full-reset-search)
	(up-set-group search-local c: migration-transport-group)
	(up-remove-objects search-local object-data-player != my-player-number)
	(up-remove-objects search-local object-data-group-flag != migration-transport-group)
	;OWNERSHIP command: migration-transport-group.
	(up-target-point gl-migration-rendezvous-x action-move -1 stance-no-attack)
	(up-modify-goal gl-migration-rendezvous-next g:= gl-transport-load-clock)
	(up-modify-goal gl-migration-rendezvous-next c:+ 8)
	(set-goal gl-island-migration-state MIGRATION-RENDEZVOUS-WAIT)
)

(defrule
	(goal gl-island-migration-state MIGRATION-RENDEZVOUS-PASSENGER)
	(up-set-target-object search-local c: 0)
	(up-object-data object-data-distance > 12)
	(up-compare-goal gl-transport-load-clock g:>= gl-migration-rendezvous-until)
=>
	;A rendezvous timeout is terminal for this preparation attempt, but the exact
	;hull/cargo still flows through the existing partial/abort recovery policy.
	(up-chat-data-to-all "RAW44C migration terminal hull: %d" g: gl-island-migration-transport-id)
	(up-chat-data-to-all "RAW44C migration terminal phase: %d" c: 4)
	(up-set-timer c: t-island-migration c: 1)
	(set-goal gl-island-migration-state MIGRATION-LOADING)
)
(defrule
	(goal gl-island-migration-state MIGRATION-ISSUE-BOARD)
	(goal gl-island-migration-mission MIGRATION-MISSION-MINING)
	(up-compare-goal gl-island-migration-load-target c:>= 2)
=>
	;OWNERSHIP command: migration-boarding-group.
	(up-remove-objects search-local object-data-player != my-player-number)
	(up-remove-objects search-local object-data-group-flag != migration-boarding-group)
	(up-target-objects 0 action-garrison -1 stance-no-attack)
	(up-chat-data-to-self "migration board target: %d" g: gl-island-migration-load-target)
	(set-goal gl-island-migration-load-terminal TRANSPORT-LOAD-TERMINAL-NONE)
	(set-goal gl-island-migration-load-reported NO)
	(set-goal gl-island-migration-load-candidate-id -1)
	(up-modify-sn sn-focus-player-number g:= gl-island-migration-focus)
	(up-set-timer c: t-island-migration c: 30)
	(up-set-timer c: t-island-migration-board-retry c: 3)
	(set-goal gl-island-migration-state MIGRATION-LOADING)
)

(defrule
	(goal gl-island-migration-state MIGRATION-ISSUE-BOARD)
	(goal gl-island-migration-mission MIGRATION-MISSION-SCOUT)
	(up-compare-goal gl-island-migration-load-target c:>= 1)
=>
	;OWNERSHIP command: migration-boarding-group.
	(up-remove-objects search-local object-data-player != my-player-number)
	(up-remove-objects search-local object-data-group-flag != migration-boarding-group)
	(up-target-objects 0 action-garrison -1 stance-no-attack)
	(up-chat-data-to-self "migration scout board: %d" g: gl-island-migration-load-target)
	(set-goal gl-island-migration-load-terminal TRANSPORT-LOAD-TERMINAL-NONE)
	(set-goal gl-island-migration-load-reported NO)
	(set-goal gl-island-migration-load-candidate-id -1)
	(up-modify-sn sn-focus-player-number g:= gl-island-migration-focus)
	(up-set-timer c: t-island-migration c: 30)
	(up-set-timer c: t-island-migration-board-retry c: 3)
	(set-goal gl-island-migration-state MIGRATION-LOADING)
)

(defrule
	(goal gl-island-migration-state MIGRATION-ISSUE-BOARD)
	(or
		(and
			(goal gl-island-migration-mission MIGRATION-MISSION-MINING)
			(up-compare-goal gl-island-migration-load-target c:< 2)
		)
		(and
			(goal gl-island-migration-mission MIGRATION-MISSION-SCOUT)
			(up-compare-goal gl-island-migration-load-target c:< 1)
		)
	)
=>
	(up-chat-data-to-self "migration passengers unavailable: %d" g: gl-island-migration-load-target)
	(up-modify-group-flag 0 c: migration-boarding-group)
	(up-reset-group c: migration-boarding-group)
	(up-modify-sn sn-focus-player-number g:= gl-island-migration-focus)
	(up-set-timer c: t-island-migration c: 60)
	(set-goal gl-island-migration-state MIGRATION-IDLE)
)

(defrule
	(goal gl-island-migration-state MIGRATION-LOADING)
=>
	;Re-resolve the exact hull every sweep. A direct-control group reserves the
	;passengers from our other controllers, while the independent retry branch
	;below renews boarding if the built-in economy overwrites their command.
	(set-strategic-number sn-focus-player-number my-player-number)
	(up-full-reset-search)
	(up-find-local c: transport-ship c: 40)
	(up-remove-objects search-local object-data-id g:!= gl-island-migration-transport-id)
	(set-goal gl-island-migration-state MIGRATION-CHECK-LOAD)
)

;Read occupancy directly from the exact live hull.  The former intermediate
;goal/result state could remain uncovered until the generic watchdog fired;
;direct object predicates keep the search and its consumer in one state.
(defrule
	(goal gl-island-migration-state MIGRATION-CHECK-LOAD)
	(goal gl-island-migration-mission MIGRATION-MISSION-SCOUT)
	(up-set-target-object search-local c: 0)
	(up-object-data object-data-garrison-count >= 1)
=>
	(up-chat-data-to-self "migration depart full: %d" g: gl-island-migration-load-target)
	(up-chat-data-to-all "RAW44B migration full hull: %d" g: gl-island-migration-transport-id)
	(up-chat-data-to-all "RAW44B migration load target: %d" g: gl-island-migration-load-target)
	(set-goal gl-island-migration-route-waits 0)
	(up-set-timer c: t-island-migration c: 120)
	(set-goal gl-owner-worker-hold NO)
	(set-goal gl-island-migration-state MIGRATION-SHORE-INIT)
)

(defrule
	(goal gl-island-migration-state MIGRATION-CHECK-LOAD)
	(goal gl-island-migration-mission MIGRATION-MISSION-MINING)
	(up-compare-goal gl-island-migration-load-target c:>= 2)
	(up-set-target-object search-local c: 0)
	(up-object-data object-data-garrison-count g:>= gl-island-migration-load-target)
=>
	(up-chat-data-to-self "migration depart full: %d" g: gl-island-migration-load-target)
	(up-chat-data-to-all "RAW44B migration full hull: %d" g: gl-island-migration-transport-id)
	(up-chat-data-to-all "RAW44B migration load target: %d" g: gl-island-migration-load-target)
	(set-goal gl-island-migration-route-waits 0)
	(up-set-timer c: t-island-migration c: 120)
	(set-goal gl-owner-worker-hold NO)
	(set-goal gl-island-migration-state MIGRATION-SHORE-INIT)
)

;One nonboarding passenger must not hold the whole colony on shore. Once the
;boarding window expires, sail with at least two settlers and stop every stale
;ashore boarding order before route preparation.
(defrule
	(goal gl-island-migration-state MIGRATION-CHECK-LOAD)
	(goal gl-island-migration-mission MIGRATION-MISSION-MINING)
	(up-timer-status t-island-migration == timer-triggered)
	(up-set-target-object search-local c: 0)
	(up-object-data object-data-garrison-count >= 2)
	(up-object-data object-data-garrison-count g:< gl-island-migration-load-target)
=>
	(up-chat-data-to-self "migration depart partial target: %d" g: gl-island-migration-load-target)
	(up-chat-data-to-all "RAW44B migration partial hull: %d" g: gl-island-migration-transport-id)
	(up-chat-data-to-all "RAW44B migration load target: %d" g: gl-island-migration-load-target)
	(up-get-object-data object-data-garrison-count gl-island-migration-load-observed)
	(set-goal gl-island-migration-load-terminal TRANSPORT-LOAD-TERMINAL-PARTIAL)
	(set-goal gl-island-migration-state MIGRATION-LOAD-DIAG-FIND)
)

;A live but underfilled hull keeps ownership until the existing bounded return
;check proves it is empty.  Rejected-zone backoff prevents the same failed
;boarding mission from immediately selecting the identical destination again.
(defrule
	(goal gl-island-migration-state MIGRATION-CHECK-LOAD)
	(goal gl-island-migration-mission MIGRATION-MISSION-MINING)
	(up-timer-status t-island-migration == timer-triggered)
	(up-set-target-object search-local c: 0)
	(up-object-data object-data-garrison-count == 1)
=>
	(up-chat-data-to-self "migration boarding abort loaded: %d" c: 1)
	(up-chat-data-to-all "RAW44B migration abort loaded hull: %d" g: gl-island-migration-transport-id)
	(up-chat-data-to-all "RAW44B migration load target: %d" g: gl-island-migration-load-target)
	(up-get-object-data object-data-garrison-count gl-island-migration-load-observed)
	(set-goal gl-island-migration-load-terminal TRANSPORT-LOAD-TERMINAL-ABORT)
	(set-goal gl-island-migration-state MIGRATION-LOAD-DIAG-FIND)
)

(defrule
	(goal gl-island-migration-state MIGRATION-CHECK-LOAD)
	(goal gl-island-migration-mission MIGRATION-MISSION-SCOUT)
	(up-timer-status t-island-migration == timer-triggered)
	(up-set-target-object search-local c: 0)
	(up-object-data object-data-garrison-count <= 0)
=>
	(up-chat-data-to-self "migration boarding abort empty: %d" c: 0)
	(up-chat-data-to-all "RAW44B migration abort empty hull: %d" g: gl-island-migration-transport-id)
	(up-chat-data-to-all "RAW44B migration load target: %d" g: gl-island-migration-load-target)
	(up-get-object-data object-data-garrison-count gl-island-migration-load-observed)
	(set-goal gl-island-migration-load-terminal TRANSPORT-LOAD-TERMINAL-ABORT)
	(set-goal gl-island-migration-state MIGRATION-LOAD-DIAG-FIND)
)

(defrule
	(goal gl-island-migration-state MIGRATION-CHECK-LOAD)
	(goal gl-island-migration-mission MIGRATION-MISSION-MINING)
	(up-timer-status t-island-migration == timer-triggered)
	(up-set-target-object search-local c: 0)
	(up-object-data object-data-garrison-count <= 0)
=>
	(up-chat-data-to-self "migration boarding abort empty: %d" c: 0)
	(up-chat-data-to-all "RAW44B migration abort empty hull: %d" g: gl-island-migration-transport-id)
	(up-chat-data-to-all "RAW44B migration load target: %d" g: gl-island-migration-load-target)
	(up-get-object-data object-data-garrison-count gl-island-migration-load-observed)
	(set-goal gl-island-migration-load-terminal TRANSPORT-LOAD-TERMINAL-ABORT)
	(set-goal gl-island-migration-state MIGRATION-LOAD-DIAG-FIND)
)

(defrule
	(goal gl-island-migration-state MIGRATION-LOAD-DIAG-FIND)
=>
	;Sample one exact shore passenger before any retry or terminal action changes
	;its command. Garrisoned group members are included only so they can be
	;excluded explicitly from this diagnostic search.
	(up-full-reset-search)
	(fe-filter-garrisoned c: 1)
	(up-set-group search-local c: migration-boarding-group)
	(up-remove-objects search-local object-data-garrisoned == 1)
	(up-set-target-point gl-island-migration-origin-x)
	(up-clean-search search-local object-data-distance search-order-asc)
	(up-get-search-state local-total)
	(up-modify-goal gl-island-migration-load-remaining g:= local-total)
	(set-goal gl-island-migration-state MIGRATION-LOAD-DIAG-PASSENGER)
)

(defrule
	(goal gl-island-migration-state MIGRATION-LOAD-DIAG-PASSENGER)
	(up-set-target-object search-local c: 0)
=>
	(up-get-object-data object-data-id gl-island-migration-load-candidate-id)
	(up-get-object-data object-data-action gl-island-migration-load-candidate-action)
	(up-get-object-data object-data-target-id gl-island-migration-load-candidate-target-id)
	(up-get-object-data object-data-order gl-island-migration-load-candidate-order)
	(up-get-object-data object-data-cmdid gl-island-migration-load-candidate-cmdid)
	(up-get-object-data object-data-distance gl-island-migration-load-candidate-distance)
	(up-get-object-data object-data-map-zone-id gl-island-migration-load-candidate-zone)
	(up-get-object-data object-data-group-flag gl-island-migration-load-candidate-group-flag)
	(up-get-object-data object-data-move-x gl-island-migration-load-candidate-move-x)
	(up-get-object-data object-data-move-y gl-island-migration-load-candidate-move-y)
	(up-get-object-data object-data-idling gl-island-migration-load-candidate-idling)
	(up-chat-data-to-all "RAW44B migration load remaining: %d" g: gl-island-migration-load-remaining)
	(up-chat-data-to-all "RAW44B migration candidate id: %d" g: gl-island-migration-load-candidate-id)
	(up-chat-data-to-all "RAW44B migration candidate action: %d" g: gl-island-migration-load-candidate-action)
	(up-chat-data-to-all "RAW44B migration candidate target: %d" g: gl-island-migration-load-candidate-target-id)
	(up-chat-data-to-all "RAW44B migration candidate order: %d" g: gl-island-migration-load-candidate-order)
	(up-chat-data-to-all "RAW44B migration candidate cmd: %d" g: gl-island-migration-load-candidate-cmdid)
	(up-chat-data-to-all "RAW44B migration candidate distance: %d" g: gl-island-migration-load-candidate-distance)
	(up-chat-data-to-all "RAW44B migration candidate zone: %d" g: gl-island-migration-load-candidate-zone)
	(up-chat-data-to-all "RAW44B migration candidate group: %d" g: gl-island-migration-load-candidate-group-flag)
	(up-chat-data-to-all "RAW44B migration candidate move x: %d" g: gl-island-migration-load-candidate-move-x)
	(up-chat-data-to-all "RAW44B migration candidate move y: %d" g: gl-island-migration-load-candidate-move-y)
	(up-chat-data-to-all "RAW44B migration candidate idling: %d" g: gl-island-migration-load-candidate-idling)
	(set-goal gl-island-migration-state MIGRATION-LOAD-DIAG-APPLY)
)

(defrule
	(goal gl-island-migration-state MIGRATION-LOAD-DIAG-PASSENGER)
	(not (up-set-target-object search-local c: 0))
=>
	(set-goal gl-island-migration-load-candidate-id -1)
	(up-chat-data-to-all "RAW44B migration load remaining: %d" g: gl-island-migration-load-remaining)
	(up-chat-data-to-all "RAW44B migration candidate missing: %d" c: -1)
	(set-goal gl-island-migration-state MIGRATION-LOAD-DIAG-APPLY)
)

(defrule
	(goal gl-island-migration-state MIGRATION-LOAD-DIAG-APPLY)
	(goal gl-island-migration-load-terminal TRANSPORT-LOAD-TERMINAL-NONE)
=>
	;Continue the pre-existing three-second retry after the first bounded sample.
	(up-full-reset-search)
	(fe-filter-garrisoned c: 1)
	(up-set-group search-local c: migration-boarding-group)
	(up-remove-objects search-local object-data-garrisoned == 1)
	(up-find-remote c: transport-ship c: 40)
	(up-remove-objects search-remote object-data-id g:!= gl-island-migration-transport-id)
	;OWNERSHIP command: migration-boarding-group.
	(up-remove-objects search-local object-data-player != my-player-number)
	(up-remove-objects search-local object-data-group-flag != migration-boarding-group)
	(up-target-objects 0 action-garrison -1 stance-no-attack)
	(set-goal gl-island-migration-load-reported YES)
	(up-set-timer c: t-island-migration-board-retry c: 3)
	(set-goal gl-island-migration-state MIGRATION-LOADING)
)

(defrule
	(goal gl-island-migration-state MIGRATION-LOAD-DIAG-APPLY)
	(goal gl-island-migration-load-terminal TRANSPORT-LOAD-TERMINAL-PARTIAL)
=>
	;Retain the established partial-migration behavior after recording the exact
	;excluded passenger: stop shore orders and continue with the loaded settlers.
	(up-full-reset-search)
	(fe-filter-garrisoned c: 1)
	(up-set-group search-local c: migration-boarding-group)
	(up-remove-objects search-local object-data-garrisoned == 1)
	;OWNERSHIP command: migration-boarding-group.
	(up-remove-objects search-local object-data-player != my-player-number)
	(up-remove-objects search-local object-data-group-flag != migration-boarding-group)
	; RAW12 counter 5
	(up-modify-goal gl-command-counter-5 c:+ 1)
	(up-target-point position-self-x action-stop -1 stance-no-attack)
	;Release the failed shore passengers; only actual cargo retains the mission.
	(up-modify-group-flag 0 c: migration-boarding-group)
	(up-set-group search-local c: migration-boarding-group)
	(up-remove-objects search-local object-data-player != my-player-number)
	(up-remove-objects search-local object-data-garrisoned != 1)
	(up-create-group 0 0 c: migration-boarding-group)
	(up-modify-group-flag 1 c: migration-boarding-group)
	(set-goal gl-island-migration-load-terminal TRANSPORT-LOAD-TERMINAL-NONE)
	(set-goal gl-island-migration-route-waits 0)
	(up-set-timer c: t-island-migration c: 120)
	(set-goal gl-owner-worker-hold NO)
	(set-goal gl-island-migration-state MIGRATION-SHORE-INIT)
)

(defrule
	(goal gl-island-migration-state MIGRATION-LOAD-DIAG-APPLY)
	(goal gl-island-migration-load-terminal TRANSPORT-LOAD-TERMINAL-ABORT)
	(up-compare-goal gl-island-migration-load-observed c:== 1)
=>
	;A one-passenger mining hull retains ownership until the existing bounded
	;return check proves it empty.
	(up-full-reset-search)
	(fe-filter-garrisoned c: 1)
	(up-set-group search-local c: migration-boarding-group)
	(up-remove-objects search-local object-data-garrisoned == 1)
	;OWNERSHIP command: migration-boarding-group.
	(up-remove-objects search-local object-data-player != my-player-number)
	(up-remove-objects search-local object-data-group-flag != migration-boarding-group)
	; RAW12 counter 6
	(up-modify-goal gl-command-counter-6 c:+ 1)
	(up-target-point position-self-x action-stop -1 stance-no-attack)
	(up-full-reset-search)
	(up-add-object-by-id search-local g: gl-island-migration-transport-id)
	;OWNERSHIP command: migration-transport-group.
	(up-remove-objects search-local object-data-player != my-player-number)
	(up-remove-objects search-local object-data-group-flag != migration-transport-group)
	(up-target-point gl-home-anchor-x action-unload -1 stance-no-attack)
	(up-modify-goal gl-island-migration-rejected-zone3 g:= gl-island-migration-rejected-zone2)
	(up-modify-goal gl-island-migration-rejected-zone2 g:= gl-island-migration-rejected-zone)
	(up-modify-goal gl-island-migration-rejected-zone g:= gl-island-migration-zone)
	(set-goal gl-island-migration-load-terminal TRANSPORT-LOAD-TERMINAL-NONE)
	(set-goal gl-island-migration-route-waits 0)
	(up-set-timer c: t-island-migration c: 15)
	(set-goal gl-island-migration-state MIGRATION-RETURNING)
)

(defrule
	(goal gl-island-migration-state MIGRATION-LOAD-DIAG-APPLY)
	(goal gl-island-migration-load-terminal TRANSPORT-LOAD-TERMINAL-ABORT)
	(up-compare-goal gl-island-migration-load-observed c:<= 0)
=>
	;Preserve the established empty abort and rejected-zone backoff.
	(up-full-reset-search)
	(fe-filter-garrisoned c: 1)
	(up-set-group search-local c: migration-boarding-group)
	(up-remove-objects search-local object-data-garrisoned == 1)
	;OWNERSHIP command: migration-boarding-group.
	(up-remove-objects search-local object-data-player != my-player-number)
	(up-remove-objects search-local object-data-group-flag != migration-boarding-group)
	; RAW12 counter 7
	(up-modify-goal gl-command-counter-7 c:+ 1)
	(up-target-point position-self-x action-stop -1 stance-no-attack)
	(up-modify-group-flag 0 c: migration-boarding-group)
	(up-reset-group c: migration-boarding-group)
	(up-modify-goal gl-island-migration-rejected-zone3 g:= gl-island-migration-rejected-zone2)
	(up-modify-goal gl-island-migration-rejected-zone2 g:= gl-island-migration-rejected-zone)
	(up-modify-goal gl-island-migration-rejected-zone g:= gl-island-migration-zone)
	(set-goal gl-island-migration-load-terminal TRANSPORT-LOAD-TERMINAL-NONE)
	(up-modify-sn sn-focus-player-number g:= gl-island-migration-focus)
	(up-set-timer c: t-island-migration c: 60)
	(set-goal gl-island-migration-state MIGRATION-IDLE)
)

(defrule
	(goal gl-island-migration-state MIGRATION-CHECK-LOAD)
	(not (up-set-target-object search-local c: 0))
=>
	(up-chat-data-to-self "migration transport lost: %d" g: gl-island-migration-transport-id)
	(up-full-reset-search)
	(up-set-group search-local c: migration-boarding-group)
	(up-remove-objects search-local object-data-garrisoned == 1)
	;OWNERSHIP command: migration-boarding-group.
	(up-remove-objects search-local object-data-player != my-player-number)
	(up-remove-objects search-local object-data-group-flag != migration-boarding-group)
	; RAW12 counter 8
	(up-modify-goal gl-command-counter-8 c:+ 1)
	(up-target-point position-self-x action-stop -1 stance-no-attack)
	(up-modify-group-flag 0 c: migration-boarding-group)
	(up-reset-group c: migration-boarding-group)
	(up-modify-sn sn-focus-player-number g:= gl-island-migration-focus)
	(up-set-timer c: t-island-migration c: 60)
	(set-goal gl-island-migration-state MIGRATION-IDLE)
)

;Resolve an actual land/water shoreline pair before any loaded migration hull
;receives a route order. The generated resolver is bounded and uses state owned
;only by the migration preparation lane.
(load "rawai-migration-shoreline")

;The direct midpoint is retained as a danger sample and as the safe fallback
;when an independently generated lateral corridor is not pathable. Corridor
;geometry is now derived from the validated water-side shoreline approach.
(defrule
	(goal gl-island-migration-state MIGRATION-ROUTE-PREPARE)
=>
	(up-modify-sn sn-focus-player-number s:= sn-target-player-number)
	(up-bound-point gl-island-migration-route-left-x gl-msr-selected-water-x)
	(up-lerp-percent gl-island-migration-route-left-x gl-island-migration-origin-x c: 50)
	(up-full-reset-search)
	(up-set-target-point gl-island-migration-route-left-x)
	(up-filter-distance c: -1 c: 20)
	(up-find-remote c: tower-class c: 40)
	(up-find-remote c: sea-tower c: 10)
	(up-find-remote c: castle c: 10)
	(up-find-remote c: town-center c: 10)
	(up-get-search-state local-total)
	(set-goal gl-island-migration-state MIGRATION-ROUTE-DIRECT)
)

(defrule
	(goal gl-island-migration-state MIGRATION-ROUTE-DIRECT)
=>
	(up-modify-goal gl-msr-direct-threats g:= remote-total)
	(up-bound-point gl-island-migration-route-left-x gl-msr-selected-water-x)
	(up-lerp-percent gl-island-migration-route-left-x gl-island-migration-origin-x c: 50)
	(up-cross-tiles gl-island-migration-route-left-x gl-island-migration-origin-x c: 30)
	(up-full-reset-search)
	(up-set-target-point gl-island-migration-route-left-x)
	(up-filter-distance c: -1 c: 20)
	(up-find-remote c: tower-class c: 40)
	(up-find-remote c: sea-tower c: 10)
	(up-find-remote c: castle c: 10)
	(up-find-remote c: town-center c: 10)
	(up-get-search-state local-total)
	(set-goal gl-island-migration-state MIGRATION-ROUTE-LEFT)
)

(defrule
	(goal gl-island-migration-state MIGRATION-ROUTE-LEFT)
=>
	(up-modify-goal gl-island-migration-route-left-threats g:= remote-total)
	(up-bound-point gl-island-migration-route-right-x gl-msr-selected-water-x)
	(up-lerp-percent gl-island-migration-route-right-x gl-island-migration-origin-x c: 50)
	(up-cross-tiles gl-island-migration-route-right-x gl-island-migration-origin-x c: -30)
	(up-full-reset-search)
	(up-set-target-point gl-island-migration-route-right-x)
	(up-filter-distance c: -1 c: 20)
	(up-find-remote c: tower-class c: 40)
	(up-find-remote c: sea-tower c: 10)
	(up-find-remote c: castle c: 10)
	(up-find-remote c: town-center c: 10)
	(up-get-search-state local-total)
	(set-goal gl-island-migration-state MIGRATION-ROUTE-RIGHT)
)

(defrule
	(goal gl-island-migration-state MIGRATION-ROUTE-RIGHT)
=>
	(up-modify-goal gl-island-migration-route-right-threats g:= remote-total)
	;The engine range is inclusive. A maximum of two yielded an uncovered value
	;2 while the tie branches handled only 0 and 1, deadlocking ROUTE-APPLY.
	(generate-random-number 1)
	(up-get-fact random-number 0 gl-island-migration-route-random)
	(up-chat-data-to-self "migration route random: %d" g: gl-island-migration-route-random)
	(up-chat-data-to-self "migration route left threats: %d" g: gl-island-migration-route-left-threats)
	(up-chat-data-to-self "migration route right threats: %d" g: gl-island-migration-route-right-threats)
	(set-goal gl-island-migration-state MIGRATION-ROUTE-APPLY)
)

(defrule
	(goal gl-island-migration-state MIGRATION-ROUTE-APPLY)
	(up-compare-goal gl-island-migration-route-left-threats c:> 0)
	(up-compare-goal gl-island-migration-route-right-threats c:> 0)
=>
	(set-strategic-number sn-focus-player-number my-player-number)
	(up-full-reset-search)
	(up-add-object-by-id search-local g: gl-island-migration-transport-id)
	;OWNERSHIP command: migration-transport-group.
	(up-remove-objects search-local object-data-player != my-player-number)
	(up-remove-objects search-local object-data-group-flag != migration-transport-group)
	(up-target-point gl-home-anchor-x action-unload -1 stance-no-attack)
	(up-modify-sn sn-focus-player-number g:= gl-island-migration-focus)
	(up-chat-data-to-self "migration route held: %d" c: 1)
	(up-modify-goal gl-island-migration-rejected-zone3 g:= gl-island-migration-rejected-zone2)
	(up-modify-goal gl-island-migration-rejected-zone2 g:= gl-island-migration-rejected-zone)
	(up-modify-goal gl-island-migration-rejected-zone g:= gl-island-migration-zone)
	(set-goal gl-island-migration-rejection-armed NO)
	(set-goal gl-island-migration-route-waits 0)
	(up-set-timer c: t-island-migration c: 15)
	(set-goal gl-island-migration-state MIGRATION-RETURNING)
)

(defrule
	(goal gl-island-migration-state MIGRATION-ROUTE-APPLY)
	(or
		(up-compare-goal gl-island-migration-route-left-threats g:< gl-island-migration-route-right-threats)
		(and
			(up-compare-goal gl-island-migration-route-left-threats g:== gl-island-migration-route-right-threats)
			(up-compare-goal gl-island-migration-route-random c:== 0)
		)
	)
=>
	(up-bound-point gl-island-migration-route-waypoint-x gl-island-migration-route-left-x)
	(up-chat-data-to-self "migration route side: %d" c: 0)
	(set-goal gl-island-migration-state MIGRATION-ROUTE-PATH)
)

(defrule
	(goal gl-island-migration-state MIGRATION-ROUTE-APPLY)
	(or
		(up-compare-goal gl-island-migration-route-right-threats g:< gl-island-migration-route-left-threats)
		(and
			(up-compare-goal gl-island-migration-route-left-threats g:== gl-island-migration-route-right-threats)
			(up-compare-goal gl-island-migration-route-random c:== 1)
		)
	)
=>
	(up-bound-point gl-island-migration-route-waypoint-x gl-island-migration-route-right-x)
	(up-chat-data-to-self "migration route side: %d" c: 1)
	(set-goal gl-island-migration-state MIGRATION-ROUTE-PATH)
)

;Validate the selected lateral corridor before the first loaded move. If its
;pure geometry is inland/unreachable, the exact validated shoreline approach
;may replace it only when the direct midpoint danger sample was clear.
(defrule
	(goal gl-island-migration-state MIGRATION-ROUTE-PATH)
=>
	(set-strategic-number sn-focus-player-number my-player-number)
	(up-full-reset-search)
	(up-add-object-by-id search-local g: gl-island-migration-transport-id)
	(up-remove-objects search-local object-data-player != my-player-number)
	(up-remove-objects search-local object-data-group-flag != migration-transport-group)
	(set-goal gl-island-migration-state MIGRATION-ROUTE-DIRECT-PATH)
)

(defrule
	(goal gl-island-migration-state MIGRATION-ROUTE-DIRECT-PATH)
	(up-set-target-object search-local c: 0)
=>
	(up-get-path-distance gl-island-migration-route-waypoint-x 1 gl-msr-water-distance)
	(set-goal gl-island-migration-state MIGRATION-ROUTE-PATH-RESULT)
)

(defrule
	(goal gl-island-migration-state MIGRATION-ROUTE-DIRECT-PATH)
	(not (up-set-target-object search-local c: 0))
=>
	(set-goal gl-island-migration-state MIGRATION-SHORE-EXHAUSTED)
)

(defrule
	(goal gl-island-migration-state MIGRATION-ROUTE-PATH-RESULT)
	(up-compare-goal gl-msr-water-distance c:>= 0)
	(up-compare-goal gl-msr-water-distance c:!= 65535)
=>
	;OWNERSHIP command: migration-transport-group.
	(up-remove-objects search-local object-data-player != my-player-number)
	(up-remove-objects search-local object-data-group-flag != migration-transport-group)
	(up-target-point gl-island-migration-route-waypoint-x action-move -1 stance-no-attack)
	(up-modify-sn sn-focus-player-number g:= gl-island-migration-focus)
	(set-goal gl-island-migration-route-distance 255)
	(up-set-timer c: t-island-migration c: 15)
	(set-goal gl-island-migration-state MIGRATION-ROUTE-WAYPOINT-WAIT)
)

(defrule
	(goal gl-island-migration-state MIGRATION-ROUTE-PATH-RESULT)
	(or (up-compare-goal gl-msr-water-distance c:< 0)
		(goal gl-msr-water-distance 65535))
	(goal gl-msr-direct-threats 0)
=>
	(up-bound-point gl-island-migration-route-waypoint-x gl-msr-selected-water-x)
	(set-goal gl-island-migration-state MIGRATION-ROUTE-DIRECT-VALIDATE)
)

(defrule
	(goal gl-island-migration-state MIGRATION-ROUTE-DIRECT-VALIDATE)
	(up-set-target-object search-local c: 0)
=>
	(up-get-path-distance gl-island-migration-route-waypoint-x 1 gl-msr-water-distance)
	(set-goal gl-island-migration-state MIGRATION-ROUTE-DIRECT-RESULT)
)

(defrule
	(goal gl-island-migration-state MIGRATION-ROUTE-DIRECT-VALIDATE)
	(not (up-set-target-object search-local c: 0))
=>
	(set-goal gl-island-migration-state MIGRATION-SHORE-EXHAUSTED)
)

(defrule
	(goal gl-island-migration-state MIGRATION-ROUTE-PATH-RESULT)
	(or (up-compare-goal gl-msr-water-distance c:< 0)
		(goal gl-msr-water-distance 65535))
	(up-compare-goal gl-msr-direct-threats c:> 0)
=>
	(up-set-timer c: t-island-migration c: 120)
	(set-goal gl-island-migration-state MIGRATION-SHORE-REMEMBER)
)

(defrule
	(goal gl-island-migration-state MIGRATION-ROUTE-DIRECT-RESULT)
	(up-compare-goal gl-msr-water-distance c:>= 0)
	(up-compare-goal gl-msr-water-distance c:!= 65535)
=>
	;OWNERSHIP command: migration-transport-group.
	(up-remove-objects search-local object-data-player != my-player-number)
	(up-remove-objects search-local object-data-group-flag != migration-transport-group)
	(up-target-point gl-island-migration-route-waypoint-x action-move -1 stance-no-attack)
	(up-modify-sn sn-focus-player-number g:= gl-island-migration-focus)
	(set-goal gl-island-migration-route-distance 255)
	(up-set-timer c: t-island-migration c: 15)
	(set-goal gl-island-migration-state MIGRATION-ROUTE-WAYPOINT-WAIT)
)

(defrule
	(goal gl-island-migration-state MIGRATION-ROUTE-DIRECT-RESULT)
	(or (up-compare-goal gl-msr-water-distance c:< 0)
		(goal gl-msr-water-distance 65535))
=>
	(up-set-timer c: t-island-migration c: 120)
	(set-goal gl-island-migration-state MIGRATION-SHORE-REMEMBER)
)

(defrule
	(goal gl-island-migration-state MIGRATION-ROUTE-WAYPOINT-WAIT)
	(up-timer-status t-island-migration == timer-triggered)
=>
	(set-strategic-number sn-focus-player-number my-player-number)
	(up-full-reset-search)
	(up-set-target-point gl-island-migration-route-waypoint-x)
	(up-add-object-by-id search-local g: gl-island-migration-transport-id)
	(set-goal gl-island-migration-state MIGRATION-ROUTE-WAYPOINT-CHECK)
)

(defrule
	(goal gl-island-migration-state MIGRATION-ROUTE-WAYPOINT-CHECK)
	(up-set-target-object search-local c: 0)
	(up-object-data object-data-distance <= 8)
=>
	;The route terminates at the resolver's validated land-side point, never at
	;the inland resource anchor.
	(up-copy-point gl-island-migration-route-waypoint-x gl-msr-selected-land-x)
	(up-chat-data-to-self "migration route waypoint reached: %d" g: gl-island-migration-route-waits)
	(set-goal gl-island-migration-landing-attempts 0)
	(set-goal gl-island-migration-state MIGRATION-CHECK-LANDING-PATH)
)

(defrule
	(goal gl-island-migration-state MIGRATION-ROUTE-WAYPOINT-CHECK)
	(up-set-target-object search-local c: 0)
	(up-object-data object-data-distance > 8)
	(up-object-data object-data-distance g:< gl-island-migration-route-distance)
	(up-compare-goal gl-island-migration-route-waits c:< 4)
=>
	(up-get-object-data object-data-distance gl-island-migration-route-distance)
	;OWNERSHIP command: migration-transport-group.
	(up-remove-objects search-local object-data-player != my-player-number)
	(up-remove-objects search-local object-data-group-flag != migration-transport-group)
	(up-target-point gl-island-migration-route-waypoint-x action-move -1 stance-no-attack)
	(up-modify-sn sn-focus-player-number g:= gl-island-migration-focus)
	(set-goal gl-island-migration-route-waits 0)
	(up-chat-data-to-self "migration route progress: %d" g: gl-island-migration-route-distance)
	(up-set-timer c: t-island-migration c: 15)
	(set-goal gl-island-migration-state MIGRATION-ROUTE-WAYPOINT-WAIT)
)

(defrule
	(goal gl-island-migration-state MIGRATION-ROUTE-WAYPOINT-CHECK)
	(up-set-target-object search-local c: 0)
	(up-object-data object-data-distance > 8)
	(up-object-data object-data-distance g:>= gl-island-migration-route-distance)
	(up-compare-goal gl-island-migration-route-waits c:< 4)
=>
	;OWNERSHIP command: migration-transport-group.
	(up-remove-objects search-local object-data-player != my-player-number)
	(up-remove-objects search-local object-data-group-flag != migration-transport-group)
	(up-target-point gl-island-migration-route-waypoint-x action-move -1 stance-no-attack)
	(up-modify-sn sn-focus-player-number g:= gl-island-migration-focus)
	(up-modify-goal gl-island-migration-route-waits c:+ 1)
	(up-chat-data-to-self "migration route retry: %d" g: gl-island-migration-route-waits)
	(up-set-timer c: t-island-migration c: 15)
	(set-goal gl-island-migration-state MIGRATION-ROUTE-WAYPOINT-WAIT)
)

(defrule
	(goal gl-island-migration-state MIGRATION-ROUTE-WAYPOINT-CHECK)
	(up-set-target-object search-local c: 0)
	(up-object-data object-data-distance > 8)
	(up-object-data object-data-distance <= 12)
	(up-object-data object-data-distance g:>= gl-island-migration-route-distance)
	(up-compare-goal gl-island-migration-route-waits c:>= 4)
=>
	;T25 hull38985 improved to ten tiles, then oscillated at ten/eleven until
	;the eight-tile waypoint test recalled it. At this bounded near-waypoint
	;terminal, advance to the existing exact zone/path landing validation. This
	;does not issue an unload or weaken wrong-island and unreachable-path checks.
	(up-copy-point gl-island-migration-route-waypoint-x gl-msr-selected-land-x)
	(up-chat-data-to-self "migration route waypoint reached: %d" g: gl-island-migration-route-waits)
	(set-goal gl-island-migration-landing-attempts 0)
	(set-goal gl-island-migration-state MIGRATION-CHECK-LANDING-PATH)
)

; P3B44T9 OBSERVER BEGIN
;Observe the exact object already selected by this owner. No new search,
;timer, command, filter, or controller mutation. The identical terminal below
;runs in this sweep and leaves the state, bounding this to one failed leg.
(defrule
	(goal gl-island-migration-state MIGRATION-ROUTE-WAYPOINT-CHECK)
	(up-set-target-object search-local c: 0)
	(up-object-data object-data-distance > 8)
	(up-object-data object-data-distance g:>= gl-island-migration-route-distance)
	(up-compare-goal gl-island-migration-route-waits c:>= 4)
=>
	(up-chat-data-to-all "RAW44C migration terminal hull: %d" g: gl-island-migration-transport-id)
	(up-chat-data-to-all "RAW44C migration terminal phase: %d" c: 1)
	(up-get-point position-object gl-transport-observed-x)
	(up-chat-data-to-all "RAW44C migration hull x: %d" g: gl-transport-observed-x)
	(up-chat-data-to-all "RAW44C migration hull y: %d" g: gl-transport-observed-y)
	(up-chat-data-to-all "RAW44C migration origin x: %d" g: gl-island-migration-origin-x)
	(up-chat-data-to-all "RAW44C migration origin y: %d" g: gl-island-migration-origin-y)
	(up-chat-data-to-all "RAW44C migration best distance: %d" g: gl-island-migration-route-distance)
	(up-get-object-data object-data-distance gl-transport-observed-value)
	(up-chat-data-to-all "RAW44C migration current distance: %d" g: gl-transport-observed-value)
	(up-get-object-data object-data-garrison-count gl-transport-observed-value)
	(up-chat-data-to-all "RAW44C migration cargo: %d" g: gl-transport-observed-value)
	(up-get-object-data object-data-idling gl-transport-observed-value)
	(up-chat-data-to-all "RAW44C migration idling: %d" g: gl-transport-observed-value)
	(up-get-object-data object-data-group-flag gl-transport-observed-value)
	(up-chat-data-to-all "RAW44C migration group: %d" g: gl-transport-observed-value)
)
; P3B44T9 OBSERVER END

(defrule
	(goal gl-island-migration-state MIGRATION-ROUTE-WAYPOINT-CHECK)
	(up-set-target-object search-local c: 0)
	(up-object-data object-data-distance > 8)
	(up-object-data object-data-distance g:>= gl-island-migration-route-distance)
	(up-compare-goal gl-island-migration-route-waits c:>= 4)
=>
	;OWNERSHIP command: migration-transport-group.
	(up-remove-objects search-local object-data-player != my-player-number)
	(up-remove-objects search-local object-data-group-flag != migration-transport-group)
	(up-target-point gl-home-anchor-x action-unload -1 stance-no-attack)
	(up-modify-sn sn-focus-player-number g:= gl-island-migration-focus)
	(up-chat-data-to-self "migration route unreachable: %d" g: gl-island-migration-transport-id)
	(up-modify-goal gl-island-migration-rejected-zone3 g:= gl-island-migration-rejected-zone2)
	(up-modify-goal gl-island-migration-rejected-zone2 g:= gl-island-migration-rejected-zone)
	(up-modify-goal gl-island-migration-rejected-zone g:= gl-island-migration-zone)
	(set-goal gl-island-migration-rejection-armed NO)
	(set-goal gl-island-migration-route-waits 0)
	(up-set-timer c: t-island-migration c: 15)
	(set-goal gl-island-migration-state MIGRATION-RETURNING)
)

(defrule
	(goal gl-island-migration-state MIGRATION-ROUTE-WAYPOINT-CHECK)
	(not (up-set-target-object search-local c: 0))
=>
	(up-modify-sn sn-focus-player-number g:= gl-island-migration-focus)
	(up-chat-data-to-self "migration route transport lost: %d" g: gl-island-migration-transport-id)
	(up-set-timer c: t-island-migration c: 60)
	(set-goal gl-island-migration-state MIGRATION-IDLE)
)

(defrule
	(goal gl-island-migration-state MIGRATION-RETURNING)
	(up-timer-status t-island-migration == timer-triggered)
=>
	(set-strategic-number sn-focus-player-number my-player-number)
	(up-full-reset-search)
	(up-add-object-by-id search-local g: gl-island-migration-transport-id)
	(set-goal gl-island-migration-state MIGRATION-RETURN-CHECK)
)

(defrule
	(goal gl-island-migration-state MIGRATION-RETURN-CHECK)
	(goal gl-island-migration-mission MIGRATION-MISSION-MINING)
	(up-set-target-object search-local c: 0)
	(up-object-data object-data-garrison-count <= 0)
=>
	;Recovered workers may still carry the island resource. Send them to the
	;nearest home Town Center before normal economy allocation can retask them.
	(up-full-reset-search)
	(up-set-target-point gl-home-anchor-x)
	(up-set-group search-local c: migration-boarding-group)
	(up-remove-objects search-local object-data-garrisoned == 1)
	(up-remove-objects search-local object-data-map-zone-id g:!= gl-home-zone)
	(up-remove-objects search-local object-data-carry <= 0)
	(up-clean-search search-local object-data-distance search-order-asc)
	;The reserved hull was selected within forty tiles of the startup anchor.
	;Search a wider bounded band so an inland home TC is still found from shore.
	(up-find-remote c: town-center c: 80)
	(up-remove-objects search-remote object-data-map-zone-id g:!= gl-home-zone)
	(up-clean-search search-remote object-data-distance search-order-asc)
	(up-set-timer c: t-island-migration c: 15)
	(set-goal gl-island-migration-state MIGRATION-RETURN-DEPOSIT)
)

(defrule
	(goal gl-island-migration-state MIGRATION-RETURN-DEPOSIT)
	(up-set-target-object search-remote c: 0)
=>
	;OWNERSHIP command: migration-boarding-group.
	(up-remove-objects search-local object-data-player != my-player-number)
	(up-remove-objects search-local object-data-group-flag != migration-boarding-group)
	(up-target-objects 0 action-default -1 stance-no-attack)
	(up-chat-data-to-self "migration cargo deposit target: %d" c: 1)
	(up-modify-sn sn-focus-player-number g:= gl-island-migration-focus)
	(up-set-timer c: t-island-migration c: 60)
	(set-goal gl-island-migration-state MIGRATION-IDLE)
)

(defrule
	(goal gl-island-migration-state MIGRATION-RETURN-DEPOSIT)
	(not (up-set-target-object search-remote c: 0))
=>
	(up-chat-data-to-self "migration cargo deposit target: %d" c: 0)
	(up-modify-sn sn-focus-player-number g:= gl-island-migration-focus)
	(up-set-timer c: t-island-migration c: 60)
	(set-goal gl-island-migration-state MIGRATION-IDLE)
)

(defrule
	(goal gl-island-migration-state MIGRATION-RETURN-CHECK)
	(goal gl-island-migration-mission MIGRATION-MISSION-SCOUT)
	(up-set-target-object search-local c: 0)
	(up-object-data object-data-garrison-count <= 0)
=>
	(up-modify-sn sn-focus-player-number g:= gl-island-migration-focus)
	(up-set-timer c: t-island-migration c: 60)
	(set-goal gl-island-migration-state MIGRATION-IDLE)
)

(defrule
	(goal gl-island-migration-state MIGRATION-RETURN-CHECK)
	(up-set-target-object search-local c: 0)
	(up-object-data object-data-garrison-count > 0)
	(up-compare-goal gl-island-migration-route-waits c:< 4)
=>
	;OWNERSHIP command: migration-transport-group.
	(up-remove-objects search-local object-data-player != my-player-number)
	(up-remove-objects search-local object-data-group-flag != migration-transport-group)
	(up-target-point gl-home-anchor-x action-unload -1 stance-no-attack)
	(up-modify-sn sn-focus-player-number g:= gl-island-migration-focus)
	(up-modify-goal gl-island-migration-route-waits c:+ 1)
	(up-chat-data-to-self "migration return retry: %d" g: gl-island-migration-route-waits)
	(up-set-timer c: t-island-migration c: 15)
	(set-goal gl-island-migration-state MIGRATION-RETURNING)
)

; P3B44T9 OBSERVER BEGIN
;The return producer does not establish a distance reference: record actual
;position/cargo, not a misleading distance inherited from another controller.
(defrule
	(goal gl-island-migration-state MIGRATION-RETURN-CHECK)
	(up-set-target-object search-local c: 0)
	(up-object-data object-data-garrison-count > 0)
	(up-compare-goal gl-island-migration-route-waits c:>= 4)
=>
	(up-chat-data-to-all "RAW44C migration terminal hull: %d" g: gl-island-migration-transport-id)
	(up-chat-data-to-all "RAW44C migration terminal phase: %d" c: 2)
	(up-get-point position-object gl-transport-observed-x)
	(up-chat-data-to-all "RAW44C migration hull x: %d" g: gl-transport-observed-x)
	(up-chat-data-to-all "RAW44C migration hull y: %d" g: gl-transport-observed-y)
	(up-chat-data-to-all "RAW44C migration origin x: %d" g: gl-island-migration-origin-x)
	(up-chat-data-to-all "RAW44C migration origin y: %d" g: gl-island-migration-origin-y)
	(up-get-object-data object-data-garrison-count gl-transport-observed-value)
	(up-chat-data-to-all "RAW44C migration cargo: %d" g: gl-transport-observed-value)
	(up-get-object-data object-data-idling gl-transport-observed-value)
	(up-chat-data-to-all "RAW44C migration idling: %d" g: gl-transport-observed-value)
	(up-get-object-data object-data-group-flag gl-transport-observed-value)
	(up-chat-data-to-all "RAW44C migration group: %d" g: gl-transport-observed-value)
)
; P3B44T9 OBSERVER END

(defrule
	(goal gl-island-migration-state MIGRATION-RETURN-CHECK)
	(up-set-target-object search-local c: 0)
	(up-object-data object-data-garrison-count > 0)
	(up-compare-goal gl-island-migration-route-waits c:>= 4)
=>
	(up-chat-data-to-self "migration return failed: %d" g: gl-island-migration-transport-id)
	(up-full-reset-search)
	(up-set-group search-local c: migration-boarding-group)
	(up-modify-group-flag 0 c: migration-boarding-group)
	(up-reset-group c: migration-boarding-group)
	(up-modify-sn sn-focus-player-number g:= gl-island-migration-focus)
	;Keep the occupied hull reserved, but stop repeating the rejected origin
	;beach. RETURN-FAILED will try the active home anchor instead.
	(up-set-timer c: t-island-migration c: 1)
	(set-goal gl-island-migration-state MIGRATION-RETURN-FAILED)
)

;After four failed origin-beach unloads, explicitly try the shoreline nearest
;the active home anchor. The occupied hull remains reserved throughout, while
;QUARANTINED is safe for unrelated attack controllers to work around.
(defrule
	(goal gl-island-migration-state MIGRATION-RETURN-FAILED)
	(up-timer-status t-island-migration == timer-triggered)
=>
	(set-strategic-number sn-focus-player-number my-player-number)
	(up-full-reset-search)
	(up-add-object-by-id search-local g: gl-island-migration-transport-id)
	;OWNERSHIP command: migration-transport-group.
	(up-remove-objects search-local object-data-player != my-player-number)
	(up-remove-objects search-local object-data-group-flag != migration-transport-group)
	(up-target-point gl-home-anchor-x action-unload -1 stance-no-attack)
	(up-chat-data-to-self "migration alternate return: %d" g: gl-island-migration-transport-id)
	(up-modify-sn sn-focus-player-number g:= gl-island-migration-focus)
	(up-set-timer c: t-island-migration c: 30)
	(set-goal gl-island-migration-state MIGRATION-QUARANTINED)
)

(defrule
	(goal gl-island-migration-state MIGRATION-QUARANTINED)
	(up-timer-status t-island-migration == timer-triggered)
=>
	;Inspect the one alternate-home attempt exactly once. Re-entering the normal
	;four-retry owner with its exhausted counter caused an endless failed/alternate
	;return loop in the replay.
	(set-strategic-number sn-focus-player-number my-player-number)
	(up-full-reset-search)
	(up-add-object-by-id search-local g: gl-island-migration-transport-id)
	(set-goal gl-island-migration-state MIGRATION-QUARANTINE-CHECK)
)

(defrule
	(goal gl-island-migration-state MIGRATION-QUARANTINE-CHECK)
	(up-set-target-object search-local c: 0)
	(up-object-data object-data-garrison-count <= 0)
=>
	;Only an empty hull is a successful quarantine terminal. Release both direct
	;control groups here, not while passengers remain aboard.
	(up-modify-group-flag 0 c: migration-boarding-group)
	(up-reset-group c: migration-boarding-group)
	(up-modify-group-flag 0 c: migration-transport-group)
	(up-reset-group c: migration-transport-group)
	(up-modify-sn sn-focus-player-number g:= gl-island-migration-focus)
	(set-goal gl-island-migration-transport-id -1)
	(up-set-timer c: t-island-migration c: 60)
	(set-goal gl-island-migration-state MIGRATION-IDLE)
)

(defrule
	(goal gl-island-migration-state MIGRATION-QUARANTINE-CHECK)
	(up-set-target-object search-local c: 0)
	(up-object-data object-data-garrison-count > 0)
	(up-compare-goal gl-quarantine-transport-id c:< 0)
=>
	;Detach the one blocked hull by exact ID. Utility selectors exclude that ID,
	;while the main migration state returns to IDLE so economy and other hulls are
	;not frozen by one impossible beach.
	(up-modify-goal gl-quarantine-transport-id g:= gl-island-migration-transport-id)
	(up-modify-goal gl-quarantine-transport-next g:= gl-game-time)
	(up-modify-goal gl-quarantine-transport-next c:+ 60)
	(set-goal gl-quarantine-transport-attempts 0)
	(set-goal gl-quarantine-transport-state TRANSPORT-QUARANTINE-IDLE)
	(up-modify-group-flag 0 c: migration-boarding-group)
	(up-reset-group c: migration-boarding-group)
	(up-modify-group-flag 0 c: migration-transport-group)
	(up-reset-group c: migration-transport-group)
	(set-goal gl-migration-placement-lock NO)
	(up-modify-sn sn-focus-player-number g:= gl-island-migration-focus)
	(up-chat-data-to-self "migration quarantined hull detached: %d" g: gl-quarantine-transport-id)
	(set-goal gl-island-migration-transport-id -1)
	(up-set-timer c: t-island-migration c: 60)
	(set-goal gl-island-migration-state MIGRATION-IDLE)
)

(defrule
	(goal gl-island-migration-state MIGRATION-QUARANTINE-CHECK)
	(up-set-target-object search-local c: 0)
	(up-object-data object-data-garrison-count > 0)
	(up-compare-goal gl-quarantine-transport-id c:>= 0)
=>
	;A second simultaneous quarantine remains owned by the main controller until
	;the detached slot clears; never overwrite and abandon the first exact ID.
	;Retry unloading at the hull's current shoreline rather than navigating to
	;the normally inland home anchor.
	(up-get-point position-object point-x)
	;OWNERSHIP command: migration-transport-group.
	(up-remove-objects search-local object-data-player != my-player-number)
	(up-remove-objects search-local object-data-group-flag != migration-transport-group)
	(up-target-point point-x action-unload -1 stance-no-attack)
	(up-chat-data-to-self "migration quarantine slot busy: %d" g: gl-island-migration-transport-id)
	(up-modify-group-flag 0 c: migration-boarding-group)
	(up-reset-group c: migration-boarding-group)
	(up-modify-group-flag 0 c: migration-transport-group)
	(up-reset-group c: migration-transport-group)
	(set-goal gl-migration-placement-lock NO)
	(up-modify-sn sn-focus-player-number g:= gl-island-migration-focus)
	(set-goal gl-island-migration-transport-id -1)
	(up-set-timer c: t-island-migration c: 60)
	(set-goal gl-island-migration-state MIGRATION-IDLE)
)

(defrule
	(goal gl-island-migration-state MIGRATION-QUARANTINE-CHECK)
	(not (up-set-target-object search-local c: 0))
=>
	(up-modify-group-flag 0 c: migration-boarding-group)
	(up-reset-group c: migration-boarding-group)
	(up-modify-group-flag 0 c: migration-transport-group)
	(up-reset-group c: migration-transport-group)
	(up-modify-sn sn-focus-player-number g:= gl-island-migration-focus)
	(set-goal gl-island-migration-transport-id -1)
	(up-set-timer c: t-island-migration c: 60)
	(set-goal gl-island-migration-state MIGRATION-IDLE)
)

;Detached quarantine ownership is exact-ID based rather than a scarce DUC
;group. Every Transport utility excludes this ID until the hull is proven empty
;or dead; one retry per minute cannot monopolize the migration state machine.
(defrule
	(up-compare-goal gl-quarantine-transport-id c:>= 0)
	(or
		(goal gl-quarantine-transport-state TRANSPORT-QUARANTINE-IDLE)
		(goal gl-quarantine-transport-state TRANSPORT-QUARANTINE-TERMINAL)
	)
	(up-compare-goal gl-game-time g:>= gl-quarantine-transport-next)
=>
	(up-modify-goal gl-quarantine-transport-focus s:= sn-focus-player-number)
	(set-strategic-number sn-focus-player-number my-player-number)
	(up-full-reset-search)
	(up-add-object-by-id search-local g: gl-quarantine-transport-id)
	(set-goal gl-quarantine-transport-state TRANSPORT-QUARANTINE-CHECK)
)

(defrule
	(goal gl-quarantine-transport-state TRANSPORT-QUARANTINE-CHECK)
	(up-set-target-object search-local c: 0)
	(up-object-data object-data-garrison-count > 0)
	(up-compare-goal gl-quarantine-transport-attempts c:< 3)
=>
	(up-get-point position-object point-x)
	;OWNERSHIP command: FREE.
	(up-remove-objects search-local object-data-player != my-player-number)
	(up-remove-objects search-local object-data-group-flag >= 0)
	(up-target-point point-x action-unload -1 stance-no-attack)
	(up-chat-data-to-self "detached quarantine retry: %d" g: gl-quarantine-transport-id)
	(up-modify-goal gl-quarantine-transport-attempts c:+ 1)
	(up-modify-sn sn-focus-player-number g:= gl-quarantine-transport-focus)
	(up-modify-goal gl-quarantine-transport-next g:= gl-game-time)
	(up-modify-goal gl-quarantine-transport-next c:+ 60)
	(set-goal gl-quarantine-transport-state TRANSPORT-QUARANTINE-IDLE)
)

(defrule
	(goal gl-quarantine-transport-state TRANSPORT-QUARANTINE-CHECK)
	(up-set-target-object search-local c: 0)
	(up-object-data object-data-garrison-count > 0)
	(goal gl-quarantine-transport-attempts 3)
=>
	;One terminal grace interval retains the exact hull without repeating an
	;impossible unload. The slot is then rotated so simultaneous orphaned cargo
	;hulls cannot remain forever outside every automatic controller.
	(up-chat-data-to-self "detached quarantine terminal: %d" g: gl-quarantine-transport-id)
	(up-modify-goal gl-quarantine-transport-attempts c:+ 1)
	(up-modify-sn sn-focus-player-number g:= gl-quarantine-transport-focus)
	(up-modify-goal gl-quarantine-transport-next g:= gl-game-time)
	(up-modify-goal gl-quarantine-transport-next c:+ 60)
	(set-goal gl-quarantine-transport-state TRANSPORT-QUARANTINE-TERMINAL)
)

(defrule
	(goal gl-quarantine-transport-state TRANSPORT-QUARANTINE-CHECK)
	(up-set-target-object search-local c: 0)
	(up-object-data object-data-garrison-count > 0)
	(up-compare-goal gl-quarantine-transport-attempts c:>= 4)
=>
	;Remember the terminal hull long enough for the free-hull scanner to choose a
	;different orphan. Loaded hulls remain excluded from migration and assault
	;admission even after this scarce exact-ID slot rotates.
	(up-modify-goal gl-assault-recovery-rejected g:= gl-quarantine-transport-id)
	(up-modify-goal gl-assault-recovery-retry g:= gl-game-time)
	(up-modify-goal gl-assault-recovery-retry c:+ 300)
	(up-modify-sn sn-focus-player-number g:= gl-quarantine-transport-focus)
	(set-goal gl-quarantine-transport-id -1)
	(up-modify-goal gl-quarantine-transport-next g:= gl-game-time)
	(up-modify-goal gl-quarantine-transport-next c:+ 30)
	(set-goal gl-quarantine-transport-state TRANSPORT-QUARANTINE-IDLE)
)

(defrule
	(goal gl-quarantine-transport-state TRANSPORT-QUARANTINE-CHECK)
	(up-set-target-object search-local c: 0)
	(up-object-data object-data-garrison-count <= 0)
=>
	(up-chat-data-to-self "detached quarantine recovered: %d" g: gl-quarantine-transport-id)
	(up-modify-sn sn-focus-player-number g:= gl-quarantine-transport-focus)
	(set-goal gl-quarantine-transport-id -1)
	(up-modify-goal gl-quarantine-transport-next g:= gl-game-time)
	(up-modify-goal gl-quarantine-transport-next c:+ 60)
	(set-goal gl-quarantine-transport-state TRANSPORT-QUARANTINE-IDLE)
)

(defrule
	(goal gl-quarantine-transport-state TRANSPORT-QUARANTINE-CHECK)
	(not (up-set-target-object search-local c: 0))
=>
	(up-chat-data-to-self "detached quarantine hull lost: %d" g: gl-quarantine-transport-id)
	(up-modify-sn sn-focus-player-number g:= gl-quarantine-transport-focus)
	(set-goal gl-quarantine-transport-id -1)
	(up-modify-goal gl-quarantine-transport-next g:= gl-game-time)
	(up-modify-goal gl-quarantine-transport-next c:+ 60)
	(set-goal gl-quarantine-transport-state TRANSPORT-QUARANTINE-IDLE)
)

;Preparation recovery can relinquish a loaded hull when the exact quarantine
;slot is already occupied. Once all transport state machines are idle, adopt
;one such free, motionless cargo hull and put it through the same bounded exact-
;ID shoreline-unload lifecycle. This scanner never takes a grouped mission,
;moving hull, damaged hull, or the most recently terminal hull.
(defrule
	(goal gl-quarantine-transport-state TRANSPORT-QUARANTINE-IDLE)
	(up-compare-goal gl-quarantine-transport-id c:< 0)
	(up-compare-goal gl-game-time g:>= gl-quarantine-transport-next)
	(goal gl-island-migration-state MIGRATION-IDLE)
	(goal gl-relic-ferry-state RELIC-FERRY-IDLE)
	(goal gl-transport-route-state TRANSPORT-ROUTE-IDLE)
	(goal gl-transport-recovery-state TRANSPORT-RECOVERY-IDLE)
	(goal gl-transport-repair-state TRANSPORT-REPAIR-IDLE)
	(goal gl-transport-clear-state TRANSPORT-CLEAR-IDLE)
=>
	(up-modify-goal gl-quarantine-transport-focus s:= sn-focus-player-number)
	(set-strategic-number sn-focus-player-number my-player-number)
	(up-full-reset-search)
	(up-find-local c: transport-ship c: 40)
	(up-remove-objects search-local object-data-player != my-player-number)
	(up-remove-objects search-local object-data-id g:== gl-assault-recovery-rejected)
	(up-remove-objects search-local object-data-garrison-count <= 0)
	(up-remove-objects search-local object-data-group-flag >= 0)
	(up-remove-objects search-local object-data-idling != 1)
	(up-remove-objects search-local object-data-under-attack > 0)
	(up-clean-search search-local object-data-distance search-order-asc)
	(set-goal gl-quarantine-transport-state TRANSPORT-QUARANTINE-SCAN)
)

(defrule
	(goal gl-quarantine-transport-state TRANSPORT-QUARANTINE-SCAN)
	(up-set-target-object search-local c: 0)
=>
	(up-get-object-data object-data-id gl-quarantine-transport-id)
	(set-goal gl-quarantine-transport-attempts 0)
	(up-modify-goal gl-quarantine-transport-next g:= gl-game-time)
	(set-goal gl-quarantine-transport-state TRANSPORT-QUARANTINE-CHECK)
)

(defrule
	(goal gl-quarantine-transport-state TRANSPORT-QUARANTINE-SCAN)
	(not (up-set-target-object search-local c: 0))
=>
	(up-modify-sn sn-focus-player-number g:= gl-quarantine-transport-focus)
	(up-modify-goal gl-quarantine-transport-next g:= gl-game-time)
	(up-modify-goal gl-quarantine-transport-next c:+ 30)
	(set-goal gl-quarantine-transport-state TRANSPORT-QUARANTINE-IDLE)
)

(defrule
	(goal gl-island-migration-state MIGRATION-RETURN-CHECK)
	(not (up-set-target-object search-local c: 0))
=>
	(up-modify-sn sn-focus-player-number g:= gl-island-migration-focus)
	(up-set-timer c: t-island-migration c: 60)
	(set-goal gl-island-migration-state MIGRATION-IDLE)
)

(defrule
	(goal gl-island-migration-state MIGRATION-CHECK-LOAD)
	(up-timer-status t-island-migration == timer-running)
	(up-timer-status t-island-migration-board-retry == timer-triggered)
	(up-set-target-object search-local c: 0)
	(up-object-data object-data-garrison-count g:< gl-island-migration-load-target)
	(goal gl-island-migration-load-reported NO)
=>
	;Record one passenger before the first command renewal. This preserves the
	;pre-manual-load state when the user later makes the route start.
	(up-get-object-data object-data-garrison-count gl-island-migration-load-observed)
	(set-goal gl-island-migration-load-terminal TRANSPORT-LOAD-TERMINAL-NONE)
	(set-goal gl-island-migration-state MIGRATION-LOAD-DIAG-FIND)
)

(defrule
	(goal gl-island-migration-state MIGRATION-CHECK-LOAD)
	(up-timer-status t-island-migration == timer-running)
	(up-timer-status t-island-migration-board-retry == timer-triggered)
	(up-set-target-object search-local c: 0)
	(up-object-data object-data-garrison-count g:< gl-island-migration-load-target)
	(goal gl-island-migration-load-reported YES)
=>
	(up-full-reset-search)
	(up-set-group search-local c: migration-boarding-group)
	(up-remove-objects search-local object-data-garrisoned == 1)
	(up-find-remote c: transport-ship c: 40)
	(up-remove-objects search-remote object-data-id g:!= gl-island-migration-transport-id)
	;OWNERSHIP command: migration-boarding-group.
	(up-remove-objects search-local object-data-player != my-player-number)
	(up-remove-objects search-local object-data-group-flag != migration-boarding-group)
	(up-target-objects 0 action-garrison -1 stance-no-attack)
	(up-set-timer c: t-island-migration-board-retry c: 3)
	(set-goal gl-island-migration-state MIGRATION-LOADING)
)

(defrule
	(goal gl-island-migration-state MIGRATION-CHECK-LOAD)
	(up-timer-status t-island-migration == timer-running)
	(up-timer-status t-island-migration-board-retry == timer-running)
	(up-set-target-object search-local c: 0)
	(up-object-data object-data-garrison-count g:< gl-island-migration-load-target)
=>
	(set-goal gl-island-migration-state MIGRATION-LOADING)
)

(defrule
	(goal gl-island-migration-state MIGRATION-SAILING)
=>
	(up-full-reset-search)
	(up-add-object-by-id search-local g: gl-island-migration-transport-id)
	(set-goal gl-island-migration-state MIGRATION-CHECK-LANDING)
)

(defrule
	(goal gl-island-migration-state MIGRATION-CHECK-LANDING)
	(goal gl-island-migration-mission MIGRATION-MISSION-MINING)
	(up-set-target-object search-local c: 0)
	(up-object-data object-data-garrison-count <= 0)
=>
	(up-full-reset-search)
	(up-set-target-point gl-island-migration-target-x)
	(up-set-group search-local c: migration-boarding-group)
	(up-remove-objects search-local object-data-garrisoned == 1)
	(up-remove-objects search-local object-data-map-zone-id g:!= gl-island-migration-zone)
	(up-clean-search search-local object-data-distance search-order-asc)
	(up-get-search-state local-total)
	(set-goal gl-island-migration-state MIGRATION-VERIFY-LANDING)
)

(defrule
	(goal gl-island-migration-state MIGRATION-CHECK-LANDING)
	(goal gl-island-migration-mission MIGRATION-MISSION-SCOUT)
	(up-set-target-object search-local c: 0)
	(up-object-data object-data-garrison-count <= 0)
=>
	;Rebuild and prove the reserved scout on the requested land zone before any
	;mission success, patrol command, or Transport recall is permitted.
	(set-strategic-number sn-focus-player-number my-player-number)
	(up-full-reset-search)
	(up-set-group search-local c: migration-boarding-group)
	(up-remove-objects search-local object-data-garrisoned == 1)
	(up-remove-objects search-local object-data-map-zone-id g:!= gl-island-migration-zone)
	(up-clean-search search-local object-data-distance search-order-asc)
	(set-goal gl-island-migration-state MIGRATION-VERIFY-SCOUT-LANDING)
)

(defrule
	(goal gl-island-migration-state MIGRATION-VERIFY-SCOUT-LANDING)
	(up-set-target-object search-local c: 0)
=>
	;Now that the reserved scout is proven ashore in the destination zone, clear
	;its stale board order before the empty Transport is allowed to move.
	;OWNERSHIP command: migration-boarding-group.
	(up-remove-objects search-local object-data-player != my-player-number)
	(up-remove-objects search-local object-data-group-flag != migration-boarding-group)
	; RAW12 counter 9
	(up-modify-goal gl-command-counter-9 c:+ 1)
	(up-target-point position-self-x action-stop -1 stance-no-attack)
	(set-goal gl-island-migration-state MIGRATION-TASK-SCOUT)
)

(defrule
	(goal gl-island-migration-state MIGRATION-VERIFY-SCOUT-LANDING)
	(not (up-set-target-object search-local c: 0))
=>
	(up-chat-data-to-self "migration scout not landed: %d" g: gl-island-migration-zone)
	(up-modify-group-flag 0 c: migration-boarding-group)
	(up-reset-group c: migration-boarding-group)
	(up-full-reset-search)
	(up-add-object-by-id search-local g: gl-island-migration-transport-id)
	;OWNERSHIP command: migration-transport-group.
	(up-remove-objects search-local object-data-player != my-player-number)
	(up-remove-objects search-local object-data-group-flag != migration-transport-group)
	(up-target-point gl-island-migration-origin-x action-move -1 stance-no-attack)
	(up-modify-sn sn-focus-player-number g:= gl-island-migration-focus)
	(up-set-timer c: t-island-migration c: 60)
	(set-goal gl-island-migration-state MIGRATION-IDLE)
)

(defrule
	(goal gl-island-migration-state MIGRATION-VERIFY-LANDING)
	(up-compare-goal local-total c:>= 1)
=>
	(up-chat-data-to-self "migration settlers landed: %d" g: local-total)
	(set-goal gl-island-migration-anchor-rejections 0)
	;Preserve the resource that justified this voyage. Revalidate its exact ID,
	;class and land zone first; the existing stale-anchor path selects a nearby
	;alternative only when that original resource truly disappeared.
	(set-goal gl-island-migration-state MIGRATION-VALIDATE-DROPSITE-ANCHOR)
)

(defrule
	(goal gl-island-migration-state MIGRATION-VERIFY-LANDING)
	(up-compare-goal local-total c:< 1)
=>
	(up-chat-data-to-self "migration wrong landing zone: %d" g: gl-island-migration-zone)
	(up-full-reset-search)
	(up-set-group search-local c: migration-boarding-group)
	(up-remove-objects search-local object-data-garrisoned == 1)
	(up-remove-objects search-local object-data-map-zone-id g:== gl-home-zone)
	(up-clean-search search-local object-data-distance search-order-asc)
	(set-goal gl-island-migration-state MIGRATION-RECOVER-LANDING)
)

;If pathing unloaded the settlers on a different island, adopt that island as
;the colony only when it contains an observed natural resource. This prevents
;a wrong beach from becoming a permanent idle-villager trap.
(defrule
	(goal gl-island-migration-state MIGRATION-RECOVER-LANDING)
	(up-set-target-object search-local c: 0)
=>
	(up-get-object-data object-data-map-zone-id gl-island-migration-zone)
	(up-get-point position-object gl-island-migration-target-x)
	(set-goal gl-island-migration-anchor-rejections 0)
	(set-strategic-number sn-focus-player-number 0)
	(up-full-reset-search)
	(up-set-target-point gl-island-migration-target-x)
	(up-find-remote c: gold-mine-class c: 10)
	(up-find-remote c: stone-mine-class c: 10)
	(up-find-remote c: tree-class c: 40)
	(up-find-remote c: forage-class c: 10)
	(up-find-remote c: prey-animal-class c: 10)
	(up-remove-objects search-remote object-data-map-zone-id g:!= gl-island-migration-zone)
	(up-clean-search search-remote object-data-distance search-order-asc)
	(set-goal gl-island-migration-state MIGRATION-FIND-RECOVERY-ANCHOR)
)

(defrule
	(goal gl-island-migration-state MIGRATION-RECOVER-LANDING)
	(not (up-set-target-object search-local c: 0))
=>
	(up-chat-data-to-self "migration settlers not found: %d" c: 0)
	(up-modify-group-flag 0 c: migration-boarding-group)
	(up-reset-group c: migration-boarding-group)
	(up-full-reset-search)
	(up-add-object-by-id search-local g: gl-island-migration-transport-id)
	;OWNERSHIP command: migration-transport-group.
	(up-remove-objects search-local object-data-player != my-player-number)
	(up-remove-objects search-local object-data-group-flag != migration-transport-group)
	(up-target-point gl-island-migration-origin-x action-move -1 stance-no-attack)
	(up-modify-sn sn-focus-player-number g:= gl-island-migration-focus)
	(up-set-timer c: t-island-migration c: 60)
	(set-goal gl-island-migration-state MIGRATION-IDLE)
)

(defrule
	(goal gl-island-migration-state MIGRATION-FIND-RECOVERY-ANCHOR)
	(up-set-target-object search-remote c: 0)
=>
	(up-get-object-data object-data-id gl-island-migration-anchor-id)
	(up-get-object-data object-data-class gl-island-migration-anchor-class)
	(up-get-point position-object gl-island-migration-target-x)
	(up-chat-data-to-self "migration recovered zone: %d" g: gl-island-migration-zone)
	(set-strategic-number sn-focus-player-number my-player-number)
	(set-goal gl-island-migration-state MIGRATION-TASK-MINING)
)

(defrule
	(goal gl-island-migration-state MIGRATION-FIND-RECOVERY-ANCHOR)
	(not (up-set-target-object search-remote c: 0))
=>
	(up-chat-data-to-self "migration recovery no resources: %d" g: gl-island-migration-zone)
	(set-strategic-number sn-focus-player-number my-player-number)
	(set-goal gl-island-migration-state MIGRATION-DROPSITE-FAILED)
)

;Task only the reserved settlers confirmed on the selected land zone, place a
;drop site matching the selected natural resource, and retain them until the
;correct-zone foundation is complete.
(defrule
	(goal gl-island-migration-state MIGRATION-TASK-MINING)
	(goal gl-island-migration-mission MIGRATION-MISSION-MINING)
=>
	(set-goal gl-migration-placement-lock YES)
	(up-set-timer c: t-island-migration c: 240)
	(set-goal gl-island-migration-state MIGRATION-WAIT-DROPSITE-OWNER)
)

;Home-base placement rules run before military rules. Wait for any placement
;that entered earlier in the same sweep to finish before claiming the global
;pending-placement channel for the remote colony.
(defrule
	(goal gl-island-migration-state MIGRATION-WAIT-DROPSITE-OWNER)
	(goal gl-colony-towncenter-state COLONY-TC-IDLE)
	(up-pending-objects c: town-center <= 0)
	(not (up-pending-placement c: town-center))
	(goal gl-lumbercamp-placement-state PLACEMENT-IDLE)
	(goal gl-miningcamp-placement-state PLACEMENT-IDLE)
	(up-pending-objects c: mining-camp <= 0)
	(up-pending-objects c: lumber-camp <= 0)
	(up-pending-objects c: mill <= 0)
	(not (up-pending-placement c: mining-camp))
	(not (up-pending-placement c: lumber-camp))
	(not (up-pending-placement c: mill))

=>
	(set-goal gl-island-migration-state MIGRATION-WAIT-DROPSITE-CLEAR)
)

(defrule
	(goal gl-island-migration-state MIGRATION-WAIT-DROPSITE-CLEAR)
	(up-pending-objects c: house <= 0)
	(up-pending-objects c: market <= 0)
	(not (up-pending-placement c: house))
	(not (up-pending-placement c: market))
=>
	(up-full-reset-search)
	(up-set-target-point gl-island-migration-target-x)
	(up-set-group search-local c: migration-boarding-group)
	(up-remove-objects search-local object-data-map-zone-id g:!= gl-island-migration-zone)
	(set-strategic-number sn-focus-player-number 0)
	(up-add-object-by-id search-remote g: gl-island-migration-anchor-id)
	;Let the reserved settlers begin harvesting while placement is negotiated,
	;but retain the group until they own and finish the remote foundation.
	;OWNERSHIP command: migration-boarding-group.
	(up-remove-objects search-local object-data-player != my-player-number)
	(up-remove-objects search-local object-data-group-flag != migration-boarding-group)
	(up-target-objects 0 action-default -1 stance-no-attack)
	(up-modify-sn sn-focus-player-number g:= gl-island-migration-focus)
	(set-goal gl-island-migration-placement-attempts 0)
	(set-goal gl-island-migration-point-retry-used NO)
	(up-set-timer c: t-island-migration c: 120)
	(set-goal gl-island-migration-state MIGRATION-VALIDATE-DROPSITE-ANCHOR)
)

;Try four bounded diagonals around the colony resource. The migration system
;keeps ownership until a foundation appears or every placement expires.
;Persist the chosen point BEFORE ISSUE can wait for resources/placement. The
;global target point is scratch state and can belong to another controller on
;the next pass. Historical position-target diagnostics read an ENEMY building,
;not that scratch point; they are not evidence of the requested coordinates.
(defrule
	(goal gl-island-migration-state MIGRATION-PLACE-DROPSITE)
	(goal gl-island-migration-placement-attempts 0)
=>
	(up-copy-point point2-x gl-island-migration-target-x)
	(up-modify-goal point2-x c:+ 3)
	(up-modify-goal point2-y c:+ 3)
	(up-bound-point point3-x point2-x)
	(up-copy-point gl-migration-build-x point3-x)
	(up-set-target-point point3-x)
	(up-set-timer c: t-island-migration c: 120)
	(set-goal gl-island-migration-state MIGRATION-ISSUE-DROPSITE)
)

(defrule
	(goal gl-island-migration-state MIGRATION-PLACE-DROPSITE)
	(goal gl-island-migration-placement-attempts 1)
=>
	(up-copy-point point2-x gl-island-migration-target-x)
	(up-modify-goal point2-x c:- 3)
	(up-modify-goal point2-y c:+ 3)
	(up-bound-point point3-x point2-x)
	(up-copy-point gl-migration-build-x point3-x)
	(up-set-target-point point3-x)
	(up-set-timer c: t-island-migration c: 120)
	(set-goal gl-island-migration-state MIGRATION-ISSUE-DROPSITE)
)

(defrule
	(goal gl-island-migration-state MIGRATION-PLACE-DROPSITE)
	(goal gl-island-migration-placement-attempts 2)
=>
	(up-copy-point point2-x gl-island-migration-target-x)
	(up-modify-goal point2-x c:+ 3)
	(up-modify-goal point2-y c:- 3)
	(up-bound-point point3-x point2-x)
	(up-copy-point gl-migration-build-x point3-x)
	(up-set-target-point point3-x)
	(up-set-timer c: t-island-migration c: 120)
	(set-goal gl-island-migration-state MIGRATION-ISSUE-DROPSITE)
)

(defrule
	(goal gl-island-migration-state MIGRATION-PLACE-DROPSITE)
	(goal gl-island-migration-placement-attempts 3)
=>
	(up-copy-point point2-x gl-island-migration-target-x)
	(up-modify-goal point2-x c:- 3)
	(up-modify-goal point2-y c:- 3)
	(up-bound-point point3-x point2-x)
	(up-copy-point gl-migration-build-x point3-x)
	(up-set-target-point point3-x)
	(up-set-timer c: t-island-migration c: 120)
	(set-goal gl-island-migration-state MIGRATION-ISSUE-DROPSITE)
)

;A cached colony anchor is not permanent evidence. Re-resolve the exact Gaia
;object immediately before every placement attempt and refresh its point. Tree
;anchors additionally require a useful same-zone cluster rather than one
;straggling tree.
(defrule
	(goal gl-island-migration-state MIGRATION-VALIDATE-DROPSITE-ANCHOR)
=>
	(set-strategic-number sn-focus-player-number 0)
	(up-full-reset-search)
	(up-add-object-by-id search-remote g: gl-island-migration-anchor-id)
	(set-goal gl-island-migration-state MIGRATION-CHECK-DROPSITE-ANCHOR)
)

(defrule
	(goal gl-island-migration-state MIGRATION-CHECK-DROPSITE-ANCHOR)
	(up-set-target-object search-remote c: 0)
	(up-object-data object-data-class g:== gl-island-migration-anchor-class)
	(up-object-data object-data-map-zone-id g:== gl-island-migration-zone)
	(goal gl-island-migration-anchor-class tree-class)
=>
	(up-get-point position-object gl-island-migration-target-x)
	(up-full-reset-search)
	(up-set-target-point gl-island-migration-target-x)
	(up-filter-distance c: -1 c: 8)
	(up-find-remote c: tree-class c: 20)
	(up-remove-objects search-remote object-data-map-zone-id g:!= gl-island-migration-zone)
	(up-get-search-state local-total)
	(set-goal gl-island-migration-state MIGRATION-CHECK-DROPSITE-TREES)
)

(defrule
	(goal gl-island-migration-state MIGRATION-CHECK-DROPSITE-ANCHOR)
	(up-set-target-object search-remote c: 0)
	(up-object-data object-data-class g:== gl-island-migration-anchor-class)
	(up-object-data object-data-map-zone-id g:== gl-island-migration-zone)
	(up-compare-goal gl-island-migration-anchor-class c:!= tree-class)
=>
	(up-get-point position-object gl-island-migration-target-x)
	(up-chat-data-to-self "migration live resource anchor: %d" g: gl-island-migration-anchor-id)
	(up-modify-sn sn-focus-player-number g:= gl-island-migration-focus)
	(set-goal gl-island-migration-state MIGRATION-PLACE-DROPSITE)
)

(defrule
	(goal gl-island-migration-state MIGRATION-CHECK-DROPSITE-TREES)
	(up-compare-goal remote-total c:>= 3)
=>
	(up-chat-data-to-self "migration live lumber cluster: %d" g: remote-total)
	(up-modify-sn sn-focus-player-number g:= gl-island-migration-focus)
	(set-goal gl-island-migration-state MIGRATION-PLACE-DROPSITE)
)

(defrule
	(goal gl-island-migration-state MIGRATION-CHECK-DROPSITE-TREES)
	(up-compare-goal remote-total c:< 3)
	(goal gl-island-migration-anchor-rejections 0)
=>
	(up-chat-data-to-self "migration rejected sparse lumber cluster: %d" g: remote-total)
	(up-copy-point gl-island-migration-rejected-tree1-x gl-island-migration-target-x)
	(set-goal gl-island-migration-anchor-rejections 1)
	(set-goal gl-island-migration-state MIGRATION-REFRESH-DROPSITE-AFTER-SPARSE)
)

(defrule
	(goal gl-island-migration-state MIGRATION-CHECK-DROPSITE-TREES)
	(up-compare-goal remote-total c:< 3)
	(goal gl-island-migration-anchor-rejections 1)
=>
	(up-chat-data-to-self "migration rejected second sparse lumber cluster: %d" g: remote-total)
	(up-copy-point gl-island-migration-rejected-tree2-x gl-island-migration-target-x)
	(set-goal gl-island-migration-anchor-rejections 2)
	(set-goal gl-island-migration-state MIGRATION-REFRESH-DROPSITE-AFTER-SPARSE)
)

(defrule
	(goal gl-island-migration-state MIGRATION-CHECK-DROPSITE-TREES)
	(up-compare-goal remote-total c:< 3)
	(goal gl-island-migration-anchor-rejections 2)
=>
	(up-chat-data-to-self "migration rejected third sparse lumber cluster: %d" g: remote-total)
	(up-copy-point gl-island-migration-rejected-tree3-x gl-island-migration-target-x)
	(set-goal gl-island-migration-anchor-rejections 3)
	(set-goal gl-island-migration-state MIGRATION-REFRESH-DROPSITE-AFTER-SPARSE)
)

(defrule
	(goal gl-island-migration-state MIGRATION-CHECK-DROPSITE-TREES)
	(up-compare-goal remote-total c:< 3)
	(goal gl-island-migration-anchor-rejections 3)
=>
	(up-chat-data-to-self "migration exhausted sparse lumber anchors: %d" g: gl-island-migration-anchor-rejections)
	(up-modify-sn sn-focus-player-number g:= gl-island-migration-focus)
	(set-goal gl-island-migration-state MIGRATION-DROPSITE-FAILED)
)

(defrule
	(goal gl-island-migration-state MIGRATION-CHECK-DROPSITE-ANCHOR)
	(up-set-target-object search-remote c: 0)
	(or
		(up-object-data object-data-class g:!= gl-island-migration-anchor-class)
		(up-object-data object-data-map-zone-id g:!= gl-island-migration-zone)
	)
=>
	(set-goal gl-island-migration-state MIGRATION-REFRESH-DROPSITE-ANCHOR)
)

(defrule
	(goal gl-island-migration-state MIGRATION-CHECK-DROPSITE-ANCHOR)
	(not (up-set-target-object search-remote c: 0))
=>
	(set-goal gl-island-migration-state MIGRATION-REFRESH-DROPSITE-ANCHOR)
)

(defrule
	(goal gl-island-migration-state MIGRATION-REFRESH-DROPSITE-ANCHOR)
=>
	(set-strategic-number sn-focus-player-number 0)
	(up-full-reset-search)
	(up-set-target-point gl-island-migration-target-x)
	(up-find-remote c: gold-mine-class c: 10)
	(up-find-remote c: stone-mine-class c: 10)
	(up-find-remote c: tree-class c: 40)
	(up-find-remote c: forage-class c: 10)
	(up-find-remote c: prey-animal-class c: 10)
	(up-remove-objects search-remote object-data-id g:== gl-island-migration-anchor-id)
	(up-remove-objects search-remote object-data-map-zone-id g:!= gl-island-migration-zone)
	(up-clean-search search-remote object-data-distance search-order-asc)
	(up-chat-data-to-self "migration refreshing stale resource anchor: %d" g: gl-island-migration-anchor-id)
	(set-goal gl-island-migration-state MIGRATION-FIND-RECOVERY-ANCHOR)
)

;Consume the refreshed list immediately. Holding a Gaia-focused DUC list until
;the next sweep lets unrelated military rules overwrite both search ownership
;and focus before the old recovery consumer can run.
(defrule
	(goal gl-island-migration-state MIGRATION-FIND-RECOVERY-ANCHOR)
	(up-set-target-object search-remote c: 0)
=>
	(up-get-object-data object-data-id gl-island-migration-anchor-id)
	(up-get-object-data object-data-class gl-island-migration-anchor-class)
	(up-get-point position-object gl-island-migration-target-x)
	(up-chat-data-to-self "migration refreshed resource anchor: %d" g: gl-island-migration-anchor-id)
	(set-strategic-number sn-focus-player-number my-player-number)
	(set-goal gl-island-migration-state MIGRATION-TASK-MINING)
)

(defrule
	(goal gl-island-migration-state MIGRATION-FIND-RECOVERY-ANCHOR)
	(not (up-set-target-object search-remote c: 0))
=>
	(up-chat-data-to-self "migration refresh found no resources: %d" g: gl-island-migration-zone)
	(set-strategic-number sn-focus-player-number my-player-number)
	(set-goal gl-island-migration-state MIGRATION-DROPSITE-FAILED)
)

;After rejecting a sparse tree, test every mine or natural-food alternative
;first. If none exists, build one tree candidate list and remove every stored
;eight-tile rejected pocket so two sparse groves cannot alternate forever.
(defrule
	(goal gl-island-migration-state MIGRATION-REFRESH-DROPSITE-AFTER-SPARSE)
=>
	(set-strategic-number sn-focus-player-number 0)
	(up-full-reset-search)
	(up-set-target-point gl-island-migration-target-x)
	(up-find-remote c: gold-mine-class c: 10)
	(up-find-remote c: stone-mine-class c: 10)
	(up-find-remote c: forage-class c: 10)
	(up-find-remote c: prey-animal-class c: 10)
	(up-remove-objects search-remote object-data-map-zone-id g:!= gl-island-migration-zone)
	(up-clean-search search-remote object-data-distance search-order-asc)
	(set-goal gl-island-migration-state MIGRATION-CHECK-DROPSITE-NONTREE)
)

(defrule
	(goal gl-island-migration-state MIGRATION-CHECK-DROPSITE-NONTREE)
	(up-set-target-object search-remote c: 0)
=>
	(up-get-object-data object-data-id gl-island-migration-anchor-id)
	(up-get-object-data object-data-class gl-island-migration-anchor-class)
	(up-get-point position-object gl-island-migration-target-x)
	(up-chat-data-to-self "migration alternate resource anchor: %d" g: gl-island-migration-anchor-id)
	(set-strategic-number sn-focus-player-number my-player-number)
	(set-goal gl-island-migration-state MIGRATION-TASK-MINING)
)

(defrule
	(goal gl-island-migration-state MIGRATION-CHECK-DROPSITE-NONTREE)
	(not (up-set-target-object search-remote c: 0))
=>
	(set-goal gl-island-migration-state MIGRATION-REFRESH-DROPSITE-TREES)
)

(defrule
	(goal gl-island-migration-state MIGRATION-REFRESH-DROPSITE-TREES)
	(goal gl-island-migration-anchor-rejections 1)
=>
	(set-strategic-number sn-focus-player-number 0)
	(up-full-reset-search)
	(up-set-target-point gl-island-migration-rejected-tree1-x)
	(up-find-remote c: tree-class c: 40)
	(up-remove-objects search-remote object-data-map-zone-id g:!= gl-island-migration-zone)
	(up-remove-objects search-remote object-data-distance <= 8)
	(up-clean-search search-remote object-data-distance search-order-asc)
	(set-goal gl-island-migration-state MIGRATION-FIND-RECOVERY-ANCHOR)
)

(defrule
	(goal gl-island-migration-state MIGRATION-REFRESH-DROPSITE-TREES)
	(goal gl-island-migration-anchor-rejections 2)
=>
	(set-strategic-number sn-focus-player-number 0)
	(up-full-reset-search)
	(up-set-target-point gl-island-migration-rejected-tree1-x)
	(up-find-remote c: tree-class c: 40)
	(up-remove-objects search-remote object-data-map-zone-id g:!= gl-island-migration-zone)
	(up-remove-objects search-remote object-data-distance <= 8)
	(up-set-target-point gl-island-migration-rejected-tree2-x)
	(up-remove-objects search-remote object-data-distance <= 8)
	(up-clean-search search-remote object-data-distance search-order-asc)
	(set-goal gl-island-migration-state MIGRATION-FIND-RECOVERY-ANCHOR)
)

(defrule
	(goal gl-island-migration-state MIGRATION-REFRESH-DROPSITE-TREES)
	(goal gl-island-migration-anchor-rejections 3)
=>
	(set-strategic-number sn-focus-player-number 0)
	(up-full-reset-search)
	(up-set-target-point gl-island-migration-rejected-tree1-x)
	(up-find-remote c: tree-class c: 40)
	(up-remove-objects search-remote object-data-map-zone-id g:!= gl-island-migration-zone)
	(up-remove-objects search-remote object-data-distance <= 8)
	(up-set-target-point gl-island-migration-rejected-tree2-x)
	(up-remove-objects search-remote object-data-distance <= 8)
	(up-set-target-point gl-island-migration-rejected-tree3-x)
	(up-remove-objects search-remote object-data-distance <= 8)
	(up-clean-search search-remote object-data-distance search-order-asc)
	(set-goal gl-island-migration-state MIGRATION-FIND-RECOVERY-ANCHOR)
)

(defrule
	(goal gl-island-migration-state MIGRATION-FIND-RECOVERY-ANCHOR)
	(up-set-target-object search-remote c: 0)
=>
	(up-get-object-data object-data-id gl-island-migration-anchor-id)
	(up-get-object-data object-data-class gl-island-migration-anchor-class)
	(up-get-point position-object gl-island-migration-target-x)
	(up-chat-data-to-self "migration alternate tree anchor: %d" g: gl-island-migration-anchor-id)
	(set-strategic-number sn-focus-player-number my-player-number)
	(set-goal gl-island-migration-state MIGRATION-TASK-MINING)
)

(defrule
	(goal gl-island-migration-state MIGRATION-FIND-RECOVERY-ANCHOR)
	(not (up-set-target-object search-remote c: 0))
=>
	(up-chat-data-to-self "migration alternate tree clusters exhausted: %d" g: gl-island-migration-zone)
	(set-strategic-number sn-focus-player-number my-player-number)
	(set-goal gl-island-migration-state MIGRATION-DROPSITE-FAILED)
)

;Remote settlers cannot solve a spendable-wood shortage by harvesting before
;their first drop site exists. Building escrow commonly holds enough total wood
;for the camp while can-afford-building sees too little. Release that reserved
;wood only when the matching building is proven affordable with escrow, then let
;the ordinary exact-point issue rule below own the foundation request.
(defrule
	(goal gl-island-migration-state MIGRATION-ISSUE-DROPSITE)
	(or
		(goal gl-island-migration-anchor-class gold-mine-class)
		(goal gl-island-migration-anchor-class stone-mine-class)
	)
	(not (can-afford-building mining-camp))
	(can-build-with-escrow mining-camp)
=>
	(release-escrow wood)
)

(defrule
	(goal gl-island-migration-state MIGRATION-ISSUE-DROPSITE)
	(goal gl-island-migration-anchor-class tree-class)
	(not (can-afford-building lumber-camp))
	(can-build-with-escrow lumber-camp)
=>
	(release-escrow wood)
)

(defrule
	(goal gl-island-migration-state MIGRATION-ISSUE-DROPSITE)
	(or
		(goal gl-island-migration-anchor-class forage-class)
		(goal gl-island-migration-anchor-class prey-animal-class)
	)
	(not (can-afford-building mill))
	(can-build-with-escrow mill)
=>
	(release-escrow wood)
)

(defrule
	(goal gl-owner-worker-hold NO)
	(goal gl-island-migration-state MIGRATION-ISSUE-DROPSITE)
	(or
		(goal gl-island-migration-anchor-class gold-mine-class)
		(goal gl-island-migration-anchor-class stone-mine-class)
	)
	(up-pending-objects c: mining-camp <= 0)
	(not (up-pending-placement c: mining-camp))
	(up-can-build 0 c: mining-camp)
	(up-can-build-line 0 gl-migration-build-x c: mining-camp)
=>
	;place-point queues an expanding search, not an exact foundation. T17's
	;requests drifted 25-34 tiles from the resource and failed our 8-tile verifier.
	;Use the explicit point twice for ONE foundation; keep the ordinary
	;up-can-build gate as well, so up-build-line cannot consume escrow.
	(up-copy-point gl-t12-drop-x gl-migration-build-x)
	(up-build-line gl-migration-build-x gl-migration-build-x c: mining-camp)
	(set-goal gl-t12-drop-stage 1)
	(up-modify-goal gl-island-migration-placement-attempts c:+ 1)
	(up-chat-data-to-self "migration mining camp attempt: %d" g: gl-island-migration-placement-attempts)
	(up-set-timer c: t-island-migration c: 20)
	(set-goal gl-island-migration-state MIGRATION-WAIT-DROPSITE)
)

;When the building is affordable but the selected point is rejected, advance
;to the next offset without waiting for the mission watchdog.
(defrule
	(goal gl-island-migration-state MIGRATION-ISSUE-DROPSITE)
	(or
		(goal gl-island-migration-anchor-class gold-mine-class)
		(goal gl-island-migration-anchor-class stone-mine-class)
	)
	(up-compare-goal gl-island-migration-placement-attempts c:< 3)
	(can-afford-building mining-camp)
	(or
		(not (up-can-build 0 c: mining-camp))
		(not (up-can-build-line 0 gl-migration-build-x c: mining-camp))
	)
=>
	(up-chat-data-to-self "migration rejected mining point: %d" g: gl-island-migration-placement-attempts)
	(up-modify-goal gl-island-migration-placement-attempts c:+ 1)
	(up-set-timer c: t-island-migration c: 1)
	(set-goal gl-island-migration-state MIGRATION-VALIDATE-DROPSITE-ANCHOR)
)

(defrule
	(goal gl-island-migration-state MIGRATION-ISSUE-DROPSITE)
	(or
		(goal gl-island-migration-anchor-class gold-mine-class)
		(goal gl-island-migration-anchor-class stone-mine-class)
	)
	(up-compare-goal gl-island-migration-placement-attempts c:>= 3)
	(can-afford-building mining-camp)
	(or
		(not (up-can-build 0 c: mining-camp))
		(not (up-can-build-line 0 gl-migration-build-x c: mining-camp))
	)
=>
	(up-chat-data-to-self "migration rejected mining point: %d" g: gl-island-migration-placement-attempts)
	(set-goal gl-island-migration-state MIGRATION-DROPSITE-FAILED)
)

(defrule
	(goal gl-island-migration-state MIGRATION-ISSUE-DROPSITE)
	(goal gl-island-migration-anchor-class tree-class)
	(up-compare-goal gl-island-migration-placement-attempts c:< 3)
	(can-afford-building lumber-camp)
	(or
		(not (up-can-build 0 c: lumber-camp))
		(not (up-can-build-line 0 gl-migration-build-x c: lumber-camp))
	)
=>
	(up-chat-data-to-self "migration rejected lumber point: %d" g: gl-island-migration-placement-attempts)
	(up-modify-goal gl-island-migration-placement-attempts c:+ 1)
	(up-set-timer c: t-island-migration c: 1)
	(set-goal gl-island-migration-state MIGRATION-VALIDATE-DROPSITE-ANCHOR)
)

(defrule
	(goal gl-island-migration-state MIGRATION-ISSUE-DROPSITE)
	(goal gl-island-migration-anchor-class tree-class)
	(up-compare-goal gl-island-migration-placement-attempts c:>= 3)
	(can-afford-building lumber-camp)
	(or
		(not (up-can-build 0 c: lumber-camp))
		(not (up-can-build-line 0 gl-migration-build-x c: lumber-camp))
	)
=>
	(up-chat-data-to-self "migration rejected lumber point: %d" g: gl-island-migration-placement-attempts)
	(set-goal gl-island-migration-state MIGRATION-DROPSITE-FAILED)
)

(defrule
	(goal gl-island-migration-state MIGRATION-ISSUE-DROPSITE)
	(or
		(goal gl-island-migration-anchor-class forage-class)
		(goal gl-island-migration-anchor-class prey-animal-class)
	)
	(up-compare-goal gl-island-migration-placement-attempts c:< 3)
	(can-afford-building mill)
	(or
		(not (up-can-build 0 c: mill))
		(not (up-can-build-line 0 gl-migration-build-x c: mill))
	)
=>
	(up-chat-data-to-self "migration rejected mill point: %d" g: gl-island-migration-placement-attempts)
	(up-modify-goal gl-island-migration-placement-attempts c:+ 1)
	(up-set-timer c: t-island-migration c: 1)
	(set-goal gl-island-migration-state MIGRATION-VALIDATE-DROPSITE-ANCHOR)
)

(defrule
	(goal gl-island-migration-state MIGRATION-ISSUE-DROPSITE)
	(or
		(goal gl-island-migration-anchor-class forage-class)
		(goal gl-island-migration-anchor-class prey-animal-class)
	)
	(up-compare-goal gl-island-migration-placement-attempts c:>= 3)
	(can-afford-building mill)
	(or
		(not (up-can-build 0 c: mill))
		(not (up-can-build-line 0 gl-migration-build-x c: mill))
	)
=>
	(up-chat-data-to-self "migration rejected mill point: %d" g: gl-island-migration-placement-attempts)
	(set-goal gl-island-migration-state MIGRATION-DROPSITE-FAILED)
)

(defrule
	(goal gl-owner-worker-hold NO)
	(goal gl-island-migration-state MIGRATION-ISSUE-DROPSITE)
	(goal gl-island-migration-anchor-class tree-class)
	(up-pending-objects c: lumber-camp <= 0)
	(not (up-pending-placement c: lumber-camp))
	(up-can-build 0 c: lumber-camp)
	(up-can-build-line 0 gl-migration-build-x c: lumber-camp)
=>
	(up-copy-point gl-t12-drop-x gl-migration-build-x)
	(up-build-line gl-migration-build-x gl-migration-build-x c: lumber-camp)
	(set-goal gl-t12-drop-stage 1)
	(up-modify-goal gl-island-migration-placement-attempts c:+ 1)
	(up-chat-data-to-self "migration lumber camp attempt: %d" g: gl-island-migration-placement-attempts)
	(up-set-timer c: t-island-migration c: 20)
	(set-goal gl-island-migration-state MIGRATION-WAIT-DROPSITE)
)

(defrule
	(goal gl-owner-worker-hold NO)
	(goal gl-island-migration-state MIGRATION-ISSUE-DROPSITE)
	(or
		(goal gl-island-migration-anchor-class forage-class)
		(goal gl-island-migration-anchor-class prey-animal-class)
	)
	(up-pending-objects c: mill <= 0)
	(not (up-pending-placement c: mill))
	(up-can-build 0 c: mill)
	(up-can-build-line 0 gl-migration-build-x c: mill)
=>
	(up-copy-point gl-t12-drop-x gl-migration-build-x)
	(up-build-line gl-migration-build-x gl-migration-build-x c: mill)
	(set-goal gl-t12-drop-stage 1)
	(up-modify-goal gl-island-migration-placement-attempts c:+ 1)
	(up-chat-data-to-self "migration mill attempt: %d" g: gl-island-migration-placement-attempts)
	(up-set-timer c: t-island-migration c: 20)
	(set-goal gl-island-migration-state MIGRATION-WAIT-DROPSITE)
)

(defrule
	(goal gl-island-migration-state MIGRATION-ISSUE-DROPSITE)
	(or
		(goal gl-island-migration-anchor-class gold-mine-class)
		(goal gl-island-migration-anchor-class stone-mine-class)
	)
	(not (can-afford-building mining-camp))
=>
	(up-chat-data-to-self "migration mining camp resource wait: %d" g: gl-island-migration-zone)
	(up-set-timer c: t-island-migration c: 60)
	(set-goal gl-island-migration-state MIGRATION-WAIT-DROPSITE-RESOURCES)
)

(defrule
	(goal gl-island-migration-state MIGRATION-ISSUE-DROPSITE)
	(goal gl-island-migration-anchor-class tree-class)
	(not (can-afford-building lumber-camp))
=>
	(up-chat-data-to-self "migration lumber camp resource wait: %d" g: gl-island-migration-zone)
	(up-set-timer c: t-island-migration c: 60)
	(set-goal gl-island-migration-state MIGRATION-WAIT-DROPSITE-RESOURCES)
)

(defrule
	(goal gl-island-migration-state MIGRATION-ISSUE-DROPSITE)
	(or
		(goal gl-island-migration-anchor-class forage-class)
		(goal gl-island-migration-anchor-class prey-animal-class)
	)
	(not (can-afford-building mill))
=>
	(up-chat-data-to-self "migration mill resource wait: %d" g: gl-island-migration-zone)
	(up-set-timer c: t-island-migration c: 60)
	(set-goal gl-island-migration-state MIGRATION-WAIT-DROPSITE-RESOURCES)
)

;A temporary resource shortage keeps the reserved builders and hull together.
;Resume the same point as soon as its matching building becomes affordable.
(defrule
	(goal gl-island-migration-state MIGRATION-WAIT-DROPSITE-RESOURCES)
	(or
		(goal gl-island-migration-anchor-class gold-mine-class)
		(goal gl-island-migration-anchor-class stone-mine-class)
	)
	(can-build-with-escrow mining-camp)
=>
	(release-escrow wood)
	(up-set-timer c: t-island-migration c: 120)
	(set-goal gl-island-migration-state MIGRATION-VALIDATE-DROPSITE-ANCHOR)
)

(defrule
	(goal gl-island-migration-state MIGRATION-WAIT-DROPSITE-RESOURCES)
	(goal gl-island-migration-anchor-class tree-class)
	(can-build-with-escrow lumber-camp)
=>
	(release-escrow wood)
	(up-set-timer c: t-island-migration c: 120)
	(set-goal gl-island-migration-state MIGRATION-VALIDATE-DROPSITE-ANCHOR)
)

(defrule
	(goal gl-island-migration-state MIGRATION-WAIT-DROPSITE-RESOURCES)
	(or
		(goal gl-island-migration-anchor-class forage-class)
		(goal gl-island-migration-anchor-class prey-animal-class)
	)
	(can-build-with-escrow mill)
=>
	(release-escrow wood)
	(up-set-timer c: t-island-migration c: 120)
	(set-goal gl-island-migration-state MIGRATION-VALIDATE-DROPSITE-ANCHOR)
)

(defrule
	(goal gl-island-migration-state MIGRATION-WAIT-DROPSITE-RESOURCES)
	(up-timer-status t-island-migration == timer-triggered)
=>
	(set-goal gl-island-migration-state MIGRATION-DROPSITE-FAILED)
)

;A global pending count is not proof that the remote request succeeded. Find
;a concrete matching foundation near the issued point AND resource anchor.
;An asynchronous/global pending indication must not trigger an immediate recall.
(load "rawai-dropsite-diag")

(defrule
	(goal gl-island-migration-state MIGRATION-WAIT-DROPSITE)
	(or
		(goal gl-island-migration-anchor-class gold-mine-class)
		(goal gl-island-migration-anchor-class stone-mine-class)
	)
=>
	(set-strategic-number sn-focus-player-number my-player-number)
	(up-full-reset-search)
	(up-set-target-point gl-migration-build-x)
	(up-filter-distance c: -1 c: 8)
	(up-filter-status c: status-pending c: list-active)
	(up-find-status-local c: mining-camp c: 8)
	(up-remove-objects search-local object-data-player != my-player-number)
	(up-remove-objects search-local object-data-map-zone-id g:!= gl-island-migration-zone)
	(up-set-target-point gl-island-migration-target-x)
	(up-remove-objects search-local object-data-distance > 8)
	(up-clean-search search-local object-data-distance search-order-asc)
	(set-goal gl-island-migration-state MIGRATION-FIND-DROPSITE)
)

(defrule
	(goal gl-island-migration-state MIGRATION-WAIT-DROPSITE)
	(goal gl-island-migration-anchor-class tree-class)
=>
	(set-strategic-number sn-focus-player-number my-player-number)
	(up-full-reset-search)
	(up-set-target-point gl-migration-build-x)
	(up-filter-distance c: -1 c: 8)
	(up-filter-status c: status-pending c: list-active)
	(up-find-status-local c: lumber-camp c: 8)
	(up-remove-objects search-local object-data-player != my-player-number)
	(up-remove-objects search-local object-data-map-zone-id g:!= gl-island-migration-zone)
	(up-set-target-point gl-island-migration-target-x)
	(up-remove-objects search-local object-data-distance > 8)
	(up-clean-search search-local object-data-distance search-order-asc)
	(set-goal gl-island-migration-state MIGRATION-FIND-DROPSITE)
)

(defrule
	(goal gl-island-migration-state MIGRATION-WAIT-DROPSITE)
	(or
		(goal gl-island-migration-anchor-class forage-class)
		(goal gl-island-migration-anchor-class prey-animal-class)
	)
=>
	(set-strategic-number sn-focus-player-number my-player-number)
	(up-full-reset-search)
	(up-set-target-point gl-migration-build-x)
	(up-filter-distance c: -1 c: 8)
	(up-filter-status c: status-pending c: list-active)
	(up-find-status-local c: mill c: 8)
	(up-remove-objects search-local object-data-player != my-player-number)
	(up-remove-objects search-local object-data-map-zone-id g:!= gl-island-migration-zone)
	(up-set-target-point gl-island-migration-target-x)
	(up-remove-objects search-local object-data-distance > 8)
	(up-clean-search search-local object-data-distance search-order-asc)
	(set-goal gl-island-migration-state MIGRATION-FIND-DROPSITE)
)

(defrule
	(goal gl-island-migration-state MIGRATION-FIND-DROPSITE)
	(up-set-target-object search-local c: 0)
=>
	(set-goal gl-island-migration-state MIGRATION-ASSIGN-DROPSITE)
)

(defrule
	(goal gl-island-migration-state MIGRATION-FIND-DROPSITE)
	(not (up-set-target-object search-local c: 0))
=>
	;Keep the original 20-second deadline; four offsets remain the hard bound.
	(set-goal gl-island-migration-state MIGRATION-WAIT-DROPSITE)
)

(defrule
	(goal gl-island-migration-state MIGRATION-ASSIGN-DROPSITE)
	(up-set-target-object search-local c: 0)
=>
	(up-get-object-data object-data-id gl-island-migration-dropsite-id)
	(up-full-reset-search)
	(up-set-target-point gl-island-migration-target-x)
	(up-set-group search-local c: migration-boarding-group)
	(up-remove-objects search-local object-data-garrisoned == 1)
	(up-remove-objects search-local object-data-map-zone-id g:!= gl-island-migration-zone)
	(up-clean-search search-local object-data-distance search-order-asc)
	(up-add-object-by-id search-remote g: gl-island-migration-dropsite-id)
	;OWNERSHIP command: migration-boarding-group.
	(up-remove-objects search-local object-data-player != my-player-number)
	(up-remove-objects search-local object-data-group-flag != migration-boarding-group)
	(up-target-objects 0 action-default -1 stance-no-attack)
	(up-chat-data-to-self "migration dropsite builders assigned: %d" g: gl-island-migration-dropsite-id)
	(up-set-timer c: t-island-migration c: 120)
	(set-goal gl-island-migration-state MIGRATION-CONFIRM-DROPSITE)
)

(defrule
	(goal gl-island-migration-state MIGRATION-ASSIGN-DROPSITE)
	(not (up-set-target-object search-local c: 0))
=>
	(set-goal gl-island-migration-state MIGRATION-WAIT-DROPSITE)
)

(defrule
	(goal gl-island-migration-state MIGRATION-CONFIRM-DROPSITE)
=>
	(up-full-reset-search)
	(up-add-object-by-id search-local g: gl-island-migration-dropsite-id)
	(set-goal gl-island-migration-state MIGRATION-CHECK-DROPSITE)
)

(defrule
	(goal gl-island-migration-state MIGRATION-CHECK-DROPSITE)
	(up-set-target-object search-local c: 0)
	(up-object-data object-data-status == status-pending)
=>
	(set-goal gl-island-migration-state MIGRATION-CONFIRM-DROPSITE)
)

(defrule
	(goal gl-island-migration-state MIGRATION-CHECK-DROPSITE)
	(up-set-target-object search-local c: 0)
	(up-object-data object-data-status == status-ready)
=>
	(up-chat-data-to-self "migration dropsite complete: %d" g: gl-island-migration-dropsite-id)
	(up-modify-goal gl-island-colony-x g:= gl-island-migration-target-x)
	(up-modify-goal gl-island-colony-y g:= gl-island-migration-target-y)
	(up-modify-goal gl-island-colony-zone g:= gl-island-migration-zone)
	(set-goal gl-colony-towncenter-id -1)
	(set-goal gl-island-colony-established YES)
	(set-goal gl-island-migration-rejected-zone -1)
	(set-goal gl-island-migration-rejected-zone2 -1)
	(set-goal gl-island-migration-rejected-zone3 -1)
	(set-goal gl-island-migration-rejection-armed NO)
	(set-goal gl-island-migration-placement-attempts 0)
	;The builders have just completed their drop site. Retain ownership long
	;enough to revalidate the resource and give the settlers a final gather
	;order; releasing them here left successful colonies standing idle.
	(set-goal gl-island-migration-state MIGRATION-RETASK-DROPSITE)
)

(defrule
	(goal gl-island-migration-state MIGRATION-RETASK-DROPSITE)
=>
	(set-strategic-number sn-focus-player-number 0)
	(up-full-reset-search)
	(up-add-object-by-id search-remote g: gl-island-migration-anchor-id)
	(set-goal gl-island-migration-state MIGRATION-CHECK-RETASK-ANCHOR)
)

(defrule
	(goal gl-island-migration-state MIGRATION-CHECK-RETASK-ANCHOR)
	(up-set-target-object search-remote c: 0)
	(up-object-data object-data-class g:== gl-island-migration-anchor-class)
	(up-object-data object-data-map-zone-id g:== gl-island-migration-zone)
=>
	(up-get-point position-object gl-island-migration-target-x)
	(up-modify-sn sn-focus-player-number g:= gl-island-migration-focus)
	(set-goal gl-island-migration-state MIGRATION-ASSIGN-RETASK-ANCHOR)
)

(defrule
	(goal gl-island-migration-state MIGRATION-CHECK-RETASK-ANCHOR)
	(up-set-target-object search-remote c: 0)
	(or
		(up-object-data object-data-class g:!= gl-island-migration-anchor-class)
		(up-object-data object-data-map-zone-id g:!= gl-island-migration-zone)
	)
=>
	(set-goal gl-island-migration-state MIGRATION-REFRESH-RETASK-ANCHOR)
)

(defrule
	(goal gl-island-migration-state MIGRATION-CHECK-RETASK-ANCHOR)
	(not (up-set-target-object search-remote c: 0))
=>
	(set-goal gl-island-migration-state MIGRATION-REFRESH-RETASK-ANCHOR)
)

(defrule
	(goal gl-island-migration-state MIGRATION-REFRESH-RETASK-ANCHOR)
=>
	;The original node can expire while the camp is built. Refresh only the same
	;resource class near the completed colony and consume the list next sweep.
	(set-strategic-number sn-focus-player-number 0)
	(up-full-reset-search)
	(up-set-target-point gl-island-migration-target-x)
	(up-filter-distance c: -1 c: 16)
	(up-find-remote g: gl-island-migration-anchor-class c: 20)
	(up-remove-objects search-remote object-data-map-zone-id g:!= gl-island-migration-zone)
	(up-clean-search search-remote object-data-distance search-order-asc)
	(set-goal gl-island-migration-state MIGRATION-CHECK-RETASK-REFRESH)
)

(defrule
	(goal gl-island-migration-state MIGRATION-CHECK-RETASK-REFRESH)
	(up-set-target-object search-remote c: 0)
	(up-object-data object-data-class g:== gl-island-migration-anchor-class)
	(up-object-data object-data-map-zone-id g:== gl-island-migration-zone)
=>
	(up-get-object-data object-data-id gl-island-migration-anchor-id)
	(up-get-point position-object gl-island-migration-target-x)
	(up-chat-data-to-self "migration refreshed post-build resource: %d" g: gl-island-migration-anchor-id)
	(up-modify-sn sn-focus-player-number g:= gl-island-migration-focus)
	(set-goal gl-island-migration-state MIGRATION-ASSIGN-RETASK-ANCHOR)
)

(defrule
	(goal gl-island-migration-state MIGRATION-CHECK-RETASK-REFRESH)
	(not (up-set-target-object search-remote c: 0))
=>
	(up-chat-data-to-self "migration post-build resource exhausted: %d" g: gl-island-migration-anchor-class)
	(up-modify-sn sn-focus-player-number g:= gl-island-migration-focus)
	(set-goal gl-island-migration-state MIGRATION-RELEASE-COLONY)
)

(defrule
	(goal gl-island-migration-state MIGRATION-CHECK-RETASK-REFRESH)
	(up-set-target-object search-remote c: 0)
	(or
		(up-object-data object-data-class g:!= gl-island-migration-anchor-class)
		(up-object-data object-data-map-zone-id g:!= gl-island-migration-zone)
	)
=>
	(up-chat-data-to-self "migration post-build refresh invalid: %d" g: gl-island-migration-zone)
	(up-modify-sn sn-focus-player-number g:= gl-island-migration-focus)
	(set-goal gl-island-migration-state MIGRATION-RELEASE-COLONY)
)

(defrule
	(goal gl-island-migration-state MIGRATION-ASSIGN-RETASK-ANCHOR)
=>
	(set-strategic-number sn-focus-player-number my-player-number)
	(up-full-reset-search)
	(up-set-target-point gl-island-migration-target-x)
	(up-set-group search-local c: migration-boarding-group)
	(up-remove-objects search-local object-data-garrisoned == 1)
	(up-remove-objects search-local object-data-map-zone-id g:!= gl-island-migration-zone)
	(up-clean-search search-local object-data-distance search-order-asc)
	(up-get-search-state local-total)
	(set-strategic-number sn-focus-player-number 0)
	(up-add-object-by-id search-remote g: gl-island-migration-anchor-id)
	;OWNERSHIP command: migration-boarding-group.
	(up-remove-objects search-local object-data-player != my-player-number)
	(up-remove-objects search-local object-data-group-flag != migration-boarding-group)
	(up-target-objects 0 action-default -1 stance-no-attack)
	(up-chat-data-to-self "migration settlers retasked: %d" g: local-total)
	(up-modify-sn sn-focus-player-number g:= gl-island-migration-focus)
	(set-goal gl-island-migration-state MIGRATION-RELEASE-COLONY)
)

(defrule
	(goal gl-island-migration-state MIGRATION-RELEASE-COLONY)
=>
	(set-goal gl-migration-placement-lock NO)
	(up-modify-group-flag 0 c: migration-boarding-group)
	(up-reset-group c: migration-boarding-group)
	(set-strategic-number sn-focus-player-number my-player-number)
	(up-full-reset-search)
	(up-add-object-by-id search-local g: gl-island-migration-transport-id)
	;OWNERSHIP command: migration-transport-group.
	(up-remove-objects search-local object-data-player != my-player-number)
	(up-remove-objects search-local object-data-group-flag != migration-transport-group)
	(up-target-point gl-island-migration-origin-x action-move -1 stance-no-attack)
	(up-modify-sn sn-focus-player-number g:= gl-island-migration-focus)
	(up-set-timer c: t-island-migration c: 60)
	(set-goal gl-island-migration-state MIGRATION-IDLE)
)

(defrule
	(goal gl-island-migration-state MIGRATION-CHECK-DROPSITE)
	(up-set-target-object search-local c: 0)
	(up-object-data object-data-status != status-pending)
	(up-object-data object-data-status != status-ready)
=>
	(up-chat-data-to-self "migration dropsite inactive: %d" g: gl-island-migration-dropsite-id)
	(set-goal gl-island-migration-state MIGRATION-DROPSITE-FAILED)
)

(defrule
	(goal gl-island-migration-state MIGRATION-CHECK-DROPSITE)
	(not (up-set-target-object search-local c: 0))
=>
	(up-chat-data-to-self "migration dropsite foundation lost: %d" g: gl-island-migration-dropsite-id)
	(set-goal gl-island-migration-state MIGRATION-DROPSITE-FAILED)
)

(defrule
	(goal gl-island-migration-state MIGRATION-WAIT-DROPSITE)
	(up-timer-status t-island-migration == timer-triggered)
	(up-compare-goal gl-island-migration-placement-attempts c:> 0)
	(up-compare-goal gl-island-migration-placement-attempts c:< 4)
	(goal gl-island-migration-point-retry-used NO)
	(goal gl-owner-worker-hold NO)
	(up-pending-objects c: mining-camp <= 0)
	(up-pending-objects c: lumber-camp <= 0)
	(up-pending-objects c: mill <= 0)
	(not (up-pending-placement c: mining-camp))
	(not (up-pending-placement c: lumber-camp))
	(not (up-pending-placement c: mill))
=>
	;T25's first exact (131,199) request vanished with no pending placement or
	;foundation, while the same point succeeded on the next migration. Retry the
	;last engine-accepted point once before advancing to geometrically different
	;offsets. The one-shot token and original four-offset bound prevent a loop.
	(up-reset-placement c: mining-camp)
	(up-reset-placement c: lumber-camp)
	(up-reset-placement c: mill)
	(set-goal gl-island-migration-point-retry-used YES)
	(up-modify-goal gl-island-migration-placement-attempts c:- 1)
	(up-set-timer c: t-island-migration c: 1)
	(set-goal gl-island-migration-state MIGRATION-VALIDATE-DROPSITE-ANCHOR)
)

(defrule
	(goal gl-island-migration-state MIGRATION-WAIT-DROPSITE)
	(up-timer-status t-island-migration == timer-triggered)
	(up-compare-goal gl-island-migration-placement-attempts c:< 4)
=>
	(up-reset-placement c: mining-camp)
	(up-reset-placement c: lumber-camp)
	(up-reset-placement c: mill)
	(up-set-timer c: t-island-migration c: 1)
	(set-goal gl-island-migration-state MIGRATION-VALIDATE-DROPSITE-ANCHOR)
)

(defrule
	(goal gl-island-migration-state MIGRATION-WAIT-DROPSITE)
	(up-timer-status t-island-migration == timer-triggered)
	(up-compare-goal gl-island-migration-placement-attempts c:>= 4)
=>
	(set-goal gl-island-migration-state MIGRATION-DROPSITE-FAILED)
)

(defrule
	(or
		(goal gl-island-migration-state MIGRATION-CONFIRM-DROPSITE)
		(goal gl-island-migration-state MIGRATION-CHECK-DROPSITE)
	)
	(up-timer-status t-island-migration == timer-triggered)
=>
	(up-chat-data-to-self "migration dropsite construction timeout: %d" g: gl-island-migration-dropsite-id)
	(set-goal gl-island-migration-state MIGRATION-DROPSITE-FAILED)
)

(defrule
	(goal gl-island-migration-state MIGRATION-DROPSITE-FAILED)
=>
	(set-goal gl-migration-placement-lock NO)
	(up-chat-data-to-self "migration dropsite failed: %d" g: gl-island-migration-zone)
	(up-modify-goal gl-island-migration-rejected-zone3 g:= gl-island-migration-rejected-zone2)
	(up-modify-goal gl-island-migration-rejected-zone2 g:= gl-island-migration-rejected-zone)
	(up-modify-goal gl-island-migration-rejected-zone g:= gl-island-migration-zone)
	(set-goal gl-island-migration-rejection-armed NO)
	(up-reset-placement c: mining-camp)
	(up-reset-placement c: lumber-camp)
	(up-reset-placement c: mill)
	(set-goal gl-island-migration-placement-attempts 0)
	(set-strategic-number sn-focus-player-number my-player-number)
	(up-full-reset-search)
	(up-set-target-point gl-island-migration-target-x)
	(up-set-group search-local c: migration-boarding-group)
	(up-remove-objects search-local object-data-garrisoned == 1)
	(up-remove-objects search-local object-data-map-zone-id g:!= gl-island-migration-zone)
	(up-clean-search search-local object-data-distance search-order-asc)
	(up-get-search-state local-total)
	(up-modify-goal gl-island-migration-load-target g:= local-total)
	(up-add-object-by-id search-remote g: gl-island-migration-transport-id)
	(up-remove-objects search-remote object-data-player != my-player-number)
	(up-remove-objects search-remote object-data-group-flag != migration-transport-group)
	;OWNERSHIP command: migration-boarding-group.
	(up-remove-objects search-local object-data-player != my-player-number)
	(up-remove-objects search-local object-data-group-flag != migration-boarding-group)
	(up-target-objects 0 action-garrison -1 stance-no-attack)
	(up-set-timer c: t-island-migration c: 45)
	(set-goal gl-island-migration-state MIGRATION-RECALL-LOADING)
)

(defrule
	(goal gl-island-migration-state MIGRATION-RECALL-LOADING)
	(up-compare-goal gl-island-migration-load-target c:< 1)
=>
	(up-modify-group-flag 0 c: migration-boarding-group)
	(up-reset-group c: migration-boarding-group)
	(up-full-reset-search)
	(up-add-object-by-id search-local g: gl-island-migration-transport-id)
	;OWNERSHIP command: migration-transport-group.
	(up-remove-objects search-local object-data-player != my-player-number)
	(up-remove-objects search-local object-data-group-flag != migration-transport-group)
	(up-target-point gl-island-migration-origin-x action-move -1 stance-no-attack)
	(up-modify-sn sn-focus-player-number g:= gl-island-migration-focus)
	(up-set-timer c: t-island-migration c: 60)
	(set-goal gl-island-migration-state MIGRATION-IDLE)
)

(defrule
	(goal gl-island-migration-state MIGRATION-RECALL-LOADING)
	(up-compare-goal gl-island-migration-load-target c:>= 1)
=>
	(up-full-reset-search)
	(up-add-object-by-id search-local g: gl-island-migration-transport-id)
	(set-goal gl-island-migration-state MIGRATION-RECALL-CHECK)
)

(defrule
	(goal gl-island-migration-state MIGRATION-RECALL-CHECK)
	(up-set-target-object search-local c: 0)
	(up-object-data object-data-garrison-count g:>= gl-island-migration-load-target)
=>
	;OWNERSHIP command: migration-transport-group.
	(up-remove-objects search-local object-data-player != my-player-number)
	(up-remove-objects search-local object-data-group-flag != migration-transport-group)
	(up-target-point gl-home-anchor-x action-unload -1 stance-no-attack)
	(up-modify-sn sn-focus-player-number g:= gl-island-migration-focus)
	(set-goal gl-island-migration-route-waits 0)
	(up-set-timer c: t-island-migration c: 15)
	(set-goal gl-island-migration-state MIGRATION-RETURNING)
)

(defrule
	(goal gl-island-migration-state MIGRATION-RECALL-CHECK)
	(up-timer-status t-island-migration == timer-triggered)
	(up-set-target-object search-local c: 0)
	(up-object-data object-data-garrison-count > 0)
	(up-object-data object-data-garrison-count g:< gl-island-migration-load-target)
=>
	;OWNERSHIP command: migration-transport-group.
	(up-remove-objects search-local object-data-player != my-player-number)
	(up-remove-objects search-local object-data-group-flag != migration-transport-group)
	(up-target-point gl-home-anchor-x action-unload -1 stance-no-attack)
	(up-modify-sn sn-focus-player-number g:= gl-island-migration-focus)
	(set-goal gl-island-migration-route-waits 0)
	(up-set-timer c: t-island-migration c: 15)
	(set-goal gl-island-migration-state MIGRATION-RETURNING)
)

(defrule
	(goal gl-island-migration-state MIGRATION-RECALL-CHECK)
	(up-timer-status t-island-migration == timer-running)
	(up-set-target-object search-local c: 0)
	(up-object-data object-data-garrison-count g:< gl-island-migration-load-target)
=>
	(set-goal gl-island-migration-state MIGRATION-RECALL-LOADING)
)

(defrule
	(goal gl-island-migration-state MIGRATION-RECALL-CHECK)
	(up-timer-status t-island-migration == timer-triggered)
	(up-set-target-object search-local c: 0)
	(up-object-data object-data-garrison-count <= 0)
=>
	(up-chat-data-to-self "migration settler recall failed: %d" g: gl-island-migration-zone)
	(up-modify-group-flag 0 c: migration-boarding-group)
	(up-reset-group c: migration-boarding-group)
	;OWNERSHIP command: migration-transport-group.
	(up-remove-objects search-local object-data-player != my-player-number)
	(up-remove-objects search-local object-data-group-flag != migration-transport-group)
	(up-target-point gl-island-migration-origin-x action-move -1 stance-no-attack)
	(up-modify-sn sn-focus-player-number g:= gl-island-migration-focus)
	(up-set-timer c: t-island-migration c: 60)
	(set-goal gl-island-migration-state MIGRATION-IDLE)
)

(defrule
	(goal gl-island-migration-state MIGRATION-RECALL-CHECK)
	(not (up-set-target-object search-local c: 0))
=>
	(up-chat-data-to-self "migration recall transport lost: %d" g: gl-island-migration-transport-id)
	(up-modify-group-flag 0 c: migration-boarding-group)
	(up-reset-group c: migration-boarding-group)
	(up-modify-sn sn-focus-player-number g:= gl-island-migration-focus)
	(up-set-timer c: t-island-migration c: 60)
	(set-goal gl-island-migration-state MIGRATION-IDLE)
)

(defrule
	(goal gl-island-migration-state MIGRATION-TASK-MINING)
	(goal gl-island-migration-mission MIGRATION-MISSION-SCOUT)
=>
	(set-goal gl-island-migration-state MIGRATION-TASK-SCOUT)
)

(defrule
	(current-age < imperial-age)
	(goal gl-island-migration-state MIGRATION-TASK-SCOUT)
	(up-set-target-object search-local c: 0)
=>
	(set-strategic-number sn-focus-player-number 0)
	(up-full-reset-search)
	(up-set-target-point gl-island-migration-target-x)
	(up-find-remote c: tree-class c: 40)
	(up-find-remote c: forage-class c: 10)
	(up-find-remote c: prey-animal-class c: 10)
	(up-remove-objects search-remote object-data-map-zone-id g:!= gl-island-migration-zone)
	(up-clean-search search-remote object-data-distance search-order-desc)
	(set-goal gl-island-migration-state MIGRATION-FIND-SCOUT-PATROL)
)

(defrule
	(current-age < imperial-age)
	(goal gl-island-migration-state MIGRATION-TASK-SCOUT)
	(not (up-set-target-object search-local c: 0))
=>
	(up-chat-data-to-self "migration scout ownership lost: %d" g: gl-island-migration-zone)
	(up-modify-group-flag 0 c: migration-boarding-group)
	(up-reset-group c: migration-boarding-group)
	(up-full-reset-search)
	(up-add-object-by-id search-local g: gl-island-migration-transport-id)
	;OWNERSHIP command: migration-transport-group.
	(up-remove-objects search-local object-data-player != my-player-number)
	(up-remove-objects search-local object-data-group-flag != migration-transport-group)
	(up-target-point gl-island-migration-origin-x action-move -1 stance-no-attack)
	(up-modify-sn sn-focus-player-number g:= gl-island-migration-focus)
	(up-set-timer c: t-island-migration c: 60)
	(set-goal gl-island-migration-state MIGRATION-IDLE)
)

(defrule
	(current-age < imperial-age)
	(goal gl-island-migration-state MIGRATION-FIND-SCOUT-PATROL)
	(up-set-target-object search-remote c: 0)
=>
	(up-get-point position-object point2-x)
	(set-strategic-number sn-focus-player-number my-player-number)
	(up-full-reset-search)
	(up-set-target-point gl-island-migration-target-x)
	(up-set-group search-local c: migration-boarding-group)
	(up-remove-objects search-local object-data-garrisoned == 1)
	(up-remove-objects search-local object-data-map-zone-id g:!= gl-island-migration-zone)
	(up-clean-search search-local object-data-distance search-order-asc)
	(set-goal gl-island-migration-state MIGRATION-CONFIRM-SCOUT)
)

(defrule
	(current-age < imperial-age)
	(goal gl-island-migration-state MIGRATION-FIND-SCOUT-PATROL)
	(not (up-set-target-object search-remote c: 0))
=>
	(set-strategic-number sn-focus-player-number my-player-number)
	;A barren or still-dark land mass is exactly where a scout is useful. Patrol
	;across the landing neighborhood instead of issuing an unreachable command
	;toward the opposite side of the whole map.
	(up-copy-point point2-x gl-island-migration-target-x)
	(up-modify-goal point2-x c:+ 12)
	(up-modify-goal point2-y c:+ 12)
	(up-bound-point point3-x point2-x)
	(up-full-reset-search)
	(up-set-group search-local c: migration-boarding-group)
	(up-remove-objects search-local object-data-garrisoned == 1)
	(up-remove-objects search-local object-data-map-zone-id g:!= gl-island-migration-zone)
	(up-clean-search search-local object-data-distance search-order-asc)
	(set-goal gl-island-migration-state MIGRATION-CONFIRM-SCOUT-FALLBACK)
)

(defrule
	(current-age < imperial-age)
	(goal gl-island-migration-state MIGRATION-CONFIRM-SCOUT-FALLBACK)
	(up-set-target-object search-local c: 0)
=>
	;OWNERSHIP command: migration-boarding-group.
	(up-remove-objects search-local object-data-player != my-player-number)
	(up-remove-objects search-local object-data-group-flag != migration-boarding-group)
	(up-target-point point3-x action-patrol -1 stance-no-attack)
	(up-copy-point gl-island-scout-patrol-x point3-x)
	(up-modify-goal gl-island-scout-missions c:+ 1)
	(up-modify-goal gl-island-scout-visited-zone3 g:= gl-island-scout-visited-zone2)
	(up-modify-goal gl-island-scout-visited-zone2 g:= gl-island-scout-visited-zone)
	(up-modify-goal gl-island-scout-visited-zone g:= gl-island-migration-zone)
	(up-chat-data-to-self "migration scout fallback patrol: %d" g: gl-island-migration-zone)
	(up-full-reset-search)
	(up-add-object-by-id search-local g: gl-island-migration-transport-id)
	;OWNERSHIP command: migration-transport-group.
	(up-remove-objects search-local object-data-player != my-player-number)
	(up-remove-objects search-local object-data-group-flag != migration-transport-group)
	(up-target-point gl-island-migration-origin-x action-move -1 stance-no-attack)
	(up-modify-sn sn-focus-player-number g:= gl-island-migration-focus)
	(up-set-timer c: t-island-migration c: 15)
	(set-goal gl-island-migration-state MIGRATION-SCOUT-PATROL-WAIT)
)

(defrule
	(current-age < imperial-age)
	(goal gl-island-migration-state MIGRATION-CONFIRM-SCOUT)
	(up-set-target-object search-local c: 0)
=>
	;OWNERSHIP command: migration-boarding-group.
	(up-remove-objects search-local object-data-player != my-player-number)
	(up-remove-objects search-local object-data-group-flag != migration-boarding-group)
	(up-target-point point2-x action-patrol -1 stance-no-attack)
	(up-copy-point gl-island-scout-patrol-x point2-x)
	(up-modify-goal gl-island-scout-missions c:+ 1)
	(up-modify-goal gl-island-scout-visited-zone3 g:= gl-island-scout-visited-zone2)
	(up-modify-goal gl-island-scout-visited-zone2 g:= gl-island-scout-visited-zone)
	(up-modify-goal gl-island-scout-visited-zone g:= gl-island-migration-zone)
	(up-chat-data-to-self "migration scout landed: %d" g: gl-island-migration-zone)
	(up-full-reset-search)
	(up-add-object-by-id search-local g: gl-island-migration-transport-id)
	;OWNERSHIP command: migration-transport-group.
	(up-remove-objects search-local object-data-player != my-player-number)
	(up-remove-objects search-local object-data-group-flag != migration-transport-group)
	(up-target-point gl-island-migration-origin-x action-move -1 stance-no-attack)
	(up-modify-sn sn-focus-player-number g:= gl-island-migration-focus)
	(up-set-timer c: t-island-migration c: 15)
	(set-goal gl-island-migration-state MIGRATION-SCOUT-PATROL-WAIT)
)

(defrule
	(current-age < imperial-age)
	(goal gl-island-migration-state MIGRATION-SCOUT-PATROL-WAIT)
	(up-timer-status t-island-migration == timer-triggered)
=>
	(set-strategic-number sn-focus-player-number my-player-number)
	(up-full-reset-search)
	(up-set-target-point gl-island-scout-patrol-x)
	(up-set-group search-local c: migration-boarding-group)
	(up-remove-objects search-local object-data-garrisoned == 1)
	(up-clean-search search-local object-data-distance search-order-asc)
	(set-goal gl-island-migration-state MIGRATION-SCOUT-PATROL-CHECK)
)

(defrule
	(current-age < imperial-age)
	(goal gl-island-migration-state MIGRATION-SCOUT-PATROL-CHECK)
	(up-set-target-object search-local c: 0)
	(up-object-data object-data-distance <= 12)
=>
	(up-chat-data-to-self "migration scout patrol progress: %d" g: gl-island-migration-zone)
	(up-modify-group-flag 0 c: migration-boarding-group)
	(up-reset-group c: migration-boarding-group)
	(up-set-timer c: t-island-migration c: 60)
	(set-goal gl-island-migration-state MIGRATION-IDLE)
)

(defrule
	(current-age < imperial-age)
	(goal gl-island-migration-state MIGRATION-SCOUT-PATROL-CHECK)
	(up-set-target-object search-local c: 0)
	(up-object-data object-data-distance > 12)
=>
	;One different, bounded land point breaks gate/shoreline path stalls without
	;creating another unbounded patrol loop.
	(up-copy-point point3-x gl-island-migration-target-x)
	(up-modify-goal point3-x c:+ 10)
	(up-modify-goal point3-y c:- 10)
	(up-bound-point point4-x point3-x)
	;OWNERSHIP command: migration-boarding-group.
	(up-remove-objects search-local object-data-player != my-player-number)
	(up-remove-objects search-local object-data-group-flag != migration-boarding-group)
	(up-target-point point4-x action-move -1 stance-no-attack)
	(up-chat-data-to-self "migration scout patrol retry: %d" g: gl-island-migration-zone)
	(up-modify-group-flag 0 c: migration-boarding-group)
	(up-reset-group c: migration-boarding-group)
	(up-set-timer c: t-island-migration c: 60)
	(set-goal gl-island-migration-state MIGRATION-IDLE)
)

(defrule
	(current-age < imperial-age)
	(goal gl-island-migration-state MIGRATION-SCOUT-PATROL-CHECK)
	(not (up-set-target-object search-local c: 0))
=>
	(up-chat-data-to-self "migration scout patrol ownership lost: %d" g: gl-island-migration-zone)
	(up-modify-group-flag 0 c: migration-boarding-group)
	(up-reset-group c: migration-boarding-group)
	(up-set-timer c: t-island-migration c: 60)
	(set-goal gl-island-migration-state MIGRATION-IDLE)
)

(defrule
	(current-age < imperial-age)
	(or
		(goal gl-island-migration-state MIGRATION-CONFIRM-SCOUT)
		(goal gl-island-migration-state MIGRATION-CONFIRM-SCOUT-FALLBACK)
	)
	(not (up-set-target-object search-local c: 0))
=>
	(up-chat-data-to-self "migration scout wrong zone: %d" g: gl-island-migration-zone)
	(up-full-reset-search)
	(up-set-group search-local c: migration-boarding-group)
	(up-remove-objects search-local object-data-garrisoned == 1)
	;OWNERSHIP command: migration-boarding-group.
	(up-remove-objects search-local object-data-player != my-player-number)
	(up-remove-objects search-local object-data-group-flag != migration-boarding-group)
	; RAW12 counter 10
	(up-modify-goal gl-command-counter-10 c:+ 1)
	(up-target-point position-self-x action-stop -1 stance-no-attack)
	(up-modify-group-flag 0 c: migration-boarding-group)
	(up-reset-group c: migration-boarding-group)
	(up-full-reset-search)
	(up-add-object-by-id search-local g: gl-island-migration-transport-id)
	;OWNERSHIP command: migration-transport-group.
	(up-remove-objects search-local object-data-player != my-player-number)
	(up-remove-objects search-local object-data-group-flag != migration-transport-group)
	(up-target-point gl-island-migration-origin-x action-move -1 stance-no-attack)
	(up-modify-sn sn-focus-player-number g:= gl-island-migration-focus)
	(up-set-timer c: t-island-migration c: 60)
	(set-goal gl-island-migration-state MIGRATION-IDLE)
)

(defrule
	(goal gl-island-migration-state MIGRATION-CHECK-LANDING)
	(up-set-target-object search-local c: 0)
	(up-object-data object-data-garrison-count > 0)
	(up-timer-status t-island-migration == timer-running)
=>
	(set-goal gl-island-migration-state MIGRATION-SAILING)
)

;A loaded hull that did not unload at a validated shore remembers that local
;sector and advances the existing bounded lateral fan. It never falls back to
;the inland resource anchor plus four arbitrary two-tile offsets.
(defrule
	(goal gl-island-migration-state MIGRATION-CHECK-LANDING)
	(up-set-target-object search-local c: 0)
	(up-object-data object-data-garrison-count > 0)
	(up-timer-status t-island-migration == timer-triggered)
=>
	(up-set-timer c: t-island-migration c: 120)
	(set-goal gl-island-migration-state MIGRATION-SHORE-REMEMBER)
)

;Rebuild the exact mission hull and candidate in the same state sequence. The
;path query uses option 0 intentionally: unload targets can be on land, so the
;water unit must be able to reach an open tile within the engine's allowed
;separation rather than occupy the destination tile itself.
(defrule
	(goal gl-island-migration-state MIGRATION-CHECK-LANDING-PATH)
=>
	(set-strategic-number sn-focus-player-number my-player-number)
	(up-full-reset-search)
	(up-set-target-point gl-island-migration-route-waypoint-x)
	(up-get-point-zone gl-island-migration-route-waypoint-x gl-island-migration-landing-zone)
	(up-add-object-by-id search-local g: gl-island-migration-transport-id)
)

(defrule
	(goal gl-island-migration-state MIGRATION-CHECK-LANDING-PATH)
	(up-compare-goal gl-island-migration-landing-zone g:== gl-island-migration-zone)
	(up-set-target-object search-local c: 0)
	(up-path-distance gl-island-migration-route-waypoint-x 0 != 65535)
=>
	;OWNERSHIP command: migration-transport-group.
	(up-remove-objects search-local object-data-player != my-player-number)
	(up-remove-objects search-local object-data-group-flag != migration-transport-group)
	(up-target-point gl-island-migration-route-waypoint-x action-unload -1 stance-no-attack)
	(up-chat-data-to-all "RAW44M landing path clear hull: %d" g: gl-island-migration-transport-id)
	(up-chat-data-to-all "RAW44M landing candidate: %d" g: gl-island-migration-landing-attempts)
	(up-modify-sn sn-focus-player-number g:= gl-island-migration-focus)
	(up-set-timer c: t-island-migration c: 20)
	(set-goal gl-island-migration-state MIGRATION-SAILING)
)

(defrule
	(goal gl-island-migration-state MIGRATION-CHECK-LANDING-PATH)
	(up-compare-goal gl-island-migration-landing-zone g:!= gl-island-migration-zone)
	(up-set-target-object search-local c: 0)
=>
	(up-chat-data-to-all "RAW44M landing wrong zone hull: %d" g: gl-island-migration-transport-id)
	(up-chat-data-to-all "RAW44M wrong-zone candidate: %d" g: gl-island-migration-landing-attempts)
	(up-chat-data-to-all "RAW44M wrong-zone actual: %d" g: gl-island-migration-landing-zone)
	(up-chat-data-to-all "RAW44M wrong-zone expected: %d" g: gl-island-migration-zone)
	(up-modify-sn sn-focus-player-number g:= gl-island-migration-focus)
	(up-set-timer c: t-island-migration c: 120)
	(set-goal gl-island-migration-state MIGRATION-SHORE-REMEMBER)
)

(defrule
	(goal gl-island-migration-state MIGRATION-CHECK-LANDING-PATH)
	(up-compare-goal gl-island-migration-landing-zone g:== gl-island-migration-zone)
	(up-set-target-object search-local c: 0)
	(up-path-distance gl-island-migration-route-waypoint-x 0 == 65535)
=>
	(up-chat-data-to-all "RAW44M landing path rejected hull: %d" g: gl-island-migration-transport-id)
	(up-chat-data-to-all "RAW44M rejected candidate: %d" g: gl-island-migration-landing-attempts)
	(up-chat-data-to-all "RAW44M rejected x: %d" g: gl-island-migration-route-waypoint-x)
	(up-chat-data-to-all "RAW44M rejected y: %d" g: gl-island-migration-route-waypoint-y)
	(up-modify-sn sn-focus-player-number g:= gl-island-migration-focus)
	(up-set-timer c: t-island-migration c: 120)
	(set-goal gl-island-migration-state MIGRATION-SHORE-REMEMBER)
)

(defrule
	(goal gl-island-migration-state MIGRATION-CHECK-LANDING-PATH)
	(not (up-set-target-object search-local c: 0))
=>
	(up-chat-data-to-all "RAW44M landing path hull missing: %d" g: gl-island-migration-transport-id)
	(up-set-timer c: t-island-migration c: 120)
	(set-goal gl-island-migration-state MIGRATION-SHORE-EXHAUSTED)
)

(defrule
	(goal gl-island-migration-state MIGRATION-CHECK-LANDING)
	(not (up-set-target-object search-local c: 0))
=>
	(up-chat-data-to-self "migration transport missing: %d" g: gl-island-migration-transport-id)
	(up-full-reset-search)
	(up-set-group search-local c: migration-boarding-group)
	(up-remove-objects search-local object-data-garrisoned == 1)
	;OWNERSHIP command: migration-boarding-group.
	(up-remove-objects search-local object-data-player != my-player-number)
	(up-remove-objects search-local object-data-group-flag != migration-boarding-group)
	; RAW12 counter 11
	(up-modify-goal gl-command-counter-11 c:+ 1)
	(up-target-point position-self-x action-stop -1 stance-no-attack)
	(up-modify-group-flag 0 c: migration-boarding-group)
	(up-reset-group c: migration-boarding-group)
	(up-modify-sn sn-focus-player-number g:= gl-island-migration-focus)
	(up-set-timer c: t-island-migration c: 60)
	(set-goal gl-island-migration-state MIGRATION-IDLE)
)

;Resolve every otherwise uncovered timeout against the exact reserved hull.
;Never publish IDLE merely because an asynchronous unload command was issued:
;the transport group remains owned until a later object check proves it empty.
(defrule
	(up-timer-status t-island-migration == timer-triggered)
	(not (goal gl-island-migration-state MIGRATION-IDLE))
=>
	(set-goal gl-migration-placement-lock NO)
	(up-chat-data-to-self "migration timeout state: %d" g: gl-island-migration-state)
	(set-strategic-number sn-focus-player-number my-player-number)
	(up-full-reset-search)
	(up-set-group search-local c: migration-boarding-group)
	(up-remove-objects search-local object-data-garrisoned == 1)
	;OWNERSHIP command: migration-boarding-group.
	(up-remove-objects search-local object-data-player != my-player-number)
	(up-remove-objects search-local object-data-group-flag != migration-boarding-group)
	; RAW12 counter 12
	(up-modify-goal gl-command-counter-12 c:+ 1)
	(up-target-point position-self-x action-stop -1 stance-no-attack)
	(up-full-reset-search)
	(up-add-object-by-id search-local g: gl-island-migration-transport-id)
	;OWNERSHIP command: migration-transport-group.
	(up-remove-objects search-local object-data-player != my-player-number)
	(up-remove-objects search-local object-data-group-flag != migration-transport-group)
	(up-target-point gl-home-anchor-x action-unload -1 stance-no-attack)
	(up-modify-sn sn-focus-player-number g:= gl-island-migration-focus)
	(up-set-timer c: t-island-migration c: 15)
	(set-goal gl-island-migration-state MIGRATION-RETURNING)
)

;Release the hull only after every migration terminal path has returned to
;IDLE.  The explicit group flag keeps other direct-control selectors from
;claiming the same Transport Ship while passengers are boarding or sailing.
(defrule
	(goal gl-island-migration-state MIGRATION-IDLE)
	(up-compare-goal gl-island-migration-transport-id c:>= 0)
=>
	(up-modify-group-flag 0 c: migration-boarding-group)
	(up-reset-group c: migration-boarding-group)
	(up-modify-group-flag 0 c: migration-transport-group)
	(up-reset-group c: migration-transport-group)
	(set-goal gl-island-migration-transport-id -1)
)

;Return empty damaged transports to the nearest naval production site and use
;idle villagers for repairs. Repairers keep working to full health after the
;initial order, while the 75 percent threshold avoids wasteful minor repairs.
(defrule
	(up-timer-status t-transport-repair == timer-triggered)
	(goal gl-transport-repair-state TRANSPORT-REPAIR-IDLE)
	(goal gl-island-migration-state MIGRATION-IDLE)
	(goal gl-transport-route-state TRANSPORT-ROUTE-IDLE)
	(goal gl-transport-recovery-state TRANSPORT-RECOVERY-IDLE)
	(goal gl-relic-ferry-state RELIC-FERRY-IDLE)
	(goal gl-transport-clear-state TRANSPORT-CLEAR-IDLE)
	(wood-amount > 80)
	(up-idle-unit-count idle-type-villager >= 1)
	(unit-type-count transport-ship >= 1)
=>
	(up-modify-goal gl-transport-repair-focus s:= sn-focus-player-number)
	(set-strategic-number sn-focus-player-number my-player-number)
	(up-full-reset-search)
	(up-find-local c: transport-ship c: 5)
	(up-remove-objects search-local object-data-id g:== gl-quarantine-transport-id)
	(up-remove-objects search-local object-data-garrison-count > 0)
	(up-remove-objects search-local object-data-under-attack > 0)
	(up-clean-search search-local object-data-hitpoints search-order-asc)
	(up-set-timer c: t-transport-repair c: 30)
	(set-goal gl-transport-repair-state TRANSPORT-REPAIR-ASSESS)
)

(defrule
	(goal gl-transport-repair-state TRANSPORT-REPAIR-ASSESS)
	(up-set-target-object search-local c: 0)
=>
	(up-get-object-data object-data-id gl-transport-repair-id)
	(up-get-object-data object-data-hitpoints gl-transport-repair-hp)
	(up-get-object-data object-data-maxhp gl-transport-repair-maxhp)
	(up-get-point position-object point-x)
	(up-modify-goal gl-transport-repair-percent g:= gl-transport-repair-hp)
	(up-modify-goal gl-transport-repair-percent c:* 100)
	(up-modify-goal gl-transport-repair-percent g:/ gl-transport-repair-maxhp)
	(set-goal gl-transport-repair-state TRANSPORT-REPAIR-FIND-PORT)
)

(defrule
	(goal gl-transport-repair-state TRANSPORT-REPAIR-ASSESS)
	(not (up-set-target-object search-local c: 0))
=>
	(up-modify-sn sn-focus-player-number g:= gl-transport-repair-focus)
	(set-goal gl-transport-repair-state TRANSPORT-REPAIR-IDLE)
)

(defrule
	(goal gl-transport-repair-state TRANSPORT-REPAIR-FIND-PORT)
	(up-compare-goal gl-transport-repair-percent >= 75)
=>
	(up-modify-sn sn-focus-player-number g:= gl-transport-repair-focus)
	(set-goal gl-transport-repair-state TRANSPORT-REPAIR-IDLE)
)

(defrule
	(goal gl-transport-repair-state TRANSPORT-REPAIR-FIND-PORT)
	(up-compare-goal gl-transport-repair-percent < 75)
=>
	(up-full-reset-search)
	(up-set-target-point point-x)
	(up-find-local c: port c: 10)
	(up-find-local c: shipyard c: 10)
	(up-clean-search search-local object-data-distance search-order-asc)
)

(defrule
	(goal gl-transport-repair-state TRANSPORT-REPAIR-FIND-PORT)
	(up-compare-goal gl-transport-repair-percent < 75)
	(up-set-target-object search-local c: 0)
=>
	(up-get-point position-object point3-x)
	(set-goal gl-transport-repair-state TRANSPORT-REPAIR-MOVE)
)

(defrule
	(goal gl-transport-repair-state TRANSPORT-REPAIR-FIND-PORT)
	(up-compare-goal gl-transport-repair-percent < 75)
	(not (up-set-target-object search-local c: 0))
=>
	(up-modify-sn sn-focus-player-number g:= gl-transport-repair-focus)
	(set-goal gl-transport-repair-state TRANSPORT-REPAIR-IDLE)
)

(defrule
	(goal gl-transport-repair-state TRANSPORT-REPAIR-MOVE)
=>
	(up-full-reset-search)
	(up-add-object-by-id search-local g: gl-transport-repair-id)
		(up-remove-objects search-local object-data-player != my-player-number)
	(up-remove-objects search-local object-data-group-flag >= 0)
	(up-remove-objects search-local object-data-order == orderid-transport)
	(up-remove-objects search-local object-data-order == orderid-unload)
	(up-target-point point3-x action-move -1 stance-no-attack)
	(set-goal gl-transport-repair-state TRANSPORT-REPAIR-TASK)
)

(defrule
	(goal gl-transport-repair-state TRANSPORT-REPAIR-TASK)
=>
	(up-full-reset-search)
	(up-set-target-point point3-x)
	(up-filter-distance c: -1 c: 12)
	(up-find-local c: villager-class c: 20)
	(up-remove-objects search-local object-data-group-flag >= 0)
	(up-remove-objects search-local object-data-id g:== gl-boar-lurer-id)
	(up-remove-objects search-local object-data-idling != 1)
	(up-clean-search search-local object-data-distance search-order-asc)
	(up-remove-objects search-local object-data-index >= 2)
	(up-add-object-by-id search-remote g: gl-transport-repair-id)
	;OWNERSHIP command: FREE.
	(up-remove-objects search-local object-data-player != my-player-number)
	(up-remove-objects search-local object-data-group-flag >= 0)
	(up-target-objects 0 action-default -1 stance-no-attack)
	(up-modify-sn sn-focus-player-number g:= gl-transport-repair-focus)
	(set-goal gl-transport-repair-state TRANSPORT-REPAIR-IDLE)
)

;A transport whose former task died can remain partially loaded indefinitely.
;Try a bounded local unload before any normal berth-clearing pass can reuse it.
(defrule
	(up-timer-status t-transport-clear == timer-triggered)
	(goal gl-transport-clear-state TRANSPORT-CLEAR-IDLE)
	(goal gl-island-migration-state MIGRATION-IDLE)
	(goal gl-relic-ferry-state RELIC-FERRY-IDLE)
	(goal gl-transport-recovery-state TRANSPORT-RECOVERY-IDLE)
	(goal gl-transport-repair-state TRANSPORT-REPAIR-IDLE)
	(goal gl-transport-route-state TRANSPORT-ROUTE-IDLE)
	(up-compare-goal gl-quarantine-transport-id c:< 0)
	(or
		(unit-type-count transport-ship >= 1)
		(or
			(building-type-count-total port >= 1)
			(building-type-count-total shipyard >= 1)
		)
	)
=>
	(up-modify-goal gl-transport-clear-focus s:= sn-focus-player-number)
	(set-strategic-number sn-focus-player-number my-player-number)
	(up-full-reset-search)
	(up-set-target-point gl-home-anchor-x)
	(up-find-remote c: transport-ship c: 40)
	(up-remove-objects search-remote object-data-garrison-count <= 0)
	(up-remove-objects search-remote object-data-garrison-count g:>= gl-transport-min-load)
	(up-remove-objects search-remote object-data-idling != 1)
	(up-remove-objects search-remote object-data-under-attack > 0)
	(up-clean-search search-remote object-data-distance search-order-desc)
	(set-goal gl-transport-clear-state TRANSPORT-CLEAR-STALE-FIND)
)

(defrule
	(goal gl-transport-clear-state TRANSPORT-CLEAR-STALE-FIND)
	(up-set-target-object search-remote c: 0)
=>
	(up-get-object-data object-data-id gl-transport-clear-id)
	(up-get-point position-object point-x)
	(set-goal gl-transport-clear-attempts 0)
	;Observe the exact hull for thirty seconds before changing any order. A live
	;engine attack can still be filling a temporarily idle partial transport.
	(up-set-timer c: t-transport-clear c: 30)
	(set-goal gl-transport-clear-state TRANSPORT-CLEAR-STALE-WAIT)
)

(defrule
	(goal gl-transport-clear-state TRANSPORT-CLEAR-STALE-FIND)
	(not (up-set-target-object search-remote c: 0))
=>
	;Continue the same triggered cycle into completed-task recovery. Resetting the
	;timer here would permanently starve both this scan and ordinary berth clear.
	(up-full-reset-search)
	(up-set-target-point gl-home-anchor-x)
	(up-filter-distance c: 24 c: -1)
	(up-find-remote c: transport-ship c: 40)
	(up-remove-objects search-remote object-data-garrison-count > 0)
	(up-remove-objects search-remote object-data-idling != 1)
	(up-remove-objects search-remote object-data-under-attack > 0)
	(up-clean-search search-remote object-data-distance search-order-desc)
	(set-goal gl-transport-clear-state TRANSPORT-CLEAR-EMPTY-FIND)
)

(defrule
	(goal gl-transport-clear-state TRANSPORT-CLEAR-STALE-WAIT)
	(up-timer-status t-transport-clear == timer-triggered)
=>
	(up-full-reset-search)
	(up-add-object-by-id search-local g: gl-transport-clear-id)
	(set-goal gl-transport-clear-state TRANSPORT-CLEAR-STALE-CHECK)
)

(defrule
	(goal gl-transport-clear-state TRANSPORT-CLEAR-STALE-CHECK)
	(up-set-target-object search-local c: 0)
	(up-object-data object-data-garrison-count <= 0)
=>
	;The home anchor is normally inland and is not a valid naval assembly point.
	;Feed the now-empty hull into the same-basin producer staging pass instead.
	(up-full-reset-search)
	(up-filter-status c: status-ready c: list-active)
	(up-find-local c: port c: 10)
	(up-find-local c: shipyard c: 10)
	(up-clean-search search-local object-data-id search-order-asc)
	(set-goal gl-transport-clear-state TRANSPORT-CLEAR-ANCHOR)
)

(defrule
	(goal gl-transport-clear-state TRANSPORT-CLEAR-STALE-CHECK)
	(up-set-target-object search-local c: 0)
	(up-object-data object-data-garrison-count > 0)
	(up-object-data object-data-garrison-count g:< gl-transport-min-load)
	(up-object-data object-data-idling == 1)
	(up-compare-goal gl-transport-clear-attempts c:< 2)
=>
	(up-get-point position-object point-x)
	;OWNERSHIP command: FREE.
	(up-remove-objects search-local object-data-player != my-player-number)
	(up-remove-objects search-local object-data-group-flag >= 0)
	(up-target-point point-x action-unload -1 stance-no-attack)
	(up-modify-goal gl-transport-clear-attempts c:+ 1)
	(up-set-timer c: t-transport-clear c: 15)
	(set-goal gl-transport-clear-state TRANSPORT-CLEAR-STALE-WAIT)
)

(defrule
	(goal gl-transport-clear-state TRANSPORT-CLEAR-STALE-CHECK)
	(up-set-target-object search-local c: 0)
	(up-object-data object-data-garrison-count > 0)
	(up-object-data object-data-garrison-count g:< gl-transport-min-load)
	(up-object-data object-data-idling == 1)
	(up-compare-goal gl-transport-clear-attempts c:>= 2)
=>
	;The two exact-position unload attempts failed. Quarantine the hull without
	;issuing a third command toward the normally inland home anchor.
	(up-modify-goal gl-quarantine-transport-id g:= gl-transport-clear-id)
	(up-modify-goal gl-quarantine-transport-next g:= gl-game-time)
	(up-modify-goal gl-quarantine-transport-next c:+ 60)
	(set-goal gl-quarantine-transport-attempts 0)
	(set-goal gl-quarantine-transport-state TRANSPORT-QUARANTINE-IDLE)
	(up-chat-data-to-self "stale transport quarantined: %d" g: gl-transport-clear-id)
	(up-modify-sn sn-focus-player-number g:= gl-transport-clear-focus)
	(up-set-timer c: t-transport-clear c: 45)
	(set-goal gl-transport-clear-state TRANSPORT-CLEAR-IDLE)
)

(defrule
	(goal gl-transport-clear-state TRANSPORT-CLEAR-STALE-CHECK)
	(up-set-target-object search-local c: 0)
	(or
		(up-object-data object-data-garrison-count g:>= gl-transport-min-load)
		(up-object-data object-data-idling != 1)
	)
=>
	;The engine resumed a legitimate load or task while it was observed.
	(up-modify-sn sn-focus-player-number g:= gl-transport-clear-focus)
	(up-set-timer c: t-transport-clear c: 30)
	(set-goal gl-transport-clear-state TRANSPORT-CLEAR-IDLE)
)

(defrule
	(goal gl-transport-clear-state TRANSPORT-CLEAR-STALE-CHECK)
	(not (up-set-target-object search-local c: 0))
=>
	(up-modify-sn sn-focus-player-number g:= gl-transport-clear-focus)
	(up-set-timer c: t-transport-clear c: 30)
	(set-goal gl-transport-clear-state TRANSPORT-CLEAR-IDLE)
)

;Stage an abandoned empty utility or attack hull from a distant shoreline near
;another proven ship in its exact producer water zone. Never send a completed
;hull back onto the production footprint. This handles the completed-task case
;separately from the partial-load watchdog above.

(defrule
	(goal gl-transport-clear-state TRANSPORT-CLEAR-EMPTY-FIND)
	(up-set-target-object search-remote c: 0)
=>
	(up-get-object-data object-data-id gl-transport-clear-id)
	(up-get-object-data object-data-map-zone-id gl-transport-clear-water-zone)
	(up-get-point position-object point-x)
	(up-full-reset-search)
	(up-set-target-point point-x)
	(up-filter-status c: status-ready c: list-active)
	(up-find-local c: port c: 20)
	(up-find-local c: shipyard c: 20)
	(up-remove-objects search-local object-data-map-zone-id g:!= gl-transport-clear-water-zone)
	(up-clean-search search-local object-data-distance search-order-asc)
	(set-goal gl-transport-clear-state TRANSPORT-CLEAR-EMPTY-PORT)
)

(defrule
	(goal gl-transport-clear-state TRANSPORT-CLEAR-EMPTY-FIND)
	(not (up-set-target-object search-remote c: 0))
	(or
		(building-type-count-total port >= 1)
		(building-type-count-total shipyard >= 1)
	)
=>
	(up-full-reset-search)
	(up-filter-status c: status-ready c: list-active)
	(up-find-local c: port c: 10)
	(up-find-local c: shipyard c: 10)
	(up-clean-search search-local object-data-id search-order-asc)
	(set-goal gl-transport-clear-state TRANSPORT-CLEAR-ANCHOR)
)

(defrule
	(goal gl-transport-clear-state TRANSPORT-CLEAR-EMPTY-FIND)
	(not (up-set-target-object search-remote c: 0))
	(building-type-count-total port < 1)
	(building-type-count-total shipyard < 1)
=>
	(up-modify-sn sn-focus-player-number g:= gl-transport-clear-focus)
	(up-set-timer c: t-transport-clear c: 30)
	(set-goal gl-transport-clear-state TRANSPORT-CLEAR-IDLE)
)

(defrule
	(goal gl-transport-clear-state TRANSPORT-CLEAR-EMPTY-PORT)
	(up-set-target-object search-local c: 0)
=>
	(up-get-point position-object point3-x)
	(up-full-reset-search)
	(up-set-target-point point3-x)
	(up-filter-distance c: -1 c: 40)
	(up-find-local c: fishing-ship-class c: 20)
	(up-find-local c: trade-cog-class c: 10)
	(up-find-local c: warship-class c: 40)
	(up-find-local c: boarding-ship c: 10)
	(up-find-local c: transport-ship c: 10)
	;Move outside the producer reacquisition radius so this completed-hull pass
	;cannot select and restage the same vessel every cycle.
	(up-remove-objects search-local object-data-distance < 24)
	(up-remove-objects search-local object-data-id g:== gl-transport-clear-id)
	(up-remove-objects search-local object-data-map-zone-id g:!= gl-transport-clear-water-zone)
	(up-clean-search search-local object-data-distance search-order-asc)
	(set-goal gl-transport-clear-state TRANSPORT-CLEAR-EMPTY-STAGE)
)

;A completed hull stages at another proven same-basin ship position, never on
;the production footprint itself.  Without such a point, leave it where it is
;and continue into the ordinary producer-obstruction scan.
(defrule
	(goal gl-transport-clear-state TRANSPORT-CLEAR-EMPTY-STAGE)
	(up-set-target-object search-local c: 0)
=>
				(up-get-point position-object gl-transport-clear-target-x)
	(up-full-reset-search)
	(up-add-object-by-id search-local g: gl-transport-clear-id)
		(up-remove-objects search-local object-data-player != my-player-number)
	(up-remove-objects search-local object-data-group-flag >= 0)
	(up-remove-objects search-local object-data-order == orderid-transport)
	(up-remove-objects search-local object-data-order == orderid-unload)
	(up-target-point gl-transport-clear-target-x action-move -1 stance-no-attack)
	(set-goal gl-transport-clear-attempts 0)
	(up-set-timer c: t-transport-clear c: 15)
	(set-goal gl-transport-clear-state TRANSPORT-CLEAR-MOVE-WAIT)
)

(defrule
	(goal gl-transport-clear-state TRANSPORT-CLEAR-EMPTY-STAGE)
	(not (up-set-target-object search-local c: 0))
=>
	(up-chat-data-to-self "empty transport no staging point: %d" g: gl-transport-clear-id)
	(up-full-reset-search)
	(up-filter-status c: status-ready c: list-active)
	(up-find-local c: port c: 10)
	(up-find-local c: shipyard c: 10)
	(up-clean-search search-local object-data-id search-order-asc)
	(set-goal gl-transport-clear-state TRANSPORT-CLEAR-ANCHOR)
)

(defrule
	(goal gl-transport-clear-state TRANSPORT-CLEAR-EMPTY-PORT)
	(not (up-set-target-object search-local c: 0))
	(or
		(building-type-count-total port >= 1)
		(building-type-count-total shipyard >= 1)
	)
=>
	(up-full-reset-search)
	(up-filter-status c: status-ready c: list-active)
	(up-find-local c: port c: 10)
	(up-find-local c: shipyard c: 10)
	(up-clean-search search-local object-data-id search-order-asc)
	(set-goal gl-transport-clear-state TRANSPORT-CLEAR-ANCHOR)
)

(defrule
	(goal gl-transport-clear-state TRANSPORT-CLEAR-EMPTY-PORT)
	(not (up-set-target-object search-local c: 0))
	(building-type-count-total port < 1)
	(building-type-count-total shipyard < 1)
=>
	(up-modify-sn sn-focus-player-number g:= gl-transport-clear-focus)
	(up-set-timer c: t-transport-clear c: 45)
	(set-goal gl-transport-clear-state TRANSPORT-CLEAR-IDLE)
)

;Clear one idle, empty ship, including a Trade Cog, from a Port or Shipyard
;berth. Cycle through every
;ready producer so neither an older nor a newer berth can monopolize the check.
;Use another ship's same-zone position as a demonstrably-water destination
;rather than projecting an unchecked point across the shoreline.
(defrule
	(up-timer-status t-transport-clear == timer-triggered)
	(goal gl-transport-clear-state TRANSPORT-CLEAR-IDLE)
	(goal gl-island-migration-state MIGRATION-IDLE)
	(goal gl-relic-ferry-state RELIC-FERRY-IDLE)
	(goal gl-transport-recovery-state TRANSPORT-RECOVERY-IDLE)
	(goal gl-transport-repair-state TRANSPORT-REPAIR-IDLE)
	(goal gl-transport-route-state TRANSPORT-ROUTE-IDLE)
	(up-compare-goal gl-quarantine-transport-id c:>= 0)
	(or
		(building-type-count-total port >= 1)
		(building-type-count-total shipyard >= 1)
	)
=>
	;A detached exact-ID quarantine must not disable berth clearing for every
	;other empty hull. Skip stale recovery, which could need the occupied slot.
	(up-modify-goal gl-transport-clear-focus s:= sn-focus-player-number)
	(set-strategic-number sn-focus-player-number my-player-number)
	(up-full-reset-search)
	(up-filter-status c: status-ready c: list-active)
	(up-find-local c: port c: 10)
	(up-find-local c: shipyard c: 10)
	(up-clean-search search-local object-data-id search-order-asc)
	(set-goal gl-transport-clear-state TRANSPORT-CLEAR-ANCHOR)
)

(defrule
	(goal gl-transport-clear-state TRANSPORT-CLEAR-ANCHOR)
	(up-set-target-object search-local g: gl-transport-clear-port-index)
=>
	(up-get-point position-object point-x)
	(up-get-object-data object-data-map-zone-id gl-transport-clear-water-zone)
	(up-modify-goal gl-transport-clear-port-index c:+ 1)
	(up-full-reset-search)
	(up-set-target-point point-x)
	(up-filter-distance c: -1 c: 8)
	(up-filter-status c: status-ready c: list-active)
	;Utility hulls can remain in old task groups after the task ends. Clear them
	;first and do not use group ownership as proof that the berth is intentional.
	(up-find-local c: trade-cog-class c: 10)
	(up-find-local c: transport-ship c: 10)
	(up-remove-objects search-local object-data-id g:== gl-quarantine-transport-id)
	(up-remove-objects search-local object-data-garrison-count > 0)
	(up-remove-objects search-local object-data-idling != 1)
	(up-remove-objects search-local object-data-under-attack > 0)
	(up-remove-objects search-local object-data-map-zone-id g:!= gl-transport-clear-water-zone)
	(up-clean-search search-local object-data-distance search-order-asc)
	(set-goal gl-transport-clear-state TRANSPORT-CLEAR-UTILITY-CHECK)
)

(defrule
	(goal gl-transport-clear-state TRANSPORT-CLEAR-UTILITY-CHECK)
	(up-set-target-object search-local c: 0)
=>
	(set-goal gl-transport-clear-state TRANSPORT-CLEAR-DESTINATION)
)

(defrule
	(goal gl-transport-clear-state TRANSPORT-CLEAR-UTILITY-CHECK)
	(not (up-set-target-object search-local c: 0))
=>
	;Only fall back to ordinary combat and fishing hulls when no idle merchant or
	;transport occupies this producer. Active task groups remain protected here.
	(up-full-reset-search)
	(up-set-target-point point-x)
	(up-filter-distance c: -1 c: 8)
	(up-filter-status c: status-ready c: list-active)
	(up-find-local c: fishing-ship-class c: 20)
	(up-find-local c: warship-class c: 40)
	(up-find-local c: boarding-ship c: 10)
	(up-remove-objects search-local object-data-idling != 1)
	(up-remove-objects search-local object-data-under-attack > 0)
	(up-remove-objects search-local object-data-group-flag >= 0)
	(up-remove-objects search-local object-data-map-zone-id g:!= gl-transport-clear-water-zone)
	(up-clean-search search-local object-data-distance search-order-asc)
	(set-goal gl-transport-clear-state TRANSPORT-CLEAR-DESTINATION)
)

(defrule
	(goal gl-transport-clear-state TRANSPORT-CLEAR-ANCHOR)
	(not (up-set-target-object search-local g: gl-transport-clear-port-index))
=>
	(set-goal gl-transport-clear-port-index 0)
	(up-modify-sn sn-focus-player-number g:= gl-transport-clear-focus)
	(up-set-timer c: t-transport-clear c: 5)
	(set-goal gl-transport-clear-state TRANSPORT-CLEAR-IDLE)
)

(defrule
	(goal gl-transport-clear-state TRANSPORT-CLEAR-DESTINATION)
	(up-set-target-object search-local c: 0)
=>
	(up-get-object-data object-data-id gl-transport-clear-id)
	(up-full-reset-search)
	(up-set-target-point point-x)
	(up-filter-distance c: -1 c: 40)
	(up-find-local c: fishing-ship-class c: 20)
	(up-find-local c: trade-cog-class c: 10)
	(up-find-local c: warship-class c: 40)
	(up-find-local c: boarding-ship c: 10)
	(up-find-local c: transport-ship c: 10)
	;Keep a real berth-sized gap and use the exact known-water position selected
	;below. Collision separation is safer than projecting an unchecked midpoint.
	(up-remove-objects search-local object-data-distance < 20)
	(up-remove-objects search-local object-data-id g:== gl-transport-clear-id)
	(up-remove-objects search-local object-data-map-zone-id g:!= gl-transport-clear-water-zone)
	(up-clean-search search-local object-data-distance search-order-asc)
	(set-goal gl-transport-clear-state TRANSPORT-CLEAR-FIND)
)

(defrule
	(goal gl-transport-clear-state TRANSPORT-CLEAR-DESTINATION)
	(not (up-set-target-object search-local c: 0))
=>
	(up-modify-sn sn-focus-player-number g:= gl-transport-clear-focus)
	(up-set-timer c: t-transport-clear c: 5)
	(set-goal gl-transport-clear-state TRANSPORT-CLEAR-IDLE)
)

(defrule
	(goal gl-transport-clear-state TRANSPORT-CLEAR-FIND)
	(up-set-target-object search-local c: 0)
	(goal gl-row-active 0)
=>
	(up-get-point position-object gl-transport-clear-target-x)
	(up-full-reset-search)
	(up-add-object-by-id search-local g: gl-transport-clear-id)
		(up-remove-objects search-local object-data-player != my-player-number)
	(up-remove-objects search-local object-data-group-flag >= 0)
	(up-remove-objects search-local object-data-order == orderid-transport)
	(up-remove-objects search-local object-data-order == orderid-unload)
	(up-target-point gl-transport-clear-target-x action-move -1 stance-no-attack)
	(set-goal gl-transport-clear-attempts 0)
	(up-set-timer c: t-transport-clear c: 15)
	(set-goal gl-transport-clear-state TRANSPORT-CLEAR-MOVE-WAIT)
)

;Do not report a cleared berth merely because a move command was accepted. The
;exact hull must reach the offset destination; two bounded retries cover a
;temporary collision without creating another endless ship-control loop.
(defrule
	(goal gl-transport-clear-state TRANSPORT-CLEAR-MOVE-WAIT)
	(up-timer-status t-transport-clear == timer-triggered)
=>
	(up-full-reset-search)
	(up-set-target-point gl-transport-clear-target-x)
	(up-filter-distance c: -1 c: 6)
	(up-find-local c: fishing-ship-class c: 20)
	(up-find-local c: trade-cog-class c: 10)
	(up-find-local c: warship-class c: 40)
	(up-find-local c: boarding-ship c: 10)
	(up-find-local c: transport-ship c: 10)
	(up-remove-objects search-local object-data-id g:!= gl-transport-clear-id)
	(set-goal gl-transport-clear-state TRANSPORT-CLEAR-MOVE-CHECK)
)

(defrule
	(goal gl-transport-clear-state TRANSPORT-CLEAR-MOVE-CHECK)
	(up-set-target-object search-local c: 0)
=>
	(up-chat-data-to-self "port hull staged clear: %d" g: gl-transport-clear-id)
	(up-modify-sn sn-focus-player-number g:= gl-transport-clear-focus)
	(up-set-timer c: t-transport-clear c: 45)
	(set-goal gl-transport-clear-state TRANSPORT-CLEAR-IDLE)
)

(defrule
	(goal gl-transport-clear-state TRANSPORT-CLEAR-MOVE-CHECK)
	(not (up-set-target-object search-local c: 0))
	(up-compare-goal gl-transport-clear-attempts c:< 2)
	(goal gl-row-active 0)
=>
	(up-full-reset-search)
	(up-add-object-by-id search-local g: gl-transport-clear-id)
		(up-remove-objects search-local object-data-player != my-player-number)
	(up-remove-objects search-local object-data-group-flag >= 0)
	(up-remove-objects search-local object-data-order == orderid-transport)
	(up-remove-objects search-local object-data-order == orderid-unload)
	(up-target-point gl-transport-clear-target-x action-move -1 stance-no-attack)
	(up-modify-goal gl-transport-clear-attempts c:+ 1)
	(up-set-timer c: t-transport-clear c: 15)
	(set-goal gl-transport-clear-state TRANSPORT-CLEAR-MOVE-WAIT)
)

(defrule
	(goal gl-transport-clear-state TRANSPORT-CLEAR-MOVE-CHECK)
	(not (up-set-target-object search-local c: 0))
	(up-compare-goal gl-transport-clear-attempts c:>= 2)
=>
	(up-chat-data-to-self "port hull staging failed: %d" g: gl-transport-clear-id)
	(up-modify-sn sn-focus-player-number g:= gl-transport-clear-focus)
	(up-set-timer c: t-transport-clear c: 30)
	(set-goal gl-transport-clear-state TRANSPORT-CLEAR-IDLE)
)

(defrule
	(goal gl-transport-clear-state TRANSPORT-CLEAR-FIND)
	(not (up-set-target-object search-local c: 0))
=>
	(up-modify-sn sn-focus-player-number g:= gl-transport-clear-focus)
	(up-set-timer c: t-transport-clear c: 30)
	(set-goal gl-transport-clear-state TRANSPORT-CLEAR-IDLE)
)

;Only an accepted full/useful-partial assault receives a departure order. Its
;destination is rebuilt from an observed enemy anchor (or the enemy start as a
;fallback), so an engine-generated waypoint on an unrelated islet is rejected.
(load "rawai-assault-admission")
(load "rawai-expedition-admission")
;Sparse assault-admission diagnostics.  T25 proves that Green and Purple can
;remain entirely upstream of the existing load/plan telemetry.  Sample the
;outer gate once per minute and publish only a mask/stage transition, using the
;existing generic strings so this cannot consume more string-table entries.
;Mask: 1 route busy, 2 all slots busy, 4 migration, 8 relic, 16 recovery,
;32 repair, 64 berth clear, 128 home defense, 256 no Transport,
;512 no living seed enemy, 1024 route timer waiting.
(defrule
	(current-age >= early-antiquity-age)
	(or
		(goal map-type LAKE)
		(or
			(goal map-type RIVERS)
			(or (goal map-type ISLANDS) (goal map-type TEAM-ISLANDS))
		)
	)
	(goal gl-assault-admission-diag-state 0)
	(up-compare-goal gl-assault-mission-clock g:>= gl-assault-admission-diag-next)
=>
	(set-goal gl-assault-admission-diag-mask 0)
	(set-goal gl-assault-admission-diag-state 1)
	(up-modify-goal gl-assault-admission-diag-next g:= gl-assault-mission-clock)
	(up-modify-goal gl-assault-admission-diag-next c:+ 60)
)
(defrule
	(goal gl-assault-admission-diag-state 1)
	(not (goal gl-transport-route-state TRANSPORT-ROUTE-IDLE))
=>
	(up-modify-goal gl-assault-admission-diag-mask c:+ 1)
)
(defrule
	(goal gl-assault-admission-diag-state 1)
	(not (goal gl-assault-admission-open YES))
=>
	(up-modify-goal gl-assault-admission-diag-mask c:+ 2)
)
(defrule
	(goal gl-assault-admission-diag-state 1)
	(not (goal gl-island-migration-state MIGRATION-IDLE))
=>
	(up-modify-goal gl-assault-admission-diag-mask c:+ 4)
)
(defrule
	(goal gl-assault-admission-diag-state 1)
	(not (goal gl-relic-ferry-state RELIC-FERRY-IDLE))
=>
	(up-modify-goal gl-assault-admission-diag-mask c:+ 8)
)
(defrule
	(goal gl-assault-admission-diag-state 1)
	(not (goal gl-transport-recovery-state TRANSPORT-RECOVERY-IDLE))
=>
	(up-modify-goal gl-assault-admission-diag-mask c:+ 16)
)
(defrule
	(goal gl-assault-admission-diag-state 1)
	(not (goal gl-transport-repair-state TRANSPORT-REPAIR-IDLE))
=>
	(up-modify-goal gl-assault-admission-diag-mask c:+ 32)
)
(defrule
	(goal gl-assault-admission-diag-state 1)
	(not (goal gl-transport-clear-state TRANSPORT-CLEAR-IDLE))
=>
	(up-modify-goal gl-assault-admission-diag-mask c:+ 64)
)
(defrule
	(goal gl-assault-admission-diag-state 1)
	(not (goal gl-home-defense-state NO))
=>
	(up-modify-goal gl-assault-admission-diag-mask c:+ 128)
)
(defrule
	(goal gl-assault-admission-diag-state 1)
	(unit-type-count transport-ship < 1)
=>
	(up-modify-goal gl-assault-admission-diag-mask c:+ 256)
)
(defrule
	(goal gl-assault-admission-diag-state 1)
	(up-compare-goal gl-ap-seed-enemy c:< 1)
=>
	(up-modify-goal gl-assault-admission-diag-mask c:+ 512)
)
(defrule
	(goal gl-assault-admission-diag-state 1)
	(up-timer-status t-transport-route != timer-triggered)
=>
	(up-modify-goal gl-assault-admission-diag-mask c:+ 1024)
)
(defrule
	(goal gl-assault-admission-diag-state 1)
	(or
		(up-compare-goal gl-assault-admission-diag-mask g:!= gl-assault-admission-reported-mask)
		(up-compare-goal gl-assault-admission-last-stage g:!= gl-assault-admission-reported-stage)
	)
=>
	(up-chat-data-to-all str-t12-diag-id c: 400)
	(up-chat-data-to-all str-t12-diag-value g: gl-assault-admission-diag-mask)
	(up-modify-goal gl-assault-admission-reported-mask g:= gl-assault-admission-diag-mask)
	(set-goal gl-assault-admission-diag-state 2)
)
(defrule
	(goal gl-assault-admission-diag-state 2)
=>
	(up-chat-data-to-all str-t12-diag-id c: 401)
	(up-chat-data-to-all str-t12-diag-value g: gl-assault-admission-last-stage)
	(up-modify-goal gl-assault-admission-reported-stage g:= gl-assault-admission-last-stage)
	(set-goal gl-assault-admission-diag-state 3)
)
(defrule
	(goal gl-assault-admission-diag-state 3)
=>
	(up-chat-data-to-all str-t12-diag-id c: 402)
	(up-chat-data-to-all str-t12-diag-value g: gl-assault-admission-last-time)
	(set-goal gl-assault-admission-diag-state 0)
)
(defrule
	(goal gl-assault-admission-diag-state 1)
=>
	(set-goal gl-assault-admission-diag-state 0)
)
(defrule
	(up-timer-status t-transport-route == timer-triggered)
	(goal gl-transport-route-state TRANSPORT-ROUTE-IDLE)
	(goal gl-assault-admission-open YES)
=>
	(set-goal gl-assault-manifest-hull -1)
	(set-goal gl-assault-admission-objective -1)
	(set-goal gl-assault-manifest-count 0)
	(set-goal gl-transport-route-script-load NO)
	(up-modify-goal gl-assault-manifest-player g:= gl-ap-seed-enemy)
	(set-goal gl-ap-active NO)
	(set-goal gl-ap-valid NO)
	(set-goal gl-assault-fallback-deadline 0)
	(set-goal gl-assault-fallback-progress-deadline 0)
)
(defrule
	(up-timer-status t-transport-route == timer-triggered)
	(goal gl-transport-route-state TRANSPORT-ROUTE-IDLE)
	(goal gl-assault-admission-open YES)
	(goal gl-island-migration-state MIGRATION-IDLE)
	(goal gl-relic-ferry-state RELIC-FERRY-IDLE)
	(goal gl-transport-recovery-state TRANSPORT-RECOVERY-IDLE)
	(goal gl-transport-repair-state TRANSPORT-REPAIR-IDLE)
	(goal gl-transport-clear-state TRANSPORT-CLEAR-IDLE)
	(goal gl-home-defense-state NO)
	(or
		(goal map-type LAKE)
		(or
			(goal map-type RIVERS)
			(or
				(goal map-type ISLANDS)
				(goal map-type TEAM-ISLANDS)
			)
		)
	)
	(unit-type-count transport-ship >= 1)
	(up-compare-goal gl-ap-seed-enemy c:>= 1)
=>
	(set-goal gl-assault-admission-last-stage 1)
	(up-modify-goal gl-assault-admission-last-time g:= gl-assault-mission-clock)
)
(defrule
	(up-timer-status t-transport-route == timer-triggered)
	(goal gl-transport-route-state TRANSPORT-ROUTE-IDLE)
	(goal gl-assault-admission-open YES)
	(goal gl-island-migration-state MIGRATION-IDLE)
	(goal gl-relic-ferry-state RELIC-FERRY-IDLE)
	(goal gl-transport-recovery-state TRANSPORT-RECOVERY-IDLE)
	(goal gl-transport-repair-state TRANSPORT-REPAIR-IDLE)
	(goal gl-transport-clear-state TRANSPORT-CLEAR-IDLE)
	(goal gl-home-defense-state NO)
	(or
		(goal map-type LAKE)
		(or
			(goal map-type RIVERS)
			(or
				(goal map-type ISLANDS)
				(goal map-type TEAM-ISLANDS)
			)
		)
	)
	(unit-type-count transport-ship >= 1)
	(up-compare-goal gl-ap-seed-enemy c:>= 1)
=>
	;A new mission cannot inherit the last mission's manifest or travel budget.
	(up-modify-goal gl-transport-route-focus s:= sn-focus-player-number)
	(set-strategic-number sn-focus-player-number my-player-number)
	(up-full-reset-search)
	(up-set-target-point position-self-x)
	(up-find-remote c: transport-ship c: 40)
	(up-remove-objects search-remote object-data-id g:== gl-quarantine-transport-id)
	(up-remove-objects search-remote object-data-id g:== gl-assault-recovery-rejected)
	(up-remove-objects search-remote object-data-garrison-count g:< gl-transport-min-load)
	;Do not take over an already dispatched native/manual voyage.
	(up-remove-objects search-remote object-data-order == orderid-transport)
	(up-remove-objects search-remote object-data-order == orderid-unload)
	(up-remove-objects search-remote object-data-group-flag >= 0)
	(up-clean-search search-remote object-data-distance search-order-desc)
	(set-goal gl-transport-route-state TRANSPORT-ROUTE-FIND)
)

(defrule
	(goal gl-transport-route-state TRANSPORT-ROUTE-LOAD-READY)
	(goal gl-assault-preflight-live YES)
=>
	;Rebuild the saved exact hull in the same sweep that the ordinary FIND
	;consumer runs. Shared searches cannot be assumed to survive a rule pass.
	(set-strategic-number sn-focus-player-number my-player-number)
	(up-full-reset-search)
	(up-add-object-by-id search-remote g: gl-transport-route-id)
	(set-goal gl-transport-route-state TRANSPORT-ROUTE-FIND)
)

(defrule
    (goal gl-transport-route-state TRANSPORT-ROUTE-LOAD-READY)
    (goal gl-assault-preflight-live NO)
=>
    ;Only loss of the sealed opponent, not a global selector change.
    (up-full-reset-search)
    (up-add-object-by-id search-local g: gl-transport-route-id)
    (up-remove-objects search-local object-data-player != my-player-number)
    (up-remove-objects search-local object-data-group-flag != attack-transport-group)
    (up-target-point gl-transport-route-origin-x action-unload -1 stance-no-attack)
    (up-set-timer c: t-transport-route c: 15)
    (set-goal gl-route-unload-attempts 0)
    (set-goal gl-transport-route-state TRANSPORT-ROUTE-RECOVERY-WAIT)
)

(defrule
	(goal gl-transport-route-state TRANSPORT-ROUTE-FIND)
	(up-set-target-object search-remote c: 0)
	(up-object-data object-data-player == my-player-number)
	(up-object-data object-data-group-flag < 0)
=>
			(up-get-object-data object-data-id gl-transport-route-id)
		(up-modify-goal gl-assault-manifest-hull g:= gl-transport-route-id)
	(up-get-object-data object-data-garrison-count gl-assault-manifest-count)
	(up-reset-search 1 1 0 0)
	(up-add-object-by-id search-local g: gl-transport-route-id)
	(up-remove-objects search-local object-data-player != my-player-number)
	(up-remove-objects search-local object-data-group-flag >= 0)
	(up-remove-objects search-local object-data-order == orderid-transport)
	(up-remove-objects search-local object-data-order == orderid-unload)
	(up-create-group 0 0 c: attack-transport-group)
	(up-modify-group-flag 1 c: attack-transport-group)
)

(defrule
	(goal gl-transport-route-state TRANSPORT-ROUTE-FIND)
	(up-set-target-object search-remote c: 0)
	(up-object-data object-data-group-flag != attack-transport-group)
=>
	;Do not silently abandon a useful loaded manifest after a failed reacquisition.
	;The bounded ownership handler recovers only our idle unowned hull; otherwise
	;it yields to the actual owner/native voyage without issuing orders to it.
	(set-goal gl-transport-route-state TRANSPORT-ROUTE-OWNER-LOST)
)

(defrule
	(goal gl-transport-route-state TRANSPORT-ROUTE-FIND)
	(up-set-target-object search-remote c: 0)
	(up-object-data object-data-player == my-player-number)
	(up-object-data object-data-group-flag == attack-transport-group)
=>
	(up-get-object-data object-data-id gl-transport-route-id)
	(up-get-point position-object gl-transport-route-origin-x)
	(up-modify-sn sn-focus-player-number g:= gl-assault-manifest-player)
	(up-get-point position-focus gl-transport-route-target-x)
	(up-full-reset-search)
	(up-set-target-point gl-transport-route-target-x)
	(up-find-remote c: town-center c: 10)
	(up-find-remote c: villager-class c: 20)
	(up-find-remote c: market c: 10)
	(up-find-remote c: barracks c: 10)
	(up-find-remote c: archery-range c: 10)
	(up-find-remote c: stable c: 10)
	(up-find-remote c: siege-workshop c: 10)
	(up-find-remote c: castle c: 10)
	(up-clean-search search-remote object-data-distance search-order-asc)
	(set-goal gl-transport-route-state TRANSPORT-ROUTE-TARGET)
)

(defrule
	(goal gl-transport-route-state TRANSPORT-ROUTE-FIND)
	(not (up-set-target-object search-remote c: 0))
	(up-compare-goal gl-home-zone c:>= 0)
	(or (up-compare-goal military-superiority c:>= TOLERABLE) (goal gl-exp-allowed YES))
	(soldier-count g:>= gl-ten-percent)
	(goal gl-ally-help-state ALLY-HELP-IDLE)
=>
	;Admission belongs to the proposed mission, not the global land target. Find
	;a live asset of its saved enemy outside the boarders' home land zone. This
	;is transport NEED only: screening/landing validation still follows loading.
	(up-modify-sn sn-focus-player-number g:= gl-assault-manifest-player)
	(up-full-reset-search)
	(up-filter-status c: status-ready c: list-active)
	(up-set-target-point gl-home-anchor-x)
	(up-find-remote c: town-center c: 10)
	(up-find-remote c: villager-class c: 20)
	(up-find-remote c: market c: 10)
	(up-find-remote c: barracks c: 10)
	(up-find-remote c: archery-range c: 10)
	(up-find-remote c: stable c: 10)
	(up-find-remote c: siege-workshop c: 10)
	(up-find-remote c: castle c: 10)
	(up-remove-objects search-remote object-data-player g:!= gl-assault-manifest-player)
	(up-remove-objects search-remote object-data-map-zone-id < 0)
	(up-remove-objects search-remote object-data-map-zone-id g:== gl-home-zone)
	(set-goal gl-transport-route-state TRANSPORT-ROUTE-ADMISSION-CHECK)
)

(defrule
	(goal gl-transport-route-state TRANSPORT-ROUTE-ADMISSION-CHECK)
	(up-set-target-object search-remote c: 0)
	(player-in-game focus-player)
	(stance-toward focus-player enemy)
=>
	(set-goal gl-assault-admission-last-stage 2)
	(up-modify-goal gl-assault-admission-last-time g:= gl-assault-mission-clock)
	(up-get-object-data object-data-id gl-assault-admission-objective)
	(set-strategic-number sn-focus-player-number my-player-number)
	(up-modify-goal gl-transport-route-load-player g:= gl-assault-manifest-player)
	;T23: reserve the assault first. Hull selection follows from the manifest's
	;rendezvous point, so remote travel never consumes the boarding deadline.
	(set-goal gl-transport-route-state TRANSPORT-ROUTE-MANIFEST-FIND)
)

(defrule
	(goal gl-transport-route-state TRANSPORT-ROUTE-ADMISSION-CHECK)
=>
	;No known overseas objective for THIS opponent. Do not substitute another
	;player's cached zone. Existing bounded retry/target rotation can try later.
	(set-goal gl-assault-admission-last-stage 3)
	(up-modify-goal gl-assault-admission-last-time g:= gl-assault-mission-clock)
	(up-modify-sn sn-focus-player-number g:= gl-transport-route-focus)
	(up-set-timer c: t-transport-route c: 30)
	(set-goal gl-transport-route-state TRANSPORT-ROUTE-IDLE)
)

;Cancel native exploration before this first explicit land claim.
(defrule
	(goal gl-transport-route-state TRANSPORT-ROUTE-MANIFEST-FIND)
	(goal gl-owner-explore-suspended NO)
=>
	(set-strategic-number sn-number-explore-groups 0)
	(set-strategic-number sn-total-number-explorers 0)
	(set-strategic-number sn-cap-civilian-explorers 0)
	(set-strategic-number sn-minimum-civilian-explorers 0)
	; RAW12 counter 13
	(up-modify-goal gl-command-counter-13 c:+ 1)
	(up-reset-scouts)
	(set-goal gl-owner-explore-suspended YES)
)

(defrule
	(goal gl-transport-route-state TRANSPORT-ROUTE-MANIFEST-FIND)
=>
	(set-goal gl-exp-manifest-limit 10)
	(set-goal gl-exp-siege-keep -1)
)
(load "rawai-expedition-budget")

(defrule
	(goal gl-transport-route-state TRANSPORT-ROUTE-MANIFEST-FIND)
=>
	(up-modify-goal gl-transport-route-load-target g:= gl-transport-capacity)
	(up-modify-goal gl-transport-route-load-target c:min 10)
	(up-modify-goal gl-transport-route-load-target g:min gl-exp-manifest-limit)
	(up-modify-group-flag 0 c: attack-boarding-group)
	(up-reset-group c: attack-boarding-group)
	(up-full-reset-search)
	(up-set-target-point gl-home-anchor-x)
	(up-find-local c: scout-cavalry-class c: 40)
	(up-find-local c: cavalry-archer-class c: 40)
	(up-find-local c: cavalry-class c: 40)
	(up-find-local c: infantry-class c: 40)
	(up-find-local c: archery-class c: 40)
	(up-find-local c: siege-weapon-class c: 40)
	(up-remove-objects search-local object-data-type == palintonon)
	(up-remove-objects search-local object-data-type == palintonon-packed)
	(up-remove-objects search-local object-data-garrisoned == 1)
	(up-remove-objects search-local object-data-idling != 1)
	(up-remove-objects search-local object-data-under-attack > 0)
	(up-remove-objects search-local object-data-group-flag >= 0)
	(up-remove-objects search-local object-data-order == orderid-enter)
	(up-remove-objects search-local object-data-map-zone-id g:!= gl-home-zone)
	(up-remove-objects search-local object-data-id g:== gl-exp-siege-keep)
	(up-clean-search search-local object-data-distance search-order-asc)
	(up-remove-objects search-local object-data-index g:>= gl-transport-route-load-target)
	(up-remove-objects search-local object-data-player != my-player-number)
	(up-create-group 0 0 c: attack-boarding-group)
	(up-modify-group-flag 1 c: attack-boarding-group)
	(up-get-search-state local-total)
	(up-modify-goal gl-transport-route-load-target g:= local-total)
	(set-goal gl-transport-route-state TRANSPORT-ROUTE-MANIFEST-CHECK)
)

(defrule
	(goal gl-transport-route-state TRANSPORT-ROUTE-MANIFEST-CHECK)
	(up-compare-goal gl-transport-route-load-target c:>= 5)
	(up-set-target-object search-local c: 0)
=>
	;The first member of the home-anchor-sorted manifest is its persistent
	;rendezvous anchor. The hull search is relative to this army, not the TC.
	(up-get-point position-object gl-assault-rendezvous-x)
	(set-goal gl-transport-route-state TRANSPORT-ROUTE-HULL-FIND)
)

(defrule
	(goal gl-transport-route-state TRANSPORT-ROUTE-MANIFEST-CHECK)
=>
	(set-goal gl-assault-admission-last-stage 4)
	(up-modify-goal gl-assault-admission-last-time g:= gl-assault-mission-clock)
	(up-chat-data-to-self "attack lift passengers unavailable: %d" g: gl-transport-route-load-target)
	(up-modify-group-flag 0 c: attack-boarding-group)
	(up-reset-group c: attack-boarding-group)
	(up-modify-sn sn-focus-player-number g:= gl-transport-route-focus)
	(up-set-timer c: t-transport-route c: 30)
	(set-goal gl-transport-route-state TRANSPORT-ROUTE-IDLE)
)

(defrule
	(goal gl-transport-route-state TRANSPORT-ROUTE-HULL-FIND)
=>
	(up-full-reset-search)
	(up-set-target-point gl-assault-rendezvous-x)
	(up-find-remote c: transport-ship c: 40)
	(up-remove-objects search-remote object-data-id g:== gl-quarantine-transport-id)
	(up-remove-objects search-remote object-data-id g:== gl-assault-recovery-rejected)
	;Do not turn a stale civilian or relic partial load into a military attack.
	(up-remove-objects search-remote object-data-garrison-count > 0)
	(up-remove-objects search-remote object-data-idling != 1)
	(up-remove-objects search-remote object-data-under-attack > 0)
	(up-remove-objects search-remote object-data-group-flag >= 0)
	(up-clean-search search-remote object-data-distance search-order-asc)
	(set-goal gl-transport-route-state TRANSPORT-ROUTE-LOAD-FIND)
)

(defrule
	(goal gl-transport-route-state TRANSPORT-ROUTE-LOAD-FIND)
	(up-set-target-object search-remote c: 0)
=>
	(up-get-object-data object-data-id gl-transport-route-id)
	(up-get-point position-object gl-transport-route-origin-x)
	(up-modify-group-flag 0 c: attack-transport-group)
	(up-reset-group c: attack-transport-group)
	(up-full-reset-search)
	(up-add-object-by-id search-local g: gl-transport-route-id)
	(up-remove-objects search-local object-data-player != my-player-number)
	(up-remove-objects search-local object-data-group-flag >= 0)
	(up-remove-objects search-local object-data-garrison-count > 0)
	(up-remove-objects search-local object-data-idling != 1)
	(up-remove-objects search-local object-data-under-attack > 0)
	(up-create-group 0 0 c: attack-transport-group)
	(up-modify-group-flag 1 c: attack-transport-group)
	(set-goal gl-transport-route-state TRANSPORT-ROUTE-HULL-VERIFY)
)

(defrule
	(goal gl-transport-route-state TRANSPORT-ROUTE-HULL-VERIFY)
	(up-set-target-object search-local c: 0)
	(up-object-data object-data-id g:== gl-transport-route-id)
	(up-object-data object-data-player == my-player-number)
	(up-object-data object-data-group-flag == attack-transport-group)
=>
	(set-goal gl-transport-route-state TRANSPORT-ROUTE-RENDEZVOUS-START)
)

(defrule
	(goal gl-transport-route-state TRANSPORT-ROUTE-HULL-VERIFY)
=>
	(set-goal gl-assault-admission-last-stage 6)
	(up-modify-goal gl-assault-admission-last-time g:= gl-assault-mission-clock)
	(up-chat-data-to-all "RAW17 assault claim rejected hull: %d" g: gl-transport-route-id)
	(up-modify-group-flag 0 c: attack-boarding-group)
	(up-reset-group c: attack-boarding-group)
	(up-modify-sn sn-focus-player-number g:= gl-transport-route-focus)
	(up-set-timer c: t-transport-route c: 30)
	(set-goal gl-transport-route-state TRANSPORT-ROUTE-IDLE)
)

(defrule
	(goal gl-transport-route-state TRANSPORT-ROUTE-LOAD-FIND)
	(not (up-set-target-object search-remote c: 0))
=>
	(set-goal gl-assault-admission-last-stage 5)
	(up-modify-goal gl-assault-admission-last-time g:= gl-assault-mission-clock)
	(up-chat-data-to-self "attack lift unavailable: %d" c: 0)
	(up-modify-group-flag 0 c: attack-boarding-group)
	(up-reset-group c: attack-boarding-group)
	(up-modify-sn sn-focus-player-number g:= gl-transport-route-focus)
	(up-set-timer c: t-transport-route c: 30)
	(set-goal gl-transport-route-state TRANSPORT-ROUTE-IDLE)
)

;The economy clock updates only every fifteen seconds. Boarding needs a live
;clock: T11's 60:00 request otherwise expired at 60:19 instead of after 30s.
;Keep this clock local to the load contract; do not retime other controllers.
(defrule
	(true)
=>
	(up-get-fact game-time 0 gl-transport-load-clock)
)

(defrule
	(goal gl-transport-route-state TRANSPORT-ROUTE-RENDEZVOUS-START)
=>
	;The 120-second rendezvous lease includes travel from both sides. It is not
	;the boarding deadline and cannot silently become an unbounded preparation.
	(set-goal gl-assault-admission-last-stage 7)
	(up-modify-goal gl-assault-admission-last-time g:= gl-assault-mission-clock)
	(up-modify-goal gl-assault-rendezvous-until g:= gl-transport-load-clock)
	(up-modify-goal gl-assault-rendezvous-until c:+ 120)
	(up-modify-goal gl-assault-rendezvous-next g:= gl-transport-load-clock)
	(up-modify-goal gl-assault-rendezvous-next c:+ 4)
	(set-goal gl-transport-route-script-load YES)
	(set-goal gl-transport-route-load-terminal TRANSPORT-LOAD-TERMINAL-NONE)
	(set-goal gl-transport-route-load-reported NO)
	(set-goal gl-transport-route-load-grace-used NO)
	(set-goal gl-transport-route-load-candidate-id -1)
	(up-full-reset-search)
	(up-set-group search-local c: attack-transport-group)
	(up-remove-objects search-local object-data-player != my-player-number)
	(up-remove-objects search-local object-data-group-flag != attack-transport-group)
	;OWNERSHIP command: attack-transport-group.
	(up-target-point gl-assault-rendezvous-x action-move -1 stance-no-attack)
	(up-full-reset-search)
	(up-set-group search-local c: attack-boarding-group)
	(up-remove-objects search-local object-data-garrisoned == 1)
	(up-remove-objects search-local object-data-player != my-player-number)
	(up-remove-objects search-local object-data-group-flag != attack-boarding-group)
	(up-add-object-by-id search-remote g: gl-transport-route-id)
	(up-remove-objects search-remote object-data-player != my-player-number)
	(up-remove-objects search-remote object-data-group-flag != attack-transport-group)
	;Ordinary passengers may share this command. Siege members are renewed one
	;at a time below so an obstructed engine cannot formation-stop its peers.
	(up-remove-objects search-local object-data-class == siege-weapon-class)
	;OWNERSHIP command: non-siege attack-boarding-group members.
	(up-target-objects 0 action-garrison -1 stance-no-attack)
	(up-chat-data-to-all str-assault-event c: 23)
	(up-chat-data-to-all str-assault-hull g: gl-transport-route-id)
	(set-goal gl-transport-route-state TRANSPORT-ROUTE-RENDEZVOUS-WAIT)
)

(defrule
	(goal gl-transport-route-state TRANSPORT-ROUTE-RENDEZVOUS-WAIT)
	(up-compare-goal gl-transport-load-clock g:>= gl-assault-rendezvous-next)
=>
	(up-full-reset-search)
	(up-add-object-by-id search-local g: gl-transport-route-id)
	(set-goal gl-transport-route-state TRANSPORT-ROUTE-RENDEZVOUS-CHECK)
)

(defrule
	(goal gl-transport-route-state TRANSPORT-ROUTE-RENDEZVOUS-CHECK)
	(up-set-target-object search-local c: 0)
	(up-object-data object-data-player == my-player-number)
	(up-object-data object-data-group-flag == attack-transport-group)
	(up-object-data object-data-garrison-count g:>= gl-transport-route-load-target)
=>
	;A manifest that boarded while the hull approached is immediately eligible
	;for the normal 30-second load contract and useful-partial sealing logic.
	(up-full-reset-search)
	(up-set-group search-local c: attack-boarding-group)
	(up-remove-objects search-local object-data-garrisoned == 1)
	(up-remove-objects search-local object-data-player != my-player-number)
	(up-remove-objects search-local object-data-group-flag != attack-boarding-group)
	(up-add-object-by-id search-remote g: gl-transport-route-id)
	(up-remove-objects search-remote object-data-player != my-player-number)
	(up-remove-objects search-remote object-data-group-flag != attack-transport-group)
	(set-goal gl-transport-route-state TRANSPORT-ROUTE-LOAD-ISSUE)
)

(defrule
	(goal gl-transport-route-state TRANSPORT-ROUTE-RENDEZVOUS-CHECK)
	(up-set-target-object search-local c: 0)
	(up-object-data object-data-player == my-player-number)
	(up-object-data object-data-group-flag == attack-transport-group)
	(up-object-data object-data-garrison-count g:< gl-transport-route-load-target)
=>
	(up-get-point position-object point-x)
	(up-full-reset-search)
	(up-set-target-point point-x)
	(up-set-group search-local c: attack-boarding-group)
	(up-remove-objects search-local object-data-garrisoned == 1)
	(up-remove-objects search-local object-data-player != my-player-number)
	(up-remove-objects search-local object-data-group-flag != attack-boarding-group)
	(up-clean-search search-local object-data-distance search-order-asc)
	(set-goal gl-transport-route-state TRANSPORT-ROUTE-RENDEZVOUS-PASSENGER)
)

(defrule
	(goal gl-transport-route-state TRANSPORT-ROUTE-RENDEZVOUS-PASSENGER)
	(up-set-target-object search-local c: 0)
	(up-object-data object-data-distance <= 12)
=>
	;Only local proximity starts the existing 30-second boarding timer.
	(up-add-object-by-id search-remote g: gl-transport-route-id)
	(up-remove-objects search-remote object-data-player != my-player-number)
	(up-remove-objects search-remote object-data-group-flag != attack-transport-group)
	(up-chat-data-to-all str-assault-event c: 24)
	(up-chat-data-to-all str-assault-hull g: gl-transport-route-id)
	(set-goal gl-transport-route-state TRANSPORT-ROUTE-LOAD-ISSUE)
)

(defrule
	(goal gl-transport-route-state TRANSPORT-ROUTE-RENDEZVOUS-PASSENGER)
	(not (up-set-target-object search-local c: 0))
=>
	;All reserved survivors are already aboard or unavailable. Let the normal
	;bounded boarding contract classify the exact cargo rather than wait forever.
	(up-set-group search-local c: attack-boarding-group)
	(up-remove-objects search-local object-data-garrisoned == 1)
	(up-remove-objects search-local object-data-player != my-player-number)
	(up-remove-objects search-local object-data-group-flag != attack-boarding-group)
	(up-add-object-by-id search-remote g: gl-transport-route-id)
	(up-remove-objects search-remote object-data-player != my-player-number)
	(up-remove-objects search-remote object-data-group-flag != attack-transport-group)
	(set-goal gl-transport-route-state TRANSPORT-ROUTE-LOAD-ISSUE)
)

(defrule
	(goal gl-transport-route-state TRANSPORT-ROUTE-RENDEZVOUS-PASSENGER)
	(up-set-target-object search-local c: 0)
	(up-object-data object-data-distance > 12)
	(up-compare-goal gl-transport-load-clock g:< gl-assault-rendezvous-until)
=>
	;Renew both halves only every eight seconds. The passenger order follows the
	;moving exact hull while the hull approaches the manifest's saved anchor.
	(up-add-object-by-id search-remote g: gl-transport-route-id)
	(up-remove-objects search-remote object-data-player != my-player-number)
	(up-remove-objects search-remote object-data-group-flag != attack-transport-group)
	(up-remove-objects search-local object-data-player != my-player-number)
	(up-remove-objects search-local object-data-group-flag != attack-boarding-group)
	(up-remove-objects search-local object-data-class == siege-weapon-class)
	;OWNERSHIP command: non-siege attack-boarding-group members.
	(up-target-objects 0 action-garrison -1 stance-no-attack)
	(up-full-reset-search)
	(up-set-group search-local c: attack-transport-group)
	(up-remove-objects search-local object-data-player != my-player-number)
	(up-remove-objects search-local object-data-group-flag != attack-transport-group)
	;OWNERSHIP command: attack-transport-group.
	(up-target-point gl-assault-rendezvous-x action-move -1 stance-no-attack)
	(up-modify-goal gl-assault-rendezvous-next g:= gl-transport-load-clock)
	(up-modify-goal gl-assault-rendezvous-next c:+ 8)
	(set-goal gl-transport-route-state TRANSPORT-ROUTE-RENDEZVOUS-WAIT)
)

(defrule
	(goal gl-transport-route-state TRANSPORT-ROUTE-RENDEZVOUS-PASSENGER)
	(up-set-target-object search-local c: 0)
	(up-object-data object-data-distance > 12)
	(up-compare-goal gl-transport-load-clock g:>= gl-assault-rendezvous-until)
=>
	;Event 25 is a rendezvous timeout, distinct from the later boarding timeout.
	(up-full-reset-search)
	(up-set-group search-local c: attack-transport-group)
	(up-remove-objects search-local object-data-player != my-player-number)
	(up-remove-objects search-local object-data-group-flag != attack-transport-group)
	;OWNERSHIP command: attack-transport-group.
	(up-target-point gl-transport-route-origin-x action-unload -1 stance-no-attack)
	(up-chat-data-to-all str-assault-event c: 25)
	(up-chat-data-to-all str-assault-hull g: gl-transport-route-id)
	(up-set-timer c: t-transport-route c: 15)
	(set-goal gl-route-unload-attempts 0)
	(set-goal gl-transport-route-state TRANSPORT-ROUTE-RECOVERY-WAIT)
)

(defrule
	(goal gl-transport-route-state TRANSPORT-ROUTE-LOAD-ISSUE)
	(up-compare-goal gl-transport-route-load-target c:>= 5)
	(up-set-target-object search-remote c: 0)
=>
	;OWNERSHIP command: non-siege attack-boarding-group members.
	(set-goal gl-assault-admission-last-stage 8)
	(up-modify-goal gl-assault-admission-last-time g:= gl-assault-mission-clock)
	(up-remove-objects search-local object-data-player != my-player-number)
	(up-remove-objects search-local object-data-group-flag != attack-boarding-group)
	(up-remove-objects search-local object-data-class == siege-weapon-class)
	(up-target-objects 0 action-garrison -1 stance-no-attack)
	(set-goal gl-transport-route-script-load YES)
	(set-goal gl-transport-route-load-terminal TRANSPORT-LOAD-TERMINAL-NONE)
	(set-goal gl-transport-route-load-reported NO)
	(set-goal gl-transport-route-load-candidate-id -1)
	(up-modify-goal gl-transport-route-load-deadline g:= gl-transport-load-clock)
	(up-modify-goal gl-transport-route-load-deadline c:+ 30)
	(up-modify-goal gl-transport-route-load-next g:= gl-transport-load-clock)
	(up-modify-goal gl-transport-route-load-next c:+ 4)
	(up-chat-data-to-self "attack lift boarding target: %d" g: gl-transport-route-load-target)
	(set-goal gl-transport-route-state TRANSPORT-ROUTE-LOAD-WAIT)
)

(defrule
	(goal gl-transport-route-state TRANSPORT-ROUTE-LOAD-ISSUE)
	(or
		(up-compare-goal gl-transport-route-load-target c:< 5)
		(not (up-set-target-object search-remote c: 0))
	)
=>
	(up-chat-data-to-self "attack lift passengers unavailable: %d" g: gl-transport-route-load-target)
	(up-modify-group-flag 0 c: attack-boarding-group)
	(up-reset-group c: attack-boarding-group)
	(up-modify-group-flag 0 c: attack-transport-group)
	(up-reset-group c: attack-transport-group)
	(set-goal gl-transport-route-script-load NO)
	(up-modify-sn sn-focus-player-number g:= gl-transport-route-focus)
	(up-set-timer c: t-transport-route c: 30)
	(set-goal gl-transport-route-state TRANSPORT-ROUTE-IDLE)
)

(defrule
	(goal gl-transport-route-state TRANSPORT-ROUTE-LOAD-WAIT)
=>
	(set-strategic-number sn-focus-player-number my-player-number)
	(up-full-reset-search)
	(up-add-object-by-id search-local g: gl-transport-route-id)
	(set-goal gl-transport-route-state TRANSPORT-ROUTE-LOAD-CHECK)
)

(defrule
	(goal gl-transport-route-state TRANSPORT-ROUTE-LOAD-CHECK)
	(up-set-target-object search-local c: 0)
	(up-object-data object-data-garrison-count g:>= gl-transport-route-load-target)
=>
	(up-chat-data-to-self "attack lift ready: %d" g: gl-transport-route-load-target)
	(set-goal gl-assault-admission-last-stage 9)
	(up-modify-goal gl-assault-admission-last-time g:= gl-assault-mission-clock)
	;Seal the accepted manifest, not capacity or a later mutable load target.
	(up-modify-goal gl-assault-manifest-hull g:= gl-transport-route-id)
	(up-modify-goal gl-assault-manifest-count g:= gl-transport-route-load-target)
	(up-chat-data-to-all "RAW44C assault ready hull: %d" g: gl-transport-route-id)
	(up-chat-data-to-all "RAW44C assault ready target: %d" g: gl-transport-route-load-target)
	(up-full-reset-search)
	(set-goal gl-transport-route-state TRANSPORT-ROUTE-LOAD-READY)
)

(defrule
	(goal gl-transport-route-state TRANSPORT-ROUTE-LOAD-CHECK)
	(up-set-target-object search-local c: 0)
	(up-object-data object-data-garrison-count g:< gl-transport-route-load-target)
	(up-compare-goal gl-transport-load-clock g:< gl-transport-route-load-deadline)
	(up-compare-goal gl-transport-load-clock g:>= gl-transport-route-load-next)
	(goal gl-transport-route-load-reported NO)
=>
	;Capture the first passenger that remains ashore before renewing the command.
	;This is bounded to one early sample per lift, so a later manual load cannot
	;erase the state that preceded it from the replay evidence.
	(up-get-object-data object-data-garrison-count gl-transport-route-load-observed)
	(set-goal gl-transport-route-load-terminal TRANSPORT-LOAD-TERMINAL-NONE)
	(set-goal gl-transport-route-state TRANSPORT-ROUTE-LOAD-DIAG-FIND)
)

(defrule
	(goal gl-transport-route-state TRANSPORT-ROUTE-LOAD-CHECK)
	(up-set-target-object search-local c: 0)
	(up-object-data object-data-garrison-count g:< gl-transport-route-load-target)
	(up-compare-goal gl-transport-load-clock g:< gl-transport-route-load-deadline)
	(up-compare-goal gl-transport-load-clock g:>= gl-transport-route-load-next)
	(goal gl-transport-route-load-reported YES)
=>
	;A unit can lose its boarding order while walking. Reissue only on the bounded
	;four-second cadence and only to the still-reserved passengers ashore.
	(up-full-reset-search)
	(up-set-group search-local c: attack-boarding-group)
	(up-remove-objects search-local object-data-garrisoned == 1)
	(up-add-object-by-id search-remote g: gl-transport-route-id)
	(up-remove-objects search-remote object-data-player != my-player-number)
	(up-remove-objects search-remote object-data-group-flag != attack-transport-group)
	;OWNERSHIP command: non-siege attack-boarding-group members.
	(up-remove-objects search-local object-data-player != my-player-number)
	(up-remove-objects search-local object-data-group-flag != attack-boarding-group)
	(up-remove-objects search-local object-data-class == siege-weapon-class)
	(up-target-objects 0 action-garrison -1 stance-no-attack)
	(up-modify-goal gl-transport-route-load-next g:= gl-transport-load-clock)
	(up-modify-goal gl-transport-route-load-next c:+ 4)
	(set-goal gl-transport-route-state TRANSPORT-ROUTE-LOAD-WAIT)
)

(defrule
	(goal gl-transport-route-state TRANSPORT-ROUTE-LOAD-CHECK)
	(up-set-target-object search-local c: 0)
	(up-object-data object-data-garrison-count g:< gl-transport-route-load-target)
	(up-compare-goal gl-transport-load-clock g:< gl-transport-route-load-next)
=>
	(set-goal gl-transport-route-state TRANSPORT-ROUTE-LOAD-WAIT)
)

(defrule
	(goal gl-transport-route-state TRANSPORT-ROUTE-LOAD-CHECK)
	(up-set-target-object search-local c: 0)
	(up-object-data object-data-garrison-count >= 5)
	(up-object-data object-data-garrison-count g:< gl-transport-route-load-target)
	(up-compare-goal gl-transport-load-clock g:>= gl-transport-route-load-deadline)
=>
	;The replay proves that one unboarded tenth passenger repeatedly discarded
	;nine boarded soldiers. Preserve useful strength without leaking home
	;stragglers into the later remote landing order: diagnose one exact remaining
	;passenger, then rebuild the manifest from garrisoned members only.
	(up-get-object-data object-data-garrison-count gl-transport-route-load-observed)
	(up-get-point position-object gl-transport-route-origin-x)
	(set-goal gl-transport-route-load-terminal TRANSPORT-LOAD-TERMINAL-PARTIAL)
	(up-chat-data-to-all "RAW44B attack load partial hull: %d" g: gl-transport-route-id)
	(up-chat-data-to-all "RAW44B attack load target: %d" g: gl-transport-route-load-target)
	(up-chat-data-to-all "RAW44B attack load garrison: %d" g: gl-transport-route-load-observed)
	(set-goal gl-transport-route-state TRANSPORT-ROUTE-LOAD-DIAG-FIND)
)

(defrule
	(goal gl-transport-route-state TRANSPORT-ROUTE-LOAD-CHECK)
	(up-set-target-object search-local c: 0)
	(up-object-data object-data-garrison-count < 5)
	(up-object-data object-data-garrison-count g:< gl-transport-route-load-target)
	(up-compare-goal gl-transport-load-clock g:>= gl-transport-route-load-deadline)
=>
	;Fewer than five soldiers is not a useful assault. Retain the existing abort,
	;but publish the same exact terminal evidence before recovery.
	(up-get-object-data object-data-garrison-count gl-transport-route-load-observed)
	(up-get-point position-object gl-transport-route-origin-x)
	(set-goal gl-transport-route-load-terminal TRANSPORT-LOAD-TERMINAL-ABORT)
	(up-chat-data-to-all "RAW44B attack load abort hull: %d" g: gl-transport-route-id)
	(up-chat-data-to-all "RAW44B attack load target: %d" g: gl-transport-route-load-target)
	(up-chat-data-to-all "RAW44B attack load garrison: %d" g: gl-transport-route-load-observed)
	(set-goal gl-transport-route-state TRANSPORT-ROUTE-LOAD-DIAG-FIND)
)

;Rebuild the exact bounded straggler search without changing its current action
;before the diagnostic captures it. DE omits garrisoned objects from DUC
;searches by default; include both states so the same group can later be reduced
;to its boarded set.
(defrule
	(goal gl-transport-route-state TRANSPORT-ROUTE-LOAD-DIAG-FIND)
=>
	(up-full-reset-search)
	(fe-filter-garrisoned c: 1)
	(up-set-group search-local c: attack-boarding-group)
	(up-remove-objects search-local object-data-garrisoned == 1)
	(up-set-target-point gl-transport-route-origin-x)
	(up-clean-search search-local object-data-distance search-order-asc)
	(up-get-search-state local-total)
	(up-modify-goal gl-transport-route-load-remaining g:= local-total)
	(set-goal gl-transport-route-state TRANSPORT-ROUTE-LOAD-DIAG-PASSENGER)
)

(defrule
	(goal gl-transport-route-state TRANSPORT-ROUTE-LOAD-DIAG-PASSENGER)
	(up-set-target-object search-local c: 0)
=>
	(up-get-object-data object-data-id gl-transport-route-load-candidate-id)
	(up-get-object-data object-data-action gl-transport-route-load-candidate-action)
	(up-get-object-data object-data-distance gl-transport-route-load-candidate-distance)
	(up-get-object-data object-data-map-zone-id gl-transport-route-load-candidate-zone)
	(up-get-object-data object-data-group-flag gl-transport-route-load-candidate-group-flag)
	(up-get-object-data object-data-target-id gl-transport-route-load-candidate-target-id)
	(up-get-object-data object-data-order gl-transport-route-load-candidate-order)
	(up-get-object-data object-data-cmdid gl-transport-route-load-candidate-cmdid)
	(up-get-object-data object-data-move-x gl-transport-route-load-candidate-move-x)
	(up-get-object-data object-data-move-y gl-transport-route-load-candidate-move-y)
	(up-get-object-data object-data-idling gl-transport-route-load-candidate-idling)
	(up-chat-data-to-all "RAW44B attack load remaining: %d" g: gl-transport-route-load-remaining)
	(up-chat-data-to-all "RAW44B attack candidate id: %d" g: gl-transport-route-load-candidate-id)
	(up-chat-data-to-all "RAW44B attack candidate action: %d" g: gl-transport-route-load-candidate-action)
	(up-chat-data-to-all "RAW44B attack candidate target: %d" g: gl-transport-route-load-candidate-target-id)
	(up-chat-data-to-all "RAW44B attack candidate order: %d" g: gl-transport-route-load-candidate-order)
	(up-chat-data-to-all "RAW44B attack candidate cmd: %d" g: gl-transport-route-load-candidate-cmdid)
	(up-chat-data-to-all "RAW44B attack candidate distance: %d" g: gl-transport-route-load-candidate-distance)
	(up-chat-data-to-all "RAW44B attack candidate zone: %d" g: gl-transport-route-load-candidate-zone)
	(up-chat-data-to-all "RAW44B attack candidate group: %d" g: gl-transport-route-load-candidate-group-flag)
	(up-chat-data-to-all "RAW44B attack candidate move x: %d" g: gl-transport-route-load-candidate-move-x)
	(up-chat-data-to-all "RAW44B attack candidate move y: %d" g: gl-transport-route-load-candidate-move-y)
	(up-chat-data-to-all "RAW44B attack candidate idling: %d" g: gl-transport-route-load-candidate-idling)
	(set-goal gl-transport-route-state TRANSPORT-ROUTE-LOAD-DIAG-APPLY)
)

(defrule
	(goal gl-transport-route-state TRANSPORT-ROUTE-LOAD-DIAG-PASSENGER)
	(not (up-set-target-object search-local c: 0))
=>
	(set-goal gl-transport-route-load-candidate-id -1)
	(up-chat-data-to-all "RAW44B attack load remaining: %d" g: gl-transport-route-load-remaining)
	(up-chat-data-to-all "RAW44B attack candidate missing: %d" c: -1)
	(set-goal gl-transport-route-state TRANSPORT-ROUTE-LOAD-DIAG-APPLY)
)

(defrule
	(goal gl-transport-route-state TRANSPORT-ROUTE-LOAD-DIAG-APPLY)
	(goal gl-transport-route-load-terminal TRANSPORT-LOAD-TERMINAL-NONE)
=>
	;Resume the ordinary bounded retry after the one early diagnostic sample.
	(up-full-reset-search)
	(fe-filter-garrisoned c: 1)
	(up-set-group search-local c: attack-boarding-group)
	(up-remove-objects search-local object-data-garrisoned == 1)
	(up-add-object-by-id search-remote g: gl-transport-route-id)
	(up-remove-objects search-remote object-data-player != my-player-number)
	(up-remove-objects search-remote object-data-group-flag != attack-transport-group)
	;OWNERSHIP command: attack-boarding-group.
	(up-remove-objects search-local object-data-player != my-player-number)
	(up-remove-objects search-local object-data-group-flag != attack-boarding-group)
	(up-remove-objects search-local object-data-class == siege-weapon-class)
	(up-target-objects 0 action-garrison -1 stance-no-attack)
	(set-goal gl-transport-route-load-reported YES)
	(up-modify-goal gl-transport-route-load-next g:= gl-transport-load-clock)
	(up-modify-goal gl-transport-route-load-next c:+ 4)
	(set-goal gl-transport-route-state TRANSPORT-ROUTE-LOAD-WAIT)
)

(defrule
	(goal gl-transport-route-state TRANSPORT-ROUTE-LOAD-DIAG-APPLY)
	(or
		(goal gl-transport-route-load-terminal TRANSPORT-LOAD-TERMINAL-PARTIAL)
		(goal gl-transport-route-load-terminal TRANSPORT-LOAD-TERMINAL-ABORT)
	)
	(goal gl-transport-route-load-grace-used NO)
	(up-compare-goal gl-transport-route-load-candidate-id c:>= 0)
	(up-compare-goal gl-transport-route-load-candidate-group-flag c:== attack-boarding-group)
	(up-compare-goal gl-transport-route-load-candidate-target-id g:== gl-transport-route-id)
	(up-compare-goal gl-transport-route-load-candidate-distance c:<= 12)
	(or
		(up-compare-goal gl-transport-route-load-candidate-action c:== action-garrison)
		(up-compare-goal gl-transport-route-load-candidate-order c:== orderid-transport)
	)
=>
	;T25 repeatedly reached the fixed deadline with the next accepted passenger
	;still obeying the exact hull order only one to four tiles away. Give that
	;specific live manifest one bounded grace period; all existing useful-partial
	;and abort terminals remain authoritative after it expires.
	(up-full-reset-search)
	(fe-filter-garrisoned c: 1)
	(up-set-group search-local c: attack-boarding-group)
	(up-remove-objects search-local object-data-garrisoned == 1)
	(up-add-object-by-id search-remote g: gl-transport-route-id)
	(up-remove-objects search-remote object-data-player != my-player-number)
	(up-remove-objects search-remote object-data-group-flag != attack-transport-group)
	(up-remove-objects search-local object-data-player != my-player-number)
	(up-remove-objects search-local object-data-group-flag != attack-boarding-group)
	(up-remove-objects search-local object-data-class == siege-weapon-class)
	;OWNERSHIP command: non-siege attack-boarding-group members.
	(up-target-objects 0 action-garrison -1 stance-no-attack)
	(set-goal gl-transport-route-load-grace-used YES)
	(set-goal gl-transport-route-load-terminal TRANSPORT-LOAD-TERMINAL-NONE)
	(up-modify-goal gl-transport-route-load-deadline g:= gl-transport-load-clock)
	(up-modify-goal gl-transport-route-load-deadline c:+ 12)
	(up-modify-goal gl-transport-route-load-next g:= gl-transport-load-clock)
	(up-modify-goal gl-transport-route-load-next c:+ 4)
	(set-goal gl-transport-route-state TRANSPORT-ROUTE-LOAD-WAIT)
)

(defrule
	(goal gl-transport-route-state TRANSPORT-ROUTE-LOAD-DIAG-APPLY)
	(goal gl-transport-route-load-terminal TRANSPORT-LOAD-TERMINAL-PARTIAL)
=>
	;Stop only the diagnosed shore stragglers, then snapshot the actually boarded
	;members before replacing the original manifest group. Home stragglers cannot
	;receive the remote landing order after this exact rebuild.
	(up-full-reset-search)
	(fe-filter-garrisoned c: 1)
	(up-set-group search-local c: attack-boarding-group)
	(up-remove-objects search-local object-data-garrisoned == 1)
	;OWNERSHIP command: attack-boarding-group.
	(up-remove-objects search-local object-data-player != my-player-number)
	(up-remove-objects search-local object-data-group-flag != attack-boarding-group)
	; RAW12 counter 14
	(up-modify-goal gl-command-counter-14 c:+ 1)
	(up-target-point position-self-x action-stop -1 stance-no-attack)
	(up-full-reset-search)
	(fe-filter-garrisoned c: 1)
	(up-set-group search-local c: attack-boarding-group)
	(up-remove-objects search-local object-data-garrisoned != 1)
	(set-goal gl-transport-route-state TRANSPORT-ROUTE-LOAD-PARTIAL-MANIFEST)
)

;Cancel native exploration before this first explicit land claim.
(defrule
	(goal gl-transport-route-state TRANSPORT-ROUTE-LOAD-PARTIAL-MANIFEST)
	(goal gl-owner-explore-suspended NO)
=>
	(set-strategic-number sn-number-explore-groups 0)
	(set-strategic-number sn-total-number-explorers 0)
	(set-strategic-number sn-cap-civilian-explorers 0)
	(set-strategic-number sn-minimum-civilian-explorers 0)
	; RAW12 counter 15
	(up-modify-goal gl-command-counter-15 c:+ 1)
	(up-reset-scouts)
	(set-goal gl-owner-explore-suspended YES)
)

(defrule
	(goal gl-transport-route-state TRANSPORT-ROUTE-LOAD-PARTIAL-MANIFEST)
=>
	(up-modify-group-flag 0 c: attack-boarding-group)
	(up-reset-group c: attack-boarding-group)
	;OWNERSHIP acquire: only FREE objects may be claimed.
	(up-remove-objects search-local object-data-player != my-player-number)
	(up-remove-objects search-local object-data-group-flag >= 0)
	(up-create-group 0 0 c: attack-boarding-group)
	(up-modify-group-flag 1 c: attack-boarding-group)
	(up-modify-goal gl-transport-route-load-target g:= gl-transport-route-load-observed)
	;The existing partial acceptance has rebuilt the boarded-only manifest.
	(up-modify-goal gl-assault-manifest-hull g:= gl-transport-route-id)
	(up-modify-goal gl-assault-manifest-count g:= gl-transport-route-load-observed)
	(set-goal gl-assault-admission-last-stage 9)
	(up-modify-goal gl-assault-admission-last-time g:= gl-assault-mission-clock)
	(up-chat-data-to-all "RAW44B attack partial departure: %d" g: gl-transport-route-load-observed)
	(set-goal gl-transport-route-load-terminal TRANSPORT-LOAD-TERMINAL-NONE)
	(up-full-reset-search)
	(set-goal gl-transport-route-state TRANSPORT-ROUTE-LOAD-READY)
)

(defrule
	(goal gl-transport-route-state TRANSPORT-ROUTE-LOAD-DIAG-APPLY)
	(goal gl-transport-route-load-terminal TRANSPORT-LOAD-TERMINAL-ABORT)
=>
	(up-full-reset-search)
	(up-add-object-by-id search-local g: gl-transport-route-id)
	;OWNERSHIP command: attack-transport-group.
	(up-remove-objects search-local object-data-player != my-player-number)
	(up-remove-objects search-local object-data-group-flag != attack-transport-group)
	(up-target-point gl-transport-route-origin-x action-unload -1 stance-no-attack)
	(up-chat-data-to-self "attack lift boarding aborted: %d" g: gl-transport-route-load-target)
	(up-chat-data-to-all "RAW44B attack load terminal abort: %d" g: gl-transport-route-load-observed)
	(up-modify-sn sn-focus-player-number g:= gl-transport-route-focus)
	;Retain both exact groups until the recovery owner proves the hull empty and
	;back at its origin. Releasing here lets another subsystem steal a partial.
	(set-goal gl-transport-route-load-terminal TRANSPORT-LOAD-TERMINAL-NONE)
	(up-set-timer c: t-transport-route c: 15)
	(set-goal gl-route-unload-attempts 0)
	(set-goal gl-transport-route-state TRANSPORT-ROUTE-RECOVERY-WAIT)
)

(defrule
	(goal gl-transport-route-state TRANSPORT-ROUTE-LOAD-CHECK)
	(not (up-set-target-object search-local c: 0))
=>
	(up-modify-group-flag 0 c: attack-boarding-group)
	(up-reset-group c: attack-boarding-group)
	(up-modify-group-flag 0 c: attack-transport-group)
	(up-reset-group c: attack-transport-group)
	(set-goal gl-transport-route-script-load NO)
	(up-chat-data-to-self "attack lift transport lost: %d" g: gl-transport-route-id)
	(up-modify-sn sn-focus-player-number g:= gl-transport-route-focus)
	(up-set-timer c: t-transport-route c: 30)
	(set-goal gl-transport-route-state TRANSPORT-ROUTE-IDLE)
)

;The engine formation-couples a multi-siege action-garrison order. Runtime T36
;showed correctly reserved passengers, still targeting the exact hull from two
;to nine tiles away, stop together when one siege engine was obstructed. Keep
;the existing group command for ordinary passengers, then independently renew
;one reserved shore-side siege engine per second. The manifest, target hull,
;30-second boarding deadline, partial threshold and ownership never change.
(defrule
	(or
		(goal gl-transport-route-state TRANSPORT-ROUTE-RENDEZVOUS-WAIT)
		(goal gl-transport-route-state TRANSPORT-ROUTE-LOAD-WAIT)
	)
	(up-compare-goal gl-transport-load-clock g:>= gl-assault-siege-board-next)
=>
	(up-full-reset-search)
	(up-set-group search-local c: attack-boarding-group)
	(up-remove-objects search-local object-data-garrisoned == 1)
	(up-remove-objects search-local object-data-player != my-player-number)
	(up-remove-objects search-local object-data-group-flag != attack-boarding-group)
	(up-remove-objects search-local object-data-class != siege-weapon-class)
	(up-clean-search search-local object-data-id search-order-asc)
	(up-get-search-state local-total)
	(up-modify-goal gl-assault-siege-board-count g:= local-total)
	(up-remove-objects search-local object-data-index g:!= gl-assault-siege-board-index)
	(up-add-object-by-id search-remote g: gl-transport-route-id)
	(up-remove-objects search-remote object-data-player != my-player-number)
	(up-remove-objects search-remote object-data-group-flag != attack-transport-group)
	;OWNERSHIP command: one attack-boarding-group siege member.
	(up-target-objects 0 action-garrison -1 stance-no-attack)
	(up-modify-goal gl-assault-siege-board-index c:+ 1)
	(up-modify-goal gl-assault-siege-board-next g:= gl-transport-load-clock)
	(up-modify-goal gl-assault-siege-board-next c:+ 1)
)

(defrule
	(up-compare-goal gl-assault-siege-board-index g:>= gl-assault-siege-board-count)
=>
	(set-goal gl-assault-siege-board-index 0)
)

;Ownership preemption is handled by rawai-severe-defense.

(defrule
	(goal gl-transport-route-state TRANSPORT-ROUTE-FIND)
	(not (up-set-target-object search-remote c: 0))
=>
	(up-modify-sn sn-focus-player-number g:= gl-transport-route-focus)
	(up-set-timer c: t-transport-route c: 20)
	(set-goal gl-transport-route-state TRANSPORT-ROUTE-IDLE)
)

;T19: bounded approach/objective/enemy search retains the accepted load.
(load "rawai-assault-plans")

;Landing safety alone is insufficient: a direct engine path can spend its whole
;voyage inside a tower's range. Sample both sides of the route at its midpoint
;and force the loaded ship through the less-defended lateral waypoint. All
;midpoints now originate at the validated water-side shoreline approach.
(defrule
	(goal gl-transport-route-state TRANSPORT-ROUTE-CORRIDOR-PREPARE)
=>
	(up-bound-point gl-transport-route-waypoint-left-x gl-ap-shore-selected-water-x)
	(up-lerp-percent gl-transport-route-waypoint-left-x gl-transport-route-origin-x c: 50)
	(up-full-reset-search)
	(up-set-target-point gl-transport-route-waypoint-left-x)
	(up-filter-distance c: -1 c: 20)
	(up-find-remote c: tower-class c: 40)
	(up-find-remote c: sea-tower c: 10)
	(up-find-remote c: castle c: 10)
	(up-find-remote c: town-center c: 10)
	(up-get-search-state local-total)
	(set-goal gl-transport-route-state TRANSPORT-ROUTE-CORRIDOR-DIRECT)
)

(defrule
	(goal gl-transport-route-state TRANSPORT-ROUTE-CORRIDOR-DIRECT)
=>
	(up-modify-goal gl-ap-direct-threats g:= remote-total)
	(up-bound-point gl-transport-route-waypoint-left-x gl-ap-shore-selected-water-x)
	(up-lerp-percent gl-transport-route-waypoint-left-x gl-transport-route-origin-x c: 50)
	(up-cross-tiles gl-transport-route-waypoint-left-x gl-transport-route-origin-x c: 26)
	(up-full-reset-search)
	(up-set-target-point gl-transport-route-waypoint-left-x)
	(up-filter-distance c: -1 c: 20)
	(up-find-remote c: tower-class c: 40)
	(up-find-remote c: sea-tower c: 10)
	(up-find-remote c: castle c: 10)
	(up-find-remote c: town-center c: 10)
	(up-get-search-state local-total)
	(set-goal gl-transport-route-state TRANSPORT-ROUTE-CORRIDOR-LEFT)
)

(defrule
	(goal gl-transport-route-state TRANSPORT-ROUTE-CORRIDOR-LEFT)
=>
	(up-modify-goal gl-transport-route-corridor-left-threats g:= remote-total)
	(up-bound-point gl-transport-route-waypoint-right-x gl-ap-shore-selected-water-x)
	(up-lerp-percent gl-transport-route-waypoint-right-x gl-transport-route-origin-x c: 50)
	(up-cross-tiles gl-transport-route-waypoint-right-x gl-transport-route-origin-x c: -26)
	(up-full-reset-search)
	(up-set-target-point gl-transport-route-waypoint-right-x)
	(up-filter-distance c: -1 c: 20)
	(up-find-remote c: tower-class c: 40)
	(up-find-remote c: sea-tower c: 10)
	(up-find-remote c: castle c: 10)
	(up-find-remote c: town-center c: 10)
	(up-get-search-state local-total)
	(set-goal gl-transport-route-state TRANSPORT-ROUTE-CORRIDOR-RIGHT)
)

(defrule
	(goal gl-transport-route-state TRANSPORT-ROUTE-CORRIDOR-RIGHT)
=>
	(up-modify-goal gl-transport-route-corridor-right-threats g:= remote-total)
	(generate-random-number 1)
	(up-get-fact random-number 0 gl-transport-route-random)
	(set-goal gl-transport-route-state TRANSPORT-ROUTE-CORRIDOR-APPLY)
)

(defrule
	(goal gl-transport-route-state TRANSPORT-ROUTE-CORRIDOR-APPLY)
	(up-compare-goal gl-transport-route-corridor-left-threats c:> 0)
	(up-compare-goal gl-transport-route-corridor-right-threats c:> 0)
=>
	(set-goal gl-transport-route-state TRANSPORT-ROUTE-CORRIDOR-WIDE-PREPARE)
)

(defrule
	(goal gl-transport-route-state TRANSPORT-ROUTE-CORRIDOR-APPLY)
	(or
		(up-compare-goal gl-transport-route-corridor-left-threats g:< gl-transport-route-corridor-right-threats)
		(and
			(up-compare-goal gl-transport-route-corridor-left-threats g:== gl-transport-route-corridor-right-threats)
			(up-compare-goal gl-transport-route-random c:== 0)
		)
	)
=>
	(up-bound-point gl-transport-route-waypoint-x gl-transport-route-waypoint-left-x)
	(set-goal gl-transport-screen-waits 0)
	(set-goal gl-transport-route-state AP-PATH)
)

;If both ordinary corridors are covered, sample a much wider pair instead of
;accepting the less dangerous route.  The transport departs only when one of
;the wide corridors has no known Tower, Castle, Town Center, or Sea Tower.
(defrule
	(goal gl-transport-route-state TRANSPORT-ROUTE-CORRIDOR-WIDE-PREPARE)
=>
	(up-bound-point gl-transport-route-waypoint-left-x gl-ap-shore-selected-water-x)
	(up-lerp-percent gl-transport-route-waypoint-left-x gl-transport-route-origin-x c: 50)
	(up-cross-tiles gl-transport-route-waypoint-left-x gl-transport-route-origin-x c: 52)
	(up-full-reset-search)
	(up-set-target-point gl-transport-route-waypoint-left-x)
	(up-filter-distance c: -1 c: 24)
	(up-find-remote c: tower-class c: 40)
	(up-find-remote c: sea-tower c: 10)
	(up-find-remote c: castle c: 10)
	(up-find-remote c: town-center c: 10)
	(up-get-search-state local-total)
	(set-goal gl-transport-route-state TRANSPORT-ROUTE-CORRIDOR-WIDE-LEFT)
)

(defrule
	(goal gl-transport-route-state TRANSPORT-ROUTE-CORRIDOR-WIDE-LEFT)
=>
	(up-modify-goal gl-transport-route-corridor-left-threats g:= remote-total)
	(up-bound-point gl-transport-route-waypoint-right-x gl-ap-shore-selected-water-x)
	(up-lerp-percent gl-transport-route-waypoint-right-x gl-transport-route-origin-x c: 50)
	(up-cross-tiles gl-transport-route-waypoint-right-x gl-transport-route-origin-x c: -52)
	(up-full-reset-search)
	(up-set-target-point gl-transport-route-waypoint-right-x)
	(up-filter-distance c: -1 c: 24)
	(up-find-remote c: tower-class c: 40)
	(up-find-remote c: sea-tower c: 10)
	(up-find-remote c: castle c: 10)
	(up-find-remote c: town-center c: 10)
	(up-get-search-state local-total)
	(set-goal gl-transport-route-state TRANSPORT-ROUTE-CORRIDOR-WIDE-RIGHT)
)

(defrule
	(goal gl-transport-route-state TRANSPORT-ROUTE-CORRIDOR-WIDE-RIGHT)
=>
	(up-modify-goal gl-transport-route-corridor-right-threats g:= remote-total)
	(generate-random-number 1)
	(up-get-fact random-number 0 gl-transport-route-random)
	(set-goal gl-transport-route-state TRANSPORT-ROUTE-CORRIDOR-WIDE-APPLY)
)

(defrule
	(goal gl-transport-route-state TRANSPORT-ROUTE-CORRIDOR-WIDE-APPLY)
	(up-compare-goal gl-transport-route-corridor-left-threats c:> 0)
	(up-compare-goal gl-transport-route-corridor-right-threats c:> 0)
=>
	(set-goal gl-ap-failure 2)
	(set-goal gl-transport-route-state AP-FAIL)
)

(defrule
	(goal gl-transport-route-state TRANSPORT-ROUTE-CORRIDOR-WIDE-APPLY)
	(or
		(up-compare-goal gl-transport-route-corridor-left-threats g:< gl-transport-route-corridor-right-threats)
		(and
			(up-compare-goal gl-transport-route-corridor-left-threats g:== gl-transport-route-corridor-right-threats)
			(up-compare-goal gl-transport-route-random c:== 0)
		)
	)
=>
	(up-bound-point gl-transport-route-waypoint-x gl-transport-route-waypoint-left-x)
	(set-goal gl-transport-screen-waits 0)
	(set-goal gl-transport-route-state AP-PATH)
)

(defrule
	(goal gl-transport-route-state TRANSPORT-ROUTE-CORRIDOR-WIDE-APPLY)
	(or
		(up-compare-goal gl-transport-route-corridor-right-threats g:< gl-transport-route-corridor-left-threats)
		(and
			(up-compare-goal gl-transport-route-corridor-left-threats g:== gl-transport-route-corridor-right-threats)
			(up-compare-goal gl-transport-route-random c:== 1)
		)
	)
=>
	(up-bound-point gl-transport-route-waypoint-x gl-transport-route-waypoint-right-x)
	(set-goal gl-transport-screen-waits 0)
	(set-goal gl-transport-route-state AP-PATH)
)

(defrule
	(goal gl-transport-route-state TRANSPORT-ROUTE-CORRIDOR-APPLY)
	(or
		(up-compare-goal gl-transport-route-corridor-right-threats g:< gl-transport-route-corridor-left-threats)
		(and
			(up-compare-goal gl-transport-route-corridor-left-threats g:== gl-transport-route-corridor-right-threats)
			(up-compare-goal gl-transport-route-random c:== 1)
		)
	)
=>
	(up-bound-point gl-transport-route-waypoint-x gl-transport-route-waypoint-right-x)
	(set-goal gl-transport-screen-waits 0)
	(set-goal gl-transport-route-state AP-PATH)
)

;Prefer a Scout Ship exposing the route. Soft screening failures can use the
;accepted-manifest fallback below; actual fire/loss/defenses veto that
;candidate and enter bounded replanning, not automatic recall.
(defrule
	(goal gl-transport-route-state TRANSPORT-ROUTE-SCREEN-FIND)
	(or (goal gl-ap-active NO) (goal gl-ap-screen-validated YES))
	(up-timer-status t-transport-route == timer-triggered)
=>
	(set-strategic-number sn-focus-player-number my-player-number)
	(up-full-reset-search)
	(up-set-target-point gl-transport-route-origin-x)
	(up-filter-distance c: -1 c: 80)
	(up-find-local c: scout-galley-line c: 10)
	(up-remove-objects search-local object-data-under-attack > 0)
	(up-remove-objects search-local object-data-group-flag >= 0)
	(up-clean-search search-local object-data-distance search-order-asc)
	(set-goal gl-transport-route-state TRANSPORT-ROUTE-SCREEN-CHECK)
)

(defrule
	(goal gl-transport-route-state TRANSPORT-ROUTE-SCREEN-CHECK)
	(up-set-target-object search-local c: 0)
=>
	(up-get-object-data object-data-id gl-transport-screen-id)
	(up-get-object-data object-data-hitpoints gl-assault-screen-start-hp)
	(set-goal gl-transport-screen-waits 0)
	(up-modify-group-flag 0 c: transport-screen-group)
	(up-reset-group c: transport-screen-group)
	(up-full-reset-search)
	(up-add-object-by-id search-local g: gl-transport-screen-id)
		(up-remove-objects search-local object-data-player != my-player-number)
	(up-remove-objects search-local object-data-group-flag >= 0)
	(up-remove-objects search-local object-data-order == orderid-transport)
	(up-remove-objects search-local object-data-order == orderid-unload)
	(up-create-group 0 0 c: transport-screen-group)
	(up-modify-group-flag 1 c: transport-screen-group)
		(up-remove-objects search-local object-data-player != my-player-number)
	(up-remove-objects search-local object-data-group-flag != transport-screen-group)
	(up-target-point gl-transport-route-waypoint-x action-move -1 stance-no-attack)
	(up-modify-sn sn-focus-player-number g:= gl-transport-route-focus)
	(up-set-timer c: t-transport-route c: 30)
	(set-goal gl-transport-route-state TRANSPORT-ROUTE-SCREEN-WAIT)
)

(defrule
	(goal gl-transport-route-state TRANSPORT-ROUTE-SCREEN-CHECK)
	(not (up-set-target-object search-local c: 0))
=>
	;No free scout is a capability shortage, not affirmative route danger.
	(set-goal gl-assault-fallback-reason 3)
	(set-goal gl-transport-route-state TRANSPORT-ROUTE-UNSCREENED-START)
)

(defrule
	(goal gl-transport-route-state TRANSPORT-ROUTE-SCREEN-WAIT)
	(up-timer-status t-transport-route == timer-triggered)
=>
	(set-strategic-number sn-focus-player-number my-player-number)
	(up-full-reset-search)
	(up-set-target-point gl-transport-route-waypoint-x)
	(up-add-object-by-id search-local g: gl-transport-screen-id)
	(up-remove-objects search-local object-data-player != my-player-number)
	(up-remove-objects search-local object-data-group-flag != transport-screen-group)
	(set-goal gl-transport-route-state TRANSPORT-ROUTE-SCREEN-THREAT)
)

(defrule
	(goal gl-transport-route-state TRANSPORT-ROUTE-SCREEN-THREAT)
	(up-set-target-object search-local c: 0)
	(or (up-object-data object-data-under-attack > 0)
		(up-object-data object-data-hitpoints g:< gl-assault-screen-start-hp))
=>
	(set-goal gl-ap-failure 4)
	(set-goal gl-transport-route-state AP-FAIL)
)

(defrule
	(goal gl-transport-route-state TRANSPORT-ROUTE-SCREEN-THREAT)
	(up-set-target-object search-local c: 0)
	(up-object-data object-data-distance > 10)
	(up-compare-goal gl-transport-screen-waits c:< 4)
=>
	;OWNERSHIP command: transport-screen-group.
	(up-remove-objects search-local object-data-player != my-player-number)
	(up-remove-objects search-local object-data-group-flag != transport-screen-group)
	(up-target-point gl-transport-route-waypoint-x action-move -1 stance-no-attack)
	(up-modify-sn sn-focus-player-number g:= gl-transport-route-focus)
	(up-modify-goal gl-transport-screen-waits c:+ 1)
	(up-set-timer c: t-transport-route c: 15)
	(set-goal gl-transport-route-state TRANSPORT-ROUTE-SCREEN-WAIT)
)

(defrule
	(goal gl-transport-route-state TRANSPORT-ROUTE-SCREEN-THREAT)
	(up-set-target-object search-local c: 0)
	(up-object-data object-data-distance > 10)
	(up-compare-goal gl-transport-screen-waits c:>= 4)
=>
	(set-goal gl-assault-fallback-reason 5)
	(set-goal gl-transport-route-state TRANSPORT-ROUTE-UNSCREENED-START)
)

(defrule
	(goal gl-transport-route-state TRANSPORT-ROUTE-SCREEN-THREAT)
	(up-set-target-object search-local c: 0)
	(up-object-data object-data-distance <= 10)
=>
	(up-modify-sn sn-focus-player-number g:= gl-assault-manifest-player)
	(up-full-reset-search)
	(up-set-target-point gl-transport-route-waypoint-x)
	(up-filter-distance c: -1 c: 20)
	(up-find-remote c: tower-class c: 40)
	(up-find-remote c: sea-tower c: 10)
	(up-find-remote c: castle c: 10)
	(up-find-remote c: town-center c: 10)
	(up-get-search-state local-total)
	(set-goal gl-transport-route-state TRANSPORT-ROUTE-SCREEN-APPLY)
)

(defrule
	(goal gl-transport-route-state TRANSPORT-ROUTE-SCREEN-THREAT)
	(not (up-set-target-object search-local c: 0))
=>
	(set-goal gl-ap-failure 6)
	(set-goal gl-transport-route-state AP-FAIL)
)

(defrule
	(goal gl-transport-route-state TRANSPORT-ROUTE-SCREEN-APPLY)
	(up-compare-goal remote-total <= 0)
=>
	(set-strategic-number sn-focus-player-number my-player-number)
	(up-full-reset-search)
	(up-add-object-by-id search-local g: gl-transport-screen-id)
	;OWNERSHIP command: transport-screen-group.
	(up-remove-objects search-local object-data-player != my-player-number)
	(up-remove-objects search-local object-data-group-flag != transport-screen-group)
	(up-target-point gl-transport-route-landing-x action-move -1 stance-no-attack)
	(up-modify-sn sn-focus-player-number g:= gl-transport-route-focus)
	(set-goal gl-transport-screen-waits 0)
	(up-set-timer c: t-transport-route c: 30)
	(set-goal gl-transport-route-state TRANSPORT-ROUTE-SCREEN-LANDING-WAIT)
)

(defrule
	(goal gl-transport-route-state TRANSPORT-ROUTE-SCREEN-APPLY)
	(up-compare-goal remote-total > 0)
=>
	(set-goal gl-ap-failure 7)
	(set-goal gl-transport-route-state AP-FAIL)
)

;After the midpoint is safe, the same reserved scout exposes the landing beach
;before the loaded transport moves. A beach point need only be approached
;within ten tiles because the geometric landing target itself can be on land.
(defrule
	(goal gl-transport-route-state TRANSPORT-ROUTE-SCREEN-LANDING-WAIT)
	(up-timer-status t-transport-route == timer-triggered)
=>
	(set-strategic-number sn-focus-player-number my-player-number)
	(up-full-reset-search)
	(up-set-target-point gl-transport-route-landing-x)
	(up-add-object-by-id search-local g: gl-transport-screen-id)
	(up-remove-objects search-local object-data-player != my-player-number)
	(up-remove-objects search-local object-data-group-flag != transport-screen-group)
	(set-goal gl-transport-route-state TRANSPORT-ROUTE-SCREEN-LANDING-THREAT)
)

(defrule
	(goal gl-transport-route-state TRANSPORT-ROUTE-SCREEN-LANDING-THREAT)
	(up-set-target-object search-local c: 0)
	(or (up-object-data object-data-under-attack > 0)
		(up-object-data object-data-hitpoints g:< gl-assault-screen-start-hp))
=>
	(set-goal gl-ap-failure 8)
	(set-goal gl-transport-route-state AP-FAIL)
)

(defrule
	(goal gl-transport-route-state TRANSPORT-ROUTE-SCREEN-LANDING-THREAT)
	(up-set-target-object search-local c: 0)
	(up-object-data object-data-distance > 10)
	(up-compare-goal gl-transport-screen-waits c:< 4)
=>
	;OWNERSHIP command: transport-screen-group.
	(up-remove-objects search-local object-data-player != my-player-number)
	(up-remove-objects search-local object-data-group-flag != transport-screen-group)
	(up-target-point gl-transport-route-landing-x action-move -1 stance-no-attack)
	(up-modify-sn sn-focus-player-number g:= gl-transport-route-focus)
	(up-modify-goal gl-transport-screen-waits c:+ 1)
	(up-set-timer c: t-transport-route c: 15)
	(set-goal gl-transport-route-state TRANSPORT-ROUTE-SCREEN-LANDING-WAIT)
)

(defrule
	(goal gl-transport-route-state TRANSPORT-ROUTE-SCREEN-LANDING-THREAT)
	(up-set-target-object search-local c: 0)
	(up-object-data object-data-distance > 10)
	(up-compare-goal gl-transport-screen-waits c:>= 4)
=>
	(set-goal gl-assault-fallback-reason 9)
	(set-goal gl-transport-route-state TRANSPORT-ROUTE-UNSCREENED-START)
)

(defrule
	(goal gl-transport-route-state TRANSPORT-ROUTE-SCREEN-LANDING-THREAT)
	(up-set-target-object search-local c: 0)
	(up-object-data object-data-distance <= 10)
=>
	(up-modify-sn sn-focus-player-number g:= gl-assault-manifest-player)
	(up-full-reset-search)
	(up-set-target-point gl-transport-route-landing-x)
	(up-filter-distance c: -1 c: 20)
	(up-find-remote c: tower-class c: 40)
	(up-find-remote c: sea-tower c: 10)
	(up-find-remote c: castle c: 10)
	(up-find-remote c: town-center c: 10)
	(up-get-search-state local-total)
	(set-goal gl-transport-route-state TRANSPORT-ROUTE-SCREEN-LANDING-APPLY)
)

(defrule
	(goal gl-transport-route-state TRANSPORT-ROUTE-SCREEN-LANDING-THREAT)
	(not (up-set-target-object search-local c: 0))
=>
	(set-goal gl-ap-failure 10)
	(set-goal gl-transport-route-state AP-FAIL)
)

(defrule
	(goal gl-transport-route-state TRANSPORT-ROUTE-SCREEN-LANDING-APPLY)
	(up-compare-goal remote-total <= 0)
=>
	;The route-screen Scout has finished its job at the exact landing and must not
	;remain parked on the unload point. Stage it to one side of the screened
	;approach before releasing its ownership; the loaded hull is still at home,
	;so the Scout has the entire departure leg to clear eighteen tiles.
	(set-strategic-number sn-focus-player-number my-player-number)
	(up-bound-point point-x gl-transport-route-landing-x)
	(up-cross-tiles point-x gl-transport-route-waypoint-x c: 18)
	(up-full-reset-search)
	(up-add-object-by-id search-local g: gl-transport-screen-id)
	;OWNERSHIP command: transport-screen-group.
	(up-remove-objects search-local object-data-player != my-player-number)
	(up-remove-objects search-local object-data-group-flag != transport-screen-group)
	(up-target-point point-x action-move -1 stance-aggressive)
	(up-chat-data-to-all "RAW44T2 route-screen landing cleared: %d" g: gl-transport-screen-id)
	(up-modify-group-flag 0 c: transport-screen-group)
	(up-reset-group c: transport-screen-group)
	(set-goal gl-transport-screen-id -1)
	(up-modify-sn sn-focus-player-number g:= gl-transport-route-focus)
	(set-goal gl-transport-route-state AP-FINAL-SAFETY)
)

(defrule
	(goal gl-transport-route-state TRANSPORT-ROUTE-SCREEN-LANDING-APPLY)
	(up-compare-goal remote-total > 0)
=>
	(set-goal gl-ap-failure 11)
	(set-goal gl-transport-route-state AP-FAIL)
)

(load "rawai-assault-screen-fallback")

(defrule
	(goal gl-transport-route-state TRANSPORT-ROUTE-SCREEN-RECALL)
=>
	(set-strategic-number sn-focus-player-number my-player-number)
	(up-full-reset-search)
	(up-add-object-by-id search-local g: gl-transport-screen-id)
	;OWNERSHIP command: transport-screen-group.
	(up-remove-objects search-local object-data-player != my-player-number)
	(up-remove-objects search-local object-data-group-flag != transport-screen-group)
	(up-target-point gl-transport-route-origin-x action-move -1 stance-no-attack)
	(up-full-reset-search)
	(up-add-object-by-id search-local g: gl-transport-route-id)
	;OWNERSHIP command: attack-transport-group.
	(up-remove-objects search-local object-data-player != my-player-number)
	(up-remove-objects search-local object-data-group-flag != attack-transport-group)
	(up-target-point gl-home-anchor-x action-unload -1 stance-no-attack)
	(up-modify-sn sn-focus-player-number g:= gl-transport-route-focus)
	(up-modify-group-flag 0 c: transport-screen-group)
	(up-reset-group c: transport-screen-group)
	(set-goal gl-transport-screen-id -1)
	(set-goal gl-transport-screen-waits 0)
	(up-set-timer c: t-transport-route c: 15)
	(set-goal gl-route-unload-attempts 0)
	(set-goal gl-transport-route-state TRANSPORT-ROUTE-RECOVERY-WAIT)
)

;The preparation owner hands each accepted screened/unscreened load to one
;of three independent voyage records. Legacy single-slot voyage rules are gone.
(load "rawai-assault-missions")

;A recalled loaded transport remains owned by the route system until it is
;empty at home OR its bounded preparation recovery lease expires. Failure is
;not permission to lose cargo, steal a voyage, or wait for quarantine forever.
(defrule
	(not (or (goal gl-transport-route-state TRANSPORT-ROUTE-RECOVERY-WAIT)
		(goal gl-transport-route-state TRANSPORT-ROUTE-RECOVERY-CHECK)))
=>
	(set-goal gl-assault-recovery-until 0)
)

(defrule
	(or (goal gl-transport-route-state TRANSPORT-ROUTE-RECOVERY-WAIT)
		(goal gl-transport-route-state TRANSPORT-ROUTE-RECOVERY-CHECK))
	(goal gl-assault-recovery-until 0)
=>
	(up-modify-goal gl-assault-recovery-until g:= gl-game-time)
	(up-modify-goal gl-assault-recovery-until c:+ 90)
)

(defrule
	(goal gl-transport-route-state TRANSPORT-ROUTE-RECOVERY-WAIT)
	(or (up-timer-status t-transport-route == timer-triggered)
		(up-compare-goal gl-game-time g:>= gl-assault-recovery-until))
=>
	(set-strategic-number sn-focus-player-number my-player-number)
	(up-full-reset-search)
	;Prune stale/converted references before any terminal flag release.
	(up-set-group search-local c: attack-boarding-group)
	(up-remove-objects search-local object-data-player != my-player-number)
	(up-remove-objects search-local object-data-group-flag != attack-boarding-group)
	(up-create-group 0 0 c: attack-boarding-group)
	(up-set-group search-local c: attack-transport-group)
	(up-remove-objects search-local object-data-player != my-player-number)
	(up-remove-objects search-local object-data-group-flag != attack-transport-group)
	(up-create-group 0 0 c: attack-transport-group)
	(up-full-reset-search)
	(up-set-target-point gl-transport-route-origin-x)
	(up-add-object-by-id search-local g: gl-transport-route-id)
	(up-remove-objects search-local object-data-player != my-player-number)
	(up-remove-objects search-local object-data-group-flag != attack-transport-group)
	(set-goal gl-transport-route-state TRANSPORT-ROUTE-RECOVERY-CHECK)
)

(defrule
	(goal gl-transport-route-state TRANSPORT-ROUTE-RECOVERY-CHECK)
	(up-set-target-object search-local c: 0)
	(up-object-data object-data-garrison-count <= 0)
	(up-object-data object-data-distance <= 12)
	(goal gl-transport-route-script-load YES)
=>
	;A screened route was rejected and the scripted passengers are back home.
	;Release them without converting the failed voyage into a land attack.
	(up-modify-group-flag 0 c: attack-boarding-group)
	(up-reset-group c: attack-boarding-group)
	(up-modify-group-flag 0 c: attack-transport-group)
	(up-reset-group c: attack-transport-group)
	(set-goal gl-transport-route-script-load NO)
	(up-modify-sn sn-focus-player-number g:= gl-transport-route-focus)
	(set-goal gl-transport-screen-id -1)
	(up-set-timer c: t-transport-route c: 90)
	(set-goal gl-transport-route-state TRANSPORT-ROUTE-IDLE)
)

(defrule
	(goal gl-transport-route-state TRANSPORT-ROUTE-RECOVERY-CHECK)
	(up-set-target-object search-local c: 0)
	(up-object-data object-data-garrison-count <= 0)
	(up-object-data object-data-distance <= 12)
	(goal gl-transport-route-script-load NO)
=>
	(up-modify-sn sn-focus-player-number g:= gl-transport-route-focus)
	(set-goal gl-transport-screen-id -1)
	(up-set-timer c: t-transport-route c: 90)
	(set-goal gl-transport-route-state TRANSPORT-ROUTE-IDLE)
)

(defrule
	(goal gl-transport-route-state TRANSPORT-ROUTE-RECOVERY-CHECK)
	(up-set-target-object search-local c: 0)
	(up-object-data object-data-garrison-count > 0)
	(up-compare-goal gl-route-unload-attempts c:< 2)
	(up-compare-goal gl-game-time g:< gl-assault-recovery-until)
=>
	;OWNERSHIP command: attack-transport-group.
	(up-remove-objects search-local object-data-player != my-player-number)
	(up-remove-objects search-local object-data-group-flag != attack-transport-group)
	(up-target-point gl-home-anchor-x action-unload -1 stance-no-attack)
	(up-modify-sn sn-focus-player-number g:= gl-transport-route-focus)
	(up-modify-goal gl-route-unload-attempts c:+ 1)
	(up-set-timer c: t-transport-route c: 15)
	(set-goal gl-transport-route-state TRANSPORT-ROUTE-RECOVERY-WAIT)
)

;One final retry uses the retained boarding shoreline, not an inland TC.
(defrule
	(goal gl-transport-route-state TRANSPORT-ROUTE-RECOVERY-CHECK)
	(up-set-target-object search-local c: 0)
	(up-object-data object-data-garrison-count > 0)
	(goal gl-route-unload-attempts 2)
	(up-compare-goal gl-game-time g:< gl-assault-recovery-until)
=>
	;OWNERSHIP command: attack-transport-group.
	(up-remove-objects search-local object-data-player != my-player-number)
	(up-remove-objects search-local object-data-group-flag != attack-transport-group)
	(up-target-point gl-transport-route-origin-x action-unload -1 stance-no-attack)
	(up-modify-sn sn-focus-player-number g:= gl-transport-route-focus)
	(up-modify-goal gl-route-unload-attempts c:+ 1)
	(up-set-timer c: t-transport-route c: 15)
	(set-goal gl-transport-route-state TRANSPORT-ROUTE-RECOVERY-WAIT)
)

(defrule
	(goal gl-transport-route-state TRANSPORT-ROUTE-RECOVERY-CHECK)
	(up-set-target-object search-local c: 0)
	(up-object-data object-data-garrison-count <= 0)
	(up-object-data object-data-distance > 12)
	(up-compare-goal gl-game-time g:< gl-assault-recovery-until)
=>
	;OWNERSHIP command: attack-transport-group.
	(up-remove-objects search-local object-data-player != my-player-number)
	(up-remove-objects search-local object-data-group-flag != attack-transport-group)
	(up-target-point gl-transport-route-origin-x action-move -1 stance-no-attack)
	(up-modify-sn sn-focus-player-number g:= gl-transport-route-focus)
	(up-set-timer c: t-transport-route c: 15)
	(set-goal gl-transport-route-state TRANSPORT-ROUTE-RECOVERY-WAIT)
)

(defrule
	(goal gl-transport-route-state TRANSPORT-ROUTE-RECOVERY-CHECK)
	(not (up-set-target-object search-local c: 0))
=>
	(up-modify-group-flag 0 c: attack-boarding-group)
	(up-reset-group c: attack-boarding-group)
	(up-modify-group-flag 0 c: attack-transport-group)
	(up-reset-group c: attack-transport-group)
	(set-goal gl-transport-route-script-load NO)
	(up-modify-sn sn-focus-player-number g:= gl-transport-route-focus)
	(set-goal gl-transport-screen-id -1)
	(up-set-timer c: t-transport-route c: 90)
	(set-goal gl-transport-route-state TRANSPORT-ROUTE-IDLE)
)

;Exhausted recovery is terminal for this exact hull. Do not recycle it into
;another voyage or restart the unload budget when another quarantine is busy.
(defrule
	(goal gl-transport-route-state TRANSPORT-ROUTE-RECOVERY-CHECK)
	(up-set-target-object search-local c: 0)
	(up-object-data object-data-garrison-count > 0)
	(up-compare-goal gl-route-unload-attempts c:>= 3)
	(up-compare-goal gl-quarantine-transport-id c:< 0)
=>
	(up-modify-goal gl-quarantine-transport-id g:= gl-transport-route-id)
	(up-modify-goal gl-quarantine-transport-next g:= gl-game-time)
	(up-modify-goal gl-quarantine-transport-next c:+ 60)
	(set-goal gl-quarantine-transport-attempts 3)
	(set-goal gl-quarantine-transport-state TRANSPORT-QUARANTINE-TERMINAL)
	(up-chat-data-to-self "stale transport quarantined: %d" g: gl-transport-route-id)
	(up-modify-group-flag 0 c: attack-boarding-group)
	(up-reset-group c: attack-boarding-group)
	(up-modify-group-flag 0 c: attack-transport-group)
	(up-reset-group c: attack-transport-group)
	(set-goal gl-transport-route-script-load NO)
	(up-modify-sn sn-focus-player-number g:= gl-transport-route-focus)
	(set-goal gl-transport-screen-id -1)
	(up-set-timer c: t-transport-route c: 90)
	(set-goal gl-transport-route-state TRANSPORT-ROUTE-IDLE)
)

(defrule
	(goal gl-transport-route-state TRANSPORT-ROUTE-RECOVERY-CHECK)
	(up-set-target-object search-local c: 0)
	(or (up-compare-goal gl-game-time g:>= gl-assault-recovery-until)
		(and (up-object-data object-data-garrison-count > 0)
			(up-compare-goal gl-route-unload-attempts c:>= 3)))
=>
	;Explicit relinquishment, NOT successful recovery. The existing quarantine
	;ID is never overwritten. Leave cargo and the last safe return order intact;
	;other utility/manual owners may recover it, but assault selection skips this
	;recent failed hull for 300s. No active voyage slot is consumed by this failure.
	(up-chat-data-to-all "RAW prep recovery released hull: %d" g: gl-transport-route-id)
	(up-modify-goal gl-assault-recovery-rejected g:= gl-transport-route-id)
	(up-modify-goal gl-assault-recovery-retry g:= gl-game-time)
	(up-modify-goal gl-assault-recovery-retry c:+ 300)
	(up-modify-group-flag 0 c: attack-boarding-group)
	(up-reset-group c: attack-boarding-group)
	(up-modify-group-flag 0 c: attack-transport-group)
	(up-reset-group c: attack-transport-group)
	(set-goal gl-transport-route-script-load NO)
	(up-modify-sn sn-focus-player-number g:= gl-transport-route-focus)
	(set-goal gl-transport-screen-id -1)
	(set-goal gl-transport-route-id -1)
	(up-set-timer c: t-transport-route c: 30)
	(set-goal gl-transport-route-state TRANSPORT-ROUTE-IDLE)
)

;Recover idle soldiers left on an off-mainland land zone that is well away from
;the enemy base. Units already fighting near the enemy anchor are left alone.
(defrule
	(up-timer-status t-transport-recovery == timer-triggered)
	(goal gl-transport-recovery-state TRANSPORT-RECOVERY-IDLE)
	(goal gl-island-migration-state MIGRATION-IDLE)
	(goal gl-relic-ferry-state RELIC-FERRY-IDLE)
	(goal gl-transport-route-state TRANSPORT-ROUTE-IDLE)
	(goal gl-transport-repair-state TRANSPORT-REPAIR-IDLE)
	(goal gl-transport-clear-state TRANSPORT-CLEAR-IDLE)
	(up-compare-goal gl-quarantine-transport-id c:< 0)
	(goal gl-home-defense-state NO)
	(current-age >= middle-antiquity-age)
	(unit-type-count transport-ship >= 1)
	(or
		(goal map-type RIVERS)
		(or
			(goal map-type ISLANDS)
			(goal map-type TEAM-ISLANDS)
		)
	)
=>
	(up-modify-goal gl-transport-recovery-focus s:= sn-focus-player-number)
	(up-modify-goal gl-transport-recovery-target-zone g:= gl-land-target-zone)
	(up-modify-sn sn-focus-player-number s:= sn-target-player-number)
	(up-get-point position-focus gl-transport-recovery-target-x)
	(up-full-reset-search)
	(up-set-target-point gl-transport-recovery-target-x)
	(up-find-remote c: town-center c: 10)
	(up-find-remote c: villager-class c: 20)
	(up-find-remote c: market c: 10)
	(up-find-remote c: barracks c: 10)
	(up-find-remote c: archery-range c: 10)
	(up-find-remote c: stable c: 10)
	(up-clean-search search-remote object-data-distance search-order-asc)
	(up-set-timer c: t-transport-recovery c: 120)
	(set-goal gl-transport-recovery-state TRANSPORT-RECOVERY-FIND-TARGET)
)

(defrule
	(goal gl-transport-recovery-state TRANSPORT-RECOVERY-FIND-TARGET)
	(up-set-target-object search-remote c: 0)
=>
	(up-get-point position-object gl-transport-recovery-target-x)
	(up-get-object-data object-data-map-zone-id gl-transport-recovery-target-zone)
	(set-strategic-number sn-focus-player-number my-player-number)
	(up-full-reset-search)
	(up-set-target-point gl-transport-recovery-target-x)
	(up-find-remote c: scout-cavalry-class c: 20)
	(up-find-remote c: cavalry-archer-class c: 20)
	(up-find-remote c: cavalry-class c: 40)
	(up-find-remote c: infantry-class c: 40)
	(up-find-remote c: archery-class c: 40)
	(up-remove-objects search-remote object-data-garrisoned == 1)
	(up-remove-objects search-remote object-data-under-attack > 0)
	(up-remove-objects search-remote object-data-idling != 1)
	(up-remove-objects search-remote object-data-group-flag >= 0)
	(up-remove-objects search-remote object-data-map-zone-id g:== gl-home-zone)
	(up-remove-objects search-remote object-data-distance < 28)
	(up-clean-search search-remote object-data-distance search-order-desc)
	(set-goal gl-transport-recovery-state TRANSPORT-RECOVERY-FIND-UNIT)
)

(defrule
	(goal gl-transport-recovery-state TRANSPORT-RECOVERY-FIND-TARGET)
	(not (up-set-target-object search-remote c: 0))
=>
	(set-strategic-number sn-focus-player-number my-player-number)
	(up-full-reset-search)
	(up-set-target-point gl-transport-recovery-target-x)
	(up-find-remote c: scout-cavalry-class c: 20)
	(up-find-remote c: cavalry-archer-class c: 20)
	(up-find-remote c: cavalry-class c: 40)
	(up-find-remote c: infantry-class c: 40)
	(up-find-remote c: archery-class c: 40)
	(up-remove-objects search-remote object-data-garrisoned == 1)
	(up-remove-objects search-remote object-data-under-attack > 0)
	(up-remove-objects search-remote object-data-idling != 1)
	(up-remove-objects search-remote object-data-group-flag >= 0)
	(up-remove-objects search-remote object-data-map-zone-id g:== gl-home-zone)
	(up-remove-objects search-remote object-data-distance < 28)
	(up-clean-search search-remote object-data-distance search-order-desc)
	(set-goal gl-transport-recovery-state TRANSPORT-RECOVERY-FIND-UNIT)
)

(defrule
	(goal gl-transport-recovery-state TRANSPORT-RECOVERY-FIND-UNIT)
	(up-set-target-object search-remote c: 0)
=>
	(up-get-object-data object-data-id gl-transport-recovery-unit-id)
	(up-get-object-data object-data-map-zone-id gl-transport-recovery-zone)
	(up-get-point position-object gl-transport-recovery-unit-x)
	(set-goal gl-transport-recovery-attempts 0)
	(up-modify-group-flag 0 c: recovery-transport-group)
	(up-reset-group c: recovery-transport-group)
	(up-full-reset-search)
	(up-set-target-point gl-transport-recovery-unit-x)
	(up-find-remote c: transport-ship c: 40)
	(up-remove-objects search-remote object-data-id g:== gl-quarantine-transport-id)
	(up-remove-objects search-remote object-data-garrison-count > 0)
	(up-remove-objects search-remote object-data-idling != 1)
	(up-remove-objects search-remote object-data-under-attack > 0)
	(up-remove-objects search-remote object-data-group-flag >= 0)
	(up-clean-search search-remote object-data-distance search-order-asc)
	(set-goal gl-transport-recovery-state TRANSPORT-RECOVERY-FIND-TRANSPORT)
)

(defrule
	(goal gl-transport-recovery-state TRANSPORT-RECOVERY-FIND-UNIT)
	(not (up-set-target-object search-remote c: 0))
=>
	(up-modify-sn sn-focus-player-number g:= gl-transport-recovery-focus)
	(set-goal gl-transport-recovery-state TRANSPORT-RECOVERY-IDLE)
)

(defrule
	(goal gl-transport-recovery-state TRANSPORT-RECOVERY-FIND-TRANSPORT)
	(up-set-target-object search-remote c: 0)
=>
	(up-get-object-data object-data-id gl-transport-recovery-transport-id)
	(up-full-reset-search)
	(up-add-object-by-id search-local g: gl-transport-recovery-transport-id)
		(up-remove-objects search-local object-data-player != my-player-number)
	(up-remove-objects search-local object-data-group-flag >= 0)
	(up-remove-objects search-local object-data-order == orderid-transport)
	(up-remove-objects search-local object-data-order == orderid-unload)
	(up-create-group 0 0 c: recovery-transport-group)
	(up-modify-group-flag 1 c: recovery-transport-group)
	(set-goal gl-transport-recovery-state TRANSPORT-RECOVERY-OWNERSHIP-CLAIM)
)

;Cancel native exploration before this first explicit land claim.
(defrule
	(goal gl-transport-recovery-state TRANSPORT-RECOVERY-OWNERSHIP-CLAIM)
	(goal gl-owner-explore-suspended NO)
=>
	(set-strategic-number sn-number-explore-groups 0)
	(set-strategic-number sn-total-number-explorers 0)
	(set-strategic-number sn-cap-civilian-explorers 0)
	(set-strategic-number sn-minimum-civilian-explorers 0)
	; RAW12 counter 16
	(up-modify-goal gl-command-counter-16 c:+ 1)
	(up-reset-scouts)
	(set-goal gl-owner-explore-suspended YES)
)

(defrule
	(goal gl-transport-recovery-state TRANSPORT-RECOVERY-OWNERSHIP-CLAIM)
=>
	(up-modify-group-flag 0 c: recovery-boarding-group)
	(up-reset-group c: recovery-boarding-group)
	(up-full-reset-search)
	(up-set-target-point gl-transport-recovery-unit-x)
	(up-filter-distance c: -1 c: 12)
	(up-find-local c: scout-cavalry-class c: 20)
	(up-find-local c: cavalry-archer-class c: 20)
	(up-find-local c: cavalry-class c: 40)
	(up-find-local c: infantry-class c: 40)
	(up-find-local c: archery-class c: 40)
	(up-remove-objects search-local object-data-garrisoned == 1)
	(up-remove-objects search-local object-data-under-attack > 0)
	(up-remove-objects search-local object-data-idling != 1)
	(up-remove-objects search-local object-data-group-flag >= 0)
	(up-remove-objects search-local object-data-map-zone-id g:!= gl-transport-recovery-zone)
	(up-clean-search search-local object-data-distance search-order-asc)
	(up-remove-objects search-local object-data-index g:>= gl-transport-capacity)
	;OWNERSHIP acquire: only FREE objects may be claimed.
	(up-remove-objects search-local object-data-player != my-player-number)
	(up-remove-objects search-local object-data-group-flag >= 0)
	(up-create-group 0 0 c: recovery-boarding-group)
	(up-modify-group-flag 1 c: recovery-boarding-group)
	(up-get-search-state local-total)
	(up-modify-goal gl-transport-recovery-load-target g:= local-total)
	(up-add-object-by-id search-remote g: gl-transport-recovery-transport-id)
	(up-remove-objects search-remote object-data-player != my-player-number)
	(up-remove-objects search-remote object-data-group-flag != recovery-transport-group)
	;OWNERSHIP command: recovery-boarding-group.
	(up-remove-objects search-local object-data-player != my-player-number)
	(up-remove-objects search-local object-data-group-flag != recovery-boarding-group)
	(up-target-objects 0 action-garrison -1 stance-no-attack)
	(set-goal gl-transport-recovery-state TRANSPORT-RECOVERY-LOADING)
)

(defrule
	(goal gl-transport-recovery-state TRANSPORT-RECOVERY-FIND-TRANSPORT)
	(not (up-set-target-object search-remote c: 0))
=>
	(up-modify-sn sn-focus-player-number g:= gl-transport-recovery-focus)
	(set-goal gl-transport-recovery-state TRANSPORT-RECOVERY-IDLE)
)

(defrule
	(goal gl-transport-recovery-state TRANSPORT-RECOVERY-LOADING)
	(up-compare-goal gl-transport-recovery-load-target c:>= 1)
=>
	(up-full-reset-search)
	(up-add-object-by-id search-local g: gl-transport-recovery-transport-id)
	(set-goal gl-transport-recovery-state TRANSPORT-RECOVERY-CHECK-LOAD)
)

(defrule
	(goal gl-transport-recovery-state TRANSPORT-RECOVERY-LOADING)
	(up-compare-goal gl-transport-recovery-load-target c:< 1)
=>
	(up-modify-group-flag 0 c: recovery-boarding-group)
	(up-reset-group c: recovery-boarding-group)
	(up-modify-group-flag 0 c: recovery-transport-group)
	(up-reset-group c: recovery-transport-group)
	(up-modify-sn sn-focus-player-number g:= gl-transport-recovery-focus)
	(set-goal gl-transport-recovery-unit-id -1)
	(set-goal gl-transport-recovery-transport-id -1)
	(up-set-timer c: t-transport-recovery c: 90)
	(set-goal gl-transport-recovery-state TRANSPORT-RECOVERY-IDLE)
)

(defrule
	(goal gl-transport-recovery-state TRANSPORT-RECOVERY-CHECK-LOAD)
	(up-set-target-object search-local c: 0)
	(up-object-data object-data-garrison-count g:>= gl-transport-recovery-load-target)
=>
	(up-full-reset-search)
	(up-add-object-by-id search-local g: gl-transport-recovery-transport-id)
	;OWNERSHIP command: recovery-transport-group.
	(up-remove-objects search-local object-data-player != my-player-number)
	(up-remove-objects search-local object-data-group-flag != recovery-transport-group)
	(up-target-point gl-transport-recovery-target-x action-unload -1 stance-no-attack)
	(set-goal gl-transport-recovery-state TRANSPORT-RECOVERY-SAILING)
)

(defrule
	(goal gl-transport-recovery-state TRANSPORT-RECOVERY-CHECK-LOAD)
	(up-set-target-object search-local c: 0)
	(up-object-data object-data-garrison-count g:< gl-transport-recovery-load-target)
	(up-timer-status t-transport-recovery == timer-running)
=>
	(set-goal gl-transport-recovery-state TRANSPORT-RECOVERY-LOADING)
)

;A passenger can be retasked or killed while walking to the hull. Depart with
;the useful partial load at the deadline instead of oscillating forever between
;LOADING and CHECK-LOAD.
(defrule
	(goal gl-transport-recovery-state TRANSPORT-RECOVERY-CHECK-LOAD)
	(up-set-target-object search-local c: 0)
	(up-object-data object-data-garrison-count > 0)
	(up-object-data object-data-garrison-count g:< gl-transport-recovery-load-target)
	(up-timer-status t-transport-recovery == timer-triggered)
=>
	(up-full-reset-search)
	(up-set-group search-local c: recovery-boarding-group)
	(up-remove-objects search-local object-data-garrisoned == 1)
	;OWNERSHIP command: recovery-boarding-group.
	(up-remove-objects search-local object-data-player != my-player-number)
	(up-remove-objects search-local object-data-group-flag != recovery-boarding-group)
	; RAW12 counter 17
	(up-modify-goal gl-command-counter-17 c:+ 1)
	(up-target-point position-self-x action-stop -1 stance-no-attack)
	(up-full-reset-search)
	(up-add-object-by-id search-local g: gl-transport-recovery-transport-id)
	;OWNERSHIP command: recovery-transport-group.
	(up-remove-objects search-local object-data-player != my-player-number)
	(up-remove-objects search-local object-data-group-flag != recovery-transport-group)
	(up-target-point gl-transport-recovery-target-x action-unload -1 stance-no-attack)
	(up-chat-data-to-self "transport recovery partial departure: %d" g: gl-transport-recovery-load-target)
	(up-set-timer c: t-transport-recovery c: 30)
	(set-goal gl-transport-recovery-state TRANSPORT-RECOVERY-SAILING)
)

(defrule
	(goal gl-transport-recovery-state TRANSPORT-RECOVERY-CHECK-LOAD)
	(up-set-target-object search-local c: 0)
	(up-object-data object-data-garrison-count <= 0)
	(up-timer-status t-transport-recovery == timer-triggered)
=>
	(up-chat-data-to-self "transport recovery boarding aborted: %d" g: gl-transport-recovery-zone)
	(up-modify-group-flag 0 c: recovery-boarding-group)
	(up-reset-group c: recovery-boarding-group)
	(up-modify-group-flag 0 c: recovery-transport-group)
	(up-reset-group c: recovery-transport-group)
	(up-modify-sn sn-focus-player-number g:= gl-transport-recovery-focus)
	(set-goal gl-transport-recovery-unit-id -1)
	(set-goal gl-transport-recovery-transport-id -1)
	(up-set-timer c: t-transport-recovery c: 90)
	(set-goal gl-transport-recovery-state TRANSPORT-RECOVERY-IDLE)
)

(defrule
	(goal gl-transport-recovery-state TRANSPORT-RECOVERY-SAILING)
=>
	(up-full-reset-search)
	(up-add-object-by-id search-local g: gl-transport-recovery-transport-id)
	(set-goal gl-transport-recovery-state TRANSPORT-RECOVERY-CHECK-LANDING)
)

(defrule
	(goal gl-transport-recovery-state TRANSPORT-RECOVERY-CHECK-LANDING)
	(up-set-target-object search-local c: 0)
	(up-object-data object-data-garrison-count <= 0)
=>
	(up-full-reset-search)
	(up-set-group search-local c: recovery-boarding-group)
	(up-remove-objects search-local object-data-garrisoned == 1)
	(up-remove-objects search-local object-data-map-zone-id g:!= gl-transport-recovery-target-zone)
	(set-goal gl-transport-recovery-state TRANSPORT-RECOVERY-VERIFY-LANDING)
)

;An empty hull is not proof of a successful landing. At least one reserved
;passenger must be present in the intended target zone before the controller
;releases the group and returns the transport.
(defrule
	(goal gl-transport-recovery-state TRANSPORT-RECOVERY-VERIFY-LANDING)
	(up-set-target-object search-local c: 0)
=>
	;OWNERSHIP command: recovery-boarding-group.
	(up-remove-objects search-local object-data-player != my-player-number)
	(up-remove-objects search-local object-data-group-flag != recovery-boarding-group)
	(up-target-point gl-transport-recovery-target-x action-move -1 stance-defensive)
	(up-modify-group-flag 0 c: recovery-boarding-group)
	(up-reset-group c: recovery-boarding-group)
	(up-full-reset-search)
	(up-add-object-by-id search-local g: gl-transport-recovery-transport-id)
	;OWNERSHIP command: recovery-transport-group.
	(up-remove-objects search-local object-data-player != my-player-number)
	(up-remove-objects search-local object-data-group-flag != recovery-transport-group)
	(up-target-point gl-transport-recovery-unit-x action-move -1 stance-no-attack)
	(up-modify-group-flag 0 c: recovery-transport-group)
	(up-reset-group c: recovery-transport-group)
	(up-modify-sn sn-focus-player-number g:= gl-transport-recovery-focus)
	(set-goal gl-transport-recovery-unit-id -1)
	(set-goal gl-transport-recovery-transport-id -1)
	(up-set-timer c: t-transport-recovery c: 90)
	(set-goal gl-transport-recovery-state TRANSPORT-RECOVERY-IDLE)
)

;A wrong-beach unload keeps exact ownership of both hull and passengers. Reboard
;only reserved survivors which share one exact passenger's actual land zone,
;then retry the intended target with the existing three-attempt watchdog.
(defrule
	(goal gl-transport-recovery-state TRANSPORT-RECOVERY-VERIFY-LANDING)
	(not (up-set-target-object search-local c: 0))
=>
	(up-full-reset-search)
	(up-set-group search-local c: recovery-boarding-group)
	(up-remove-objects search-local object-data-garrisoned == 1)
	(up-clean-search search-local object-data-distance search-order-asc)
	(set-goal gl-transport-recovery-state TRANSPORT-RECOVERY-FIND-WRONG-ZONE)
)

(defrule
	(goal gl-transport-recovery-state TRANSPORT-RECOVERY-FIND-WRONG-ZONE)
	(up-set-target-object search-local c: 0)
	(up-compare-goal gl-transport-recovery-attempts c:< 3)
=>
	;The selected object is a nongarrisoned reserved land passenger, not the hull.
	(up-get-object-data object-data-map-zone-id gl-transport-recovery-landing-zone)
	(up-remove-objects search-local object-data-map-zone-id g:!= gl-transport-recovery-landing-zone)
	(up-get-search-state local-total)
	(up-modify-goal gl-transport-recovery-load-target g:= local-total)
	(up-add-object-by-id search-remote g: gl-transport-recovery-transport-id)
	(up-remove-objects search-remote object-data-player != my-player-number)
	(up-remove-objects search-remote object-data-group-flag != recovery-transport-group)
	;OWNERSHIP command: recovery-boarding-group.
	(up-remove-objects search-local object-data-player != my-player-number)
	(up-remove-objects search-local object-data-group-flag != recovery-boarding-group)
	(up-target-objects 0 action-garrison -1 stance-no-attack)
	(up-modify-goal gl-transport-recovery-attempts c:+ 1)
	(up-chat-data-to-self "transport recovery wrong-zone reboard: %d" g: gl-transport-recovery-landing-zone)
	(up-set-timer c: t-transport-recovery c: 30)
	(set-goal gl-transport-recovery-state TRANSPORT-RECOVERY-LOADING)
)

(defrule
	(goal gl-transport-recovery-state TRANSPORT-RECOVERY-FIND-WRONG-ZONE)
	(up-set-target-object search-local c: 0)
	(up-compare-goal gl-transport-recovery-attempts c:>= 3)
=>
	(up-get-object-data object-data-map-zone-id gl-transport-recovery-landing-zone)
	;Do not report the wrong island as success. Release the stranded survivors
	;and quarantine this exact route hull so another controller cannot claim it
	;in the same sweep.
	(up-modify-group-flag 0 c: recovery-boarding-group)
	(up-reset-group c: recovery-boarding-group)
	(up-modify-group-flag 0 c: recovery-transport-group)
	(up-reset-group c: recovery-transport-group)
	(up-modify-goal gl-quarantine-transport-id g:= gl-transport-recovery-transport-id)
	(up-modify-goal gl-quarantine-transport-next g:= gl-game-time)
	(up-modify-goal gl-quarantine-transport-next c:+ 60)
	(up-modify-sn sn-focus-player-number g:= gl-transport-recovery-focus)
	(up-chat-data-to-self "transport recovery wrong-zone abort: %d" g: gl-transport-recovery-landing-zone)
	(set-goal gl-transport-recovery-unit-id -1)
	(set-goal gl-transport-recovery-transport-id -1)
	(up-set-timer c: t-transport-recovery c: 90)
	(set-goal gl-transport-recovery-state TRANSPORT-RECOVERY-IDLE)
)

;All reserved passengers may have died after unload. End explicitly and return
;the proven-empty hull; an empty passenger set is neither a landing success nor
;a reason to quarantine an otherwise usable ship.
(defrule
	(goal gl-transport-recovery-state TRANSPORT-RECOVERY-FIND-WRONG-ZONE)
	(not (up-set-target-object search-local c: 0))
=>
	(up-modify-group-flag 0 c: recovery-boarding-group)
	(up-reset-group c: recovery-boarding-group)
	(up-full-reset-search)
	(up-add-object-by-id search-local g: gl-transport-recovery-transport-id)
	;OWNERSHIP command: recovery-transport-group.
	(up-remove-objects search-local object-data-player != my-player-number)
	(up-remove-objects search-local object-data-group-flag != recovery-transport-group)
	(up-target-point gl-transport-recovery-unit-x action-move -1 stance-no-attack)
	(up-modify-group-flag 0 c: recovery-transport-group)
	(up-reset-group c: recovery-transport-group)
	(up-modify-sn sn-focus-player-number g:= gl-transport-recovery-focus)
	(up-chat-data-to-self "transport recovery no survivors: %d" g: gl-transport-recovery-target-zone)
	(set-goal gl-transport-recovery-unit-id -1)
	(set-goal gl-transport-recovery-transport-id -1)
	(up-set-timer c: t-transport-recovery c: 90)
	(set-goal gl-transport-recovery-state TRANSPORT-RECOVERY-IDLE)
)

(defrule
	(goal gl-transport-recovery-state TRANSPORT-RECOVERY-CHECK-LANDING)
	(up-set-target-object search-local c: 0)
	(up-object-data object-data-garrison-count > 0)
=>
	(set-goal gl-transport-recovery-state TRANSPORT-RECOVERY-SAILING)
)

(defrule
	(up-timer-status t-transport-recovery == timer-triggered)
	(not (goal gl-transport-recovery-state TRANSPORT-RECOVERY-IDLE))
	(up-compare-goal gl-transport-recovery-transport-id c:< 0)
=>
	(up-modify-group-flag 0 c: recovery-boarding-group)
	(up-reset-group c: recovery-boarding-group)
	(up-modify-group-flag 0 c: recovery-transport-group)
	(up-reset-group c: recovery-transport-group)
	(up-modify-sn sn-focus-player-number g:= gl-transport-recovery-focus)
	(up-set-timer c: t-transport-recovery c: 90)
	(set-goal gl-transport-recovery-state TRANSPORT-RECOVERY-IDLE)
)

(defrule
	(up-timer-status t-transport-recovery == timer-triggered)
	(not (goal gl-transport-recovery-state TRANSPORT-RECOVERY-IDLE))
	(up-compare-goal gl-transport-recovery-transport-id c:>= 0)
	(up-compare-goal gl-transport-recovery-attempts c:< 3)
=>
	(set-strategic-number sn-focus-player-number my-player-number)
	(up-full-reset-search)
	(up-add-object-by-id search-local g: gl-transport-recovery-transport-id)
	;OWNERSHIP command: recovery-transport-group.
	(up-remove-objects search-local object-data-player != my-player-number)
	(up-remove-objects search-local object-data-group-flag != recovery-transport-group)
	(up-target-point gl-transport-recovery-target-x action-unload -1 stance-no-attack)
	(up-modify-goal gl-transport-recovery-attempts c:+ 1)
	(up-chat-data-to-self "transport recovery unload retry: %d" g: gl-transport-recovery-attempts)
	(up-set-timer c: t-transport-recovery c: 20)
	(set-goal gl-transport-recovery-state TRANSPORT-RECOVERY-SAILING)
)

(defrule
	(up-timer-status t-transport-recovery == timer-triggered)
	(not (goal gl-transport-recovery-state TRANSPORT-RECOVERY-IDLE))
	(up-compare-goal gl-transport-recovery-transport-id c:>= 0)
	(goal gl-transport-recovery-attempts 3)
=>
	;The destination is not viable. Recall the still-owned hull and passengers;
	;the normal empty check performs the eventual release at home.
	(up-copy-point gl-transport-recovery-target-x gl-transport-recovery-unit-x)
	(up-modify-goal gl-transport-recovery-target-zone g:= gl-transport-recovery-zone)
	(set-strategic-number sn-focus-player-number my-player-number)
	(up-full-reset-search)
	(up-add-object-by-id search-local g: gl-transport-recovery-transport-id)
	;OWNERSHIP command: recovery-transport-group.
	(up-remove-objects search-local object-data-player != my-player-number)
	(up-remove-objects search-local object-data-group-flag != recovery-transport-group)
	(up-target-point gl-transport-recovery-target-x action-unload -1 stance-no-attack)
	(set-goal gl-transport-recovery-attempts 4)
	(up-chat-data-to-self "transport recovery recalled: %d" g: gl-transport-recovery-zone)
	(up-set-timer c: t-transport-recovery c: 30)
	(set-goal gl-transport-recovery-state TRANSPORT-RECOVERY-SAILING)
)

(defrule
	(up-timer-status t-transport-recovery == timer-triggered)
	(not (goal gl-transport-recovery-state TRANSPORT-RECOVERY-IDLE))
	(up-compare-goal gl-transport-recovery-transport-id c:>= 0)
	(up-compare-goal gl-transport-recovery-attempts c:>= 4)
=>
	;A hull that cannot unload even at its own origin must not be reclaimed by a
	;new controller. Quarantine the exact object instead of recreating the loop.
	(up-modify-goal gl-quarantine-transport-id g:= gl-transport-recovery-transport-id)
	(up-modify-group-flag 0 c: recovery-boarding-group)
	(up-reset-group c: recovery-boarding-group)
	(up-modify-group-flag 0 c: recovery-transport-group)
	(up-reset-group c: recovery-transport-group)
	(up-modify-sn sn-focus-player-number g:= gl-transport-recovery-focus)
	(up-chat-data-to-self "transport recovery quarantined: %d" g: gl-quarantine-transport-id)
	(set-goal gl-transport-recovery-unit-id -1)
	(set-goal gl-transport-recovery-transport-id -1)
	(up-set-timer c: t-transport-recovery c: 90)
	(set-goal gl-transport-recovery-state TRANSPORT-RECOVERY-IDLE)
)

;Ferry a priest to a known off-mainland relic, then ferry the carrier back to
;the home monastery. The utility transport budget keeps this from borrowing an
;attack transport that is already loading.
(defrule
	(up-timer-status t-relic-ferry == timer-triggered)
	(goal gl-relic-ferry-state RELIC-FERRY-IDLE)
	(goal gl-island-migration-state MIGRATION-IDLE)
	(goal gl-transport-recovery-state TRANSPORT-RECOVERY-IDLE)
	(goal gl-transport-route-state TRANSPORT-ROUTE-IDLE)
	(goal gl-transport-repair-state TRANSPORT-REPAIR-IDLE)
	(goal gl-transport-clear-state TRANSPORT-CLEAR-IDLE)
	(current-age >= middle-antiquity-age)
	(building-type-count-total monastery >= 1)
	(unit-type-count transport-ship >= 1)
	(or
		(goal map-type RIVERS)
		(or
			(goal map-type ISLANDS)
			(goal map-type TEAM-ISLANDS)
		)
	)
=>
	(up-modify-goal gl-relic-ferry-focus s:= sn-focus-player-number)
	(set-goal gl-relic-ferry-return-attempts 0)
	(set-strategic-number sn-focus-player-number my-player-number)
	(up-full-reset-search)
	(up-set-target-point gl-home-anchor-x)
	(up-filter-distance c: -1 c: 160)
	(up-find-remote c: monk-with-relic-class c: 5)
	(up-remove-objects search-remote object-data-garrisoned == 1)
	(up-remove-objects search-remote object-data-map-zone-id g:== gl-home-zone)
	(up-clean-search search-remote object-data-distance search-order-asc)
	(up-set-timer c: t-relic-ferry c: 180)
	(set-goal gl-relic-ferry-state RELIC-FERRY-FIND-CARRIER)
)

(defrule
	(goal gl-relic-ferry-state RELIC-FERRY-FIND-CARRIER)
	(up-set-target-object search-remote c: 0)
=>
	(set-goal gl-relic-ferry-direction RELIC-FERRY-RETURN)
	(up-get-object-data object-data-id gl-relic-ferry-unit-id)
	(up-get-point position-object gl-relic-ferry-target-x)
	(up-full-reset-search)
	(up-set-target-point gl-relic-ferry-target-x)
	(up-find-remote c: transport-ship c: 40)
	(up-remove-objects search-remote object-data-id g:== gl-quarantine-transport-id)
	(up-remove-objects search-remote object-data-garrison-count > 0)
	(up-remove-objects search-remote object-data-under-attack > 0)
	(up-remove-objects search-remote object-data-group-flag >= 0)
	(up-clean-search search-remote object-data-distance search-order-asc)
	(set-goal gl-relic-ferry-state RELIC-FERRY-FIND-TRANSPORT)
)

(defrule
	(goal gl-relic-ferry-state RELIC-FERRY-FIND-CARRIER)
	(not (up-set-target-object search-remote c: 0))
=>
	(set-strategic-number sn-focus-player-number 0)
	(up-full-reset-search)
	(up-set-target-point gl-home-anchor-x)
	(up-find-remote c: relic-class c: 10)
	(up-remove-objects search-remote object-data-map-zone-id g:== gl-home-zone)
	(up-clean-search search-remote object-data-distance search-order-asc)
	(set-goal gl-relic-ferry-state RELIC-FERRY-FIND-RELIC)
)

(defrule
	(goal gl-relic-ferry-state RELIC-FERRY-FIND-RELIC)
	(up-set-target-object search-remote c: 0)
=>
	(set-goal gl-relic-ferry-direction RELIC-FERRY-OUTBOUND)
	(up-get-object-data object-data-id gl-relic-ferry-target-id)
	(up-get-point position-object gl-relic-ferry-target-x)
	(set-strategic-number sn-focus-player-number my-player-number)
	(up-full-reset-search)
	(up-set-target-point gl-home-anchor-x)
	(up-find-remote c: priest c: 5)
	(up-find-remote c: brahmin c: 5)
	(up-remove-objects search-remote object-data-garrisoned == 1)
	(up-remove-objects search-remote object-data-map-zone-id g:!= gl-home-zone)
	(up-clean-search search-remote object-data-distance search-order-asc)
	(set-goal gl-relic-ferry-state RELIC-FERRY-FIND-PRIEST)
)

(defrule
	(goal gl-relic-ferry-state RELIC-FERRY-FIND-RELIC)
	(not (up-set-target-object search-remote c: 0))
=>
	(up-modify-sn sn-focus-player-number g:= gl-relic-ferry-focus)
	(up-set-timer c: t-relic-ferry c: 60)
	(set-goal gl-relic-ferry-state RELIC-FERRY-IDLE)
)

(defrule
	(goal gl-relic-ferry-state RELIC-FERRY-FIND-PRIEST)
	(up-set-target-object search-remote c: 0)
=>
	(up-get-object-data object-data-id gl-relic-ferry-unit-id)
	(up-get-point position-object gl-transport-recovery-unit-x)
	(up-full-reset-search)
	(up-set-target-point gl-transport-recovery-unit-x)
	(up-find-remote c: transport-ship c: 40)
	(up-remove-objects search-remote object-data-id g:== gl-quarantine-transport-id)
	(up-remove-objects search-remote object-data-garrison-count > 0)
	(up-remove-objects search-remote object-data-under-attack > 0)
	(up-remove-objects search-remote object-data-group-flag >= 0)
	(up-clean-search search-remote object-data-distance search-order-asc)
	(set-goal gl-relic-ferry-state RELIC-FERRY-FIND-TRANSPORT)
)

(defrule
	(goal gl-relic-ferry-state RELIC-FERRY-FIND-PRIEST)
	(not (up-set-target-object search-remote c: 0))
=>
	(up-modify-sn sn-focus-player-number g:= gl-relic-ferry-focus)
	(up-set-timer c: t-relic-ferry c: 60)
	(set-goal gl-relic-ferry-state RELIC-FERRY-IDLE)
)

(defrule
	(goal gl-relic-ferry-state RELIC-FERRY-FIND-TRANSPORT)
	(up-set-target-object search-remote c: 0)
=>
	(up-get-object-data object-data-id gl-relic-ferry-transport-id)
	(up-full-reset-search)
	(up-add-object-by-id search-local g: gl-relic-ferry-transport-id)
		(up-remove-objects search-local object-data-player != my-player-number)
	(up-remove-objects search-local object-data-group-flag >= 0)
	(up-remove-objects search-local object-data-order == orderid-transport)
	(up-remove-objects search-local object-data-order == orderid-unload)
	(up-create-group 0 0 c: relic-ferry-transport-group)
	(up-modify-group-flag 1 c: relic-ferry-transport-group)
	(up-full-reset-search)
	(up-add-object-by-id search-local g: gl-relic-ferry-unit-id)
	(up-remove-objects search-local object-data-player != my-player-number)
	(up-remove-objects search-local object-data-group-flag >= 0)
	(up-remove-objects search-local object-data-order == orderid-transport)
	(up-remove-objects search-local object-data-order == orderid-unload)
	(up-create-group 0 0 c: relic-ferry-passenger-group)
	(up-modify-group-flag 1 c: relic-ferry-passenger-group)
	(up-add-object-by-id search-remote g: gl-relic-ferry-transport-id)
	(up-remove-objects search-remote object-data-player != my-player-number)
	(up-remove-objects search-remote object-data-group-flag != relic-ferry-transport-group)
		(up-remove-objects search-local object-data-player != my-player-number)
	(up-remove-objects search-local object-data-group-flag != relic-ferry-passenger-group)
	(up-target-objects 0 action-garrison -1 stance-no-attack)
	(set-goal gl-relic-ferry-load-wait-reported NO)
	(set-goal gl-relic-ferry-state RELIC-FERRY-LOADING)
)

(defrule
	(goal gl-relic-ferry-state RELIC-FERRY-FIND-TRANSPORT)
	(not (up-set-target-object search-remote c: 0))
=>
	(up-modify-group-flag 0 c: relic-ferry-transport-group)
	(up-reset-group c: relic-ferry-transport-group)
	(up-modify-sn sn-focus-player-number g:= gl-relic-ferry-focus)
	(up-set-timer c: t-relic-ferry c: 60)
	(set-goal gl-relic-ferry-state RELIC-FERRY-IDLE)
)

(defrule
	(goal gl-relic-ferry-state RELIC-FERRY-LOADING)
=>
	(up-full-reset-search)
	;Verify the exact reserved passenger, not an indirect hull count. P3B44T3
	;showed the Priest visibly aboard while this state remained stuck until the
	;180-second watchdog in two separate missions.
	;DE direct-unit searches exclude garrisoned units by default. Include both
	;states so this exact-ID lookup survives the boarding transition.
	(fe-filter-garrisoned c: 1)
	(up-add-object-by-id search-local g: gl-relic-ferry-unit-id)
	(set-goal gl-relic-ferry-state RELIC-FERRY-CHECK-LOAD)
)

(defrule
	(goal gl-relic-ferry-state RELIC-FERRY-CHECK-LOAD)
	(goal gl-relic-ferry-direction RELIC-FERRY-OUTBOUND)
	(up-set-target-object search-local c: 0)
	(up-object-data object-data-garrisoned == 1)
=>
	(up-full-reset-search)
	(up-add-object-by-id search-local g: gl-relic-ferry-transport-id)
	;OWNERSHIP command: relic-ferry-transport-group.
	(up-remove-objects search-local object-data-player != my-player-number)
	(up-remove-objects search-local object-data-group-flag != relic-ferry-transport-group)
	(up-target-point gl-relic-ferry-target-x action-unload -1 stance-no-attack)
	(up-chat-data-to-all "RAW44R relic ferry outbound unit: %d" g: gl-relic-ferry-unit-id)
	(up-chat-data-to-all "RAW44R relic ferry outbound hull: %d" g: gl-relic-ferry-transport-id)
	(up-chat-data-to-all "RAW44R relic ferry target: %d" g: gl-relic-ferry-target-id)
	(set-goal gl-relic-ferry-load-wait-reported NO)
	(set-goal gl-relic-ferry-state RELIC-FERRY-SAILING)
)

(defrule
	(goal gl-relic-ferry-state RELIC-FERRY-CHECK-LOAD)
	(goal gl-relic-ferry-direction RELIC-FERRY-RETURN)
	(up-set-target-object search-local c: 0)
	(up-object-data object-data-garrisoned == 1)
=>
	(up-full-reset-search)
	(up-add-object-by-id search-local g: gl-relic-ferry-transport-id)
	;OWNERSHIP command: relic-ferry-transport-group.
	(up-remove-objects search-local object-data-player != my-player-number)
	(up-remove-objects search-local object-data-group-flag != relic-ferry-transport-group)
	(up-target-point gl-home-anchor-x action-unload -1 stance-no-attack)
	(up-chat-data-to-all "RAW44R relic ferry return unit: %d" g: gl-relic-ferry-unit-id)
	(up-chat-data-to-all "RAW44R relic ferry return hull: %d" g: gl-relic-ferry-transport-id)
	(set-goal gl-relic-ferry-load-wait-reported NO)
	(set-goal gl-relic-ferry-state RELIC-FERRY-SAILING)
)

(defrule
	(goal gl-relic-ferry-state RELIC-FERRY-CHECK-LOAD)
	(up-set-target-object search-local c: 0)
	(up-object-data object-data-garrisoned != 1)
	(goal gl-relic-ferry-load-wait-reported NO)
=>
	(up-chat-data-to-all "RAW44R relic ferry passenger pending: %d" g: gl-relic-ferry-unit-id)
	(set-goal gl-relic-ferry-load-wait-reported YES)
	(set-goal gl-relic-ferry-state RELIC-FERRY-LOADING)
)

(defrule
	(goal gl-relic-ferry-state RELIC-FERRY-CHECK-LOAD)
	(up-set-target-object search-local c: 0)
	(up-object-data object-data-garrisoned != 1)
	(goal gl-relic-ferry-load-wait-reported YES)
=>
	(set-goal gl-relic-ferry-state RELIC-FERRY-LOADING)
)

(defrule
	(goal gl-relic-ferry-state RELIC-FERRY-CHECK-LOAD)
	(not (up-set-target-object search-local c: 0))
	(goal gl-relic-ferry-load-wait-reported NO)
=>
	(up-chat-data-to-all "RAW44R relic ferry passenger missing: %d" g: gl-relic-ferry-unit-id)
	(set-goal gl-relic-ferry-load-wait-reported YES)
	(set-goal gl-relic-ferry-state RELIC-FERRY-LOADING)
)

(defrule
	(goal gl-relic-ferry-state RELIC-FERRY-CHECK-LOAD)
	(not (up-set-target-object search-local c: 0))
	(goal gl-relic-ferry-load-wait-reported YES)
=>
	(set-goal gl-relic-ferry-state RELIC-FERRY-LOADING)
)

(defrule
	(goal gl-relic-ferry-state RELIC-FERRY-SAILING)
=>
	(up-full-reset-search)
	(up-add-object-by-id search-local g: gl-relic-ferry-transport-id)
	(set-goal gl-relic-ferry-state RELIC-FERRY-CHECK-LANDING)
)

(defrule
	(goal gl-relic-ferry-state RELIC-FERRY-CHECK-LANDING)
	(goal gl-relic-ferry-direction RELIC-FERRY-OUTBOUND)
	(up-set-target-object search-local c: 0)
	(up-object-data object-data-garrison-count <= 0)
=>
	(set-goal gl-relic-ferry-state RELIC-FERRY-TASK-RELIC)
)

(defrule
	(goal gl-relic-ferry-state RELIC-FERRY-CHECK-LANDING)
	(goal gl-relic-ferry-direction RELIC-FERRY-RETURN)
	(up-set-target-object search-local c: 0)
	(up-object-data object-data-garrison-count <= 0)
=>
	(set-goal gl-relic-ferry-state RELIC-FERRY-TASK-HOME)
)

(defrule
	(goal gl-relic-ferry-state RELIC-FERRY-CHECK-LANDING)
	(up-set-target-object search-local c: 0)
	(up-object-data object-data-garrison-count > 0)
=>
	(set-goal gl-relic-ferry-state RELIC-FERRY-SAILING)
)

(defrule
	(goal gl-relic-ferry-state RELIC-FERRY-TASK-RELIC)
=>
	(set-strategic-number sn-focus-player-number my-player-number)
	(up-full-reset-search)
	(up-add-object-by-id search-local g: gl-relic-ferry-unit-id)
	(set-strategic-number sn-focus-player-number 0)
	(up-add-object-by-id search-remote g: gl-relic-ferry-target-id)
	;OWNERSHIP command: relic-ferry-passenger-group.
	(up-remove-objects search-local object-data-player != my-player-number)
	(up-remove-objects search-local object-data-group-flag != relic-ferry-passenger-group)
	(up-target-objects 0 action-default -1 stance-no-attack)
	;Keep the exact transport reserved beside the landing while the priest walks
	;to and picks up the relic. Releasing ownership here caused other transport
	;controllers to send the hull home before the return passenger was ready.
	(up-set-timer c: t-relic-ferry c: 90)
	(set-goal gl-relic-ferry-state RELIC-FERRY-WAIT-CARRIER)
)

(defrule
	(goal gl-relic-ferry-state RELIC-FERRY-WAIT-CARRIER)
=>
	(set-strategic-number sn-focus-player-number my-player-number)
	(up-full-reset-search)
	(up-add-object-by-id search-local g: gl-relic-ferry-unit-id)
	(up-add-object-by-id search-remote g: gl-relic-ferry-transport-id)
	(set-goal gl-relic-ferry-state RELIC-FERRY-CHECK-CARRIER)
)

(defrule
	(goal gl-relic-ferry-state RELIC-FERRY-CHECK-CARRIER)
	(up-set-target-object search-local c: 0)
	(up-object-data object-data-class == monk-with-relic-class)
	(up-set-target-object search-remote c: 0)
=>
	(set-goal gl-relic-ferry-direction RELIC-FERRY-RETURN)
	;OWNERSHIP command: relic-ferry-passenger-group.
	(up-remove-objects search-local object-data-player != my-player-number)
	(up-remove-objects search-local object-data-group-flag != relic-ferry-passenger-group)
	(up-target-objects 0 action-garrison -1 stance-no-attack)
	(up-chat-data-to-self "relic carrier return boarding: %d" g: gl-relic-ferry-unit-id)
	(up-set-timer c: t-relic-ferry c: 90)
	(set-goal gl-relic-ferry-load-wait-reported NO)
	(set-goal gl-relic-ferry-state RELIC-FERRY-LOADING)
)

(defrule
	(goal gl-relic-ferry-state RELIC-FERRY-CHECK-CARRIER)
	(up-set-target-object search-local c: 0)
	(up-object-data object-data-class != monk-with-relic-class)
=>
	(set-goal gl-relic-ferry-state RELIC-FERRY-WAIT-CARRIER)
)

(defrule
	(goal gl-relic-ferry-state RELIC-FERRY-CHECK-CARRIER)
	(or
		(not (up-set-target-object search-local c: 0))
		(not (up-set-target-object search-remote c: 0))
	)
=>
	(up-modify-group-flag 0 c: relic-ferry-transport-group)
	(up-reset-group c: relic-ferry-transport-group)
	(up-modify-sn sn-focus-player-number g:= gl-relic-ferry-focus)
	(up-set-timer c: t-relic-ferry c: 60)
	(set-goal gl-relic-ferry-state RELIC-FERRY-IDLE)
)

(defrule
	(goal gl-relic-ferry-state RELIC-FERRY-TASK-HOME)
=>
	(set-strategic-number sn-focus-player-number my-player-number)
	(up-full-reset-search)
	(up-add-object-by-id search-local g: gl-relic-ferry-unit-id)
	(up-set-target-point gl-home-anchor-x)
	(up-find-remote c: monastery c: 5)
	(up-remove-objects search-remote object-data-map-zone-id g:!= gl-home-zone)
	(up-clean-search search-remote object-data-distance search-order-asc)
	;OWNERSHIP command: relic-ferry-passenger-group.
	(up-remove-objects search-local object-data-player != my-player-number)
	(up-remove-objects search-local object-data-group-flag != relic-ferry-passenger-group)
	(up-target-objects 0 action-default -1 stance-no-attack)
	(up-modify-group-flag 0 c: relic-ferry-transport-group)
	(up-reset-group c: relic-ferry-transport-group)
	(up-modify-sn sn-focus-player-number g:= gl-relic-ferry-focus)
	(up-set-timer c: t-relic-ferry c: 60)
	(set-goal gl-relic-ferry-state RELIC-FERRY-IDLE)
)

(defrule
	(up-timer-status t-relic-ferry == timer-triggered)
	(not (goal gl-relic-ferry-state RELIC-FERRY-IDLE))
	(nor
		(goal gl-relic-ferry-state RELIC-FERRY-WATCHDOG-RETURN)
		(goal gl-relic-ferry-state RELIC-FERRY-WATCHDOG-CHECK)
	)
	(up-compare-goal gl-relic-ferry-return-attempts c:< 3)
=>
	(set-strategic-number sn-focus-player-number my-player-number)
	(up-full-reset-search)
	(up-add-object-by-id search-local g: gl-relic-ferry-transport-id)
	;OWNERSHIP command: relic-ferry-transport-group.
	(up-remove-objects search-local object-data-player != my-player-number)
	(up-remove-objects search-local object-data-group-flag != relic-ferry-transport-group)
	(up-target-point gl-home-anchor-x action-unload -1 stance-no-attack)
	;Do not release the exact hull merely because its controller timed out. Keep
	;ownership until it is empty and physically back beside the active home.
	(up-modify-goal gl-relic-ferry-return-attempts c:+ 1)
	(up-set-timer c: t-relic-ferry c: 30)
	(set-goal gl-relic-ferry-state RELIC-FERRY-WATCHDOG-RETURN)
)

(defrule
	(goal gl-relic-ferry-state RELIC-FERRY-WATCHDOG-RETURN)
	(up-timer-status t-relic-ferry == timer-triggered)
=>
	(set-strategic-number sn-focus-player-number my-player-number)
	(up-full-reset-search)
	(up-set-target-point gl-home-anchor-x)
	(up-add-object-by-id search-local g: gl-relic-ferry-transport-id)
	(set-goal gl-relic-ferry-state RELIC-FERRY-WATCHDOG-CHECK)
)

(defrule
	(goal gl-relic-ferry-state RELIC-FERRY-WATCHDOG-CHECK)
	(up-set-target-object search-local c: 0)
	(up-object-data object-data-garrison-count <= 0)
	(up-object-data object-data-distance <= 16)
=>
	(up-modify-group-flag 0 c: relic-ferry-transport-group)
	(up-reset-group c: relic-ferry-transport-group)
	(up-modify-sn sn-focus-player-number g:= gl-relic-ferry-focus)
	(set-goal gl-relic-ferry-return-attempts 0)
	(up-set-timer c: t-relic-ferry c: 60)
	(set-goal gl-relic-ferry-state RELIC-FERRY-IDLE)
)

(defrule
	(goal gl-relic-ferry-state RELIC-FERRY-WATCHDOG-CHECK)
	(up-set-target-object search-local c: 0)
	(up-compare-goal gl-relic-ferry-return-attempts c:< 3)
	(or
		(up-object-data object-data-garrison-count > 0)
		(up-object-data object-data-distance > 16)
	)
=>
	(up-full-reset-search)
	(up-add-object-by-id search-local g: gl-relic-ferry-transport-id)
	;OWNERSHIP command: relic-ferry-transport-group.
	(up-remove-objects search-local object-data-player != my-player-number)
	(up-remove-objects search-local object-data-group-flag != relic-ferry-transport-group)
	(up-target-point gl-home-anchor-x action-unload -1 stance-no-attack)
	(up-modify-goal gl-relic-ferry-return-attempts c:+ 1)
	(up-set-timer c: t-relic-ferry c: 30)
	(set-goal gl-relic-ferry-state RELIC-FERRY-WATCHDOG-RETURN)
)

(defrule
	(goal gl-relic-ferry-state RELIC-FERRY-WATCHDOG-CHECK)
	(not (up-set-target-object search-local c: 0))
=>
	(up-modify-group-flag 0 c: relic-ferry-transport-group)
	(up-reset-group c: relic-ferry-transport-group)
	(up-modify-sn sn-focus-player-number g:= gl-relic-ferry-focus)
	(set-goal gl-relic-ferry-return-attempts 0)
	(up-set-timer c: t-relic-ferry c: 60)
	(set-goal gl-relic-ferry-state RELIC-FERRY-IDLE)
)

;A living transport can still be unable to path back to the active home. Do
;not reserve that hull forever: after three timed return commands, release the
;utility channel so another ferry or migration mission can be attempted.
(defrule
	(up-timer-status t-relic-ferry == timer-triggered)
	(not (goal gl-relic-ferry-state RELIC-FERRY-IDLE))
	(up-compare-goal gl-relic-ferry-return-attempts c:>= 3)
=>
	(up-modify-group-flag 0 c: relic-ferry-transport-group)
	(up-reset-group c: relic-ferry-transport-group)
	(up-modify-sn sn-focus-player-number g:= gl-relic-ferry-focus)
	(set-goal gl-relic-ferry-return-attempts 0)
	(up-chat-data-to-self "relic ferry watchdog abort: %d" g: gl-relic-ferry-transport-id)
	(up-set-timer c: t-relic-ferry c: 60)
	(set-goal gl-relic-ferry-state RELIC-FERRY-IDLE)
)

;Roman Spearmen should not remain the default answer to swordsmen inside the
;base. Confirm that a known enemy Champion is within the town perimeter before
;enabling the emergency Long Swordsman production override.
#load-if-defined BYZANTINE-CIV
(defrule
	(up-timer-status t-defense-leash == timer-triggered)
	(goal gl-champion-threat-scan-state CHAMPION-THREAT-SCAN-IDLE)
	(players-unit-type-count any-enemy champion >= 1)
=>
	(up-modify-goal gl-champion-threat-scan-focus s:= sn-focus-player-number)
	(up-find-player enemy find-closest gl-champion-threat-player)
	(up-modify-sn sn-focus-player-number g:= gl-champion-threat-player)
	(up-full-reset-search)
	(up-set-target-point position-self-x)
	(up-filter-distance c: -1 c: 32)
	(up-find-remote c: champion c: 20)
	(up-clean-search search-remote object-data-distance search-order-asc)
	(up-get-search-state local-total)
	(set-goal gl-champion-threat-scan-state CHAMPION-THREAT-SCAN-CHECK)
)

(defrule
	(goal gl-champion-threat-scan-state CHAMPION-THREAT-SCAN-CHECK)
	(up-set-target-object search-remote c: 0)
=>
	(set-goal gl-roman-champion-base-threat YES)
	(up-modify-goal gl-roman-champion-counter-target g:= remote-total)
	(up-modify-goal gl-roman-champion-counter-target c:+ 3)
	(up-modify-sn sn-focus-player-number g:= gl-champion-threat-scan-focus)
	(set-goal gl-champion-threat-scan-state CHAMPION-THREAT-SCAN-IDLE)
)

(defrule
	(goal gl-roman-champion-base-threat YES)
	(up-compare-goal gl-roman-champion-counter-target c:< 4)
=>
	(set-goal gl-roman-champion-counter-target 4)
)

(defrule
	(goal gl-roman-champion-base-threat YES)
	(up-compare-goal gl-roman-champion-counter-target c:> 12)
=>
	(set-goal gl-roman-champion-counter-target 12)
)

(defrule
	(goal gl-champion-threat-scan-state CHAMPION-THREAT-SCAN-CHECK)
	(not (up-set-target-object search-remote c: 0))
=>
	(set-goal gl-roman-champion-base-threat NO)
	(set-goal gl-roman-champion-counter-target 0)
	(up-modify-sn sn-focus-player-number g:= gl-champion-threat-scan-focus)
	(set-goal gl-champion-threat-scan-state CHAMPION-THREAT-SCAN-IDLE)
)

(defrule
	(goal gl-roman-champion-base-threat YES)
	(players-unit-type-count any-enemy champion <= 0)
=>
	(set-goal gl-roman-champion-base-threat NO)
	(set-goal gl-roman-champion-counter-target 0)
)
#end-if

;Verified attacks use the actual victim-owned point, including a relocated colony.
;The shared verifier already tested exact hostile action/target/victim ownership.
(defrule
	(goal gl-home-defense-state NO)
	(up-timer-status t-defense-leash == timer-triggered)
	(goal gl-local-response-state LOCAL-RESPONSE-IDLE)
	(goal gl-self-attack-verified YES)
=>
	(up-modify-goal gl-local-response-focus s:= sn-focus-player-number)
	(up-modify-goal gl-local-response-player g:= gl-verify-enemy)
	(up-copy-point gl-local-response-target-x gl-verify-asset-x)
	(up-modify-goal gl-local-response-zone g:= gl-verify-zone)
	(set-goal gl-local-response-threats 1)
	(set-goal gl-local-response-siege-threats 0)
	(set-goal gl-local-response-state LOCAL-RESPONSE-COMMAND)
)
(defrule
	(goal gl-local-response-state LOCAL-RESPONSE-COMMAND)
	(goal gl-self-attack-verified YES)
	(goal gl-verify-hostile-class siege-weapon-class)
=>
	(set-goal gl-local-response-siege-threats 1)
)

;Unverified proximity remains an incursion response, never an attack claim.
(defrule
	(goal gl-home-defense-state NO)
	(up-timer-status t-defense-leash == timer-triggered)
	(goal gl-local-response-state LOCAL-RESPONSE-IDLE)
	(goal gl-self-attack-verified NO)
=>
	(up-modify-goal gl-local-response-focus s:= sn-focus-player-number)
	(up-find-player enemy find-closest gl-local-response-player)
	(up-modify-sn sn-focus-player-number g:= gl-local-response-player)
	(up-full-reset-search)
	(up-set-target-point gl-home-anchor-x)
	(up-filter-distance c: -1 c: 48)
	;A lone ram or catapult is a real threat where two scouts are not.
	(up-find-remote c: siege-weapon-class c: 40)
	(up-remove-objects search-remote object-data-map-zone-id g:!= gl-home-zone)
	(up-get-search-state local-total)
	(up-modify-goal gl-local-response-siege-threats g:= remote-total)
	(up-full-reset-search)
	(up-set-target-point gl-home-anchor-x)
	(up-filter-distance c: -1 c: 48)
	(up-find-remote c: scout-cavalry-class c: 40)
	(up-find-remote c: cavalry-archer-class c: 40)
	(up-find-remote c: cavalry-class c: 40)
	(up-find-remote c: infantry-class c: 40)
	(up-find-remote c: archery-class c: 40)
	(up-find-remote c: siege-weapon-class c: 40)
	(up-find-remote c: priest c: 10)
	(up-remove-objects search-remote object-data-map-zone-id g:!= gl-home-zone)
	(up-clean-search search-remote object-data-distance search-order-asc)
	(up-get-search-state local-total)
	(up-modify-goal gl-local-response-threats g:= remote-total)
	(set-goal gl-local-response-state LOCAL-RESPONSE-FIND)
)

(defrule
	(goal gl-local-response-state LOCAL-RESPONSE-FIND)
	(up-set-target-object search-remote c: 0)
=>
	(set-goal gl-t12-help-kind 3)
	(set-goal gl-t12-help-asset -1)
	(up-copy-point gl-t12-help-anchor-x gl-home-anchor-x)
	(up-get-object-data object-data-id gl-t12-help-hostile)
	(up-get-fact game-time 0 gl-t12-help-time)
	(up-get-point position-object gl-local-response-target-x)
	(up-get-object-data object-data-map-zone-id gl-local-response-zone)
	(set-goal gl-local-response-state LOCAL-RESPONSE-COMMAND)
)

;A detected same-zone threat must remain actionable even when no military unit
;is currently available. Keep a short independent latch for emergency
;production/help requests and suspend exposed construction until the area has
;been quiet long enough to reassess it.
(defrule
	(goal gl-local-response-state LOCAL-RESPONSE-COMMAND)
	(up-compare-goal gl-local-response-threats c:>= 1)
=>
	(set-goal gl-local-threat-active YES)
	(up-modify-goal gl-local-threat-until g:= gl-game-time)
	(up-modify-goal gl-local-threat-until c:+ 90)
	(up-modify-goal gl-wall-danger-until g:= gl-game-time)
	(up-modify-goal gl-wall-danger-until c:+ 90)
	(up-chat-data-to-self "local threat construction hold: %d" g: gl-local-response-zone)
)

;Evacuate only perimeter builders. Pulling every builder would cancel the
;emergency Barracks foundation requested earlier in the load order. Stop the
;wall job first, then garrison only when a ready same-zone Town Center is at
;least twelve tiles from the detected hostile. If no such anchor exists the
;builders remain stopped instead of being ordered toward an unproven point.
(defrule
	(goal gl-local-response-state LOCAL-RESPONSE-COMMAND)
	(or
		(up-compare-goal gl-local-response-zone g:== gl-home-zone)
		(up-compare-goal gl-local-response-zone g:== gl-island-colony-zone)
	)
=>
	(set-strategic-number sn-focus-player-number my-player-number)
	(up-full-reset-search)
	(up-set-target-point gl-local-response-target-x)
	(up-filter-distance c: -1 c: 18)
	(up-find-local c: villager-class c: 40)
	(up-remove-objects search-local object-data-group-flag >= 0)
	(up-remove-objects search-local object-data-id g:== gl-boar-lurer-id)
	(up-remove-objects search-local object-data-action != actionid-build)
	;object-data-target is a class-domain operand for builders. Match both wall
	;families through wall-class instead of comparing it with unit-line IDs.
	(up-remove-objects search-local object-data-target != wall-class)
	(up-remove-objects search-local object-data-garrisoned == 1)
	(up-remove-objects search-local object-data-map-zone-id g:!= gl-local-response-zone)
	(up-clean-search search-local object-data-distance search-order-asc)
	;OWNERSHIP command: FREE.
	(up-remove-objects search-local object-data-player != my-player-number)
	(up-remove-objects search-local object-data-group-flag >= 0)
	; RAW12 counter 18
	(up-modify-goal gl-command-counter-18 c:+ 1)
	(up-target-point position-self-x action-stop -1 stance-no-attack)
	(up-set-target-point gl-local-response-target-x)
	(up-filter-distance c: 12 c: 48)
	(up-filter-status c: status-ready c: list-active)
	(up-find-remote c: town-center c: 10)
	(up-remove-objects search-remote object-data-map-zone-id g:!= gl-local-response-zone)
	(up-clean-search search-remote object-data-distance search-order-asc)
	;OWNERSHIP command: FREE.
	(up-remove-objects search-local object-data-player != my-player-number)
	(up-remove-objects search-local object-data-group-flag >= 0)
	(up-target-objects 0 action-garrison -1 stance-no-attack)
	(up-modify-sn sn-focus-player-number g:= gl-local-response-player)
)

(defrule
	(goal gl-local-response-state LOCAL-RESPONSE-COMMAND)
	(or
		(up-compare-goal gl-local-response-zone g:== gl-home-zone)
		(up-compare-goal gl-local-response-zone g:== gl-island-colony-zone)
	)
=>
	(set-strategic-number sn-focus-player-number my-player-number)
	(up-full-reset-search)
	(up-set-target-point gl-local-response-target-x)
	(up-filter-distance c: -1 c: 18)
	(up-find-local c: villager-class c: 40)
	(up-remove-objects search-local object-data-group-flag >= 0)
	(up-remove-objects search-local object-data-id g:== gl-boar-lurer-id)
	(up-remove-objects search-local object-data-action != actionid-build)
	(up-remove-objects search-local object-data-target != gate-class)
	(up-remove-objects search-local object-data-garrisoned == 1)
	(up-remove-objects search-local object-data-map-zone-id g:!= gl-local-response-zone)
	(up-clean-search search-local object-data-distance search-order-asc)
	;OWNERSHIP command: FREE.
	(up-remove-objects search-local object-data-player != my-player-number)
	(up-remove-objects search-local object-data-group-flag >= 0)
	; RAW12 counter 19
	(up-modify-goal gl-command-counter-19 c:+ 1)
	(up-target-point position-self-x action-stop -1 stance-no-attack)
	(up-set-target-point gl-local-response-target-x)
	(up-filter-distance c: 12 c: 48)
	(up-filter-status c: status-ready c: list-active)
	(up-find-remote c: town-center c: 10)
	(up-remove-objects search-remote object-data-map-zone-id g:!= gl-local-response-zone)
	(up-clean-search search-remote object-data-distance search-order-asc)
	;OWNERSHIP command: FREE.
	(up-remove-objects search-local object-data-player != my-player-number)
	(up-remove-objects search-local object-data-group-flag >= 0)
	(up-target-objects 0 action-garrison -1 stance-no-attack)
	(up-modify-sn sn-focus-player-number g:= gl-local-response-player)
)

(defrule
	(goal gl-local-threat-active YES)
	(up-compare-goal gl-game-time g:>= gl-local-threat-until)
	(goal gl-local-response-state LOCAL-RESPONSE-IDLE)
=>
	(set-goal gl-local-threat-active NO)
	(up-chat-data-to-self "local threat hold cleared: %d" g: gl-local-response-zone)
)

;This consumer sits between both local-response target producers and the
;COMMAND consumer. It therefore captures a colony attack even when the whole
;response state machine advances back to IDLE within one rule sweep.
(defrule
	(goal gl-local-response-state LOCAL-RESPONSE-COMMAND)
	(goal gl-island-colony-established YES)
	(up-compare-goal gl-local-response-zone g:== gl-island-colony-zone)
=>
	(set-goal gl-island-colony-threat YES)
	(up-modify-goal gl-island-colony-threat-until g:= gl-game-time)
	(up-modify-goal gl-island-colony-threat-until c:+ 120)
	(up-chat-data-to-self "migration colony threat hold: %d" g: gl-island-colony-zone)
)

(defrule
	(goal gl-local-response-state LOCAL-RESPONSE-COMMAND)
=>
	;Builder evacuation deliberately reuses search-remote for a safe owned TC.
	;Revalidate the hostile list here so responder dispatch never consumes that
	;temporary target or another controller's stale shared search.
	(up-modify-sn sn-focus-player-number g:= gl-local-response-player)
	(up-full-reset-search)
	(up-filter-status c: status-ready c: list-active)
	(up-set-target-point gl-local-response-target-x)
	(up-filter-distance c: -1 c: 32)
	(up-find-remote c: scout-cavalry-class c: 40)
	(up-find-remote c: cavalry-archer-class c: 40)
	(up-find-remote c: cavalry-class c: 40)
	(up-find-remote c: infantry-class c: 40)
	(up-find-remote c: archery-class c: 40)
	(up-find-remote c: siege-weapon-class c: 40)
	(up-find-remote c: priest c: 10)
	(up-remove-objects search-remote object-data-map-zone-id g:!= gl-local-response-zone)
	(up-remove-objects search-remote object-data-player g:!= gl-local-response-player)
	(up-clean-search search-remote object-data-distance search-order-asc)
	(set-goal gl-local-response-state LOCAL-RESPONSE-REBUILD)
)

(defrule
	(goal gl-local-response-state LOCAL-RESPONSE-REBUILD)
=>
	(up-modify-group-flag 0 c: home-defense-response-group)
	(up-reset-group c: home-defense-response-group)
	(set-strategic-number sn-focus-player-number my-player-number)
	(up-reset-search 1 1 0 0)
	(up-set-target-point gl-local-response-target-x)
	(up-filter-distance c: -1 c: 24)
	(up-find-local c: scout-cavalry-class c: 40)
	(up-find-local c: cavalry-archer-class c: 40)
	(up-find-local c: cavalry-class c: 40)
	(up-find-local c: infantry-class c: 40)
	(up-find-local c: archery-class c: 40)
	(up-find-local c: siege-weapon-class c: 40)
	(up-remove-objects search-local object-data-group-flag >= 0)
	(up-remove-objects search-local object-data-idling != 1)
	(up-remove-objects search-local object-data-type == palintonon)
	(up-remove-objects search-local object-data-type == palintonon-packed)
	(up-remove-objects search-local object-data-garrisoned == 1)
	(up-remove-objects search-local object-data-map-zone-id g:!= gl-local-response-zone)
	(up-clean-search search-local object-data-distance search-order-asc)
	(up-remove-objects search-local object-data-index >= 8)
	(up-get-search-state local-total)
	(up-modify-goal gl-local-response-responders g:= local-total)
	(set-goal gl-local-response-state LOCAL-RESPONSE-DISPATCH)
)

;Cancel native exploration before this first explicit land claim.
(defrule
	(goal gl-local-response-state LOCAL-RESPONSE-DISPATCH)
	(up-compare-goal gl-local-response-responders c:> 0)
	(up-set-target-object search-remote c: 0)
	(up-object-data object-data-player g:== gl-local-response-player)
	(up-object-data object-data-status == status-ready)
	(goal gl-owner-explore-suspended NO)
=>
	(set-strategic-number sn-number-explore-groups 0)
	(set-strategic-number sn-total-number-explorers 0)
	(set-strategic-number sn-cap-civilian-explorers 0)
	(set-strategic-number sn-minimum-civilian-explorers 0)
	; RAW12 counter 20
	(up-modify-goal gl-command-counter-20 c:+ 1)
	(up-reset-scouts)
	(set-goal gl-owner-explore-suspended YES)
)

(defrule
	(goal gl-local-response-state LOCAL-RESPONSE-DISPATCH)
	(up-compare-goal gl-local-response-responders c:> 0)
	(up-set-target-object search-remote c: 0)
	(up-object-data object-data-player g:== gl-local-response-player)
	(up-object-data object-data-status == status-ready)
=>
	;OWNERSHIP acquire: only FREE objects may be claimed.
	(up-remove-objects search-local object-data-player != my-player-number)
	(up-remove-objects search-local object-data-group-flag >= 0)
	(up-create-group 0 0 c: home-defense-response-group)
	(up-modify-group-flag 1 c: home-defense-response-group)
	(up-remove-objects search-local object-data-player != my-player-number)
	(up-remove-objects search-local object-data-group-flag != home-defense-response-group)
	(up-target-objects 1 action-default -1 stance-aggressive)
	(up-chat-data-to-self "asset defense responders: %d" g: gl-local-response-responders)
	(up-modify-sn sn-focus-player-number g:= gl-local-response-focus)
	(set-goal gl-local-response-state LOCAL-RESPONSE-IDLE)
)
;Routine probes now dispatch bounded FREE responders in the preceding rule.

(defrule
	(goal gl-local-response-state LOCAL-RESPONSE-DISPATCH)
	(up-compare-goal gl-local-response-responders c:<= 0)
=>
	(up-chat-data-to-self "asset defense no responders zone: %d" g: gl-local-response-zone)
	(up-modify-sn sn-focus-player-number g:= gl-local-response-focus)
	(set-goal gl-local-response-state LOCAL-RESPONSE-IDLE)
)

(defrule
	(goal gl-local-response-state LOCAL-RESPONSE-FIND)
	(not (up-set-target-object search-remote c: 0))
=>
	(set-goal gl-local-response-threats 0)
	(up-modify-sn sn-focus-player-number g:= gl-local-response-focus)
	(set-goal gl-local-response-state LOCAL-RESPONSE-IDLE)
)

;Any attacked coastal economy can call the navy. The subsequent attacker and
;water-zone checks prevent a land raider or a ship in a disconnected basin from
;capturing the response group.
(defrule
	(up-timer-status t-naval-response == timer-triggered)
	(goal gl-naval-response-state NAVAL-RESPONSE-IDLE)
=>
	(up-modify-goal gl-naval-response-focus s:= sn-focus-player-number)
	(set-goal gl-naval-response-asset-zone -1)
	(set-strategic-number sn-focus-player-number my-player-number)
	(up-full-reset-search)
	(up-set-target-point gl-home-anchor-x)
	(up-filter-distance c: -1 c: 160)
	(up-find-local c: warship-class c: 40)
	(up-find-local c: boarding-ship c: 10)
	(up-find-local c: villager-class c: 240)
	(up-find-local c: town-center c: 20)
	(up-find-local c: mining-camp c: 20)
	(up-find-local c: lumber-camp c: 20)
	(up-find-local c: mill c: 20)
	(up-find-local c: dock c: 20)
	(up-find-local c: port c: 10)
	(up-find-local c: shipyard c: 10)
	(up-remove-objects search-local object-data-under-attack <= 0)
	(up-clean-search search-local object-data-distance search-order-desc)
	(set-goal gl-naval-response-state NAVAL-RESPONSE-HOME-FIND)
)

(defrule
	(goal gl-naval-response-state NAVAL-RESPONSE-HOME-FIND)
	(up-set-target-object search-local c: 0)
=>
	(up-get-point position-object gl-naval-response-target-x)
	(up-get-object-data object-data-map-zone-id gl-naval-response-asset-zone)
	(up-find-player enemy find-attacker gl-naval-response-player)
	(up-modify-sn sn-focus-player-number g:= gl-naval-response-player)
	(up-full-reset-search)
	(up-set-target-point gl-naval-response-target-x)
	(up-filter-distance c: -1 c: 32)
	(up-find-remote c: warship-class c: 40)
	(up-find-remote c: boarding-ship c: 10)
	(up-find-remote c: scout-cavalry-class c: 20)
	(up-find-remote c: cavalry-archer-class c: 20)
	(up-find-remote c: cavalry-class c: 20)
	(up-find-remote c: infantry-class c: 40)
	(up-find-remote c: archery-class c: 40)
	(up-find-remote c: siege-weapon-class c: 20)
	(up-remove-objects search-remote object-data-player g:!= gl-naval-response-player)
	(up-remove-objects search-remote object-data-status != status-ready)
	(up-clean-search search-remote object-data-distance search-order-asc)
	(up-get-search-state local-total)
	(up-modify-goal gl-naval-response-threats g:= remote-total)
	(set-goal gl-naval-response-state NAVAL-RESPONSE-HOME-THREAT)
)

;Capture the attacked colony asset before the naval response can complete and
;return to IDLE in the same rule sweep. The asset's land zone is authoritative;
;the later attacker zone can be a water zone and is not comparable to it.
(defrule
	(goal gl-naval-response-state NAVAL-RESPONSE-HOME-THREAT)
	(goal gl-island-colony-established YES)
	(up-compare-goal gl-naval-response-asset-zone g:== gl-island-colony-zone)
=>
	(set-goal gl-island-colony-threat YES)
	(up-modify-goal gl-island-colony-threat-until g:= gl-game-time)
	(up-modify-goal gl-island-colony-threat-until c:+ 120)
	(up-chat-data-to-self "migration colony naval threat hold: %d" g: gl-island-colony-zone)
)

(defrule
	(goal gl-naval-response-state NAVAL-RESPONSE-HOME-FIND)
	(not (up-set-target-object search-local c: 0))
=>
	(set-goal gl-naval-response-threats 0)
	(set-strategic-number sn-focus-player-number my-player-number)
	(up-full-reset-search)
	(up-find-local c: warship-class c: 40)
	(up-find-local c: boarding-ship c: 10)
	(up-remove-objects search-local object-data-group-flag >= 0)
	(up-remove-objects search-local object-data-under-attack <= 0)
	(up-clean-search search-local object-data-distance search-order-asc)
	(set-goal gl-naval-response-state NAVAL-RESPONSE-FIND-SHIP)
)

(defrule
	(goal gl-naval-response-state NAVAL-RESPONSE-HOME-THREAT)
	(up-set-target-object search-remote c: 0)
	(or
		(up-object-data object-data-class == warship-class)
		(up-object-data object-data-type == boarding-ship)
	)
=>
	(up-get-point position-object gl-naval-response-target-x)
	(up-get-object-data object-data-map-zone-id gl-naval-response-zone)
	(set-goal gl-naval-response-land-threat NO)
	(up-chat-data-to-self "naval asset response water zone: %d" g: gl-naval-response-zone)
	(set-goal gl-naval-response-state NAVAL-RESPONSE-HOME-COMMAND)
)

(defrule
	(goal gl-naval-response-state NAVAL-RESPONSE-HOME-THREAT)
	(up-set-target-object search-remote c: 0)
	(and
		(up-object-data object-data-class != warship-class)
		(up-object-data object-data-type != boarding-ship)
	)
=>
	(up-get-point position-object gl-naval-response-target-x)
	(set-goal gl-naval-response-land-threat YES)
	(up-chat-data-to-self "naval response to coastal land threat: %d" c: 1)
	(set-goal gl-naval-response-state NAVAL-RESPONSE-HOME-COMMAND)
)

(defrule
	(goal gl-naval-response-state NAVAL-RESPONSE-HOME-COMMAND)
	(goal gl-naval-response-land-threat NO)
=>
	(set-strategic-number sn-focus-player-number my-player-number)
	(up-modify-group-flag 0 c: home-naval-response-group)
	(up-reset-group c: home-naval-response-group)
	;Clear only the local list; the selected hostile remains in search-remote for
	;HOME-DISPATCH's up-target-objects call.
	(up-reset-search 1 1 0 0)
	(up-set-target-point gl-naval-response-target-x)
	(up-find-local c: warship-class c: 40)
	(up-find-local c: boarding-ship c: 10)
	(up-remove-objects search-local object-data-group-flag >= 0)
	(up-remove-objects search-local object-data-idling != 1)
	(up-remove-objects search-local object-data-map-zone-id g:!= gl-naval-response-zone)
	(up-remove-objects search-local object-data-group-flag >= 0)
	(up-clean-search search-local object-data-distance search-order-asc)
	(up-remove-objects search-local object-data-index >= 8)
	(up-get-search-state local-total)
	(up-modify-goal gl-naval-response-responders g:= local-total)
	(set-goal gl-naval-response-state NAVAL-RESPONSE-HOME-DISPATCH)
)

(defrule
	(goal gl-naval-response-state NAVAL-RESPONSE-HOME-COMMAND)
	(goal gl-naval-response-land-threat YES)
=>
	(set-strategic-number sn-focus-player-number my-player-number)
	(up-modify-group-flag 0 c: home-naval-response-group)
	(up-reset-group c: home-naval-response-group)
	(up-reset-search 1 1 0 0)
	(up-set-target-point gl-naval-response-target-x)
	(up-filter-distance c: -1 c: 56)
	(up-find-local c: warship-class c: 40)
	(up-find-local c: boarding-ship c: 10)
	(up-remove-objects search-local object-data-group-flag >= 0)
	(up-remove-objects search-local object-data-idling != 1)
	(up-remove-objects search-local object-data-group-flag >= 0)
	(up-clean-search search-local object-data-distance search-order-asc)
	(up-remove-objects search-local object-data-index >= 8)
	(up-get-search-state local-total)
	(up-modify-goal gl-naval-response-responders g:= local-total)
	(set-goal gl-naval-response-state NAVAL-RESPONSE-HOME-DISPATCH)
)

(defrule
	(goal gl-naval-response-state NAVAL-RESPONSE-HOME-DISPATCH)
	(goal gl-naval-response-land-threat NO)
	(up-compare-goal gl-naval-response-responders c:> 0)
	(up-set-target-object search-remote c: 0)
	(up-object-data object-data-player g:== gl-naval-response-player)
	(up-object-data object-data-status == status-ready)
=>
	;OWNERSHIP acquire: only FREE objects may be claimed.
	(up-remove-objects search-local object-data-player != my-player-number)
	(up-remove-objects search-local object-data-group-flag >= 0)
	(up-create-group 0 0 c: home-naval-response-group)
	(up-modify-group-flag 1 c: home-naval-response-group)
	(up-remove-objects search-local object-data-player != my-player-number)
	(up-remove-objects search-local object-data-group-flag != home-naval-response-group)
	(up-target-objects 1 action-default -1 stance-aggressive)
	(up-chat-data-to-self "naval defense responders: %d" g: gl-naval-response-responders)
	(up-modify-sn sn-focus-player-number g:= gl-naval-response-focus)
	(up-set-timer c: t-naval-response c: 10)
	(set-goal gl-naval-response-state NAVAL-RESPONSE-IDLE)
)
;Routine probes now dispatch bounded FREE responders in the preceding rule.

;For a land unit attacking a coastal asset, Euclidean proximity cannot prove
;that a responding ship shares the same navigable basin.  Still issue coastal
;support, but do not globally retreat the army or latch home defense on that
;unverified naval path.
(defrule
	(goal gl-naval-response-state NAVAL-RESPONSE-HOME-DISPATCH)
	(goal gl-naval-response-land-threat YES)
	(up-compare-goal gl-naval-response-responders c:> 0)
	(up-set-target-object search-remote c: 0)
	(up-object-data object-data-player g:== gl-naval-response-player)
	(up-object-data object-data-status == status-ready)
=>
	;OWNERSHIP acquire: only FREE objects may be claimed.
	(up-remove-objects search-local object-data-player != my-player-number)
	(up-remove-objects search-local object-data-group-flag >= 0)
	(up-create-group 0 0 c: home-naval-response-group)
	(up-modify-group-flag 1 c: home-naval-response-group)
	;OWNERSHIP command: home-naval-response-group.
	(up-remove-objects search-local object-data-player != my-player-number)
	(up-remove-objects search-local object-data-group-flag != home-naval-response-group)
	(up-target-objects 1 action-default -1 stance-aggressive)
	(up-chat-data-to-self "coastal support responders: %d" g: gl-naval-response-responders)
	(up-modify-sn sn-focus-player-number g:= gl-naval-response-focus)
	(up-set-timer c: t-naval-response c: 10)
	(set-goal gl-naval-response-state NAVAL-RESPONSE-IDLE)
)

(defrule
	(goal gl-naval-response-state NAVAL-RESPONSE-HOME-DISPATCH)
	(up-compare-goal gl-naval-response-responders c:<= 0)
=>
	(up-chat-data-to-self "naval defense no responders zone: %d" g: gl-naval-response-zone)
	(up-modify-sn sn-focus-player-number g:= gl-naval-response-focus)
	(up-set-timer c: t-naval-response c: 10)
	(set-goal gl-naval-response-state NAVAL-RESPONSE-IDLE)
)

(defrule
	(goal gl-naval-response-state NAVAL-RESPONSE-HOME-THREAT)
	(not (up-set-target-object search-remote c: 0))
=>
	(set-goal gl-naval-response-threats 0)
	(up-modify-sn sn-focus-player-number g:= gl-naval-response-focus)
	(up-set-timer c: t-naval-response c: 10)
	(set-goal gl-naval-response-state NAVAL-RESPONSE-IDLE)
)

;These consumers follow their producers in file order so the shared DUC search
;lists cannot be clobbered across a rule-sweep boundary.
(defrule
	(goal gl-naval-response-state NAVAL-RESPONSE-FIND-SHIP)
	(up-set-target-object search-local c: 0)
=>
	(up-get-point position-object gl-naval-response-target-x)
	(up-find-player enemy find-attacker gl-naval-response-player)
	(up-modify-sn sn-focus-player-number g:= gl-naval-response-player)
	(up-full-reset-search)
	(up-set-target-point gl-naval-response-target-x)
	(up-filter-distance c: -1 c: 32)
	(up-find-remote c: warship-class c: 40)
	(up-find-remote c: boarding-ship c: 10)
	(up-find-remote c: scout-cavalry-class c: 20)
	(up-find-remote c: cavalry-archer-class c: 20)
	(up-find-remote c: cavalry-class c: 20)
	(up-find-remote c: infantry-class c: 40)
	(up-find-remote c: archery-class c: 40)
	(up-find-remote c: siege-weapon-class c: 20)
	(up-remove-objects search-remote object-data-player g:!= gl-naval-response-player)
	(up-remove-objects search-remote object-data-status != status-ready)
	(up-clean-search search-remote object-data-distance search-order-asc)
	(up-get-search-state local-total)
	(set-goal gl-naval-response-state NAVAL-RESPONSE-FIND-THREAT)
)

(defrule
	(goal gl-naval-response-state NAVAL-RESPONSE-FIND-SHIP)
	(not (up-set-target-object search-local c: 0))
=>
	(up-modify-sn sn-focus-player-number g:= gl-naval-response-focus)
	(up-set-timer c: t-naval-response c: 15)
	(set-goal gl-naval-response-state NAVAL-RESPONSE-IDLE)
)

(defrule
	(goal gl-naval-response-state NAVAL-RESPONSE-FIND-THREAT)
	(up-set-target-object search-remote c: 0)
	(or
		(up-object-data object-data-class == warship-class)
		(up-object-data object-data-type == boarding-ship)
	)
=>
	(up-get-point position-object gl-naval-response-target-x)
	(up-get-object-data object-data-map-zone-id gl-naval-response-zone)
	(set-goal gl-naval-response-land-threat NO)
	(up-reset-search 1 1 0 0)
	(up-set-target-point gl-naval-response-target-x)
	(up-find-local c: warship-class c: 40)
	(up-find-local c: boarding-ship c: 10)
	(up-remove-objects search-local object-data-map-zone-id g:!= gl-naval-response-zone)
	(up-remove-objects search-local object-data-group-flag >= 0)
	(up-remove-objects search-local object-data-idling != 1)
	(up-clean-search search-local object-data-distance search-order-asc)
	(up-remove-objects search-local object-data-index >= 8)
	;OWNERSHIP command: FREE.
	(up-remove-objects search-local object-data-player != my-player-number)
	(up-remove-objects search-local object-data-group-flag >= 0)
	(up-target-objects 1 action-default -1 stance-aggressive)
	(up-modify-sn sn-focus-player-number g:= gl-naval-response-focus)
	(up-set-timer c: t-naval-response c: 10)
	(set-goal gl-naval-response-state NAVAL-RESPONSE-IDLE)
)

(defrule
	(goal gl-naval-response-state NAVAL-RESPONSE-FIND-THREAT)
	(up-set-target-object search-remote c: 0)
	(and
		(up-object-data object-data-class != warship-class)
		(up-object-data object-data-type != boarding-ship)
	)
=>
	(up-get-point position-object gl-naval-response-target-x)
	(set-goal gl-naval-response-land-threat YES)
	(up-reset-search 1 1 0 0)
	(up-set-target-point gl-naval-response-target-x)
	(up-filter-distance c: -1 c: 56)
	(up-find-local c: warship-class c: 40)
	(up-find-local c: boarding-ship c: 10)
	(up-remove-objects search-local object-data-group-flag >= 0)
	(up-remove-objects search-local object-data-idling != 1)
	(up-clean-search search-local object-data-distance search-order-asc)
	(up-remove-objects search-local object-data-index >= 8)
	;OWNERSHIP command: FREE.
	(up-remove-objects search-local object-data-player != my-player-number)
	(up-remove-objects search-local object-data-group-flag >= 0)
	(up-target-objects 1 action-default -1 stance-aggressive)
	(up-modify-sn sn-focus-player-number g:= gl-naval-response-focus)
	(up-set-timer c: t-naval-response c: 10)
	(set-goal gl-naval-response-state NAVAL-RESPONSE-IDLE)
)

(defrule
	(goal gl-naval-response-state NAVAL-RESPONSE-FIND-THREAT)
	(not (up-set-target-object search-remote c: 0))
=>
	(up-modify-sn sn-focus-player-number g:= gl-naval-response-focus)
	(up-set-timer c: t-naval-response c: 15)
	(set-goal gl-naval-response-state NAVAL-RESPONSE-IDLE)
)

;Vulnerable ranged ships already under capital-ship or static-defense fire
;withdraw toward a safe Port or Shipyard in their own water zone. Reserved
;Scout Ships receive first inspection; other reserved mission ships remain out.
(defrule
	(up-timer-status t-juggernaut-evasion == timer-triggered)
	(goal gl-juggernaut-evasion-state JUGGERNAUT-EVASION-IDLE)
=>
	(up-modify-goal gl-juggernaut-evasion-focus s:= sn-focus-player-number)
	(set-strategic-number sn-focus-player-number my-player-number)
	(up-full-reset-search)
	(up-set-target-point gl-home-anchor-x)
	(up-set-group search-local c: naval-scout-group)
	(up-remove-objects search-local object-data-under-attack <= 0)
	(up-clean-search search-local object-data-distance search-order-asc)
	(set-goal gl-juggernaut-evasion-state JUGGERNAUT-EVASION-SCOUT-CHECK)
)

(defrule
	(goal gl-juggernaut-evasion-state JUGGERNAUT-EVASION-SCOUT-CHECK)
	(up-set-target-object search-local c: 0)
=>
	;Capture the exact grouped scout here instead of depending on a shared local
	;search surviving another rule boundary.
	(up-get-object-data object-data-id gl-juggernaut-evasion-unit-id)
	(up-get-object-data object-data-group-flag gl-owner-evasion-flag)
	(up-get-object-data object-data-map-zone-id gl-juggernaut-evasion-zone)
	(up-get-point position-object gl-juggernaut-evasion-target-x)
	(up-find-player enemy find-attacker gl-juggernaut-evasion-player)
	(up-modify-sn sn-focus-player-number g:= gl-juggernaut-evasion-player)
	(up-full-reset-search)
	(up-set-target-point gl-juggernaut-evasion-target-x)
	(up-filter-distance c: -1 c: 18)
	(up-find-remote c: juggernaut-line c: 10)
	(up-find-remote c: octeres c: 10)
	(up-find-remote c: sea-tower c: 10)
	(up-find-remote c: tower-class c: 20)
	(up-find-remote c: castle c: 10)
	(set-goal gl-juggernaut-evasion-state JUGGERNAUT-EVASION-CHECK)
)

(defrule
	(goal gl-juggernaut-evasion-state JUGGERNAUT-EVASION-SCOUT-CHECK)
	(not (up-set-target-object search-local c: 0))
=>
	(up-full-reset-search)
	(up-find-local c: scout-galley-line c: 10)
	(up-find-local c: polyreme-line c: 20)
	(up-find-local c: hemiolia-line c: 10)
	(up-find-local c: quadrireme c: 10)
	(up-find-local c: quinquereme c: 10)
	(up-find-local c: liburna-line c: 10)
	(up-remove-objects search-local object-data-under-attack <= 0)
	(up-remove-objects search-local object-data-group-flag >= 0)
	(up-clean-search search-local object-data-distance search-order-asc)
	(set-goal gl-juggernaut-evasion-state JUGGERNAUT-EVASION-FIND)
)

(defrule
	(goal gl-juggernaut-evasion-state JUGGERNAUT-EVASION-FIND)
	(up-set-target-object search-local c: 0)
=>
	(up-get-object-data object-data-id gl-juggernaut-evasion-unit-id)
	(up-get-object-data object-data-group-flag gl-owner-evasion-flag)
	(up-get-object-data object-data-map-zone-id gl-juggernaut-evasion-zone)
	(up-get-point position-object gl-juggernaut-evasion-target-x)
	(up-find-player enemy find-attacker gl-juggernaut-evasion-player)
	(up-modify-sn sn-focus-player-number g:= gl-juggernaut-evasion-player)
	(up-full-reset-search)
	(up-set-target-point gl-juggernaut-evasion-target-x)
	(up-filter-distance c: -1 c: 18)
	(up-find-remote c: juggernaut-line c: 10)
	(up-find-remote c: octeres c: 10)
	(up-find-remote c: sea-tower c: 10)
	(up-find-remote c: tower-class c: 20)
	(up-find-remote c: castle c: 10)
	(set-goal gl-juggernaut-evasion-state JUGGERNAUT-EVASION-CHECK)
)

(defrule
	(goal gl-juggernaut-evasion-state JUGGERNAUT-EVASION-FIND)
	(not (up-set-target-object search-local c: 0))
=>
	(up-modify-sn sn-focus-player-number g:= gl-juggernaut-evasion-focus)
	(up-set-timer c: t-juggernaut-evasion c: 10)
	(set-goal gl-juggernaut-evasion-state JUGGERNAUT-EVASION-IDLE)
)

(defrule
	(goal gl-juggernaut-evasion-state JUGGERNAUT-EVASION-CHECK)
	(up-set-target-object search-remote c: 0)
=>
	(set-strategic-number sn-focus-player-number my-player-number)
	(up-full-reset-search)
	(up-set-target-point gl-juggernaut-evasion-target-x)
	(up-find-local c: port c: 10)
	(up-find-local c: shipyard c: 10)
	(up-remove-objects search-local object-data-under-attack > 0)
	(up-remove-objects search-local object-data-map-zone-id g:!= gl-juggernaut-evasion-zone)
	(up-clean-search search-local object-data-distance search-order-asc)
	(set-goal gl-juggernaut-evasion-state JUGGERNAUT-EVASION-FIND-ANCHOR)
)

(defrule
	(goal gl-juggernaut-evasion-state JUGGERNAUT-EVASION-FIND-ANCHOR)
	(up-set-target-object search-local c: 0)
=>
	(up-get-point position-object point2-x)
	(up-full-reset-search)
	(up-add-object-by-id search-local g: gl-juggernaut-evasion-unit-id)
	;OWNERSHIP command: FREE.
	(up-remove-objects search-local object-data-player != my-player-number)
	(up-remove-objects search-local object-data-group-flag g:!= gl-owner-evasion-flag)
	(up-target-point point2-x action-move -1 stance-no-attack)
	(up-modify-sn sn-focus-player-number g:= gl-juggernaut-evasion-focus)
	(up-set-timer c: t-juggernaut-evasion c: 8)
	(set-goal gl-juggernaut-evasion-state JUGGERNAUT-EVASION-IDLE)
)

(defrule
	(goal gl-juggernaut-evasion-state JUGGERNAUT-EVASION-FIND-ANCHOR)
	(not (up-set-target-object search-local c: 0))
=>
	(up-modify-sn sn-focus-player-number g:= gl-juggernaut-evasion-focus)
	(up-set-timer c: t-juggernaut-evasion c: 10)
	(set-goal gl-juggernaut-evasion-state JUGGERNAUT-EVASION-IDLE)
)

(defrule
	(goal gl-juggernaut-evasion-state JUGGERNAUT-EVASION-CHECK)
	(not (up-set-target-object search-remote c: 0))
=>
	(up-modify-sn sn-focus-player-number g:= gl-juggernaut-evasion-focus)
	(up-set-timer c: t-juggernaut-evasion c: 10)
	(set-goal gl-juggernaut-evasion-state JUGGERNAUT-EVASION-IDLE)
)

;Rams and Palintonons are breach engines, not raiders. Form one same-land-zone
;objective group and give the whole detachment one known fortification target,
;so individual engines are not repeatedly packed or dragged onto economy sites.
(defrule
	(up-timer-status t-siege-target == timer-triggered)
	(goal gl-siege-target-state SIEGE-TARGET-IDLE)
	(unit-type-count-total palintonon >= 1)
	(or
		(goal gl-home-defense-state YES)
		(players-building-count any-enemy < 1)
	)
=>
	;A completed or interrupted objective can leave the zero-speed unpacked form
	;inside the persistent siege group. Release it and pack only truly idle,
	;unthreatened engines so they remain movable for the next objective.
	(up-modify-group-flag 0 c: siege-objective-group)
	(up-reset-group c: siege-objective-group)
	;Emergency/no-enemy fallback historically covers all source land zones.
	(set-goal gl-siege-target-zone -1)
	(set-goal gl-siege-target-state SIEGE-TARGET-FALLBACK)
)

;The full-enemy-cycle producer is below this consumer and resumes next pass.
;DUC search lists are shared, not persistent siege-owned snapshots. Rebuild
;here, immediately before the scope filter and PACK; never pack a cached list
;that a Port/Shipyard or other controller may have replaced in the meantime.
(defrule
	(goal gl-siege-target-state SIEGE-TARGET-FALLBACK)
=>
	(up-full-reset-search)
	(up-find-local c: palintonon c: 20)
	(up-remove-objects search-local object-data-type != palintonon)
	(up-remove-objects search-local object-data-player != my-player-number)
	(up-remove-objects search-local object-data-group-flag >= 0)
	(up-remove-objects search-local object-data-garrisoned == 1)
	(up-remove-objects search-local object-data-under-attack > 0)
	(up-remove-objects search-local object-data-idling != 1)
)

(defrule
	(goal gl-siege-target-state SIEGE-TARGET-FALLBACK)
	(up-compare-goal gl-siege-target-zone c:>= 0)
=>
	;Ordinary exhausted-objective fallback remains confined to its source zone.
	(up-remove-objects search-local object-data-map-zone-id g:!= gl-siege-target-zone)
)

(defrule
	(goal gl-siege-target-state SIEGE-TARGET-FALLBACK)
	(up-set-target-object search-local c: 0)
=>
	;OWNERSHIP command: FREE.
	(up-remove-objects search-local object-data-type != palintonon)
	(up-remove-objects search-local object-data-player != my-player-number)
	(up-remove-objects search-local object-data-group-flag >= 0)
	(up-get-search-state local-total)
	(up-modify-goal gl-siege-source-count g:= local-total)
	;action-pack is a point action; target-objects treats it as action-none.
	(up-target-point position-self-x action-pack -1 stance-no-attack)
	(up-chat-data-to-self "idle Palintonons packed: %d" g: gl-siege-source-count)
	(up-set-timer c: t-siege-target c: 12)
	(set-goal gl-siege-target-state SIEGE-TARGET-IDLE)
)

(defrule
	(goal gl-siege-target-state SIEGE-TARGET-FALLBACK)
	(not (up-set-target-object search-local c: 0))
=>
	(up-set-timer c: t-siege-target c: 12)
	(set-goal gl-siege-target-state SIEGE-TARGET-IDLE)
)

(defrule
	(up-timer-status t-siege-target == timer-triggered)
	(goal gl-siege-target-state SIEGE-TARGET-IDLE)
	(goal gl-home-defense-state NO)
	(or
		(unit-type-count-total battering-ram-line >= 1)
		(or
			(unit-type-count-total palintonon >= 1)
			(unit-type-count-total palintonon-packed >= 1)
		)
	)
	(players-building-count any-enemy >= 1)
=>
	(up-modify-goal gl-siege-target-focus s:= sn-focus-player-number)
	(set-strategic-number sn-focus-player-number my-player-number)
	(up-modify-group-flag 0 c: siege-objective-group)
	(up-reset-group c: siege-objective-group)
	(up-full-reset-search)
	(up-set-target-point gl-home-anchor-x)
	(up-find-local c: battering-ram-line c: 40)
	(up-find-local c: palintonon c: 20)
	(up-find-local c: palintonon-packed c: 20)
	(up-remove-objects search-local object-data-garrisoned == 1)
	(up-remove-objects search-local object-data-under-attack > 0)
	(up-remove-objects search-local object-data-group-flag >= 0)
	(up-clean-search search-local object-data-distance search-order-asc)
	(set-goal gl-siege-target-state SIEGE-TARGET-FIND-UNIT)
)

(defrule
	(goal gl-siege-target-state SIEGE-TARGET-FIND-UNIT)
	(up-set-target-object search-local c: 0)
=>
	(up-get-point position-object gl-siege-target-x)
	(up-get-object-data object-data-map-zone-id gl-siege-target-zone)
	(up-get-object-data object-data-id gl-siege-source-id)
	(up-find-player enemy find-ordered gl-siege-target-player)
	(up-modify-goal gl-siege-first-player g:= gl-siege-target-player)
	(up-modify-sn sn-focus-player-number g:= gl-siege-target-player)
	(up-full-reset-search)
	(up-set-target-point gl-siege-target-x)
	(up-filter-distance c: -1 c: 56)
	(up-find-remote c: tower-class c: 40)
	(up-find-remote c: castle c: 10)
	(up-find-remote c: town-center c: 20)
	(up-find-remote c: wall-class c: 40)
	(up-find-remote c: gate-class c: 20)
	(up-remove-objects search-remote object-data-map-zone-id g:!= gl-siege-target-zone)
	(up-clean-search search-remote object-data-distance search-order-asc)
	(set-goal gl-siege-target-state SIEGE-TARGET-FIND-STRUCTURE)
)

(defrule
	(goal gl-siege-target-state SIEGE-TARGET-FIND-UNIT)
	(not (up-set-target-object search-local c: 0))
=>
	(up-modify-sn sn-focus-player-number g:= gl-siege-target-focus)
	(up-set-timer c: t-siege-target c: 12)
	(set-goal gl-siege-target-state SIEGE-TARGET-IDLE)
)

(defrule
	(goal gl-siege-target-state SIEGE-TARGET-FIND-STRUCTURE)
	(up-set-target-object search-remote c: 0)
=>
	(up-get-object-data object-data-id gl-siege-target-id)
	(up-get-point position-object gl-siege-target-x)
	(set-strategic-number sn-focus-player-number my-player-number)
	;The authoritative DAT gives the unpacked Palintonon 16 range and zero speed.
	;Pack only engines outside that envelope; action-default can then move the
	;packed form to the retained fortification while in-range engines keep firing.
	(up-reset-search 1 1 0 0)
	(up-set-target-point gl-siege-target-x)
	(up-filter-distance c: 17 c: 56)
	(up-find-local c: palintonon c: 20)
	(up-remove-objects search-local object-data-map-zone-id g:!= gl-siege-target-zone)
	(up-remove-objects search-local object-data-garrisoned == 1)
	(up-remove-objects search-local object-data-under-attack > 0)
	(up-remove-objects search-local object-data-group-flag >= 0)
	;OWNERSHIP command: FREE.
	(up-remove-objects search-local object-data-type != palintonon)
	(up-remove-objects search-local object-data-player != my-player-number)
	(up-remove-objects search-local object-data-group-flag >= 0)
	;action-pack is a point action; target-objects treats it as action-none.
	(up-target-point position-self-x action-pack -1 stance-no-attack)
	;Pack is asynchronous. Do not immediately replace it with group/default.
	;Rebuild both exact-ID target and engine list after a bounded conversion wait.
	(up-modify-sn sn-focus-player-number g:= gl-siege-target-focus)
	(up-set-timer c: t-siege-target c: 3)
	(set-goal gl-siege-target-state SIEGE-TARGET-PACK-WAIT)
)

(defrule
	(goal gl-siege-target-state SIEGE-TARGET-PACK-WAIT)
	(up-timer-status t-siege-target == timer-triggered)
=>
	(up-modify-sn sn-focus-player-number g:= gl-siege-target-player)
	(up-full-reset-search)
	(up-add-object-by-id search-remote g: gl-siege-target-id)
	(set-strategic-number sn-focus-player-number my-player-number)
	;Preserve the rebuilt remote exact-ID list while rebuilding available breach
	;engines in the sampled source land zone.
	(up-reset-search 1 1 0 0)
	(up-set-target-point gl-siege-target-x)
	(up-find-local c: battering-ram-line c: 40)
	(up-find-local c: palintonon c: 20)
	(up-find-local c: palintonon-packed c: 20)
	(up-remove-objects search-local object-data-map-zone-id g:!= gl-siege-target-zone)
	(up-remove-objects search-local object-data-garrisoned == 1)
	(up-remove-objects search-local object-data-idling != 1)
	(up-remove-objects search-local object-data-under-attack > 0)
	(up-remove-objects search-local object-data-group-flag >= 0)
	(up-clean-search search-local object-data-distance search-order-asc)
	(up-get-search-state local-total)
	(up-modify-goal gl-siege-source-count g:= local-total)
	;OWNERSHIP acquire: only FREE objects may be claimed.
	(up-remove-objects search-local object-data-player != my-player-number)
	(up-remove-objects search-local object-data-group-flag >= 0)
	(up-create-group 0 0 c: siege-objective-group)
	(up-modify-group-flag 1 c: siege-objective-group)
	(set-goal gl-siege-target-state SIEGE-TARGET-PACK-CHECK)
)

(defrule
	(goal gl-siege-target-state SIEGE-TARGET-PACK-CHECK)
	(up-set-target-object search-remote c: 0)
=>
	(set-goal gl-siege-target-state SIEGE-TARGET-COMMAND)
)

(defrule
	(goal gl-siege-target-state SIEGE-TARGET-PACK-CHECK)
	(not (up-set-target-object search-remote c: 0))
=>
	(up-modify-group-flag 0 c: siege-objective-group)
	(up-reset-group c: siege-objective-group)
	(up-modify-sn sn-focus-player-number g:= gl-siege-target-focus)
	(up-set-timer c: t-siege-target c: 12)
	(set-goal gl-siege-target-state SIEGE-TARGET-IDLE)
)

(defrule
	(goal gl-siege-target-state SIEGE-TARGET-COMMAND)
	(up-compare-goal gl-siege-source-count c:> 0)
=>
	;OWNERSHIP command: siege-objective-group.
	(up-remove-objects search-local object-data-player != my-player-number)
	(up-remove-objects search-local object-data-group-flag != siege-objective-group)
	(up-target-objects 1 action-default -1 stance-aggressive)
	(up-chat-data-to-self "siege objective group: %d" g: gl-siege-source-count)
	(up-modify-sn sn-focus-player-number g:= gl-siege-target-focus)
	(up-set-timer c: t-siege-target c: 12)
	(set-goal gl-siege-target-state SIEGE-TARGET-IDLE)
)

(defrule
	(goal gl-siege-target-state SIEGE-TARGET-COMMAND)
	(up-compare-goal gl-siege-source-count c:<= 0)
=>
	(up-modify-group-flag 0 c: siege-objective-group)
	(up-reset-group c: siege-objective-group)
	(up-modify-sn sn-focus-player-number g:= gl-siege-target-focus)
	(up-set-timer c: t-siege-target c: 12)
	(set-goal gl-siege-target-state SIEGE-TARGET-IDLE)
)

(defrule
	(goal gl-siege-target-state SIEGE-TARGET-FIND-STRUCTURE)
	(not (up-set-target-object search-remote c: 0))
=>
	(set-goal gl-siege-target-state SIEGE-TARGET-ADVANCE-PLAYER)
)

(defrule
	(goal gl-siege-target-state SIEGE-TARGET-ADVANCE-PLAYER)
=>
	(up-find-next-player enemy find-ordered gl-siege-target-player)
	(set-goal gl-siege-target-state SIEGE-TARGET-NEXT-PLAYER)
)

(defrule
	(goal gl-siege-target-state SIEGE-TARGET-NEXT-PLAYER)
	(up-compare-goal gl-siege-target-player g:!= gl-siege-first-player)
=>
	(up-modify-sn sn-focus-player-number g:= gl-siege-target-player)
	(up-full-reset-search)
	(up-set-target-point gl-siege-target-x)
	(up-filter-distance c: -1 c: 56)
	(up-find-remote c: tower-class c: 40)
	(up-find-remote c: castle c: 10)
	(up-find-remote c: town-center c: 20)
	(up-find-remote c: wall-class c: 40)
	(up-find-remote c: gate-class c: 20)
	(up-remove-objects search-remote object-data-map-zone-id g:!= gl-siege-target-zone)
	(up-clean-search search-remote object-data-distance search-order-asc)
	(set-goal gl-siege-target-state SIEGE-TARGET-FIND-STRUCTURE)
)

(defrule
	(goal gl-siege-target-state SIEGE-TARGET-NEXT-PLAYER)
	(up-compare-goal gl-siege-target-player g:== gl-siege-first-player)
=>
	;A different enemy may own all global structures, or the sampled source land
	;zone may simply have no valid target. After one full enemy cycle, release the
	;group and pack only idle, unthreatened zero-speed forms.
	(set-strategic-number sn-focus-player-number my-player-number)
	(up-modify-group-flag 0 c: siege-objective-group)
	(up-reset-group c: siege-objective-group)
	;Only persist the state and source zone; FALLBACK rebuilds on its next pass.
	(up-modify-sn sn-focus-player-number g:= gl-siege-target-focus)
	(set-goal gl-siege-target-state SIEGE-TARGET-FALLBACK)
)

;Juggernauts and Octeres have different range envelopes but the engine exposes
;only DUC groups 0..9. Both families remain reserved in one valid shared group;
;the consumer filters that group to the active family before issuing a target.
(load "rawai-naval-siege-watch")
;Escorts are rebuilt from a positive light-hull allowlist and guard the exact
;capital without consuming a second persistent group slot.
(defrule
	(up-timer-status t-naval-siege == timer-triggered)
	(goal gl-naval-siege-state SIEGE-TARGET-IDLE)
	(goal gl-home-defense-state NO)
	(goal gl-juggernaut-evasion-state JUGGERNAUT-EVASION-IDLE)
	(goal gl-naval-siege-family 0)
	(unit-type-count-total juggernaut-line >= 1)
	(players-building-count any-enemy >= 1)
=>
	(up-modify-goal gl-naval-siege-focus s:= sn-focus-player-number)
	(set-strategic-number sn-focus-player-number my-player-number)
	(up-modify-group-flag 0 c: juggernaut-bombardment-group)
	(up-reset-group c: juggernaut-bombardment-group)
	(set-goal gl-naval-siege-state SIEGE-TARGET-SELECT)
)

(defrule
	(up-timer-status t-naval-siege == timer-triggered)
	(goal gl-naval-siege-state SIEGE-TARGET-IDLE)
	(goal gl-home-defense-state NO)
	(goal gl-juggernaut-evasion-state JUGGERNAUT-EVASION-IDLE)
	(goal gl-naval-siege-family 1)
	(unit-type-count-total octeres >= 1)
	(players-building-count any-enemy >= 1)
=>
	(up-modify-goal gl-naval-siege-focus s:= sn-focus-player-number)
	(set-strategic-number sn-focus-player-number my-player-number)
	(up-modify-group-flag 0 c: octeres-bombardment-group)
	(up-reset-group c: octeres-bombardment-group)
	(set-goal gl-naval-siege-state SIEGE-TARGET-SELECT)
)

(defrule
	(up-timer-status t-naval-siege == timer-triggered)
	(goal gl-naval-siege-state SIEGE-TARGET-IDLE)
	(goal gl-naval-siege-family 0)
	(unit-type-count-total juggernaut-line < 1)
=>
	(up-modify-group-flag 0 c: juggernaut-bombardment-group)
	(up-reset-group c: juggernaut-bombardment-group)
	(set-goal gl-naval-siege-family 1)
)

(defrule
	(up-timer-status t-naval-siege == timer-triggered)
	(goal gl-naval-siege-state SIEGE-TARGET-IDLE)
	(goal gl-naval-siege-family 1)
	(unit-type-count-total octeres < 1)
=>
	(up-modify-group-flag 0 c: octeres-bombardment-group)
	(up-reset-group c: octeres-bombardment-group)
	(set-goal gl-naval-siege-family 0)
	(up-set-timer c: t-naval-siege c: 12)
)

;Select one unreserved source hull first. The family group is formed only after
;the source water zone has been captured, so other basins remain available.
(defrule
	(goal gl-naval-siege-state SIEGE-TARGET-SELECT)
	(goal gl-naval-siege-family 0)
=>
	(up-full-reset-search)
	(up-set-target-point gl-home-anchor-x)
	(up-find-local c: juggernaut-line c: 200)
	(up-remove-objects search-local object-data-under-attack > 0)
	(up-remove-objects search-local object-data-group-flag >= 0)
	(up-clean-search search-local object-data-distance search-order-asc)
	(set-goal gl-naval-siege-state SIEGE-TARGET-FIND-UNIT)
)

(defrule
	(goal gl-naval-siege-state SIEGE-TARGET-SELECT)
	(goal gl-naval-siege-family 1)
=>
	(up-full-reset-search)
	(up-set-target-point gl-home-anchor-x)
	(up-find-local c: octeres c: 200)
	(up-remove-objects search-local object-data-under-attack > 0)
	(up-remove-objects search-local object-data-group-flag >= 0)
	(up-clean-search search-local object-data-distance search-order-asc)
	(set-goal gl-naval-siege-state SIEGE-TARGET-FIND-UNIT)
)

(defrule
	(goal gl-naval-siege-state SIEGE-TARGET-FIND-UNIT)
	(goal gl-naval-siege-family 0)
	(up-set-target-object search-local c: 0)
=>
	(up-get-point position-object gl-naval-siege-target-x)
	(up-get-object-data object-data-id gl-naval-siege-source-id)
	(up-get-object-data object-data-map-zone-id gl-naval-siege-zone)
	(set-goal gl-naval-siege-state SIEGE-TARGET-GROUP)
)

(defrule
	(goal gl-naval-siege-state SIEGE-TARGET-FIND-UNIT)
	(goal gl-naval-siege-family 1)
	(up-set-target-object search-local c: 0)
=>
	(up-get-point position-object gl-naval-siege-target-x)
	(up-get-object-data object-data-id gl-naval-siege-source-id)
	(up-get-object-data object-data-map-zone-id gl-naval-siege-zone)
	(set-goal gl-naval-siege-state SIEGE-TARGET-GROUP)
)

(defrule
	(goal gl-naval-siege-state SIEGE-TARGET-GROUP)
	(goal gl-naval-siege-family 0)
=>
	(up-full-reset-search)
	(up-set-target-point gl-naval-siege-target-x)
	(up-find-local c: juggernaut-line c: 200)
	(up-remove-objects search-local object-data-under-attack > 0)
	(up-remove-objects search-local object-data-group-flag >= 0)
	(up-remove-objects search-local object-data-map-zone-id g:!= gl-naval-siege-zone)
	(up-clean-search search-local object-data-distance search-order-asc)
	(up-get-search-state local-total)
	(up-modify-goal gl-naval-siege-escort-count g:= local-total)
	(up-modify-goal gl-naval-siege-escort-count c:* 2)
	(up-modify-goal gl-naval-siege-escort-count c:min 8)
	;Keep the other capital family reserved while this family is active.
	(up-find-local c: octeres c: 200)
	(up-remove-objects search-local object-data-under-attack > 0)
	(up-remove-objects search-local object-data-group-flag >= 0)
	(up-remove-objects search-local object-data-map-zone-id g:!= gl-naval-siege-zone)
	;OWNERSHIP acquire: only FREE objects may be claimed.
	(up-remove-objects search-local object-data-player != my-player-number)
	(up-remove-objects search-local object-data-group-flag >= 0)
	(up-create-group 0 0 c: juggernaut-bombardment-group)
	(up-modify-group-flag 1 c: juggernaut-bombardment-group)
	(set-goal gl-naval-siege-state SIEGE-TARGET-ESCORT-SELECT)
)

(defrule
	(goal gl-naval-siege-state SIEGE-TARGET-GROUP)
	(goal gl-naval-siege-family 1)
=>
	(up-full-reset-search)
	(up-set-target-point gl-naval-siege-target-x)
	(up-find-local c: octeres c: 200)
	(up-remove-objects search-local object-data-under-attack > 0)
	(up-remove-objects search-local object-data-group-flag >= 0)
	(up-remove-objects search-local object-data-map-zone-id g:!= gl-naval-siege-zone)
	(up-clean-search search-local object-data-distance search-order-asc)
	(up-get-search-state local-total)
	(up-modify-goal gl-naval-siege-escort-count g:= local-total)
	(up-modify-goal gl-naval-siege-escort-count c:* 2)
	(up-modify-goal gl-naval-siege-escort-count c:min 8)
	;Keep the other capital family reserved while this family is active.
	(up-find-local c: juggernaut-line c: 200)
	(up-remove-objects search-local object-data-under-attack > 0)
	(up-remove-objects search-local object-data-group-flag >= 0)
	(up-remove-objects search-local object-data-map-zone-id g:!= gl-naval-siege-zone)
	;OWNERSHIP acquire: only FREE objects may be claimed.
	(up-remove-objects search-local object-data-player != my-player-number)
	(up-remove-objects search-local object-data-group-flag >= 0)
	(up-create-group 0 0 c: octeres-bombardment-group)
	(up-modify-group-flag 1 c: octeres-bombardment-group)
	(set-goal gl-naval-siege-state SIEGE-TARGET-ESCORT-SELECT)
)

(defrule
	(goal gl-naval-siege-state SIEGE-TARGET-ESCORT-SELECT)
	(goal gl-naval-siege-family 0)
=>
	(set-goal gl-naval-siege-state SIEGE-TARGET-ESCORT)
)

(defrule
	(goal gl-naval-siege-state SIEGE-TARGET-ESCORT-SELECT)
	(goal gl-naval-siege-family 1)
=>
	(set-goal gl-naval-siege-state SIEGE-TARGET-ESCORT)
)

;Rebuild escorts in the consumer rule so no shared search list has to survive a
;state boundary. Guard orders reserve these ungrouped lights by action while
;the valid shared capital group remains available for structure targeting.
(defrule
	(goal gl-naval-siege-state SIEGE-TARGET-ESCORT)
	(up-group-size c: juggernaut-bombardment-group > 0)
=>
	(set-strategic-number sn-focus-player-number my-player-number)
	(up-full-reset-search)
	(up-set-target-point gl-naval-siege-target-x)
	(up-find-local c: scout-galley-line c: 30)
	(up-find-local c: polyreme-line c: 30)
	(up-find-local c: hemiolia-line c: 30)
	(up-find-local c: quadrireme c: 30)
	(up-find-local c: quinquereme c: 30)
	(up-find-local c: liburna-line c: 30)
	(up-find-local c: fire-ship-line c: 30)
	(up-find-local c: fire-galley c: 30)
	(up-find-local c: boarding-ship c: 30)
	(up-remove-objects search-local object-data-under-attack > 0)
	(up-remove-objects search-local object-data-group-flag >= 0)
	(up-remove-objects search-local object-data-map-zone-id g:!= gl-naval-siege-zone)
	(up-clean-search search-local object-data-distance search-order-asc)
	(up-remove-objects search-local object-data-index g:>= gl-naval-siege-escort-count)
	(up-get-search-state local-total)
	(up-modify-goal gl-naval-siege-escort-count g:= local-total)
	(up-add-object-by-id search-remote g: gl-naval-siege-source-id)
	;OWNERSHIP command: FREE.
	(up-remove-objects search-local object-data-player != my-player-number)
	(up-remove-objects search-local object-data-group-flag >= 0)
	(up-target-objects 0 action-guard -1 stance-aggressive)
	;Retain T11's nearest-enemy policy. Range growth and command-time identity
	;reconstruction are independent of the reverted T12 enemy-priority change.
)

(defrule
	(goal gl-naval-siege-state SIEGE-TARGET-ESCORT)
	(up-group-size c: juggernaut-bombardment-group > 0)
=>
	(up-find-player enemy find-closest gl-naval-siege-player)
	(up-modify-sn sn-focus-player-number g:= gl-naval-siege-player)
	(up-full-reset-search)
	(up-set-target-point gl-naval-siege-target-x)
	(up-filter-distance c: -1 g: gl-naval-search-sea-radius)
	(up-find-remote c: sea-tower c: 20)
	(up-clean-search search-remote object-data-distance search-order-asc)
	(set-goal gl-naval-siege-state SIEGE-TARGET-FIND-STRUCTURE)
)

(defrule
	(goal gl-naval-siege-state SIEGE-TARGET-ESCORT)
	(goal gl-naval-siege-family 0)
	(up-group-size c: juggernaut-bombardment-group <= 0)
=>
	(up-chat-data-to-self "Juggernaut group formation failed: %d" g: gl-naval-siege-source-id)
	(up-modify-sn sn-focus-player-number g:= gl-naval-siege-focus)
	(set-goal gl-naval-siege-family 1)
	(up-set-timer c: t-naval-siege c: 12)
	(set-goal gl-naval-siege-state SIEGE-TARGET-IDLE)
)

(defrule
	(goal gl-naval-siege-state SIEGE-TARGET-ESCORT)
	(goal gl-naval-siege-family 1)
	(up-group-size c: octeres-bombardment-group <= 0)
=>
	(up-chat-data-to-self "Octeres group formation failed: %d" g: gl-naval-siege-source-id)
	(up-modify-sn sn-focus-player-number g:= gl-naval-siege-focus)
	(set-goal gl-naval-siege-family 0)
	(up-set-timer c: t-naval-siege c: 12)
	(set-goal gl-naval-siege-state SIEGE-TARGET-IDLE)
)

(defrule
	(goal gl-naval-siege-state SIEGE-TARGET-FIND-UNIT)
	(goal gl-naval-siege-family 0)
	(not (up-set-target-object search-local c: 0))
=>
	(up-modify-sn sn-focus-player-number g:= gl-naval-siege-focus)
	(up-modify-group-flag 0 c: juggernaut-bombardment-group)
	(up-reset-group c: juggernaut-bombardment-group)
	(set-goal gl-naval-siege-family 1)
	(up-set-timer c: t-naval-siege c: 12)
	(set-goal gl-naval-siege-state SIEGE-TARGET-IDLE)
)

(defrule
	(goal gl-naval-siege-state SIEGE-TARGET-FIND-UNIT)
	(goal gl-naval-siege-family 1)
	(not (up-set-target-object search-local c: 0))
=>
	(up-modify-sn sn-focus-player-number g:= gl-naval-siege-focus)
	(up-modify-group-flag 0 c: octeres-bombardment-group)
	(up-reset-group c: octeres-bombardment-group)
	(set-goal gl-naval-siege-family 0)
	(up-set-timer c: t-naval-siege c: 12)
	(set-goal gl-naval-siege-state SIEGE-TARGET-IDLE)
)

(defrule
	(goal gl-naval-siege-state SIEGE-TARGET-FIND-STRUCTURE)
	(goal gl-naval-siege-family 0)
	(up-set-target-object search-remote c: 0)
=>
	(up-get-object-data object-data-type gl-naval-siege-target-type)
	(up-get-object-data object-data-id gl-naval-siege-target-id)
	(up-get-point position-object gl-naval-siege-target-x)
	(set-strategic-number sn-focus-player-number my-player-number)
	(up-reset-search 1 1 0 0)
	(up-set-group search-local c: juggernaut-bombardment-group)
	(up-remove-objects search-local object-data-type == octeres)
	(up-remove-objects search-local object-data-under-attack > 0)
	(up-remove-objects search-local object-data-map-zone-id g:!= gl-naval-siege-zone)
	(up-get-search-state local-total)
	(up-modify-goal gl-naval-siege-source-count g:= local-total)
	(set-goal gl-naval-siege-state SIEGE-TARGET-COMMAND)
)

(defrule
	(goal gl-naval-siege-state SIEGE-TARGET-FIND-STRUCTURE)
	(goal gl-naval-siege-family 1)
	(up-set-target-object search-remote c: 0)
=>
	(up-get-object-data object-data-type gl-naval-siege-target-type)
	(up-get-object-data object-data-id gl-naval-siege-target-id)
	(up-get-point position-object gl-naval-siege-target-x)
	(set-strategic-number sn-focus-player-number my-player-number)
	(up-reset-search 1 1 0 0)
	(up-set-group search-local c: octeres-bombardment-group)
	(up-remove-objects search-local object-data-type != octeres)
	(up-remove-objects search-local object-data-under-attack > 0)
	(up-remove-objects search-local object-data-map-zone-id g:!= gl-naval-siege-zone)
	(up-get-search-state local-total)
	(up-modify-goal gl-naval-siege-source-count g:= local-total)
	(set-goal gl-naval-siege-state SIEGE-TARGET-COMMAND)
)

;Fallback selection is below the command rules and can cross a sweep. Recover
;both identities here, after all unrelated shared-search writers have run.
(defrule
	(goal gl-naval-siege-state SIEGE-TARGET-COMMAND)
=>
	(up-full-reset-search)
	(up-modify-sn sn-focus-player-number g:= gl-naval-siege-player)
	(up-add-object-by-id search-remote g: gl-naval-siege-target-id)
	(up-remove-objects search-remote object-data-player g:!= gl-naval-siege-player)
	(set-strategic-number sn-focus-player-number my-player-number)
	(up-set-group search-local c: juggernaut-bombardment-group)
	(up-remove-objects search-local object-data-player != my-player-number)
	(up-remove-objects search-local object-data-group-flag != juggernaut-bombardment-group)
	(up-remove-objects search-local object-data-under-attack > 0)
	(up-remove-objects search-local object-data-map-zone-id g:!= gl-naval-siege-zone)
)

(defrule
	(goal gl-naval-siege-state SIEGE-TARGET-COMMAND)
	(goal gl-naval-siege-family 0)
=>
	(up-remove-objects search-local object-data-type == octeres)
	(up-get-search-state local-total)
	(up-modify-goal gl-naval-siege-source-count g:= local-total)
)

(defrule
	(goal gl-naval-siege-state SIEGE-TARGET-COMMAND)
	(goal gl-naval-siege-family 1)
=>
	(up-remove-objects search-local object-data-type != octeres)
	(up-get-search-state local-total)
	(up-modify-goal gl-naval-siege-source-count g:= local-total)
)

(defrule
	(goal gl-naval-siege-state SIEGE-TARGET-COMMAND)
	(not (up-set-target-object search-remote c: 0))
=>
	(up-modify-sn sn-focus-player-number g:= gl-naval-siege-focus)
	(up-modify-goal gl-naval-siege-family c:* -1)
	(up-modify-goal gl-naval-siege-family c:+ 1)
	(up-set-timer c: t-naval-siege c: 12)
	(set-goal gl-naval-siege-state SIEGE-TARGET-IDLE)
)

(defrule
	(goal gl-naval-siege-state SIEGE-TARGET-COMMAND)
	(goal gl-naval-siege-family 0)
	(up-compare-goal gl-naval-siege-source-count c:> 0)
	(up-set-target-object search-remote c: 0)
	(up-object-data object-data-id g:== gl-naval-siege-target-id)
=>
	(up-modify-goal gl-naval-watch-source g:= gl-naval-siege-source-id)
	(up-modify-goal gl-naval-watch-target g:= gl-naval-siege-target-id)
	(up-modify-goal gl-naval-watch-player g:= gl-naval-siege-player)
	(up-get-object-data object-data-hitpoints gl-naval-watch-hp)
	;OWNERSHIP command: juggernaut-bombardment-group.
	(up-remove-objects search-local object-data-player != my-player-number)
	(up-remove-objects search-local object-data-group-flag != juggernaut-bombardment-group)
	(up-target-objects 1 action-default -1 stance-aggressive)
	(up-chat-data-to-self "Juggernaut bombardment escorts: %d" g: gl-naval-siege-escort-count)
	(up-chat-data-to-self "naval bombardment target type: %d" g: gl-naval-siege-target-type)
	(up-chat-data-to-self "naval bombardment target id: %d" g: gl-naval-siege-target-id)
	(up-chat-data-to-self "naval bombardment water zone: %d" g: gl-naval-siege-zone)
	(up-modify-sn sn-focus-player-number g:= gl-naval-siege-focus)
	(set-goal gl-naval-siege-family 1)
	(up-set-timer c: t-naval-siege c: 12)
	(set-goal gl-naval-siege-state SIEGE-TARGET-IDLE)
)

(defrule
	(goal gl-naval-siege-state SIEGE-TARGET-COMMAND)
	(goal gl-naval-siege-family 1)
	(up-compare-goal gl-naval-siege-source-count c:> 0)
	(up-set-target-object search-remote c: 0)
	(up-object-data object-data-id g:== gl-naval-siege-target-id)
=>
	(up-modify-goal gl-naval-watch-source g:= gl-naval-siege-source-id)
	(up-modify-goal gl-naval-watch-target g:= gl-naval-siege-target-id)
	(up-modify-goal gl-naval-watch-player g:= gl-naval-siege-player)
	(up-get-object-data object-data-hitpoints gl-naval-watch-hp)
	;OWNERSHIP command: juggernaut-bombardment-group.
	(up-remove-objects search-local object-data-player != my-player-number)
	(up-remove-objects search-local object-data-group-flag != juggernaut-bombardment-group)
	(up-target-objects 1 action-default -1 stance-aggressive)
	(up-chat-data-to-self "Octeres bombardment escorts: %d" g: gl-naval-siege-escort-count)
	(up-chat-data-to-self "naval bombardment target type: %d" g: gl-naval-siege-target-type)
	(up-chat-data-to-self "naval bombardment target id: %d" g: gl-naval-siege-target-id)
	(up-chat-data-to-self "naval bombardment water zone: %d" g: gl-naval-siege-zone)
	(up-modify-sn sn-focus-player-number g:= gl-naval-siege-focus)
	(set-goal gl-naval-siege-family 0)
	(up-set-timer c: t-naval-siege c: 12)
	(set-goal gl-naval-siege-state SIEGE-TARGET-IDLE)
)

(defrule
	(goal gl-naval-siege-state SIEGE-TARGET-COMMAND)
	(goal gl-naval-siege-family 0)
	(up-compare-goal gl-naval-siege-source-count c:<= 0)
=>
	(up-modify-sn sn-focus-player-number g:= gl-naval-siege-focus)
	(set-goal gl-naval-siege-family 1)
	(up-set-timer c: t-naval-siege c: 12)
	(set-goal gl-naval-siege-state SIEGE-TARGET-IDLE)
)

(defrule
	(goal gl-naval-siege-state SIEGE-TARGET-COMMAND)
	(goal gl-naval-siege-family 1)
	(up-compare-goal gl-naval-siege-source-count c:<= 0)
=>
	(up-modify-sn sn-focus-player-number g:= gl-naval-siege-focus)
	(set-goal gl-naval-siege-family 0)
	(up-set-timer c: t-naval-siege c: 12)
	(set-goal gl-naval-siege-state SIEGE-TARGET-IDLE)
)

(defrule
	(goal gl-naval-siege-state SIEGE-TARGET-FIND-STRUCTURE)
	(not (up-set-target-object search-remote c: 0))
=>
	;Expand discovery after bounded inactivity, not the ship's weapon range.
	;Still restrict targets to fortifications; do not add inland Town Centers.
	(up-full-reset-search)
	(up-set-target-point gl-naval-siege-target-x)
	(up-filter-distance c: -1 g: gl-naval-search-radius)
	(up-find-remote c: tower-class c: 20)
	(up-find-remote c: castle c: 10)
	(up-find-remote c: wall-class c: 20)
	(up-find-remote c: gate-class c: 10)
	(up-clean-search search-remote object-data-distance search-order-asc)
	(set-goal gl-naval-siege-state SIEGE-TARGET-FALLBACK)
)

(defrule
	(goal gl-naval-siege-state SIEGE-TARGET-FALLBACK)
	(goal gl-naval-siege-family 0)
	(up-set-target-object search-remote c: 0)
=>
	(up-get-object-data object-data-type gl-naval-siege-target-type)
	(up-get-object-data object-data-id gl-naval-siege-target-id)
	(up-get-point position-object gl-naval-siege-target-x)
	(set-strategic-number sn-focus-player-number my-player-number)
	(up-reset-search 1 1 0 0)
	(up-set-group search-local c: juggernaut-bombardment-group)
	(up-remove-objects search-local object-data-type == octeres)
	(up-remove-objects search-local object-data-under-attack > 0)
	(up-remove-objects search-local object-data-map-zone-id g:!= gl-naval-siege-zone)
	(up-get-search-state local-total)
	(up-modify-goal gl-naval-siege-source-count g:= local-total)
	(set-goal gl-naval-siege-state SIEGE-TARGET-COMMAND)
)

(defrule
	(goal gl-naval-siege-state SIEGE-TARGET-FALLBACK)
	(goal gl-naval-siege-family 1)
	(up-set-target-object search-remote c: 0)
=>
	(up-get-object-data object-data-type gl-naval-siege-target-type)
	(up-get-object-data object-data-id gl-naval-siege-target-id)
	(up-get-point position-object gl-naval-siege-target-x)
	(set-strategic-number sn-focus-player-number my-player-number)
	(up-reset-search 1 1 0 0)
	(up-set-group search-local c: octeres-bombardment-group)
	(up-remove-objects search-local object-data-type != octeres)
	(up-remove-objects search-local object-data-under-attack > 0)
	(up-remove-objects search-local object-data-map-zone-id g:!= gl-naval-siege-zone)
	(up-get-search-state local-total)
	(up-modify-goal gl-naval-siege-source-count g:= local-total)
	(set-goal gl-naval-siege-state SIEGE-TARGET-COMMAND)
)

(defrule
	(goal gl-naval-siege-state SIEGE-TARGET-FALLBACK)
	(goal gl-naval-siege-family 0)
	(not (up-set-target-object search-remote c: 0))
=>
	(up-modify-sn sn-focus-player-number g:= gl-naval-siege-focus)
	(set-goal gl-naval-siege-family 1)
	(up-set-timer c: t-naval-siege c: 12)
	(set-goal gl-naval-siege-state SIEGE-TARGET-IDLE)
)

(defrule
	(goal gl-naval-siege-state SIEGE-TARGET-FALLBACK)
	(goal gl-naval-siege-family 1)
	(not (up-set-target-object search-remote c: 0))
=>
	(up-modify-sn sn-focus-player-number g:= gl-naval-siege-focus)
	(set-goal gl-naval-siege-family 0)
	(up-set-timer c: t-naval-siege c: 12)
	(set-goal gl-naval-siege-state SIEGE-TARGET-IDLE)
)

;Positive land/naval responder dispatches own the home-defense latch.  A threat
;with no reachable responders must not globally freeze attacks and migration.
;Ownership preemption is handled by rawai-severe-defense.

;Ownership preemption is handled by rawai-severe-defense.

;Abort a transport route when an attacked-home threat is observed, even when
;no ordinary responder exists to raise the global defense latch. Re-resolve
;the exact route hull and include the outbound RETURN stages: they begin after
;the unload command is issued, not after the passengers are proven ashore.
;Ownership preemption is handled by rawai-severe-defense.

;Ownership preemption is handled by rawai-severe-defense.

;Ownership preemption is handled by rawai-severe-defense.

;The raid state returns to IDLE immediately after dispatch, so state alone does
;not identify a launched DUC raid. Recall the reserved group itself when home
;defense activates, then release its ownership flag.
;Ownership preemption is handled by rawai-severe-defense.

;Response groups leash to the attacked anchor's zone, not always to the original
;Town Center. Otherwise an island defender is ordered to walk across water.
(defrule
	(up-timer-status t-defense-leash == timer-triggered)
	(up-group-size c: home-defense-response-group > 0)
=>
	(up-modify-goal gl-local-response-focus s:= sn-focus-player-number)
	(set-strategic-number sn-focus-player-number my-player-number)
	(up-full-reset-search)
	(up-set-target-point gl-local-response-target-x)
	(up-filter-distance c: 48 c: -1)
	(up-find-local c: scout-cavalry-class c: 40)
	(up-find-local c: cavalry-archer-class c: 40)
	(up-find-local c: cavalry-class c: 40)
	(up-find-local c: infantry-class c: 40)
	(up-find-local c: archery-class c: 40)
	(up-find-local c: siege-weapon-class c: 40)
	(up-remove-objects search-local object-data-type == palintonon)
	(up-remove-objects search-local object-data-type == palintonon-packed)
	(up-remove-objects search-local object-data-group-flag != home-defense-response-group)
	;OWNERSHIP command: home-defense-response-group.
	(up-remove-objects search-local object-data-player != my-player-number)
	(up-remove-objects search-local object-data-group-flag != home-defense-response-group)
	(up-target-point gl-local-response-target-x action-move -1 stance-defensive)
	(up-modify-sn sn-focus-player-number g:= gl-local-response-focus)
)

(defrule
	(up-timer-status t-defense-leash == timer-triggered)
	(up-group-size c: home-naval-response-group > 0)
=>
	(up-modify-goal gl-naval-response-focus s:= sn-focus-player-number)
	(set-strategic-number sn-focus-player-number my-player-number)
	(up-full-reset-search)
	(up-set-target-point gl-naval-response-target-x)
	(up-filter-distance c: 72 c: -1)
	(up-find-local c: warship-class c: 40)
	(up-find-local c: boarding-ship c: 10)
	(up-remove-objects search-local object-data-group-flag != home-naval-response-group)
	;OWNERSHIP command: home-naval-response-group.
	(up-remove-objects search-local object-data-player != my-player-number)
	(up-remove-objects search-local object-data-group-flag != home-naval-response-group)
	(up-target-point gl-naval-response-target-x action-move -1 stance-defensive)
	(up-modify-sn sn-focus-player-number g:= gl-naval-response-focus)
)

;Once the defense latch clears, release responders at the defended anchor. A
;later ordinary military rule may reassign them, but no impossible cross-water
;recall is issued.
(defrule
	(goal gl-home-defense-state NO)
	(up-group-size c: home-defense-response-group > 0)
=>
	(up-modify-goal gl-local-response-focus s:= sn-focus-player-number)
	(set-strategic-number sn-focus-player-number my-player-number)
	(up-full-reset-search)
	(up-find-local c: scout-cavalry-class c: 40)
	(up-find-local c: cavalry-archer-class c: 40)
	(up-find-local c: cavalry-class c: 40)
	(up-find-local c: infantry-class c: 40)
	(up-find-local c: archery-class c: 40)
	(up-find-local c: siege-weapon-class c: 40)
	(up-remove-objects search-local object-data-group-flag != home-defense-response-group)
	;OWNERSHIP command: home-defense-response-group.
	(up-remove-objects search-local object-data-player != my-player-number)
	(up-remove-objects search-local object-data-group-flag != home-defense-response-group)
	(up-modify-group-flag 0 c: home-defense-response-group)
	(up-reset-group c: home-defense-response-group)
	(up-modify-sn sn-focus-player-number g:= gl-local-response-focus)
)

(defrule
	(goal gl-home-defense-state NO)
	(up-group-size c: home-naval-response-group > 0)
=>
	(up-modify-goal gl-naval-response-focus s:= sn-focus-player-number)
	(set-strategic-number sn-focus-player-number my-player-number)
	(up-full-reset-search)
	(up-find-local c: warship-class c: 40)
	(up-find-local c: boarding-ship c: 10)
	(up-remove-objects search-local object-data-group-flag != home-naval-response-group)
	;OWNERSHIP command: home-naval-response-group.
	(up-remove-objects search-local object-data-player != my-player-number)
	(up-remove-objects search-local object-data-group-flag != home-naval-response-group)
	(up-modify-group-flag 0 c: home-naval-response-group)
	(up-reset-group c: home-naval-response-group)
	(up-modify-sn sn-focus-player-number g:= gl-naval-response-focus)
)

;Native defenders are not a free group; no convenience home leash.

;Keep the main army available for decisive attacks while a small detachment raids
;known economy and production targets outside the nearest enemy Town Center.
(defrule
	(up-timer-status t-opportunistic-raid == timer-triggered)
	(goal gl-raid-state RAID-IDLE)
	(goal map-type LAND)
	(goal gl-home-defense-state NO)
	(goal gl-attack-escalation-state ATTACK-ESCALATION-NORMAL)
	(up-compare-goal military-superiority c:>= EQUAL)
	(soldier-count >= 12)
	(players-building-count any-enemy >= 1)
=>
	(up-get-fact soldier-count 0 gl-raid-group-size)
	(up-modify-goal gl-raid-group-size c:/ 4)
	(up-modify-goal gl-raid-focus-player s:= sn-focus-player-number)
	(up-find-player enemy find-closest gl-raid-target-player)
	(up-modify-group-flag 0 c: opportunistic-raid-group)
	(up-reset-group c: opportunistic-raid-group)
	(up-full-reset-search)
	(up-modify-sn sn-focus-player-number g:= gl-raid-target-player)
	(up-set-target-point position-self-x)
	(up-find-remote c: town-center c: 8)
	(up-clean-search search-remote object-data-distance search-order-asc)
	(up-get-search-state local-total)
	(set-goal gl-raid-state RAID-FIND-TOWN)
)

(defrule
	(goal gl-raid-state RAID-FIND-TOWN)
	(up-compare-goal gl-raid-group-size c:< 4)
=>
	(set-goal gl-raid-group-size 4)
)

(defrule
	(goal gl-raid-state RAID-FIND-TOWN)
	(up-compare-goal gl-raid-group-size c:> 10)
=>
	(set-goal gl-raid-group-size 10)
)

(defrule
	(goal gl-raid-state RAID-FIND-TOWN)
	(up-set-target-object search-remote c: 0)
=>
	(up-get-point position-object point-x)
	(up-full-reset-search)
	(up-set-target-point point-x)
	(up-filter-distance c: 12 c: -1)
	(up-find-remote c: villager-class c: 20)
	(up-find-remote c: trade-cart-class c: 5)
	(up-find-remote c: lumber-camp c: 5)
	(up-find-remote c: mining-camp c: 5)
	(up-find-remote c: mill c: 5)
	(up-find-remote c: market c: 5)
	(up-find-remote c: barracks c: 5)
	(up-find-remote c: archery-range c: 5)
	(up-find-remote c: stable c: 5)
	(up-find-remote c: siege-workshop c: 5)
	(up-clean-search search-remote -1 search-order-asc)
	(up-set-target-point position-self-x)
	(up-clean-search search-remote object-data-distance search-order-asc)
	(up-get-search-state local-total)
	(set-goal gl-raid-state RAID-FIND-TARGET)
)

;If no enemy Town Center has been sighted, use the best vulnerable target known.
(defrule
	(goal gl-raid-state RAID-FIND-TOWN)
	(not (up-set-target-object search-remote c: 0))
=>
	(up-full-reset-search)
	(up-set-target-point position-self-x)
	(up-find-remote c: villager-class c: 20)
	(up-find-remote c: trade-cart-class c: 5)
	(up-find-remote c: lumber-camp c: 5)
	(up-find-remote c: mining-camp c: 5)
	(up-find-remote c: mill c: 5)
	(up-find-remote c: market c: 5)
	(up-find-remote c: barracks c: 5)
	(up-find-remote c: archery-range c: 5)
	(up-find-remote c: stable c: 5)
	(up-find-remote c: siege-workshop c: 5)
	(up-clean-search search-remote -1 search-order-asc)
	(up-clean-search search-remote object-data-distance search-order-asc)
	(up-get-search-state local-total)
	(set-goal gl-raid-state RAID-FIND-TARGET)
)

;Cancel native exploration before this first explicit land claim.
(defrule
	(goal gl-raid-state RAID-FIND-TARGET)
	(up-set-target-object search-remote c: 0)
	(goal gl-owner-explore-suspended NO)
=>
	(set-strategic-number sn-number-explore-groups 0)
	(set-strategic-number sn-total-number-explorers 0)
	(set-strategic-number sn-cap-civilian-explorers 0)
	(set-strategic-number sn-minimum-civilian-explorers 0)
	; RAW12 counter 21
	(up-modify-goal gl-command-counter-21 c:+ 1)
	(up-reset-scouts)
	(set-goal gl-owner-explore-suspended YES)
)

(defrule
	(goal gl-raid-state RAID-FIND-TARGET)
	(up-set-target-object search-remote c: 0)
=>
	(up-get-point position-object point2-x)
	(up-reset-search 1 1 0 0)
	(up-set-target-point point2-x)
	(up-find-local c: scout-cavalry-class c: 10)
	(up-find-local c: cavalry-archer-class c: 10)
	(up-find-local c: cavalry-class c: 10)
	(up-find-local c: infantry-class c: 10)
	(up-find-local c: archery-class c: 10)
	(up-remove-objects search-local object-data-group-flag >= 0)
	(up-remove-objects search-local object-data-idling != 1)
	(up-clean-search search-local -1 search-order-asc)
	(up-remove-objects search-local object-data-action == actionid-retreat)
	(up-clean-search search-local object-data-distance search-order-asc)
	(up-remove-objects search-local object-data-index g:>= gl-raid-group-size)
	;OWNERSHIP acquire: only FREE objects may be claimed.
	(up-remove-objects search-local object-data-player != my-player-number)
	(up-remove-objects search-local object-data-group-flag >= 0)
	(up-create-group 0 0 c: opportunistic-raid-group)
	(up-modify-group-flag 1 c: opportunistic-raid-group)
	;OWNERSHIP command: opportunistic-raid-group.
	(up-remove-objects search-local object-data-player != my-player-number)
	(up-remove-objects search-local object-data-group-flag != opportunistic-raid-group)
	(up-target-objects 1 action-default -1 stance-aggressive)
	(up-modify-sn sn-focus-player-number g:= gl-raid-focus-player)
	(set-goal gl-raid-state RAID-IDLE)
)

(defrule
	(goal gl-raid-state RAID-FIND-TARGET)
	(not (up-set-target-object search-remote c: 0))
=>
	(up-modify-sn sn-focus-player-number g:= gl-raid-focus-player)
	(set-goal gl-raid-state RAID-IDLE)
)

;Refresh the number of known hard defensive structures around the closest
;enemy.  This uses remembered objects, so the AI reacts only to defenses it has
;actually scouted rather than omnisciently countering hidden buildings.
(defrule
	(up-timer-status t-fortification-scan == timer-triggered)
	(goal gl-fortification-scan-state FORTIFICATION-SCAN-IDLE)
	(players-building-count any-enemy >= 1)
=>
	(up-modify-goal gl-fortification-scan-focus s:= sn-focus-player-number)
	(up-find-player enemy find-closest gl-fortification-scan-player)
	(up-modify-sn sn-focus-player-number g:= gl-fortification-scan-player)
	(up-full-reset-search)
	;position-focus is a point source, not a goal-pair identifier. Copy it into
	;the scratch point before setting the search origin.
	(up-get-point position-focus point-x)
	(up-set-target-point point-x)
	(up-filter-distance c: -1 c: 60)
	(up-find-remote c: tower-class c: 40)
	(up-find-remote c: sea-tower c: 10)
	(up-find-remote c: castle c: 10)
	(up-get-search-state local-total)
	(set-goal gl-fortification-scan-state FORTIFICATION-SCAN-CHECK)
)

(defrule
	(goal gl-fortification-scan-state FORTIFICATION-SCAN-CHECK)
=>
	(up-modify-goal gl-known-fortifications g:= remote-total)
	(up-modify-sn sn-focus-player-number g:= gl-fortification-scan-focus)
	(set-goal gl-fortification-scan-state FORTIFICATION-SCAN-IDLE)
)

(defrule
	(up-timer-status t-fortification-scan == timer-triggered)
	(players-building-count any-enemy <= 0)
=>
	(set-goal gl-known-fortifications 0)
)

;Any two assault engines are enough to accompany the rebuilt attack.  Armored
;Elephants fill the Ram role for civilizations that use that replacement line.
(defrule
	(or
		(unit-type-count-total battering-ram-line g:>= gl-one-percent)
		(or
			(unit-type-count-total armored-elephant-line g:>= gl-one-percent)
			(or
				(unit-type-count-total mangonel-line g:>= gl-one-percent)
				(unit-type-count-total catapult g:>= gl-one-percent)
			)
		)
	)
	(goal have-siege NO)
=>
	(set-goal have-siege YES)
)

(defrule
	(unit-type-count-total battering-ram-line g:< gl-one-percent)
	(unit-type-count-total armored-elephant-line g:< gl-one-percent)
	(unit-type-count-total mangonel-line g:< gl-one-percent)
	(unit-type-count-total catapult g:< gl-one-percent)
	(goal have-siege YES)
=>
	(set-goal have-siege NO)
)

;Three known Towers/Castles force a siege buildup immediately.  Otherwise two
;recent high-loss attack windows force a large combined regrouping attack.
(defrule
	(up-compare-goal gl-known-fortifications c:>= 3)
	(up-compare-goal gl-attack-escalation-state c:!= ATTACK-ESCALATION-SIEGE)
=>
	(set-goal current-action ACTION-WAIT)
	(set-goal gl-attack-escalation-state ATTACK-ESCALATION-SIEGE)
	(up-modify-goal land-attack-requirement g:= gl-fifteen-percent)
	(set-goal train-ram YES)
	(set-goal train-onager YES)
	(set-goal train-catapult YES)
	(set-strategic-number sn-minimum-attack-group-size 0)
	(set-strategic-number sn-maximum-attack-group-size 0)
	(set-strategic-number sn-number-attack-groups 0)
	(chat-local-to-self "Fortified enemy: wait for siege and a large attack")
)

(defrule
	(up-compare-goal gl-known-fortifications c:< 3)
	(up-compare-goal gl-failed-attack-streak c:>= 2)
	(up-compare-goal gl-attack-escalation-state c:!= ATTACK-ESCALATION-REGROUP)
=>
	(set-goal current-action ACTION-WAIT)
	(set-goal gl-attack-escalation-state ATTACK-ESCALATION-REGROUP)
	(up-modify-goal land-attack-requirement g:= gl-fifteen-percent)
	(set-strategic-number sn-minimum-attack-group-size 0)
	(set-strategic-number sn-maximum-attack-group-size 0)
	(set-strategic-number sn-number-attack-groups 0)
	(chat-local-to-self "Repeated attack losses: regroup for a large attack")
)

(defrule
	(up-compare-goal gl-known-fortifications c:< 3)
	(up-compare-goal gl-failed-attack-streak c:< 2)
	(up-compare-goal gl-attack-escalation-state c:!= ATTACK-ESCALATION-NORMAL)
=>
	(set-goal gl-attack-escalation-state ATTACK-ESCALATION-NORMAL)
	(set-goal current-action ACTION-WAIT)
	(set-strategic-number sn-minimum-attack-group-size 0)
	(set-strategic-number sn-maximum-attack-group-size 0)
	(set-strategic-number sn-number-attack-groups 0)
	(chat-local-to-self "Attack losses stabilized: resume normal pressure")
)

(defrule
	(goal gl-attack-escalation-state ATTACK-ESCALATION-NORMAL)
	(up-compare-goal current-phase c:<= 4)
	(up-compare-goal land-attack-requirement g:!= gl-two-percent)
=>
	(up-modify-goal land-attack-requirement g:= gl-two-percent)
)

(defrule
	(goal gl-attack-escalation-state ATTACK-ESCALATION-NORMAL)
	(up-compare-goal current-phase c:>= 5)
	(up-compare-goal land-attack-requirement g:!= gl-one-percent)
=>
	(up-modify-goal land-attack-requirement g:= gl-one-percent)
)

;retreat when forces are too dwindled
(defrule
	(up-timer-status t-retreat == timer-triggered)
	(current-age >= early-antiquity-age)
	(or
		(up-compare-goal gl-current-soldier-losses g:> gl-five-percent)
		(up-compare-goal gl-current-warboat-losses g:> gl-five-percent)
	)
=>
	;Source 5 includes the all-unit STOP immediately before the global recall.
	(up-modify-sn sn-minimum-attack-group-size c:= 0)
	(up-modify-sn sn-maximum-attack-group-size c:= 0)
	(up-modify-sn sn-number-attack-groups c:= 0)
	(up-modify-sn sn-minimum-attack-group-size g:= gl-pop-atkgrp-minsize)
	(up-modify-sn sn-maximum-attack-group-size g:= gl-pop-atkgrp-maxsize)
	(up-modify-sn sn-number-attack-groups g:= gl-pop-number-groups)
	(set-goal current-action ACTION-WAIT)
)

(defrule
	(up-timer-status t-retreat == timer-triggered)
	(goal current-action ACTION-RETREAT)
=>
	(set-goal current-action ACTION-WAIT)
)

(defrule
	(or
		(up-timer-status t-land-attack == timer-triggered)
		(up-timer-status t-naval-attack == timer-triggered)
	)
	(goal current-action ACTION-NONE)
=>
	(set-goal current-action ACTION-WAIT)
)

(defrule
	(or
		(up-timer-status t-land-attack == timer-triggered)
		(up-timer-status t-naval-attack == timer-triggered)
	)
	(or
		(goal current-action ACTION-RETREAT)
		(goal current-action ACTION-ATTACK)
	)
=>
	(set-goal current-action ACTION-WAIT)
)

(defrule
	(goal current-phase 1)
=>
	(set-goal military-spread-time 1)
	(set-goal military-spread-interval 100)
	(set-goal preferred-target-player -1)
	(set-goal allow-wall-targeting 1)
	(set-goal smart-wall-targeting 1)
	(set-goal land-attack-delay 300)
	(set-goal land-attack-interval 300)
	(up-modify-goal land-attack-requirement g:= gl-two-percent)
	(set-goal naval-attack-delay 300)
	(set-goal naval-attack-interval 300)
	(up-modify-goal naval-attack-requirement g:= gl-two-percent)
	
	(disable-self)
)

(defrule
	(goal current-phase 2)
=>
	(set-goal military-spread-time 1)
	(set-goal military-spread-interval 100)
	(set-goal preferred-target-player -1)
	(set-goal allow-wall-targeting 1)
	(set-goal smart-wall-targeting 1)
	(set-goal land-attack-delay 300)
	(set-goal land-attack-interval 240)
	(up-modify-goal land-attack-requirement g:= gl-two-percent)
	(set-goal naval-attack-delay 300)
	(set-goal naval-attack-interval 240)
	(up-modify-goal naval-attack-requirement g:= gl-two-percent)
	
	(disable-self)
)

(defrule
	(goal current-phase 3)
=>
	(set-goal military-spread-time 1)
	(set-goal military-spread-interval 100)
	(set-goal preferred-target-player -1)
	(set-goal allow-wall-targeting 1)
	(set-goal smart-wall-targeting 1)
	(set-goal land-attack-delay 300)
	(set-goal land-attack-interval 180)
	(up-modify-goal land-attack-requirement g:= gl-two-percent)
	(set-goal naval-attack-delay 300)
	(set-goal naval-attack-interval 180)
	(up-modify-goal naval-attack-requirement g:= gl-two-percent)
	
	(disable-self)
)

(defrule
	(goal current-phase 4)
=>
	(set-goal military-spread-time 1)
	(set-goal military-spread-interval 100)
	(set-goal preferred-target-player -1)
	(set-goal allow-wall-targeting 1)
	(set-goal smart-wall-targeting 1)
	(set-goal land-attack-delay 300)
	(set-goal land-attack-interval 180)
	(up-modify-goal land-attack-requirement g:= gl-two-percent)
	(set-goal naval-attack-delay 300)
	(set-goal naval-attack-interval 180)
	(up-modify-goal naval-attack-requirement g:= gl-two-percent)
	
	(disable-self)
)

