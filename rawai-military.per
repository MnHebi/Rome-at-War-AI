(defrule
	(goal gl-island-migration-state MIGRATION-ISSUE-DROPSITE)
	(or
		(goal gl-island-migration-anchor-class gold-mine-class)
		(goal gl-island-migration-anchor-class stone-mine-class)
	)
	(up-pending-objects c: mining-camp <= 0)
	(not (up-pending-placement c: mining-camp))
	(up-can-build 0 c: mining-camp)
=>
	(up-build place-point 0 c: mining-camp)
	(up-modify-goal gl-island-migration-placement-attempts c:+ 1)
	(up-chat-data-to-self "migration mining camp attempt: %d" g: gl-island-migration-placement-attempts)
	(up-set-timer c: t-island-migration c: 20)
	(set-goal gl-island-migration-state MIGRATION-WAIT-DROPSITE)
)

;When the building is affordable but the selected point is rejected, advance
;to the next offset without waiting for the mission watchdog.
(defrule
	(goal gl-island-migration-state MIGRATION-ISSUE-DROPSITE)
	(or
		(goal gl-island-migration-anchor-class gold-mine-class)
		(goal gl-island-migration-anchor-class stone-mine-class)
	)
	(up-compare-goal gl-island-migration-placement-attempts c:< 3)
	(can-afford-building mining-camp)
	(not (up-can-build 0 c: mining-camp))
=>
	(up-chat-data-to-self "migration rejected mining point: %d" g: gl-island-migration-placement-attempts)
	(up-modify-goal gl-island-migration-placement-attempts c:+ 1)
	(up-set-timer c: t-island-migration c: 1)
	(set-goal gl-island-migration-state MIGRATION-VALIDATE-DROPSITE-ANCHOR)
)

(defrule
	(goal gl-island-migration-state MIGRATION-ISSUE-DROPSITE)
	(or
		(goal gl-island-migration-anchor-class gold-mine-class)
		(goal gl-island-migration-anchor-class stone-mine-class)
	)
	(up-compare-goal gl-island-migration-placement-attempts c:>= 3)
	(can-afford-building mining-camp)
	(not (up-can-build 0 c: mining-camp))
=>
	(up-chat-data-to-self "migration rejected mining point: %d" g: gl-island-migration-placement-attempts)
	(set-goal gl-island-migration-state MIGRATION-DROPSITE-FAILED)
)

(defrule
	(goal gl-island-migration-state MIGRATION-ISSUE-DROPSITE)
