	(goal gl-relic-ferry-state RELIC-FERRY-TASK-HOME)
=>
	(set-strategic-number sn-focus-player-number my-player-number)
	(up-full-reset-search)
	(up-add-object-by-id search-local g: gl-relic-ferry-unit-id)
	(up-find-remote c: monastery c: 5)
	(up-clean-search search-remote object-data-distance search-order-asc)
	(up-target-objects 0 action-default -1 stance-no-attack)
	(up-modify-sn sn-focus-player-number g:= gl-relic-ferry-focus)
	(up-set-timer c: t-relic-ferry c: 60)
	(set-goal gl-relic-ferry-state RELIC-FERRY-IDLE)
)

(defrule
	(up-timer-status t-relic-ferry == timer-triggered)
	(not (goal gl-relic-ferry-state RELIC-FERRY-IDLE))
=>
	(set-strategic-number sn-focus-player-number my-player-number)
	(up-full-reset-search)
	(up-add-object-by-id search-local g: gl-relic-ferry-transport-id)
	(up-target-point position-self-x action-unload -1 stance-no-attack)
	(up-modify-sn sn-focus-player-number g:= gl-relic-ferry-focus)
	(set-goal gl-relic-ferry-state RELIC-FERRY-IDLE)
)

;If an enemy reaches the town while an outbound attack is still assembling near
;home, cancel that attack and hold reinforcements until the incursion is cleared.
(defrule
	(up-timer-status t-defense-leash == timer-triggered)
	(goal gl-home-defense-state NO)
	(up-enemy-units-in-town c:>= 3)
=>
	(up-full-reset-search)
	(up-set-target-point position-self-x)
	(up-filter-distance c: -1 c: 18)
	(up-filter-include -1 actionid-attack -1 -1)
	(up-find-local c: scout-cavalry-class c: 40)
	(up-find-local c: cavalry-archer-class c: 40)
	(up-find-local c: cavalry-class c: 40)
	(up-find-local c: infantry-class c: 40)
	(up-find-local c: archery-class c: 40)
	(up-find-local c: siege-weapon-class c: 40)
	(up-clean-search search-local -1 search-order-asc)
	(up-get-search-state local-total)
)

(defrule
	(up-timer-status t-defense-leash == timer-triggered)
	(goal gl-home-defense-state NO)
	(up-enemy-units-in-town c:>= 3)
	(up-compare-goal local-total c:>= 4)
=>
	(up-reset-attack-now)
	(up-retreat-now)
	(set-goal gl-home-defense-state YES)
	(set-goal current-action ACTION-RETREAT)
	(up-set-timer c: t-home-defense-hold c: 45)
)

(defrule
	(up-timer-status t-home-defense-hold == timer-triggered)
	(goal gl-home-defense-state YES)
	(up-enemy-units-in-town c:< 2)
=>
	(set-goal gl-home-defense-state NO)
	(set-goal current-action ACTION-WAIT)
)

(defrule
	(up-timer-status t-home-defense-hold == timer-triggered)
	(goal gl-home-defense-state YES)
	(up-enemy-units-in-town c:>= 2)
=>
	(up-set-timer c: t-home-defense-hold c: 30)
)

;Defend groups that chase past the town perimeter return under supporting fire.
(defrule
	(up-timer-status t-defense-leash == timer-triggered)
=>
	(up-full-reset-search)
	(up-set-target-point position-self-x)
	(up-filter-distance c: 18 c: -1)
	(up-filter-include -1 actionid-defend -1 -1)
	(up-find-local c: scout-cavalry-class c: 40)
	(up-find-local c: cavalry-archer-class c: 40)
	(up-find-local c: cavalry-class c: 40)
	(up-find-local c: infantry-class c: 40)
	(up-find-local c: archery-class c: 40)
	(up-find-local c: siege-weapon-class c: 40)
	(up-clean-search search-local -1 search-order-asc)
	(up-target-point position-self-x action-move -1 stance-defensive)
)

;Keep the main army available for decisive attacks while a small detachment raids
;known economy and production targets outside the nearest enemy Town Center.
(defrule
	(up-timer-status t-opportunistic-raid == timer-triggered)
	(goal gl-raid-state RAID-IDLE)
	(goal gl-home-defense-state NO)
	(up-compare-goal military-superiority c:>= EQUAL)
	(soldier-count >= 12)
	(players-building-count any-enemy >= 1)
=>
	(up-get-fact soldier-count 0 gl-raid-group-size)
	(up-modify-goal gl-raid-group-size c:/ 4)
	(up-modify-goal gl-raid-focus-player s:= sn-focus-player-number)
	(up-find-player enemy find-closest gl-raid-target-player)
	(up-modify-group-flag 0 c: opportunistic-raid-group)
	(up-reset-group c: opportunistic-raid-group)
	(up-full-reset-search)
	(up-modify-sn sn-focus-player-number g:= gl-raid-target-player)
	(up-set-target-point position-self-x)
	(up-find-remote c: town-center c: 8)
	(up-clean-search search-remote object-data-distance search-order-asc)
	(up-get-search-state local-total)
	(set-goal gl-raid-state RAID-FIND-TOWN)
)

(defrule
	(goal gl-raid-state RAID-FIND-TOWN)
	(up-compare-goal gl-raid-group-size c:< 4)
=>
	(set-goal gl-raid-group-size 4)
)

(defrule
	(goal gl-raid-state RAID-FIND-TOWN)
	(up-compare-goal gl-raid-group-size c:> 10)
=>
	(set-goal gl-raid-group-size 10)
)

(defrule
	(goal gl-raid-state RAID-FIND-TOWN)
	(up-set-target-object search-remote c: 0)
=>
	(up-get-point position-object point-x)
	(up-full-reset-search)
	(up-set-target-point point-x)
	(up-filter-distance c: 12 c: -1)
	(up-find-remote c: villager-class c: 20)
	(up-find-remote c: trade-cart-class c: 5)
	(up-find-remote c: lumber-camp c: 5)
	(up-find-remote c: mining-camp c: 5)
	(up-find-remote c: mill c: 5)
	(up-find-remote c: market c: 5)
	(up-find-remote c: barracks c: 5)
	(up-find-remote c: archery-range c: 5)
	(up-find-remote c: stable c: 5)
	(up-find-remote c: siege-workshop c: 5)
	(up-clean-search search-remote -1 search-order-asc)
	(up-set-target-point position-self-x)
	(up-clean-search search-remote object-data-distance search-order-asc)
	(up-get-search-state local-total)
	(set-goal gl-raid-state RAID-FIND-TARGET)
)

;If no enemy Town Center has been sighted, use the best vulnerable target known.
(defrule
	(goal gl-raid-state RAID-FIND-TOWN)
	(not (up-set-target-object search-remote c: 0))
=>
	(up-full-reset-search)
	(up-set-target-point position-self-x)
	(up-find-remote c: villager-class c: 20)
	(up-find-remote c: trade-cart-class c: 5)
	(up-find-remote c: lumber-camp c: 5)
	(up-find-remote c: mining-camp c: 5)
	(up-find-remote c: mill c: 5)
	(up-find-remote c: market c: 5)
	(up-find-remote c: barracks c: 5)
	(up-find-remote c: archery-range c: 5)
	(up-find-remote c: stable c: 5)
	(up-find-remote c: siege-workshop c: 5)
	(up-clean-search search-remote -1 search-order-asc)
	(up-clean-search search-remote object-data-distance search-order-asc)
	(up-get-search-state local-total)
	(set-goal gl-raid-state RAID-FIND-TARGET)
)

(defrule
	(goal gl-raid-state RAID-FIND-TARGET)
	(up-set-target-object search-remote c: 0)
=>
	(up-get-point position-object point2-x)
	(up-reset-search 1 1 0 0)
	(up-set-target-point point2-x)
	(up-find-local c: scout-cavalry-class c: 10)
	(up-find-local c: cavalry-archer-class c: 10)
	(up-find-local c: cavalry-class c: 10)
	(up-find-local c: infantry-class c: 10)
	(up-find-local c: archery-class c: 10)
	(up-clean-search search-local -1 search-order-asc)
	(up-remove-objects search-local object-data-action == actionid-retreat)
	(up-clean-search search-local object-data-distance search-order-asc)
	(up-remove-objects search-local object-data-index g:>= gl-raid-group-size)
	(up-create-group 0 0 c: opportunistic-raid-group)
	(up-modify-group-flag 1 c: opportunistic-raid-group)
	(up-target-objects 1 action-default -1 stance-aggressive)
	(up-modify-sn sn-focus-player-number g:= gl-raid-focus-player)
	(set-goal gl-raid-state RAID-IDLE)
)

(defrule
	(goal gl-raid-state RAID-FIND-TARGET)
	(not (up-set-target-object search-remote c: 0))
=>
	(up-modify-sn sn-focus-player-number g:= gl-raid-focus-player)
	(set-goal gl-raid-state RAID-IDLE)
)

;retreat when forces are too dwindled
(defrule
	(up-timer-status t-retreat == timer-triggered)
	(current-age >= early-antiquity-age)
	(or
		(up-compare-goal gl-current-soldier-losses g:> gl-five-percent)
		(up-compare-goal gl-current-warboat-losses g:> gl-five-percent)
	)
=>
	(up-reset-attack-now)
	(up-reset-unit c: -1)
	(up-modify-sn sn-minimum-attack-group-size c:= 0)
	(up-modify-sn sn-maximum-attack-group-size c:= 0)
	(up-modify-sn sn-number-attack-groups c:= 0)
	(up-retreat-now)
	(up-modify-sn sn-minimum-attack-group-size g:= gl-pop-atkgrp-minsize)
	(up-modify-sn sn-maximum-attack-group-size g:= gl-pop-atkgrp-maxsize)
	(up-modify-sn sn-number-attack-groups g:= gl-pop-number-groups)
	(set-goal current-action ACTION-RETREAT)
)

(defrule
	(up-timer-status t-retreat == timer-triggered)
	(goal current-action ACTION-RETREAT)
=>
	(set-goal current-action ACTION-WAIT)
)

(defrule
	(or
		(up-timer-status t-land-attack == timer-triggered)
		(up-timer-status t-naval-attack == timer-triggered)
	)
	(goal current-action ACTION-NONE)
=>
	(set-goal current-action ACTION-WAIT)
)

(defrule
	(or
		(up-timer-status t-land-attack == timer-triggered)
		(up-timer-status t-naval-attack == timer-triggered)
	)
	(or
		(goal current-action ACTION-RETREAT)
		(goal current-action ACTION-ATTACK)
	)
=>
	(set-goal current-action ACTION-WAIT)
)

(defrule
	(goal current-phase 1)
=>
	(set-goal military-spread-time 1)
	(set-goal military-spread-interval 100)
	(set-goal preferred-target-player -1)
	(set-goal allow-wall-targeting 1)
	(set-goal smart-wall-targeting 1)
	(set-goal land-attack-delay 300)
	(set-goal land-attack-interval 300)
	(set-goal land-attack-requirement gl-two-percent)
	(set-goal naval-attack-delay 300)
	(set-goal naval-attack-interval 300)
	(set-goal naval-attack-requirement gl-two-percent)
	
	(disable-self)
)

(defrule
	(goal current-phase 2)
=>
	(set-goal military-spread-time 1)
	(set-goal military-spread-interval 100)
	(set-goal preferred-target-player -1)
	(set-goal allow-wall-targeting 1)
	(set-goal smart-wall-targeting 1)
	(set-goal land-attack-delay 300)
	(set-goal land-attack-interval 240)
	(set-goal land-attack-requirement gl-two-percent)
	(set-goal naval-attack-delay 300)
	(set-goal naval-attack-interval 240)
	(set-goal naval-attack-requirement gl-two-percent)
	
	(disable-self)
)

