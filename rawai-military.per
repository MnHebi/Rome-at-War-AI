;The legacy jump chain synchronizes focus before the viability fallbacks run.
;Resynchronize it here so target-player facts and focus-relative searches use
;the same live building-owning enemy selected above.
(defrule
	(players-building-count target-player >= 1)
	(player-in-game target-player)
	(not (stance-toward target-player ally))
=>
	(up-modify-sn sn-focus-player-number s:= sn-target-player-number)
	(up-modify-goal gl-land-target-current-player s:= sn-target-player-number)
)

;Hybrid maps can contain both reachable land fronts and enemies across water.
;Classify the current live target from a known ready building instead of making
;every RIVERS attack pretend that transport reachability is irrelevant.
(defrule
	(up-compare-goal gl-game-time g:>= gl-land-target-scan-next)
	(goal gl-land-target-scan-state LAND-TARGET-SCAN-IDLE)
	(players-building-count target-player >= 1)
	(player-in-game target-player)
	(not (stance-toward target-player ally))
=>
	(up-modify-goal gl-land-target-scan-focus s:= sn-focus-player-number)
	(up-modify-goal gl-land-target-scan-player s:= sn-target-player-number)
	(up-modify-sn sn-focus-player-number s:= sn-target-player-number)
	(up-full-reset-search)
	(up-get-point position-focus point4-x)
	(up-set-target-point point4-x)
	(up-filter-distance c: -1 c: 255)
	(up-filter-status c: status-ready c: list-active)
	(up-find-remote c: building-class c: 40)
	(up-clean-search search-remote object-data-distance search-order-asc)
	(set-goal gl-land-target-scan-state LAND-TARGET-SCAN-CHECK)
)

(defrule
	(goal gl-land-target-scan-state LAND-TARGET-SCAN-CHECK)
	(up-set-target-object search-remote c: 0)
=>
	(up-get-object-data object-data-map-zone-id gl-land-target-zone)
	(up-modify-sn sn-focus-player-number g:= gl-land-target-scan-focus)
	(up-modify-goal gl-land-target-scan-next g:= gl-game-time)
	(up-modify-goal gl-land-target-scan-next c:+ 5)
	(set-goal gl-land-target-scan-state LAND-TARGET-SCAN-IDLE)
)

(defrule
	(goal gl-land-target-scan-state LAND-TARGET-SCAN-CHECK)
	(not (up-set-target-object search-remote c: 0))
=>
	(set-goal gl-land-target-zone -1)
	(set-goal gl-land-target-needs-transport YES)
	(up-modify-sn sn-focus-player-number g:= gl-land-target-scan-focus)
	(up-modify-goal gl-land-target-scan-next g:= gl-game-time)
	(up-modify-goal gl-land-target-scan-next c:+ 5)
	(set-goal gl-land-target-scan-state LAND-TARGET-SCAN-IDLE)
)

(defrule
	(up-compare-goal gl-land-target-zone g:== gl-home-zone)
	(up-compare-goal gl-land-target-scan-player g:== gl-land-target-current-player)
	(goal gl-land-target-needs-transport YES)
=>
	(set-goal gl-land-target-needs-transport NO)
	(up-chat-data-to-self "land target same zone: %d" g: gl-land-target-zone)
)

(defrule
	(up-compare-goal gl-land-target-zone g:!= gl-home-zone)
	(up-compare-goal gl-land-target-scan-player g:== gl-land-target-current-player)
	(goal gl-land-target-needs-transport NO)
=>
	(set-goal gl-land-target-needs-transport YES)
	(up-chat-data-to-self "land target transport zone: %d" g: gl-land-target-zone)
)

(defrule
	(up-compare-goal gl-land-target-scan-player g:!= gl-land-target-current-player)
	(goal gl-land-target-needs-transport NO)
=>
	;A new target invalidates the previous five-second zone result immediately.
	;No dispatch may reuse enemy A's land reachability for enemy B.
	(set-goal gl-land-target-needs-transport YES)
	(up-chat-data-to-self "land target scan stale player: %d" g: gl-land-target-current-player)
)

;Age advantage is a pressure signal, not permission to ignore defense, failed
;raids, siege preparation, or transport safety.  Because ages never regress,
;remaining ahead after two minutes in the current age is the required
;hysteresis: the lead necessarily persisted for that whole interval.
(defrule
	(goal gl-age-advantage-pressure NO)
	(current-age == early-antiquity-age)
	(current-age-time >= 120)
	(players-building-count target-player >= 1)
	(player-in-game target-player)
	(not (stance-toward target-player ally))
	(players-current-age target-player < early-antiquity-age)
=>
	(set-goal gl-age-advantage-pressure YES)
	(generate-random-number 60)
	(up-get-fact random-number 0 gl-attack-timer-random)
	(up-modify-goal gl-age-advantage-next g:= gl-game-time)
	(up-modify-goal gl-age-advantage-next g:+ gl-attack-timer-random)
	(up-modify-goal gl-age-advantage-next c:+ 90)
	(up-chat-data-to-self "age advantage pressure: %d" c: 1)
)

(defrule
	(goal gl-age-advantage-pressure NO)
	(current-age == middle-antiquity-age)
	(current-age-time >= 120)
	(players-building-count target-player >= 1)
	(player-in-game target-player)
	(not (stance-toward target-player ally))
	(players-current-age target-player < middle-antiquity-age)
=>
	(set-goal gl-age-advantage-pressure YES)
	(generate-random-number 60)
	(up-get-fact random-number 0 gl-attack-timer-random)
	(up-modify-goal gl-age-advantage-next g:= gl-game-time)
	(up-modify-goal gl-age-advantage-next g:+ gl-attack-timer-random)
	(up-modify-goal gl-age-advantage-next c:+ 90)
	(up-chat-data-to-self "age advantage pressure: %d" c: 2)
)

(defrule
	(goal gl-age-advantage-pressure NO)
	(current-age == imperial-age)
	(current-age-time >= 120)
	(players-building-count target-player >= 1)
	(player-in-game target-player)
	(not (stance-toward target-player ally))
	(players-current-age target-player < imperial-age)
=>
	(set-goal gl-age-advantage-pressure YES)
	(generate-random-number 60)
	(up-get-fact random-number 0 gl-attack-timer-random)
	(up-modify-goal gl-age-advantage-next g:= gl-game-time)
	(up-modify-goal gl-age-advantage-next g:+ gl-attack-timer-random)
	(up-modify-goal gl-age-advantage-next c:+ 90)
	(up-chat-data-to-self "age advantage pressure: %d" c: 3)
)

(defrule
	(goal gl-age-advantage-pressure YES)
	(current-age == early-antiquity-age)
	(players-current-age target-player >= early-antiquity-age)
=>
	(set-goal gl-age-advantage-pressure NO)
	(set-goal gl-age-advantage-next 0)
	(up-chat-data-to-self "age advantage cleared: %d" c: 1)
)

(defrule
	(goal gl-age-advantage-pressure YES)
	(current-age == middle-antiquity-age)
	(players-current-age target-player >= middle-antiquity-age)
=>
	(set-goal gl-age-advantage-pressure NO)
	(set-goal gl-age-advantage-next 0)
	(up-chat-data-to-self "age advantage cleared: %d" c: 2)
)

(defrule
	(goal gl-age-advantage-pressure YES)
	(current-age == imperial-age)
	(players-current-age target-player >= imperial-age)
=>
	(set-goal gl-age-advantage-pressure NO)
	(set-goal gl-age-advantage-next 0)
	(up-chat-data-to-self "age advantage cleared: %d" c: 3)
)

;A stale preferred target must not keep an age-pressure latch alive. Target
;selection above can reacquire a live enemy before the next pressure window.
(defrule
	(goal gl-age-advantage-pressure YES)
	(or
		(not (player-in-game target-player))
		(or
			(stance-toward target-player ally)
			(players-building-count target-player <= 0)
		)
	)
=>
	(set-goal gl-age-advantage-pressure NO)
	(set-goal gl-age-advantage-next 0)
	(up-chat-data-to-self "age advantage invalid target: %d" c: 1)
)

;This extra cadence works on hybrid maps where the LAND-only periodic pressure
;and opportunistic-raid rules cannot fire.  Sixty percent is deliberately
;bounded below a superior normal attack, and every normal safety gate remains.
(load "rawai-native-attack-ownership")

(defrule
	(up-compare-goal gl-game-time g:>= gl-age-advantage-next)
	(goal gl-age-advantage-pressure YES)
	(goal gl-home-defense-state NO)
	(or
		(goal gl-island-migration-state MIGRATION-IDLE)
		(goal gl-island-migration-state MIGRATION-QUARANTINED)
	)
	(goal gl-transport-route-state TRANSPORT-ROUTE-IDLE)
	(goal gl-land-transport-ready YES)
	(up-compare-goal gl-land-target-scan-player g:== gl-land-target-current-player)
	(goal gl-attack-escalation-state ATTACK-ESCALATION-NORMAL)
	(up-compare-goal military-superiority c:>= TOLERABLE)
	(soldier-count g:>= gl-ten-percent)
	(players-building-count target-player >= 1)
	(player-in-game target-player)
	(not (stance-toward target-player ally))
	(nor
		(goal current-action ACTION-ATTACK)
		(goal current-action ACTION-RETREAT)
	)
	(goal gl-attack-dispatch-owner ATTACK-DISPATCH-NONE)
=>
	(set-goal current-action ACTION-ATTACK)
	(set-goal gl-attack-dispatch-owner ATTACK-DISPATCH-AGE)
	(up-modify-sn sn-percent-attack-soldiers c:= 60)
	(attack-now)
	(up-chat-data-to-self "age advantage land dispatch: %d" c: 60)
	(set-strategic-number sn-percent-attack-soldiers 0)
	(set-goal gl-attack-dispatch-owner ATTACK-DISPATCH-COMPLETE)
	(generate-random-number 60)
	(up-get-fact random-number 0 gl-attack-timer-random)
	(up-modify-goal gl-age-advantage-next g:= gl-game-time)
	(up-modify-goal gl-age-advantage-next g:+ gl-attack-timer-random)
	(up-modify-goal gl-age-advantage-next c:+ 90)
)

;Age-up attacks are requested by the one-shot rules near the end of this file,
;then executed through the same global dispatch owner on the following sweep.
(defrule
	(goal gl-age-up-attack-pending YES)
	(goal gl-age-advantage-pressure NO)
	(goal gl-home-defense-state NO)
	(or
		(goal gl-island-migration-state MIGRATION-IDLE)
		(goal gl-island-migration-state MIGRATION-QUARANTINED)
	)
	(goal gl-transport-route-state TRANSPORT-ROUTE-IDLE)
	(goal gl-land-transport-ready YES)
	(up-compare-goal gl-land-target-scan-player g:== gl-land-target-current-player)
	(goal gl-attack-escalation-state ATTACK-ESCALATION-NORMAL)
	(up-compare-goal military-superiority c:>= TOLERABLE)
	(soldier-count g:>= gl-ten-percent)
	(players-building-count target-player >= 1)
	(player-in-game target-player)
	(not (stance-toward target-player ally))
	(nor
		(goal current-action ACTION-ATTACK)
		(goal current-action ACTION-RETREAT)
	)
	(goal gl-attack-dispatch-owner ATTACK-DISPATCH-NONE)
=>
	(set-goal current-action ACTION-ATTACK)
	(set-goal gl-attack-dispatch-owner ATTACK-DISPATCH-AGE)
	(up-modify-sn sn-percent-attack-soldiers c:= 60)
	(attack-now)
	(up-chat-data-to-self "age-up land dispatch: %d" c: 60)
	(set-strategic-number sn-percent-attack-soldiers 0)
	(set-goal gl-age-up-attack-pending NO)
	(set-goal gl-attack-dispatch-owner ATTACK-DISPATCH-COMPLETE)
)

;rule 10
(defrule
(or	
	(goal allow-wall-targeting 0)
	(goal allow-wall-targeting 1)
)
=>
	(up-modify-sn sn-wall-targeting-mode g:= allow-wall-targeting)
)

(defrule
	(up-timer-status t-land-attack == timer-triggered)
	(up-timer-status t-naval-attack == timer-triggered)
	(up-compare-goal gl-naval-role c:<= NAVAL-ROLE-COMPETITIVE)
	(up-compare-goal gl-naval-role c:>= NAVAL-ROLE-PRIMARY)
	(warboat-count g:>= naval-attack-requirement)
	(up-compare-goal gl-game-time g:>= naval-attack-delay)
	(nor
		(goal current-action ACTION-ATTACK)
		(goal current-action ACTION-RETREAT)
	)
=>
	(set-goal current-action ACTION-ATTACK)
	;attack-now is global, so a ready navy owns the rare simultaneous collision.
	;Preserve the unserved land channel on a short retry instead of letting the
	;timer loader silently restart it for a full normal interval.
	(up-set-timer c: t-land-attack c: 20)
	(set-goal gl-attack-dispatch-owner ATTACK-DISPATCH-NAVAL)
)

(defrule
	(up-timer-status t-land-attack == timer-triggered)
	(up-timer-status t-naval-attack == timer-triggered)
	(or
		(up-compare-goal gl-naval-role c:< NAVAL-ROLE-PRIMARY)
		(or
			(up-compare-goal gl-naval-role c:> NAVAL-ROLE-COMPETITIVE)
			(or
				(warboat-count g:< naval-attack-requirement)
				(up-compare-goal gl-game-time g:< naval-attack-delay)
			)
		)
	)
	(nor
		(goal current-action ACTION-ATTACK)
		(goal current-action ACTION-RETREAT)
	)
=>
	(set-goal current-action ACTION-ATTACK)
	;A support/incomplete navy cannot consume the land timer and enter a stable
	;20-second naval retry loop.
	(set-goal gl-attack-dispatch-owner ATTACK-DISPATCH-LAND)
)

(defrule
	(up-timer-status t-land-attack == timer-triggered)
	(up-timer-status t-naval-attack != timer-triggered)
	(nor
		(goal current-action ACTION-ATTACK)
		(goal current-action ACTION-RETREAT)
	)
=>
	(set-goal current-action ACTION-ATTACK)
	(set-goal gl-attack-dispatch-owner ATTACK-DISPATCH-LAND)
)

(defrule
	(up-timer-status t-naval-attack == timer-triggered)
	(up-timer-status t-land-attack != timer-triggered)
	(up-compare-goal gl-naval-role c:<= NAVAL-ROLE-COMPETITIVE)
	(up-compare-goal gl-naval-role c:>= NAVAL-ROLE-PRIMARY)
	(nor
		(goal current-action ACTION-ATTACK)
		(goal current-action ACTION-RETREAT)
	)
=>
	(set-goal current-action ACTION-ATTACK)
	(set-goal gl-attack-dispatch-owner ATTACK-DISPATCH-NAVAL)
)

;rule 11
(defrule
	(up-compare-goal current-action c:== ACTION-ATTACK)
	(up-timer-status t-land-attack == timer-triggered)
	(goal gl-attack-dispatch-owner ATTACK-DISPATCH-LAND)
	(goal gl-home-defense-state NO)
	(or
		(goal gl-island-migration-state MIGRATION-IDLE)
		(goal gl-island-migration-state MIGRATION-QUARANTINED)
	)
	(goal gl-transport-route-state TRANSPORT-ROUTE-IDLE)
	(goal gl-land-transport-ready YES)
	(up-compare-goal gl-land-target-scan-player g:== gl-land-target-current-player)
	(goal gl-attack-escalation-state ATTACK-ESCALATION-NORMAL)
	(and
		(up-compare-goal attack-type-land c:== PERCENTAGE)
		(and
			(up-compare-goal gl-game-time g:>= land-attack-delay)
			(soldier-count g:>= land-attack-requirement)
		)
	)
=>
	(chat-local-to-self "land attack")
	(up-modify-sn sn-percent-attack-soldiers g:= land-attack-percentage)
	(attack-now)
	(up-chat-data-to-self "land dispatch: %d" g: land-attack-percentage)
	(set-strategic-number sn-percent-attack-soldiers 0)
	(set-goal gl-attack-dispatch-owner ATTACK-DISPATCH-COMPLETE)
)

;rule 12
(defrule
	(up-compare-goal current-action c:== ACTION-ATTACK)
	(goal gl-attack-dispatch-owner ATTACK-DISPATCH-NAVAL)
	(goal gl-home-defense-state NO)
	(or
		(goal gl-island-migration-state MIGRATION-IDLE)
		(goal gl-island-migration-state MIGRATION-QUARANTINED)
	)
	(goal gl-transport-route-state TRANSPORT-ROUTE-IDLE)
	(up-compare-goal gl-naval-role c:<= NAVAL-ROLE-COMPETITIVE)
	(up-compare-goal gl-naval-role c:>= NAVAL-ROLE-PRIMARY)
	(and
		(up-compare-goal attack-type-sea c:== PERCENTAGE)
		(and
			(up-compare-goal gl-game-time g:>= naval-attack-delay)
			(and
				(warboat-count g:>= naval-attack-requirement)
				(up-timer-status t-naval-attack == timer-triggered)
			)
		)
	)
=>
	(chat-local-to-self "naval attack")
	;Wake the vessel-priority controller. attack-now is global and was sending
	;ordinary ships onto Town Centers and towers regardless of local opportunity.
	(up-modify-goal gl-naval-opportunity-next g:= gl-game-time)
	(up-chat-data-to-self "naval opportunity wake: %d" g: naval-attack-percentage)
	(set-goal gl-attack-dispatch-owner ATTACK-DISPATCH-NAVAL-WAKE)
)

(defrule
	(up-compare-goal current-action c:== ACTION-ATTACK)
	(up-timer-status t-land-attack == timer-triggered)
	(goal gl-attack-dispatch-owner ATTACK-DISPATCH-LAND)
	(goal gl-home-defense-state NO)
	(or
		(goal gl-island-migration-state MIGRATION-IDLE)
		(goal gl-island-migration-state MIGRATION-QUARANTINED)
	)
	(goal gl-transport-route-state TRANSPORT-ROUTE-IDLE)
	(goal gl-land-transport-ready YES)
	(up-compare-goal gl-land-target-scan-player g:== gl-land-target-current-player)
	(goal gl-attack-escalation-state ATTACK-ESCALATION-NORMAL)
	(and
		(up-compare-goal attack-type-land c:== TOWN-SIZE)
		(and
			(up-compare-goal gl-game-time g:>= land-attack-delay)
			(soldier-count g:>= land-attack-requirement)
		)
	)
=>
	(chat-local-to-self "land attack")
	(up-modify-sn sn-maximum-town-size c:= 250)
	(attack-now)
	(up-chat-data-to-self "land dispatch town-size: %d" c: 250)
	(up-modify-sn sn-maximum-town-size g:= outer-townsize)
	(set-goal gl-attack-dispatch-owner ATTACK-DISPATCH-COMPLETE)
)

;After repeated failures, wait until roughly fifteen percent of the population
;is military and send most of it together instead of issuing more small raids.
(defrule
	(up-compare-goal current-action c:== ACTION-ATTACK)
	(up-timer-status t-land-attack == timer-triggered)
	(goal gl-attack-dispatch-owner ATTACK-DISPATCH-LAND)
	(goal gl-home-defense-state NO)
	(or
		(goal gl-island-migration-state MIGRATION-IDLE)
		(goal gl-island-migration-state MIGRATION-QUARANTINED)
	)
	(goal gl-transport-route-state TRANSPORT-ROUTE-IDLE)
	(goal gl-land-transport-ready YES)
	(up-compare-goal gl-land-target-scan-player g:== gl-land-target-current-player)
	(goal gl-attack-escalation-state ATTACK-ESCALATION-REGROUP)
	(up-compare-goal gl-game-time g:>= land-attack-delay)
	(soldier-count g:>= gl-fifteen-percent)
=>
	(chat-local-to-self "regrouped large land attack")
	(set-strategic-number sn-percent-attack-soldiers 80)
	(attack-now)
	(up-chat-data-to-self "land dispatch regroup: %d" c: 80)
	(set-strategic-number sn-percent-attack-soldiers 0)
	(set-goal gl-attack-dispatch-owner ATTACK-DISPATCH-COMPLETE)
)

;A fortified target adds the further requirement that the assault force has a
;real siege component before the accumulated army is released.
(defrule
	(up-compare-goal current-action c:== ACTION-ATTACK)
	(up-timer-status t-land-attack == timer-triggered)
	(goal gl-attack-dispatch-owner ATTACK-DISPATCH-LAND)
	(goal gl-home-defense-state NO)
	(or
		(goal gl-island-migration-state MIGRATION-IDLE)
		(goal gl-island-migration-state MIGRATION-QUARANTINED)
	)
	(goal gl-transport-route-state TRANSPORT-ROUTE-IDLE)
	(goal gl-land-transport-ready YES)
	(up-compare-goal gl-land-target-scan-player g:== gl-land-target-current-player)
	(goal gl-attack-escalation-state ATTACK-ESCALATION-SIEGE)
	(goal have-siege YES)
	(up-compare-goal gl-game-time g:>= land-attack-delay)
	(soldier-count g:>= gl-fifteen-percent)
=>
	(chat-local-to-self "siege-supported large land attack")
	(set-strategic-number sn-percent-attack-soldiers 80)
	(attack-now)
	(up-chat-data-to-self "land dispatch siege: %d" c: 80)
	(set-strategic-number sn-percent-attack-soldiers 0)
	(set-goal gl-attack-dispatch-owner ATTACK-DISPATCH-COMPLETE)
)

(defrule
	(up-compare-goal current-action c:== ACTION-ATTACK)
	(goal gl-attack-dispatch-owner ATTACK-DISPATCH-NAVAL)
	(goal gl-home-defense-state NO)
	(or
		(goal gl-island-migration-state MIGRATION-IDLE)
		(goal gl-island-migration-state MIGRATION-QUARANTINED)
	)
	(goal gl-transport-route-state TRANSPORT-ROUTE-IDLE)
	(up-compare-goal gl-naval-role c:<= NAVAL-ROLE-COMPETITIVE)
	(up-compare-goal gl-naval-role c:>= NAVAL-ROLE-PRIMARY)
	(and
		(up-compare-goal attack-type-sea c:== TOWN-SIZE)
		(and
			(up-compare-goal gl-game-time g:>= naval-attack-delay)
			(and
				(warboat-count g:>= naval-attack-requirement)
				(up-timer-status t-naval-attack == timer-triggered)
			)
		)
	)
=>
	(chat-local-to-self "naval attack")
	(up-modify-goal gl-naval-opportunity-next g:= gl-game-time)
	(up-chat-data-to-self "naval opportunity wake: %d" g: naval-attack-percentage)
	(set-goal gl-attack-dispatch-owner ATTACK-DISPATCH-NAVAL-WAKE)
)

;A timer dispatch that missed a transient force, route, or defense gate retries
;soon.  Clearing an expired timer without restarting it lets rawai-timers load
;later in the same sweep and postpone the next attempt for a full interval.
(defrule
	(goal current-action ACTION-ATTACK)
	(goal gl-attack-dispatch-owner ATTACK-DISPATCH-LAND)
=>
	(up-set-timer c: t-land-attack c: 20)
	(set-goal gl-attack-dispatch-owner ATTACK-DISPATCH-NONE)
	(set-goal current-action ACTION-WAIT)
)

(defrule
	(goal current-action ACTION-ATTACK)
	(goal gl-attack-dispatch-owner ATTACK-DISPATCH-NAVAL)
=>
	(up-set-timer c: t-naval-attack c: 20)
	(set-goal gl-attack-dispatch-owner ATTACK-DISPATCH-NONE)
	(set-goal current-action ACTION-WAIT)
)

;periodic attacks
(defrule
	(game-time > 300)
	(goal map-type LAND)
	(goal gl-home-defense-state NO)
	(goal gl-attack-escalation-state ATTACK-ESCALATION-NORMAL)
	(up-compare-goal military-superiority c:>= EQUAL)
	(soldier-count g:>= gl-ten-percent)
	(up-timer-status t-periodic-attack != timer-running)
	(nor
		(goal current-action ACTION-ATTACK)
		(goal current-action ACTION-RETREAT)
	)
	(goal gl-attack-dispatch-owner ATTACK-DISPATCH-NONE)
=>
	(set-goal current-action ACTION-ATTACK)
	(set-goal gl-attack-dispatch-owner ATTACK-DISPATCH-COMPLETE)
	(chat-local-to-self "periodic attack")
	(up-modify-sn sn-percent-attack-soldiers g:= land-attack-percentage)
	;The periodic land producer is also a global attack-now path. Explicitly
	;exclude boats so it cannot steal light fleets from opportunity ownership.
	(set-strategic-number sn-percent-attack-boats 0)
	(up-modify-sn sn-maximum-town-size c:= 250)
	(attack-now)
	(up-modify-sn sn-maximum-town-size g:= outer-townsize)
	(set-strategic-number sn-percent-attack-soldiers 0)
	(set-strategic-number sn-percent-attack-boats 0)
)
;loss counter

(defrule
	(up-timer-status t-check-losses == timer-triggered)
=>
	(up-modify-goal gl-previous-civilian-count g:= gl-past-civilian-count)
	(up-modify-goal gl-previous-soldier-count g:= gl-past-soldier-count)
	(up-modify-goal gl-previous-warboat-count g:= gl-past-warboat-count)
	(up-modify-goal gl-past-civilian-count c:= 0)
	(up-modify-goal gl-past-soldier-count c:= 0)
	(up-modify-goal gl-past-warboat-count c:= 0)
	(up-modify-goal gl-past-civilian-count g:= gl-current-civilian-count)
	(up-get-fact civilian-population 0 gl-current-civilian-count)
	(up-modify-goal gl-past-soldier-count g:= gl-current-soldier-count)
	(up-get-fact soldier-count 0 gl-current-soldier-count)
	(up-modify-goal gl-past-warboat-count g:= gl-current-warboat-count)
	(up-get-fact warboat-count 0 gl-current-warboat-count)
	(up-chat-data-to-self "current civilian count: %d." g: gl-current-civilian-count)
	(up-chat-data-to-self "past civilian count: %d." g: gl-past-civilian-count)
	(up-chat-data-to-self "current soldier count: %d." g: gl-current-soldier-count)
	(up-chat-data-to-self "past soldier count: %d." g: gl-past-soldier-count)
	(up-chat-data-to-self "current warboat count: %d." g: gl-current-warboat-count)
	(up-chat-data-to-self "past warboat count: %d." g: gl-past-warboat-count)
)

(defrule
	(up-timer-status t-check-losses == timer-triggered)
	(up-compare-goal gl-previous-civilian-count g:> gl-current-civilian-count)
=>
	(up-modify-goal gl-previous-civilian-losses g:= gl-current-civilian-losses)
	(up-modify-goal gl-civilian-loss-counter g:= gl-previous-civilian-count)
	(up-modify-goal gl-civilian-loss-counter g:- gl-current-civilian-count)
	(up-modify-goal gl-current-civilian-losses g:= gl-civilian-loss-counter)
	(up-modify-goal gl-total-civilian-losses g:+ gl-civilian-loss-counter)
	(up-chat-data-to-self "previous civilian losses: %d." g: gl-previous-civilian-losses)
	(up-chat-data-to-self "current civilian losses: %d." g: gl-current-civilian-losses)
	(up-chat-data-to-self "total civilian losses: %d." g: gl-total-civilian-losses)
)

(defrule
	(up-timer-status t-check-losses == timer-triggered)
	(up-compare-goal gl-previous-soldier-count g:> gl-current-soldier-count)
=>
	(up-modify-goal gl-previous-soldier-losses g:= gl-current-soldier-losses)
	(up-modify-goal gl-soldier-loss-counter g:= gl-previous-soldier-count)
	(up-modify-goal gl-soldier-loss-counter g:- gl-current-soldier-count)
	(up-modify-goal gl-current-soldier-losses g:= gl-soldier-loss-counter)
	(up-modify-goal gl-total-soldier-losses g:+ gl-soldier-loss-counter)
	(up-chat-data-to-self "previous soldier losses: %d." g: gl-previous-soldier-losses)
	(up-chat-data-to-self "current soldier losses: %d." g: gl-current-soldier-losses)
	(up-chat-data-to-self "total soldier losses: %d." g: gl-total-soldier-losses)
)

;Do not let an old loss value masquerade as a new failed attack when the army
;count was stable or grew during this sampling window.
(defrule
	(up-timer-status t-check-losses == timer-triggered)
	(up-compare-goal gl-previous-soldier-count g:<= gl-current-soldier-count)
=>
	(up-modify-goal gl-previous-soldier-losses g:= gl-current-soldier-losses)
	(up-modify-goal gl-current-soldier-losses c:= 0)
	(up-modify-goal gl-soldier-loss-counter c:= 0)
)

;Two non-defensive windows with a net loss of at least eight soldiers trigger
;regrouping. Concurrent production can mask losses, so this is deliberately a
;coarse army-loss signal; three quiet windows let normal pressure resume.
(defrule
	(up-timer-status t-check-losses == timer-triggered)
	(goal gl-home-defense-state NO)
	(up-compare-goal gl-current-soldier-losses c:>= 8)
=>
	(up-modify-goal gl-failed-attack-streak c:+ 1)
	(up-modify-goal gl-attack-recovery-streak c:= 0)
	(up-chat-data-to-self "costly attack windows: %d." g: gl-failed-attack-streak)
)

(defrule
	(up-timer-status t-check-losses == timer-triggered)
	(up-compare-goal gl-current-soldier-losses g:< gl-two-percent)
=>
	(up-modify-goal gl-attack-recovery-streak c:+ 1)
)

(defrule
	(up-compare-goal gl-attack-recovery-streak c:>= 3)
	(up-compare-goal gl-failed-attack-streak c:> 0)
=>
	(up-modify-goal gl-failed-attack-streak c:- 1)
	(up-modify-goal gl-attack-recovery-streak c:= 0)
)

(defrule
	(up-compare-goal gl-attack-recovery-streak c:>= 3)
	(up-compare-goal gl-failed-attack-streak c:<= 0)
=>
	(up-modify-goal gl-attack-recovery-streak c:= 0)
)

(defrule
	(up-timer-status t-check-losses == timer-triggered)
	(up-compare-goal gl-previous-warboat-count g:> gl-current-warboat-count)
=>
	(up-modify-goal gl-previous-warboat-losses g:= gl-current-warboat-losses)
	(up-modify-goal gl-warboat-loss-counter g:= gl-previous-warboat-count)
	(up-modify-goal gl-warboat-loss-counter g:- gl-current-warboat-count)
	(up-modify-goal gl-current-warboat-losses g:= gl-warboat-loss-counter)
	(up-modify-goal gl-total-warboat-losses g:+ gl-warboat-loss-counter)
	(up-chat-data-to-self "previous warboat losses: %d." g: gl-previous-warboat-losses)
	(up-chat-data-to-self "current warboat losses: %d." g: gl-current-warboat-losses)
	(up-chat-data-to-self "total warboat losses: %d." g: gl-total-warboat-losses)
)

;Clear the sampled naval loss when the fleet held steady or grew, matching the
;soldier-loss window and preventing an old loss from retriggering retreats.
(defrule
	(up-timer-status t-check-losses == timer-triggered)
	(up-compare-goal gl-previous-warboat-count g:<= gl-current-warboat-count)
=>
	(up-modify-goal gl-previous-warboat-losses g:= gl-current-warboat-losses)
	(up-modify-goal gl-current-warboat-losses c:= 0)
	(up-modify-goal gl-warboat-loss-counter c:= 0)
)

;toggle allowed military units based on civ specialties, and current phase

(defrule
	(game-time >= 60)
=>
	(set-goal train-scoutships YES)
	(chat-local-to-self "Allow Scout Ships for everyone from the beginning")
	
	(disable-self)
)

;aging up to early antiquity & middle antiquity allowed trains

(defrule
	(or
		(up-compare-goal current-phase == 2)
		(up-compare-goal current-phase == 4)
	)
	(and
		(goal civ-specialty1 SPE-INFANTRY)
		(goal has-horus NO)
	)
	(goal train-champion NO)
	(goal train-spearman NO)
	(goal train-skirmisher NO)
=>
	(set-goal train-champion YES)
	(set-goal train-spearman YES)
	(set-goal train-skirmisher YES)
	(chat-local-to-self "Infantry Civilization that does not have Horus Scout/Warrior, allow Champion, Spearman, and Skirmisher training before Middle Antiquity Age")
)

