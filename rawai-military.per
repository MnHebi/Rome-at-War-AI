;The superiority checks above still measure a support fleet for defensive
;decisions, but they must not promote it into an independent attack. This rule
;is deliberately after every percentage writer and before periodic attack-now.
(defrule
	(goal gl-naval-role NAVAL-ROLE-SUPPORT)
=>
	(set-goal naval-attack-percentage 0)
)

;reset

(defrule
	(goal milcheck-concluded CONCLUDED-NAVY)
=>
	(set-goal milcheck-concluded RESET)
)

