(defrule
	(goal gl-transport-route-state TRANSPORT-ROUTE-MANIFEST-FIND)
	(goal gl-exp-allowed YES)
	(up-set-target-object search-local c: 0)
=>
	(up-get-object-data object-data-id gl-exp-siege-keep)
)

(defrule
	(goal gl-transport-route-state TRANSPORT-ROUTE-MANIFEST-FIND)
	(goal gl-exp-allowed YES)
=>
	(up-modify-goal gl-exp-reserve g:= gl-exp-free)
	(up-modify-goal gl-exp-reserve c:/ 4)
	(up-modify-goal gl-exp-reserve c:max 12)
)

(defrule
	(goal gl-transport-route-state TRANSPORT-ROUTE-MANIFEST-FIND)
	(goal gl-exp-allowed YES)
	(up-compare-goal naval-superiority c:< EQUAL)
=>
	(up-modify-goal gl-exp-reserve g:= gl-exp-free)
	(up-modify-goal gl-exp-reserve c:/ 2)
	(up-modify-goal gl-exp-reserve c:max 20)
	(set-goal gl-exp-manifest-limit 5)
)

(defrule
	(goal gl-transport-route-state TRANSPORT-ROUTE-MANIFEST-FIND)
	(goal gl-exp-allowed YES)
=>
	(up-modify-goal gl-exp-free g:- gl-exp-reserve)
	(up-modify-goal gl-exp-free c:max 0)
	(up-modify-goal gl-exp-manifest-limit g:min gl-exp-free)
)
