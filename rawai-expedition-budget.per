	(goal gl-transport-route-state TRANSPORT-ROUTE-MANIFEST-FIND)
	(goal gl-exp-allowed YES)
=>
	(up-full-reset-search)
	(up-set-target-point gl-home-anchor-x)
	(up-find-local c: cavalry-archer-class c: 240)
