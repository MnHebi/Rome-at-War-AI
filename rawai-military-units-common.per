;Probe every concrete weapon form. A shared at-least-ten-second deadline serializes the
;baseline and role copies even if more than one stance is transiently exposed.
(defrule
	(current-age >= middle-antiquity-age)
	(goal train-champion YES)
	(up-compare-goal gl-legionary-family-count g:< gl-ten-percent)
	(up-compare-goal gl-game-time g:>= gl-legionary-request-next)
	(food-amount > 180)
	(up-can-train gl-unitescrow-state c: elite-legionary)
=>
	(up-train gl-unitescrow-state c: elite-legionary)
	(up-modify-goal gl-legionary-request-next g:= gl-game-time)
	(up-modify-goal gl-legionary-request-next c:+ 10)
	(up-chat-data-to-self "Roman Legionary request: %d" c: elite-legionary)
)

(defrule
	(current-age >= middle-antiquity-age)
	(goal train-champion YES)
	(up-compare-goal gl-legionary-family-count g:< gl-ten-percent)
	(up-compare-goal gl-game-time g:>= gl-legionary-request-next)
	(food-amount > 180)
	(up-can-train gl-unitescrow-state c: elite-legionary-melee)
=>
	(up-train gl-unitescrow-state c: elite-legionary-melee)
	(up-modify-goal gl-legionary-request-next g:= gl-game-time)
	(up-modify-goal gl-legionary-request-next c:+ 10)
	(up-chat-data-to-self "Roman Legionary request: %d" c: elite-legionary-melee)
)

(defrule
	(current-age >= middle-antiquity-age)
	(goal train-champion YES)
	(up-compare-goal gl-legionary-family-count g:< gl-ten-percent)
	(up-compare-goal gl-game-time g:>= gl-legionary-request-next)
	(food-amount > 180)
	(up-can-train gl-unitescrow-state c: legionary)
=>
	(up-train gl-unitescrow-state c: legionary)
	(up-modify-goal gl-legionary-request-next g:= gl-game-time)
	(up-modify-goal gl-legionary-request-next c:+ 10)
	(up-chat-data-to-self "Roman Legionary request: %d" c: legionary)
)

(defrule
	(current-age >= middle-antiquity-age)
	(goal train-champion YES)
	(up-compare-goal gl-legionary-family-count g:< gl-ten-percent)
	(up-compare-goal gl-game-time g:>= gl-legionary-request-next)
	(food-amount > 180)
	(up-can-train gl-unitescrow-state c: legionary-melee)
=>
