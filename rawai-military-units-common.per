#load-if-not-defined INCAN-CIV

;Counter observed ranged mass even when Skirmishers are outside this
;civilization's focus-sheet composition. The population cap keeps the response
;proportional instead of replacing the historical core army.
(defrule
	(current-age >= early-antiquity-age)
	(or
		(players-unit-type-count any-enemy archery-class >= 3)
		(players-unit-type-count any-enemy cavalry-archer-class >= 3)
	)
	(unit-type-count-total skirmisher-line g:< gl-five-percent)
	(food-amount > 150)
	(up-can-train gl-unitescrow-state c: skirmisher-line)
=>
	(set-goal train-skirmisher YES)
	(up-train gl-unitescrow-state c: skirmisher-line)
)

