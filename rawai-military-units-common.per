
;========================BARRACKS BEGIN========================

;Generic composition must not turn a planned later infantry line into an
;Iron-Age Militia opening. A selected drush owns that opening explicitly.
(defrule
	(current-age < early-antiquity-age)
	(goal rush-drush NO)
	(goal train-champion YES)
=>
	(set-goal train-champion NO)
)

;Emergency Roman response to enemy Champions inside the town. This exact unit
;request bypasses the normal Middle-Age legionary role mapping.
#load-if-defined BYZANTINE-CIV

(defrule
	(true)
=>
	(up-get-fact unit-type-count-total legionary-ranged-line gl-legionary-family-count)
	(up-get-fact unit-type-count-total legionary-melee-line temporary-goal)
	(up-modify-goal gl-legionary-family-count g:+ temporary-goal)
)
(defrule
	(goal gl-roman-champion-base-threat YES)
	(current-age >= middle-antiquity-age)
	(unit-type-count-total long-swordsman g:< gl-roman-champion-counter-target)
	(food-amount > 180)
	(up-can-train gl-unitescrow-state c: long-swordsman)
=>
	(up-train gl-unitescrow-state c: long-swordsman)
)
#end-if

;========================CHAMPION BEGIN========================

#load-if-not-defined BYZANTINE-CIV ; Roman Empire
#load-if-not-defined ITALIAN-CIV ; Roman Republic
#load-if-not-defined KHMER-CIV ; Pontus
#load-if-not-defined BURMESE-CIV ; Seleucids

(defrule
	(and
		(goal train-champion YES)
		(goal primary-unit CHAMPION)
	)
	(unit-type-count-total militiaman-line g:< gl-ten-percent)
	(food-amount > 180)
	(up-can-train gl-unitescrow-state c: militiaman-line)
=>
	(up-train gl-unitescrow-state c: militiaman-line)
)

(defrule
	(and
		(goal train-champion YES)
		(goal secondary-unit CHAMPION)
	)
	(unit-type-count-total militiaman-line g:< gl-five-percent)
	(food-amount > 180)
	(up-can-train gl-unitescrow-state c: militiaman-line)
=>
	(up-train gl-unitescrow-state c: militiaman-line)
)

(defrule
	(and
		(goal train-champion YES)
		(goal tertiary-unit CHAMPION)
	)
	(unit-type-count-total militiaman-line g:< gl-two-percent)
	(food-amount > 180)
	(up-can-train gl-unitescrow-state c: militiaman-line)
=>
	(up-train gl-unitescrow-state c: militiaman-line)
)

(defrule
	(and
		(goal train-champion YES)
		(goal quaternary-unit CHAMPION)
	)
	(unit-type-count-total militiaman-line g:< gl-one-percent)
	(food-amount > 180)
	(up-can-train gl-unitescrow-state c: militiaman-line)
=>
	(up-train gl-unitescrow-state c: militiaman-line)
)

(defrule
	(and
		(goal train-champion YES)
		(goal primary-support-unit CHAMPION)
	)
	(unit-type-count-total militiaman-line g:< gl-one-percent)
	(food-amount > 180)
	(up-can-train gl-unitescrow-state c: militiaman-line)
=>
	(up-train gl-unitescrow-state c: militiaman-line)
)

(defrule
	(and
		(goal train-champion YES)
		(goal secondary-support-unit CHAMPION)
	)
	(unit-type-count-total militiaman-line g:< gl-no-percent)
	(food-amount > 180)
	(up-can-train gl-unitescrow-state c: militiaman-line)
=>
	(up-train gl-unitescrow-state c: militiaman-line)
)

#end-if
#end-if
#end-if
#end-if

