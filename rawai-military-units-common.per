;A Naval No support civilization with both heavy families may contribute a
;small artillery detachment without mirroring its primary naval ally's fleet.
;Its ordinary escort roster stops at three percent; this separate five-percent
;ceiling reserves the remaining capacity for heavy hulls.
(defrule
	(up-compare-goal current-phase c:>= 4)
	(current-age < imperial-age)
	(goal gl-naval-role NAVAL-ROLE-SUPPORT)
	(goal gl-naval-specialist-support YES)
	(up-compare-goal gl-naval-fleet-count-total g:< gl-naval-specialist-fleet-cap)
	(up-compare-goal gl-heavy-reme-count c:< 1)
	(wood-amount > 300)
	(gold-amount > 200)
	(up-compare-goal gl-heavy-reme-train-id c:>= 0)
	(up-can-train gl-unitescrow-state g: gl-heavy-reme-train-id)
=>
	(up-train gl-unitescrow-state g: gl-heavy-reme-train-id)
	(up-modify-goal gl-heavy-reme-count c:+ 1)
	(up-modify-goal gl-naval-fleet-count-total c:+ 1)
)

;Octeres receives first claim on Imperial specialist capacity so two early
;Quadriremes cannot permanently crowd it out.
(defrule
	(current-age >= imperial-age)
	(goal gl-naval-role NAVAL-ROLE-SUPPORT)
	(goal gl-naval-specialist-support YES)
	(up-compare-goal gl-naval-fleet-count-total g:< gl-naval-specialist-fleet-cap)
	(unit-type-count-total octeres < 1)
	(wood-amount > 350)
	(gold-amount > 250)
	(up-can-train gl-unitescrow-state c: octeres)
=>
	(up-train gl-unitescrow-state c: octeres)
	(up-modify-goal gl-naval-fleet-count-total c:+ 1)
)

(defrule
	(current-age >= imperial-age)
	(goal gl-naval-role NAVAL-ROLE-SUPPORT)
	(goal gl-naval-specialist-support YES)
	(up-compare-goal gl-naval-fleet-count-total g:< gl-naval-specialist-fleet-cap)
	(up-compare-goal gl-heavy-reme-count c:< 2)
	(wood-amount > 300)
	(gold-amount > 200)
	(up-compare-goal gl-heavy-reme-train-id c:>= 0)
	(up-can-train gl-unitescrow-state g: gl-heavy-reme-train-id)
=>
	(up-train gl-unitescrow-state g: gl-heavy-reme-train-id)
	(up-modify-goal gl-heavy-reme-count c:+ 1)
	(up-modify-goal gl-naval-fleet-count-total c:+ 1)
)

;========================SHIPYARD END========================

#load-if-defined DIFFICULTY-MODERATE

;Palintonon

(defrule
	(current-age >= middle-antiquity-age)
	(up-object-type-count-total c: trebuchet-set g:< gl-no-percent)
	(food-amount > 180)
	(up-can-train gl-unitescrow-state c: palintonon-packed)
=>
	(up-train gl-unitescrow-state c: palintonon-packed)
)

#end-if
