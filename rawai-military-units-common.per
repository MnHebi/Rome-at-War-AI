			(goal map-type RIVERS)
			(or
				(goal map-type ISLANDS)
				(goal map-type TEAM-ISLANDS)
			)
		)
	)
	(up-compare-goal gl-naval-fleet-count-total g:< gl-naval-fleet-cap)
	(up-compare-goal gl-heavy-reme-count g:< gl-one-percent)
	(up-compare-goal gl-heavy-reme-train-id c:>= 0)
	(up-can-train gl-unitescrow-state g: gl-heavy-reme-train-id)
=>
	(up-train gl-unitescrow-state g: gl-heavy-reme-train-id)
	(up-modify-goal gl-heavy-reme-count c:+ 1)
	(up-modify-goal gl-naval-fleet-count-total c:+ 1)
)

