;========================Q-REME BEGIN========================

;Concrete heavy-reme family: queued base and upgraded hulls share one allowance.
(defrule
	(true)
=>
	(up-get-fact unit-type-count-total quadrireme gl-heavy-reme-count)
	(up-get-fact unit-type-count-total quinquereme gl-heavy-reme-upgraded-count)
	(up-modify-goal gl-heavy-reme-count g:+ gl-heavy-reme-upgraded-count)
	(set-goal gl-heavy-reme-train-id -1)
)
(defrule
	(unit-available quinquereme)
	(up-can-train gl-unitescrow-state c: quinquereme)
=>
	(set-goal gl-heavy-reme-train-id quinquereme)
)
(defrule
	(goal gl-heavy-reme-train-id -1)
	(unit-available quadrireme)
	(up-can-train gl-unitescrow-state c: quadrireme)
=>
	(set-goal gl-heavy-reme-train-id quadrireme)
)



(defrule
	(and
		(up-compare-goal current-phase >= 4)
		(goal ship-train Q-REME)
	)
	(or
