	(up-modify-goal gl-legionary-request-next g:= gl-game-time)
	(up-modify-goal gl-legionary-request-next c:+ 10)
	(up-chat-data-to-self "Roman Legionary request: %d" c: legionary-melee)
)

;Roman Imperial ranges switch completely from Improved Bowmen to the separate
;Crossbowman unit required by the focus sheet.
(defrule
	(up-compare-goal current-phase >= 7)
	(goal train-bowman YES)
=>
	(set-goal train-bowman NO)
)

(defrule
	(up-compare-goal current-phase >= 7)
	(goal train-crossbow NO)
	(unit-available crossbowman)
=>
	(set-goal train-crossbow YES)
)

(defrule
	(up-compare-goal current-phase >= 7)
	(goal train-crossbow YES)
	(unit-type-count-total crossbowman g:< gl-five-percent)
	(food-amount > 180)
	(up-can-train gl-unitescrow-state c: crossbowman)
=>
	(up-train gl-unitescrow-state c: crossbowman)
)

#end-if

