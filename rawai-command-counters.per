;Generated once-per-minute nonzero source invocation counters.

;No lifetime quota; never changes targets, searches, groups, or orders.

(defrule
	(true)
=>
	(up-get-fact game-time 0 gl-command-counter-clock)
)

(defrule
	(up-compare-goal gl-command-counter-clock g:>= gl-command-counter-next)
	(up-compare-goal gl-command-counter-1 c:> 0)
=>
	(up-chat-data-to-all str-command-counter-id c: 1)
	(up-chat-data-to-all str-command-counter-count g: gl-command-counter-1)
	(set-goal gl-command-counter-1 0)
)

