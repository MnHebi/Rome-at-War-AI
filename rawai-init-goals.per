;Adaptive attack state is isolated from the larger transport initializer so
;both startup rules stay comfortably below the engine expression limit.
(defrule
	(true)
=>
	(set-goal gl-failed-attack-streak 0)
	(set-goal gl-attack-recovery-streak 0)
	(set-goal gl-attack-escalation-state ATTACK-ESCALATION-NORMAL)
	(set-goal gl-known-fortifications 0)
	(set-goal gl-fortification-scan-state FORTIFICATION-SCAN-IDLE)
	(set-goal gl-fortification-scan-focus 0)
	(set-goal gl-fortification-scan-player 0)
	(set-goal have-siege NO)

	(disable-self)
)

;Route-corridor and close-combat response state are initialized separately to
;keep the transport startup blocks below the engine's 32-expression limit.
(defrule
	(true)
=>
	(set-goal gl-transport-route-landing-x 0)
	(set-goal gl-transport-route-landing-y 0)
	(set-goal gl-transport-route-waypoint-left-x 0)
	(set-goal gl-transport-route-waypoint-left-y 0)
	(set-goal gl-transport-route-waypoint-right-x 0)
	(set-goal gl-transport-route-waypoint-right-y 0)
	(set-goal gl-transport-route-waypoint-x 0)
	(set-goal gl-transport-route-waypoint-y 0)
	(set-goal gl-transport-route-corridor-left-threats 0)
	(set-goal gl-transport-route-corridor-right-threats 0)
	(set-goal gl-local-response-state LOCAL-RESPONSE-IDLE)
	(set-goal gl-local-response-focus 0)
	(set-goal gl-local-response-player 0)
	(set-goal gl-local-response-target-x 0)
	(set-goal gl-local-response-target-y 0)
	(disable-self)
)

