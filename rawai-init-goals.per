(defrule
	(true)
=>
	(set-goal gl-attack-timer-random 0)
	(set-goal gl-attack-timer-next 0)
	(set-goal gl-home-defense-state NO)
	(set-goal gl-transport-min-load 5)
	(set-goal gl-transport-route-state TRANSPORT-ROUTE-IDLE)
	(set-goal gl-transport-route-focus 0)
	(set-goal gl-transport-route-left-threats 0)
	(set-goal gl-transport-route-right-threats 0)
	(set-goal gl-transport-route-random 0)
	(set-goal gl-transport-route-id -1)
	(set-goal gl-island-migration-state MIGRATION-IDLE)
	(set-goal gl-island-migration-transport-id -1)
	(set-goal gl-island-migration-focus 0)
	(set-goal gl-transport-repair-state TRANSPORT-REPAIR-IDLE)
	(set-goal gl-transport-repair-id -1)
	(set-goal gl-transport-repair-hp 0)
	(set-goal gl-transport-repair-maxhp 1)
	(set-goal gl-transport-repair-percent 100)
	(set-goal gl-transport-repair-focus 0)
	(up-set-timer c: t-ship-train c: 12)
	(generate-random-number 121)
	(up-get-fact random-number 0 gl-age-attack-delay)
	(up-modify-goal gl-age-attack-delay c:+ 120)
	(generate-random-number 121)
	(up-get-fact random-number 0 gl-rush-attack-delay)
	(up-modify-goal gl-rush-attack-delay c:+ 300)

	(disable-self)
)

;Keep the larger transport state machines out of the rule above so startup
;remains below the engine's per-rule expression limit.
(defrule
	(true)
=>
	(set-goal gl-transport-capacity 5)
	(set-goal gl-transport-capacity-upgrade 0)
	(set-goal gl-transport-required 1)
	(set-goal gl-transport-route-target-x 0)
	(set-goal gl-transport-route-target-y 0)
	(set-goal gl-island-migration-target-x 0)
	(set-goal gl-island-migration-target-y 0)
	(set-goal gl-island-migration-anchor-id -1)
	(set-goal gl-island-migration-load-target 0)
	(set-goal gl-transport-recovery-state TRANSPORT-RECOVERY-IDLE)
	(set-goal gl-transport-recovery-unit-id -1)
	(set-goal gl-transport-recovery-transport-id -1)
	(set-goal gl-transport-recovery-load-target 0)
	(set-goal gl-roman-champion-base-threat NO)
	(set-goal gl-champion-threat-scan-state CHAMPION-THREAT-SCAN-IDLE)
	(set-goal gl-champion-threat-scan-focus 0)
	(set-goal gl-champion-threat-player 0)
	(set-goal gl-roman-champion-counter-target 0)
	(set-goal gl-relic-ferry-state RELIC-FERRY-IDLE)
	(set-goal gl-relic-ferry-transport-id -1)
	(set-goal gl-relic-ferry-unit-id -1)
	(set-goal gl-relic-ferry-target-id -1)
	(set-goal gl-relic-ferry-direction 0)
	(disable-self)
)
