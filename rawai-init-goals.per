
;T12 bounded diagnostic state; never used as behavior permissions.
(defrule
	(true)
=>
	(set-goal gl-t12-navy-next 0)
	(set-goal gl-t12-drop-stage 0)
	(set-goal gl-t12-help-kind 0)
	(set-goal gl-t12-help-asset -1)
	(set-goal gl-t12-help-hostile -1)
	(set-goal gl-t12-help-time -1)
	(disable-self)
)

;init age at Start
(defrule
	(true)
=>
	(up-modify-goal current-phase c:= START)
	(up-modify-goal previous-phase c:= PHASE-NONE)
	(up-modify-goal current-action c:= ACTION-NONE)
	
	(disable-self)
)

;init attack intervals
(defrule
	(true)
=>
	(up-modify-goal land-attack-interval c:= 500)
	(up-modify-goal naval-attack-interval c:= 500)
	
	(disable-self)
)

