;Generated by tools/generate_migration_shoreline.py.

;Mechanical bound: 24 coarse samples, four refinements, five coast sectors,

;and exactly two exact-hull path queries per path-tested sector.

(defrule
	(true)
=>
	(set-goal gl-msr-write 1)
	(set-goal gl-msr-memory1-until 0)
	(set-goal gl-msr-memory2-until 0)
	(set-goal gl-msr-memory3-until 0)
	(set-goal gl-msr-memory4-until 0)
	(disable-self)
)

(defrule
	(goal gl-island-migration-state MIGRATION-SHORE-INIT)
=>
	(set-strategic-number sn-focus-player-number my-player-number)
	(up-full-reset-search)
	(up-add-object-by-id search-local g: gl-island-migration-transport-id)
	(up-remove-objects search-local object-data-player != my-player-number)
	(up-remove-objects search-local object-data-group-flag != migration-transport-group)
	(set-goal gl-island-migration-state MIGRATION-SHORE-HULL)
)

(defrule
	(goal gl-island-migration-state MIGRATION-SHORE-HULL)
	(up-set-target-object search-local c: 0)
=>
	(up-get-point position-object gl-msr-hull-x)
	(up-bound-point gl-msr-scan-x gl-island-migration-target-x)
	(up-bound-point gl-msr-land-x gl-island-migration-target-x)
	(set-goal gl-msr-steps 0)
	(set-goal gl-msr-refines 0)
	(set-goal gl-island-migration-state MIGRATION-SHORE-COARSE)
)

(defrule
	(goal gl-island-migration-state MIGRATION-SHORE-HULL)
	(not (up-set-target-object search-local c: 0))
=>
	(up-modify-sn sn-focus-player-number g:= gl-island-migration-focus)
	(up-set-timer c: t-island-migration c: 60)
	(set-goal gl-island-migration-state MIGRATION-IDLE)
)

(defrule
	(goal gl-island-migration-state MIGRATION-SHORE-COARSE)
	(up-compare-goal gl-msr-steps c:>= 24)
=>
	(set-goal gl-island-migration-state MIGRATION-SHORE-EXHAUSTED)
)

(defrule
	(goal gl-island-migration-state MIGRATION-SHORE-COARSE)
	(up-compare-goal gl-msr-steps c:< 24)
=>
	(up-lerp-tiles gl-msr-scan-x gl-msr-hull-x c: 16)
	(up-bound-point gl-msr-scan-x gl-msr-scan-x)
	(set-goal gl-msr-zone -2)
	(up-get-point-zone gl-msr-scan-x gl-msr-zone)
	(up-modify-goal gl-msr-steps c:+ 1)
	(set-goal gl-island-migration-state MIGRATION-SHORE-COARSE-CHECK)
)

(defrule
	(goal gl-island-migration-state MIGRATION-SHORE-COARSE-CHECK)
	(up-compare-goal gl-msr-zone g:== gl-island-migration-zone)
=>
	(up-bound-point gl-msr-land-x gl-msr-scan-x)
	(set-goal gl-island-migration-state MIGRATION-SHORE-COARSE)
)

(defrule
	(goal gl-island-migration-state MIGRATION-SHORE-COARSE-CHECK)
	(up-compare-goal gl-msr-zone g:!= gl-island-migration-zone)
=>
	(up-bound-point gl-msr-water-x gl-msr-scan-x)
	(up-bound-point gl-msr-refine-x gl-msr-land-x)
	(set-goal gl-msr-refines 0)
	(set-goal gl-island-migration-state MIGRATION-SHORE-REFINE)
)

(defrule
	(goal gl-island-migration-state MIGRATION-SHORE-REFINE)
	(up-compare-goal gl-msr-refines c:>= 4)
=>
	(set-goal gl-msr-candidate 0)
	(set-goal gl-island-migration-state MIGRATION-SHORE-CANDIDATE)
)

(defrule
	(goal gl-island-migration-state MIGRATION-SHORE-REFINE)
	(up-compare-goal gl-msr-refines c:< 4)
=>
	(up-lerp-tiles gl-msr-refine-x gl-msr-water-x c: 4)
	(up-bound-point gl-msr-refine-x gl-msr-refine-x)
	(set-goal gl-msr-zone -2)
	(up-get-point-zone gl-msr-refine-x gl-msr-zone)
	(up-modify-goal gl-msr-refines c:+ 1)
	(set-goal gl-island-migration-state MIGRATION-SHORE-REFINE-CHECK)
)

(defrule
	(goal gl-island-migration-state MIGRATION-SHORE-REFINE-CHECK)
	(up-compare-goal gl-msr-zone g:== gl-island-migration-zone)
=>
	(up-bound-point gl-msr-land-x gl-msr-refine-x)
	(set-goal gl-island-migration-state MIGRATION-SHORE-REFINE)
)

(defrule
	(goal gl-island-migration-state MIGRATION-SHORE-REFINE-CHECK)
	(up-compare-goal gl-msr-zone g:!= gl-island-migration-zone)
=>
	(up-bound-point gl-msr-water-x gl-msr-refine-x)
	(set-goal gl-msr-candidate 0)
	(set-goal gl-island-migration-state MIGRATION-SHORE-CANDIDATE)
)

(defrule
	(goal gl-island-migration-state MIGRATION-SHORE-CANDIDATE)
	(up-compare-goal gl-msr-candidate c:>= 5)
=>
	(set-goal gl-island-migration-state MIGRATION-SHORE-EXHAUSTED)
)

(defrule
	(goal gl-island-migration-state MIGRATION-SHORE-CANDIDATE)
	(goal gl-msr-candidate 0)
=>
	(up-bound-point gl-island-migration-route-waypoint-x gl-msr-land-x)
	(up-bound-point gl-msr-candidate-water-x gl-msr-water-x)
	(up-bound-point gl-island-migration-route-waypoint-x gl-island-migration-route-waypoint-x)
	(up-bound-point gl-msr-candidate-water-x gl-msr-candidate-water-x)
	(set-goal gl-msr-zone -2)
	(up-get-point-zone gl-island-migration-route-waypoint-x gl-msr-zone)
	(set-goal gl-msr-water-zone -2)
	(up-get-point-zone gl-msr-candidate-water-x gl-msr-water-zone)
	(set-goal gl-msr-blocked NO)
	(up-modify-goal gl-msr-min-x g:= gl-island-migration-route-waypoint-x)
	(up-modify-goal gl-msr-min-x c:- 6)
	(up-modify-goal gl-msr-max-x g:= gl-island-migration-route-waypoint-x)
	(up-modify-goal gl-msr-max-x c:+ 6)
	(up-modify-goal gl-msr-min-y g:= gl-island-migration-route-waypoint-y)
	(up-modify-goal gl-msr-min-y c:- 6)
	(up-modify-goal gl-msr-max-y g:= gl-island-migration-route-waypoint-y)
	(up-modify-goal gl-msr-max-y c:+ 6)
	(set-goal gl-island-migration-state MIGRATION-SHORE-CACHE)
)

(defrule
	(goal gl-island-migration-state MIGRATION-SHORE-CANDIDATE)
	(goal gl-msr-candidate 1)
=>
	(up-bound-point gl-island-migration-route-waypoint-x gl-msr-land-x)
	(up-bound-point gl-msr-candidate-water-x gl-msr-water-x)
	(up-cross-tiles gl-island-migration-route-waypoint-x gl-msr-water-x c: 8)
	(up-cross-tiles gl-msr-candidate-water-x gl-msr-land-x c: -8)
	(up-bound-point gl-island-migration-route-waypoint-x gl-island-migration-route-waypoint-x)
	(up-bound-point gl-msr-candidate-water-x gl-msr-candidate-water-x)
	(set-goal gl-msr-zone -2)
	(up-get-point-zone gl-island-migration-route-waypoint-x gl-msr-zone)
	(set-goal gl-msr-water-zone -2)
	(up-get-point-zone gl-msr-candidate-water-x gl-msr-water-zone)
	(set-goal gl-msr-blocked NO)
	(up-modify-goal gl-msr-min-x g:= gl-island-migration-route-waypoint-x)
	(up-modify-goal gl-msr-min-x c:- 6)
	(up-modify-goal gl-msr-max-x g:= gl-island-migration-route-waypoint-x)
	(up-modify-goal gl-msr-max-x c:+ 6)
	(up-modify-goal gl-msr-min-y g:= gl-island-migration-route-waypoint-y)
	(up-modify-goal gl-msr-min-y c:- 6)
	(up-modify-goal gl-msr-max-y g:= gl-island-migration-route-waypoint-y)
	(up-modify-goal gl-msr-max-y c:+ 6)
	(set-goal gl-island-migration-state MIGRATION-SHORE-CACHE)
)

(defrule
	(goal gl-island-migration-state MIGRATION-SHORE-CANDIDATE)
	(goal gl-msr-candidate 2)
=>
	(up-bound-point gl-island-migration-route-waypoint-x gl-msr-land-x)
