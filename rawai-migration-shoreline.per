)

(defrule
	(goal gl-island-migration-state MIGRATION-SHORE-CANDIDATE)
	(goal gl-msr-candidate 3)
=>
	(up-bound-point gl-island-migration-route-waypoint-x gl-msr-land-x)
	(up-bound-point gl-msr-candidate-water-x gl-msr-water-x)
	(up-cross-tiles gl-island-migration-route-waypoint-x gl-msr-water-x c: 16)
	(up-cross-tiles gl-msr-candidate-water-x gl-msr-land-x c: -16)
	(up-bound-point gl-island-migration-route-waypoint-x gl-island-migration-route-waypoint-x)
	(up-bound-point gl-msr-candidate-water-x gl-msr-candidate-water-x)
