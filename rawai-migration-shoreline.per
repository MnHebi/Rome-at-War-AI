	(up-modify-goal gl-msr-max-x g:= gl-island-migration-route-waypoint-x)
	(up-modify-goal gl-msr-max-x c:+ 6)
	(up-modify-goal gl-msr-min-y g:= gl-island-migration-route-waypoint-y)
	(up-modify-goal gl-msr-min-y c:- 6)
	(up-modify-goal gl-msr-max-y g:= gl-island-migration-route-waypoint-y)
	(up-modify-goal gl-msr-max-y c:+ 6)
	(set-goal gl-island-migration-state MIGRATION-SHORE-CACHE)
)

(defrule
	(goal gl-island-migration-state MIGRATION-SHORE-CACHE)
	(up-compare-goal gl-game-time g:< gl-msr-memory1-until)
	(up-compare-goal gl-msr-memory1-x g:>= gl-msr-min-x)
	(up-compare-goal gl-msr-memory1-x g:<= gl-msr-max-x)
	(up-compare-goal gl-msr-memory1-y g:>= gl-msr-min-y)
	(up-compare-goal gl-msr-memory1-y g:<= gl-msr-max-y)
=>
	(set-goal gl-msr-blocked YES)
)

(defrule
	(goal gl-island-migration-state MIGRATION-SHORE-CACHE)
	(up-compare-goal gl-game-time g:< gl-msr-memory2-until)
	(up-compare-goal gl-msr-memory2-x g:>= gl-msr-min-x)
	(up-compare-goal gl-msr-memory2-x g:<= gl-msr-max-x)
	(up-compare-goal gl-msr-memory2-y g:>= gl-msr-min-y)
	(up-compare-goal gl-msr-memory2-y g:<= gl-msr-max-y)
=>
	(set-goal gl-msr-blocked YES)
)

(defrule
	(goal gl-island-migration-state MIGRATION-SHORE-CACHE)
	(up-compare-goal gl-game-time g:< gl-msr-memory3-until)
	(up-compare-goal gl-msr-memory3-x g:>= gl-msr-min-x)
	(up-compare-goal gl-msr-memory3-x g:<= gl-msr-max-x)
	(up-compare-goal gl-msr-memory3-y g:>= gl-msr-min-y)
	(up-compare-goal gl-msr-memory3-y g:<= gl-msr-max-y)
=>
	(set-goal gl-msr-blocked YES)
)

(defrule
	(goal gl-island-migration-state MIGRATION-SHORE-CACHE)
	(up-compare-goal gl-game-time g:< gl-msr-memory4-until)
	(up-compare-goal gl-msr-memory4-x g:>= gl-msr-min-x)
	(up-compare-goal gl-msr-memory4-x g:<= gl-msr-max-x)
	(up-compare-goal gl-msr-memory4-y g:>= gl-msr-min-y)
	(up-compare-goal gl-msr-memory4-y g:<= gl-msr-max-y)
=>
	(set-goal gl-msr-blocked YES)
)

(defrule
	(goal gl-island-migration-state MIGRATION-SHORE-CACHE)
	(goal gl-msr-blocked YES)
=>
	(up-modify-goal gl-msr-candidate c:+ 1)
	(set-goal gl-island-migration-state MIGRATION-SHORE-CANDIDATE)
)

(defrule
	(goal gl-island-migration-state MIGRATION-SHORE-CACHE)
	(or (up-compare-goal gl-msr-zone g:!= gl-island-migration-zone)
	(or (up-compare-goal gl-msr-water-zone c:< 0)
	(up-compare-goal gl-msr-water-zone g:== gl-island-migration-zone)))
=>
	(up-modify-goal gl-msr-candidate c:+ 1)
	(set-goal gl-island-migration-state MIGRATION-SHORE-CANDIDATE)
)

(defrule
	(goal gl-island-migration-state MIGRATION-SHORE-CACHE)
=>
	(set-strategic-number sn-focus-player-number my-player-number)
	(up-full-reset-search)
	(up-add-object-by-id search-local g: gl-island-migration-transport-id)
	(up-remove-objects search-local object-data-player != my-player-number)
	(up-remove-objects search-local object-data-group-flag != migration-transport-group)
	(set-goal gl-island-migration-state MIGRATION-SHORE-PATH)
)

(defrule
	(goal gl-island-migration-state MIGRATION-SHORE-PATH)
	(up-set-target-object search-local c: 0)
=>
	(up-get-path-distance gl-msr-candidate-water-x 1 gl-msr-water-distance)
	(up-get-path-distance gl-island-migration-route-waypoint-x 0 gl-msr-land-distance)
	(set-goal gl-island-migration-state MIGRATION-SHORE-PATH-RESULT)
)

(defrule
	(goal gl-island-migration-state MIGRATION-SHORE-PATH)
	(not (up-set-target-object search-local c: 0))
=>
	(set-goal gl-island-migration-state MIGRATION-SHORE-EXHAUSTED)
)

(defrule
	(goal gl-island-migration-state MIGRATION-SHORE-PATH-RESULT)
	(or (up-compare-goal gl-msr-water-distance c:< 0)
	(or (goal gl-msr-water-distance 65535)
	(or (up-compare-goal gl-msr-land-distance c:< 0)
	(goal gl-msr-land-distance 65535))))
=>
	(set-goal gl-island-migration-state MIGRATION-SHORE-REMEMBER)
)

(defrule
	(goal gl-island-migration-state MIGRATION-SHORE-PATH-RESULT)
	(up-compare-goal gl-msr-water-distance c:>= 0)
	(up-compare-goal gl-msr-water-distance c:!= 65535)
	(up-compare-goal gl-msr-land-distance c:>= 0)
	(up-compare-goal gl-msr-land-distance c:!= 65535)
=>
	(up-bound-point gl-msr-selected-water-x gl-msr-candidate-water-x)
	(up-bound-point gl-msr-selected-land-x gl-island-migration-route-waypoint-x)
	(up-modify-sn sn-focus-player-number g:= gl-island-migration-focus)
	(set-goal gl-island-migration-state MIGRATION-ROUTE-PREPARE)
)

(defrule
	(goal gl-island-migration-state MIGRATION-SHORE-REMEMBER)
	(goal gl-msr-write 1)
=>
	(up-modify-goal gl-msr-memory1-x g:= gl-island-migration-route-waypoint-x)
	(up-modify-goal gl-msr-memory1-y g:= gl-island-migration-route-waypoint-y)
	(up-modify-goal gl-msr-memory1-until g:= gl-game-time)
	(up-modify-goal gl-msr-memory1-until c:+ 300)
	(set-goal gl-msr-write 2)
	(up-modify-goal gl-msr-candidate c:+ 1)
	(set-goal gl-island-migration-state MIGRATION-SHORE-CANDIDATE)
)

(defrule
	(goal gl-island-migration-state MIGRATION-SHORE-REMEMBER)
	(goal gl-msr-write 2)
=>
	(up-modify-goal gl-msr-memory2-x g:= gl-island-migration-route-waypoint-x)
	(up-modify-goal gl-msr-memory2-y g:= gl-island-migration-route-waypoint-y)
	(up-modify-goal gl-msr-memory2-until g:= gl-game-time)
	(up-modify-goal gl-msr-memory2-until c:+ 300)
	(set-goal gl-msr-write 3)
	(up-modify-goal gl-msr-candidate c:+ 1)
	(set-goal gl-island-migration-state MIGRATION-SHORE-CANDIDATE)
)

(defrule
	(goal gl-island-migration-state MIGRATION-SHORE-REMEMBER)
	(goal gl-msr-write 3)
=>
	(up-modify-goal gl-msr-memory3-x g:= gl-island-migration-route-waypoint-x)
	(up-modify-goal gl-msr-memory3-y g:= gl-island-migration-route-waypoint-y)
	(up-modify-goal gl-msr-memory3-until g:= gl-game-time)
	(up-modify-goal gl-msr-memory3-until c:+ 300)
	(set-goal gl-msr-write 4)
	(up-modify-goal gl-msr-candidate c:+ 1)
	(set-goal gl-island-migration-state MIGRATION-SHORE-CANDIDATE)
