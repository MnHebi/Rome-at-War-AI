;Generated terminal releases; never issue a movement/STOP here.

;Clear only living self-owned members still carrying this owner flag.

(defrule
	(up-group-size c: 1 > 0)
=>
	(up-set-group search-local c: 1)
	(up-remove-objects search-local object-data-player != my-player-number)
	(up-remove-objects search-local object-data-group-flag != 1)
	(up-create-group 0 0 c: 1)
)

