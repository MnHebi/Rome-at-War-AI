)

(defrule
	(up-group-size c: allied-relief-group > 0)
	(up-compare-goal gl-game-time g:>= gl-owner-relief-until)
=>
	(up-set-group search-local c: allied-relief-group)
	(up-remove-objects search-local object-data-player != my-player-number)
	(up-remove-objects search-local object-data-group-flag != allied-relief-group)
	(up-create-group 0 0 c: allied-relief-group)
	(up-modify-group-flag 0 c: allied-relief-group)
	(up-reset-group c: allied-relief-group)
)

(defrule
	(up-group-size c: allied-relief-group > 0)
=>
	(up-full-reset-search)
	(up-add-object-by-id search-remote g: gl-owner-relief-target)
	(up-remove-objects search-remote object-data-player g:!= gl-owner-relief-player)
	(up-remove-objects search-remote object-data-status != status-ready)
)

(defrule
	(up-group-size c: allied-relief-group > 0)
	(not (up-set-target-object search-remote c: 0))
=>
	(up-set-group search-local c: allied-relief-group)
	(up-remove-objects search-local object-data-player != my-player-number)
	(up-remove-objects search-local object-data-group-flag != allied-relief-group)
	(up-create-group 0 0 c: allied-relief-group)
	(up-modify-group-flag 0 c: allied-relief-group)
	(up-reset-group c: allied-relief-group)
)
