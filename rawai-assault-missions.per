)

(defrule
	(goal gl-am3-state 6)
	(goal gl-am3-sample 7)
	(up-compare-goal gl-am3-combat-target c:>= 0)
	(up-compare-goal gl-am3-combat-target g:!= gl-am3-combat-last)
=>
	(set-goal gl-am3-combat-tries 0)
	(up-chat-data-to-all str-assault-slot c: 3)
	(up-chat-data-to-all str-assault-hull g: gl-am3-hull)
	(up-chat-data-to-all str-assault-saved-enemy g: gl-am3-enemy)
	(up-chat-data-to-all str-assault-event c: 13)
	(up-chat-data-to-all "RAW landed combat target: %d" g: gl-am3-combat-target)
)

(defrule
	(goal gl-am3-state 6)
	(goal gl-am3-sample 7)
	(up-compare-goal gl-am3-combat-target c:>= 0)
=>
	(up-full-reset-search)
	(up-set-group search-local c: assault-mission-3-group)
	(up-remove-objects search-local object-data-player != my-player-number)
	(up-remove-objects search-local object-data-group-flag != assault-mission-3-group)
	(up-remove-objects search-local object-data-garrisoned == 1)
	(up-remove-objects search-local object-data-map-zone-id g:!= gl-am3-target-zone)
	(up-remove-objects search-local object-data-idling != 1)
	(up-remove-objects search-local object-data-under-attack > 0)
	(up-add-object-by-id search-remote g: gl-am3-combat-target)
	(up-target-objects 1 action-default -1 stance-aggressive)
	(up-modify-goal gl-am3-combat-last g:= gl-am3-combat-target)
	(set-goal gl-am3-combat-misses 0)
	(up-modify-goal gl-am3-combat-tries c:+ 1)
)

(defrule
	(goal gl-am3-state 6)
	(goal gl-am3-sample 7)
	(up-compare-goal gl-am3-combat-target c:>= 0)
	(up-compare-goal gl-am3-combat-tries c:>= 3)
=>
	(up-modify-goal gl-am3-combat-failed g:= gl-am3-combat-target)
)

(defrule
	(goal gl-am3-state 6)
	(goal gl-am3-sample 7)
	(goal gl-am3-combat-target -1)
=>
	(up-modify-goal gl-am3-combat-misses c:+ 1)
)

(defrule
	(goal gl-am3-state 6)
	(goal gl-am3-sample 7)
	(up-compare-goal gl-am3-combat-misses c:>= 4)
=>
	(set-goal gl-am3-state 5)
	(set-goal gl-am3-reason 12)
	(up-chat-data-to-all str-assault-slot c: 3)
	(up-chat-data-to-all str-assault-hull g: gl-am3-hull)
	(up-chat-data-to-all str-assault-saved-enemy g: gl-am3-enemy)
	(up-chat-data-to-all str-assault-event c: 12)
)

(defrule
	(goal gl-am3-state 5)
=>
	(up-full-reset-search)
	(up-set-group search-local c: assault-mission-3-group)
	(up-remove-objects search-local object-data-player != my-player-number)
	(up-remove-objects search-local object-data-group-flag != assault-mission-3-group)
	(up-create-group 0 0 c: assault-mission-3-group)
	(up-modify-group-flag 0 c: assault-mission-3-group)
	(up-reset-group c: assault-mission-3-group)
	(set-goal gl-am3-state 0)
	(set-goal gl-am3-hull -1)
	(set-goal gl-am3-sample 0)
)

(defrule
	(goal gl-transport-route-state TRANSPORT-ROUTE-DEPARTURE-START)
=>
	(set-goal gl-transport-route-state TRANSPORT-ROUTE-SCREEN-RECALL)
)

(defrule
	(true)
=>
	(up-modify-sn sn-focus-player-number g:= gl-assault-mission-focus)
)
