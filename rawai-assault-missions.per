	(up-remove-objects search-local object-data-order == orderid-unload)
	(up-remove-objects search-local object-data-map-zone-id g:!= gl-am2-water-zone)
	(up-clean-search search-local object-data-distance search-order-asc)
	(up-remove-objects search-local object-data-index > 0)
	(set-goal gl-am2-sample 3)
)

