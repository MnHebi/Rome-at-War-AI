(defrule
	(goal gl-am1-state 6)
	(goal gl-am1-sample 7)
	(up-compare-goal gl-am1-combat-target c:>= 0)
	(up-compare-goal gl-am1-combat-target g:!= gl-am1-combat-last)
=>
	(set-goal gl-am1-combat-tries 0)
	(up-chat-data-to-all str-assault-slot c: 1)
	(up-chat-data-to-all str-assault-hull g: gl-am1-hull)
	(up-chat-data-to-all str-assault-saved-enemy g: gl-am1-enemy)
	(up-chat-data-to-all str-assault-event c: 13)
	(up-chat-data-to-all "RAW landed combat target: %d" g: gl-am1-combat-target)
)

(defrule
	(goal gl-am1-state 6)
	(goal gl-am1-sample 7)
	(up-compare-goal gl-am1-combat-target c:>= 0)
=>
	(up-full-reset-search)
	(up-set-group search-local c: assault-mission-1-group)
	(up-remove-objects search-local object-data-player != my-player-number)
	(up-remove-objects search-local object-data-group-flag != assault-mission-1-group)
	(up-remove-objects search-local object-data-garrisoned == 1)
	(up-remove-objects search-local object-data-map-zone-id g:!= gl-am1-target-zone)
	(up-remove-objects search-local object-data-idling != 1)
	(up-remove-objects search-local object-data-under-attack > 0)
	(up-add-object-by-id search-remote g: gl-am1-combat-target)
	(up-target-objects 1 action-default -1 stance-aggressive)
	(up-modify-goal gl-am1-combat-last g:= gl-am1-combat-target)
	(set-goal gl-am1-combat-misses 0)
	(up-modify-goal gl-am1-combat-tries c:+ 1)
)

(defrule
	(goal gl-am1-state 6)
	(goal gl-am1-sample 7)
	(up-compare-goal gl-am1-combat-target c:>= 0)
	(up-compare-goal gl-am1-combat-tries c:>= 3)
=>
	(up-modify-goal gl-am1-combat-failed g:= gl-am1-combat-target)
)

(defrule
	(goal gl-am1-state 6)
	(goal gl-am1-sample 7)
	(goal gl-am1-combat-target -1)
=>
	(up-modify-goal gl-am1-combat-misses c:+ 1)
)

(defrule
	(goal gl-am1-state 6)
	(goal gl-am1-sample 7)
	(up-compare-goal gl-am1-combat-misses c:>= 4)
=>
	(set-goal gl-am1-state 5)
	(set-goal gl-am1-reason 12)
	(up-chat-data-to-all str-assault-slot c: 1)
	(up-chat-data-to-all str-assault-hull g: gl-am1-hull)
	(up-chat-data-to-all str-assault-saved-enemy g: gl-am1-enemy)
	(up-chat-data-to-all str-assault-event c: 12)
)

(defrule
	(goal gl-am1-state 5)
=>
	(up-full-reset-search)
	(up-set-group search-local c: assault-mission-1-group)
	(up-remove-objects search-local object-data-player != my-player-number)
	(up-remove-objects search-local object-data-group-flag != assault-mission-1-group)
	(up-create-group 0 0 c: assault-mission-1-group)
	(up-modify-group-flag 0 c: assault-mission-1-group)
	(up-reset-group c: assault-mission-1-group)
	(set-goal gl-am1-state 0)
	(set-goal gl-am1-hull -1)
	(set-goal gl-am1-sample 0)
)

(defrule
	(goal gl-transport-route-state TRANSPORT-ROUTE-DEPARTURE-START)
=>
	(up-full-reset-search)
	(up-add-object-by-id search-local g: gl-transport-route-id)
	(up-remove-objects search-local object-data-player != my-player-number)
	(up-remove-objects search-local object-data-group-flag != attack-transport-group)
)

(defrule
	(goal gl-transport-route-state TRANSPORT-ROUTE-DEPARTURE-START)
	(goal gl-am2-state 0)
	(goal gl-assault-preflight-live YES)
	(up-compare-goal gl-assault-manifest-hull g:== gl-transport-route-id)
	(up-compare-goal gl-assault-manifest-count c:>= 5)
	(up-set-target-object search-local c: 0)
	(up-object-data object-data-garrison-count g:>= gl-assault-manifest-count)
=>
	(set-goal gl-transport-route-state 101)
	(set-goal gl-am2-state 11)
	(up-modify-goal gl-am2-hull g:= gl-transport-route-id)
	(up-modify-goal gl-am2-enemy g:= gl-assault-manifest-player)
	(up-modify-goal gl-am2-cargo g:= gl-assault-manifest-count)
	(up-modify-goal gl-am2-screen g:= gl-transport-screen-id)
	(up-modify-goal gl-am2-target-zone g:= gl-transport-route-target-zone)
	(up-modify-goal gl-am2-unscreened g:= gl-assault-fallback-deadline)
	(set-goal gl-am2-reason 0)
	(set-goal gl-am2-clear-count 0)
	(set-goal gl-am2-stalls 0)
	(set-goal gl-am2-issue 1)
	(set-goal gl-am2-best 99999)
	(up-bound-point gl-am2-origin-x gl-transport-route-origin-x)
	(up-bound-point gl-am2-waypoint-x gl-transport-route-waypoint-x)
	(up-bound-point gl-am2-landing-x gl-transport-route-landing-x)
	(up-bound-point gl-am2-target-x gl-transport-route-target-x)
)

(defrule
	(goal gl-am2-state 11)
=>
	(up-full-reset-search)
	(up-add-object-by-id search-local g: gl-am2-screen)
	(up-remove-objects search-local object-data-player != my-player-number)
	(up-remove-objects search-local object-data-group-flag != transport-screen-group)
)

(defrule
	(goal gl-am2-state 11)
	(not (up-set-target-object search-local c: 0))
=>
	(set-goal gl-am2-screen -1)
)

(defrule
	(goal gl-am2-state 11)
=>
	(up-full-reset-search)
	(up-set-group search-local c: attack-boarding-group)
	(up-remove-objects search-local object-data-player != my-player-number)
	(up-remove-objects search-local object-data-group-flag != attack-boarding-group)
	(up-add-object-by-id search-local g: gl-am2-hull)
	(up-add-object-by-id search-local g: gl-am2-screen)
	(up-remove-objects search-local object-data-player != my-player-number)
	(up-create-group 0 0 c: assault-mission-2-group)
	(up-modify-group-flag 0 c: attack-boarding-group)
	(up-reset-group c: attack-boarding-group)
	(up-modify-group-flag 0 c: attack-transport-group)
	(up-reset-group c: attack-transport-group)
	(up-modify-group-flag 0 c: transport-screen-group)
	(up-reset-group c: transport-screen-group)
	(up-modify-group-flag 1 c: assault-mission-2-group)
	(set-goal gl-am2-state 12)
)

(defrule
	(goal gl-am2-state 12)
=>
	(up-full-reset-search)
	(up-add-object-by-id search-local g: gl-am2-hull)
	(up-remove-objects search-local object-data-player != my-player-number)
	(up-remove-objects search-local object-data-group-flag != assault-mission-2-group)
	(set-goal gl-am2-previous-hp 0)
	(set-goal gl-am2-next 0)
	(up-modify-goal gl-am2-travel-until g:= gl-assault-mission-clock)
	(up-modify-goal gl-am2-travel-until c:+ 600)
	(up-modify-goal gl-am2-progress-until g:= gl-assault-mission-clock)
	(up-modify-goal gl-am2-progress-until c:+ 90)
	(set-goal gl-am2-state 1)
	(set-goal gl-transport-route-state TRANSPORT-ROUTE-IDLE)
	(set-goal gl-transport-route-script-load NO)
	(set-goal gl-transport-route-id -1)
	(set-goal gl-transport-screen-id -1)
	(set-goal gl-assault-fallback-deadline 0)
	(set-goal gl-assault-fallback-progress-deadline 0)
	(up-set-timer c: t-transport-route c: 1)
	(up-chat-data-to-all str-assault-slot c: 2)
	(up-chat-data-to-all str-assault-hull g: gl-am2-hull)
	(up-chat-data-to-all str-assault-saved-enemy g: gl-am2-enemy)
	(up-chat-data-to-all str-assault-event c: 0)
)

(defrule
	(goal gl-am2-state 1)
	(up-compare-goal gl-am2-unscreened c:> 0)
=>
	(up-modify-goal gl-am2-travel-until g:= gl-am2-unscreened)
	(set-goal gl-am2-unscreened 0)
)

(defrule
	(true)
=>
	(set-goal gl-am2-sample 0)
)

(defrule
	(up-compare-goal gl-am2-state c:>= 1)
	(up-compare-goal gl-am2-state c:<= 4)
	(up-compare-goal gl-assault-mission-clock g:>= gl-am2-next)
=>
	(set-goal gl-am2-sample 1)
	(up-modify-goal gl-am2-next g:= gl-assault-mission-clock)
	(up-modify-goal gl-am2-next c:+ 8)
	(up-full-reset-search)
	(up-add-object-by-id search-local g: gl-am2-hull)
	(up-remove-objects search-local object-data-player != my-player-number)
	(up-remove-objects search-local object-data-group-flag != assault-mission-2-group)
)

(defrule
	(goal gl-am2-sample YES)
	(not (up-set-target-object search-local c: 0))
=>
	(set-goal gl-am2-state 5)
	(set-goal gl-am2-reason 6)
	(up-chat-data-to-all str-assault-slot c: 2)
	(up-chat-data-to-all str-assault-hull g: gl-am2-hull)
	(up-chat-data-to-all str-assault-saved-enemy g: gl-am2-enemy)
	(up-chat-data-to-all str-assault-event c: 6)
)

(defrule
	(goal gl-am2-sample YES)
	(up-compare-goal gl-am2-state c:>= 1)
	(up-compare-goal gl-am2-state c:<= 4)
	(up-set-target-object search-local c: 0)
=>
	(up-get-object-data object-data-garrison-count gl-am2-cargo)
	(up-get-object-data object-data-hitpoints gl-am2-hp)
	(up-get-object-data object-data-attacker-id gl-am2-attacker)
	(up-get-object-data object-data-map-zone-id gl-am2-water-zone)
	(up-get-point position-object gl-am2-x)
