;Generated three-slot voyage controller. Never reads global target or home-defense state.

;Shared search lists are reconstructed inside each uninterrupted sample; only goals/groups persist.

;A native/manual transport already underway is NOT adopted by this controller.

(defrule
	(true)
=>
	(up-get-fact game-time 0 gl-assault-mission-clock)
	(up-modify-goal gl-assault-mission-focus s:= sn-focus-player-number)
)

(defrule
	(goal gl-transport-route-state TRANSPORT-ROUTE-DEPARTURE-START)
=>
	(up-full-reset-search)
	(up-add-object-by-id search-local g: gl-transport-route-id)
	(up-remove-objects search-local object-data-player != my-player-number)
	(up-remove-objects search-local object-data-group-flag != attack-transport-group)
)

(defrule
	(goal gl-transport-route-state TRANSPORT-ROUTE-DEPARTURE-START)
	(goal gl-am1-state 0)
	(goal gl-assault-preflight-live YES)
	(up-compare-goal gl-assault-manifest-hull g:== gl-transport-route-id)
	(up-compare-goal gl-assault-manifest-count c:>= 5)
	(up-set-target-object search-local c: 0)
	(up-object-data object-data-garrison-count g:>= gl-assault-manifest-count)
=>
	(set-goal gl-transport-route-state 101)
	(set-goal gl-am1-state 11)
	(up-modify-goal gl-am1-hull g:= gl-transport-route-id)
	(up-modify-goal gl-am1-enemy g:= gl-assault-manifest-player)
	(up-modify-goal gl-am1-cargo g:= gl-assault-manifest-count)
	(up-modify-goal gl-am1-screen g:= gl-transport-screen-id)
	(up-modify-goal gl-am1-target-zone g:= gl-transport-route-target-zone)
	(up-modify-goal gl-am1-unscreened g:= gl-assault-fallback-deadline)
	(set-goal gl-am1-reason 0)
	(set-goal gl-am1-clear-count 0)
	(set-goal gl-am1-stalls 0)
	(set-goal gl-am1-issue 1)
	(set-goal gl-am1-best 99999)
	(up-bound-point gl-am1-origin-x gl-transport-route-origin-x)
	(up-bound-point gl-am1-waypoint-x gl-transport-route-waypoint-x)
	(up-bound-point gl-am1-landing-x gl-transport-route-landing-x)
	(up-bound-point gl-am1-target-x gl-transport-route-target-x)
)

(defrule
	(goal gl-am1-state 11)
=>
	(up-full-reset-search)
	(up-add-object-by-id search-local g: gl-am1-screen)
	(up-remove-objects search-local object-data-player != my-player-number)
	(up-remove-objects search-local object-data-group-flag != transport-screen-group)
)

(defrule
	(goal gl-am1-state 11)
	(not (up-set-target-object search-local c: 0))
=>
	(set-goal gl-am1-screen -1)
)

(defrule
	(goal gl-am1-state 11)
=>
	(up-full-reset-search)
	(up-set-group search-local c: attack-boarding-group)
	(up-remove-objects search-local object-data-player != my-player-number)
	(up-remove-objects search-local object-data-group-flag != attack-boarding-group)
	(up-add-object-by-id search-local g: gl-am1-hull)
	(up-add-object-by-id search-local g: gl-am1-screen)
	(up-remove-objects search-local object-data-player != my-player-number)
	(up-create-group 0 0 c: assault-mission-1-group)
	(up-modify-group-flag 0 c: attack-boarding-group)
	(up-reset-group c: attack-boarding-group)
	(up-modify-group-flag 0 c: attack-transport-group)
	(up-reset-group c: attack-transport-group)
	(up-modify-group-flag 0 c: transport-screen-group)
	(up-reset-group c: transport-screen-group)
	(up-modify-group-flag 1 c: assault-mission-1-group)
	(set-goal gl-am1-state 12)
)

(defrule
	(goal gl-am1-state 12)
=>
	(up-full-reset-search)
	(up-add-object-by-id search-local g: gl-am1-hull)
	(up-remove-objects search-local object-data-player != my-player-number)
	(up-remove-objects search-local object-data-group-flag != assault-mission-1-group)
	(set-goal gl-am1-previous-hp 0)
	(set-goal gl-am1-next 0)
	(up-modify-goal gl-am1-travel-until g:= gl-assault-mission-clock)
	(up-modify-goal gl-am1-travel-until c:+ 600)
	(up-modify-goal gl-am1-progress-until g:= gl-assault-mission-clock)
	(up-modify-goal gl-am1-progress-until c:+ 90)
	(set-goal gl-am1-state 1)
	(set-goal gl-transport-route-state TRANSPORT-ROUTE-IDLE)
	(set-goal gl-transport-route-script-load NO)
	(set-goal gl-transport-route-id -1)
	(set-goal gl-transport-screen-id -1)
	(set-goal gl-assault-fallback-deadline 0)
	(set-goal gl-assault-fallback-progress-deadline 0)
	(up-set-timer c: t-transport-route c: 1)
	(up-chat-data-to-all str-assault-slot c: 1)
	(up-chat-data-to-all str-assault-hull g: gl-am1-hull)
	(up-chat-data-to-all str-assault-saved-enemy g: gl-am1-enemy)
	(up-chat-data-to-all str-assault-event c: 0)
)

(defrule
	(goal gl-am1-state 1)
	(up-compare-goal gl-am1-unscreened c:> 0)
=>
	(up-modify-goal gl-am1-travel-until g:= gl-am1-unscreened)
	(set-goal gl-am1-unscreened 0)
)

(defrule
	(true)
=>
	(set-goal gl-am1-sample 0)
)

(defrule
	(up-compare-goal gl-am1-state c:>= 1)
	(up-compare-goal gl-am1-state c:<= 4)
	(up-compare-goal gl-assault-mission-clock g:>= gl-am1-next)
=>
	(set-goal gl-am1-sample 1)
	(up-modify-goal gl-am1-next g:= gl-assault-mission-clock)
	(up-modify-goal gl-am1-next c:+ 8)
	(up-full-reset-search)
	(up-add-object-by-id search-local g: gl-am1-hull)
	(up-remove-objects search-local object-data-player != my-player-number)
	(up-remove-objects search-local object-data-group-flag != assault-mission-1-group)
)

(defrule
	(goal gl-am1-sample YES)
	(not (up-set-target-object search-local c: 0))
=>
	(set-goal gl-am1-state 5)
	(set-goal gl-am1-reason 6)
	(up-chat-data-to-all str-assault-slot c: 1)
	(up-chat-data-to-all str-assault-hull g: gl-am1-hull)
	(up-chat-data-to-all str-assault-saved-enemy g: gl-am1-enemy)
	(up-chat-data-to-all str-assault-event c: 6)
)

(defrule
	(goal gl-am1-sample YES)
	(up-compare-goal gl-am1-state c:>= 1)
	(up-compare-goal gl-am1-state c:<= 4)
	(up-set-target-object search-local c: 0)
=>
	(up-get-object-data object-data-garrison-count gl-am1-cargo)
	(up-get-object-data object-data-hitpoints gl-am1-hp)
	(up-get-object-data object-data-attacker-id gl-am1-attacker)
	(up-get-object-data object-data-map-zone-id gl-am1-water-zone)
	(up-get-point position-object gl-am1-x)
)

(defrule
	(goal gl-am1-sample YES)
	(goal gl-am1-state 1)
=>
	(up-full-reset-search)
	(up-add-object-by-id search-local g: gl-am1-hull)
	(up-remove-objects search-local object-data-player != my-player-number)
	(up-remove-objects search-local object-data-group-flag != assault-mission-1-group)
	(up-set-target-point gl-am1-waypoint-x)
)

(defrule
	(goal gl-am1-sample YES)
	(goal gl-am1-state 2)
=>
	(up-full-reset-search)
	(up-add-object-by-id search-local g: gl-am1-hull)
	(up-remove-objects search-local object-data-player != my-player-number)
	(up-remove-objects search-local object-data-group-flag != assault-mission-1-group)
	(up-set-target-point gl-am1-landing-x)
)

(defrule
	(goal gl-am1-sample YES)
	(goal gl-am1-state 3)
=>
	(up-full-reset-search)
	(up-add-object-by-id search-local g: gl-am1-hull)
	(up-remove-objects search-local object-data-player != my-player-number)
	(up-remove-objects search-local object-data-group-flag != assault-mission-1-group)
	(up-set-target-point gl-am1-origin-x)
)

(defrule
	(goal gl-am1-sample YES)
	(goal gl-am1-state 4)
=>
	(up-full-reset-search)
	(up-add-object-by-id search-local g: gl-am1-hull)
	(up-remove-objects search-local object-data-player != my-player-number)
	(up-remove-objects search-local object-data-group-flag != assault-mission-1-group)
	(up-set-target-point gl-am1-origin-x)
)

(defrule
	(goal gl-am1-sample YES)
	(up-compare-goal gl-am1-state c:>= 1)
	(up-compare-goal gl-am1-state c:<= 4)
	(up-set-target-object search-local c: 0)
=>
	(up-get-object-data object-data-distance gl-am1-distance)
)

(defrule
	(goal gl-am1-sample YES)
	(goal gl-am1-state 2)
	(up-compare-goal gl-am1-cargo c:<= 0)
	(up-compare-goal gl-am1-distance c:<= 12)
=>
	(up-full-reset-search)
	(up-add-object-by-id search-local g: gl-am1-hull)
	(up-remove-objects search-local object-data-player != my-player-number)
	(up-remove-objects search-local object-data-group-flag != assault-mission-1-group)
	(up-target-point gl-am1-origin-x action-move -1 stance-no-attack)
	(set-goal gl-am1-state 14)
)

(defrule
	(goal gl-am1-state 14)
=>
	(up-full-reset-search)
	(up-set-group search-local c: assault-mission-1-group)
	(up-remove-objects search-local object-data-player != my-player-number)
	(up-remove-objects search-local object-data-group-flag != assault-mission-1-group)
	(up-create-group 0 0 c: assault-mission-1-group)
	(up-modify-group-flag 0 c: assault-mission-1-group)
	(up-remove-objects search-local object-data-id g:== gl-am1-hull)
	(up-remove-objects search-local object-data-id g:== gl-am1-screen)
	(up-remove-objects search-local object-data-garrisoned == 1)
	(up-remove-objects search-local object-data-map-zone-id g:!= gl-am1-target-zone)
	(up-create-group 0 0 c: assault-mission-1-group)
	(up-modify-group-flag 1 c: assault-mission-1-group)
	(up-target-point gl-am1-target-x action-default -1 stance-aggressive)
	(set-goal gl-am1-state 6)
	(set-goal gl-am1-reason 8)
	(up-modify-goal gl-am1-combat-until g:= gl-assault-mission-clock)
	(up-modify-goal gl-am1-combat-until c:+ 300)
	(set-goal gl-am1-combat-last -1)
	(set-goal gl-am1-combat-failed -1)
	(set-goal gl-am1-combat-tries 0)
	(set-goal gl-am1-combat-misses 0)
	(up-chat-data-to-all str-assault-slot c: 1)
	(up-chat-data-to-all str-assault-hull g: gl-am1-hull)
	(up-chat-data-to-all str-assault-saved-enemy g: gl-am1-enemy)
	(up-chat-data-to-all str-assault-event c: 8)
)

(defrule
	(goal gl-am1-sample YES)
	(or (goal gl-am1-state 1) (goal gl-am1-state 2))
	(goal gl-am1-enemy 1)
	(not (player-in-game 1))
=>
	(set-goal gl-am1-state 3)
	(set-goal gl-am1-issue 1)
	(set-goal gl-am1-reason 1)
	(up-modify-goal gl-am1-travel-until g:= gl-assault-mission-clock)
	(up-modify-goal gl-am1-travel-until c:+ 180)
	(up-chat-data-to-all str-assault-slot c: 1)
	(up-chat-data-to-all str-assault-hull g: gl-am1-hull)
	(up-chat-data-to-all str-assault-saved-enemy g: gl-am1-enemy)
	(up-chat-data-to-all str-assault-event c: 1)
)

