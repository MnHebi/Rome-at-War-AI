(defrule
	(goal gl-am2-sample YES)
	(goal gl-am2-state 4)
=>
	(up-full-reset-search)
	(up-add-object-by-id search-local g: gl-am2-hull)
	(up-remove-objects search-local object-data-player != my-player-number)
	(up-remove-objects search-local object-data-group-flag != assault-mission-2-group)
	(up-set-target-point gl-am2-origin-x)
)

(defrule
	(goal gl-am2-sample YES)
	(up-compare-goal gl-am2-state c:>= 1)
	(up-compare-goal gl-am2-state c:<= 4)
	(up-set-target-object search-local c: 0)
=>
	(up-get-object-data object-data-distance gl-am2-distance)
)

(defrule
	(goal gl-am2-sample YES)
	(goal gl-am2-state 2)
	(up-compare-goal gl-am2-cargo c:<= 0)
	(up-compare-goal gl-am2-distance c:<= 12)
=>
	(up-full-reset-search)
	(up-add-object-by-id search-local g: gl-am2-hull)
	(up-remove-objects search-local object-data-player != my-player-number)
	(up-remove-objects search-local object-data-group-flag != assault-mission-2-group)
	(up-target-point gl-am2-origin-x action-move -1 stance-no-attack)
	(set-goal gl-am2-state 14)
)

(defrule
	(goal gl-am2-state 14)
=>
	(up-full-reset-search)
	(up-set-group search-local c: assault-mission-2-group)
	(up-remove-objects search-local object-data-player != my-player-number)
	(up-remove-objects search-local object-data-group-flag != assault-mission-2-group)
	(up-create-group 0 0 c: assault-mission-2-group)
	(up-modify-group-flag 0 c: assault-mission-2-group)
	(up-remove-objects search-local object-data-id g:== gl-am2-hull)
	(up-remove-objects search-local object-data-id g:== gl-am2-screen)
	(up-remove-objects search-local object-data-garrisoned == 1)
	(up-remove-objects search-local object-data-map-zone-id g:!= gl-am2-target-zone)
	(up-create-group 0 0 c: assault-mission-2-group)
	(up-modify-group-flag 1 c: assault-mission-2-group)
	(up-target-point gl-am2-target-x action-default -1 stance-aggressive)
	(set-goal gl-am2-state 6)
	(set-goal gl-am2-reason 8)
	(up-modify-goal gl-am2-combat-until g:= gl-assault-mission-clock)
	(up-modify-goal gl-am2-combat-until c:+ 300)
	(set-goal gl-am2-combat-last -1)
	(set-goal gl-am2-combat-failed -1)
	(set-goal gl-am2-combat-tries 0)
	(set-goal gl-am2-combat-misses 0)
	(up-chat-data-to-all str-assault-slot c: 2)
	(up-chat-data-to-all str-assault-hull g: gl-am2-hull)
	(up-chat-data-to-all str-assault-saved-enemy g: gl-am2-enemy)
	(up-chat-data-to-all str-assault-event c: 8)
)

(defrule
	(goal gl-am2-sample YES)
	(or (goal gl-am2-state 1) (goal gl-am2-state 2))
	(goal gl-am2-enemy 1)
	(not (player-in-game 1))
=>
	(set-goal gl-am2-state 3)
	(set-goal gl-am2-issue 1)
	(set-goal gl-am2-reason 1)
	(up-modify-goal gl-am2-travel-until g:= gl-assault-mission-clock)
	(up-modify-goal gl-am2-travel-until c:+ 180)
	(up-chat-data-to-all str-assault-slot c: 2)
